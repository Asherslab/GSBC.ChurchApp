<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Library warnings are policed by aot-warnings/, so they must not fail the publish. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>

    <!-- PBN9001: protobuf-net's AOT generators are [Experimental]. -->
    <NoWarn>$(NoWarn);PBN9001</NoWarn>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);ProtoBuf.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct in every project: protobuf-net ships its props in build/, not buildTransitive/, so its AOT analyzers stay silent in projects that only reference it transitively. -->
    <PackageReference Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- Homebrew's .NET links native AOT against Homebrew's OpenSSL and Brotli. -->
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@4/lib;-L/opt/homebrew/opt/brotli/lib" />
  </ItemGroup>
</Project>
