@inject MinistriesService Ministries

<div class="stack">
    <h3 class="control-label">Viewing as</h3>
    <Segmented TValue="ViewerRole" Options="Roles" Value="Ministries.Role" ValueChanged="r => Ministries.SetRoleAsync(r)" />
    <p class="hint">@ViewerRoles.Hint(Ministries.Role)</p>
</div>

@code {
    private static readonly IReadOnlyList<Choice<ViewerRole>> Roles =
        [.. Enum.GetValues<ViewerRole>().Select(r => new Choice<ViewerRole>(r, ViewerRoles.Name(r)))];
}
