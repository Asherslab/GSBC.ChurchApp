<Sheet Open="Open" OpenChanged="OpenChanged">
    <h2>This preview</h2>
    <p>Sign-in isn't designed yet, so pick who you are.</p>
    <div class="sheet__form">
        <PreviewControls />
    </div>
    <div class="sheet__actions">
        <button class="btn btn--quiet btn--block" @onclick="() => OpenChanged.InvokeAsync(false)">Done</button>
    </div>
</Sheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
}
