@page "/ministries/{Id}"
@page "/ministries/{Id}/{Area}"
@implements IDisposable
@inject MinistriesService Ministries
@inject NativeBridge Native
@inject NavigationManager Navigation

<Page Title="@(ministry?.Name ?? "Ministry")" BackHref="@BackHref" BackLabel="@BackLabel" StuckAt="150" Bell="false">
    <Actions>
        <button class="icon-btn" @onclick="() => previewOpen = true" aria-label="Preview: viewing as and design"><Icon Name="eye" /></button>
        @if (ministry is not null && Ministries.IsLeader(ministry))
        {
            <a class="icon-btn" href="@($"ministries/{Id}/settings")" aria-label="Ministry settings"><Icon Name="sliders" /></a>
        }
    </Actions>
    <ChildContent>
        @if (ministry is null)
        {
            <EmptyState Icon="users" Title="This ministry isn't here any more" />
        }
        else
        {
            <BandHero Title="@ministry.Name" Note="@HeroNote" Colour="@ministry.Colour">
                <Actions>
                    @if (Ministries.IsLeader(ministry))
                    {
                        <button class="btn btn--on-masthead" @onclick="() => Compose(DefaultAudience)"><Icon Name="plus" Size="IconSize.Small" />Post</button>
                    }
                    else if (Ministries.IsOwnMember(ministry))
                    {
                        <button class="btn btn--ghost-masthead" @onclick="() => memberOpen = true"><Icon Name="check" Size="IconSize.Small" />Member</button>
                    }
                    else if (Ministries.IsMember(ministry))
                    {
                        <span class="hero-note"><Icon Name="check" Size="IconSize.ExtraSmall" />Member through @MinistriesService.Names(MinistriesService.Children(ministry).Where(Ministries.IsOwnMember).ToList())</span>
                    }
                    else
                    {
                        @JoinButton
                    }
                </Actions>
            </BandHero>

            @if (Areas.Count > 1)
            {
                <SectionTabs Items="Tabs" Selected="@Current.Slug()" Href="AreaHref" Locked="LockedTabs" LockedApart="Ministries.Split == ViewingSplit.TeamTabs" Label="@($"{ministry.Name} areas")" />
            }

            <div class="area" @key="Current">
                @AreaContent
            </div>
            <PreviewFooter />
        }
    </ChildContent>
</Page>

@if (ministry is not null)
{
    <ComposeSheet Open="composeOpen" OpenChanged="v => composeOpen = v" Ministry="ministry" DefaultAudience="composeAudience" OnSent="Sent" />
    <PreviewSheet @bind-Open="previewOpen" />

    <Sheet Open="askOpen" OpenChanged="v => askOpen = v">
        <h2>@(Settings.Join == JoinMode.Ask ? $"Ask to join {ministry.Name}" : "Message the leaders")</h2>
        <p>Goes to @LeaderNames only. They'll get back to you, usually within a few days.</p>
        <div class="stack sheet__form">
            <div class="field">
                <label for="ask-name">Your name</label>
                <input id="ask-name" @bind="askName" @bind:event="oninput" autocomplete="name" />
            </div>
            <div class="field">
                <label for="ask-contact">Phone or email</label>
                <input id="ask-contact" @bind="askContact" @bind:event="oninput" autocomplete="email" />
            </div>
            <div class="field">
                <label for="ask-message">Message</label>
                <textarea id="ask-message" rows="3" @bind="askMessage" @bind:event="oninput"></textarea>
            </div>
            <button class="btn btn--primary btn--block" disabled="@(string.IsNullOrWhiteSpace(askName) || string.IsNullOrWhiteSpace(askContact))" @onclick="SendAsk">
                <Icon Name="send" Size="IconSize.Small" />Send to the leaders
            </button>
            <p class="hint">Design preview: nothing is sent.</p>
        </div>
    </Sheet>

    <MembershipSheet Ministry="ministry" @bind-Open="memberOpen" Title="@($"You're in {ministry.Name}")" Line="@MemberLine"
                     LeaveLabel="@($"Leave {ministry.Name}")" OnLeave="Leave" />
}

<Toast @ref="toast" />

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string? Area { get; set; }

    private Ministry? ministry;
    private Toast toast = default!;
    private bool previewOpen;
    private bool composeOpen;
    private bool askOpen;
    private bool memberOpen;
    private Audience composeAudience;
    private string askName = "";
    private string askContact = "";
    private string askMessage = "";

    private MinistrySettings Settings => Ministries.Settings(ministry!);

    private Ministry? Parent => ministry is null ? null : MinistriesService.Parent(ministry);

    private string BackHref => ministry?.ParentId is { } parent ? $"ministries/{parent}" : "ministries";

    private string BackLabel => Parent is { } parent ? parent.Name : "Ministries";

    private bool Member => Ministries.IsMember(ministry!);

    private bool Leader => Ministries.IsLeader(ministry!);

    private string LeaderNames => string.Join(" & ", ministry!.Leaders.Select(l => l.Name));

    private string HeroNote
    {
        get
        {
            var parts = new List<string>();
            if (Parent is { } parent)
            {
                parts.Add($"Part of {parent.Name}");
            }
            if (ministry!.WhoFor is { } whoFor)
            {
                parts.Add(whoFor);
            }
            if (Settings.ServingTeam && Parent is null)
            {
                parts.Add("Serving team");
            }
            parts.Add(MinistriesService.JoinLabel(Settings.Join));
            return string.Join(" · ", parts);
        }
    }

    private string MemberLine => Settings.Join == JoinMode.Open
        ? "You see its members-only news and chats. Leave any time."
        : $"You see its members-only news, rosters and chats. Leaving tells {LeaderNames}, and takes you off future rosters.";

    private RenderFragment JoinButton => Settings.Join switch
    {
        JoinMode.Open => @<button class="btn btn--on-masthead" @onclick="Join"><Icon Name="user-plus" Size="IconSize.Small" />Join</button>,
        JoinMode.Ask when Ministries.HasAsked(ministry!) => @<span class="hero-note"><Icon Name="check" Size="IconSize.ExtraSmall" />Asked to join. The leaders will be in touch.</span>,
        JoinMode.Ask => @<button class="btn btn--on-masthead" @onclick="() => askOpen = true"><Icon Name="user-plus" Size="IconSize.Small" />Ask to join</button>,
        _ when Ministries.HasMessaged(ministry!) => @<span class="hero-note"><Icon Name="check" Size="IconSize.ExtraSmall" />Message sent to the leaders</span>,
        _ => @<button class="btn btn--on-masthead" @onclick="() => askOpen = true"><Icon Name="message-square" Size="IconSize.Small" />Message the leaders</button>,
    };

    private MinistryArea? requested;

    private ViewingSplit Split => Ministries.Split;

    private FeedScope PublicScope => Split == ViewingSplit.Marked ? FeedScope.All : FeedScope.Everyone;

    private Marking PublicMarking => Split == ViewingSplit.Marked ? Marking.MembersOnly : Marking.None;

    private bool RosterOn => Member && Ministries.Has(ministry!, MinistryModule.Rosters);

    private bool ChatsOn => Member && Ministries.Has(ministry!, MinistryModule.Chats) && Ministries.ChatsAllowed(ministry!);

    private bool TeamFeedOn => Member && (Ministries.Has(ministry!, MinistryModule.Announcements) || Ministries.Has(ministry!, MinistryModule.Calendar) || Ministries.Has(ministry!, MinistryModule.Files));

    private IReadOnlyList<MinistryArea> Areas
    {
        get
        {
            var areas = new List<MinistryArea> { MinistryArea.About };
            void Add(MinistryArea area, bool on)
            {
                if (on)
                {
                    areas.Add(area);
                }
            }
            Add(MinistryArea.News, Ministries.Has(ministry!, MinistryModule.Announcements) && (Leader || Posts(PublicScope).Count > 0));
            Add(MinistryArea.Calendar, Ministries.Has(ministry!, MinistryModule.Calendar) && (Leader || Events(PublicScope).Count > 0));
            if (Split == ViewingSplit.Marked)
            {
                Add(MinistryArea.Roster, RosterOn);
                Add(MinistryArea.Chats, ChatsOn);
            }
            Add(MinistryArea.Files, Ministries.Has(ministry!, MinistryModule.Files) && (Leader || Files(PublicScope).Count > 0));
            if (Split == ViewingSplit.TeamTabs)
            {
                Add(MinistryArea.Team, TeamFeedOn);
                Add(MinistryArea.Roster, RosterOn);
                Add(MinistryArea.Chats, ChatsOn);
            }
            return areas;
        }
    }

    private MinistryArea Current => requested switch
    {
        { } area when Areas.Contains(area) => area,
        MinistryArea.Team when Areas.Contains(MinistryArea.News) => MinistryArea.News,
        _ => MinistryArea.About,
    };

    private IReadOnlyList<Choice<string>> Tabs => [.. Areas.Select(a => new Choice<string>(a.Slug(), AreaLabel(a)))];

    private IReadOnlyCollection<string> LockedTabs => [.. Areas.Where(a => a.IsTeam()).Select(a => a.Slug())];

    private string AreaHref(string slug) => MinistryAreas.Path(Id, MinistryAreas.Parse(slug) ?? MinistryArea.About);

    private static string AreaLabel(MinistryArea area) => area switch
    {
        MinistryArea.About => "About",
        MinistryArea.News => "News",
        MinistryArea.Calendar => "Calendar",
        MinistryArea.Files => "Files",
        MinistryArea.Team => "Team",
        MinistryArea.Roster => "Roster",
        _ => "Chats",
    };

    private Audience DefaultAudience => Split switch
    {
        ViewingSplit.TeamRoom => Audience.Everyone,
        ViewingSplit.TeamTabs => Current.IsTeam() ? Audience.Members : Audience.Everyone,
        _ => Audience.Members,
    };

    private RenderFragment AreaContent => Current switch
    {
        MinistryArea.News => @<text>
            @Band(false)
            <Section First="true"><PostList Ministry="ministry!" Posts="Posts(PublicScope)" Marking="PublicMarking" /></Section>
        </text>,
        MinistryArea.Calendar => @<text>
            @Band(false)
            <Section First="true"><EventList Ministry="ministry!" Events="Events(PublicScope)" Marking="PublicMarking" /></Section>
        </text>,
        MinistryArea.Files => @<text>
            @Band(false)
            <Section First="true"><FileList Files="Files(PublicScope)" Marking="PublicMarking" /></Section>
        </text>,
        MinistryArea.Team => @<text>
            @Band(true)
            @TeamFeed
        </text>,
        MinistryArea.Roster => @<text>
            @Band(true)
            <RosterView Ministry="ministry!" OnSaved="Sent" />
        </text>,
        MinistryArea.Chats => @<text>
            @Band(true)
            <Section First="true"><ChatList Ministry="ministry!" /></Section>
        </text>,
        _ => Overview,
    };

    private RenderFragment Band(bool team) => @<text>
        @if (Split == ViewingSplit.TeamTabs && Member)
        {
            <div class="area-band @(team ? "area-band--team" : "")">
                <Icon Name="@(team ? "lock" : "globe")" Size="IconSize.Small" />
                <span><strong>@(team ? "Team only" : "For everyone")</strong> · @BandLine(team)</span>
            </div>
        }
    </text>;

    private string BandLine(bool team) =>
        !team ? "anyone with the app sees this"
        : MinistriesService.Children(ministry!).Count > 0 ? $"only members of {ministry!.Name} and its teams see this"
        : $"only {ministry!.Name} members see this";

    private RenderFragment TeamFeed => @<text>
        @if (!HasAny(FeedScope.Members))
        {
            <Section First="true"><p class="muted small">No team notices, events or files yet.</p></Section>
        }
        @if (Ministries.Has(ministry!, MinistryModule.Announcements) && Posts(FeedScope.Members) is { Count: > 0 } posts)
        {
            <Section Title="Notices" First="true"><PostList Ministry="ministry!" Posts="posts" /></Section>
        }
        @if (Ministries.Has(ministry!, MinistryModule.Calendar) && Events(FeedScope.Members) is { Count: > 0 } events)
        {
            <Section Title="Team dates"><EventList Ministry="ministry!" Events="events" /></Section>
        }
        @if (Ministries.Has(ministry!, MinistryModule.Files) && Files(FeedScope.Members) is { Count: > 0 } files)
        {
            <Section Title="Team files"><FileList Files="files" /></Section>
        }
    </text>;

    private RenderFragment Overview => @<text>
        @if (Member && Split == ViewingSplit.TeamRoom)
        {
            <Section First="true">
                <a class="team-door" href="@($"ministries/{Id}/team")" style="--band: @ministry!.Colour">
                    <span class="team-door__icon"><Icon Name="door-open" /></span>
                    <span class="team-door__body">
                        <strong>@ministry.Name team room</strong>
                        <span>@DoorLine</span>
                    </span>
                    <Icon Name="chevron-right" Size="IconSize.Small" />
                </a>
            </Section>
        }
        else if (HasLead)
        {
            <Section First="true">
                <div class="stack"><YourSlots Ministry="ministry" Limit="1" /></div>
                @if (Areas.Contains(MinistryArea.Roster))
                {
                    <a class="link-btn overview-link" href="@AreaHref(MinistryArea.Roster.Slug())">Full roster<Icon Name="chevron-right" Size="IconSize.Small" /></a>
                }
            </Section>
        }
        @if (Member)
        {
            @NextUp
        }
        <MinistryAbout Ministry="ministry!" First="!Member || (!HasLead && NextEvent is null)" />
        @if (!Member)
        {
            @NextUp
            @Teaser
        }
        @Teams
    </text>;

    private bool HasLead => Member && (Split == ViewingSplit.TeamRoom || Ministries.YourSlotsIn(ministry!).Count > 0);

    private MinistryEvent? NextEvent => Ministries.Has(ministry!, MinistryModule.Calendar) ? Ministries.Events(ministry!).FirstOrDefault() : null;

    private RenderFragment NextUp => @<text>
        @if (NextEvent is { } next)
        {
            <Section Title="Next up" First="Member && !HasLead"
                     LinkText="@(Areas.Contains(MinistryArea.Calendar) ? "Calendar" : null)" LinkHref="@(Areas.Contains(MinistryArea.Calendar) ? AreaHref(MinistryArea.Calendar.Slug()) : null)">
                <EventList Ministry="ministry!" Events="[next]" Marking="Marking.MembersOnly" />
            </Section>
        }
    </text>;

    private RenderFragment Teams => @<text>
        @if (MinistriesService.Children(ministry!) is { Count: > 0 } children)
        {
            <Section Title="@($"Teams in {ministry!.Name}")">
                <p class="section__lead">@ministry.Name's leaders lead these teams too, and @ministry.Name announcements reach all of them.</p>
                <div class="list">
                    @foreach (var child in children)
                    {
                        <MinistryRow @key="child.Id" Ministry="child" />
                    }
                </div>
            </Section>
        }
    </text>;

    private RenderFragment Teaser => @<Section>
        <div class="callout teaser">
            <strong><Icon Name="lock" Size="IconSize.Small" />Members see more</strong>
            <span>@LockedLine</span>
        </div>
    </Section>;

    private string LockedLine
    {
        get
        {
            var extras = new List<string>();
            if (Ministries.MembersOnlyCount(ministry!) is var count and > 0)
            {
                extras.Add($"{count} team notices, events and files");
            }
            if (Ministries.Has(ministry!, MinistryModule.Rosters))
            {
                extras.Add("the roster");
            }
            if (Ministries.Has(ministry!, MinistryModule.Chats) && Ministries.ChatsAllowed(ministry!))
            {
                extras.Add("chats");
            }
            var what = extras.Count == 0 ? "team notices" : extras.Count == 1 ? extras[0] : $"{string.Join(", ", extras.Take(extras.Count - 1))} and {extras[^1]}";
            var how = Settings.Join switch
            {
                JoinMode.Open => "Tap Join to see them.",
                JoinMode.Ask => "Ask to join and a leader will be in touch.",
                _ => "Leaders invite people to this team.",
            };
            return $"Members see {what}. {how}";
        }
    }

    private string DoorLine
    {
        get
        {
            var parts = new List<string>();
            if (Ministries.YourSlotsIn(ministry!).FirstOrDefault() is { } slot)
            {
                parts.Add($"You're on {slot.Date.Start:d MMM}");
            }
            var notices = Ministries.Posts(ministry!).Count(p => p.Audience == Audience.Members);
            if (notices > 0)
            {
                parts.Add(MinistriesService.Count(notices, "team notice"));
            }
            var chats = Ministries.Chats(ministry!).Count();
            if (chats > 0 && Ministries.Has(ministry!, MinistryModule.Chats))
            {
                parts.Add(MinistriesService.Count(chats, "chat"));
            }
            return parts.Count > 0 ? string.Join(" · ", parts) : "Team notices, rosters and files";
        }
    }

    private IReadOnlyList<MinistryPost> Posts(FeedScope scope) => Ministries.Posts(ministry!).Where(p => scope.Includes(p.Audience)).ToList();

    private IReadOnlyList<MinistryEvent> Events(FeedScope scope) => Ministries.Events(ministry!).Where(e => scope.Includes(e.Audience)).ToList();

    private IReadOnlyList<MinistryFile> Files(FeedScope scope) => Ministries.Files(ministry!).Where(f => scope.Includes(f.Audience)).ToList();

    private bool HasAny(FeedScope scope) =>
        (Ministries.Has(ministry!, MinistryModule.Announcements) && Posts(scope).Count > 0)
        || (Ministries.Has(ministry!, MinistryModule.Calendar) && Events(scope).Count > 0)
        || (Ministries.Has(ministry!, MinistryModule.Files) && Files(scope).Count > 0);

    protected override async Task OnInitializedAsync()
    {
        Ministries.Changed += Refresh;
        await Ministries.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        ministry = MinistriesService.Find(Id);
        requested = MinistryAreas.Parse(Area);
        Redirect();
    }

    private void Redirect()
    {
        if (ministry?.Kind == MinistryKind.LifeGroup)
        {
            Navigation.NavigateTo($"groups/{Id}", replace: true);
        }
        else if (ministry is not null && Split == ViewingSplit.TeamRoom && requested is { } area && area.IsTeam())
        {
            Navigation.NavigateTo(MinistryAreas.Path(Id, area, inTeamRoom: true), replace: true);
        }
    }

    private void Compose(Audience audience)
    {
        composeAudience = audience;
        composeOpen = true;
    }

    private Task Sent(string message) => toast.ShowAsync(message);

    private async Task Join()
    {
        await Native.HapticAsync(Haptic.Success);
        await Ministries.JoinAsync(ministry!);
        await toast.ShowAsync($"You've joined {ministry!.Name}");
    }

    private async Task Leave()
    {
        await Native.HapticAsync(Haptic.Light);
        await Ministries.LeaveAsync(ministry!);
        memberOpen = false;
    }

    private async Task SendAsk()
    {
        await Native.HapticAsync(Haptic.Success);
        if (Settings.Join == JoinMode.Ask)
        {
            Ministries.AskToJoin(ministry!);
        }
        else
        {
            Ministries.MessageLeaders(ministry!);
        }
        askOpen = false;
        await toast.ShowAsync("Sent to the leaders");
    }

    private void Refresh() => InvokeAsync(() =>
    {
        Redirect();
        StateHasChanged();
    });

    public void Dispose() => Ministries.Changed -= Refresh;
}
