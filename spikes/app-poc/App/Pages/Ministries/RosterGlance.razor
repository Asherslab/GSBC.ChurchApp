@inject MinistriesService Ministries
@inject ChurchClock Clock

@if (Next is { } date)
{
    <div class="roster-glance">
        <p class="roster-glance__when">@Clock.Relative(date.Start) · @date.Start.ToString("d MMM"), @ChurchClock.Time(date.Start) · @date.Service</p>
        <dl>
            @foreach (var slot in date.Slots)
            {
                <div class="@(slot.People.Any(MinistriesService.IsYou) ? "roster-glance--you" : "")">
                    <dt>@slot.Position</dt>
                    <dd>@PeopleLine(slot)</dd>
                </div>
            }
        </dl>
    </div>
}
<div class="list">
    <ListRow Icon="roster" Title="@(Ministries.IsLeader(Ministry) ? "Roster and assigning" : "Full roster")" Subtitle="@Subtitle" Href="@($"ministries/{Ministry.Id}/roster")" />
</div>

@code {
    [Parameter, EditorRequired] public Ministry Ministry { get; set; } = default!;

    private RosterDate? Next => Ministries.Roster(Ministry).FirstOrDefault();

    private string Subtitle
    {
        get
        {
            var count = Ministries.Roster(Ministry).Count;
            var songs = Ministries.Roster(Ministry).Any(r => r.Songs.Count > 0) ? ", songs and practice recordings" : "";
            return $"{count} dates{songs} · from {MinistriesContent.Elvanto}";
        }
    }

    public static string PeopleLine(RosterSlot slot) =>
        slot.People.Count == 0 ? "Not filled" : string.Join(", ", slot.People.Select(p => MinistriesService.IsYou(p) ? "You" : p.Name));
}
