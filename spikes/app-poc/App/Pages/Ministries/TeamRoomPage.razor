@page "/ministries/{Id}/team"
@page "/ministries/{Id}/team/{Area}"
@inject NavigationManager Navigation
@implements IDisposable
@inject MinistriesService Ministries

<Page Title="@($"{ministry?.Name} team")" BackHref="@($"ministries/{Id}")" BackLabel="@(ministry?.Name ?? "Back")" StuckAt="150" Bell="false">
    <Actions>
        <button class="icon-btn" @onclick="() => previewOpen = true" aria-label="Preview: viewing as and design"><Icon Name="eye" /></button>
        @if (ministry is not null && Ministries.IsLeader(ministry))
        {
            <a class="icon-btn" href="@($"ministries/{Id}/settings")" aria-label="Ministry settings"><Icon Name="sliders" /></a>
        }
    </Actions>
    <ChildContent>
        @if (ministry is null)
        {
            <EmptyState Icon="users" Title="This ministry isn't here any more" />
        }
        else if (!Ministries.IsMember(ministry))
        {
            <BandHero Title="@($"{ministry.Name} team")" Note="Team room" Colour="@ministry.Colour" Class="group-hero--team" />
            <EmptyState Icon="lock" Title="The team room is for members" Body="@($"Rosters, chats and team notices for {ministry.Name}. See the ministry page to join.")">
                <a class="btn btn--quiet" href="@($"ministries/{Id}")">Back to @ministry.Name</a>
            </EmptyState>
        }
        else
        {
            <BandHero Title="@($"{ministry.Name} team")" Colour="@ministry.Colour" Class="group-hero--team">
                <ChildContent>
                    <p class="team-badge"><Icon Name="lock" Size="IconSize.ExtraSmall" />Team room · only @ministry.Name members see this</p>
                </ChildContent>
                <Actions>
                    @if (Ministries.IsLeader(ministry))
                    {
                        <button class="btn btn--on-masthead" @onclick="() => composeOpen = true"><Icon Name="plus" Size="IconSize.Small" />Post</button>
                    }
                    <a class="btn btn--ghost-masthead" href="@($"ministries/{Id}")"><Icon Name="globe" Size="IconSize.Small" />Public page</a>
                </Actions>
            </BandHero>

            @if (Areas.Count > 1)
            {
                <SectionTabs Items="Tabs" Selected="@Current.Slug()" Href="AreaHref" Label="@($"{ministry.Name} team room areas")" />
            }

            <div class="area" @key="Current">
                @switch (Current)
                {
                    case MinistryArea.Roster:
                        <RosterView Ministry="ministry" OnSaved="m => toast.ShowAsync(m)" />
                        break;
                    case MinistryArea.Chats:
                        <Section First="true"><ChatList Ministry="ministry" /></Section>
                        break;
                    case MinistryArea.Calendar:
                        <Section First="true"><EventList Ministry="ministry" Events="Ministries.Events(ministry).ToList()" Marking="Marking.Public" /></Section>
                        break;
                    case MinistryArea.Files:
                        <Section First="true"><FileList Files="Ministries.Files(ministry).ToList()" Marking="Marking.Public" /></Section>
                        break;
                    default:
                        @if (Ministries.YourSlotsIn(ministry).Count > 0)
                        {
                            <Section First="true"><div class="stack"><YourSlots Ministry="ministry" Limit="1" /></div></Section>
                        }
                        <Section First="Ministries.YourSlotsIn(ministry).Count == 0" Title="@(Ministries.YourSlotsIn(ministry).Count > 0 ? "Notices" : null)">
                            <PostList Ministry="ministry" Posts="Ministries.Posts(ministry).ToList()" Marking="Marking.Public" />
                        </Section>
                        break;
                }
            </div>
            <PreviewFooter />
        }
    </ChildContent>
</Page>

@if (ministry is not null)
{
    <ComposeSheet Open="composeOpen" OpenChanged="v => composeOpen = v" Ministry="ministry" DefaultAudience="Audience.Members" OnSent="m => toast.ShowAsync(m)" />
}
<PreviewSheet @bind-Open="previewOpen" />
<Toast @ref="toast" />

@code {
    [Parameter] public string Id { get; set; } = "";

    private Ministry? ministry;
    private Toast toast = default!;
    private bool previewOpen;
    private bool composeOpen;

    [Parameter] public string? Area { get; set; }

    private MinistryArea? requested;

    private IReadOnlyList<MinistryArea> Areas
    {
        get
        {
            var areas = new List<MinistryArea>();
            void Add(MinistryArea area, MinistryModule module, bool on = true)
            {
                if (on && Ministries.Has(ministry!, module))
                {
                    areas.Add(area);
                }
            }
            Add(MinistryArea.News, MinistryModule.Announcements);
            Add(MinistryArea.Roster, MinistryModule.Rosters);
            Add(MinistryArea.Chats, MinistryModule.Chats, Ministries.ChatsAllowed(ministry!));
            Add(MinistryArea.Calendar, MinistryModule.Calendar);
            Add(MinistryArea.Files, MinistryModule.Files);
            return areas.Count == 0 ? [MinistryArea.News] : areas;
        }
    }

    private MinistryArea Current => requested is { } area && Areas.Contains(area) ? area : Areas[0];

    private IReadOnlyList<Choice<string>> Tabs => [.. Areas.Select(a => new Choice<string>(a.Slug(), AreaLabel(a)))];

    private string AreaHref(string slug) => MinistryAreas.Path(Id, MinistryAreas.Parse(slug) ?? MinistryArea.News, inTeamRoom: true);

    private static string AreaLabel(MinistryArea area) => area switch
    {
        MinistryArea.News => "Notices",
        MinistryArea.Roster => "Roster",
        MinistryArea.Chats => "Chats",
        MinistryArea.Calendar => "Calendar",
        _ => "Files",
    };

    protected override async Task OnInitializedAsync()
    {
        Ministries.Changed += Refresh;
        await Ministries.EnsureLoadedAsync();
    }

    protected override void OnParametersSet()
    {
        ministry = MinistriesService.Find(Id);
        requested = Area is null ? MinistryArea.News : MinistryAreas.Parse(Area);
        Redirect();
    }

    private void Redirect()
    {
        if (ministry is not null && Ministries.Split != ViewingSplit.TeamRoom)
        {
            var area = requested is null or MinistryArea.News ? MinistryArea.Team : requested.Value;
            Navigation.NavigateTo(MinistryAreas.Path(Id, area), replace: true);
        }
    }

    private void Refresh() => InvokeAsync(() =>
    {
        Redirect();
        StateHasChanged();
    });

    public void Dispose() => Ministries.Changed -= Refresh;
}
