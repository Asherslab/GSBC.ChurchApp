@page "/groups/{Id}"
@implements IDisposable
@inject LifeGroupsService Groups
@inject MinistriesService Ministries
@inject NativeBridge Native

<Page Title="@(group?.Name ?? "Life Group")" BackHref="groups" BackLabel="Groups" StuckAt="150" Bell="false">
    <Actions>
        @if (group is not null)
        {
            <button class="icon-btn" @onclick="Share" aria-label="Share"><Icon Name="share" /></button>
        }
    </Actions>
    <ChildContent>
        @if (group is null)
        {
            <EmptyState Icon="users" Title="This group has finished or moved" />
        }
        else
        {
            var round = LifeGroupsService.RoundOf(group);
            var sunday = Groups.NextSunday(group);
            var change = Groups.ChangeOn(group, sunday);
            var where = Groups.PlaceOn(group, sunday);
            <BandHero Title="@group.Name" Note="@Kicker(round)" Colour="@group.Colour">
                <Actions>
                    @if (Groups.IsFinished(group))
                    {
                        <span class="pill pill--quiet">Finished @round!.Last.ToString("d MMM")</span>
                    }
                    else if (Groups.IsJoined(group))
                    {
                        <button class="btn btn--ghost-masthead" @onclick="() => joinedOpen = true"><Icon Name="check" Size="IconSize.Small" />Joined</button>
                    }
                    else
                    {
                        <button class="btn btn--on-masthead" @onclick="Join"><Icon Name="bell-ring" Size="IconSize.Small" />@JoinLabel</button>
                    }
                    @if (where is not null)
                    {
                        <a class="btn btn--ghost-masthead" href="@WhereHref"><Icon Name="map-pin" Size="IconSize.Small" />Find the room</a>
                    }
                </Actions>
            </BandHero>

            @if (!Groups.IsFinished(group))
            {
                <Section First="true">
                    <div class="facts">
                        <div class="fact">
                            <Icon Name="clock" />
                            <div>
                                <strong>@Groups.WhenLabel(sunday)</strong>
                                @if (change is not null)
                                {
                                    <span class="session__note">@change.Summary</span>
                                }
                                else
                                {
                                    <span>Until 9:45, then the morning service at 10:30</span>
                                }
                            </div>
                        </div>
                    </div>
                </Section>
            }

            <MinistryAbout Ministry="group" First="Groups.IsFinished(group)" ShowWhoFor="false" />

            <Section Title="Where" LinkText="Find the room" LinkHref="@WhereHref">
                @if (where is { } shown)
                {
                    <div class="where">
                        <a href="@WhereHref" aria-label="Find the room on the site map">
                            <SiteMap Marks="[Groups.MarkFor(group, shown)]" Around="shown" SelectedPlaceId="@shown.Id" />
                        </a>
                        <PlaceChip Label="@($"Room {Groups.NumberAt(group, shown)} · {shown.Name}")" Number="@Groups.NumberAt(group, shown).ToString()" Colour="@group.Colour" />
                        @if (change?.MovedToPlaceId is not null)
                        {
                            <p class="hint">Moved for @sunday.ToString("d MMMM") only.</p>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">The room will be confirmed before the first Sunday.</p>
                }
            </Section>

            <Section Title="@(round is null ? "Coming Sundays" : $"{round.Name} Sundays")">
                <EventList Ministry="group" Events="Sessions(round)" PastBefore="Groups.Now" MarkNext="!Groups.IsFinished(group)" />
            </Section>

            <Section Title="Notices">
                <PostList Ministry="group" Posts="Ministries.Posts(group).ToList()" Empty="No notices yet." />
            </Section>

            <Section Title="Resources">
                <FileList Files="Ministries.Files(group).ToList()" />
            </Section>

            <PreviewFooter />
        }
    </ChildContent>
</Page>

@if (group is not null)
{
    <MembershipSheet Ministry="group" @bind-Open="joinedOpen" Title="@(justJoined ? "You've joined" : "You're in this group")" Line="@JoinedLine"
                     NotifyLine="Notices from the leaders: a moved room, no class this week" LeaveLabel="Leave this group" OnLeave="Leave">
        <ChildContent>
            <ToggleRow Title="Remind me on Sundays" Description="A nudge at 8:30 with the room" Checked="Groups.HasReminder(group)" CheckedChanged="on => Groups.SetReminderAsync(group, on)" />
        </ChildContent>
        <Actions>
            <button class="btn btn--primary btn--block" @onclick="PreviewNotice"><Icon Name="bell" Size="IconSize.Small" />@previewLabel</button>
        </Actions>
    </MembershipSheet>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private Ministry? group;
    private bool joinedOpen;
    private bool justJoined;
    private string previewLabel = "Preview a notice from this group";

    private string JoinLabel => group!.LifeGroup?.ParentsJoin == true ? "Join as a parent" : "Join";

    private string JoinedLine
    {
        get
        {
            var from = group!.Leaders.Count > 0 ? string.Join(" & ", group.Leaders.Select(l => l.Name)) : "the leaders";
            return $"Notices from {from} arrive on this phone. No account needed; leaders see how many have joined, not who.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Groups.Changed += Refresh;
        await Groups.EnsureLoadedAsync();
    }

    protected override void OnParametersSet() => group = LifeGroupsService.Find(Id);

    private string Kicker(LifeGroupRound? round)
    {
        var who = group!.WhoFor is { } audience ? $"{audience} · " : "";
        return round is null ? $"{who}All year" : $"{who}{round.Name} · {round.Dates}";
    }

    private const int UpcomingAllYear = 4;

    private string WhereHref => $"groups/{Id}/room";

    private IReadOnlyList<MinistryEvent> Sessions(LifeGroupRound? round) =>
        Ministries.Events(group!, withPast: round is not null).Take(round is null ? UpcomingAllYear : int.MaxValue).ToList();

    private async Task Join()
    {
        await Native.HapticAsync(Haptic.Success);
        await Groups.SetJoinedAsync(group!, true);
        justJoined = true;
        joinedOpen = true;
    }

    private async Task Leave()
    {
        await Native.HapticAsync(Haptic.Light);
        await Groups.SetJoinedAsync(group!, false);
        joinedOpen = false;
        justJoined = false;
    }

    private async Task PreviewNotice()
    {
        var result = await Native.ScheduleNotificationAsync(group!.Name, "Sample notice: we're in a different room this Sunday. Tap to see where.", 5);
        previewLabel = result switch
        {
            "scheduled" => "Arriving in 5 seconds; lock your phone",
            "web" => "Notifications only show on the phone",
            _ => $"Not allowed ({result})",
        };
    }

    private Task Share() =>
        Native.ShareAsync(group!.Name, $"{group.Name}: Life Groups at Good Shepherd, Sundays 9am", SampleContent.Website).AsTask();

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Groups.Changed -= Refresh;
}
