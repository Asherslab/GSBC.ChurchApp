@inject LifeGroupsService Groups

<BandCard Title="@Group.Name" Href="@($"groups/{Group.Id}")" Colour="@Group.Colour" Blurb="@Group.Summary" Quiet="Quiet">
    <Badge>
        @if (Groups.IsJoined(Group) && !Quiet)
        {
            <span class="pill"><Icon Name="check" Size="IconSize.ExtraSmall" />Joined</span>
        }
        else if (Group.WhoFor is not null)
        {
            <span class="pill pill--quiet">@Group.WhoFor</span>
        }
    </Badge>
    <Footer>
        <People Persons="Group.Leaders" />
        <PlaceChip Label="@Room" Number="@(LifeGroupsService.PlaceOf(Group) is null ? null : LifeGroupsService.MapNumber(Group).ToString())" Colour="@Group.Colour" />
    </Footer>
</BandCard>

@code {
    [Parameter, EditorRequired] public Ministry Group { get; set; } = default!;
    [Parameter] public bool Quiet { get; set; }

    private string Room => LifeGroupsService.PlaceOf(Group)?.Name ?? "Room to be confirmed";
}
