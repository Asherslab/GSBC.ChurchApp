@using System.Text
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject OutreachService Outreach

<div class="planner-map-wrap">
    <div class="planner-map" @ref="element" role="application" aria-label="Map for drawing an outreach area and editing its routes"></div>
    <div class="planner-overlay">@Overlay</div>
</div>

@code {
    private const string Attribution = "© OpenFreeMap · Addresses © State of Queensland";

    [Parameter] public IReadOnlyList<GeoPoint> Polygon { get; set; } = [];
    [Parameter] public bool Closed { get; set; }
    [Parameter] public GeoPoint Meeting { get; set; }
    [Parameter] public AreaSelection? Selection { get; set; }
    [Parameter] public IReadOnlyList<SectionSummary> Sections { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Palette { get; set; } = [];
    [Parameter] public IReadOnlySet<DraftSection> Chosen { get; set; } = new HashSet<DraftSection>();
    [Parameter] public DraftSection? Active { get; set; }
    [Parameter] public RouteDraft? Draft { get; set; }
    [Parameter] public MapTool Tool { get; set; }
    [Parameter] public RenderFragment? Overlay { get; set; }
    [Parameter] public string Mode { get; set; } = "select";
    [Parameter] public int FitVersion { get; set; }
    [Parameter] public IReadOnlyList<ExclusionZone> Zones { get; set; } = [];
    [Parameter] public IReadOnlyList<PlannerPin> Pins { get; set; } = [];
    [Parameter] public GeoPoint? Focus { get; set; }
    [Parameter] public int FocusVersion { get; set; }
    [Parameter] public EventCallback<GeoPoint> OnPoint { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public EventCallback<GeoPoint> OnMeeting { get; set; }
    [Parameter] public EventCallback<RoutePick> OnRoute { get; set; }
    [Parameter] public EventCallback<MapStroke> OnStroke { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<GeoPoint>> OnCut { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<GeoPoint>> OnLasso { get; set; }
    [Parameter] public EventCallback<StartMove> OnStart { get; set; }
    [Parameter] public EventCallback<string> OnShortcut { get; set; }

    private ElementReference element;
    private DotNetObjectReference<PlannerMap>? self;
    private Task? attaching;
    private int fittedVersion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Outreach.Map is null)
        {
            return;
        }
        if (self is null)
        {
            self = DotNetObjectReference.Create(this);
            attaching = JS.InvokeVoidAsync("gsbc.plannerMap.attach", element, self, Meeting.Lat, Meeting.Lon, Attribution).AsTask();
        }
        await attaching!;
        var fit = FitVersion != fittedVersion;
        fittedVersion = FitVersion;
        await JS.InvokeVoidAsync("gsbc.plannerMap.update", element, Json(), Mode, Tool.ToString().ToLowerInvariant(), fit);
    }

    [JSInvokable]
    public Task MapClicked(double lat, double lon) => OnPoint.InvokeAsync(new GeoPoint(lat, lon));

    [JSInvokable]
    public Task DrawFinished() => OnFinish.InvokeAsync();

    [JSInvokable]
    public Task MeetingSet(double lat, double lon) => OnMeeting.InvokeAsync(new GeoPoint(lat, lon));

    [JSInvokable]
    public Task RoutePicked(int route, bool add) => OnRoute.InvokeAsync(new RoutePick(route, add));

    [JSInvokable]
    public Task StrokeFinished(string tool, double[] stretches) =>
        OnStroke.InvokeAsync(new MapStroke(tool == "eraser" ? MapTool.Eraser : MapTool.Brush, Stretches(stretches)));

    [JSInvokable]
    public string BrushPreview(string tool, double[] stretches)
    {
        var erasing = tool == "eraser";
        var boxes = Draft?.Moving(erasing ? null : Active, Stretches(stretches)) ?? 0;
        return erasing ? $"{boxes} letterboxes out" : $"{boxes} letterboxes into route {Draft!.Number(Active!)}";
    }

    [JSInvokable]
    public Task CutFinished(double[] line) => OnCut.InvokeAsync(Points(line));

    [JSInvokable]
    public Task LassoFinished(double[] loop) => OnLasso.InvokeAsync(Points(loop));

    [JSInvokable]
    public Task StartMoved(int route, double lat, double lon) => OnStart.InvokeAsync(new StartMove(route, new GeoPoint(lat, lon)));

    [JSInvokable]
    public Task Shortcut(string key) => OnShortcut.InvokeAsync(key);

    [JSInvokable]
    public string CutPreview(double[] line)
    {
        var previews = Draft?.PreviewCut(Points(line)) ?? [];
        return Write(json =>
        {
            json.WriteBoolean("touches", previews.Count == 0 && Draft?.CutTouches(Points(line)) == true);
            json.WriteStartArray("routes");
            foreach (var preview in previews)
            {
                json.WriteStartObject();
                json.WriteNumber("route", Draft!.Sections.IndexOf(preview.Route));
                json.WriteNumber("number", Draft.Number(preview.Route));
                json.WriteString("keptColor", Colour(preview.Route.Colour));
                json.WriteNumber("keptBoxes", Outreach.Letterboxes(preview.Kept));
                Edges(json, "kept", preview.Kept);
                json.WriteStartArray("pieces");
                foreach (var piece in preview.Pieces)
                {
                    json.WriteStartObject();
                    json.WriteString("color", Colour(piece.Colour));
                    json.WriteNumber("boxes", Outreach.Letterboxes(piece.Edges));
                    Edges(json, "edges", piece.Edges);
                    json.WriteEndObject();
                }
                json.WriteEndArray();
                json.WriteEndObject();
            }
            json.WriteEndArray();
        });
    }

    [JSInvokable]
    public string LassoPreview(double[] loop)
    {
        var captured = Draft?.Lassoed(Active, Points(loop), Outreach.Planner!) ?? [];
        return Write(json =>
        {
            Edges(json, "edges", captured);
            json.WriteNumber("boxes", Outreach.Letterboxes(captured));
            json.WriteString("color", Active is null ? Colour(NewColour) : Colour(Active.Colour));
            json.WriteString("into", Active is null ? "a new route" : $"route {Draft!.Number(Active)}");
        });
    }

    [JSInvokable]
    public double[] SnapStart(int route, double lat, double lon)
    {
        if (Draft is null || route < 0 || route >= Draft.Sections.Count)
        {
            return [];
        }
        var node = Outreach.Planner!.Node(Outreach.Editor!.NearestNode(Draft.Sections[route], new GeoPoint(lat, lon)));
        return [node.Lon, node.Lat];
    }

    private int NewColour => Enumerable.Range(0, Palette.Count).MinBy(c => (Draft!.Sections.Count(s => s.Colour == c), c));

    private string Colour(int index) => Palette[index % Palette.Count];

    private static List<Stretch> Stretches(double[] flat) =>
        Enumerable.Range(0, flat.Length / 3).Select(i => new Stretch((int)flat[3 * i], flat[3 * i + 1], flat[3 * i + 2])).ToList();

    private static Dictionary<int, List<(double From, double To)>> Coverage(StreetNetwork net, IEnumerable<int> edges) =>
        edges.GroupBy(e => net[e].Street).ToDictionary(g => g.Key, g => g.Select(e => (net[e].From, net[e].To)).ToList());

    private static bool Covered(Dictionary<int, List<(double From, double To)>> coverage, Piece piece) =>
        coverage.TryGetValue(piece.Street, out var spans) && spans.Any(s => s.From <= piece.From + 1e-6 && s.To >= piece.To - 1e-6);

    private static List<GeoPoint> Points(double[] flat) =>
        Enumerable.Range(0, flat.Length / 2).Select(i => new GeoPoint(flat[2 * i + 1], flat[2 * i])).ToList();

    private static void Edges(Utf8JsonWriter json, string name, IEnumerable<int> edges)
    {
        json.WriteStartArray(name);
        foreach (var edge in edges)
        {
            json.WriteNumberValue(edge);
        }
        json.WriteEndArray();
    }

    private static string Write(Action<Utf8JsonWriter> body)
    {
        using var buffer = new MemoryStream();
        using (var json = new Utf8JsonWriter(buffer))
        {
            json.WriteStartObject();
            body(json);
            json.WriteEndObject();
        }
        return Encoding.UTF8.GetString(buffer.ToArray());
    }

    private static string Muted(string hex)
    {
        const double grey = 0x96;
        const double keep = 0.4;
        var channels = Enumerable.Range(0, 3).Select(i => (int)Math.Round(Convert.ToInt32(hex.Substring(1 + 2 * i, 2), 16) * keep + grey * (1 - keep)));
        return "#" + string.Concat(channels.Select(c => c.ToString("x2", System.Globalization.CultureInfo.InvariantCulture)));
    }

    private string Json()
    {
        var net = Outreach.Network!;
        var planner = Outreach.Planner!;
        var owner = new Dictionary<int, int>();
        var walkThrough = new HashSet<int>();
        for (var i = 0; i < Sections.Count; i++)
        {
            foreach (var edge in Sections[i].Section.Edges)
            {
                owner[edge] = i;
            }
            walkThrough.UnionWith(Sections[i].WalkThrough);
        }
        using var buffer = new MemoryStream();
        using (var json = new Utf8JsonWriter(buffer))
        {
            json.WriteStartObject();
            json.WriteNumber("points", Polygon.Count);
            if (Polygon.Count > 0)
            {
                json.WritePropertyName("first");
                Point(json, Polygon[0]);
            }

            Collection(json, "area", () =>
            {
                if (Closed && Polygon.Count >= 3)
                {
                    Feature(json, "Polygon", () =>
                    {
                        json.WriteStartArray();
                        foreach (var p in Polygon.Append(Polygon[0]))
                        {
                            Point(json, p);
                        }
                        json.WriteEndArray();
                    });
                }
                if (Polygon.Count >= 2)
                {
                    Feature(json, "LineString", () =>
                    {
                        foreach (var p in Closed ? Polygon.Append(Polygon[0]) : Polygon)
                        {
                            Point(json, p);
                        }
                    });
                }
                if (!Closed)
                {
                    foreach (var p in Polygon)
                    {
                        Feature(json, "Point", () => { json.WriteNumberValue(p.Lon); json.WriteNumberValue(p.Lat); });
                    }
                }
            });

            Collection(json, "streets", () =>
            {
                if (Selection is null)
                {
                    return;
                }
                var cuts = Draft?.Cuts() ?? new Dictionary<int, double[]>();
                var selected = Selection.Fresh.Concat(Selection.Rested).ToHashSet();
                var through = Coverage(net, walkThrough);
                var drawn = Selection.Fresh.Select(e => (e, false))
                    .Concat(Selection.Rested.Select(e => (e, true)))
                    .SelectMany(x => (Draft?.PiecesOf(x.e, cuts) ?? [x.e]).Select(p => (p, x.Item2)))
                    .Concat(walkThrough.Where(e => !selected.Contains(net[e].Street)).Select(e => (e, true)));
                foreach (var (edge, rested) in drawn)
                {
                    var piece = net[edge];
                    var kind = owner.ContainsKey(edge) ? "section" : Covered(through, piece) ? "through" : rested ? "rested" : Sections.Count > 0 ? "unassigned" : "free";
                    Feature(json, "LineString", () =>
                    {
                        foreach (var point in piece.Line)
                        {
                            json.WriteStartArray();
                            json.WriteNumberValue(point[0]);
                            json.WriteNumberValue(point[1]);
                            json.WriteEndArray();
                        }
                    }, properties: () =>
                    {
                        json.WriteNumber("edge", edge);
                        json.WriteNumber("street", piece.Street);
                        json.WriteNumber("from", piece.From);
                        json.WriteNumber("to", piece.To);
                        json.WriteNumber("length", piece.Whole.Length);
                        json.WriteString("kind", kind);
                        json.WriteNumber("boxes", Outreach.Count(edge, 0) + Outreach.Count(edge, 1));
                        if (owner.TryGetValue(edge, out var section))
                        {
                            var colour = Colour(Sections[section].Section.Colour);
                            json.WriteNumber("route", section);
                            json.WriteString("color", colour);
                            json.WriteString("muted", Muted(colour));
                            json.WriteBoolean("selected", Chosen.Contains(Sections[section].Section));
                        }
                    });
                }
            });

            Collection(json, "starts", () =>
            {
                for (var i = 0; i < Sections.Count; i++)
                {
                    var start = planner.Node(Sections[i].Plan.StartNode);
                    var colour = Colour(Sections[i].Section.Colour);
                    var route = i;
                    Feature(json, "Point", () => { json.WriteNumberValue(start.Lon); json.WriteNumberValue(start.Lat); }, properties: () =>
                    {
                        json.WriteNumber("route", route);
                        json.WriteString("color", colour);
                    });
                }
            });
            json.WriteBoolean("anySelected", Chosen.Count > 0);
            json.WriteNumber("cosLat", net.CosLat);
            if (Active is not null)
            {
                json.WriteString("activeColor", Colour(Active.Colour));
            }

            Collection(json, "meeting", () => Feature(json, "Point", () => { json.WriteNumberValue(Meeting.Lon); json.WriteNumberValue(Meeting.Lat); }));

            Collection(json, "zones", () =>
            {
                foreach (var zone in Zones)
                {
                    Feature(json, "Polygon", () =>
                    {
                        json.WriteStartArray();
                        foreach (var p in zone.Polygon.Append(zone.Polygon[0]))
                        {
                            Point(json, p.Point);
                        }
                        json.WriteEndArray();
                    });
                }
            });

            Collection(json, "pins", () =>
            {
                foreach (var pin in Pins)
                {
                    Feature(json, "Point", () => { json.WriteNumberValue(pin.Point.Lon); json.WriteNumberValue(pin.Point.Lat); }, properties: () => json.WriteString("kind", pin.Kind));
                }
            });

            json.WriteNumber("focusVersion", FocusVersion);
            if (Focus is { } focus)
            {
                json.WritePropertyName("focus");
                Point(json, focus);
            }
            json.WriteEndObject();
        }
        return Encoding.UTF8.GetString(buffer.ToArray());
    }

    private static void Point(Utf8JsonWriter json, GeoPoint point)
    {
        json.WriteStartArray();
        json.WriteNumberValue(point.Lon);
        json.WriteNumberValue(point.Lat);
        json.WriteEndArray();
    }

    private static void Collection(Utf8JsonWriter json, string name, Action features)
    {
        json.WriteStartObject(name);
        json.WriteString("type", "FeatureCollection");
        json.WriteStartArray("features");
        features();
        json.WriteEndArray();
        json.WriteEndObject();
    }

    private static void Feature(Utf8JsonWriter json, string type, Action coordinates, Action? properties = null)
    {
        json.WriteStartObject();
        json.WriteString("type", "Feature");
        json.WriteStartObject("properties");
        properties?.Invoke();
        json.WriteEndObject();
        json.WriteStartObject("geometry");
        json.WriteString("type", type);
        json.WriteStartArray("coordinates");
        coordinates();
        json.WriteEndArray();
        json.WriteEndObject();
        json.WriteEndObject();
    }

    public async ValueTask DisposeAsync()
    {
        if (self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("gsbc.plannerMap.detach", element);
            }
            catch (JSDisconnectedException)
            {
            }
            self.Dispose();
        }
    }
}
