@page "/staff/outreach-planner"
@using System.Globalization
@implements IDisposable
@inject OutreachService Outreach
@inject NativeBridge Native
@inject IJSRuntime JS

<Page Title="Outreach planner" TopBar="TopBarStyle.Solid" TitleAlwaysShown="true" Bell="false">
    <div class="planner">
        <div class="planner__map">
            @if (Outreach.Map is not null)
            {
                <PlannerMap Polygon="@(ZoneActive ? zoneDraft : polygon)" Closed="@(ZoneActive ? zoneClosed : closed)" Meeting="MeetingPoint" Selection="selection" Sections="summaries" Palette="Palette"
                            Chosen="chosen" Active="Active" Draft="draft" Tool="@(ToolsLive ? tool : MapTool.Select)" Mode="@MapMode" FitVersion="fitVersion" Zones="Outreach.Zones" Pins="Pins" Focus="focusPoint" FocusVersion="focusVersion"
                            OnPoint="AddPoint" OnFinish="FinishDrawing" OnMeeting="SetMeeting" OnRoute="PickRoute" OnStroke="Stroke" OnCut="Cut" OnLasso="Lasso" OnStart="MoveStart" OnShortcut="Shortcut">
                    <Overlay>
                        @for (var i = 0; i < summaries.Count; i++)
                        {
                            var summary = summaries[i];
                            var section = summary.Section;
                            var index = i;
                            <RouteLabel @key="section" Summary="summary" Route="index" Number="index + 1" Colour="@Colour(section)" At="labelAt[section]"
                                        Selected="chosen.Contains(section)" Expanded="@(Active == section && tool == MapTool.Select)" Renaming="renaming == section"
                                        OnPick="add => PickRoute(new RoutePick(index, add))" OnStartRename="() => StartRename(section)" OnRename="name => Rename(section, name)"
                                        OnLock="() => SetLocked([section], !section.Locked)" OnUnassign="() => Unassign([section])" />
                        }
                        @if (chosen.Count > 1 && tool == MapTool.Select)
                        {
                            var anchor = ChosenCentre;
                            <div class="map-group" data-lng="@anchor.Lon.ToString(CultureInfo.InvariantCulture)" data-lat="@anchor.Lat.ToString(CultureInfo.InvariantCulture)">
                                <div class="map-group__card" role="group" aria-label="Selected routes">
                                    <span class="map-group__title">@chosen.Count routes · @ChosenSummaries.Sum(s => s.Letterboxes) letterboxes</span>
                                    <div class="route-tag__actions">
                                        <button type="button" class="map-action map-action--primary" @onclick="MergeChosen" disabled="@chosen.Any(s => s.Locked)"><Icon Name="merge" Size="IconSize.ExtraSmall" />Merge</button>
                                        <button type="button" class="map-action" @onclick="() => SetLocked([.. chosen], !chosen.All(s => s.Locked))"><Icon Name="@(chosen.All(s => s.Locked) ? "lock-open" : "lock")" Size="IconSize.ExtraSmall" />@(chosen.All(s => s.Locked) ? "Unlock" : "Lock")</button>
                                        <button type="button" class="map-action" @onclick="() => Unassign([.. chosen])"><Icon Name="circle-off" Size="IconSize.ExtraSmall" />Unassign</button>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (ToolsLive)
                        {
                            <ToolRail Label="Route tools" Groups="ToolGroups" OnPick="PickTool" Class="planner__rail" />
                            <div class="planner-hint">
                                <div class="planner-hint__bar">
                                    <span>@ToolHint</span>
                                    @if (tool is MapTool.Brush or MapTool.Lasso)
                                    {
                                        <span class="planner-hint__chips">
                                            @if (tool == MapTool.Lasso)
                                            {
                                                <button type="button" class="route-chip" aria-pressed="@(Active is null ? "true" : "false")" @onclick="() => chosen.Clear()">New</button>
                                            }
                                            @foreach (var summary in summaries)
                                            {
                                                var section = summary.Section;
                                                <button type="button" class="route-chip" style="--swatch: @Colour(section)" aria-pressed="@(Active == section ? "true" : "false")" aria-label="Route @(draft.Number(section))" @onclick="() => Choose(section)">@draft.Number(section)</button>
                                            }
                                        </span>
                                    }
                                </div>
                                @if (note is not null)
                                {
                                    <p class="planner-hint__note" role="status">@note</p>
                                }
                            </div>
                        }
                    </Overlay>
                </PlannerMap>
            }
        </div>

        <aside class="planner__panel">
            <div class="callout">
                <strong>Staff preview</strong>
                In the real app this lives in the admin panel. Nothing here is shared; publishing changes only this device.
            </div>
            <div class="planner__tabs">
                <Segmented TValue="PlannerPanel" Options="PanelOptions" Value="panel" ValueChanged="SetPanel" />
            </div>

            @if (panel == PlannerPanel.Exclusions)
            {
                <ExclusionsPanel DrawingZone="drawingZone" ZoneReady="zoneClosed" ZonePoints="zoneDraft.Count" PickingAddress="pickingAddress" PendingAddress="pendingAddress"
                                 Reason="prefillReason" Note="@prefillNote" OnStartZone="StartZone" OnFinishZone="FinishDrawing" OnSaveZone="SaveZone"
                                 OnStartAddress="StartAddress" OnSaveAddress="SaveAddress" OnCancel="CancelExclusion" OnFocus="FocusOn" />
            }
            else if (panel == PlannerPanel.Reports)
            {
                <ReportsPanel OnMakeZone="MakeZone" OnMakeAddress="MakeAddress" OnFocus="FocusOn" />
            }
            else
            {

            <Section Title="Area" First="true">
                <p class="section__lead">@AreaHint</p>
                <div class="planner__actions">
                    @if (mode == DrawMode)
                    {
                        <button class="btn btn--primary" @onclick="FinishDrawing" disabled="@(polygon.Count < 3)">Finish area</button>
                    }
                    else
                    {
                        <button class="btn btn--primary" @onclick="StartDrawing">@(closed ? "Draw again" : "Draw area")</button>
                    }
                    <button class="btn btn--quiet" @onclick="Clear" disabled="@(polygon.Count == 0)">Clear</button>
                </div>
                @if (selection is not null)
                {
                    <p class="hint"><Icon Name="map" Size="IconSize.Small" />@SelectionLine</p>
                }
                <div class="planner__meeting">
                    <span><Icon Name="map-pin" Size="IconSize.Small" />Meeting point: <strong>@(MeetsAtChurch ? "church" : "pinned on the map")</strong></span>
                    <span class="planner__actions">
                        <button class="btn btn--quiet planner__small" @onclick="ToggleMeetingMode">@(mode == MeetingMode ? "Cancel" : "Set on map")</button>
                        @if (!MeetsAtChurch)
                        {
                            <button class="btn btn--quiet planner__small" @onclick="UseChurch">Use church</button>
                        }
                    </span>
                </div>
            </Section>

            <Section Title="Routes">
                <div class="stack">
                    <Segmented TValue="SplitTarget" Options="TargetOptions" Value="target" ValueChanged="SetTarget" />
                    <Stepper Label="Target per route" Value="TargetValue" ValueChanged="SetTargetValue" Step="@TargetStep" Min="@TargetStep" Max="@TargetMax" Unit="@TargetUnit" />
                </div>
                <ToggleRow Title="Leave out streets walked this week" Description="Walked in the last 7 days; they show as faded dashes. Thin dashed lines are streets walked through without delivering." Checked="leaveOutRested" CheckedChanged="SetLeaveOutRested" />
                <button class="btn btn--primary btn--block" @onclick="SplitArea" disabled="@(selection is null || Included.Count == 0)">@(summaries.Count > 0 ? "Regenerate" : "Split into routes")</button>
                @if (summaries.Any(s => s.Section.Locked))
                {
                    <p class="hint"><Icon Name="lock" Size="IconSize.Small" />Locked routes stay as they are.</p>
                }
            </Section>

            @if (summaries.Count > 0)
            {
                <Section Title="@($"{summaries.Count} {(summaries.Count == 1 ? "route" : "routes")}")">
                    <p class="section__lead">@SpreadLine. Edit them on the map with the tools beside it.</p>
                    <div class="planner-sections">
                        @foreach (var summary in summaries)
                        {
                            var section = summary.Section;
                            var number = draft.Number(section);
                            var picked = chosen.Contains(section);
                            <div class="planner-section @(picked ? "is-selected" : "")" @key="section">
                                <button type="button" class="planner-section__head" aria-pressed="@(picked ? "true" : "false")" @onclick="e => PickRoute(new RoutePick(number - 1, e.ShiftKey))">
                                    <span class="planner-section__number" style="--swatch: @Colour(section)">@number</span>
                                    <strong>@summary.Name</strong>
                                    @if (section.Locked)
                                    {
                                        <Icon Name="lock" Size="IconSize.ExtraSmall" Class="planner-section__lock" />
                                    }
                                    @if (summary.NeedsReview)
                                    {
                                        <span class="pill pill--urgent">Needs review</span>
                                    }
                                </button>
                                <p class="planner-section__meta">@summary.Letterboxes letterboxes · @ConnectorLine(summary)@summary.Bundles @(summary.Bundles == 1 ? "bundle" : "bundles") · @OutreachFormat.Duration(summary.Time) · @TravelLine(summary)</p>
                                @if (picked)
                                {
                                    @if (summary.NeedsReview)
                                    {
                                        <p class="hint"><Icon Name="flag" Size="IconSize.Small" />@ReviewLine(summary)</p>
                                    }
                                    <div class="planner__actions">
                                        <button class="btn btn--quiet planner__small" @onclick="() => StartRename(section)">Rename</button>
                                        <button class="btn btn--quiet planner__small" @onclick="() => Apply(draft.SplitInTwo(section, target))" disabled="@(section.Edges.Count < 2 || section.Locked)">Split in two</button>
                                        <button class="btn btn--quiet planner__small" @onclick="() => merging = merging == section ? null : section" disabled="@section.Locked">Merge…</button>
                                        <button class="btn btn--quiet planner__small" @onclick="() => SetLocked([section], !section.Locked)">@(section.Locked ? "Unlock" : "Lock")</button>
                                    </div>
                                    @if (merging == section)
                                    {
                                        <div class="planner__actions planner-section__merge">
                                            @foreach (var other in MergeOptions(section))
                                            {
                                                <button class="btn btn--quiet planner__small" @onclick="() => Merge([section, other])">
                                                    <i class="planner__swatch" style="--swatch: @Colour(other)"></i>With route @draft.Number(other)
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="stack planner__publish">
                        <button class="btn btn--primary btn--block" @onclick="Publish">Publish to Saturday's outreach</button>
                        @if (publishedCount is { } count)
                        {
                            <p class="hint"><Icon Name="check" Size="IconSize.Small" />Published @count routes. <a href="outreach/day">See them on Outreach day</a></p>
                        }
                    </div>
                </Section>
            }

            @if (Outreach.HasPublishedRoutes)
            {
                <Section>
                    <button class="btn btn--quiet" @onclick="RestoreSamples">Restore the sample routes</button>
                </Section>
            }
            }
        </aside>
    </div>
</Page>

@code {
    private enum PlannerPanel { Routes, Exclusions, Reports }

    private const string SelectMode = "select";
    private const string DrawMode = "draw";
    private const string MeetingMode = "meeting";
    private const double SamePointMetres = 3;
    private static readonly TimeSpan NoteFor = TimeSpan.FromSeconds(3.5);

    private static readonly IReadOnlyList<string> Palette =
        ["#3f7fc4", "#d1495b", "#2a9d8f", "#e3a033", "#8a63c4", "#5f9e5a", "#c96f2d", "#d16ba5", "#4aa8c9", "#8c8f3a"];

    private static readonly IReadOnlyList<Choice<SplitTarget>> TargetOptions =
        [new(SplitTarget.Letterboxes, "Letterboxes"), new(SplitTarget.Bundles, "Bundles"), new(SplitTarget.Minutes, "Minutes")];

    private readonly List<GeoPoint> polygon = [];
    private readonly List<GeoPoint> zoneDraft = [];
    private PlannerPanel panel = PlannerPanel.Routes;
    private bool drawingZone;
    private bool zoneClosed;
    private bool pickingAddress;
    private GeoPoint? pendingAddress;
    private ExclusionReason prefillReason = ExclusionReason.NonResidential;
    private string prefillNote = "";
    private WalkerReport? fromReport;
    private GeoPoint? focusPoint;
    private int focusVersion;
    private readonly Dictionary<SplitTarget, double> targetValues = new()
    {
        [SplitTarget.Letterboxes] = 120,
        [SplitTarget.Bundles] = 2,
        [SplitTarget.Minutes] = 60,
    };

    private bool closed;
    private string mode = SelectMode;
    private GeoPoint? pinnedMeeting;
    private SplitTarget target = SplitTarget.Letterboxes;
    private bool leaveOutRested = true;
    private AreaSelection? selection;
    private RouteDraft draft = default!;
    private List<SectionSummary> summaries = [];
    private readonly Dictionary<DraftSection, GeoPoint> labelAt = [];
    private readonly HashSet<DraftSection> chosen = [];
    private MapTool tool = MapTool.Select;
    private DraftSection? renaming;
    private DraftSection? merging;
    private string? note;
    private CancellationTokenSource? noteTimer;
    private bool mac;
    private int? publishedCount;
    private int fitVersion;

    private GeoPoint MeetingPoint => pinnedMeeting ?? Outreach.Church;

    private DraftSection? Active => chosen.Count == 1 ? chosen.First() : null;

    private bool ToolsLive => summaries.Count > 0 && mode == SelectMode && !drawingZone && !zoneClosed && !pickingAddress && pendingAddress is null;

    private IEnumerable<SectionSummary> ChosenSummaries => summaries.Where(s => chosen.Contains(s.Section));

    private GeoPoint ChosenCentre
    {
        get
        {
            var top = chosen.SelectMany(s => s.Edges).SelectMany(e => Outreach.Network![e].Line).Max(p => p[1]);
            return new(top, chosen.Average(s => labelAt[s].Lon));
        }
    }

    private IReadOnlyList<IReadOnlyList<ToolRailItem>> ToolGroups =>
    [
        [
            new("select", "pointer", "Select", "V", tool == MapTool.Select),
            new("scissors", "scissors", "Scissors", "C", tool == MapTool.Scissors),
            new("brush", "paintbrush", "Brush", "B", tool == MapTool.Brush),
            new("lasso", "lasso", "Lasso", "L", tool == MapTool.Lasso),
            new("eraser", "eraser", "Eraser", "E", tool == MapTool.Eraser),
            new("start", "map-pin", "Start pin", "S", tool == MapTool.Start),
        ],
        [
            new("undo", "undo", "Undo", mac ? "⌘Z" : "Ctrl+Z", Disabled: !draft.CanUndo),
            new("redo", "redo", "Redo", mac ? "⇧⌘Z" : "Ctrl+Y", Disabled: !draft.CanRedo),
            new("rebalance", "scale", "Rebalance", Disabled: summaries.Count(s => !s.Section.Locked) < 2),
            new("fit", "maximize", "Fit to area", "F"),
        ],
    ];

    private string ToolHint => tool switch
    {
        MapTool.Scissors => "Drag across the streets where the route should split",
        MapTool.Brush => Active is null ? "Paint into" : $"Drag along a street to paint that stretch into route {draft.Number(Active)}; click to take it all",
        MapTool.Lasso => "Loop streets into",
        MapTool.Eraser => "Drag along a street to leave that stretch out; click to leave it all out",
        MapTool.Start => "Drag a route's start pin along its streets",
        _ => chosen.Count == 0 ? "Click a route to select it; shift-click to add more" : "Shift-click to add or remove routes; click the map to clear",
    };

    private bool ZoneActive => drawingZone || zoneClosed;

    private string MapMode => drawingZone ? DrawMode : pickingAddress ? MeetingMode : ZoneActive ? SelectMode : mode;

    private IReadOnlyList<Choice<PlannerPanel>> PanelOptions =>
    [
        new(PlannerPanel.Routes, "Routes"),
        new(PlannerPanel.Exclusions, $"Exclusions ({Outreach.Zones.Count + Outreach.ExcludedAddresses.Count})"),
        new(PlannerPanel.Reports, $"Reports ({Outreach.Reports.Count(r => r.Status == ReportStatus.SentForReview)})"),
    ];

    private IReadOnlyList<PlannerPin> Pins =>
    [
        .. Outreach.ExcludedAddresses.Select(a => new PlannerPin(a.Point.Point, "excluded")),
        .. Outreach.Reports.Where(r => r.Status == ReportStatus.SentForReview && r.Point is not null).Select(r => new PlannerPin(r.Point!.Point, "report")),
        .. pendingAddress is { } pending ? [new PlannerPin(pending, "pending")] : Array.Empty<PlannerPin>(),
    ];

    private bool MeetsAtChurch => pinnedMeeting is null;

    private double TargetValue => targetValues[target];

    private double TargetStep => target switch { SplitTarget.Bundles => 1, SplitTarget.Minutes => 15, _ => 10 };

    private double TargetMax => target switch { SplitTarget.Bundles => 10, SplitTarget.Minutes => 240, _ => 600 };

    private string TargetUnit => target switch { SplitTarget.Bundles => " bundles", SplitTarget.Minutes => " min", _ => " letterboxes" };

    private IReadOnlyList<int> Included => selection is null ? [] : leaveOutRested ? selection.Fresh : [.. selection.Fresh, .. selection.Rested];

    private string AreaHint => mode switch
    {
        DrawMode => "Click the map to add corners. Double-click, or click the first corner, to finish.",
        MeetingMode => "Click the map where everyone meets.",
        _ when closed => "Streets whose middle is inside the area are included. Main roads are left out.",
        _ => "Draw the area to split: click its corners on the map.",
    };

    private string SelectionLine
    {
        get
        {
            var letterboxes = Outreach.Letterboxes(Included);
            var rested = selection!.Rested.Count;
            return $"{Included.Count} street segments, {letterboxes} letterboxes" + (rested > 0 ? $" · {rested} walked this week{(leaveOutRested ? ", left out" : ", included")}" : "");
        }
    }

    private string SpreadLine
    {
        get
        {
            var values = summaries.Select(s => target == SplitTarget.Minutes ? s.Time.TotalMinutes : s.Letterboxes).ToList();
            var unit = target == SplitTarget.Minutes ? " min" : " letterboxes";
            return $"{summaries.Sum(s => s.Letterboxes)} letterboxes in all; each route has {values.Min():0} to {values.Max():0}{unit}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Outreach.Changed += Refresh;
        await Outreach.EnsureLoadedAsync();
        draft = new RouteDraft(Outreach.Splitter!, Outreach.Editor!, Outreach.Network!, Outreach.Count, Palette.Count);
        mac = await JS.InvokeAsync<bool>("gsbc.isMac");
    }

    private void StartDrawing()
    {
        polygon.Clear();
        closed = false;
        ResetDraft();
        selection = null;
        mode = DrawMode;
    }

    private void AddPoint(GeoPoint point)
    {
        var target = drawingZone ? zoneDraft : polygon;
        if ((!drawingZone && mode != DrawMode) || (target.Count > 0 && Outreach.Planner!.Distance(target[^1], point) < SamePointMetres))
        {
            return;
        }
        target.Add(point);
    }

    private void FinishDrawing()
    {
        if (drawingZone)
        {
            if (zoneDraft.Count >= 3)
            {
                drawingZone = false;
                zoneClosed = true;
            }
            return;
        }
        if (polygon.Count < 3)
        {
            return;
        }
        closed = true;
        mode = SelectMode;
        Reselect();
        fitVersion++;
    }

    private void Clear()
    {
        polygon.Clear();
        closed = false;
        selection = null;
        ResetDraft();
        mode = SelectMode;
    }

    private void ToggleMeetingMode() => mode = mode == MeetingMode ? SelectMode : MeetingMode;

    private void SetMeeting(GeoPoint point)
    {
        if (pickingAddress)
        {
            pendingAddress = point;
            pickingAddress = false;
            return;
        }
        if (mode != MeetingMode)
        {
            return;
        }
        pinnedMeeting = point;
        mode = SelectMode;
        Summarise();
    }

    private void UseChurch()
    {
        pinnedMeeting = null;
        Summarise();
    }

    private void SetTarget(SplitTarget value) => target = value;

    private void SetTargetValue(double value) => targetValues[target] = value;

    private void SetLeaveOutRested(bool on)
    {
        leaveOutRested = on;
        ResetDraft();
    }

    private void Reselect()
    {
        selection = Outreach.Splitter!.Select(polygon, Outreach.Rested, Outreach.InZone);
        ResetDraft();
    }

    private void ResetDraft()
    {
        draft.Reset(selection is null ? [] : [.. selection.Fresh, .. selection.Rested]);
        summaries = [];
        labelAt.Clear();
        chosen.Clear();
        tool = MapTool.Select;
        renaming = null;
        merging = null;
        publishedCount = null;
    }

    private async Task SplitArea()
    {
        await Native.HapticAsync(Haptic.Medium);
        chosen.RemoveWhere(s => !s.Locked);
        Apply(draft.Regenerate(Included, target, TargetValue, selection!.Connectors(leaveOutRested)));
        fitVersion++;
    }

    private void Apply(EditOutcome outcome)
    {
        if (outcome.Note is { } message)
        {
            Notify(message);
        }
        if (!outcome.Changed)
        {
            return;
        }
        chosen.RemoveWhere(s => !draft.Sections.Contains(s));
        if (renaming is not null && !draft.Sections.Contains(renaming))
        {
            renaming = null;
        }
        merging = null;
        Summarise();
    }

    private void Notify(string message)
    {
        noteTimer?.Cancel();
        noteTimer = new CancellationTokenSource();
        note = message;
        _ = ClearNoteAsync(noteTimer.Token);
    }

    private async Task ClearNoteAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(NoteFor, token);
            note = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void PickTool(string key)
    {
        switch (key)
        {
            case "undo":
                Step(draft.Undo());
                break;
            case "redo":
                Step(draft.Redo());
                break;
            case "rebalance":
                Apply(draft.Rebalance(target));
                break;
            case "fit":
                fitVersion++;
                break;
            default:
                tool = Enum.Parse<MapTool>(key, ignoreCase: true);
                renaming = null;
                break;
        }
    }

    private void Step(bool moved)
    {
        if (moved)
        {
            Apply(EditOutcome.Done);
        }
    }

    private void Shortcut(string key)
    {
        if (!ToolsLive)
        {
            return;
        }
        if (key != "escape")
        {
            PickTool(key);
        }
        else if (tool != MapTool.Select || renaming is not null)
        {
            tool = MapTool.Select;
            renaming = null;
        }
        else
        {
            chosen.Clear();
        }
    }

    private void PickRoute(RoutePick pick)
    {
        var route = pick.Route >= 0 && pick.Route < draft.Sections.Count ? draft.Sections[pick.Route] : null;
        if (route is null)
        {
            if (!pick.Add)
            {
                chosen.Clear();
            }
        }
        else if (pick.Add && tool == MapTool.Select)
        {
            if (!chosen.Remove(route))
            {
                chosen.Add(route);
            }
        }
        else
        {
            Choose(route);
        }
        if (renaming is not null && !chosen.Contains(renaming))
        {
            renaming = null;
        }
    }

    private void Choose(DraftSection route)
    {
        chosen.Clear();
        chosen.Add(route);
    }

    private void Stroke(MapStroke stroke)
    {
        if (stroke.Tool == MapTool.Eraser)
        {
            Apply(draft.Erase(stroke.Stretches));
        }
        else if (Active is { } into)
        {
            Apply(draft.Paint(into, stroke.Stretches));
        }
        else
        {
            Notify("Pick a route to paint into first: click its label or its number above.");
        }
    }

    private void Cut(IReadOnlyList<GeoPoint> line) => Apply(draft.Cut(line));

    private void Lasso(IReadOnlyList<GeoPoint> loop) => Apply(draft.Lasso(Active, loop, Outreach.Planner!));

    private void MoveStart(StartMove move)
    {
        if (move.Route >= 0 && move.Route < draft.Sections.Count)
        {
            Apply(draft.MoveStart(draft.Sections[move.Route], move.Point));
        }
    }

    private void MergeChosen()
    {
        var routes = draft.Sections.Where(chosen.Contains).ToList();
        Apply(draft.Merge(routes));
        if (routes.Count > 1 && draft.Sections.Contains(routes[0]))
        {
            Choose(routes[0]);
        }
    }

    private void Merge(IReadOnlyList<DraftSection> routes) => Apply(draft.Merge(routes));

    private void Unassign(IReadOnlyList<DraftSection> routes) => Apply(draft.Unassign(routes));

    private void SetLocked(IReadOnlyList<DraftSection> routes, bool locked) => Apply(draft.SetLocked(routes, locked));

    private void StartRename(DraftSection section)
    {
        Choose(section);
        tool = MapTool.Select;
        renaming = section;
    }

    private void Rename(DraftSection section, string? name)
    {
        renaming = null;
        if (name is not null)
        {
            Apply(draft.Rename(section, name));
        }
    }

    private async Task Publish()
    {
        await Native.HapticAsync(Haptic.Success);
        await Outreach.PublishRoutesAsync(summaries.Select(s => (s.Name, (IEnumerable<int>)s.Section.Edges)));
        publishedCount = summaries.Count;
    }

    private async Task RestoreSamples()
    {
        await Outreach.RestoreSampleRoutesAsync();
        publishedCount = null;
    }

    private void Summarise()
    {
        publishedCount = null;
        summaries = draft.Sections.Select(s => Outreach.Splitter!.Summarise(s, MeetingPoint, draft.Graph!)).ToList();
        labelAt.Clear();
        foreach (var section in draft.Sections)
        {
            labelAt[section] = Outreach.Planner!.Midpoint(Outreach.Editor!.LabelEdge(section.Edges));
        }
    }

    private static string ConnectorLine(SectionSummary summary) =>
        summary.Plan.ConnectorMetres < 1 ? "" : $"{OutreachFormat.Metres(summary.Plan.ConnectorMetres)} with no letterboxes · ";

    private static string TravelLine(SectionSummary summary) =>
        summary.TravelMetres < 50 ? "starts at the meeting point" : $"includes {OutreachFormat.Kilometres(summary.TravelMetres * 2)} there and back";

    private static string ReviewLine(SectionSummary summary) => summary.InPieces
        ? "In pieces: its streets don't join up. Paint a link, merge it or cut it apart."
        : $"Long walk with no letterboxes ({OutreachFormat.Metres(summary.Plan.LongestConnectorMetres)} at a stretch). Cut it, merge it or move streets.";

    private IEnumerable<DraftSection> MergeOptions(DraftSection section)
    {
        var others = draft.Sections.Where(s => s != section && !s.Locked).ToList();
        var neighbours = AreaSplitter.Neighbours(draft.Graph!, section, others).ToList();
        return [.. neighbours, .. others.Where(s => !neighbours.Contains(s))];
    }

    private string Colour(DraftSection section) => Palette[section.Colour % Palette.Count];

    private void SetPanel(PlannerPanel value)
    {
        CancelExclusion();
        panel = value;
    }

    private void StartZone()
    {
        zoneDraft.Clear();
        zoneClosed = false;
        drawingZone = true;
        mode = SelectMode;
    }

    private void StartAddress()
    {
        pendingAddress = null;
        pickingAddress = true;
        mode = SelectMode;
    }

    private async Task SaveZone((ExclusionReason Reason, string Note) form)
    {
        await Outreach.AddZoneAsync(zoneDraft.ToList(), form.Reason, form.Note);
        await ResolveFromReport(ReportStatus.MadeZone);
        CancelExclusion();
        AfterExclusionChange();
    }

    private async Task SaveAddress((ExclusionReason Reason, string Note, bool ShowWalkers) form)
    {
        await Outreach.AddExcludedAddressAsync(pendingAddress!.Value, form.Reason, form.Note, form.ShowWalkers);
        await ResolveFromReport(ReportStatus.MadeAddress);
        CancelExclusion();
        AfterExclusionChange();
    }

    private async Task ResolveFromReport(ReportStatus status)
    {
        if (fromReport is not null)
        {
            await Outreach.ResolveReportAsync(fromReport, status);
        }
    }

    private void CancelExclusion()
    {
        drawingZone = false;
        zoneClosed = false;
        zoneDraft.Clear();
        pickingAddress = false;
        pendingAddress = null;
        fromReport = null;
        prefillReason = ExclusionReason.NonResidential;
        prefillNote = "";
    }

    private void AfterExclusionChange()
    {
        if (closed)
        {
            selection = Outreach.Splitter!.Select(polygon, Outreach.Rested, Outreach.InZone);
            Summarise();
        }
    }

    private void MakeZone(WalkerReport report)
    {
        CancelExclusion();
        panel = PlannerPanel.Exclusions;
        fromReport = report;
        prefillReason = OutreachLabels.ToExclusion(report.Reason);
        prefillNote = $"Walker report: {report.Note}";
        drawingZone = true;
        if (report.Point is { } point)
        {
            FocusOn(point.Point);
        }
    }

    private void MakeAddress(WalkerReport report)
    {
        CancelExclusion();
        panel = PlannerPanel.Exclusions;
        fromReport = report;
        prefillReason = OutreachLabels.ToExclusion(report.Reason);
        prefillNote = $"Walker report: {report.Note}";
        pendingAddress = report.Point?.Point;
        if (report.Point is { } point)
        {
            FocusOn(point.Point);
        }
    }

    private void FocusOn(GeoPoint point)
    {
        focusPoint = point;
        focusVersion++;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Outreach.Changed -= Refresh;
        noteTimer?.Cancel();
    }
}
