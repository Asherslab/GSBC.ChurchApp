@page "/outreach/go"
@implements IAsyncDisposable
@inject OutreachService Outreach
@inject NavigationManager Navigation
@inject NativeBridge Native

<Page Title="@(Outreach.Walk?.Title ?? "Walk")" BackHref="outreach" BackLabel="Outreach" TopBar="TopBarStyle.Solid" Bell="false">
    @if (Outreach.Walk is not { } walk)
    {
        <Section First="true">
            <EmptyState Icon="footprints" Title="No walk in progress" Body="Start one from Walk now, an area or an outreach route.">
                <a class="btn btn--quiet" href="outreach">Back to Outreach</a>
            </EmptyState>
        </Section>
    }
    else
    {
        <StreetMap Plan="walk.Plan" CurrentLeg="walk.LegIndex" Start="Outreach.Planner!.Node(walk.Plan.StartNode)" ShowLocation="true" Follow="@(following && !picking)" Markers="Outreach.MarkersFor(walk.Plan)" Pickable="picking" OnPick="Picked" Class="street-map--walking" Label="Map of your walk with the current street highlighted" />
        @if (picking)
        {
            <p class="walk-pick"><Icon Name="map-pin" Size="IconSize.Small" />Tap the letterbox on the map. <button class="btn btn--quiet planner__small" @onclick="() => { picking = false; reporting = true; }">Cancel</button></p>
        }

        @if (walk.Current is { } leg)
        {
            <section class="walk-card" aria-live="polite">
                <div class="walk-card__progress">
                    <span>Street @(walk.LegIndex + 1) of @walk.Plan.Legs.Count</span>
                    <span>@walk.LetterboxesDone of @walk.Plan.Letterboxes letterboxes</span>
                </div>
                <span class="progress"><i style="width: @Percent(walk)%"></i></span>

                <h2 class="walk-card__street">@leg.Street</h2>
                <p class="walk-card__what">
                    @if (leg.Letterboxes > 0)
                    {
                        <span>Houses on your left · <strong>@leg.Letterboxes</strong> @(leg.Letterboxes == 1 ? "letterbox" : "letterboxes")</span>
                    }
                    else
                    {
                        <span>Walk along here. Nothing to deliver.</span>
                    }
                </p>
                @if (Outreach.FlagsOn(leg) is > 0 and var flagged)
                {
                    <p class="hint"><Icon Name="mailbox" Size="IconSize.Small" />@flagged marked "No junk mail" on this side</p>
                }
                @if (Outreach.DontLetterboxOn(leg.Arcs).Count is > 0 and var donts)
                {
                    <p class="walk-mark walk-mark--dont"><Icon Name="x" Size="IconSize.Small" />Don't letterbox @(donts == 1 ? "one house" : $"{donts} houses") on this side (red on the map)</p>
                }
                @if (leg.Letterboxes > 0 && Outreach.SkipsOn(leg.Arcs) is { Count: > 0 } skips)
                {
                    <p class="walk-mark"><Icon Name="mailbox" Size="IconSize.Small" />Skip: @string.Join(", ", skips.Select(m => m.Label).Distinct())</p>
                }
                @if (walk.Next is { } next)
                {
                    <p class="hint"><Icon Name="chevron-right" Size="IconSize.Small" />Then @next.Street</p>
                }

                <div class="stack walk-card__actions">
                    <button class="btn btn--primary btn--block" @onclick="Done">@(walk.Next is null ? "Finish walk" : "Done, next street")</button>
                    <div class="walk-card__row">
                        <button class="btn btn--quiet" @onclick="Back" disabled="@(walk.LegIndex == 0)"><Icon Name="undo" Size="IconSize.Small" />Back a street</button>
                        <button class="btn btn--quiet" @onclick="Flag" disabled="@(leg.Letterboxes == 0)"><Icon Name="mailbox" Size="IconSize.Small" />No junk mail</button>
                    </div>
                    <div class="walk-card__row">
                        <button class="btn btn--quiet walk-card__follow" @onclick="() => following = !following" aria-pressed="@(following ? "true" : "false")"><Icon Name="locate" Size="IconSize.Small" />@(following ? "Following you" : "Follow me")</button>
                        <button class="btn btn--quiet walk-card__follow" @onclick="StartReport"><Icon Name="flag" Size="IconSize.Small" />Report a problem</button>
                    </div>
                </div>
            </section>
        }
        else
        {
            <Section First="true">
                <EmptyState Icon="check" Title="Walk done. Thank you!" Body="@Summary(walk)">
                    @if (walk.CountsTowardDay)
                    {
                        <p class="outreach-counts"><span class="live-dot"></span>Counted toward today's outreach</p>
                    }
                    <button class="btn btn--primary" @onclick="Finish">Back to Outreach</button>
                </EmptyState>
            </Section>
        }
    }
</Page>

<ReportSheet Open="reporting" OpenChanged="o => { reporting = o; if (!o) pickedFromMap = false; }" Scopes="WalkScopes"
             AreaName="@(Outreach.Walk?.Title ?? "This walk")" StreetName="@Outreach.Walk?.Current?.Street" StreetEdge="@Outreach.Walk?.Current?.Arcs.FirstOrDefault().Edge"
             Point="reportPoint" PointFromMap="pickedFromMap" OnPickOnMap="PickOnMap" />

@code {
    private static readonly IReadOnlyList<ReportScope> WalkScopes = [ReportScope.Street, ReportScope.Letterbox, ReportScope.Area];

    private bool following = true;
    private bool reporting;
    private bool picking;
    private bool pickedFromMap;
    private GeoPoint? reportPoint;
    private bool awake;

    protected override void OnInitialized() => Outreach.Changed += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Outreach.Walk is not null)
        {
            awake = true;
            await Native.KeepAwakeAsync(true);
        }
    }

    private static double Percent(WalkSession walk) =>
        walk.Plan.Letterboxes == 0 ? 0 : Math.Round(100.0 * walk.LetterboxesDone / walk.Plan.Letterboxes, 1);

    private static string Summary(WalkSession walk)
    {
        var minutes = Math.Max(1, (int)(DateTime.Now - walk.StartedAt).TotalMinutes);
        return $"{walk.Plan.Letterboxes} letterboxes · {OutreachFormat.Kilometres(walk.Plan.Metres)} · {minutes} min. These streets now show as done, so nobody repeats them this week.";
    }

    private async Task Done()
    {
        await Native.HapticAsync(Outreach.Walk?.Next is null ? Haptic.Success : Haptic.Light);
        await Outreach.CompleteLegAsync();
    }

    private async Task Back()
    {
        await Native.HapticAsync(Haptic.Selection);
        Outreach.StepBack();
    }

    private async Task Flag()
    {
        await Native.HapticAsync(Haptic.Warning);
        await Outreach.FlagNoJunkMailAsync(OutreachPosition.Parse(await Native.LastPositionAsync()));
    }

    private async Task StartReport()
    {
        pickedFromMap = false;
        reportPoint = OutreachPosition.Parse(await Native.LastPositionAsync())
            ?? (Outreach.Walk?.Current is { } leg && leg.Arcs.Count > 0 ? Outreach.Planner!.Midpoint(leg.Arcs[0].Edge) : null);
        reporting = true;
    }

    private void PickOnMap()
    {
        reporting = false;
        picking = true;
    }

    private void Picked(GeoPoint point)
    {
        reportPoint = point;
        pickedFromMap = true;
        picking = false;
        reporting = true;
    }

    private void Finish()
    {
        Outreach.EndWalk();
        Navigation.NavigateTo("outreach");
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Outreach.Changed -= Refresh;
        if (awake)
        {
            try
            {
                await Native.KeepAwakeAsync(false);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
