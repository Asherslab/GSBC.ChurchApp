@inject OutreachService Outreach

<Sheet Open="Open" OpenChanged="OpenChanged">
    <h2>Your first name</h2>
    <p>So others can see who has claimed what. Only your first name is shown.</p>
    <div class="field" style="margin-top: 16px">
        <label for="walker-name">First name</label>
        <input id="walker-name" @bind="name" @bind:event="oninput" autocomplete="given-name" autocapitalize="words" maxlength="30" />
    </div>
    <div class="stack" style="margin-top: 20px">
        <button class="btn btn--primary btn--block" disabled="@string.IsNullOrWhiteSpace(name)" @onclick="Save">@Action</button>
    </div>
</Sheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Action { get; set; } = "Claim";
    [Parameter] public EventCallback OnSaved { get; set; }

    private string name = "";

    private async Task Save()
    {
        await Outreach.SetNameAsync(name);
        await OpenChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync();
    }
}
