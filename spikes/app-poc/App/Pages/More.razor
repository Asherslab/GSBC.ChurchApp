            <ListRow Icon="scroll-text" Title="Our beliefs" Href="https://baptist.com.au/pages/our-beliefs" OpenInApp="true" />
            <ListRow Icon="users" Title="Our team" Href="https://baptist.com.au/pages/our-team" OpenInApp="true" />
            <ListRow Icon="shield-check" Title="Safety forms" Href="https://baptist.com.au/pages/safety-forms" OpenInApp="true" />
