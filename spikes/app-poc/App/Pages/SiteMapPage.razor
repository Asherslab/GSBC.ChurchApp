@page "/map"
@implements IDisposable
@inject IEnumerable<IMapLayer> Layers
@inject LifeGroupsService Groups
@inject NativeBridge Native
@inject NavigationManager Navigation

<Page Title="Site map" BackHref="more" BackLabel="Back" TopBar="TopBarStyle.Solid" Bell="false">
    <div class="map-page">
        <SiteMap Marks="Marks" Interactive="true" FocusPlaceId="@Place" SelectedPlaceId="@(selected?.Place.Id ?? Place)" OnTap="Select" />

        <Section First="true">
            <Segmented TValue="string" Options="LayerOptions" Value="LayerId" ValueChanged="ShowLayer" />
            <p class="hint">Pinch or double-tap to zoom. Tap a room or a building.</p>
        </Section>

        <Section Title="@CurrentLayer.Name">
            <div class="list map-legend">
                @foreach (var mark in Marks)
                {
                    <ListRow Title="@mark.Label" Subtitle="@(mark.Detail ?? KindLabel(mark.Place))" OnClick="() => Select(mark)">
                        <Leading>
                            @if (mark.Badge is not null)
                            {
                                <span class="badge-dot" style="--band: @mark.Colour">@mark.Badge</span>
                            }
                            else
                            {
                                <span class="row__icon"><Icon Name="map-pin" Size="IconSize.Small" /></span>
                            }
                        </Leading>
                    </ListRow>
                }
            </div>
        </Section>

        <PreviewFooter />
    </div>
</Page>

<Sheet Open="selected is not null" OpenChanged="_ => selected = null">
    @if (selected is not null)
    {
        <h2>@selected.Label</h2>
        <p>@(selected.Detail ?? KindLabel(selected.Place))</p>
        @if (selected.Href is not null)
        {
            <div style="margin-top: 18px">
                <a class="btn btn--primary btn--block" href="@selected.Href">Open</a>
            </div>
        }
    }
</Sheet>

@code {
    private const string DefaultLayer = "places";

    [SupplyParameterFromQuery] public string? Layer { get; set; }
    [SupplyParameterFromQuery] public string? Place { get; set; }

    private MapMark? selected;

    private string LayerId => Layers.Any(l => l.Id == Layer) ? Layer! : DefaultLayer;

    private IMapLayer CurrentLayer => Layers.First(l => l.Id == LayerId);

    private IReadOnlyList<MapMark> Marks => CurrentLayer.Marks();

    private IReadOnlyList<Choice<string>> LayerOptions => Layers.Select(l => new Choice<string>(l.Id, l.Name)).ToList();

    protected override async Task OnInitializedAsync()
    {
        Groups.Changed += Refresh;
        await Groups.EnsureLoadedAsync();
    }

    private static string KindLabel(Place place) => place.Kind switch
    {
        PlaceKind.Facility => "Facilities",
        PlaceKind.Room => "Room",
        _ => "Building",
    };

    private async Task Select(MapMark mark)
    {
        await Native.HapticAsync(Haptic.Selection);
        selected = mark;
    }

    private void ShowLayer(string id) =>
        Navigation.NavigateTo($"map?layer={id}", new NavigationOptions { ReplaceHistoryEntry = true });

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Groups.Changed -= Refresh;
}
