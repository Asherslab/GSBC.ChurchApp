@typeparam TValue
@inject NativeBridge Native

<div class="segmented" role="tablist" aria-label="@Label">
    @foreach (var option in Options)
    {
        <button role="tab" aria-pressed="@(EqualityComparer<TValue>.Default.Equals(option.Value, Value) ? "true" : "false")" @onclick="() => Select(option.Value)">@if (Icon?.Invoke(option.Value) is { } icon)
            {
                <Icon Name="@icon" Size="IconSize.Small" />
            }@option.Label</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Choice<TValue>> Options { get; set; } = [];
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Func<TValue, string?>? Icon { get; set; }
    [Parameter] public string? Label { get; set; }

    private async Task Select(TValue value)
    {
        await Native.HapticAsync(Haptic.Selection);
        await ValueChanged.InvokeAsync(value);
    }
}
