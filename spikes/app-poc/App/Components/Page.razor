@inject NativeBridge Native
@inject AppSettings Settings
@inject NavigationManager Navigation

<div class="page-scroll" data-stuck-at="@StuckAt">
    <header class="topbar @TopBarClass">
        <div class="topbar__start">
            @if (BackHref is not null)
            {
                <button class="icon-btn icon-btn--back" @onclick="GoBack" aria-label="Back">
                    <Icon Name="chevron-left" />@BackLabel
                </button>
            }
            else if (NeedsHomeButton)
            {
                <a class="icon-btn icon-btn--back" href="" aria-label="Home">
                    <Icon Name="chevron-left" />Home
                </a>
            }
        </div>
        <div class="topbar__title">@Title</div>
        <div class="topbar__end">
            @Actions
            @if (Bell)
            {
                <NotificationBell />
            }
        </div>
    </header>
    <div class="page @(BackHref is null ? "" : "page--push")">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string? BackLabel { get; set; }
    [Parameter] public TopBarStyle TopBar { get; set; } = TopBarStyle.OverHero;
    [Parameter] public int StuckAt { get; set; } = 120;
    [Parameter] public bool Bell { get; set; } = true;
    [Parameter] public bool TitleAlwaysShown { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool NeedsHomeButton =>
        !Settings.LayoutOption.ShowTabBar && Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length > 0;

    private string TopBarClass => (TopBar == TopBarStyle.Solid ? "topbar--solid" : "topbar--over-hero") + (TitleAlwaysShown ? " topbar--titled" : "");

    private async Task GoBack()
    {
        await Native.HapticAsync(Haptic.Selection);
        await Native.BackAsync(BackHref!);
    }
}
