@if (PhotoUrl is not null)
{
    <img class="speaker @Class" src="@PhotoUrl" alt="" loading="lazy" />
}
else
{
    <span class="speaker speaker--initials @Class" aria-hidden="true">@Initials</span>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Initials =>
        string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(p => char.IsLetter(p[0])).Take(2).Select(p => p[0]));
}
