<svg class="icon @SizeClass @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)IconPaths.All[Name])</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public IconSize Size { get; set; } = IconSize.Normal;
    [Parameter] public string? Class { get; set; }

    private string SizeClass => Size switch
    {
        IconSize.ExtraSmall => "icon--xs",
        IconSize.Small => "icon--sm",
        IconSize.Large => "icon--lg",
        _ => "",
    };
}
