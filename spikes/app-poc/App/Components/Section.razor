<section class="section @(First ? "section--first" : "") @(Bleed ? "section--bleed" : "")" id="@Id">
    @if (Title is not null)
    {
        <div class="section__head">
            <h2 class="section__title">@Title</h2>
            @if (LinkHref is not null)
            {
                <a class="section__link" href="@LinkHref">@LinkText<Icon Name="chevron-right" Size="IconSize.Small" /></a>
            }
            @Trailing
        </div>
    }
    @ChildContent
</section>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? LinkText { get; set; }
    [Parameter] public string? LinkHref { get; set; }
    [Parameter] public bool First { get; set; }
    [Parameter] public bool Bleed { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
