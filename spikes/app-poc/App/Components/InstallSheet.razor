@implements IDisposable
@inject NativeBridge Native
@inject NavigationManager Navigation

<Sheet Open="open" OpenChanged="_ => open = false">
    <h2>Add Good Shepherd to your Home Screen</h2>
    <p>It's a preview of the church app. From the Home Screen it opens full screen, like an app, which is how it's meant to be tried.</p>
    @if (mode == DisplayMode.BrowserIos)
    {
        <ol class="install-steps">
            <li>Tap <Icon Name="menu" Size="IconSize.Small" /> beside the address, then <Icon Name="share" Size="IconSize.Small" /> <strong>Share</strong>. On older iPhones, Share is in Safari's toolbar.</li>
            <li>Choose <strong>Add to Home Screen</strong>. If it isn't listed, tap <strong>View More</strong> or scroll down.</li>
            <li>Open <strong>Good Shepherd</strong> from your Home Screen.</li>
        </ol>
    }
    <div class="stack" style="margin-top: 20px">
        @if (mode == DisplayMode.BrowserInstallable)
        {
            <button class="btn btn--primary btn--block" @onclick="Install">Install</button>
        }
        <button class="btn btn--quiet btn--block" @onclick="() => open = false">Keep using the browser</button>
    </div>
</Sheet>

@code {
    private bool open;
    private DisplayMode mode;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += StaffPageOpened;
        mode = await Native.DisplayModeAsync();
        open = !OnStaffPage && mode is DisplayMode.BrowserIos or DisplayMode.BrowserInstallable;
    }

    private bool OnStaffPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("staff/", StringComparison.OrdinalIgnoreCase);

    private void StaffPageOpened(object? sender, LocationChangedEventArgs e)
    {
        if (open && OnStaffPage)
        {
            open = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= StaffPageOpened;

    private async Task Install() => open = !await Native.InstallAsync();
}
