@page "/account"
@inject AccountsClient Accounts

<Page Title="Account" BackHref="more" BackLabel="More">
    <Masthead Title="Account" />

    <Section First="true">
        <LiveData TValue="CurrentSession" Load="() => Accounts.GetCurrentSessionAsync().AsTask()" FailedTitle="Can't reach the church's server">
            @if (context.Value.SignedIn)
            {
                <ListGroup>
                    <ListRow Title="@context.Value.DisplayName" Subtitle="Signed in on this phone" Icon="user" IconTone="RowTone.Accent" />
                </ListGroup>
            }
            else
            {
                <Card Title="You don't need an account to use the app">
                    Signing in unlocks what's personal or private, such as your prayer requests and a ministry's members-only news.
                    Signing in on the phone arrives once the app can use passkeys; until then, sign in at the website.
                </Card>
            }
        </LiveData>
    </Section>
</Page>
