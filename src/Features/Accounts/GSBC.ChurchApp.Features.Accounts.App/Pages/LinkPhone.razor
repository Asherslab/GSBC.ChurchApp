@page "/link-phone"
@using GSBC.ChurchApp.Platform.Client.Native
@inject AccountsClient Accounts
@inject NativeBridge Bridge
@inject NavigationManager Navigation

<Page Title="Link this phone" BackHref="previews" BackLabel="Previews">
    <Masthead Title="Link this phone" Note="For previews, until passkeys work in the app" />
    <Section First="true" Lead="In the admin panel, open Preview on your phone, then type the code it shows. Development builds only.">
        <TextField Label="Code" Placeholder="K7Q 4XM" Value="@_code" ValueChanged="value => _code = value" AutoComplete="one-time-code" MaxLength="12" />
        @if (_problem is not null)
        {
            <div class="ui-after"><Notice Tone="NoticeTone.Warning" Text="@_problem" /></div>
        }
        <div class="ui-after">
            <Button Block="true" Busy="_busy" Disabled="@(_code.Trim().Length < 6)" OnClick="LinkAsync">Link</Button>
        </div>
    </Section>
</Page>

@code {
    private string _code = "";
    private string? _problem;
    private bool _busy;

    private async Task LinkAsync()
    {
        _busy = true;
        _problem = null;
        try
        {
            LinkedPhone linked = await Accounts.LinkPhoneAsync(_code, "iPhone (development build)");
            await Bridge.UseSessionAsync(linked.Secret);
            await Accounts.NotifySessionChangedAsync();
            Navigation.NavigateTo("previews");
        }
        catch (Grpc.Core.RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
