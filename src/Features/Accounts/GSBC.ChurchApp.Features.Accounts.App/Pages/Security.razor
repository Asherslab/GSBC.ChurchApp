@page "/account/security"
@inject IAccess Access

<Page Title="Security" BackHref="@AccountsDestinations.Account.Route" BackLabel="Account">
    <Masthead Title="Security" Note="Your passkeys and where you're signed in" />

    <LiveData TValue="bool" Load="() => Task.FromResult(Access.SignedIn)" ReloadOn="ChangeKind.Session | ChangeKind.Access">
        @if (context.Value)
        {
            <AccountSecurity />
        }
        else
        {
            <SignIn />
        }
    </LiveData>
</Page>
