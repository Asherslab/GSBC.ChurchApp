@inject AccountsClient Accounts
@inject IPasskeyCeremonies Passkeys
@inject ISignInCodes Codes

@if (_supported is false)
{
    <Section First="true">
        <Notice Tone="NoticeTone.Warning" Text="This browser can't use passkeys. Try a current version of Safari, Chrome or Edge." />
    </Section>
}
else if (_mode == Mode.SignIn)
{
    <Section First="true" Title="Sign in" Lead="With the passkey saved on this device. Face ID, Touch ID or your screen lock confirms it's you.">
        <Button Block="true" Icon="key" Busy="_busy" OnClick="SignInAsync">Sign in with a passkey</Button>
    </Section>
    <Section>
        <ListGroup>
            <ListRow Title="Create an account" Subtitle="With your name, your email and a passkey" Icon="plus" IconTone="RowTone.Accent" OnClick="() => Switch(Mode.SignUp)" />
            <ListRow Title="Lost your passkey?" Subtitle="Get a link by email to add a new one" Icon="lock" IconTone="RowTone.Quiet" OnClick="() => Switch(Mode.Recover)" />
        </ListGroup>
        @if (Codes.IsAvailable)
        {
            <div class="ui-after">
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="() => Switch(Mode.Code)">App reviewer? Sign in with a code</Button>
            </div>
        }
    </Section>
}
else if (_mode == Mode.Code)
{
    <Section First="true" Title="Sign in with a code" Lead="For app reviewers. Use the email and sign-in code the church gave you.">
        <TextField Label="Email" Type="email" Value="@_email" ValueChanged="value => _email = value" AutoComplete="username" />
        <div class="ui-after">
            <TextField Label="Sign-in code" Value="@_code" ValueChanged="value => _code = value" AutoComplete="one-time-code" Placeholder="ABCD-EFGH-JKMN" />
        </div>
        <div class="ui-actions ui-after">
            <Button Variant="ButtonVariant.Quiet" OnClick="() => Switch(Mode.SignIn)">Back</Button>
            <Button Busy="_busy" Disabled="@(_email.Trim().Length == 0 || _code.Trim().Length == 0)" OnClick="SignInWithCodeAsync">Sign in</Button>
        </div>
    </Section>
}
else if (_mode == Mode.SignUp)
{
    <Section First="true" Title="Create an account" Lead="Then this device makes a passkey, so there's no password to remember.">
        <TextField Label="Your name" Value="@_name" ValueChanged="value => _name = value" AutoComplete="name" />
        <div class="ui-after">
            <TextField Label="Email" Type="email" Value="@_email" ValueChanged="value => _email = value" AutoComplete="email" Hint="For getting back in if you lose your passkeys" />
        </div>
        <div class="ui-actions ui-after">
            <Button Variant="ButtonVariant.Quiet" OnClick="() => Switch(Mode.SignIn)">Back</Button>
            <Button Busy="_busy" Disabled="@(_name.Trim().Length == 0 || _email.Trim().Length == 0)" OnClick="SignUpAsync">Create a passkey</Button>
        </div>
    </Section>
}
else
{
    <Section First="true" Title="Get back in" Lead="We'll email a link that adds a new passkey to your account. It works for 2 hours.">
        <TextField Label="Your account's email" Type="email" Value="@_email" ValueChanged="value => _email = value" AutoComplete="email" />
        <div class="ui-actions ui-after">
            <Button Variant="ButtonVariant.Quiet" OnClick="() => Switch(Mode.SignIn)">Back</Button>
            <Button Busy="_busy" Disabled="@(_email.Trim().Length == 0)" OnClick="RecoverAsync">Email me a link</Button>
        </div>
    </Section>
}

@if (_message is not null)
{
    <Section>
        <Notice Tone="_messageTone" Text="@_message" />
    </Section>
}

@code {
    private enum Mode { SignIn, SignUp, Recover, Code }

    private Mode _mode = Mode.SignIn;
    private bool? _supported;
    private bool _busy;
    private string? _message;
    private NoticeTone _messageTone = NoticeTone.Warning;
    private string _name = "";
    private string _email = "";
    private string _code = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _supported = await Passkeys.IsSupportedAsync();
        }
        catch (JSException)
        {
            Warn("This page couldn't start passkeys. Reload it and try again.");
        }
        StateHasChanged();
    }

    private void Switch(Mode mode)
    {
        _mode = mode;
        _message = null;
    }

    private Task SignInAsync() => RunAsync(async () => await FinishAsync(await Passkeys.SignInAsync()));

    private Task SignInWithCodeAsync() => RunAsync(async () => await FinishAsync(await Codes.SignInAsync(_email, _code)));

    private Task SignUpAsync() => RunAsync(async () =>
    {
        TicketReply reply = await Accounts.StartSignUpAsync(_name, _email);
        await FinishAsync(await Passkeys.RegisterAsync(reply.Ticket));
    });

    private Task RecoverAsync() => RunAsync(async () =>
    {
        await Accounts.RequestRecoveryAsync(_email);
        _messageTone = NoticeTone.Info;
        _message = "If that email has a confirmed account, a link is on its way. Open it on this device.";
    });

    private async Task FinishAsync(CeremonyResult result)
    {
        if (result.Ok)
            await Accounts.NotifySessionChangedAsync();
        else
            Warn(result.Error ?? "That didn't work. Try again.");
    }

    private void Warn(string message)
    {
        _messageTone = NoticeTone.Warning;
        _message = message;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            Warn(exception.Status.Detail);
        }
        catch (JSException)
        {
            Warn("This page couldn't start passkeys. Reload it and try again.");
        }
        finally
        {
            _busy = false;
        }
    }
}
