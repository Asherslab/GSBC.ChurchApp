@using GSBC.ChurchApp.Platform.Client.Modules
@inject AccountsClient Accounts
@inject IAccountReads Reads
@inject ClientSignals Signals
@inject IEnumerable<AccountSection> Sections

<UnsavedGuard Changed="() => _name is not null || _code.Trim().Length > 0" What="@(_name is not null ? "your name" : "the code from the email")" Save="@(_name is not null ? SaveNameBeforeLeavingAsync : null)" />

<LiveData @ref="_live" TValue="AccountView" Feeds="Reads.Feeds" Load="LoadAsync" FailedTitle="Can't reach the church's server">
    <Section First="true" Title="You" Grouped="true">
        <Trailing>
            <Menu Label="More for your account" Items="AccountActions" Small="true" Disabled="_busy" />
        </Trailing>
        <ChildContent>
        <div class="ui-pair ui-pair--wide">
            <div>
                <TextField Label="Name" Value="@(_name ?? context.Value.Profile.DisplayName)" ValueChanged="value => _name = value" AutoComplete="name" />
                @if (_name is not null)
                {
                    <SaveBar Class="ui-after" Label="Save name" Busy="_busy" OnSave="SaveNameAsync" OnCancel="() => _name = null" State="SaveState.Unsaved"
                             Blocked="@(!Signals.Online ? "Needs a connection." : _name.Trim().Length == 0 ? "Give your name to save it." : null)" />
                }
            </div>
            <ListGroup>
                <ListRow Title="@context.Value.Profile.Email" Subtitle="@(context.Value.Profile.EmailConfirmed ? "Confirmed" : "Not confirmed yet")" Icon="send" IconTone="RowTone.Quiet" />
            </ListGroup>
        </div>
        @if (context.Value.Profile is { EmailConfirmed: false, DemoAccount: false })
        {
            <div class="ui-after">
                <TextField Label="Code from the email" Value="@_code" ValueChanged="value => _code = value" AutoComplete="one-time-code" Hint="Confirming lets you get back in by email if you lose your passkeys." />
            </div>
            <div class="ui-actions ui-after">
                <Button Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="ResendAsync">Send a new code</Button>
                <Button Busy="_busy" Disabled="@(_code.Trim().Length == 0)" OnClick="ConfirmAsync">Confirm</Button>
            </div>
        }
        </ChildContent>
    </Section>

    @if (!context.Value.Profile.DemoAccount)
    {
        @foreach (AccountSection section in Sections.OrderBy(section => section.Order))
        {
            <ErrorBoundary @key="section.Key">@section.Content</ErrorBoundary>
        }
    }

    @if (context.Value.Profile.DemoAccount)
    {
        <Section Title="Signed in with a code" Grouped="true">
            <p class="hint">This is a demo account. It's for reviewing the app, so it signs in with a code instead of a passkey and has no personal data.</p>
        </Section>
    }

    <Section Title="Security" Grouped="true">
        <ListGroup>
            <ListRow Title="Passkeys and sign-ins" Subtitle="@SecurityLine(context.Value)" Icon="key" IconTone="RowTone.Accent" Href="@AccountsDestinations.Security.Route" />
        </ListGroup>
        <div class="ui-actions ui-after">
            <Button Busy="_busy" OnClick="SignOutAsync">Sign out</Button>
        </div>
    </Section>
</LiveData>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="Delete your account?">
    <ChildContent>
        @foreach (string line in AccountDeletionWords.Lines(yours: true))
        {
            <p class="sheet__lead">@line</p>
        }
        <Notice Tone="NoticeTone.Warning" Text="@_deleteProblem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete my account</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@if (_message is not null)
{
    <Section>
        <Notice Tone="_messageTone" Text="@_message" />
    </Section>
}

@code {
    private LiveData<AccountView>? _live;
    private string? _name;
    private string _code = "";
    private bool _busy, _deleting;
    private string? _deleteProblem;
    private string? _message;
    private NoticeTone _messageTone = NoticeTone.Info;

    private IReadOnlyList<MenuItem> AccountActions =>
    [
        this.Item("Delete my account…", () =>
        {
            _deleting = true;
            return Task.CompletedTask;
        }, "trash-2", "For good. Signing out is enough to stop using it here.", danger: true),
    ];

    private Task SignOutAsync() => RunAsync(Accounts.SignOutAsync);

    private static string SecurityLine(AccountView view)
    {
        string devices = view.Sessions.Count == 1 ? "signed in on 1 device" : $"signed in on {view.Sessions.Count} devices";
        if (view.Profile.DemoAccount)
            return char.ToUpperInvariant(devices[0]) + devices[1..];
        string passkeys = view.Passkeys.Count == 1 ? "1 passkey" : $"{view.Passkeys.Count} passkeys";
        return $"{passkeys} · {devices}";
    }

    private async Task<AccountView> LoadAsync()
    {
        MyAccount mine = await Reads.MineAsync();
        return new AccountView(mine.Profile, mine.Passkeys.Passkeys, mine.Sessions.Sessions);
    }

    private async Task<bool> SaveNameBeforeLeavingAsync()
    {
        if (_name is null || _name.Trim().Length == 0)
            return false;
        await SaveNameAsync();
        return _name is null;
    }

    private Task SaveNameAsync() => RunAsync(async () =>
    {
        await Accounts.UpdateNameAsync(_name!);
        _name = null;
        Tell("Saved. It shows everywhere the next time you sign in.");
    });

    private Task ConfirmAsync() => RunAsync(async () =>
    {
        await Accounts.ConfirmEmailAsync(_code);
        _code = "";
        Tell("Email confirmed.");
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        await Accounts.ResendConfirmationAsync();
        Tell("A new code is on its way.");
    });

    private async Task DeleteAsync()
    {
        _busy = true;
        _deleteProblem = null;
        try
        {
            await Accounts.DeleteMyAccountAsync();
            _deleting = false;
        }
        catch (RpcException exception)
        {
            _deleteProblem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Tell(string message)
    {
        _messageTone = NoticeTone.Info;
        _message = message;
    }

    private void Warn(string message)
    {
        _messageTone = NoticeTone.Warning;
        _message = message;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            Warn(exception.Status.Detail);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record AccountView(Profile Profile, List<PasskeySummary> Passkeys, List<SessionSummary> Sessions);
}
