@inject AccountsClient Accounts
@inject IPasskeyCeremonies Passkeys

<LiveData @ref="_live" TValue="AccountView" Feeds="[AccountsFeeds.People]" Load="LoadAsync" FailedTitle="Can't reach the church's server">
    <Section First="true" Title="You">
        <TextField Label="Name" Value="@(_name ?? context.Value.Profile.DisplayName)" ValueChanged="value => _name = value" AutoComplete="name" />
        <div class="ui-actions ui-after">
            <Button Variant="ButtonVariant.Quiet" Busy="_busy" Disabled="@(_name is null || _name.Trim().Length == 0)" OnClick="SaveNameAsync">Save name</Button>
        </div>
        <div class="ui-after">
            <ListGroup>
                <ListRow Title="@context.Value.Profile.Email" Subtitle="@(context.Value.Profile.EmailConfirmed ? "Confirmed" : "Not confirmed yet")" Icon="send" IconTone="RowTone.Quiet" />
            </ListGroup>
        </div>
        @if (!context.Value.Profile.EmailConfirmed && !context.Value.Profile.DemoAccount)
        {
            <div class="ui-after">
                <TextField Label="Code from the email" Value="@_code" ValueChanged="value => _code = value" AutoComplete="one-time-code" Hint="Confirming lets you get back in by email if you lose your passkeys." />
            </div>
            <div class="ui-actions ui-after">
                <Button Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="ResendAsync">Send a new code</Button>
                <Button Busy="_busy" Disabled="@(_code.Trim().Length == 0)" OnClick="ConfirmAsync">Confirm</Button>
            </div>
        }
    </Section>

    @if (context.Value.Profile.DemoAccount)
    {
        <Section Title="Signed in with a code">
            <Card Title="This is a demo account">
                It's for reviewing the app, so it signs in with a code instead of a passkey and has no personal data.
            </Card>
        </Section>
    }
    else
    {
        <Section Title="Passkeys" Lead="A second passkey, on another phone or computer, means losing one device never locks you out.">
            <ListGroup>
                @foreach (PasskeySummary passkey in context.Value.Passkeys)
                {
                    <ListRow Title="@passkey.Name" Subtitle="@PasskeyLine(passkey)" Icon="key" IconTone="RowTone.Accent">
                        <TrailingContent>
                            @if (context.Value.Passkeys.Count > 1)
                            {
                                <Button Variant="ButtonVariant.Quiet" Small="true" Disabled="_busy" OnClick="() => RemoveAsync(passkey.Id)">Remove</Button>
                            }
                        </TrailingContent>
                    </ListRow>
                }
            </ListGroup>
            <div class="ui-after">
                <Button Variant="ButtonVariant.Quiet" Icon="plus" Busy="_busy" OnClick="AddPasskeyAsync">Add a passkey on this device</Button>
            </div>
        </Section>
    }

    <Section Title="Where you're signed in">
        <ListGroup>
            @foreach (SessionSummary session in context.Value.Sessions)
            {
                <ListRow Title="@(session.Current ? "This device" : session.DeviceName ?? session.Client)" Subtitle="@($"Last used {session.LastSeenAt.ToLocalTime():d MMM, h:mm tt}")" Icon="smartphone" IconTone="RowTone.Quiet">
                    <TrailingContent>
                        @if (!session.Current)
                        {
                            <Button Variant="ButtonVariant.Quiet" Small="true" Disabled="_busy" OnClick="() => EndAsync(session.Id)">Sign out</Button>
                        }
                    </TrailingContent>
                </ListRow>
            }
        </ListGroup>
        <div class="ui-actions ui-after">
            <Button Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="() => RunAsync(Accounts.SignOutEverywhereAsync)">Sign out everywhere</Button>
            <Button Busy="_busy" OnClick="() => RunAsync(Accounts.SignOutAsync)">Sign out</Button>
        </div>
    </Section>
</LiveData>

@if (_message is not null)
{
    <Section>
        <Notice Tone="_messageTone" Text="@_message" />
    </Section>
}

@code {
    private LiveData<AccountView>? _live;
    private string? _name;
    private string _code = "";
    private bool _busy;
    private string? _message;
    private NoticeTone _messageTone = NoticeTone.Info;

    private async Task<AccountView> LoadAsync() => new(
        await Accounts.GetProfileAsync(),
        (await Accounts.ListPasskeysAsync()).Passkeys,
        (await Accounts.ListSessionsAsync()).Sessions);

    private static string PasskeyLine(PasskeySummary passkey) =>
        $"Added {passkey.CreatedAt.ToLocalTime():d MMM yyyy}{(passkey.BackedUp ? " · synced" : "")}";

    private Task SaveNameAsync() => RunAsync(async () =>
    {
        await Accounts.UpdateNameAsync(_name!);
        _name = null;
        Tell("Saved. It shows everywhere the next time you sign in.");
    });

    private Task ConfirmAsync() => RunAsync(async () =>
    {
        await Accounts.ConfirmEmailAsync(_code);
        _code = "";
        Tell("Email confirmed.");
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        await Accounts.ResendConfirmationAsync();
        Tell("A new code is on its way.");
    });

    private Task AddPasskeyAsync() => RunAsync(async () =>
    {
        CeremonyResult result = await Passkeys.RegisterAsync(null);
        if (result.Ok)
            Tell("Passkey added.");
        else
            Warn(result.Error ?? "That didn't work. Try again.");
    });

    private Task RemoveAsync(string id) => RunAsync(async () =>
    {
        await Accounts.RemovePasskeyAsync(id);
        Tell("Passkey removed.");
    });

    private Task EndAsync(string id) => RunAsync(async () =>
    {
        await Accounts.EndSessionAsync(id);
        Tell("Signed out of that device.");
    });

    private void Tell(string message)
    {
        _messageTone = NoticeTone.Info;
        _message = message;
    }

    private void Warn(string message)
    {
        _messageTone = NoticeTone.Warning;
        _message = message;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            Warn(exception.Status.Detail);
        }
        catch (JSException)
        {
            Warn("This page couldn't start passkeys. Reload it and try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record AccountView(Profile Profile, List<PasskeySummary> Passkeys, List<SessionSummary> Sessions);
}
