@inject AccountsClient Accounts
@inject IPasskeyCeremonies Passkeys

<Section First="true" Title="Welcome" Lead="@Lead">
    @if (_done)
    {
        <Notice Text="You're signed in. Your new passkey is saved on this device." />
        @if (Next is not null)
        {
            <div class="ui-after">@Next</div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Code))
    {
        <Button Block="true" Icon="key" Busy="_busy" OnClick="CreateAsync">Create a passkey</Button>
    }
    @if (_message is not null)
    {
        <div class="ui-after"><Notice Tone="NoticeTone.Warning" Text="@_message" /></div>
    }
</Section>

@code {
    [Parameter] public string? Code { get; set; }

    [Parameter] public RenderFragment? Next { get; set; }

    private bool _busy;
    private bool _done;
    private string? _message;

    private string? Lead => _done ? null
        : string.IsNullOrWhiteSpace(Code) ? "This link is missing its code. Open the link from your email again."
        : "Create a passkey on this device to sign in. Face ID, Touch ID or your screen lock confirms it's you.";

    private async Task CreateAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            TicketReply reply = await Accounts.RedeemAsync(Code!);
            CeremonyResult result = await Passkeys.RegisterAsync(reply.Ticket);
            _done = result.Ok;
            _message = result.Error;
            if (result.Ok)
                await Accounts.NotifySessionChangedAsync();
        }
        catch (RpcException exception)
        {
            _message = exception.Status.Detail;
        }
        catch (JSException)
        {
            _message = "This page couldn't start passkeys. Reload it and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
