@page "/people/{Id}"
@using GSBC.ChurchApp.Platform.Client.Access
@using GSBC.ChurchApp.Platform.Client.Modules
@inject AccountsOfficeClient Office
@inject IAccess Access
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject IEnumerable<PersonTab> ContributedTabs
@inject IEnumerable<PersonFact> ContributedFacts

<LiveData @key="Id" @ref="_live" TValue="PersonView" Feeds="[AccountsFeeds.People]" Load="LoadAsync" FailedTitle="Can't load this person right now">
    @if (context.Value.Person is not { } person)
    {
        <TitleBand Title="Not here" BackHref="people" BackText="People" />
        <EmptyState Icon="users" Title="This person isn't here any more" Body="Their account may have been deleted. Go back to People to find someone else." />
    }
    else
    {
        <TitleBand Title="@person.DisplayName" BackHref="people" BackText="People">
            <LeadContent>
                @if (PersonState.NeedsStaff(person, context.Value.Invitation, Clock))
                {
                    <PersonState Person="person" Invitation="context.Value.Invitation" />
                }
            </LeadContent>
        </TitleBand>

        <TabStrip TValue="string" Label="@($"About {person.DisplayName}")" Options="Tabs.Select(tab => new TabOption<string>(tab.Slug, tab.Title)).ToList()"
                  Value="@Shown.Slug" ValueChanged="ShowTab" />

        <div role="tabpanel">
            @if (Shown.Slug == ProfileTab)
            {
                <PersonProfile @key="person.Id" Person="person" Invitation="context.Value.Invitation" Facts="Facts" OnChanged="ReloadAsync" OnRemoved="Removed" />
            }
            else if (Shown.Slug == ActivityTab)
            {
                <PersonActivity @key="person.Id" Person="person" />
            }
            else
            {
                @Shown.Content(new PersonOnPage(person.Id, person.DisplayName))
            }
        </div>
    }
</LiveData>

@code {
    private const string ProfileTab = "profile";
    private const string ActivityTab = "activity";
    private static readonly RenderFragment<PersonOnPage> NoContent = _ => _ => { };

    private LiveData<PersonView>? _live;

    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private IReadOnlyList<PersonTab> Tabs =>
        ContributedTabs.Where(tab => tab.Requires is null || Access.Can(tab.Requires))
            .Prepend(new PersonTab(ProfileTab, "Profile", int.MinValue, NoContent))
            .Concat(Access.Can(AccountsPermissions.Manage) ? [new PersonTab(ActivityTab, "Activity", 5, NoContent)] : [])
            .OrderBy(tab => tab.Order)
            .ToList();

    private IReadOnlyList<PersonFact> Facts =>
        ContributedFacts.Where(fact => fact.Requires is null || Access.Can(fact.Requires)).OrderBy(fact => fact.Order).ToList();

    private PersonTab Shown => Tabs.FirstOrDefault(tab => tab.Slug == Tab) ?? Tabs[0];

    private async Task<PersonView> LoadAsync()
    {
        Task<PeopleList> people = Office.GetPeopleAsync([Id]).AsTask();
        Task<InvitationList> invitations = Office.ListInvitationsAsync().AsTask();
        await Task.WhenAll(people, invitations);
        PersonInfo? person = (await people).People.FirstOrDefault(found => !found.Deleted);
        InvitationInfo? invitation = (await invitations).Invitations.FirstOrDefault(found => found.UserId == Id);
        return new PersonView(person, invitation);
    }

    private void ShowTab(string slug) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", slug), new NavigationOptions { ReplaceHistoryEntry = true });

    private async Task ReloadAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private void Removed() => Navigation.NavigateTo("people");

    private sealed record PersonView(PersonInfo? Person, InvitationInfo? Invitation);
}
