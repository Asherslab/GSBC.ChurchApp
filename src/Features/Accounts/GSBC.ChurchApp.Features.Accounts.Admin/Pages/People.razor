@page "/people"
@using Grpc.Core
@using GSBC.ChurchApp.Platform.Client.Access
@implements IDisposable
@inject AccountsClient Accounts
@inject IAccess Access

<TitleBand Title="People" Lead="Everyone with an account. Invite staff, send someone a recovery link, or turn an account off.">
    <Actions>
        <Can Permission="AccountsPermissions.Manage">
            <Button Icon="plus" OnClick="StartInvite">Invite someone</Button>
        </Can>
    </Actions>
</TitleBand>

<SplitView Detail="@Detail" DetailLabel="@(_inviting ? "Invite someone" : _selected?.DisplayName ?? "Person")">
    <LiveData @ref="_live" TValue="List<PersonInfo>" Feeds="[AccountsFeeds.People]" Load="LoadAsync" FailedTitle="Can't load people right now">
        <DataTable TItem="PersonInfo" Label="People" Items="Shown(context.Value)" Columns="Columns" Key="person => person.Id"
                   Selected="_selected" SelectedChanged="Select" SortColumn="0">
            <Toolbar>
                <SearchField Label="Find someone" Placeholder="Find someone by name or email" Value="@_query" ValueChanged="SearchAsync" />
                <FilterChips TValue="PeopleFilter" Label="Show" Options="Filters(context.Value)" @bind-Value="_filter" />
            </Toolbar>
            <Empty>
                <EmptyState Icon="users" Title="@(_query.Length > 0 ? $"No one matches “{_query}”" : "No one here")" Body="Try part of their name or email, or show everyone." />
            </Empty>
        </DataTable>
    </LiveData>
</SplitView>

@code {
    private LiveData<List<PersonInfo>>? _live;
    private string _query = "";
    private PeopleFilter _filter = PeopleFilter.Everyone;
    private PersonInfo? _selected;
    private bool _inviting;

    private static readonly IReadOnlyList<TableColumn<PersonInfo>> Columns =
    [
        new("Name", person => @<span class="cell-strong">@person.DisplayName</span>, person => person.DisplayName),
        new("Email", person => @<span class="quiet truncate" title="@person.Email">@person.Email</span>, person => person.Email),
        new("Account", person => @<PersonState Person="person" />, person => StateOrder(person)),
        new("Joined", person => @<DateLine At="person.CreatedAt" Style="DateLineStyle.Short" />, person => person.CreatedAt, "num optional"),
    ];

    private RenderFragment? Detail => _inviting
        ? @<InvitePerson OnSent="InvitedAsync" OnCancel="() => _inviting = false" />
        : _selected is null ? null : @<PersonDetail @key="_selected.Id" Person="_selected" OnChanged="ChangedAsync" />;

    protected override void OnInitialized() => Access.Changed += OnAccessChanged;

    private async Task<List<PersonInfo>> LoadAsync()
    {
        List<PersonInfo> people = (await Accounts.SearchPeopleAsync(_query)).People;
        _selected = _selected is null ? null : people.FirstOrDefault(person => person.Id == _selected.Id) ?? _selected;
        return people;
    }

    private IEnumerable<PersonInfo> Shown(List<PersonInfo> people) => people.Where(person => Matches(person, _filter));

    private static bool Matches(PersonInfo person, PeopleFilter filter) => filter switch
    {
        PeopleFilter.NoPasskey => !person.HasPasskey && !person.Disabled,
        PeopleFilter.Unconfirmed => !person.EmailConfirmed && !person.Disabled,
        PeopleFilter.TurnedOff => person.Disabled,
        _ => true,
    };

    private static string FilterLabel(PeopleFilter filter) => filter switch
    {
        PeopleFilter.NoPasskey => "No passkey yet",
        PeopleFilter.Unconfirmed => "Email not confirmed",
        PeopleFilter.TurnedOff => "Turned off",
        _ => "Everyone",
    };

    private static int StateOrder(PersonInfo person) => person.Disabled ? 3 : !person.HasPasskey ? 1 : !person.EmailConfirmed ? 2 : 0;

    private async Task SearchAsync(string query)
    {
        _query = query;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private static IReadOnlyList<FilterOption<PeopleFilter>> Filters(List<PersonInfo> people) =>
        Enum.GetValues<PeopleFilter>().Select(filter => new FilterOption<PeopleFilter>(filter, FilterLabel(filter), people.Count(person => Matches(person, filter)))).ToList();

    private void Select(PersonInfo person)
    {
        _inviting = false;
        _selected = person;
    }

    private void StartInvite()
    {
        _selected = null;
        _inviting = true;
    }

    private async Task InvitedAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task ChangedAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Access.Changed -= OnAccessChanged;

    public enum PeopleFilter
    {
        Everyone,
        NoPasskey,
        Unconfirmed,
        TurnedOff,
    }
}
