@page "/people"
@using GSBC.ChurchApp.Platform.Client.Access
@implements IDisposable
@inject AccountsClient Accounts
@inject IAccess Access
@inject NavigationManager Navigation

<TitleBand Title="People" Lead="Everyone with an account. Choose someone to give them roles, send them a recovery link, or turn their account off.">
    <Actions>
        <Can Permission="AccountsPermissions.Manage">
            <Button Icon="plus" OnClick="StartInvite">Invite someone</Button>
        </Can>
    </Actions>
</TitleBand>

<SplitView Detail="@Detail" DetailLabel="Invite someone">
    <LiveData @ref="_live" TValue="PeopleView" Feeds="[AccountsFeeds.People]" Load="LoadAsync" FailedTitle="Can't load people right now">
        <DataTable TItem="PersonInfo" Label="People" Items="Shown(context.Value)" Columns="Columns" Key="person => person.Id"
                   SelectedChanged="Open" SortColumn="0">
            <Toolbar>
                <SearchField Label="Find someone" Placeholder="Find someone by name or email" Value="@_query" ValueChanged="SearchAsync" />
                <FilterChips TValue="PeopleFilter" Label="Show" Options="Filters(context.Value)" @bind-Value="_filter" />
            </Toolbar>
            <Empty>
                @if (_filter == PeopleFilter.Invited && _query.Length == 0)
                {
                    <EmptyState Icon="send" Title="No invitations waiting" Body="People you invite show here until they set up their sign-in." />
                }
                else
                {
                    <EmptyState Icon="users" Title="@(_query.Length > 0 ? $"No one matches “{_query}”" : "No one here")" Body="Try part of their name or email, or show everyone." />
                }
            </Empty>
        </DataTable>
    </LiveData>
</SplitView>

@code {
    private LiveData<PeopleView>? _live;
    private Dictionary<string, InvitationInfo> _invitations = [];
    private string _query = "";
    private PeopleFilter _filter = PeopleFilter.Everyone;
    private bool _inviting;

    [SupplyParameterFromQuery] public string? Show { get; set; }
    [SupplyParameterFromQuery(Name = "person")] public string? PersonId { get; set; }

    private IReadOnlyList<TableColumn<PersonInfo>> Columns =>
    [
        new("Name", person => @<span class="cell-strong">@person.DisplayName</span>, person => person.DisplayName),
        new("Email", person => @<span class="quiet truncate" title="@person.Email">@person.Email</span>, person => person.Email),
        new("Account", person => @<PersonState Person="person" Invitation="@_invitations.GetValueOrDefault(person.Id)" />, person => StateOrder(person)),
        new("Joined", person => @<DateLine At="person.CreatedAt" Style="DateLineStyle.Short" />, person => person.CreatedAt, "num optional"),
    ];

    private RenderFragment? Detail => _inviting
        ? @<InvitePerson OnSent="InvitedAsync" OnCancel="() => _inviting = false" />
        : null;

    protected override void OnInitialized()
    {
        if (PersonId is { } linked)
            Navigation.NavigateTo($"people/{Uri.EscapeDataString(linked)}", new NavigationOptions { ReplaceHistoryEntry = true });
        if (Show == InvitedQuery)
            _filter = PeopleFilter.Invited;
        Access.Changed += OnAccessChanged;
    }

    private const string InvitedQuery = "invited";

    private async Task<PeopleView> LoadAsync()
    {
        Task<PeopleList> searching = Accounts.SearchPeopleAsync(_query).AsTask();
        Task<InvitationList> listing = Accounts.ListInvitationsAsync().AsTask();
        await Task.WhenAll(searching, listing);
        List<InvitationInfo> invitations = (await listing).Invitations;
        List<PersonInfo> people = (await searching).People;
        _invitations = invitations.ToDictionary(invitation => invitation.UserId);
        return new PeopleView(people, invitations.Select(AsPerson).ToList());
    }

    private static PersonInfo AsPerson(InvitationInfo invitation) => new()
    {
        Id = invitation.UserId,
        DisplayName = invitation.DisplayName,
        Email = invitation.Email,
        CreatedAt = invitation.InvitedAt,
    };

    private IEnumerable<PersonInfo> Shown(PeopleView view) => _filter == PeopleFilter.Invited
        ? view.Invited.Where(person => _query.Length == 0 || person.DisplayName.Contains(_query, StringComparison.OrdinalIgnoreCase) || person.Email.Contains(_query, StringComparison.OrdinalIgnoreCase))
        : view.People.Where(person => Matches(person, _filter));

    private bool Matches(PersonInfo person, PeopleFilter filter) => filter switch
    {
        PeopleFilter.Invited => _invitations.ContainsKey(person.Id),
        PeopleFilter.NoPasskey => !person.HasPasskey && !person.Disabled && !_invitations.ContainsKey(person.Id),
        PeopleFilter.Unconfirmed => !person.EmailConfirmed && !person.Disabled && !_invitations.ContainsKey(person.Id),
        PeopleFilter.TurnedOff => person.Disabled,
        _ => true,
    };

    private static string FilterLabel(PeopleFilter filter) => filter switch
    {
        PeopleFilter.Invited => "Invited",
        PeopleFilter.NoPasskey => "No passkey yet",
        PeopleFilter.Unconfirmed => "Email not confirmed",
        PeopleFilter.TurnedOff => "Turned off",
        _ => "Everyone",
    };

    private int StateOrder(PersonInfo person) => person.Disabled ? 4 : _invitations.ContainsKey(person.Id) ? 1 : !person.HasPasskey ? 2 : !person.EmailConfirmed ? 3 : 0;

    private async Task SearchAsync(string query)
    {
        _query = query;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private IReadOnlyList<FilterOption<PeopleFilter>> Filters(PeopleView view) =>
        Enum.GetValues<PeopleFilter>().Select(filter => new FilterOption<PeopleFilter>(filter, FilterLabel(filter),
            filter == PeopleFilter.Invited ? view.Invited.Count : view.People.Count(person => Matches(person, filter)))).ToList();

    private void Open(PersonInfo person) => Navigation.NavigateTo($"people/{Uri.EscapeDataString(person.Id)}");

    private void StartInvite() => _inviting = true;

    private async Task InvitedAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Access.Changed -= OnAccessChanged;

    public enum PeopleFilter
    {
        Everyone,
        Invited,
        NoPasskey,
        Unconfirmed,
        TurnedOff,
    }

    private sealed record PeopleView(List<PersonInfo> People, List<PersonInfo> Invited);
}
