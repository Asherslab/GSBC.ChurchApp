@page "/account"
@implements IDisposable
@inject AccountsClient Accounts
@inject OnlineAccount Online

@if (_session is null)
{
    <TitleBand Title="Account" />
    <Skeleton Count="3" />
}
else if (_session.SignedIn)
{
    <TitleBand Title="Account" Lead="@SignedInLead" />
    <div class="account-column">
        <AccountDetails />
    </div>
}
else
{
    <SignInStage>
        <SignIn />
    </SignInStage>
}

@code {
    private CurrentSession? _session;

    private string SignedInLead => $"Signed in as {_session?.DisplayName}. Your name, what the church knows about you, and how you sign in.";

    protected override async Task OnInitializedAsync()
    {
        Accounts.SessionChanged += OnSessionChanged;
        _session = await Online.GetCurrentSessionAsync();
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        _session = await Online.GetCurrentSessionAsync();
        StateHasChanged();
    });

    public void Dispose() => Accounts.SessionChanged -= OnSessionChanged;
}
