@page "/account"
@implements IDisposable
@inject AccountsClient Accounts

<h1>Account</h1>

@if (_session is null)
{
    <p>Checking…</p>
}
else if (_session.SignedIn)
{
    <p>Signed in as @_session.DisplayName.</p>
    <AccountDetails />
}
else
{
    <SignIn />
}

@code {
    private CurrentSession? _session;

    protected override async Task OnInitializedAsync()
    {
        Accounts.SessionChanged += OnSessionChanged;
        _session = await Accounts.GetCurrentSessionAsync();
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        _session = await Accounts.GetCurrentSessionAsync();
        StateHasChanged();
    });

    public void Dispose() => Accounts.SessionChanged -= OnSessionChanged;
}
