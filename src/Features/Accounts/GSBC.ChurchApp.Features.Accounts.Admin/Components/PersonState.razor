@inject TimeProvider Clock

@if (Person.Disabled)
{
    <Pill Tone="PillTone.Masthead">Turned off</Pill>
}
else if (Invitation is { Held: true })
{
    <Pill Tone="PillTone.Quiet" Icon="clock">Not invited yet</Pill>
}
else if (Invitation is not null)
{
    <Pill Tone="@(Expired ? PillTone.Quiet : PillTone.Marker)" Icon="send">@(Expired ? "Invitation expired" : "Invited")</Pill>
}
else if (Person is { HasPasskey: false, AddedByFamily: true })
{
    <Pill Icon="users">Looked after by a parent</Pill>
}
else if (!Person.HasPasskey)
{
    <Pill>No passkey yet</Pill>
}
else if (!Person.EmailConfirmed)
{
    <Pill>Email not confirmed</Pill>
}
else
{
    <span class="quiet">Ready</span>
}

@code {
    [Parameter, EditorRequired] public required PersonInfo Person { get; set; }
    [Parameter] public InvitationInfo? Invitation { get; set; }

    private bool Expired => HasExpired(Invitation, Clock);

    public static bool NeedsStaff(PersonInfo person, InvitationInfo? invitation, TimeProvider clock) =>
        person.Disabled || invitation is { Held: true } || HasExpired(invitation, clock);

    private static bool HasExpired(InvitationInfo? invitation, TimeProvider clock) =>
        invitation is { Held: false } && invitation.ExpiresAt <= clock.GetUtcNow().UtcDateTime;
}
