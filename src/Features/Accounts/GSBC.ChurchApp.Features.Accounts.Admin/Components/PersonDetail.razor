@using Grpc.Core
@inject AccountsClient Accounts
@inject AccountsOfficeClient Office
@inject TimeProvider Clock

<Can Permission="AccountsPermissions.Manage">
    <div class="ui-tools">
        <Menu Label="@($"More for {Person.DisplayName}'s account")" Text="More" Items="Actions" Disabled="_busy" />
    </div>
</Can>

<dl class="facts">
    <dt>Account</dt>
    <dd><PersonState Person="Person" Invitation="Invitation" /></dd>
    @if (Invitation is null)
    {
        <dt>Joined</dt>
        <dd><DateLine At="Person.CreatedAt" /></dd>
        <dt>Passkey</dt>
        <dd>@(Person.HasPasskey ? "Has one" : "Not made yet")</dd>
        <dt>Email</dt>
        <dd>@(Person.EmailConfirmed ? "Confirmed" : "Not confirmed yet")</dd>
    }
    else
    {
        <dt>@(Invitation.Held ? "Added by" : "Invited by")</dt>
        <dd>@(Invitation.InvitedBy ?? "Not recorded")</dd>
        <dt>@(Invitation.Held ? "Added" : "Invited")</dt>
        <dd><DateLine At="Invitation.InvitedAt" Style="DateLineStyle.Short" WithTime="true" /></dd>
    }
</dl>

@if (Invitation is { Held: true })
{
    <section class="panel-section" aria-labelledby="invitation-@Person.Id">
        <h3 class="panel-subtitle" id="invitation-@Person.Id">Waiting for you to invite them</h3>
        <p class="panel-lead">They can be given roles and put in ministries, but they haven't heard anything from the app. Send their invitation when you're ready.</p>
        <Can Permission="AccountsPermissions.Manage">
            <div class="panel-actions">
                <Button Icon="send" Busy="_busy" OnClick="ResendAsync">Send the invitation</Button>
            </div>
            <p class="panel-hint">The invitation is an email with a link that works for 7 days. Removing them, under More, takes away their account and anything they were given.</p>
        </Can>
    </section>
}
else if (Invitation is not null)
{
    <section class="panel-section" aria-labelledby="invitation-@Person.Id">
        <h3 class="panel-subtitle" id="invitation-@Person.Id">@(InvitationExpired ? "Their invitation has expired" : "Invited, not accepted yet")</h3>
        <p class="panel-lead">
            They haven't set up their sign-in yet.
            @if (InvitationExpired)
            {
                <text>The link stopped working <DateLine At="Invitation.ExpiresAt" Style="DateLineStyle.Relative" />.</text>
            }
            else
            {
                <text>The link in their email works until <DateLine At="Invitation.ExpiresAt" Style="DateLineStyle.Short" WithTime="true" />.</text>
            }
        </p>
        <Can Permission="AccountsPermissions.Manage">
            <Notice Text="@_sent" />
            <div class="panel-actions">
                <Button Variant="ButtonVariant.Quiet" Icon="send" Busy="_busy" OnClick="ResendAsync">Send it again</Button>
            </div>
            <p class="panel-hint">Sending it again makes a new link that works for 7 days. Withdrawing it, under More, stops the link and removes the account they haven't set up.</p>
        </Can>
    </section>
}

<Can Permission="AccountsPermissions.Manage">
    @if (Invitation is null)
    {
        <section class="panel-section" aria-labelledby="recovery-@Person.Id">
            <h3 class="panel-subtitle" id="recovery-@Person.Id">Lost their passkey?</h3>
            <p class="panel-lead">Make a recovery link and give it to them yourself. It works once, for a short time.</p>
            @if (_link is not null)
            {
                <CopyField Label="Recovery link" Value="@_link.Code" />
                <p class="panel-hint">Works until <DateLine At="_link.ExpiresAt" Style="DateLineStyle.TimeOnly" />. Making another one stops this one.</p>
            }
            <Button Variant="ButtonVariant.Quiet" Icon="link" Busy="_busy" OnClick="IssueAsync">@(_link is null ? "Make a recovery link" : "Make a new link")</Button>
        </section>
    }
</Can>

<Notice Tone="NoticeTone.Warning" Text="@_problem" />

@if (Invitation is { Held: true })
{
    <Sheet Open="_withdrawing" OpenChanged="open => _withdrawing = open" Title="@($"Remove {Person.DisplayName}?")"
           Lead="Their account is removed, with the roles, ministries and families they were given. They never hear about it. You can add them again.">
        <Actions>
            <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="WithdrawAsync">Remove them</Button>
            <Button Variant="ButtonVariant.Quiet" OnClick="() => _withdrawing = false">Keep them</Button>
        </Actions>
    </Sheet>
}
else
{
    <Sheet Open="_withdrawing" OpenChanged="open => _withdrawing = open" Title="@($"Withdraw {Person.DisplayName}'s invitation?")"
           Lead="The link in their email stops working and the account they haven't set up is removed. You can invite them again.">
        <Actions>
            <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="WithdrawAsync">Withdraw it</Button>
            <Button Variant="ButtonVariant.Quiet" OnClick="() => _withdrawing = false">Keep it</Button>
        </Actions>
    </Sheet>
}

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@($"Delete {Person.DisplayName}'s account?")">
    <ChildContent>
        @foreach (string line in AccountDeletionWords.Lines(yours: false))
        {
            <p class="sheet__lead">@line</p>
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete the account</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private CodeReply? _link;
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required PersonInfo Person { get; set; }
    [Parameter] public InvitationInfo? Invitation { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRemoved { get; set; }

    private string? _sent;
    private bool _withdrawing;
    private bool _deleting;

    private IReadOnlyList<MenuItem> Actions => Invitation switch
    {
        { Held: true } => [this.Item("Remove them…", Ask(() => _withdrawing = true), "user-x", "Takes away their account and anything they were given", danger: true)],
        not null => [this.Item("Withdraw the invitation…", Ask(() => _withdrawing = true), "user-x", "The link stops working", danger: true)],
        _ =>
        [
            Person.Disabled
                ? this.Item("Turn the account back on", ToggleAsync, "user-check", "They can sign in with their passkey again")
                : this.Item("Turn the account off", ToggleAsync, "user-x", "Signs them out everywhere; nothing they made is deleted", danger: true),
            this.Item("Delete the account…", Ask(() => _deleting = true), "trash-2", "For good: they can't sign in with it again", danger: true, startsGroup: true),
        ],
    };

    private static Func<Task> Ask(Action open) => () =>
    {
        open();
        return Task.CompletedTask;
    };

    private bool InvitationExpired => Invitation is { } invitation && invitation.ExpiresAt <= Clock.GetUtcNow().UtcDateTime;

    private Task ResendAsync() => RunAsync(async () =>
    {
        bool first = Invitation is { Held: true };
        await Office.ResendInvitationAsync(Person.Id);
        _sent = first
            ? $"Their invitation is on its way to {Person.Email}."
            : $"A new invitation is on its way to {Person.Email}. The old link no longer works.";
        await OnChanged.InvokeAsync();
    });

    private Task WithdrawAsync() => RunAsync(async () =>
    {
        await Office.WithdrawInvitationAsync(Person.Id);
        _withdrawing = false;
        await OnRemoved.InvokeAsync();
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Office.DeleteAccountAsync(Person.Id);
        _deleting = false;
        await OnRemoved.InvokeAsync();
    });

    private Task IssueAsync() => RunAsync(async () => _link = await Office.IssueRecoveryCodeAsync(Person.Id));

    private Task ToggleAsync() => RunAsync(async () =>
    {
        await Office.SetDisabledAsync(Person.Id, !Person.Disabled);
        Person.Disabled = !Person.Disabled;
        await OnChanged.InvokeAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

}
