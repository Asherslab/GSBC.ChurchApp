@using Grpc.Core
@inject AccountsClient Accounts

<h2 class="panel-title">@Person.DisplayName</h2>
<p class="panel-lead">@Person.Email</p>

<dl class="facts">
    <dt>Account</dt>
    <dd><PersonState Person="Person" /></dd>
    <dt>Joined</dt>
    <dd><DateLine At="Person.CreatedAt" /></dd>
    <dt>Passkey</dt>
    <dd>@(Person.HasPasskey ? "Has one" : "Not made yet")</dd>
    <dt>Email</dt>
    <dd>@(Person.EmailConfirmed ? "Confirmed" : "Not confirmed yet")</dd>
</dl>

<div class="panel-actions">
    <Button Variant="ButtonVariant.Quiet" Icon="key" Href="@($"access/people?user={Person.Id}")">See what they can do</Button>
</div>

<Can Permission="AccountsPermissions.Manage">
    <section class="panel-section" aria-labelledby="recovery-@Person.Id">
        <h3 class="panel-subtitle" id="recovery-@Person.Id">Lost their passkey?</h3>
        <p class="panel-lead">Make a recovery link and give it to them yourself. It works once, for a short time.</p>
        @if (_link is not null)
        {
            <CopyField Label="Recovery link" Value="@_link.Code" />
            <p class="panel-hint">Works until <DateLine At="_link.ExpiresAt" Style="DateLineStyle.TimeOnly" />. Making another one stops this one.</p>
        }
        <Button Variant="ButtonVariant.Quiet" Icon="link" Busy="_busy" OnClick="IssueAsync">@(_link is null ? "Make a recovery link" : "Make a new link")</Button>
    </section>

    <section class="panel-section" aria-labelledby="switch-@Person.Id">
        <h3 class="panel-subtitle" id="switch-@Person.Id">@(Person.Disabled ? "Turned off" : "Turn the account off")</h3>
        <p class="panel-lead">@(Person.Disabled ? "They can't sign in. Turning it back on lets them use their passkey again." : "They're signed out everywhere and can't sign in until it's turned back on. Nothing they made is deleted.")</p>
        <Button Variant="@(Person.Disabled ? ButtonVariant.Quiet : ButtonVariant.Danger)" Busy="_busy" OnClick="ToggleAsync">@(Person.Disabled ? "Turn it back on" : "Turn the account off")</Button>
    </section>

    <section class="panel-section" aria-labelledby="activity-@Person.Id">
        <h3 class="panel-subtitle" id="activity-@Person.Id">Recent activity</h3>
        <LiveData TValue="List<AuditInfo>" Feeds="[AccountsFeeds.People]" Load="LoadAuditAsync" FailedTitle="Can't load their activity">
            @if (context.Value.Count == 0)
            {
                <p class="panel-hint">Nothing yet.</p>
            }
            else
            {
                <ol class="activity">
                    @foreach (AuditInfo entry in context.Value)
                    {
                        <li>
                            <span>@Words(entry.Action)@(entry.ActorId is { Length: > 0 } actor && actor != Person.Id ? " by staff" : "")</span>
                            <DateLine At="entry.At" Style="DateLineStyle.Short" WithTime="true" Class="quiet" />
                        </li>
                    }
                </ol>
            }
        </LiveData>
    </section>
</Can>

<Notice Tone="NoticeTone.Warning" Text="@_problem" />

@code {
    private CodeReply? _link;
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required PersonInfo Person { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task<List<AuditInfo>> LoadAuditAsync() => (await Accounts.ListAuditAsync(Person.Id)).Entries;

    private Task IssueAsync() => RunAsync(async () => _link = await Accounts.IssueRecoveryCodeAsync(Person.Id));

    private Task ToggleAsync() => RunAsync(async () =>
    {
        await Accounts.SetDisabledAsync(Person.Id, !Person.Disabled);
        Person.Disabled = !Person.Disabled;
        await OnChanged.InvokeAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Words(string action) => action switch
    {
        "signed-up" => "Made their account",
        "signed-in" => "Signed in",
        "passkey-added" => "Added a passkey",
        "passkey-removed" => "Removed a passkey",
        "email-confirmed" => "Confirmed their email",
        "recovery-requested" => "Asked for a recovery email",
        "recovery-issued" => "Recovery link made",
        "code-redeemed" => "Used a link",
        "invited" => "Invited",
        "session-ended" => "Signed out on a device",
        "signed-out-everywhere" => "Signed out everywhere",
        "name-changed" => "Changed their name",
        "disabled" => "Account turned off",
        "enabled" => "Account turned back on",
        "demo-account-created" => "Made as a demo account",
        "review-code-created" => "Sign-in code made",
        "review-code-turned-off" => "Sign-in code turned off",
        "review-code-used" => "Signed in with a code",
        "review-code-refused" => "A sign-in code was refused",
        "tool-connected" => "Connected a tool",
        _ => action,
    };
}
