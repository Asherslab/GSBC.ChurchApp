@using Grpc.Core
@inject AccountsClient Accounts
@inject AccountsOfficeClient Office
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="the demo account" />

<PaneHead Title="Make a demo account" OnClose="CloseAsync">
    <p class="pane-head__lead">An account with no real data for Apple's reviewers. Give it an email of its own, such as review@@ your church's domain. Nothing is sent to it. It can only sign in with a sign-in code and never gets a passkey.</p>
</PaneHead>
<form class="panel-form" @onsubmit="MakeAsync">
    <TextField Label="Name" @bind-Value="_name" AutoComplete="off" Required="true" Hint="Shown in the app while signed in, such as App Review" />
    <TextField Label="Email" Type="email" @bind-Value="_email" AutoComplete="off" Required="true" Hint="Goes in App Store Connect's user name field" />
    <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    <SaveBar Class="ui-after" Submit="true" Label="Make the demo account" Busy="_busy" Blocked="@(_name.Trim().Length == 0 || _email.Trim().Length == 0 ? "Give it a name and an email to make it." : null)"
             State="SaveBar.For(Changed, _made is not null)" SavedText="@(_made ?? "")" OnCancel="CloseAsync">
        @if (_made is not null)
        {
            <Button Variant="ButtonVariant.Quiet" Icon="key" OnClick="OnMakeCode">Make a code for it</Button>
        }
    </SaveBar>
</form>

@code {
    private string _name = "App Review";
    private string _email = "";
    private string? _problem;
    private string? _made;
    private bool _busy;

    [Parameter] public EventCallback OnMade { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnMakeCode { get; set; }

    private bool Changed => _email.Trim().Length > 0;

    private async Task CloseAsync()
    {
        if (await Unsaved.MayLeaveAsync())
            await OnCancel.InvokeAsync();
    }

    private async Task MakeAsync()
    {
        _busy = true;
        _problem = _made = null;
        try
        {
            await Office.CreateDemoAccountAsync(_name.Trim(), _email.Trim());
            _made = $"{_email.Trim()} is ready. Next, make a sign-in code for it.";
            _email = "";
            await OnMade.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
