@using Grpc.Core
@inject AccountsClient Accounts
@inject AccountsOfficeClient Office

<PaneHead Title="@Code.Label" Lead="@(Account is null ? "Its demo account was removed." : $"Signs in to {Account.DisplayName}, {Account.Email}.")"
          Actions="Actions" OnClose="OnClose" />

<dl class="facts">
    <dt>State</dt>
    <dd><ReviewCodeState Code="Code" /></dd>
    <dt>Made</dt>
    <dd><DateLine At="Code.CreatedAt" /> by @Code.CreatedBy</dd>
    <dt>@(Code.TurnedOffAt is null ? "Expires" : "Turned off")</dt>
    <dd><DateLine At="@(Code.TurnedOffAt ?? Code.ExpiresAt)" /></dd>
    <dt>Used</dt>
    <dd>@(Code.Uses == 0 ? "Not yet" : Code.Uses == 1 ? "Once" : $"{Code.Uses} times")</dd>
    @if (Code.LastUsedAt is { } lastUsed)
    {
        <dt>Last used</dt>
        <dd><DateLine At="lastUsed" WithTime="true" /></dd>
    }
</dl>

@if (Working)
{
    <p class="panel-hint">Turn it off, under More, once Apple has approved the build.</p>
}

<Notice Tone="NoticeTone.Warning" Text="@_problem" />

<Sheet Open="_asking" OpenChanged="open => _asking = open" Title="@($"Turn off {Code.Label}?")"
       Lead="It stops working at once, and anyone signed in with it is signed out. It can't be turned back on; make a new code if you need one.">
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="TurnOffAsync">Turn it off</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _asking = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private bool _busy;
    private bool _asking;
    private string? _problem;

    [Parameter] public EventCallback OnClose { get; set; }

    private bool Working => ReviewCodeState.Order(Code) == 0;

    private IReadOnlyList<MenuItem> Actions => Working
        ? [this.Item("Turn the code off…", () => { _asking = true; return Task.CompletedTask; }, "circle-off", "Stops it working and signs reviewers out", danger: true)]
        : [];

    [Parameter, EditorRequired] public required ReviewCodeInfo Code { get; set; }
    [Parameter] public DemoAccountInfo? Account { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task TurnOffAsync()
    {
        _busy = true;
        _problem = null;
        try
        {
            await Office.TurnOffReviewCodeAsync(Code.Id);
            _asking = false;
            await OnChanged.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
