@inject PeopleClient People
@inject PeopleOfficeClient Office
@inject SafeMinistryCheckClient SafeMinistryCheck
@inject IAccess Access
@inject TimeProvider Clock

<UnsavedGuard Changed="() => _dirty" What="their blue card and training" Save="SaveBeforeLeavingAsync" />

<LiveData @ref="_live" TValue="TabData" Feeds="[PeopleFeeds.Safeguarding]" Load="LoadAsync" FailedTitle="Can't load their blue card and training right now">
    @{
        SafeguardingRecord saved = context.Value.Family.Safeguarding ?? new SafeguardingRecord();
        SmcSyncStatus status = context.Value.Status;
        DateOnly today = ChurchTime.Today(Clock);
        bool mayEdit = Access.Can(PeoplePermissions.SafeguardingEdit, Person.Id);
        bool linked = saved.FromSafeMinistryCheck;
        IReadOnlyList<SafeguardingFlag> flags = SafeguardingFlags.For(saved, today);
    }
    <div class="people-tab">
        <div>
            @foreach (SafeguardingFlag flag in flags)
            {
                <div class="people-flag @(flag.RunOut ? "people-flag--run-out" : "")"><Icon Name="alert" /> @flag.Words</div>
            }
            @if (linked)
            {
                <Notice Text="@SyncedWords(saved)" />
            }
            else if (saved is { HasCard: false, HasTraining: false })
            {
                <Notice Text="@($"Nothing recorded for {Person.FirstName} yet. {(status.Connected ? "Link them to Safe Ministry Check below, or record" : "Record")} a blue card or training when they serve with children or young people.")" />
            }

            <Section Title="Blue card and training" Grouped="true" Foot="@(linked || !mayEdit ? null : SaveFoot(saved))">
            <ChildContent>
            <h3 class="panel-subtitle">Blue card</h3>
            @if (linked)
            {
                <FactList>
                    <Fact Label="Number" Text="@Or(saved.CardNumber)" />
                    <Fact Label="Status" Text="@(saved.CardStatus.Length > 0 ? BlueCards.Words(saved.CardStatus) : "Not given")" />
                    <Fact Label="Expires" Text="@Or(PeopleWords.Day(saved.CardExpires))" />
                    <Fact Label="Checked" Text="@PeopleWords.Day(saved.CardChecked)" />
                </FactList>
            }
            else
            {
                <div class="people-record">
                    <TextField Label="Number" Value="@_draft.CardNumber" ValueChanged="value => Edit(() => _draft.CardNumber = value)" MaxLength="30" Disabled="!mayEdit" Placeholder="For example 1234567/2" />
                    <SelectField Label="Status" Options="Statuses" Value="@_draft.CardStatus" ValueChanged="value => Edit(() => _draft.CardStatus = value)" Disabled="!mayEdit" />
                    <DateField Label="Expires" Value="@PeopleWords.FieldDay(_draft.CardExpires)" ValueChanged="value => Edit(() => _draft.CardExpires = Day(value))" Disabled="!mayEdit" />
                    <DateField Label="Checked by the office" Value="@PeopleWords.FieldDay(_draft.CardChecked)" ValueChanged="value => Edit(() => _draft.CardChecked = Day(value))" Disabled="!mayEdit"
                               Max="@($"{today:yyyy-MM-dd}")" Hint="When someone last looked it up" />
                </div>
            }

            <h3 class="panel-subtitle">Safe Ministry training</h3>
            @if (linked)
            {
                <FactList>
                    <Fact Label="Course" Text="@SafeMinistryTraining.Words(saved.TrainingProgress)" />
                    <Fact Label="Due again" Text="@Or(PeopleWords.Day(saved.TrainingDue))" />
                    <Fact Label="Other training" Text="@OtherTraining(saved)" />
                </FactList>
            }
            else
            {
                <div class="people-record">
                    <DateField Label="Done" Value="@PeopleWords.FieldDay(_draft.TrainingDone)" ValueChanged="value => Edit(() => _draft.TrainingDone = Day(value))" Disabled="!mayEdit" Max="@($"{today:yyyy-MM-dd}")" />
                    <DateField Label="Due again" Value="@PeopleWords.FieldDay(_draft.TrainingDue)" ValueChanged="value => Edit(() => _draft.TrainingDue = Day(value))" Disabled="!mayEdit"
                               Hint="Leave it empty for a year after it was done" />
                </div>
                @if (saved.UpdatedAt is { } at)
                {
                    <p class="hint">Recorded by hand@(saved.UpdatedBy is { } by ? $" by {by}" : ""), @PeopleWords.When(at).</p>
                }
            }
            </ChildContent>
            </Section>

            @if (linked || status.Connected)
            {
                <Section Title="Safe Ministry Check" Grouped="true">
                <Trailing>
                    @if (linked && mayEdit)
                    {
                        <Menu Label="More for the Safe Ministry Check link" Small="true" Disabled="_busy"
                              Items="@([this.Item("Unlink…", () => { _confirmingUnlink = true; return Task.CompletedTask; }, "unlink", "Clears their blue card and training here", danger: true)])" />
                    }
                </Trailing>
                <ChildContent>
                @if (linked)
                {
                    <FactList>
                        <Fact Label="Their record" Text="@($"{Or(saved.SmcName)} (number {saved.SmcId})")" />
                        <Fact Label="Linked" Text="@LinkedWords(saved)" />
                        <Fact Label="Status there" Text="@StatusWords(saved)" />
                    </FactList>
                }
                else if (mayEdit)
                {
                    <SearchPicker TItem="SmcPerson" Label="Link to their Safe Ministry Check record" Items="context.Value.Unmatched" Text="person => person.Name" Detail="SmcDetail"
                                  Value="null" ValueChanged="LinkAsync" Disabled="_busy" Placeholder="Find them by name or email"
                                  Hint="Only records not linked to anyone are listed. Their blue card and training then come from Safe Ministry Check, replacing what's entered here." />
                }
                else
                {
                    <p class="hint">Not linked to a Safe Ministry Check record.</p>
                }
                </ChildContent>
                </Section>
            }
            <Notice Tone="NoticeTone.Warning" Text="@_message" />
            <Sheet Open="_confirmingUnlink" OpenChanged="open => _confirmingUnlink = open" Title="@($"Unlink {Person.FirstName} from Safe Ministry Check?")"
                   Lead="Their blue card and training are cleared here, and the record isn't matched to anyone automatically again: link it by hand if it's needed.">
                <Actions>
                    <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="UnlinkAsync">Unlink</Button>
                    <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => _confirmingUnlink = false">Keep the link</Button>
                </Actions>
            </Sheet>
        </div>

        <aside class="people-tab__panel">
            @if (linked)
            {
                <h3>From Safe Ministry Check</h3>
                <p>@Person.FirstName's blue card and training come across from Safe Ministry Check each night, or when someone presses Sync now on the Safe Ministry Check page. To change them, change them in Safe Ministry Check.</p>
                <p>Only the blue card, training and status come across. When something else there needs looking at, such as a police check or a referee, it's flagged here as "@SafeguardingFlags.CheckWords".</p>
            }
            else
            {
                <h3>Entered by hand</h3>
                <p>Copy these from the card itself or from Safe Ministry Check. @Person.FirstName sees them on their Account page.</p>
            }
            <p>Nothing is ever blocked: a card or training that has run out, or is due in the next @SafeguardingFlags.SoonDays days, is flagged here, on Safeguarding and for @Person.FirstName.</p>
            @if (saved.HasCard)
            {
                <p>How @Person.FirstName sees it:</p>
                <BlueCard Record="saved" Today="today" />
            }
        </aside>
    </div>
</LiveData>

@code {
    private static readonly IReadOnlyList<FieldOption> Statuses =
        [new("", "Not recorded"), .. BlueCards.Statuses.Select(status => new FieldOption(status.Value, status.Words))];

    private sealed record TabData(PersonFamily Family, SmcSyncStatus Status, IReadOnlyList<SmcPerson> Unmatched);

    private LiveData<TabData>? _live;
    private SafeguardingRecord _draft = new();
    private bool _busy, _dirty, _saved, _confirmingUnlink;
    private string? _message;

    [Parameter, EditorRequired] public required PersonOnPage Person { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private async Task<TabData> LoadAsync()
    {
        PersonFamily family = await Office.GetPersonAsync(Person.Id);
        SmcSyncStatus status = await SafeMinistryCheck.GetStatusAsync();
        bool mayLink = status.Connected && family.Safeguarding?.FromSafeMinistryCheck != true && Access.Can(PeoplePermissions.SafeguardingEdit, Person.Id);
        IReadOnlyList<SmcPerson> unmatched = mayLink ? await SafeMinistryCheck.GetUnmatchedAsync() : [];
        if (!_dirty)
            _draft = Copy(family.Safeguarding ?? new SafeguardingRecord());
        return new TabData(family, status, unmatched);
    }

    private string SyncedWords(SafeguardingRecord record) =>
        record.SyncedAt is { } at ? $"From Safe Ministry Check, {ChurchDates.Ago(at, Now)}. Change these there." : "From Safe Ministry Check, once the next sync has run.";

    private static string LinkedWords(SafeguardingRecord record) =>
        PeopleWords.Sentence(SmcLinkHow.Words(record.LinkedHow))
        + (record.LinkedBy is { } by ? $" by {by}" : "")
        + (record.LinkedAt is { } at ? $", {PeopleWords.When(at)}" : "");

    private static string StatusWords(SafeguardingRecord record) =>
        string.Join(": ", new[] { record.SmcStatus, record.SmcStatusWords }.Where(part => part.Length > 0)) is { Length: > 0 } words ? words : "Not given";

    private static string OtherTraining(SafeguardingRecord record) =>
        string.Join(", ", new[] { record.OtherTrainingName, record.OtherTrainingDone is null ? "" : $"done {PeopleWords.Day(record.OtherTrainingDone)}" }.Where(part => part.Length > 0));

    private static string SmcDetail(SmcPerson person) =>
        string.Join(" · ", new[] { person.Email, person.BirthDate is null ? "" : $"born {PeopleWords.Day(person.BirthDate)}" }.Where(part => part.Length > 0));

    private static string Or(string text) => text.Length > 0 ? text : "Not given";

    private RenderFragment SaveFoot(SafeguardingRecord saved) =>
        @<SaveBar Label="Save" Busy="_busy" OnSave="() => SaveAsync(_draft)" OnCancel="RevertAsync" State="SaveBar.For(_dirty, _saved)">
            @if (saved.HasCard)
            {
                <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => SaveAsync(WithoutCard(saved))">Remove the blue card</Button>
            }
            @if (saved.HasTraining)
            {
                <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => SaveAsync(WithoutTraining(saved))">Remove the training</Button>
            }
        </SaveBar>;

    private async Task RevertAsync()
    {
        _dirty = false;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private void Edit(Action change)
    {
        change();
        _dirty = true;
    }

    private static DateTime? Day(string text) => WireDates.ToWire(PeopleWords.ParseDay(text));

    private static SafeguardingRecord Copy(SafeguardingRecord record) => new()
    {
        CardNumber = record.CardNumber,
        CardStatus = record.CardStatus,
        CardExpires = record.CardExpires,
        CardChecked = record.CardChecked,
        TrainingDone = record.TrainingDone,
        TrainingDue = record.TrainingDue,
    };

    private static SafeguardingRecord WithoutCard(SafeguardingRecord record)
    {
        SafeguardingRecord copy = Copy(record);
        (copy.CardNumber, copy.CardStatus, copy.CardExpires, copy.CardChecked) = ("", "", null, null);
        return copy;
    }

    private static SafeguardingRecord WithoutTraining(SafeguardingRecord record)
    {
        SafeguardingRecord copy = Copy(record);
        (copy.TrainingDone, copy.TrainingDue) = (null, null);
        return copy;
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync(_draft);
        return !_dirty;
    }

    private Task SaveAsync(SafeguardingRecord record) => ChangeAsync(async () =>
    {
        await Office.SetSafeguardingAsync(Person.Id, record);
        (_dirty, _saved) = (false, true);
    });

    private Task LinkAsync(SmcPerson? person) => person is null ? Task.CompletedTask : ChangeAsync(async () =>
    {
        await SafeMinistryCheck.LinkAsync(Person.Id, person.SmcId);
        _dirty = false;
    });

    private Task UnlinkAsync() => ChangeAsync(async () =>
    {
        await SafeMinistryCheck.UnlinkAsync(Person.Id);
        _confirmingUnlink = false;
    });

    private async Task ChangeAsync(Func<Task> change)
    {
        _busy = true;
        _message = null;
        try
        {
            await change();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _message = PeopleWords.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
