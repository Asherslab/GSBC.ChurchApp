@inject PeopleClient People
@inject PeopleOfficeClient Office
@inject IPeopleDirectory Directory
@inject IAccess Access
@inject TimeProvider Clock

<UnsavedGuard Changed="() => Changed" What="the child you were adding" />

<LiveData @ref="_live" TValue="PersonFamily" Feeds="[PeopleFeeds.Family]" Load="() => Office.GetPersonAsync(Person.Id).AsTask()" FailedTitle="Can't load this family right now">
    @{
        PersonFamily family = context.Value;
        DateOnly today = ChurchTime.Today(Clock);
        bool office = Access.Can(PeoplePermissions.FamiliesManage);
        bool mayEdit = Access.Can(PeoplePermissions.FamilyEdit, family.Id);
        bool minor = Ages.IsMinor(WireDates.FromWire(family.BirthDate), today);
        List<LinkAsk> theirAsks = family.Asks.Where(ask => ask.ChildId == family.Id).ToList();
    }
    <div class="people-tab">
        <div>
            @if (minor && family.Parents.Count > 0)
            {
                <Section Title="@($"How ministries reach {Person.FirstName}")" Grouped="true">
                    @if (family.CanSignIn && mayEdit)
                    {
                        <Segmented TValue="string" Label="@($"How ministries reach {Person.FirstName}")" Options="ReachOptions"
                                   Value="@Reach.Effective(family.Reach, minor, family.CanSignIn, hasParents: true)"
                                   ValueChanged="reach => RunAsync(() => People.SetReachAsync(family.Id, reach).AsTask())" />
                    }
                    <p class="hint">@ReachLine(family, minor)</p>
                </Section>
            }

            @if (family.AskedOfThem.Count > 0 || theirAsks.Count > 0)
            {
                <Section Title="Waiting" Grouped="true">
                    <ListGroup>
                        @foreach (LinkAsk ask in family.AskedOfThem)
                        {
                            <ListRow @key="ask.Id" Title="@AskedOfLine(ask, Person)" Subtitle="@AskSub(ask, today)" Icon="users" IconTone="RowTone.Warm">
                                <TrailingContent>
                                    @if (office)
                                    {
                                        <div class="ui-actions">
                                            <Button Small="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => RunAsync(() => People.WithdrawAsync(ask.Id).AsTask())">Take it back</Button>
                                            <Button Small="true" Busy="_busy" OnClick="() => RunAsync(() => Office.LinkAsync(family.Id, ask.ChildId).AsTask())">Link them</Button>
                                        </div>
                                    }
                                </TrailingContent>
                            </ListRow>
                        }
                        @foreach (LinkAsk ask in theirAsks)
                        {
                            <ListRow @key="ask.Id" Title="@($"Asked {ask.ParentEmail} to be their parent")" Subtitle="@($"{PeopleWords.When(ask.AskedAt)} · waiting for them to say yes in the app")" Icon="clock" IconTone="RowTone.Quiet">
                                <TrailingContent>
                                    @if (office)
                                    {
                                        <Button Small="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => RunAsync(() => People.WithdrawAsync(ask.Id).AsTask())">Take it back</Button>
                                    }
                                </TrailingContent>
                            </ListRow>
                        }
                    </ListGroup>
                </Section>
            }

            @if (!minor || family.Children.Count > 0)
            {
                <Section Title="@($"Children {Person.FirstName} looks after · {family.Children.Count}")" Grouped="true">
                    <ListGroup>
                        @foreach (PersonCard child in family.Children)
                        {
                            <ListRow @key="child.Id" Title="@child.Name" Subtitle="@CardLine(child, today)">
                                <Leading><Avatar Name="@child.Name" /></Leading>
                                <TrailingContent>
                                    <div class="ui-actions">
                                        <Button Small="true" Variant="ButtonVariant.Quiet" Href="@($"people/{child.Id}?tab=family")">Open</Button>
                                        @if (office)
                                        {
                                            <Button Small="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => RunAsync(() => People.UnlinkAsync(family.Id, child.Id).AsTask())">Unlink</Button>
                                        }
                                    </div>
                                </TrailingContent>
                            </ListRow>
                        }
                        @if (office && _linking != Linking.Child)
                        {
                            <ListRow Title="Link a child" Subtitle="Find someone, or add a child who isn't in the app" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _linking = Linking.Child" />
                        }
                    </ListGroup>
                    @if (_linking == Linking.Child)
                    {
                        <div class="ui-after">
                            <PersonFinder Label="Find their child" Placeholder="Find their child by name" Find="FindAsync" ActionText="Link as their child" AutoFocus="true"
                                          Leave="Leave(family)" Busy="@_busyFor" OnChosen="person => LinkAsync(family.Id, person.Id)" />
                            <div class="people-inline">
                                <TextField Label="Or add a child who isn't in the app" Placeholder="Their name" Value="@_childName" ValueChanged="value => _childName = value" />
                                <DateField Label="Birth date" Placeholder="Like 4 Mar 2011" Value="@_childBorn" ValueChanged="value => _childBorn = value" Max="@($"{today:yyyy-MM-dd}")" />
                                <Button Variant="ButtonVariant.Quiet" Busy="_busy" Disabled="@(_childName.Trim().Length == 0 || PeopleWords.ParseDay(_childBorn) is null)" OnClick="() => AddChildAsync(family.Id)">Add</Button>
                            </div>
                            <div class="ui-actions ui-after">
                                <Button Small="true" Variant="ButtonVariant.Quiet" OnClick="() => _linking = Linking.None">Done</Button>
                            </div>
                        </div>
                    }
                </Section>
            }

            @if (minor || family.Parents.Count > 0 || office)
            {
                <Section Title="@($"{Person.FirstName}'s parents and guardians")" Grouped="true">
                    <ListGroup>
                        @foreach (PersonCard parent in family.Parents)
                        {
                            <ListRow @key="parent.Id" Title="@parent.Name" Subtitle="@LinkedLine(parent)">
                                <Leading><Avatar Name="@parent.Name" /></Leading>
                                <TrailingContent>
                                    <div class="ui-actions">
                                        <Button Small="true" Variant="ButtonVariant.Quiet" Href="@($"people/{parent.Id}?tab=family")">Open</Button>
                                        @if (office)
                                        {
                                            <Button Small="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => RunAsync(() => People.UnlinkAsync(parent.Id, family.Id).AsTask())">Unlink</Button>
                                        }
                                    </div>
                                </TrailingContent>
                            </ListRow>
                        }
                        @if (minor && family.Parents.Count == 0)
                        {
                            <ListRow Title="No parent linked yet" Subtitle="Shown on Safeguarding until someone is" Icon="alert" IconTone="RowTone.Warm" />
                        }
                        @if (office && _linking != Linking.Parent)
                        {
                            <ListRow Title="Link a parent" Subtitle="It matters while they're under 18" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _linking = Linking.Parent" />
                        }
                    </ListGroup>
                    @if (_linking == Linking.Parent)
                    {
                        <div class="ui-after">
                            <PersonFinder Label="Find their parent" Placeholder="Find their parent or guardian by name" Find="FindAsync" ActionText="Link as their parent" AutoFocus="true"
                                          Leave="Leave(family)" Busy="@_busyFor" OnChosen="person => LinkAsync(person.Id, family.Id)" />
                            <div class="ui-actions ui-after">
                                <Button Small="true" Variant="ButtonVariant.Quiet" OnClick="() => _linking = Linking.None">Done</Button>
                            </div>
                        </div>
                    }
                </Section>
            }

            @if (_message is not null)
            {
                <Notice Tone="NoticeTone.Warning" Text="@_message" />
            }
        </div>

        <aside class="people-tab__panel">
            <h3>What linking does</h3>
            <p>A parent or guardian, while their child is under 18:</p>
            <ul>
                <li>sees and changes the child's details in the app</li>
                <li>makes them a sign-in code for their own phone</li>
                <li>is who ministries tell about the child, and can answer for them when they're reached through their parents, shown as the parent</li>
            </ul>
            <p>Parents link from their Account page too: a parent adds a child, and a young person asks a parent, who says yes.</p>
            <p>A young person no one has linked shows on Safeguarding until someone is.</p>
        </aside>
    </div>
</LiveData>

@code {
    private enum Linking { None, Child, Parent }

    private LiveData<PersonFamily>? _live;
    private Linking _linking;
    private bool _busy;
    private string? _busyFor, _message;
    private string _childName = "", _childBorn = "";

    private bool Changed => _childName.Trim().Length > 0 || _childBorn.Length > 0;

    [Parameter, EditorRequired] public required PersonOnPage Person { get; set; }

    private static readonly IReadOnlyList<SegmentOption<string>> ReachOptions =
    [
        new(Reach.Directly, "Directly"),
        new(Reach.ThroughParents, "Through their parents"),
        new(Reach.Both, "Both"),
    ];

    private static string ReachLine(PersonFamily family, bool minor) => Reach.Effective(family.Reach, minor, family.CanSignIn, hasParents: true) switch
    {
        Reach.ThroughParents when !family.CanSignIn => $"{family.Name} can't sign in yet, so roster requests and messages go to their parents, who can answer for them.",
        Reach.ThroughParents => "Roster requests and messages go to their parents, who can answer for them. The family chose this.",
        Reach.Both => "Roster requests and messages reach them and their parents; either can answer.",
        _ => "Roster requests and messages reach them directly; their parents still see their details.",
    };

    private static string CardLine(PersonCard card, DateOnly today) => $"{PeopleWords.ChildLine(card, today)} · {LinkedLine(card)}";

    private static string LinkedLine(PersonCard card) => card.How switch
    {
        LinkHow.Added => $"added by {card.LinkedBy ?? "a parent"}, {PeopleWords.When(card.LinkedAt)}",
        LinkHow.Approved => $"asked and approved, {PeopleWords.When(card.LinkedAt)}",
        _ => $"linked by {card.LinkedBy ?? "the office"}, {PeopleWords.When(card.LinkedAt)}",
    };

    private static string AskedOfLine(LinkAsk ask, PersonOnPage person) =>
        ask.AskedByChild ? $"{ask.ChildName} asked {person.FirstName} to be their parent" : $"{ask.AskedByName} asked {person.FirstName} to look after {ask.ChildName} too";

    private static string AskSub(LinkAsk ask, DateOnly today) =>
        $"{PeopleWords.When(ask.AskedAt)}{(ask.ChildBirthDate is null ? "" : $" · {ask.ChildName} is {PeopleWords.Age(ask.ChildBirthDate, today)}")}";

    private static IReadOnlyCollection<string> Leave(PersonFamily family) =>
        [family.Id, .. family.Children.Select(child => child.Id), .. family.Parents.Select(parent => parent.Id)];

    private async Task<IReadOnlyList<PersonChoice>> FindAsync(string query) =>
        (await Directory.SearchAsync(query)).Where(person => !person.Disabled).Select(person => new PersonChoice(person.Id, person.Name, person.Email)).ToList();

    private async Task LinkAsync(string parentId, string childId)
    {
        _busyFor = parentId == Person.Id ? childId : parentId;
        await RunAsync(() => Office.LinkAsync(parentId, childId).AsTask());
        _busyFor = null;
    }

    private Task AddChildAsync(string parentId) => RunAsync(async () =>
    {
        await People.AddChildAsync(_childName, PeopleWords.ParseDay(_childBorn)!.Value, parentId);
        (_childName, _childBorn) = ("", "");
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _message = PeopleWords.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
