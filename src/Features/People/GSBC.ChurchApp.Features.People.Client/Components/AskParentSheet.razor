@inject PeopleClient People

<Sheet Open="Open" OpenChanged="OpenChanged" Title="Ask a parent" Lead="Use the email your parent or guardian has for the app. They say yes on their Account page; if they're not in the app yet, your ask waits until they sign up with that email.">
    <ChildContent>
        <TextField Label="Their email" Type="email" Value="@_email" ValueChanged="value => _email = value" AutoComplete="email" />
        <Notice Tone="NoticeTone.Warning" Text="@_message" />
    </ChildContent>
    <Actions>
        <Button Block="true" Busy="_busy" Disabled="@(_email.Trim().Length == 0)" OnClick="AskAsync">Ask them</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => OpenChanged.InvokeAsync(false)">Not now</Button>
    </Actions>
</Sheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnAsked { get; set; }

    private string _email = "";
    private bool _busy;
    private string? _message;

    private async Task AskAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            await People.AskToLinkAsync(_email);
            _email = "";
            await OpenChanged.InvokeAsync(false);
            await OnAsked.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _message = PeopleWords.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
