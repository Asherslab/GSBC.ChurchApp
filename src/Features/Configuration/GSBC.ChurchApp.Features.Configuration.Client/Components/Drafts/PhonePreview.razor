@inject TimeProvider Clock

@if (!Compact)
{
    <SelectField Label="Preview on" Options="Devices" Value="@_device.Name" ValueChanged="name => _device = PhoneDevice.All.Single(device => device.Name == name)" />
}
<PhoneFrame Title="@HubSurfaces.Top.In(Shown).Title" Bell="true" Tabs="ShownTabs" Palette="@Chosen.Palette" Theme="@(Theme ?? Chosen.Custom)" Scheme="Scheme" Device="_device" Label="@($"A preview of Home with this draft on an {_device.Name}, as a visitor would see it")">
    <HomeScreen Shown="Shown" At="Now" />
</PhoneFrame>
@if (!Compact)
{
    <p>A preview of Home with this draft, as a visitor would see it today, drawn by the app's own screen. Preview it on your phone under More → Previews.</p>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<ArrangedSurface> Hub { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<ArrangedSurface> Appearance { get; set; }
    [Parameter] public IReadOnlyList<ArrangedSurface> Tabs { get; set; } = [];

    private static readonly IReadOnlyList<FieldOption> Devices =
        PhoneDevice.All.Select(device => new FieldOption(device.Name, $"{device.Name} · {device.Size} points")).ToList();

    private PhoneDevice _device = PhoneDevice.IPhone15Pro;

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private IReadOnlyList<AppTab> ShownTabs => Tabs.Count == 0 ? TabBar.Starting : TabBar.For(Tabs.Where(entry => entry.IsShownTo(Viewer.Anonymous, Now)));

    private List<ArrangedSurface> Shown => Hub.Where(entry => entry.IsShownTo(Viewer.Anonymous, Now)).ToList();

    [Parameter] public ThemeSpec? Theme { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public ThemeScheme? Scheme { get; set; }

    private AppearanceSurfaces.ChosenTheme Chosen => AppearanceSurfaces.ChosenFrom(Appearance.Where(entry => entry.IsShownTo(Viewer.Anonymous, Now)));
}
