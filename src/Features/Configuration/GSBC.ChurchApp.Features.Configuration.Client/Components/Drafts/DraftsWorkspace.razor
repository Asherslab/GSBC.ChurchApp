    private async Task RefreshAsync()
    {
        _behind = false;
        _missedWhileSaving = false;
        try
        {
            _list = await LoadListAsync();
            _loadProblem = null;
        }
        catch (RpcException exception)
        {
            _loadProblem = exception.StatusCode == StatusCode.Unauthenticated
                ? "Sign in to see and change drafts."
                : exception.StatusCode == StatusCode.Unavailable ? "The church's server can't be reached. This page tries again when it's back." : exception.Status.Detail;
            return;
        }
        if (DraftId != _opened)
            await OpenDraftAsync(DraftId);
        if (_session is null)
            return;
        if (_saving)
        {
            _behind = _missedWhileSaving = true;
            return;
        }
        CatchUpWithOthers();
        if (_session is not null && !_session.HasUnsaved && _form is null)
        {
            foreach (AreaKey area in _session.TouchedAreas.Append(_area).Distinct().ToList())
                await LoadLiveAsync(area);
        }
        else if (_session is not null)
        {
            _behind = true;
        }
    }

    private void CatchUpWithOthers()
    {
        Draft? latest = _list!.Drafts.FirstOrDefault(draft => draft.Id == _session!.Draft.Id);
        if (latest is null)
        {
            _message = GoneMessage(_session!.Draft.Name, _session.HasUnsaved);
            _session = null;
            Deselect();
            Navigation.NavigateTo(BasePath);
            return;
        }
        if (latest.Revision == _session!.Draft.Revision)
            return;

        PatchMessage? before = _session.Draft.Changes.FirstOrDefault(change => change.PlacementId == _formId);
        PatchMessage? after = latest.Changes.FirstOrDefault(change => change.PlacementId == _formId);
        _session.Accept(latest);
        if (_form is not null && !SamePatch(before, after))
            _changedWhileEditing = true;
    }

    private static bool SamePatch(PatchMessage? before, PatchMessage? after) =>
        before is null || after is null ? before == after : Encode(before).AsSpan().SequenceEqual(Encode(after));

    private static byte[] Encode(PatchMessage patch)
    {
        using MemoryStream stream = new();
        ConfigurationContractsModel.Instance.Serialize(stream, patch);
        return stream.ToArray();
    }

    private string GoneMessage(string name, bool hadUnsaved)
    {
        PublishedDraft? published = _list!.Published.FirstOrDefault(entry => entry.Name == name);
        string what = published is null ? $"“{name}” was deleted by someone else." : $"{published.By} published “{name}”, so it's live for everyone now.";
        return hadUnsaved ? $"{what} Your last changes in it weren't saved." : what;
    }

