    private Task TurnOnAsync((DateTime? StartsAt, DateTime? EndsAt) when) => RunAsync(async () =>
    {
        await SaveNowAsync();
        Draft on = await Drafts.TurnOnAsync(_session!.Draft.Id, when.StartsAt, when.EndsAt);
        _session.Accept(on);
        _turningOn = false;
        _more = false;
        _list = await LoadListAsync();
    });

    private Task TurnOffAsync(Draft layer) => RunAsync(async () =>
    {
        await Drafts.TurnOffAsync(layer.Id);
        _more = false;
        _list = await LoadListAsync();
        if (_session?.Draft.Id == layer.Id)
            _session.Accept(await Drafts.GetAsync(layer.Id));
    });

    private Task ChangeDatesAsync(Draft layer)
    {
        if (_session?.Draft.Id == layer.Id)
            _turningOn = true;
        else
            Navigation.NavigateTo($"{BasePath}/{layer.Id}");
        return Task.CompletedTask;
    }

    private Task UndoAsync(PublishedDraft published) => RunAsync(async () =>
    {
        await Configuration.RollBackAsync(published.BatchId);
        _message = $"Undid “{published.Name}”. Phones show it within a few seconds. Open it under Published recently to publish it again.";
        _list = await LoadListAsync();
    });

    private Task PublishAgainAsync(PublishedDraft published) => RunAsync(async () =>
    {
        await Configuration.RollBackAsync(published.UndoneBatchId!);
        _message = $"Published “{published.Name}” again. Phones show it within a few seconds.";
        _list = await LoadListAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _undoKeys = await Shell.HearUndoKeysAsync(StepAsync);
    }

    public async ValueTask DisposeAsync()
    {
        _pending?.Cancel();
        if (_undoKeys is not null)
            await _undoKeys.DisposeAsync();
    }
}
