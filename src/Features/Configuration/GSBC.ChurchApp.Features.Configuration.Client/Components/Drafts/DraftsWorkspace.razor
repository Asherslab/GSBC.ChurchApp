    private void CatchUpLater()
    {
        if (_behind)
            _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
    }

    private async Task OpenDraftAsync(string? draftId)
    {
        await SaveNowAsync();
        _opened = draftId;
        _session = null;
        Deselect();
        _problem = null;
        if (draftId is null)
            return;

        try
        {
            _session = new DraftSession(await Drafts.GetAsync(draftId), Surfaces);
        }
        catch (RpcException exception) when (exception.StatusCode == StatusCode.NotFound)
        {
            _message = "That draft isn't there any more: it was published or deleted.";
            return;
        }

        _view = View.Drafts;
        _save = SaveState.Saved;
        _rename = _session.Draft.Name;
        AreaKey? requested = AreaKey is not null && Surfaces.Areas.ContainsKey(AreaKey) ? new AreaKey(AreaKey, null) : null;
        AreaKey? touched = _session.TouchedAreas.Where(area => Surfaces.Areas.ContainsKey(area.Area)).Cast<AreaKey?>().FirstOrDefault();
        _area = requested ?? touched ?? new AreaKey(EditableAreas.FirstOrDefault()?.Key ?? HubSurfaces.Area.Key, null);
        foreach (AreaKey area in _session.TouchedAreas.Append(_area).Concat(PreviewAreas).Distinct().ToList())
            await LoadLiveAsync(area);
    }

    private static readonly AreaKey[] PreviewAreas = [new(HubSurfaces.Area.Key, null), new(AppearanceSurfaces.Area.Key, null)];

    private async Task LoadLiveAsync(AreaKey area)
    {
        if (_session is null || !Surfaces.Areas.TryGetValue(area.Area, out SurfaceArea? known))
            return;
        try
        {
            _session.UseLive(area, (await Configuration.GetAreaAsync(known, area.ScopeId)).Placements.Select(placement => placement.ToStored()));
        }
        catch (RpcException exception) when (exception.StatusCode == StatusCode.PermissionDenied)
        {
            _session.UseLive(area, []);
            _problem = $"You can't arrange {known.Title}, so you can see but not change that part of this draft.";
        }
    }

