@inject IPeopleDirectory Directory

<PeopleSheet Source="Reviewers" View="View" Title="@($"Share “{Draft.Name}”")" Open="Open" OpenChanged="OpenChanged"
             Lead="Reviewers preview it on their phone and watch it change as you edit. They can't change it."
             Empty="Not shared with anyone yet." />

@code {
    private const string ReviewerRole = "reviewer";

    private static readonly PlaceRoleView Reviewer = new(ReviewerRole, "Reviewer", "Preview this draft on their phone",
        [new AbilityGroup("App", ["Preview this draft on their phone, and watch it change as it's edited"])], null);

    [Parameter, EditorRequired] public required Draft Draft { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> Names { get; set; } = new Dictionary<string, string>();
    [Parameter] public EventCallback<string> OnShare { get; set; }
    [Parameter] public EventCallback<string> OnUnshare { get; set; }

    private DraftPeople Reviewers => field ??= new DraftPeople(this);

    private PlacePeopleView View => new([Reviewer],
        Draft.SharedWith.Select(id => new PlacePersonView(id, Names.GetValueOrDefault(id, "Someone"), null, [ReviewerRole])).ToList());

    private sealed class DraftPeople(ShareSheet sheet) : IPlacePeople
    {
        public IReadOnlyCollection<string> Feeds => [];

        public Task<PlacePeopleView> LoadAsync() => Task.FromResult(sheet.View);

        public async Task<IReadOnlyList<PersonChoice>> FindAsync(string query) =>
            (await sheet.Directory.SearchAsync(query))
                .Where(person => !person.Disabled)
                .Select(person => new PersonChoice(person.Id, person.Name, person.Email))
                .ToList();

        public Task GiveAsync(string userId, string roleId) => sheet.OnShare.InvokeAsync(userId);

        public Task TakeAwayAsync(string userId, string roleId) => sheet.OnUnshare.InvokeAsync(userId);
    }
}
