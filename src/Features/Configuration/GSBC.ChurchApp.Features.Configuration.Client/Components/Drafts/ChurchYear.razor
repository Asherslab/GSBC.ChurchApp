@inject DatedChanges Dated
@inject TimeProvider Clock

<div class="church-year">
    <div class="church-year__head">
        <h2 class="section__title">The coming weeks</h2>
        <p class="section__lead">The event layer and everything with dates: what's published, and what's waiting in drafts.</p>
    </div>
    <LiveData TValue="IReadOnlyList<DatedLane>" Load="LoadAsync" Feeds="[ConfigurationFeeds.Placements, ConfigurationFeeds.Drafts]">
        <div class="church-year__grid" style="--weeks: @Weeks">
            <span></span>
            @for (int week = 0; week < Weeks; week++)
            {
                <span class="church-year__week @(week == 0 ? "church-year__week--now" : "")">@(week == 0 ? "This week" : DraftWords.Day(WeekStart(week)))</span>
            }
            @foreach (DatedLane lane in context.Value)
            {
                <span class="church-year__lane">@lane.Title</span>
                <div class="church-year__track">
                    @if (lane.Spans.Count == 0)
                    {
                        <span class="church-year__quiet">Nothing dated</span>
                    }
                    @foreach (DatedSpan span in lane.Spans)
                    {
                        <button type="button" class="church-year__span church-year__span--@KindClass(span.Kind)" style="grid-column: @Column(span.StartsAt) / @(Column(span.EndsAt) + 1)"
                                title="@span.Title" @onclick="() => OnOpen.InvokeAsync(span.DraftId)" disabled="@(span.DraftId is null)">
                            @span.Title
                        </button>
                    }
                </div>
            }
        </div>
    </LiveData>
</div>

@code {
    private const int Weeks = 8;

    [Parameter, EditorRequired] public required DraftList List { get; set; }
    [Parameter] public EventCallback<string?> OnOpen { get; set; }

    private DateTime Today => ChurchTime.ToUtc(ChurchTime.ToChurch(Clock.GetUtcNow().UtcDateTime).Date);

    private DateTime WeekStart(int week) => Today.AddDays(7 * week);

    private int Column(DateTime at) => Math.Clamp((int)Math.Floor((at - Today).TotalDays / 7) + 1, 1, Weeks);

    private Task<IReadOnlyList<DatedLane>> LoadAsync() => Dated.LanesAsync(List, Today, WeekStart(Weeks));

    private static string KindClass(DatedKind kind) => kind switch
    {
        DatedKind.Layer => "layer",
        DatedKind.Draft => "draft",
        _ => "live",
    };
}
