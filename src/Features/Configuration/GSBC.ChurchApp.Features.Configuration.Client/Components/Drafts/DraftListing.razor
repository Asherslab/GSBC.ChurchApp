@inject SurfaceCatalog Surfaces

@if (Waiting.Count > 0)
{
    <h2 class="draft-list__head">Waiting to publish <span class="tab-strip__count">@Waiting.Count</span></h2>
    <ListGroup>
        @foreach (Draft draft in Waiting)
        {
            <ListRow Title="@draft.Name" Subtitle="@($"{Author(draft)} · {DraftWords.Touches(draft, Surfaces)}")" Icon="send" IconTone="RowTone.Warm"
                     Class="@RowClass(draft)" OnClick="() => OnOpen.InvokeAsync(draft)" />
        }
    </ListGroup>
}

<h2 class="draft-list__head">
    Open
    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="plus" OnClick="OnNew">New draft</Button>
</h2>
@if (Open.Count == 0)
{
    <p class="draft-list__empty">A draft is a set of changes to the app that only you, and people you share it with, can see until it's published.</p>
}
else
{
    <ListGroup>
        @foreach (Draft draft in Open)
        {
            <ListRow Title="@draft.Name" Subtitle="@($"{Author(draft)} · {DraftWords.Touches(draft, Surfaces)}")" Icon="@(draft.LayerOn ? "calendar" : "pencil")"
                     IconTone="@(draft.LayerOn ? RowTone.Accent : RowTone.Primary)" Class="@RowClass(draft)" OnClick="() => OnOpen.InvokeAsync(draft)">
                <Below>
                    @if (ToCheck(draft) is > 0 and var count)
                    {
                        <Pill Icon="alert">@(count == 1 ? "1 change to check" : $"{count} changes to check")</Pill>
                    }
                    @if (draft.SharedWith.Count > 0)
                    {
                        <span class="row__subtitle">Shared with @string.Join(", ", draft.SharedWith.Select(id => Names.GetValueOrDefault(id, "someone")))</span>
                    }
                </Below>
            </ListRow>
        }
    </ListGroup>
}

@if (List.Published.Count > 0)
{
    <h2 class="draft-list__head">Published recently</h2>
    <ListGroup>
        @foreach (PublishedDraft published in List.Published)
        {
            <ListRow Title="@published.Name" Subtitle="@($"{string.Join(", ", published.Areas)} · {Names.GetValueOrDefault(published.By, "Someone")} · {DraftWords.Day(published.At)}")"
                     Icon="@(published.UndoneBatchId is null ? "check" : "undo")" IconTone="RowTone.Quiet" OnClick="() => _looking = published">
                <Below>
                    @if (published.UndoneBatchId is not null)
                    {
                        <Pill>Undone</Pill>
                    }
                </Below>
            </ListRow>
        }
    </ListGroup>
}

<Sheet Open="_looking is not null" OpenChanged="open => { if (!open) _looking = null; }" Title="@_looking?.Name" Lead="@PublishedLead">
    <ChildContent>
        @if (_looking is { } published)
        {
            @if (published.UndoneBatchId is null)
            {
                <p class="published-sheet__text">If you undo it, @Places(published) @(published.Areas.Count == 1 ? "goes" : "go") back to how @(published.Areas.Count == 1 ? "it was" : "they were") before “@published.Name” was published, for everyone, within a few seconds. Anything it changed goes back, even if it was changed again since.</p>
                <p class="published-sheet__text">You can publish it again afterwards from here.</p>
            }
            else
            {
                <p class="published-sheet__text">@Names.GetValueOrDefault(published.UndoneBy ?? "", "Someone") undid it on @DraftWords.Day(published.UndoneAt ?? published.At), so @Places(published) @(published.Areas.Count == 1 ? "is" : "are") as @(published.Areas.Count == 1 ? "it was" : "they were") before.</p>
                <p class="published-sheet__text">Publish it again and its changes come back for everyone within a few seconds. Anything changed since it was undone goes back to how this publish left it.</p>
            }
            @if (!MayUndo)
            {
                <Notice Text="Only someone who can publish can undo it or publish it again." />
            }
        }
    </ChildContent>
    <Actions>
        @if (_looking is { } published && MayUndo)
        {
            @if (published.UndoneBatchId is null)
            {
                <Button Variant="ButtonVariant.Danger" Block="true" Icon="undo" OnClick="() => ActAsync(OnUndo, published)">Undo this publish</Button>
            }
            else
            {
                <Button Block="true" Icon="redo" OnClick="() => ActAsync(OnPublishAgain, published)">Publish it again</Button>
            }
        }
        <Button Variant="ButtonVariant.Quiet" Block="true" OnClick="() => _looking = null">@(MayUndo ? "Cancel" : "Close")</Button>
    </Actions>
</Sheet>

@code {
    [Parameter, EditorRequired] public required DraftList List { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> Names { get; set; } = new Dictionary<string, string>();
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public bool MayUndo { get; set; }
    [Parameter] public EventCallback<Draft> OnOpen { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<PublishedDraft> OnUndo { get; set; }
    [Parameter] public EventCallback<PublishedDraft> OnPublishAgain { get; set; }

    private PublishedDraft? _looking;

    private string? PublishedLead => _looking is { } published
        ? $"Published by {(Names.GetValueOrDefault(published.By, "someone"))} on {DraftWords.Day(published.At)} · {(published.Changes == 1 ? "1 change" : $"{published.Changes} changes")}"
        : null;

    private static string Places(PublishedDraft published) =>
        published.Areas.Count == 0 ? "the app" : "the " + string.Join(" and ", published.Areas.Select(area => area == published.Areas[0] ? area : area.ToLowerInvariant()));

    private async Task ActAsync(EventCallback<PublishedDraft> action, PublishedDraft published)
    {
        _looking = null;
        await action.InvokeAsync(published);
    }

    private List<Draft> Waiting => List.Drafts.Where(draft => draft.Status == DraftStatus.WaitingToPublish).ToList();

    private List<Draft> Open => List.Drafts.Where(draft => draft.Status == DraftStatus.Open).ToList();

    private string Author(Draft draft) => draft.Mine ? "You" : Names.GetValueOrDefault(draft.AuthorId, "Someone");

    private static int ToCheck(Draft draft) => draft.ToCheck;

    private string? RowClass(Draft draft) => draft.Id == SelectedId ? "row--selected" : null;
}
