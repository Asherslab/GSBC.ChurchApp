@switch (Setting)
{
    case YesNoSetting yesNo:
        <ToggleRow Title="@Setting.Label" Description="@Help" Checked="@(yesNo.TryParse(Value, out bool on) && on)" CheckedChanged="checkedNow => SetAsync(yesNo.Format(checkedNow))" />
        break;
    case AudienceSetting:
        <AudiencePicker Label="@Setting.Label" Value="@Value" ValueChanged="SetAsync" />
        break;
    case ChoiceSetting choice:
        <SelectField Label="@Setting.Label" Options="@choice.Choices.Select(option => new FieldOption(option.Value, option.Label)).ToList()" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case NumberSetting number:
        <TextField Label="@Setting.Label" Type="number" Min="@number.Minimum.ToString()" Max="@number.Maximum.ToString()" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case DateSetting:
        <TextField Label="@Setting.Label" Type="date" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case TextSetting text:
        <TextField Label="@Setting.Label" Type="@(text.IsLink ? "url" : "text")" MaxLength="text.MaxLength" Required="text.Required" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
}

@code {
    [Parameter, EditorRequired] public required Setting Setting { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private string? Help => Setting.Help.Length > 0 ? Setting.Help : null;

    private string? Problem => Setting.ProblemWith(Value);

    private Task SetAsync(string value) => ValueChanged.InvokeAsync(value);
}
