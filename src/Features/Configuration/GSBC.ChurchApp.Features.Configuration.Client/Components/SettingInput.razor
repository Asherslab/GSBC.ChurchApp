@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Ui.Content
@inject IServiceProvider Services

@switch (Setting)
{
    case YesNoSetting yesNo:
        <label>
            <input type="checkbox" checked="@yesNo.TryParse(Value, out bool on) && on" @onchange="change => SetAsync(yesNo.Format(change.Value is true))" />
            @Setting.Label
        </label>
        break;
    case AudienceSetting:
        <AudiencePicker Label="@Setting.Label" Value="@Value" ValueChanged="SetAsync" />
        break;
    case ChoiceSetting choice:
        <label>
            @Setting.Label
            <select value="@Value" @onchange="ChangeAsync">
                @foreach (Choice option in choice.Choices)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </label>
        break;
    case NumberSetting number:
        <label>@Setting.Label <input type="number" min="@number.Minimum" max="@number.Maximum" value="@Value" @onchange="ChangeAsync" /></label>
        break;
    case DateSetting:
        <label>@Setting.Label <input type="date" value="@Value" @onchange="ChangeAsync" /></label>
        break;
    case MediaSetting media:
        <div class="media-setting">
            <span>@Setting.Label</span>
            @if (media.TryParse(Value, out MediaRef? chosen) && chosen is not null)
            {
                <MediaImage Media="chosen" Class="media-thumbnail" />
                <button type="button" class="link" @onclick="() => SetAsync(media.Format(null))">Remove</button>
            }
            @if (_choosing)
            {
                <MediaChooser ImagesOnly="media.ImagesOnly" OnChosen="chosenMedia => ChooseAsync(media, chosenMedia)" OnCancel="() => _choosing = false" />
            }
            else if (MediaChooser.IsAvailable(Services))
            {
                <button type="button" @onclick="() => _choosing = true">@(chosen is null ? "Choose" : "Change")</button>
            }
        </div>
        break;
    case RichTextSetting richText:
        <RichTextEditor Label="@Setting.Label" Value="@(richText.TryParse(Value, out RichText content) ? content : new RichText())"
                        ValueChanged="changed => SetAsync(richText.Format(changed))" MaximumLength="richText.MaxLength" Rows="6" />
        break;
    case TextSetting text:
        <label>
            @Setting.Label
            <input type="@(text.IsLink ? "url" : "text")" maxlength="@text.MaxLength" required="@text.Required" value="@Value" @onchange="ChangeAsync" />
        </label>
        break;
}
@if (Setting.Help.Length > 0)
{
    <small>@Setting.Help</small>
}
@if (Setting.ProblemWith(Value) is { } problem)
{
    <small class="message">@problem</small>
}

@code {
    private bool _choosing;

    [Parameter, EditorRequired] public required Setting Setting { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task ChangeAsync(ChangeEventArgs change) => SetAsync(change.Value?.ToString() ?? "");

    private Task SetAsync(string value) => ValueChanged.InvokeAsync(value);

    private Task ChooseAsync(MediaSetting setting, MediaRef chosen)
    {
        _choosing = false;
        return SetAsync(setting.Format(chosen));
    }
}
