@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media

@switch (Setting)
{
    case YesNoSetting yesNo:
        <ToggleRow Title="@Setting.Label" Description="@Help" Checked="@(yesNo.TryParse(Value, out bool on) && on)" CheckedChanged="checkedNow => SetAsync(yesNo.Format(checkedNow))" />
        break;
    case AudienceSetting:
        <AudiencePicker Label="@Setting.Label" Value="@Value" ValueChanged="SetAsync" />
        break;
    case ThemeChoiceSetting themes:
        <SelectField Label="@Setting.Label" Options="@themes.Choices.Concat(MoreChoices).Select(option => new FieldOption(option.Value, option.Label)).ToList()" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case ChoiceSetting choice:
        <SelectField Label="@Setting.Label" Options="@choice.Choices.Select(option => new FieldOption(option.Value, option.Label)).ToList()" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case NumberSetting number:
        <TextField Label="@Setting.Label" Type="number" Min="@number.Minimum.ToString()" Max="@number.Maximum.ToString()" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case DateSetting:
        <DateField Label="@Setting.Label" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
    case MediaSetting media:
        <PictureField Label="@Setting.Label" Value="@(media.TryParse(Value, out MediaRef? chosen) ? chosen : null)" ValueChanged="picture => SetAsync(media.Format(picture))"
                      Size="media.ShownAt" ImagesOnly="media.ImagesOnly" Adding="@(media.ImagesOnly ? "Choose a picture" : "Choose a file")" />
        break;
    case RichTextSetting richText:
        <RichTextEditor Label="@Setting.Label" Value="@(richText.TryParse(Value, out RichText content) ? content : new RichText())"
                        ValueChanged="changed => SetAsync(richText.Format(changed))" MaximumLength="richText.MaxLength" Rows="6" />
        break;
    case IconSetting:
        <SelectField Label="@Setting.Label" Options="@IconOptions" Value="@Value" ValueChanged="SetAsync" Problem="@Problem" />
        break;
    case LinkSetting:
        <TextField Label="@Setting.Label" Value="@Value" ValueChanged="SetAsync" Hint="A place in the app such as /sermons, or a web page starting with https://" Problem="@Problem" />
        break;
    case SvgIconSetting:
        <div class="media-setting">
            <span class="field__label">@Setting.Label</span>
            <span class="row__icon hub-icon--primary"><SvgIcon Drawing="@Value" /></span>
        </div>
        break;
    case FocusSetting:
    case TemplateSetting:
    case KindSetting:
        break;
    case TextSetting text:
        <TextField Label="@Setting.Label" Type="@(text.IsLink ? "url" : "text")" MaxLength="text.MaxLength" Required="text.Required" Value="@Value" ValueChanged="SetAsync" Hint="@Help" Problem="@Problem" />
        break;
}

@code {
    [Parameter, EditorRequired] public required Setting Setting { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<Choice> MoreChoices { get; set; } = [];

    private IReadOnlyList<FieldOption> IconOptions =>
    [
        new("", "No icon"),
        .. IconPicker.BuiltIn.Select(name => new FieldOption(name, IconPicker.Words(name))),
        .. IconSetting.IsCustom(Value) ? [new FieldOption(Value, "An uploaded icon")] : Array.Empty<FieldOption>(),
    ];

    private string? Help => Setting.Help.Length > 0 ? Setting.Help : null;

    private string? Problem => Setting.ProblemWith(Value);

    private Task SetAsync(string value) => ValueChanged.InvokeAsync(value);
}
