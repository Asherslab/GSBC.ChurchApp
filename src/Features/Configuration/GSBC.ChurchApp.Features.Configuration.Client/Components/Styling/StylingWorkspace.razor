    private async Task ChangeAsync(string areaKey, string? key)
    {
        if (!Surfaces.Areas.TryGetValue(areaKey, out SurfaceArea? area) || !MayEdit(area))
            return;
        List<Draft> mine = MyOpenDrafts;
        _message = null;
        if (mine.Count == 1)
        {
            await CarryOnAsync(mine[0], (areaKey, key));
            return;
        }
        _choosing = (areaKey, key);
        if (mine.Count == 0)
            await StartForChangeAsync();
    }

