@implements IAsyncDisposable
@inject DraftsClient Drafts
@inject ConfigurationClient Configuration
@inject SurfaceCatalog Surfaces
@inject IAccess Access
@inject IPeopleDirectory People
@inject NavigationManager Navigation
@inject Shell Shell
@inject TimeProvider Clock
@inject SurfaceViews Views
@inject IEnumerable<HubTileKind> TileKinds
@inject IServiceProvider Services

<RefreshOn Feeds="[ConfigurationFeeds.Drafts, ConfigurationFeeds.Placements]" Changed="RefreshAsync" />

@if (_list is null && _loadProblem is not null)
{
    <TitleBand Title="App styling" />
    <EmptyState Icon="alert" Title="Can't show the app's styling right now" Body="@_loadProblem" />
}
else if (_list is null)
{
    <TitleBand Title="App styling" />
    <Skeleton Count="4" Label="Loading the app's styling" />
}
else
{
    DraftSession shown = Shown;
    <div class="styling @(_session is null ? "" : "styling--drafting")">
        <TitleBand Title="@(_session?.Draft.Name ?? "App styling")" BrowserTitle="App styling">
            <LeadContent>
                @if (_session is { } session)
                {
                    <div class="styling__line">
                        <SaveStatus State="_save" SavedText="Saved" Detail="@SharedText(session.Draft)" Retry="SaveNowAsync" />
                        <span class="draft-pane__step-slot">
                            @if (_stepNote is not null && session.Edits == _stepNoteAt)
                            {
                                <span class="draft-pane__step-note" role="status">
                                    <span class="draft-pane__step-words">@_stepNote</span>
                                    <button type="button" class="draft-pane__step-again" @onclick="@(_stepOffersRedo ? StepForwardAsync : StepBackAsync)">@(_stepOffersRedo ? "Redo" : "Undo")</button>
                                </span>
                            }
                        </span>
                        <button type="button" class="link styling__leave" @onclick="BackToEveryoneAsync">Back to what everyone sees</button>
                    </div>
                }
                else
                {
                    <p class="title-band__lead styling__sentence">@Sentence</p>
                }
            </LeadContent>
            <Actions>
                <div class="ui-actions draft-pane__actions">
                    @if (_session is { } session)
                    {
                        <span class="draft-pane__steps" role="group" aria-label="Undo and redo" data-undo-keys>
                            <Button Variant="ButtonVariant.Quiet" Icon="undo" AriaLabel="Undo" Tooltip="Undo (⌘Z, or Ctrl+Z)" Disabled="@(!session.CanStepBack)" OnClick="StepBackAsync" />
                            <Button Variant="ButtonVariant.Quiet" Icon="redo" AriaLabel="Redo" Tooltip="Redo (⇧⌘Z, or Ctrl+Shift+Z)" Disabled="@(!session.CanStepForward)" OnClick="StepForwardAsync" />
                        </span>
                    }
                    <DraftsMenu List="_list" Names="_names" SelectedId="@_session?.Draft.Id" MayUndo="MayPublishAnything" PublishedNote="_publishedNote" TriggerClass="btn btn--quiet"
                                OnOpen="draft => OpenAsync(draft.Id)" OnNew="() => _naming = true" OnUndo="UndoAsync" OnPublishAgain="PublishAgainAsync">
                        <span>Drafts</span>
                        @if (_list.Drafts.Count > 0)
                        {
                            <span class="drafts-menu__count">@_list.Drafts.Count</span>
                        }
                    </DraftsMenu>
                    @if (_session is { } drafting)
                    {
                        <Button Variant="ButtonVariant.Quiet" Icon="share" AriaLabel="Share" Tooltip="Share" OnClick="() => _sharing = true"><span class="draft-pane__label">Share</span></Button>
                        <Button Variant="ButtonVariant.Quiet" Icon="more" AriaLabel="More" Tooltip="More" OnClick="OpenMore"><span class="draft-pane__label">More</span></Button>
                        @if (MayPublishDraft)
                        {
                            <Button Busy="_busy" Disabled="@(drafting.ChangedForEveryone.Count > 0 || !drafting.Patches.Any() || _save == SaveState.Failed)" OnClick="PublishAsync">Publish now</Button>
                        }
                        else if (drafting.Draft.Status == DraftStatus.WaitingToPublish)
                        {
                            <Button Disabled="true">Waiting to publish</Button>
                        }
                        else
                        {
                            <Button Busy="_busy" Disabled="@(!drafting.Patches.Any())" OnClick="AskToPublishAsync">Ask to publish</Button>
                        }
                    }
                </div>
            </Actions>
        </TitleBand>

        <div class="styling__desk">
            <div class="styling__stage">
                <StylingPhone Hub="@shown.Arranged(HubSurfaces.Area, null)" Appearance="@shown.Arranged(AppearanceSurfaces.Area, null)" Tabs="@shown.Arranged(TabBarSurfaces.Area, null)"
                              Preview="_preview" Theme="EditingTheme" SelectedKey="@_selectedKey" Marks="@(_session is null ? NoMarks : TileMarks(_session))" Still="@(_session is null || !MayEdit(HubSurfaces.Area))"
                              Showing="@(_session is null ? "What everyone sees" : $"“{_session.Draft.Name}”")" OnChoose="ChooseAsync" OnTabBar="ChooseTabBarAsync"
                              OnMove="ArrangeTilesAsync" OnResize="ResizeTileAsync" OnScheme="SchemeFound" />
                <PreviewChips Value="_preview" ValueChanged="preview => _preview = preview" Roles="RolesInUse(shown)" RoleNames="_roleNames" />
            </div>
            <div class="styling__panel">
                @Notices
                @Panel
            </div>
        </div>
    </div>

    @if (_session is not null)
    {
        <AddTileSheet Open="_addingTile" OpenChanged="open => _addingTile = open" OnChosen="AddTile" Saved="SavedTiles" Library="Library" />
        <SaveToLibrarySheet Open="_savingTile" OpenChanged="open => _savingTile = open" Suggested="@SuggestedLibraryName" Saved="SavedTiles" OnSave="SaveTile" OnReplace="ReplaceSaved" />
        <ShareSheet Draft="_session.Draft" Open="_sharing" OpenChanged="open => _sharing = open" Names="_names" OnShare="ShareAsync" OnUnshare="UnshareAsync" />
        <ForEveryoneSheet Draft="_session.Draft" Open="_turningOn" OpenChanged="open => _turningOn = open" Starting="_startingWay" Busy="_busy" Problem="@_problem"
                          Replacing="@(Layer is { } layer && layer.Id != _session.Draft.Id ? layer.Name : null)" OnTurnOn="TurnOnAsync" OnSchedulePublish="SchedulePublishAsync" />
        <Sheet Open="_more" OpenChanged="open => _more = open" Title="@_session.Draft.Name">
            <ChildContent>
                <TextField Label="Name" Value="@_rename" ValueChanged="value => _rename = value" MaxLength="80" />
                <ListGroup>
                    <ListRow Title="Undo" Subtitle="Take back your last change (⌘Z, or Ctrl+Z)" Icon="undo" Disabled="@(!_session.CanStepBack)" OnClick="() => StepFromMoreAsync(StepBackAsync)" />
                    <ListRow Title="Redo" Subtitle="Bring back what you undid (⇧⌘Z, or Ctrl+Shift+Z)" Icon="redo" Disabled="@(!_session.CanStepForward)" OnClick="() => StepFromMoreAsync(StepForwardAsync)" />
                    <ListRow Title="Open the preview in its own window" Subtitle="For a second screen; it follows this draft as you change it" Icon="external-link" OnClick="PopOutAsync" />
                </ListGroup>
                <ListGroup>
                    @if (MayPublishDraft)
                    {
                        @if (_session.Draft.LayerOn)
                        {
                            <ListRow Title="Turn off for the event" Subtitle="Everyone goes back to what's published" Icon="calendar" OnClick="() => TurnOffAsync(_session.Draft)" />
                        }
                        else
                        {
                            <ListRow Title="Turn on for everyone, or publish on a date" Subtitle="Now or between two dates, then off again; or published for good at a time you choose" Icon="calendar" OnClick="() => ChooseForEveryone(ForEveryoneWay.TryNow)" />
                        }
                        @if (_session.Draft.PublishAt is not null)
                        {
                            <ListRow Title="Don't publish it on a date" Subtitle="@($"Cancels publishing it on {DraftWords.Moment(_session.Draft.PublishAt.Value)}")" Icon="x" OnClick="CancelScheduledPublishAsync" />
                        }
                    }
                    <ListRow Title="Make a copy" Subtitle="Next year's version, starting from this one" Icon="plus" OnClick="CopyAsync" />
                    @if (!_session.Draft.LayerOn)
                    {
                        <ListRow Title="@(_confirmDelete ? "Delete it: nothing reached everyone" : "Delete this draft")" Icon="x" IconTone="RowTone.Warm" OnClick="DeleteAsync" />
                    }
                </ListGroup>
            </ChildContent>
            <Actions>
                <Button Block="true" Busy="_busy" Disabled="@(string.IsNullOrWhiteSpace(_rename) || _rename == _session.Draft.Name)" OnClick="RenameAsync">Save name</Button>
                <Button Variant="ButtonVariant.Quiet" Block="true" OnClick="() => _more = false">Close</Button>
            </Actions>
        </Sheet>
    }

    <Sheet Open="_choosing is not null" OpenChanged="open => { if (!open) _choosing = null; }" Title="Change it in which draft?" Lead="You have more than one draft open. Carry on in one of them, or start another.">
        <ChildContent>
            <ListGroup>
                @foreach (Draft draft in MyOpenDrafts)
                {
                    <ListRow Title="@draft.Name" Subtitle="@DraftWords.Touches(draft, Surfaces)" Icon="pencil" Chevron="true" OnClick="() => CarryOnAsync(draft)" />
                }
            </ListGroup>
        </ChildContent>
        <Actions>
            <Button Block="true" Icon="plus" Busy="_busy" OnClick="StartForChangeAsync">Start a new draft</Button>
            <Button Variant="ButtonVariant.Quiet" Block="true" OnClick="() => _choosing = null">Cancel</Button>
        </Actions>
    </Sheet>

    <Sheet Open="_naming" OpenChanged="open => _naming = open" Title="New draft" Lead="Name it for what it's for, so you'll know it in a few weeks.">
        <ChildContent>
            <TextField Label="Name" Placeholder="Christmas 2026" Value="@_newName" ValueChanged="value => _newName = value" MaxLength="80" />
            @if (_problem is not null && _naming)
            {
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            }
        </ChildContent>
        <Actions>
            <Button Block="true" Busy="_busy" Disabled="@string.IsNullOrWhiteSpace(_newName)" OnClick="CreateAsync">Start the draft</Button>
            <Button Variant="ButtonVariant.Quiet" Block="true" OnClick="() => _naming = false">Cancel</Button>
        </Actions>
    </Sheet>
}

@code {
    private static readonly TimeSpan SaveAfter = TimeSpan.FromSeconds(1);
    private static readonly TimeSpan RetryAfter = TimeSpan.FromSeconds(5);
    private static readonly IReadOnlyDictionary<string, string> NoMarks = new Dictionary<string, string>();

    [Parameter] public string? DraftId { get; set; }
    [Parameter] public string? AreaKey { get; set; }
    [Parameter] public string BasePath { get; set; } = "app-styling";

    private StylingPreview _preview = StylingPreview.Start;
    private bool _schemeFound;
    private bool _addingTile;
    private bool _savingTile;
    private string? _savedNote;
    private IReadOnlyDictionary<Guid, string> _roleNames = new Dictionary<Guid, string>();
    private DraftList? _list;
    private string? _loadProblem;
    private readonly Dictionary<string, string> _names = [];
    private readonly Dictionary<AreaKey, IReadOnlyList<StoredPlacement>> _everyone = [];
    private DraftSession? _session;
    private AreaKey _area;
    private bool _overview = true;
    private PlacementDraft? _form;
    private string? _formId;
    private string? _selectedKey;
    private (string Area, string? Key)? _choosing;
    private (string Area, string? Key)? _carryOn;
    private string? _madeForChange;
    private bool _askedForArea;
    private SaveState _save;
    private bool _saving;
    private CancellationTokenSource? _pending;
    private string? _problem;
    private string? _message;
    private DraftListing.Note? _publishedNote;
    private string? _stepNote;
    private bool _stepOffersRedo;
    private int _stepNoteAt;
    private WindowChannel? _undoKeys;
    private bool _busy;
    private bool _sharing;
    private bool _turningOn;
    private ForEveryoneWay _startingWay;
    private bool _more;
    private bool _naming;
    private bool _confirmDelete;
    private string _newName = "";
    private string _rename = "";
    private string? _opened;
    private bool _behind;
    private bool _missedWhileSaving;
    private bool _changedWhileEditing;

    protected override async Task OnParametersSetAsync()
    {
        if (_list is null)
        {
            await RefreshAsync();
            await LoadRoleNamesAsync();
        }
        if (_list is not null && DraftId != _opened)
            await OpenDraftAsync(DraftId);
        if (_list is not null && DraftId is null && AreaKey is { } asked && !_askedForArea && Surfaces.Areas.ContainsKey(asked))
        {
            _askedForArea = true;
            await ChangeAsync(asked, null);
        }
    }

    private Draft? Layer => _list?.Drafts.FirstOrDefault(draft => draft.LayerOn);

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private bool MayPublishAnything => Surfaces.Areas.Values.Any(area => area.ScopeKind == ScopeKind.Global && Access.Can(area.PublishPermission));

    private bool MayPublishDraft => _session is not null
        && _session.TouchedAreas.Append(_area).All(area => Surfaces.Areas.TryGetValue(area.Area, out SurfaceArea? known) && Access.Can(known.PublishPermission, area.ScopeId));

    private bool MayEdit(SurfaceArea area) => Access.Can(area.EditPermission);

    private IEnumerable<SurfaceArea> EditableAreas => Surfaces.Areas.Values.Where(area => area.ScopeKind == ScopeKind.Global && MayEdit(area));

    private SurfaceArea? CurrentArea => Surfaces.Areas.GetValueOrDefault(_area.Area);

    private List<Draft> MyOpenDrafts => _list?.Drafts.Where(draft => draft is { Mine: true, Status: DraftStatus.Open, LayerOn: false, PublishAt: null }).ToList() ?? [];

    private DraftSession Shown => _session ?? EveryoneOn(_preview.At(Now));

    private DraftSession EveryoneOn(DateTime at)
    {
        Draft? layer = _list?.Drafts.FirstOrDefault(draft => draft.LayerOn && (draft.LayerStartsAt ?? DateTime.MinValue) <= at && (draft.LayerEndsAt ?? DateTime.MaxValue) > at);
        DraftSession everyone = new(layer ?? new Draft(), Surfaces);
        foreach ((AreaKey area, IReadOnlyList<StoredPlacement> placements) in _everyone)
            everyone.UseLive(area, placements);
        return everyone;
    }

    private static IEnumerable<Guid> RolesInUse(DraftSession shown) =>
        shown.Arranged(HubSurfaces.Area, null).Concat(shown.Arranged(TabBarSurfaces.Area, null)).SelectMany(entry => entry.Audience.RoleIds).Distinct();

    private RenderFragment Sentence => __builder =>
    {
        DraftSession now = EveryoneOn(Now);
        IReadOnlyList<ArrangedSurface> appearance = now.Arranged(AppearanceSurfaces.Area, null);
        int tiles = HubTiles.TilesIn(now.Arranged(HubSurfaces.Area, null), Views).Count(entry => entry.IsShownTo(Viewer.Anonymous, Now));
        int tabs = TabBar.For(now.Arranged(TabBarSurfaces.Area, null).Where(entry => entry.IsShownTo(Viewer.Anonymous, Now))).Count + 1;
        if (Layer is { } layer && now.Draft.Id == layer.Id)
        {
            <span><b>“@layer.Name”</b> is on for everyone@(layer.LayerEndsAt is { } ends ? $" until {DraftWords.Day(ends)}" : "").</span>
            @(" ")
        }
        <span>Everyone sees <b>@ThemeNames.Chosen(appearance, Viewer.Anonymous, Now)</b>, <b>@tiles tiles</b> on Home and <b>@tabs tabs</b>.</span>
    };

    private RenderFragment Notices => __builder =>
    {
        if (_message is not null)
        {
            <Notice Text="@_message" />
        }
        if (_session is not { } session)
            return;
        Draft draft = session.Draft;
        if (_problem is not null && !_turningOn && !_naming)
        {
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        }
        if (session.ChangedForEveryone is { Count: > 0 } changedForEveryone)
        {
            int count = changedForEveryone.Count;
            <Notice Tone="NoticeTone.Warning">
                <span>@($"{(count == 1 ? "One thing" : $"{count} things")} in this draft {(count == 1 ? "was" : "were")} changed for everyone since you edited {(count == 1 ? "it" : "them")}. Choose which to keep before publishing.")</span>
                @foreach (ChangedForEveryone changed in changedForEveryone)
                {
                    <span class="styling__settle">
                        <b>@NameOfPatch(changed.Patch)</b>
                        <span class="ui-actions">
                            <Button Small="true" OnClick="() => SettleIdAsync(changed.Patch.PlacementId, keepMine: true)">Keep mine</Button>
                            <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="() => SettleIdAsync(changed.Patch.PlacementId, keepMine: false)">Use everyone's</Button>
                        </span>
                    </span>
                }
            </Notice>
        }
        foreach (string dropped in draft.LayerOn ? draft.DroppedFromLayer : [])
        {
            <Notice Tone="NoticeTone.Warning" Text="@($"Dropped {dropped} from this event: it was removed for everyone.")" />
        }
        if (draft is { LayerOn: true, LayerStartsAt: { } starts } && starts > Now)
        {
            <Notice Text="@($"This draft is on for an event from {DraftWords.When(starts)}. What you save goes out to everyone then.")" />
        }
        else if (draft.LayerOn)
        {
            <Notice Text="This draft is on for an event, so everyone sees your changes as they save." />
        }
        else if (draft.Status == DraftStatus.WaitingToPublish)
        {
            <Notice Text="Waiting for someone who can publish. If you change it, you'll need to ask again." />
        }
        if (draft is { PublishAt: { } publishAt, NotPublished: null })
        {
            <Notice>
                <span>Publishes on @DraftWords.Moment(publishAt), for good. What you save before then is published too.</span>
                @if (MayPublishDraft)
                {
                    <span class="ui-actions">
                        <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="() => ChooseForEveryone(ForEveryoneWay.PublishOn)">Change the time</Button>
                        <Button Variant="ButtonVariant.Quiet" Small="true" Busy="_busy" OnClick="CancelScheduledPublishAsync">Don't publish it then</Button>
                    </span>
                }
            </Notice>
        }
        else if (draft is { PublishAt: { } missed, NotPublished: { } reason })
        {
            <Notice Tone="NoticeTone.Warning">
                <span>It didn't publish on @DraftWords.Moment(missed). @reason</span>
                <span class="ui-actions">
                    @if (MayPublishDraft)
                    {
                        <Button Small="true" OnClick="() => ChooseForEveryone(ForEveryoneWay.PublishOn)">Choose a new time</Button>
                    }
                    <Button Variant="ButtonVariant.Quiet" Small="true" Busy="_busy" OnClick="CancelScheduledPublishAsync">Dismiss</Button>
                </span>
            </Notice>
        }
    };

    private RenderFragment Panel => __builder =>
    {
        if (_session is not { } session)
        {
            DraftSession everyone = EveryoneOn(Now);
            <StylingOverview List="_list!" Hub="@everyone.Arranged(HubSurfaces.Area, null)" Appearance="@everyone.Arranged(AppearanceSurfaces.Area, null)"
                             Tabs="@everyone.Arranged(TabBarSurfaces.Area, null)" OnPart="area => ChangeAsync(area, null)" OnComingUp="ComingUpAsync" />
            return;
        }
        if (_overview || CurrentArea is not { } area)
        {
            <section class="styling-overview" aria-labelledby="styling-draft-parts">
                <h2 id="styling-draft-parts" class="styling-panel__label">What this draft changes</h2>
                <ListGroup>
                    @foreach (SurfaceArea part in EditableAreas)
                    {
                        int count = session.CountIn(new AreaKey(part.Key, null));
                        <ListRow Title="@part.Title" Subtitle="@(count == 0 ? "No changes yet" : count == 1 ? "1 change" : $"{count} changes")" Chevron="true" OnClick="() => OpenPartAsync(part.Key)" />
                    }
                </ListGroup>
                <p class="styling-overview__quiet">Click a part of the phone, or one of these, to change it. Changes save themselves, and phones previewing this draft follow along.</p>
            </section>
            return;
        }
        if (!session.Knows(_area))
        {
            <Skeleton Count="3" Label="Loading what's there" />
            return;
        }
        if (EditingTheme is not null)
        {
            <button type="button" class="draft-pane__back" @onclick="Deselect"><Icon Name="chevron-left" Size="IconSize.Small" /> The app's colours</button>
            @ChangedWhileEditing
            <div class="theme-editor">
                <PlacementForm Draft="_form!" Changed="FormChangedAsync" Scheme="_preview.Scheme" SchemeChanged="SetScheme" />
                <div class="ui-actions tile-settings__actions">@FormActions</div>
            </div>
            return;
        }
        if (_form is not null && !IsHub && !IsTabs)
        {
            <button type="button" class="draft-pane__back" @onclick="Deselect"><Icon Name="chevron-left" Size="IconSize.Small" /> @area.Title</button>
            <div class="detail-pane__head">
                <h3>@FormTitle</h3>
                <span>@_form.Surface.Description</span>
            </div>
            @ChangedWhileEditing
            <PlacementForm Draft="_form" Changed="FormChangedAsync" MoreChoices="CustomThemes" Scheme="_preview.Scheme" SchemeChanged="SetScheme" />
            <div class="ui-actions tile-settings__actions">@FormActions</div>
            return;
        }
        if (_form is null)
        {
            <button type="button" class="draft-pane__back" @onclick="ToOverview"><Icon Name="chevron-left" Size="IconSize.Small" /> What this draft changes</button>
        }
        if (IsAppearance)
        {
            <ColoursPanel Appearance="@session.Arranged(area, null)" EveryoneValue="@EveryoneThemeValue" Drafting="true" MayChange="MayEdit(area)"
                          OnChoose="ChooseThemeAsync" OnEdit="Select" OnDates="Select" OnMake="() => Add(AppearanceSurfaces.CustomTheme.Surface, session.Arranged(area, null))" />
        }
        else if (IsHub)
        {
            if (_form is not null)
            {
                <button type="button" class="draft-pane__back" @onclick="Deselect"><Icon Name="chevron-left" Size="IconSize.Small" /> Home screen</button>
                @HubDetail
            }
            else
            {
                <HomePanel Hub="@session.Arranged(area, null)" Preview="_preview" RoleNames="_roleNames" Removed="@RemovedIn(session)"
                           OnAdd="() => _addingTile = true" OnColumns="SetColumnsAsync" OnChoose="Select" OnPutBack="UndoAsync">
                    <HubLibrary Icons="CustomIconEntries" Library="Library" OnChoose="Select" />
                </HomePanel>
            }
        }
        else if (IsTabs)
        {
            if (_form is not null)
            {
                <button type="button" class="draft-pane__back" @onclick="Deselect"><Icon Name="chevron-left" Size="IconSize.Small" /> Tab bar</button>
                @TabsDetail
            }
            else
            {
                <TabsPanel Tabs="@session.Arranged(area, null)" Preview="_preview" RoleNames="_roleNames" Removed="@RemovedIn(session)" SelectedKey="@_selectedKey"
                           Marks="@MarksIn(session, TabBarSurfaces.Area)" MayChange="MayEdit(area)" OnChoose="Select" OnMove="SetOrdersAsync"
                           OnAdd="() => Add(TabBarSurfaces.Tab, session.Arranged(area, null))" OnPutBack="UndoAsync" />
            }
        }
        else
        {
            <div class="styling-panel__head">
                <h2>@area.Title</h2>
                <p>@area.Description</p>
            </div>
            @GenericArea(session, area)
        }
    };

    private RenderFragment GenericArea(DraftSession session, SurfaceArea area) => __builder =>
    {
        IReadOnlyList<ArrangedSurface> arranged = session.Arranged(area, _area.ScopeId);
        <ListGroup>
            @for (int index = 0; index < arranged.Count; index++)
            {
                int position = index;
                ArrangedSurface entry = arranged[position];
                PlacementPatch? patch = session.PatchFor(entry.Placement?.Id);
                ChangedForEveryone? changed = session.ChangedFor(entry.Placement?.Id);
                <ListRow Title="@DraftWords.NameOf(entry)" Subtitle="@DraftWords.Summary(entry)" Icon="@(changed is not null ? "alert" : entry.Hidden ? "eye-off" : "eye")"
                         IconTone="@(changed is not null ? RowTone.Warm : entry.Hidden ? RowTone.Quiet : RowTone.Accent)"
                         Class="@RowClass(entry)" OnClick="() => Select(entry)">
                    <Below>
                        @if (patch is not null)
                        {
                            <Pill>@(patch.Kind == PatchKind.Add ? "Added in this draft" : "Changed in this draft")</Pill>
                        }
                        @if (changed is not null)
                        {
                            <span class="changed-for-everyone">
                                <b>Changed for everyone since you edited it:</b> @string.Join(", ", changed.Fields.Select(changedField => DraftWords.Field(changedField, entry.Surface))).
                                <span class="ui-actions">
                                    <Button Small="true" OnClick="() => SettleAsync(entry, keepMine: true)">Keep mine</Button>
                                    <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="() => SettleAsync(entry, keepMine: false)">Use everyone's</Button>
                                </span>
                            </span>
                        }
                    </Below>
                    <TrailingContent>
                        @if (area.Ordered && arranged.Count > 1)
                        {
                            <Button Variant="ButtonVariant.Quiet" Small="true" Icon="arrow-up" Disabled="@(position == 0)" AriaLabel="@($"Move {DraftWords.NameOf(entry)} up")" OnClick="() => MoveAsync(arranged, position, -1)" />
                            <Button Variant="ButtonVariant.Quiet" Small="true" Icon="arrow-down" Disabled="@(position == arranged.Count - 1)" AriaLabel="@($"Move {DraftWords.NameOf(entry)} down")" OnClick="() => MoveAsync(arranged, position, 1)" />
                        }
                        <Icon Name="chevron-right" Size="IconSize.Small" />
                    </TrailingContent>
                </ListRow>
            }
            @foreach (PlacementPatch removed in session.Patches.Where(patch => patch.Kind == PatchKind.Remove && patch.Touches(_area.Area, _area.ScopeId)))
            {
                ChangedForEveryone? changed = session.ChangedFor(removed.PlacementId);
                <ListRow Title="@RemovedTitle(removed)" Subtitle="Taken out in this draft" Icon="x" IconTone="RowTone.Quiet" Class="row--muted">
                    <Below>
                        @if (changed is not null)
                        {
                            <span class="changed-for-everyone">
                                <b>Changed for everyone since you took it out.</b>
                                <span class="ui-actions">
