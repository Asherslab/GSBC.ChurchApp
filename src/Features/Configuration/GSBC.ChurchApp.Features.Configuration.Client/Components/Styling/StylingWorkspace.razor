    private Task ArrangeTilesAsync(IReadOnlyList<ArrangedSurface> arranged)
    {
        HashSet<string> keys = [.. arranged.Select(KeyOf)];
        Queue<ArrangedSurface> next = new(arranged);
        List<ArrangedSurface> tiles = HubTilesNow.Select(entry => keys.Contains(KeyOf(entry)) ? next.Dequeue() : entry).ToList();
        if (tiles.Count != HubTilesNow.Count || tiles.Select(KeyOf).SequenceEqual(HubTilesNow.Select(KeyOf)))
            return Task.CompletedTask;
        for (int index = 0; index < tiles.Count; index++)
        {
            ArrangedSurface entry = tiles[index];
            int order = index * 10;
            if (entry.Order == order)
                continue;
            if (_form is not null && KeyOf(entry) == _formId)
            {
                _form.Order = order;
                _session!.Set(_area, _form.ToStored(_formId!));
                continue;
            }
            PlacementDraft moved = PlacementDraft.Of(entry);
            moved.Order = order;
            _session!.Set(_area, moved.ToStored(entry.Placement?.Id ?? Guid.CreateVersion7().ToString()));
        }
        SaveSoon();
        return Task.CompletedTask;
    }

