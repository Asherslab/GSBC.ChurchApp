    private async Task LoadRoleNamesAsync()
    {
        if (Services.GetService(typeof(IRoleDirectory)) is not IRoleDirectory roles)
            return;
        try
        {
            _roleNames = (await roles.ListAsync()).ToDictionary(role => role.Id, role => role.Name);
        }
        catch (RpcException)
        {
        }
    }

    private async Task<DraftList> LoadListAsync()
    {
        DraftList list = await Drafts.ListAsync();
        List<string> ids = list.Drafts.SelectMany(draft => draft.SharedWith.Append(draft.AuthorId)).Concat(list.Published.Select(published => published.By))
            .Where(id => !_names.ContainsKey(id)).Distinct().ToList();
        if (ids.Count > 0)
        {
            try
            {
                foreach (PersonSummary person in await People.GetAsync(ids))
                    _names[person.Id] = person.Name;
            }
            catch (RpcException)
            {
            }
        }
        return list;
    }

    private async Task RefreshAsync()
    {
        _behind = false;
        _missedWhileSaving = false;
        try
        {
            _list = await LoadListAsync();
            await LoadEveryoneAsync();
            _loadProblem = null;
        }
        catch (RpcException exception)
        {
            _loadProblem = exception.StatusCode == StatusCode.Unauthenticated
                ? "Sign in to see the app's styling."
                : exception.StatusCode == StatusCode.Unavailable ? "The church's server can't be reached. This page tries again when it's back." : exception.Status.Detail;
            return;
        }
        if (DraftId != _opened)
            await OpenDraftAsync(DraftId);
        if (_session is null)
            return;
        if (_saving)
        {
            _behind = _missedWhileSaving = true;
            return;
        }
        CatchUpWithOthers();
        if (_session is not null && !_session.HasUnsaved && _form is null)
        {
            foreach (AreaKey area in _session.TouchedAreas.Append(_area).Distinct().ToList())
                await LoadLiveAsync(area);
        }
        else if (_session is not null)
        {
            _behind = true;
        }
    }

    private void CatchUpWithOthers()
    {
        Draft? latest = _list!.Drafts.FirstOrDefault(draft => draft.Id == _session!.Draft.Id);
        if (latest is null)
        {
            _message = GoneMessage(_session!.Draft.Name, _session.HasUnsaved);
            _session = null;
            Deselect();
            Navigation.NavigateTo(BasePath);
            return;
        }
        if (latest.Revision == _session!.Draft.Revision)
            return;

        PatchMessage? before = _session.Draft.Changes.FirstOrDefault(change => change.PlacementId == _formId);
        PatchMessage? after = latest.Changes.FirstOrDefault(change => change.PlacementId == _formId);
        _session.Accept(latest);
        if (_form is not null && !SamePatch(before, after))
            _changedWhileEditing = true;
    }

    private static bool SamePatch(PatchMessage? before, PatchMessage? after) =>
        before is null || after is null ? before == after : Encode(before).AsSpan().SequenceEqual(Encode(after));

    private static byte[] Encode(PatchMessage patch)
    {
        using MemoryStream stream = new();
        ConfigurationContractsModel.Instance.Serialize(stream, patch);
        return stream.ToArray();
    }

    private string GoneMessage(string name, bool hadUnsaved)
    {
        PublishedDraft? published = _list!.Published.FirstOrDefault(entry => entry.Name == name);
        string what = published is null ? $"“{name}” was deleted by someone else." : $"{published.By} published “{name}”, so it's live for everyone now.";
        return hadUnsaved ? $"{what} Your last changes in it weren't saved." : what;
    }

    private async Task KeepMineAsync()
    {
        _changedWhileEditing = false;
        await FormChangedAsync();
    }

    private void ShowTheirs()
    {
        if (_session is null || _formId is null)
            return;
        _session.Forget(_formId);
        _changedWhileEditing = false;
        if (_session.Arranged(CurrentArea!, _area.ScopeId).FirstOrDefault(candidate => KeyOf(candidate) == _formId) is { } entry)
            Select(entry);
        else
            Deselect();
    }

    private void CatchUpLater()
    {
        if (_behind)
            _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
    }

    private async Task OpenDraftAsync(string? draftId)
    {
        await SaveNowAsync();
        if (_session?.Draft.Id != draftId)
            await ForgetUnusedAsync();
        _opened = draftId;
        _session = null;
        Deselect();
        _problem = null;
        _overview = true;
        if (draftId is null)
            return;

        try
        {
            _session = new DraftSession(await Drafts.GetAsync(draftId), Surfaces);
        }
        catch (RpcException exception) when (exception.StatusCode == StatusCode.NotFound)
        {
            _message = "That draft isn't there any more: it was published or deleted.";
            return;
        }

        _message = null;
        _save = SaveState.Saved;
        _rename = _session.Draft.Name;
        (string Area, string? Key)? carryOn = _carryOn;
        _carryOn = null;
        string? asked = carryOn?.Area ?? (AreaKey is not null && Surfaces.Areas.ContainsKey(AreaKey) ? AreaKey : null);
        _area = new AreaKey(asked ?? _session.TouchedAreas.Select(area => area.Area).FirstOrDefault(Surfaces.Areas.ContainsKey) ?? HubSurfaces.Area.Key, null);
        _overview = asked is null;
        foreach (AreaKey area in _session.TouchedAreas.Append(_area).Concat(PreviewAreas).Distinct().ToList())
            await LoadLiveAsync(area);
        if (carryOn is { Key: { } key } && _session.Arranged(Surfaces.Areas[_area.Area], null).FirstOrDefault(entry => KeyOf(entry) == key) is { } chosen)
            Select(chosen);
    }

    private static readonly AreaKey[] PreviewAreas = [new(HubSurfaces.Area.Key, null), new(AppearanceSurfaces.Area.Key, null), new(TabBarSurfaces.Area.Key, null)];

    private async Task LoadEveryoneAsync()
    {
        foreach (AreaKey area in PreviewAreas)
        {
            try
            {
                _everyone[area] = (await Configuration.GetAreaAsync(Surfaces.Areas[area.Area], null)).Placements.Select(placement => placement.ToStored()).ToList();
            }
            catch (RpcException exception) when (exception.StatusCode == StatusCode.PermissionDenied)
            {
                _everyone[area] = [];
            }
        }
    }

    private async Task LoadLiveAsync(AreaKey area)
    {
        if (_session is null || !Surfaces.Areas.TryGetValue(area.Area, out SurfaceArea? known))
            return;
        try
        {
            _session.UseLive(area, (await Configuration.GetAreaAsync(known, area.ScopeId)).Placements.Select(placement => placement.ToStored()));
        }
        catch (RpcException exception) when (exception.StatusCode == StatusCode.PermissionDenied)
        {
            _session.UseLive(area, []);
            _problem = $"You can't arrange {known.Title}, so you can see but not change that part of this draft.";
        }
    }

    private Task OpenAsync(string draftId)
    {
        Navigation.NavigateTo($"{BasePath}/{draftId}");
        return Task.CompletedTask;
    }

    private async Task SelectAreaAsync(AreaKey area)
    {
        Deselect();
        _area = area;
        if (_session is not null && !_session.Knows(area))
            await LoadLiveAsync(area);
    }

    private void Select(ArrangedSurface entry)
    {
        _savedNote = null;
        _changedWhileEditing = false;
        _form = PlacementDraft.Of(entry);
        _formId = entry.Placement?.Id ?? Guid.CreateVersion7().ToString();
        _selectedKey = KeyOf(entry);
    }

    private void Add(Surface surface, IReadOnlyList<ArrangedSurface> arranged)
    {
        _form = PlacementDraft.New(surface, arranged.Count == 0 ? surface.DefaultOrder : arranged.Max(entry => entry.Order) + 10);
        _formId = Guid.CreateVersion7().ToString();
    }

    private void Deselect()
    {
        _form = null;
        _formId = null;
        _selectedKey = null;
        _changedWhileEditing = false;
        CatchUpLater();
    }

    private Task FormChangedAsync()
    {
        if (_session is null || _form is null || _formId is null || _form.Problems.Count > 0)
            return Task.CompletedTask;
        _session.Set(_area, _form.ToStored(_formId));
        SaveSoon();
        return Task.CompletedTask;
    }

    private Task MoveAsync(IReadOnlyList<ArrangedSurface> arranged, int position, int by)
    {
        List<ArrangedSurface> reordered = [.. arranged];
        (reordered[position], reordered[position + by]) = (reordered[position + by], reordered[position]);
        return SetOrdersAsync(reordered);
    }

    private Task SetOrdersAsync(IReadOnlyList<ArrangedSurface> reordered)
    {
        int? before = null;
        foreach (ArrangedSurface entry in reordered)
        {
            if (before is null || entry.Order > before)
            {
                before = entry.Order;
                continue;
            }
            int order = before.Value + 1;
            before = order;
            if (_form is not null && KeyOf(entry) == _selectedKey)
            {
                _form.Order = order;
                _session!.Set(_area, _form.ToStored(_formId!));
                continue;
            }
            PlacementDraft moved = PlacementDraft.Of(entry);
            moved.Order = order;
            _session!.Set(_area, moved.ToStored(entry.Placement?.Id ?? Guid.CreateVersion7().ToString()));
        }
        SaveSoon();
        return Task.CompletedTask;
    }

    private Task RemoveSelectedAsync()
    {
        if (_session is null || _formId is null)
            return Task.CompletedTask;
        if (TabBarSurfaces.IsTab(_form!.Surface) && !_form.Surface.Repeatable)
        {
            string word = FormTitle;
            _form.Hidden = true;
            _session.Set(_area, _form.ToStored(_formId));
            Deselect();
            Tell($"Took “{word}” off the bar. Its page is still in the app.", offersRedo: false);
            SaveSoon();
            return Task.CompletedTask;
        }
        StoredPlacement? live = _session.LiveOf(_area, _formId);
        string note = _form!.Surface.Repeatable ? $"Took out “{FormTitle}”." : $"Put “{FormTitle}” back to how the app starts.";
        if (live is null)
            _session.Discard(_formId);
        else
            _session.Remove(_area, new ArrangedSurface(_form!.Surface, live));
        Deselect();
        Tell(note, offersRedo: false);
        SaveSoon();
        return Task.CompletedTask;
    }

    private Task UndoAsync(string placementId)
    {
        if (_session is null)
            return Task.CompletedTask;
        string note = _session.PatchFor(placementId) is { } patch
            ? patch.Kind == PatchKind.Add ? $"Took out “{AddedTitle(patch)}”." : $"Put “{RemovedTitle(patch)}” back as it was."
            : "Put back as it was.";
        _session.Discard(placementId);
        Deselect();
        Tell(note, offersRedo: false);
        SaveSoon();
        return Task.CompletedTask;
    }

    private Task StepFromMoreAsync(Func<Task> step)
    {
        _more = false;
        return step();
    }

    private Task StepBackAsync() => StepAsync("undo");

    private Task StepForwardAsync() => StepAsync("redo");

    private async Task StepAsync(string which)
    {
        if (_session is null || !(which == "redo" ? _session.StepForward() : _session.StepBack()))
            return;
        if (_formId is not null)
        {
            if (_session.Arranged(CurrentArea!, _area.ScopeId).FirstOrDefault(candidate => KeyOf(candidate) == _formId) is { } entry)
                Select(entry);
            else
                Deselect();
        }
        Tell(which == "redo" ? "Redone." : "Undone.", offersRedo: which != "redo");
        SaveSoon();
        await InvokeAsync(StateHasChanged);
    }

    private void Tell(string note, bool offersRedo)
    {
        _stepNote = note;
        _stepOffersRedo = offersRedo;
        _stepNoteAt = _session!.Edits;
    }

    private void SaveSoon()
    {
        _save = SaveState.Waiting;
        _pending?.Cancel();
        _pending = new CancellationTokenSource();
        _ = SaveAfterAsync(SaveAfter, _pending.Token);
    }

    private async Task SaveAfterAsync(TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        await InvokeAsync(SaveNowAsync);
    }

    private async Task SaveNowAsync()
    {
        if (_session is null || !_session.HasUnsaved || _saving)
            return;

        _saving = true;
        _save = SaveState.Saving;
        StateHasChanged();
        (List<PatchMessage> set, List<string> cleared) = _session.TakeUnsaved();
        try
        {
            Draft saved = await Drafts.SaveAsync(_session.Draft.Id, set, cleared);
            _session.Accept(saved);
            _save = SaveState.Saved;
            _problem = null;
            Replace(saved);
            await Shell.TellOtherWindowsAsync(DraftPreviewWindow.Channel, saved.Id);
        }
        catch (RpcException exception)
        {
            _session.MarkUnsaved(set, cleared);
            _save = SaveState.Failed;
            if (exception.StatusCode is StatusCode.InvalidArgument or StatusCode.PermissionDenied or StatusCode.FailedPrecondition or StatusCode.Aborted)
                _problem = exception.Status.Detail;
            else
                _ = SaveAfterAsync(RetryAfter, CancellationToken.None);
        }
        finally
        {
            _saving = false;
        }

        if (_session.HasUnsaved && _save != SaveState.Failed)
            SaveSoon();
        else if (_missedWhileSaving || _form is null)
            CatchUpLater();
        StateHasChanged();
    }

    private void Replace(Draft saved)
    {
        if (_list is null)
            return;
        int index = _list.Drafts.FindIndex(draft => draft.Id == saved.Id);
        if (index >= 0)
            _list.Drafts[index] = saved;
    }

    private Task SettleAsync(ArrangedSurface entry, bool keepMine) =>
        entry.Placement is { } placement ? SettleIdAsync(placement.Id, keepMine) : Task.CompletedTask;

    private Task SettleRemovedAsync(PlacementPatch removed, bool keepMine) => SettleIdAsync(removed.PlacementId, keepMine);

    private Task SettleIdAsync(string placementId, bool keepMine) => RunAsync(async () =>
    {
        await SaveNowAsync();
        Draft settled = await Drafts.SettleAsync(_session!.Draft.Id, placementId, keepMine);
        _session = new DraftSession(settled, Surfaces);
        foreach (AreaKey area in _session.TouchedAreas.Append(_area).Distinct().ToList())
            await LoadLiveAsync(area);
        Deselect();
        Replace(settled);
    });

    private Task PublishAsync() => RunAsync(async () =>
    {
        await SaveNowAsync();
        if (_session is null || _session.HasUnsaved)
            return;
        Draft publishing = _session.Draft;
        await Drafts.PublishAsync(publishing.Id);
        _message = $"Published \"{publishing.Name}\". Phones show it within a few seconds.";
        _session = null;
        _list = await LoadListAsync();
        Navigation.NavigateTo(BasePath);
    });

    private Task AskToPublishAsync() => RunAsync(async () =>
    {
        await SaveNowAsync();
        Draft asked = await Drafts.AskToPublishAsync(_session!.Draft.Id);
        _session.Accept(asked);
        Replace(asked);
    });

    private Task CreateAsync() => RunAsync(async () =>
    {
        Draft created = await Drafts.CreateAsync(_newName.Trim());
        _naming = false;
        _newName = "";
        _list = await LoadListAsync();
        await OpenAsync(created.Id);
    });

    private Task CopyAsync() => RunAsync(async () =>
    {
        Draft copy = await Drafts.CreateAsync($"Copy of {_session!.Draft.Name}", _session.Draft.Id);
        _more = false;
        _list = await LoadListAsync();
        await OpenAsync(copy.Id);
    });

    private Task RenameAsync() => RunAsync(async () =>
    {
        Draft renamed = await Drafts.RenameAsync(_session!.Draft.Id, _rename.Trim());
        _session.Accept(renamed);
        Replace(renamed);
        _more = false;
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        if (!_confirmDelete)
        {
            _confirmDelete = true;
            return;
        }
        Draft deleting = _session!.Draft;
        await Drafts.DeleteAsync(deleting.Id);
        _message = $"Deleted \"{deleting.Name}\".";
        _more = false;
        _session = null;
        _list = await LoadListAsync();
        Navigation.NavigateTo(BasePath);
    });

    private Task PopOutAsync() =>
        _session is null ? Task.CompletedTask : Shell.OpenWindowAsync($"{BasePath}/{_session.Draft.Id}/preview", $"preview-{_session.Draft.Id}", 520, 1000).AsTask();

    private void OpenMore()
    {
        _rename = _session?.Draft.Name ?? "";
        _confirmDelete = false;
        _more = true;
    }

    private Task ShareAsync(string userId) => RunAsync(async () => Accept(await Drafts.ShareAsync(_session!.Draft.Id, userId)));

    private Task UnshareAsync(string userId) => RunAsync(async () => Accept(await Drafts.UnshareAsync(_session!.Draft.Id, userId)));

    private void Accept(Draft draft)
    {
        _session?.Accept(draft);
        Replace(draft);
        _ = InvokeAsync(async () =>
        {
            _list = await LoadListAsync();
            StateHasChanged();
        });
    }

    private Task TurnOnAsync((DateTime? StartsAt, DateTime? EndsAt) when) => RunAsync(async () =>
    {
        await SaveNowAsync();
        Draft on = await Drafts.TurnOnAsync(_session!.Draft.Id, when.StartsAt, when.EndsAt);
        _session.Accept(on);
        _turningOn = false;
        _more = false;
        _list = await LoadListAsync();
    });

    private void ChooseForEveryone(ForEveryoneWay way)
    {
        _startingWay = _session?.Draft is { LayerOn: true, LayerStartsAt: not null } && way == ForEveryoneWay.TryNow ? ForEveryoneWay.BetweenDates : way;
        _problem = null;
        _more = false;
        _turningOn = true;
    }

    private Task SchedulePublishAsync(DateTime at) => RunAsync(async () =>
    {
        await SaveNowAsync();
        Accept(await Drafts.SchedulePublishAsync(_session!.Draft.Id, at));
        _turningOn = false;
    });

    private Task CancelScheduledPublishAsync() => RunAsync(async () =>
    {
        Accept(await Drafts.CancelScheduledPublishAsync(_session!.Draft.Id));
        _more = false;
    });

    private Task TurnOffAsync(Draft layer) => RunAsync(async () =>
    {
        await Drafts.TurnOffAsync(layer.Id);
        _more = false;
        _list = await LoadListAsync();
        if (_session?.Draft.Id == layer.Id)
            _session.Accept(await Drafts.GetAsync(layer.Id));
    });

    private Task ChangeDatesAsync(Draft layer)
    {
        if (_session?.Draft.Id == layer.Id)
            ChooseForEveryone(ForEveryoneWay.TryNow);
        else
            Navigation.NavigateTo($"{BasePath}/{layer.Id}");
        return Task.CompletedTask;
    }

    private Task UndoAsync(PublishedDraft published) => RollBackAsync(published.BatchId,
        $"Undid “{published.Name}”. Phones show it within a few seconds; open it here to publish it again.");

    private Task PublishAgainAsync(PublishedDraft published) => RollBackAsync(published.UndoneBatchId!,
        $"Published “{published.Name}” again. Phones show it within a few seconds.");

    private async Task RollBackAsync(string batchId, string done)
    {
        _busy = true;
        try
        {
            await Configuration.RollBackAsync(batchId);
            _publishedNote = new DraftListing.Note(done, Warns: false);
        }
        catch (RpcException exception)
        {
            _publishedNote = new DraftListing.Note(exception.Status.Detail, Warns: true);
        }
        finally
        {
            _busy = false;
        }
        _list = await LoadListAsync();
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _undoKeys = await Shell.HearUndoKeysAsync(StepAsync);
    }

    public async ValueTask DisposeAsync()
    {
        if (_pending is not null)
            await _pending.CancelAsync();
        if (_undoKeys is not null)
            await _undoKeys.DisposeAsync();
    }
}
