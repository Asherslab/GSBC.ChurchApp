    private Task StartForChangeAsync() => RunAsync(async () =>
    {
        if (_choosing is not { } wanted)
            return;
        string name = $"{Surfaces.Areas[wanted.Area].Title}, {DraftWords.Day(Now)}";
        Draft created = await Drafts.CreateAsync(name);
        _madeForChange = created.Id;
        _list = await LoadListAsync();
        await CarryOnAsync(created, wanted);
    });

