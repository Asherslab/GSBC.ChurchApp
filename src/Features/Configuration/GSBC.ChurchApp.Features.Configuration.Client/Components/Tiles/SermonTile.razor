@inject TimeProvider Clock
@inject IServiceProvider Services

@switch (Variant.Key)
{
    case WaitingTiles.Layouts.Listening:
        <HubTile Look="@(Look with { Icon = "" })" Layout="@(Span.Rows > 1 ? TileShape.Poster : Span.Columns > 1 ? TileShape.Row : TileShape.Square)" Title="Sunday's sermon"
                 Lines="ListeningLines" PlacementId="@Entry.Placement?.Id" Action="Play" />
        break;
    case var _ when Span is { Columns: 1, Rows: 1 }:
        <HubTile Look="Look" Layout="TileShape.Behind" Title="Sunday's sermon" Class="hub-tile--cover-only" PlacementId="@Entry.Placement?.Id" Cover="Cover" Action="Play" />
        break;
    case var _ when Span.Rows == 1:
        <HubTile Look="Look" Layout="TileShape.Beside" Title="Sunday's sermon" Lines="[Date]" PlacementId="@Entry.Placement?.Id" Cover="Cover" Action="Play" />
        break;
    default:
        <HubTile Look="Look" Layout="TileShape.Picture" Title="Sunday's sermon" Lines="AboveLines" PlacementId="@Entry.Placement?.Id" Cover="Cover" Action="Play" />
        break;
}

@code {
    [CascadingParameter] public HubContext Hub { get; set; } = HubContext.Still;
    [Parameter, EditorRequired] public required ArrangedSurface Entry { get; set; }

    private TileLook Look => TileLook.Of(WaitingTiles.Sermon, Entry.Values);

    private TileVariant Variant => WaitingTiles.Sermon.VariantFor(Look, Hub.Columns);

    private TileSpan Span => new(Math.Min(Look.Columns, Hub.Columns), Look.Rows);

    private string Date => ChurchDates.Describe(WaitingWeek.LastSunday(Clock), DateLineStyle.Short, false, Clock.GetUtcNow().UtcDateTime);

    private static readonly RenderFragment Cover = @<span class="hub-cover"><BrandMark Decorative="true" /></span>;

    private RenderFragment Play => @<text>
        @if (Hub.Live)
        {
            <button type="button" class="hub-play" aria-label="Play Sunday's sermon" @onclick="OpenAsync"><Icon Name="play" /></button>
        }
        else
        {
            <span class="hub-play" aria-hidden="true"><Icon Name="play" /></span>
        }
    </text>;

    private async Task OpenAsync()
    {
        if (Services.GetService(typeof(GSBC.ChurchApp.Platform.Ui.Destinations.LinkOpener)) is GSBC.ChurchApp.Platform.Ui.Destinations.LinkOpener opener && Look.Link.Length > 0)
            await opener.OpenAsync(Look.Link);
    }

    private IReadOnlyList<string> ListeningLines => [Span.Columns > 1 || Span.Rows > 1 ? $"{Date} · 38 min" : "38 min"];

    private IReadOnlyList<string> AboveLines => Span is { Columns: > 1, Rows: > 1 } ? [$"{Date} · 38 min"] : [Date];
}
