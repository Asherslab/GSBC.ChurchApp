@inject ConfigurationClient Configuration
@inject DraftsClient Drafts
@inject SurfaceCatalog Surfaces
@inject IAccess Access
@inject IPeopleDirectory People
@inject NavigationManager Navigation

<LiveData TValue="Arrangement" Load="LoadAsync" Feeds="[ConfigurationFeeds.Placements, ConfigurationFeeds.Drafts]">
    <Section First="true" Title="What everyone sees" Lead="@($"{Area.Description}. Changes go into a draft until they're published.")">
        <div class="ui-actions live-arrangement__actions">
            @if (context.Value.Mine is { } mine)
            {
                <Button Variant="ButtonVariant.Quiet" OnClick="() => Open(mine.Id)">Carry on "@mine.Name"</Button>
            }
            <Button Icon="pencil" Busy="_busy" OnClick="ChangeAsync">Change it</Button>
        </div>
        @if (_problem is not null)
        {
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        }
        <ListGroup>
            @foreach (ArrangedSurface entry in context.Value.Arranged)
            {
                <ListRow Title="@DraftWords.NameOf(entry)" Subtitle="@DraftWords.Summary(entry)" Icon="@(entry.Hidden ? "eye-off" : "eye")"
                         IconTone="@(entry.Hidden ? RowTone.Quiet : RowTone.Accent)" Class="@(entry.Hidden ? "row--muted" : null)" />
            }
        </ListGroup>
    </Section>

    <Section Title="Recent changes">
        <ListGroup>
            @if (context.Value.History.Count == 0)
            {
                <ListRow Title="Nothing changed yet" Subtitle="Everything is as the app starts" Icon="check" IconTone="RowTone.Quiet" />
            }
            @foreach (ChangeBatch batch in context.Value.History)
            {
                <ListRow Title="@Describe(batch)" Icon="undo" IconTone="RowTone.Quiet">
                    <Below><span class="row__subtitle">@context.Value.Names.GetValueOrDefault(batch.By, "Someone") · <DateLine At="batch.At" Style="DateLineStyle.Relative" WithTime="true" /></span></Below>
                    <TrailingContent>
                        @if (Access.Can(Area.PublishPermission, ScopeId))
                        {
                            <Button Variant="ButtonVariant.Quiet" Small="true" Disabled="_busy" OnClick="() => UndoAsync(batch)">Undo</Button>
                        }
                    </TrailingContent>
                </ListRow>
            }
        </ListGroup>
    </Section>
</LiveData>

@code {
    [Parameter, EditorRequired] public required SurfaceArea Area { get; set; }
    [Parameter] public string? ScopeId { get; set; }
    [Parameter] public string DraftsPath { get; set; } = "drafts";

    private bool _busy;
    private string? _problem;

    private async Task<Arrangement> LoadAsync()
    {
        AreaPlacements live = await Configuration.GetAreaAsync(Area, ScopeId);
        ChangeList history = await Configuration.ListChangesAsync(Area, ScopeId);
        DraftList drafts = await Drafts.ListAsync();
        Dictionary<string, string> names = [];
        try
        {
            names = (await People.GetAsync(history.Batches.Select(batch => batch.By).Distinct().ToList())).ToDictionary(person => person.Id, person => person.Name);
        }
        catch (RpcException)
        {
        }

        return new Arrangement(
            SurfaceLayout.Arrange(Surfaces.In(Area), live.Placements.Select(placement => placement.ToStored())),
            history.Batches,
            names,
            drafts.Drafts.FirstOrDefault(draft => draft.Mine && !draft.LayerOn && draft.Changes.Any(change => change.Area == Area.Key && change.ScopeId == ScopeId)));
    }

    private async Task ChangeAsync()
    {
        _busy = true;
        try
        {
            Draft draft = await Drafts.CreateAsync($"{Area.Title} change");
            Open(draft.Id);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Open(string draftId) => Navigation.NavigateTo($"{DraftsPath}/{draftId}?area={Uri.EscapeDataString(Area.Key)}");

    private async Task UndoAsync(ChangeBatch batch)
    {
        _busy = true;
        try
        {
            await Configuration.RollBackAsync(batch.Id);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private string Describe(ChangeBatch batch)
    {
        string what = string.Join(", ", batch.Changes.Select(change =>
            $"{Surfaces.ByKey.GetValueOrDefault(change.Surface)?.Title ?? change.Surface} {(change.Before is null ? "added" : change.After is null ? "removed" : "changed")}"));
        return batch.RollsBack is not null ? $"Undid a change: {what}" : batch.DraftName is { } name ? $"Published \"{name}\": {what}" : what;
    }

    private sealed record Arrangement(IReadOnlyList<ArrangedSurface> Arranged, List<ChangeBatch> History, Dictionary<string, string> Names, Draft? Mine);
}
