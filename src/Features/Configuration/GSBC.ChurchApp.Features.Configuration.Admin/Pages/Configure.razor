@page "/configure/{AreaKey}"
@page "/configure/{AreaKey}/{ScopeId}"
@inject SurfaceCatalog Surfaces

<h1>@(Surfaces.Areas.GetValueOrDefault(AreaKey)?.Title ?? "Arrange")</h1>

<SurfaceArrangement AreaKey="@AreaKey" ScopeId="@ScopeId" />

@code {
    [Parameter] public string AreaKey { get; set; } = "";
    [Parameter] public string? ScopeId { get; set; }
}
