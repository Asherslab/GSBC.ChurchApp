@inject RosterWrites Writes

<LiveData @ref="_live" TValue="AwayList" Load="Load" Feeds="Feeds" Remember="@Remember">
    <ChildContent>
        @{
            AwayList away = context.Value;
            IReadOnlyList<PersonLine> people = People ?? away.People.Select(person => new PersonLine { Id = person.PersonId, Name = person.Name }).ToList();
            string yourId = YourId ?? away.YourId;
            List<(PersonLine Person, AwaySpan Span)> spans = people
                .SelectMany(person => (away.People.FirstOrDefault(each => each.PersonId == person.Id)?.Spans ?? []).Select(span => (person, span)))
                .ToList();
        }
        @if (people.Count > 0)
        {
            <Section First="First" Title="Days away" Lead="@(people.Count > 1 ? "Leaders of every ministry you or your children serve in see these. They can still put you on, and it's flagged." : Lead)">
                <ListGroup>
                    @foreach ((PersonLine person, AwaySpan span) in spans)
                    {
                        <ListRow @key="span.Id" Title="@RosterLines.Span(span)" Subtitle="@string.Join(" · ", new[] { person.Id == yourId || people.Count == 1 ? "" : RosterLines.First(person.Name), span.Note }.Where(line => line.Length > 0))"
                                 Icon="circle-off" IconTone="RowTone.Quiet">
                            <TrailingContent>
                                <Button Small="true" Variant="ButtonVariant.Quiet" Icon="x" AriaLabel="@($"Remove {RosterLines.Span(span)}")" Disabled="_busy" OnClick="() => RemoveAsync(span)" />
                            </TrailingContent>
                        </ListRow>
                    }
                    <ListRow Title="Add days away" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _adding = true" />
                </ListGroup>
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            </Section>
            <AwaySheet @key="@($"away-{_adding}")" Open="_adding" OpenChanged="AddedAsync" People="people" YourId="@yourId" />
        }
    </ChildContent>
    <Loading />
</LiveData>

@code {
    private LiveData<AwayList>? _live;
    private bool _adding, _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required Func<Task<AwayList>> Load { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyCollection<string> Feeds { get; set; }
    [Parameter] public IReadOnlyList<PersonLine>? People { get; set; }
    [Parameter] public string? YourId { get; set; }
    [Parameter] public string Lead { get; set; } = "Leaders of every ministry you serve in see these. They can still put you on, and it's flagged.";
    [Parameter] public string? Remember { get; set; }
    [Parameter] public bool First { get; set; }

    private async Task AddedAsync(bool open)
    {
        _adding = open;
        if (!open && _live is not null)
            await _live.ReloadAsync();
    }

    private async Task RemoveAsync(AwaySpan span)
    {
        _busy = true;
        _problem = await RosterProblems.TryAsync(() => Writes.RemoveAwayAsync(span.Id));
        _busy = false;
        if (_problem is null && _live is not null)
            await _live.ReloadAsync();
    }
}
