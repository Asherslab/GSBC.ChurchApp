@inject RosterWrites Writes

<UnsavedGuard Changed="() => Open && Changed" What="how the roster works" Save="SaveAsync" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="How the roster works" Lead="@($"For {View.MinistryName}. Days away are always allowed.")">
    <ChildContent>
        <ToggleRow Title="Ask people to answer" Description="They say whether they can do each date, and you hear when they can't" @bind-Checked="_draft.Replies" />
        <h3 class="roster-position">Swaps</h3>
        @foreach (string way in SwapWays.All)
        {
            <ToggleRow @key="way" Title="@RosterLines.WaysWords(way)" Checked="_draft.SwapWays.Contains(way)" CheckedChanged="on => Toggle(way, on)" />
        }
        <p class="roster-hint">@(_draft.SwapWays.Count > 1 ? "Someone asking for a swap chooses which way." : _draft.SwapWays.Count == 0 ? "Nobody can ask for a swap; they tell a leader instead." : "Leaders hear of every swap.")</p>
        <Segmented TValue="string" Label="What the team sees" ShowLabel="true" Stacked="true" Value="@_draft.WhoSees" ValueChanged="value => _draft.WhoSees = value"
                   Options="@([.. new[] { WhoSees.Everything, WhoSees.WithYou, WhoSees.Yours }.Select(value => new SegmentOption<string>(value, RosterLines.WhoSeesWords(value)))])"
                   Hint="Leaders always see the whole roster." />
        <SelectField Label="Reminder before each date" Value="@_draft.RemindDaysBefore.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     ValueChanged="value => _draft.RemindDaysBefore = int.Parse(value, System.Globalization.CultureInfo.InvariantCulture)" Options="Reminders" />
        @if (_draft.Replies)
        {
            <SelectField Label="If someone hasn't answered" Value="@_draft.NudgeAfterDays.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         ValueChanged="value => _draft.NudgeAfterDays = int.Parse(value, System.Globalization.CultureInfo.InvariantCulture)" Options="Nudges" />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Save" Busy="_busy" OnSave="SaveAsync" State="@(Changed ? SaveState.Unsaved : null)" />
    </Actions>
</Sheet>

@code {
    private static readonly IReadOnlyList<FieldOption> Reminders =
        [new("0", "No reminder"), new("1", "The day before"), .. new[] { 2, 3, 4, 5, 6, 7 }.Select(days => new FieldOption(days.ToString(System.Globalization.CultureInfo.InvariantCulture), $"{days} days before"))];

    private static readonly IReadOnlyList<FieldOption> Nudges =
        [new("0", "Don't remind them"), new("1", "Remind them after a day"), .. new[] { 2, 3, 4, 5, 7 }.Select(days => new FieldOption(days.ToString(System.Globalization.CultureInfo.InvariantCulture), $"Remind them after {days} days"))];

    private RosterSettings _draft = new();
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required RosterView View { get; set; }

    private bool Changed =>
        (_draft.Replies, _draft.WhoSees, _draft.RemindDaysBefore, _draft.NudgeAfterDays, string.Join(",", _draft.SwapWays.Order()))
        != (View.Settings.Replies, View.Settings.WhoSees, View.Settings.RemindDaysBefore, View.Settings.NudgeAfterDays, string.Join(",", View.Settings.SwapWays.Order()));

    protected override void OnInitialized() => _draft = RostersContractsModel.Instance.DeepClone(View.Settings);

    private void Toggle(string way, bool on)
    {
        _draft.SwapWays.Remove(way);
        if (on)
            _draft.SwapWays.Add(way);
    }

    private async Task<bool> SaveAsync()
    {
        _busy = true;
        _problem = await RosterProblems.TryAsync(() => Writes.SaveSettingsAsync(View.MinistryId, _draft));
        _busy = false;
        if (_problem is null)
            await OpenChanged.InvokeAsync(false);
        return _problem is null;
    }
}
