@using System.Globalization
@inject RosterWrites Writes
@inject IRosterReads Reads

<UnsavedGuard Changed="() => Open && Changed" What="how the roster works" Save="SaveAsync" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="How the roster works" Lead="@($"For {View.MinistryName}. Leaders always see the whole roster, and the team can always mark days away.")">
    <ChildContent>
        <Section Grouped="true" First="true" Title="Answers">
            <ToggleRow Title="Ask people to answer" Description="They say whether they can do each date, and leaders hear when someone can't" @bind-Checked="_draft.Replies" />
            @if (_draft.Replies)
            {
                <SelectField Label="If someone hasn't answered" Value="@Number(_draft.NudgeAfterDays)" ValueChanged="value => _draft.NudgeAfterDays = Parse(value)" Options="Nudges" />
            }
            <SelectField Label="Reminder before each date" Value="@Number(_draft.RemindDaysBefore)" ValueChanged="value => _draft.RemindDaysBefore = Parse(value)" Options="Reminders" />
        </Section>
        <Section Grouped="true" Title="When someone asks the team for a swap" Foot="@SwapFoot">
            <Segmented TValue="string" Label="When someone asks the team for a swap" Rows="true" Value="@_draft.OpenSwaps" ValueChanged="value => _draft.OpenSwaps = value"
                       Options="@([.. OpenSwaps.All.Select(value => new SegmentOption<string>(value, RosterLines.OpenSwapsWords(value), Detail: RosterLines.OpenSwapsDetail(value)))])" />
        </Section>
        <Section Grouped="true" Title="Asking one person">
            <ToggleRow Title="@RosterLines.WaysWords(SwapWays.Direct)" Description="They choose who on the team to ask, and that person says yes or can't" @bind-Checked="_draft.DirectSwaps" />
        </Section>
        <p class="roster-say">@RosterLines.SwapSentence(_draft)</p>
        <Section Grouped="true" Title="What the team sees">
            <Segmented TValue="string" Label="What the team sees" Rows="true" Value="@_draft.WhoSees" ValueChanged="value => _draft.WhoSees = value"
                       Options="@([.. new[] { WhoSees.Everything, WhoSees.WithYou, WhoSees.Yours }.Select(value => new SegmentOption<string>(value, RosterLines.WhoSeesWords(value)))])" />
        </Section>
        <Section Grouped="true" Title="Calendars it rosters from" Lead="Add a date starts on these calendars' events. Every calendar is still there.">
            @if (Open)
            {
                <LiveData TValue="IReadOnlyList<EventChoice>" Load="() => Reads.EventChoicesAsync(View.MinistryId)" Feeds="Reads.Feeds">
                    <ChildContent>
                        @foreach ((string id, string name) in Calendars(context.Value))
                        {
                            <ToggleRow @key="id" Title="@name" Checked="_draft.Calendars.Contains(id)" CheckedChanged="on => ToggleCalendar(id, on)" />
                        }
                        @if (_draft.Calendars.Count == 0)
                        {
                            <p class="hint">With none chosen, it starts on @(View.MinistryName)'s own calendars.</p>
                        }
                    </ChildContent>
                    <Loading><Skeleton Shape="SkeletonShape.Lines" Count="3" /></Loading>
                </LiveData>
            }
        </Section>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Label="Save" Busy="_busy" OnSave="SaveAsync" OnCancel="() => OpenChanged.InvokeAsync(false)" State="@(Changed ? SaveState.Unsaved : null)" />
    </Actions>
</Sheet>

@code {
    private static readonly IReadOnlyList<FieldOption> Reminders =
        [new("0", "No reminder"), new("1", "The day before"), .. new[] { 2, 3, 4, 5, 6, 7 }.Select(days => new FieldOption(Number(days), $"{days} days before"))];

    private static readonly IReadOnlyList<FieldOption> Nudges =
        [new("0", "Don't remind them"), new("1", "Remind them after a day"), .. new[] { 2, 3, 4, 5, 7 }.Select(days => new FieldOption(Number(days), $"Remind them after {days} days"))];

    private RosterSettings _draft = new();
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required RosterView View { get; set; }

    private RenderFragment SwapFoot => @<text>Leaders hear of every swap.</text>;

    private bool Changed =>
        (_draft.Replies, _draft.WhoSees, _draft.RemindDaysBefore, _draft.NudgeAfterDays, _draft.OpenSwaps, _draft.DirectSwaps, string.Join(",", _draft.Calendars.Order()))
        != (View.Settings.Replies, View.Settings.WhoSees, View.Settings.RemindDaysBefore, View.Settings.NudgeAfterDays, View.Settings.OpenSwaps, View.Settings.DirectSwaps,
            string.Join(",", View.Settings.Calendars.Order()));

    private static string Number(int value) => value.ToString(CultureInfo.InvariantCulture);

    private static int Parse(string value) => int.Parse(value, CultureInfo.InvariantCulture);

    private IEnumerable<(string Id, string Name)> Calendars(IReadOnlyList<EventChoice> choices) =>
        choices.Where(choice => choice.CalendarId.Length > 0).Select(choice => (choice.CalendarId, choice.CalendarName))
            .Concat(View.Settings.Calendars.Select(id => (id, "A calendar with nothing coming up")))
            .DistinctBy(calendar => calendar.Item1)
            .OrderBy(calendar => calendar.Item2, StringComparer.CurrentCulture);

    private void ToggleCalendar(string id, bool on)
    {
        _draft.Calendars.Remove(id);
        if (on)
            _draft.Calendars.Add(id);
    }

    protected override void OnInitialized() => _draft = RostersContractsModel.Instance.DeepClone(View.Settings);

    private async Task<bool> SaveAsync()
    {
        _busy = true;
        _problem = await RosterProblems.TryAsync(() => Writes.SaveSettingsAsync(View.MinistryId, _draft));
        _busy = false;
        if (_problem is null)
            await OpenChanged.InvokeAsync(false);
        return _problem is null;
    }
}
