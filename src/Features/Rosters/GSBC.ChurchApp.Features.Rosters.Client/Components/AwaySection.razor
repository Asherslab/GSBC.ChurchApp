@inject IRosterReads Reads

@if (View.MayEdit && !View.Archived && View.Team.Count > 0)
{
    <DaysAway @key="View.MinistryId" Load="TeamAsync" Feeds="Reads.Feeds" People="TeamPeople" YourId="@View.YourId" Remember="@($"rosters.away.{View.MinistryId}")"
              Title="The team's days away" Lead="You and other leaders can change anyone's on the team. Everyone's are flagged when you put them on." />
}
else if (View.You.Count > 0)
{
    <DaysAway Load="Reads.AwayAsync" Feeds="Reads.Feeds" Remember="rosters.away" People="View.You" YourId="@View.YourId" />
}

@code {
    [Parameter, EditorRequired] public required RosterView View { get; set; }

    private IReadOnlyList<PersonLine> TeamPeople =>
        View.You.Concat(View.Team.Select(member => new PersonLine { Id = member.PersonId, Name = member.Name }))
            .DistinctBy(person => person.Id).ToList();

    private async Task<AwayList> TeamAsync()
    {
        AwayList yours = await Reads.AwayAsync();
        return new AwayList
        {
            YourId = View.YourId,
            People = yours.People
                .Concat(View.Team.Select(member => new AwayOf { PersonId = member.PersonId, Name = member.Name, Spans = member.Away }))
                .DistinctBy(person => person.PersonId).ToList(),
        };
    }
}
