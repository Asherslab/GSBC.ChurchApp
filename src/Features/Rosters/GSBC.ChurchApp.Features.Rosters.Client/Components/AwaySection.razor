@inject IRosterReads Reads
@inject IEnumerable<AwayOnItsOwnPage> OwnPage
@inject TimeProvider Clock

@if (OwnPage.Any())
{
    @if (View.You.Count > 0 || TeamAway.Shown(View))
    {
        <Section Title="Days away">
            <ListGroup>
                @if (View.You.Count > 0)
                {
                    <YourAwayRow />
                }
                @if (TeamAway.Shown(View))
                {
                    <ListRow Title="The team's days away" Subtitle="@RosterLines.TeamAwayLine(TeamAway.Spans(View), ChurchTime.Today(Clock))" Icon="users" IconTone="RowTone.Quiet"
                             Href="@AwayPlaces.Team(View.MinistryId)" Chevron="true" />
                }
            </ListGroup>
        </Section>
    }
}
else if (TeamAway.Shown(View))
{
    <DaysAway @key="View.MinistryId" Load="() => TeamAway.LoadAsync(Reads, View)" Feeds="Reads.Feeds" People="TeamAway.People(View)" YourId="@View.YourId" Remember="@($"rosters.away.{View.MinistryId}")"
              Title="The team's days away" Lead="Leaders can change anyone's days away. Anyone away is flagged when they're put on." />
}
else if (View.You.Count > 0)
{
    <DaysAway Load="Reads.AwayAsync" Feeds="Reads.Feeds" Remember="rosters.away" People="View.You" YourId="@View.YourId" />
}

@code {
    [Parameter, EditorRequired] public required RosterView View { get; set; }
}
