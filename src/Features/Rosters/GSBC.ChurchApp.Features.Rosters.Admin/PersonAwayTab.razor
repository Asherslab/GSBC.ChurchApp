@using GSBC.ChurchApp.Features.Rosters.Client.Components
@using GSBC.ChurchApp.Features.Rosters.Contracts
@using GSBC.ChurchApp.Platform.Client.Modules
@inject OnlineRosters Rosters

<DaysAway @key="Person.Id" First="true" Load="() => Rosters.AwayOfAsync(Person.Id)" Feeds="[RostersFeeds.Away]" People="[new PersonLine { Id = Person.Id, Name = Person.Name }]"
          Lead="@($"Leaders of every team {Person.FirstName} is on see these, and can change them. They can still put {Person.FirstName} on; it's flagged.")" />

@code {
    [Parameter, EditorRequired] public required PersonOnPage Person { get; set; }
}
