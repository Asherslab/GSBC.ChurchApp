<BoardCard Title="@FeedbackWords.Title(Ticket.Text)" Href="@FeedbackDestinations.Ticket(Ticket.Number).TrimStart('/')" Open="Open"
           Quiet="Ticket.Status is TicketStatus.Resolved or TicketStatus.NotDoing" OnOpen="OnOpen" Shot="Shot">
    <Meta>#@Ticket.Number · @Ticket.From</Meta>
    <Labels>
        @if (Ticket.Source == FeedbackSource.AdminPanel)
        {
            <span class="feedback-label feedback-label--admin">Admin panel</span>
            @if (Ticket.Browser.Length > 0)
            {
                <span class="feedback-label feedback-label--clip" title="@Ticket.Browser">@Ticket.Browser</span>
            }
        }
        else
        {
            @if (Ticket.AppBuild.Length > 0)
            {
                <span class="feedback-label feedback-label--clip" title="@Ticket.AppBuild">@Ticket.AppBuild</span>
            }
            @if (Ticket.Model.Length > 0)
            {
                <span class="feedback-label feedback-label--clip" title="@PhoneModels.Name(Ticket.Model)">@PhoneModels.Name(Ticket.Model)</span>
            }
        }
        @if (Ticket.Attachments > 0)
        {
            <span class="feedback-label feedback-label--accent"><Icon Name="paperclip" Size="IconSize.Small" />@(Ticket.Attachments == 1 ? "1 file" : $"{Ticket.Attachments} files")</span>
        }
        else if (Ticket.AttachmentsDeleted)
        {
            <span class="feedback-label" title="Pictures deleted">Pictures deleted</span>
        }
        @if (Ticket.FilesGoAt is { } goes)
        {
            <span class="feedback-label" title="@FeedbackWords.FilesGo(goes)">@FeedbackWords.FilesGoShort(goes)</span>
        }
    </Labels>
</BoardCard>

@code {
    [Parameter, EditorRequired] public required TicketLine Ticket { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnOpen { get; set; }

    private RenderFragment? Shot => Ticket.Cover is { } cover
        ? @<MediaImage Media="cover" Size="MediaSizeName.Thumbnail" Alt="" />
        : null;
}
