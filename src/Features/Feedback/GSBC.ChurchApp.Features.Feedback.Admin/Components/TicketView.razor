@using GSBC.ChurchApp.Platform.Client.Media
@inject FeedbackDeskClient Desk
@inject IMediaFiles Files
@inject IJSRuntime Js
@inject TimeProvider Clock
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => _note.Trim().Length > 0 || _blockReason.Trim().Length > 0" What="@(_blockReason.Trim().Length > 0 ? "why you're blocking this phone" : "your note")" />

<LiveData @ref="_live" TValue="Ticket" Feeds="DeskFeeds" Load="LoadAsync" FailedTitle="Can't load this feedback right now">
    @{
        Ticket ticket = context.Value;
        TicketLine line = ticket.Line;
    }
    <article class="ticket @(Docked ? "ticket--docked" : "ticket--page")" aria-label="@($"Feedback #{line.Number}")">
        @if (Docked)
        {
            <PaneHead Title="@FeedbackWords.Title(line.Text)" Lead="@($"#{line.Number} · {ChurchDates.Ago(line.SentAt, Now)}")" Actions="Actions(ticket)"
                      OnOpen="() => Navigation.NavigateTo(FeedbackDestinations.Ticket(line.Number).TrimStart('/'))" OnClose="OnClose" />
        }
        else
        {
            <TitleBand Title="@FeedbackWords.Title(line.Text)" Lead="@($"#{line.Number} · {line.From} · {ChurchDates.Ago(line.SentAt, Now)}")"
                       BackHref="feedback" BackText="Feedback" BrowserTitle="@($"Feedback #{line.Number}")">
                <Actions><Menu Label="@($"More for #{line.Number}")" Items="Actions(ticket)" /></Actions>
            </TitleBand>
        }

        <div class="ticket__status">
            <StagePipeline TValue="TicketStatus" Label="Status" Stages="StatusOptions" Value="line.Status" Disabled="@(_busy is not null)" ValueChanged="status => SetStatusAsync(ticket, status)" />
            <div class="ticket__status-line">
                @if (line.Status == TicketStatus.NotDoing)
                {
                    <Pill Tone="PillTone.Quiet">Not doing</Pill>
                }
                <span class="ticket__hint">@(FeedbackWords.IsClosed(line.Status)
                    ? $"Closed {ChurchDates.Ago(ticket.ClosedAt ?? line.ChangedAt, Now)}. {(line.FilesGoAt is { } goes ? FeedbackWords.FilesGo(goes) + " " : "")}Deleted entirely 180 days after it closed."
                    : $"Its pictures, videos and phone data are deleted {FeedbackLimits.FilesKeptDaysAfterClosing} days after it's Resolved or Not doing.")</span>
            </div>
        </div>

        <div class="ticket__body">
            <div class="ticket__main">
                @if (ticket.Attachments.Count > 0)
                {
                    <div class="ticket__pictures" aria-label="Screenshots and videos">
                        @foreach (MediaRef media in ticket.Attachments)
                        {
                            <figure class="ticket__picture">
                                @if (media.IsImage)
                                {
                                    int shown = Screenshots(ticket).IndexOf(media);
                                    <PictureOpen Label="@($"Open screenshot {shown + 1} bigger")" OnOpen="() => OpenScreenshot(shown)">
                                        <MediaPreview Media="media" Size="MediaSizeName.Original" Class="ticket__media" />
                                    </PictureOpen>
                                }
                                else
                                {
                                    <MediaPreview Media="media" Size="MediaSizeName.Original" Class="ticket__media" />
                                }
                                <figcaption>@(media.IsVideo ? "Video" : "Screenshot") · @FeedbackWords.Size(media.Bytes)</figcaption>
                            </figure>
                        }
                    </div>
                    <PictureViewer @bind-Open="_viewing" @bind-Index="_viewingAt" Pictures="Screenshots(ticket)" Noun="Screenshot" About="@($"#{line.Number} {FeedbackWords.Title(line.Text)}")" />
                }
                else if (line.AttachmentsDeleted)
                {
                    <p class="ticket__gone"><Icon Name="trash" Size="IconSize.Small" />Its pictures and videos were deleted a week after it closed.</p>
                }
                @if (FeedbackWords.SaysMore(line.Text))
                {
                    <p class="ticket__words">@line.Text</p>
                }

                <section class="ticket__timeline" aria-labelledby="ticket-history-@line.Number">
                    <h3 id="ticket-history-@line.Number">What's happened</h3>
                    <ol class="timeline">
                        @foreach (TimelineItem item in Timeline(ticket))
                        {
                            @if (item.Note is { } note)
                            {
                                <li class="timeline__note">
                                    <p>@note.Text</p>
                                    <span class="timeline__by">@note.Author · @ChurchDates.Ago(note.At, Now)
                                        <button type="button" class="timeline__delete" aria-label="Delete this note" @onclick="() => DeleteNoteAsync(ticket, note.Id)"><Icon Name="x" Size="IconSize.Small" /></button>
                                    </span>
                                </li>
                            }
                            else if (item.Step is { } step)
                            {
                                <li class="timeline__step"><strong>@step.Who</strong> @step.What.ToLowerInvariant() · @ChurchDates.Ago(step.At, Now)</li>
                            }
                        }
                    </ol>
                    <TextField Label="Add a note" Multiline="true" MaxLength="2000" @bind-Value="_note" />
                    <SaveBar Label="Add the note" Busy="@(_busy == "note")" Blocked="@(_note.Trim().Length == 0 ? "Write the note to add it." : null)" OnSave="() => AddNoteAsync(ticket)" />
                </section>
            </div>

            <aside class="ticket__side" aria-label="What came with it">
                <h3>Sent with it</h3>
                <dl class="ticket__facts">
                    <dt>From</dt><dd>@line.From</dd>
                    <dt>Sent</dt><dd>@ChurchDates.Describe(line.SentAt, DateLineStyle.Long, true, Now)</dd>
                    @if (ticket.Browser is { } browser)
                    {
                        <dt>Where</dt><dd>The admin panel</dd>
                        <dt>Version</dt><dd>@(string.Join(" · ", new[] { browser.Version, ticket.Environment }.Where(part => part.Length > 0)) is { Length: > 0 } version ? version : "Not known")</dd>
                        <dt>Browser</dt><dd>@(string.Join(" · ", new[] { browser.Browser, browser.System }.Where(part => part.Length > 0)))</dd>
                        <dt>Window</dt><dd>@(string.Join(" · ", new[] { browser.Window, browser.ColourScheme.Length > 0 ? $"{browser.ColourScheme} mode" : "" }.Where(part => part.Length > 0)))</dd>
                        @if (ticket.Page.Length > 0)
                        {
                            <dt>Page</dt><dd>@(browser.PageTitle.Length > 0 ? $"{browser.PageTitle} ({ticket.Page})" : ticket.Page)</dd>
                        }
                        @if (browser.RecentPages.Count > 1)
                        {
                            <dt>Before</dt><dd>@string.Join(", ", browser.RecentPages.Skip(1))</dd>
                        }
                    }
                    else
                    {
                        <dt>App</dt><dd>@AppLine(ticket)</dd>
                        <dt>Phone</dt><dd>@PhoneLine(ticket)</dd>
                        @if (ticket.Page.Length > 0)
                        {
                            <dt>Page</dt><dd>@ticket.Page</dd>
                        }
                        @if (ticket.Phone is { RecentPages.Count: > 1 } phone)
                        {
                            <dt>Before</dt><dd>@string.Join(", ", phone.RecentPages.Skip(1))</dd>
                        }
                        @if (ticket.Phone is { Screenshots.Count: > 0 } screenshotted)
                        {
                            <dt>Screenshots</dt><dd>@FeedbackWords.Screenshots(screenshotted.Screenshots)</dd>
                        }
                    }
                </dl>

                @if (ticket.Browser is null)
                {
                    <h3>This phone</h3>
                    @if (ticket.InstallId.Length == 0)
                    {
                        <p class="ticket__note">Sent by someone with the Feedback role from a phone that hasn't proved itself, so there's no phone to block.</p>
                    }
                    else if (ticket.Blocked)
                    {
                        <p class="ticket__note"><Pill Tone="PillTone.Danger">Blocked</Pill> @ticket.BlockedBecause</p>
                        <Button Variant="ButtonVariant.Quiet" Small="true" Busy="@(_busy == "block")" OnClick="() => UnblockAsync(ticket)">Unblock this phone</Button>
                    }
                    else
                    {
                        <p class="ticket__note">@(ticket.FromThisPhone == 1 ? "This is the only feedback from this phone." : $"{ticket.FromThisPhone} pieces of feedback from this phone.")</p>
                        @if (_blocking)
                        {
                            <TextField Label="Why block it?" Hint="Only people who look after feedback see this." MaxLength="300" @bind-Value="_blockReason" />
                            <SaveBar Label="Block this phone" Busy="@(_busy == "block")" Blocked="@(_blockReason.Trim().Length == 0 ? "Say why to block it." : null)" OnSave="() => BlockAsync(ticket)"
                                     OnCancel="() => (_blocking, _blockReason) = (false, string.Empty)" />
                        }
                    }
                }

                @if (ticket.PhoneData is { } data)
                {
                    <h3>Its stored data</h3>
                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="database" Busy="@(_busy == "data")" OnClick="() => DownloadAsync(data)">Download a copy (@FeedbackWords.Size(data.Bytes))</Button>
                    <p class="ticket__hint">Everything the phone had synced, for finding a bug. It can hold the person's private things.</p>
                }
                else if (ticket.HadPhoneData && !line.AttachmentsDeleted)
                {
                    <p class="ticket__hint">A copy of the phone's stored data came with it; downloading it needs the phone data permission.</p>
                }

                @if (ticket.State.Length > 0)
                {
                    <details class="ticket__state">
                        <summary><Icon Name="chevron-right" Size="IconSize.Small" />The phone's state</summary>
                        <pre>@ticket.State</pre>
                    </details>
                }

            </aside>
        </div>
    </article>

    <Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@($"Delete #{line.Number}?")"
           Lead="Its words, pictures, videos and notes go. This can't be undone.">
        <Actions>
            <Button Variant="ButtonVariant.Danger" Block="true" Busy="@(_busy == "delete")" OnClick="() => DeleteAsync(ticket)">Delete it</Button>
            <Button Variant="ButtonVariant.Quiet" Block="true" OnClick="() => _deleting = false">Keep it</Button>
        </Actions>
    </Sheet>
</LiveData>
<Notice Tone="NoticeTone.Warning" Text="@_problem" />

@code {
    private static readonly IReadOnlyCollection<string> DeskFeeds = [FeedbackFeeds.Desk];
    private static readonly IReadOnlyList<SegmentOption<TicketStatus>> StatusOptions =
        FeedbackWords.Board.Select(status => new SegmentOption<TicketStatus>(status, FeedbackWords.Status(status))).ToList();

    private LiveData<Ticket>? _live;
    private string _note = "";
    private string _blockReason = "";
    private bool _blocking;
    private bool _deleting;
    private bool _viewing;
    private int _viewingAt;
    private string? _busy;
    private string? _problem;

    [Parameter, EditorRequired] public int Number { get; set; }
    [Parameter] public bool Docked { get; set; }
    private IReadOnlyList<MenuItem> Actions(Ticket ticket) =>
    [
        .. ticket.Line.Status == TicketStatus.NotDoing ? Array.Empty<MenuItem>() : [this.Item("Mark not doing", () => SetStatusAsync(ticket, TicketStatus.NotDoing), "circle-off", disabled: _busy is not null)],
        .. ticket.Browser is null && ticket.InstallId.Length > 0 && !ticket.Blocked && !_blocking
            ? [this.Item("Block this phone…", () => { _blocking = true; return Task.CompletedTask; }, "ban")]
            : Array.Empty<MenuItem>(),
        this.Item("Delete this feedback…", () => { _deleting = true; return Task.CompletedTask; }, "trash-2", danger: true, startsGroup: true),
    ];

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnGone { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private Task<Ticket> LoadAsync() => Desk.TicketAsync(Number);

    private sealed record TimelineItem(DateTime At, TicketNote? Note, TicketStep? Step);

    private static IEnumerable<TimelineItem> Timeline(Ticket ticket) =>
        ticket.History.Select(step => new TimelineItem(step.At, null, step))
            .Concat(ticket.Notes.Select(note => new TimelineItem(note.At, note, null)))
            .OrderBy(item => item.At);

    private static string AppLine(Ticket ticket)
    {
        PhoneDetails phone = ticket.Phone ?? new PhoneDetails();
        List<string> parts = [];
        if (phone.AppVersion.Length > 0)
            parts.Add($"{phone.AppVersion} ({phone.AppBuild})");
        if (ticket.Environment.Length > 0)
            parts.Add(ticket.Environment);
        if (phone.DevelopmentBuild)
            parts.Add("a development build");
        return parts.Count == 0 ? "Not known" : string.Join(" · ", parts);
    }

    private static string PhoneLine(Ticket ticket)
    {
        PhoneDetails phone = ticket.Phone ?? new PhoneDetails();
        string system = $"{FeedbackWords.Platform(phone)} {phone.OsVersion}".Trim();
        string model = phone.Model.Length > 0 && PhoneModels.Name(phone.Model) != phone.Model ? $"{PhoneModels.Name(phone.Model)} ({phone.Model})" : phone.Model;
        return string.Join(" · ", new[] { model, system }.Where(part => part.Length > 0)) is { Length: > 0 } line ? line : "Not known";
    }

    private Task SetStatusAsync(Ticket ticket, TicketStatus status) =>
        status == ticket.Line.Status ? Task.CompletedTask : DoAsync("status", () => Desk.SetStatusAsync(ticket.Line.Id, status));

    private Task AddNoteAsync(Ticket ticket) => DoAsync("note", async () =>
    {
        await Desk.AddNoteAsync(ticket.Line.Id, _note);
        _note = "";
    });

    private Task DeleteNoteAsync(Ticket ticket, string noteId) => DoAsync("note", () => Desk.DeleteNoteAsync(ticket.Line.Id, noteId));

    private Task BlockAsync(Ticket ticket) => DoAsync("block", async () =>
    {
        await Desk.BlockAsync(ticket.Line.Id, _blockReason);
        (_blocking, _blockReason) = (false, "");
    });

    private Task UnblockAsync(Ticket ticket) => DoAsync("block", () => Desk.UnblockAsync(ticket.InstallId));

    private async Task DeleteAsync(Ticket ticket)
    {
        await DoAsync("delete", () => Desk.DeleteAsync(ticket.Line.Id), reload: false);
        if (_problem is null)
        {
            _deleting = false;
            await OnGone.InvokeAsync();
        }
    }

    private static List<MediaRef> Screenshots(Ticket ticket) => ticket.Attachments.Where(media => media.IsImage).ToList();

    private void OpenScreenshot(int index) => (_viewingAt, _viewing) = (index, true);

    private Task DownloadAsync(MediaRef data) => DoAsync("data", async () =>
    {
        if (await Files.SourceOfAsync(data) is { } link)
            await Js.InvokeVoidAsync("open", link, "_blank");
    }, reload: false);

    private async Task DoAsync(string what, Func<Task> work, bool reload = true)
    {
        (_busy, _problem) = (what, null);
        try
        {
            await work();
            if (reload && _live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = null;
        }
    }
}
