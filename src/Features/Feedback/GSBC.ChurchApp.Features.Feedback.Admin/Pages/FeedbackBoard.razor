@page "/feedback"
@inject FeedbackDeskClient Desk
@inject UnsavedChanges Unsaved
@inject IJSRuntime Js

<LiveData @ref="_live" TValue="DeskList" Feeds="DeskFeeds" Load="LoadAsync" FailedTitle="Can't load feedback right now">
    <div class="feedback-desk @(_open is null ? "" : "feedback-desk--docked")">
        <div class="feedback-desk__main">
            <TitleBand Title="Feedback" Lead="@Lead(context.Value)">
                <Actions>
                    <SearchField Label="Find feedback" Placeholder="Words or #number" Value="@_query" ValueChanged="SearchAsync" Class="feedback-desk__search" />
                </Actions>
            </TitleBand>
            <TabStrip TValue="DeskView" Label="Show" Options="Views" Value="_view" ValueChanged="view => _view = view" />

            @if (_view == DeskView.Blocked)
            {
                <BlockedPhonesList />
            }
            else
            {
                <FilterChips TValue="SourceFilter" Label="Sent from" Options="Sources" Value="_source" ValueChanged="SourceAsync" />
                <Board TItem="TicketLine" TColumn="TicketStatus" Label="Feedback by status" Columns="Columns" Items="Ordered(context.Value)" ColumnOf="ticket => ticket.Status"
                       OnMove="MoveAsync" Compact="_open is not null" Class="feedback-desk__board">
                    <Card Context="ticket">
                        <TicketCard Ticket="ticket" Open="ticket.Number == _open" OnOpen="args => OpenAsync(args, ticket)" />
                    </Card>
                </Board>
                <p class="feedback-desk__hint">Drag a card to another column to move it along (or press Alt and an arrow key), or open it and choose its status. ⌘-click or Ctrl-click a card to open it in a new tab.</p>
            }
        </div>
        @if (_open is { } number)
        {
            <aside class="feedback-desk__dock" aria-label="@($"Feedback #{number}")">
                <TicketView @key="number" Number="number" Docked="true" OnClose="CloseAsync" OnGone="() => _open = null" />
            </aside>
        }
    </div>
</LiveData>

@code {
    private const int ResolvedShown = 20;
    private static readonly IReadOnlyCollection<string> DeskFeeds = [FeedbackFeeds.Desk];

    private enum DeskView
    {
        Board,
        Blocked,
    }

    private static readonly IReadOnlyList<TabOption<DeskView>> Views = [new(DeskView.Board, "Board"), new(DeskView.Blocked, "Blocked phones")];

    private static readonly IReadOnlyList<FilterOption<SourceFilter>> Sources =
        [new(SourceFilter.Both, "Everywhere"), new(SourceFilter.App, "The app"), new(SourceFilter.AdminPanel, "The admin panel")];

    private LiveData<DeskList>? _live;
    private SourceFilter _source;
    private DeskView _view = DeskView.Board;
    private string _query = "";
    private int? _open;

    private static readonly IReadOnlyList<BoardColumn<TicketStatus>> Columns =
    [
        .. FeedbackWords.Board.Select(status => status == TicketStatus.Resolved
            ? new BoardColumn<TicketStatus>(status, FeedbackWords.Status(status), Narrow: true, Shown: ResolvedShown, More: More)
            : new BoardColumn<TicketStatus>(status, FeedbackWords.Status(status), status == TicketStatus.New ? "Nothing new." : "Nothing here.")),
        new(TicketStatus.NotDoing, FeedbackWords.Status(TicketStatus.NotDoing), Narrow: true, Folds: true, Shown: ResolvedShown, More: More),
    ];

    private Task<DeskList> LoadAsync() => Desk.ListAsync(DeskFilter.Everything, _query, _source);

    private static string More(int count) => $"And {count} more. Find one by its number or words.";

    private static List<TicketLine> Ordered(DeskList list) =>
        list.Tickets.OrderByDescending(ticket => FeedbackWords.IsClosed(ticket.Status) ? ticket.ChangedAt : ticket.SentAt).ToList();

    private static string Lead(DeskList list)
    {
        int Count(TicketStatus status) => list.Counts.FirstOrDefault(count => count.Status == status)?.Count ?? 0;
        return $"{Count(TicketStatus.New)} new · {Count(TicketStatus.InProgress)} in progress · {Count(TicketStatus.FixedToCheck)} fixed, to check";
    }

    private async Task SourceAsync(SourceFilter source)
    {
        _source = source;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task SearchAsync(string query)
    {
        _query = query;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task OpenAsync(MouseEventArgs args, TicketLine ticket)
    {
        if (args.MetaKey || args.CtrlKey || args.ShiftKey)
        {
            await Js.InvokeVoidAsync("open", FeedbackDestinations.Ticket(ticket.Number).TrimStart('/'), "_blank");
            return;
        }
        if (ticket.Number == _open || !await Unsaved.MayLeaveAsync())
            return;
        _open = ticket.Number;
    }

    private async Task CloseAsync()
    {
        if (await Unsaved.MayLeaveAsync())
            _open = null;
    }

    private async Task MoveAsync(BoardMove<TicketLine, TicketStatus> move)
    {
        move.Item.Status = move.To;
        await Desk.SetStatusAsync(move.Item.Id, move.To);
        if (_live is not null)
            await _live.ReloadAsync();
    }
}
