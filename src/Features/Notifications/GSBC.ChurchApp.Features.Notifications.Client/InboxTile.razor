@using GSBC.ChurchApp.Platform.Contracts.Configuration
@using GSBC.ChurchApp.Platform.Ui.Surfaces
@inject IServiceProvider Services

@if (Services.GetService(typeof(Inbox)) is Inbox inbox)
{
    <LiveData TValue="IReadOnlyList<InboxEntry>" Load="inbox.LoadAsync" Feeds="Inbox.Feeds" Remember="@Inbox.Remembered" ReloadOn="ChangeKind.Reconnected | ChangeKind.Session">
        <ChildContent>@Drawn(context.Value)</ChildContent>
        <Loading>@Drawn([])</Loading>
        <Failed>@Drawn([])</Failed>
    </LiveData>
}
else
{
    @Drawn([])
}

@code {
    [Parameter, EditorRequired] public required ArrangedSurface Entry { get; set; }

    private TileLook Look => TileLook.Of(NotificationsTiles.Inbox, Entry.Values);

    [CascadingParameter] public HubContext Hub { get; set; } = HubContext.Still;

    private static readonly List<InboxEntry> Examples =
    [
        new(new InboxItem { Id = "example-1", Title = "An example notice", Body = "Notices the church sends show here, newest first." }, true),
        new(new InboxItem { Id = "example-2", Title = "Another example notice", Body = "Each one opens where it points." }, true),
        new(new InboxItem { Id = "example-3", Title = "A third example", Body = "" }, true),
    ];

    private RenderFragment Drawn(IReadOnlyList<InboxEntry> entries)
    {
        TileLook look = Look;
        TileSpan span = new(Math.Min(look.Columns, Hub.Columns), look.Rows);
        List<InboxEntry> unread = entries.Where(entry => entry.Unread).ToList();
        if (unread.Count == 0 && !Hub.Live)
            unread = Examples;
        TileVariant chosen = NotificationsTiles.Inbox.VariantFor(look, Hub.Columns);
        string variant = chosen.Key;
        string count = $"{unread.Count} unread";
        if (WordsTileView.ShapeOf(chosen) is { } shape)
            return unread.Count == 0
                ? @<HubTile Look="@(look with { Icon = "" })" Layout="shape" Title="@look.Title" Lines="[look.Text]" PlacementId="@Entry.Placement?.Id" />
                : @<HubTile Look="@(look with { Icon = "" })" Layout="shape" Title="@count" Lines="[unread[0].Item.Title]" Unread="true" PlacementId="@Entry.Placement?.Id" />;
        look = look with { Image = null };
        if (unread.Count == 0)
            return @<HubTile Look="look" Title="@look.Title" Lines="[look.Text]" PlacementId="@Entry.Placement?.Id" />;
        return variant switch
        {
            NotificationsTiles.Newest => @<HubTile Look="@(look with { Icon = "" })" Title="@unread[0].Item.Title" Lines="[count, unread[0].Item.Body]" Unread="true" PlacementId="@Entry.Placement?.Id" />,
            NotificationsTiles.Dots => @<HubTile Look="@(look with { Icon = "" })" Layout="TileShape.Square" Title="@count" Class="hub-tile--list" PlacementId="@Entry.Placement?.Id">
                <span class="hub-dots">
                    @foreach (InboxEntry entry in unread.Take(span.Rows > 1 ? span.Rows * 2 : 2))
                    {
                        <span class="hub-dots__item"><i class="hub-tile__dot" aria-hidden="true"></i><span class="hub-dots__title">@entry.Item.Title</span></span>
                    }
                </span>
            </HubTile>,
            _ => @<HubTile Look="@(look with { IconTone = "warm" })" Title="@count" Lines="[unread[0].Item.Title]" Unread="true" PlacementId="@Entry.Placement?.Id" />,
        };
    }
}
