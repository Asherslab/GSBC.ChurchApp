@using GSBC.ChurchApp.Platform.Client.Access
@implements IDisposable
@inject IAccess Access
@inject PushRegistration Push
@inject NotificationPreferences Preferences
@inject Shell Shell

@if (Push.Permission == PushRegistration.Denied)
{
    <Section First="true">
        <Notice Tone="NoticeTone.Warning" Text="Notifications are off for this app in your iPhone's Settings. Open Settings, tap Notifications, and turn on Allow Notifications.">
            <span class="ui-actions"><Button Small="true" Icon="external-link" OnClick="OpenSettingsAsync">Open Settings</Button></span>
        </Notice>
    </Section>
}
else if (Push.Permission != PushRegistration.Granted)
{
    <Section First="true">
        <Card Title="Hear from the church">
            <ChildContent><p>Get a notification when the church sends an announcement, or something is waiting for you.</p></ChildContent>
            <Footer><Button Busy="_turningOn" OnClick="TurnOnAsync">Turn on notifications</Button></Footer>
        </Card>
    </Section>
}

<LiveData TValue="IReadOnlyList<KindChoice>" Load="Preferences.LoadAsync" Feeds="NotificationPreferences.Feeds">
    @foreach (IGrouping<string, KindChoice> area in context.Value.GroupBy(choice => choice.Kind.Area))
    {
        <Section Title="@area.Key" Grouped="true">
            <ListGroup>
                @foreach (KindChoice choice in area)
                {
                    <ToggleRow Title="@choice.Kind.Description" Description="@(choice.Kind.Mandatory ? "Always on: it's about your account's safety" : null)"
                               Checked="choice.Push" Disabled="choice.Kind.Mandatory" CheckedChanged="push => Preferences.SetAsync(choice.Kind, push)" />
                }
            </ListGroup>
        </Section>
    }
    <Section>
        <p class="hint">What you turn off doesn't reach your notifications list or buzz your phone.@(Access.SignedIn ? "" : " Sign in to keep your choices on every phone you use.")</p>
    </Section>
</LiveData>

@code {
    private const string AppSettings = "app-settings:";
    private bool _turningOn;

    protected override void OnInitialized() => Push.Changed += OnChanged;

    private async Task TurnOnAsync()
    {
        _turningOn = true;
        await Push.TurnOnAsync();
        _turningOn = false;
    }

    private Task OpenSettingsAsync() => Shell.OpenExternalAsync(AppSettings).AsTask();

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Push.Changed -= OnChanged;
}
