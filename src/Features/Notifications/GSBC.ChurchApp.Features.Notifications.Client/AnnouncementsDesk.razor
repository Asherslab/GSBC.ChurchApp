@using System.Globalization
@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Client.Access
@using GSBC.ChurchApp.Platform.Client.Modules
@using GSBC.ChurchApp.Platform.Common
@implements IDisposable
@inject AnnouncementsClient Announcements
@inject IAccess Access
@inject NavigationManager Navigation
@inject TimeProvider Clock

<TitleBand Title="Announcements" Lead="What goes out this week and next, and what you're writing. Times are church time.">
    <Actions>
        <Button Icon="plus" Href="announcements/new">New announcement</Button>
    </Actions>
</TitleBand>

<LiveData @ref="_live" TValue="IReadOnlyList<Announcement>" Load="LoadAsync" Feeds="[NotificationsFeeds.Announcements]" FailedTitle="Can't load announcements right now">
    <DayRail First="FirstDay" Today="Today" Days="FortnightDays" Spans="Spans(context.Value)" Heading="This week and next" Selected="@SelectedHref"
             Quiet="Nothing sent or scheduled this week or next." Legend="Legend" />

    @if (context.Value.Where(announcement => announcement.State is Drafting or WaitingToSend).ToList() is { Count: > 0 } unsent)
    {
        <nav class="announcement-unsent" aria-label="Not sent yet">
            <span class="announcement-unsent__label">Not sent yet</span>
            @foreach (Announcement announcement in unsent)
            {
                <a class="announcement-chip" href="announcements/@announcement.Id" aria-current="@(announcement.Id == _editing.Id ? "page" : null)">
                    <span class="announcement-chip__title">@announcement.Title</span>
                    <span class="announcement-chip__state">@StateLabel(announcement)</span>
                </a>
            }
        </nav>
    }

    @if (_gone)
    {
        <Notice Tone="NoticeTone.Warning" Text="That announcement isn't there any more: someone deleted it. Start a new one, or pick another." />
    }
    else
    {
        <div class="announcement-desk">
            <div class="announcement-desk__writing">
                <div class="announcement-desk__head">
                    <h2 class="announcement-desk__title">@DeskTitle</h2>
                    @if (Editable)
                    {
                        <SaveStatus State="_save" SavedText="@(_editing.Id.Length == 0 ? "Saves as you type" : "Saved")" Detail="@StateLabel(_editing)" Retry="SaveNowAsync" />
                    }
                </div>

                @if (_told is not null)
                {
                    <Notice Text="@_told" />
                }
                @if (_problem is not null)
                {
                    <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                }

                @if (Editable)
                {
                    @if (_editing.State == WaitingToSend)
                    {
                        <p class="announcement-desk__state">Waiting for someone who sends announcements. Changing it puts it back to being written.</p>
                    }
                    <TextField Label="Title" Value="@_editing.Title" ValueChanged="value => Change(a => a.Title = value)" MaxLength="80" Required="true"
                               Hint="What the lock screen shows in bold" />
                    <TextField Label="Message" Value="@_editing.Body" ValueChanged="value => Change(a => a.Body = value)" Multiline="true" MaxLength="600"
                               Hint="A sentence or two. Phones show about four lines; the whole message is in the app." />

                    <dl class="announcement-checks">
                        <div class="announcement-check">
                            <dt>Who it's for</dt>
                            <dd>
                                <SelectField Label="Who it's for" Options="Audiences" Value="@(_editing.Audience?.Kind ?? Everyone)" ValueChanged="ChooseAudienceAsync" Hint="@ReachLine" />
                            </dd>
                        </div>
                        <div class="announcement-check">
                            <dt>When</dt>
                            <dd>
                                @if (MaySend)
                                {
                                    <Segmented TValue="bool" Label="When it goes" Options="Timings" Value="_later" ValueChanged="later => _later = later" />
                                    @if (_later)
                                    {
                                        <div class="announcement-check__pair">
                                            <TextField Label="Day" Type="date" Value="@_day" ValueChanged="value => _day = value" Min="@Today.ToString(DayFormat, CultureInfo.InvariantCulture)" />
                                            <SelectField Label="Time" Options="Times" Value="@_time" ValueChanged="value => _time = value" />
                                        </div>
                                        <p class="announcement-check__note">@LaterLine</p>
                                    }
                                    else
                                    {
                                        <p class="announcement-check__note">As soon as you send it. Between 9pm and 7am it waits until 7am, unless it's urgent.</p>
                                    }
                                }
                                else
                                {
                                    <p class="announcement-check__note">Whoever sends it chooses when.</p>
                                }
                            </dd>
                        </div>
                        <div class="announcement-check">
                            <dt>Opens</dt>
                            <dd>
                                <SelectField Label="What it opens" Options="Opens" Value="@_opens" ValueChanged="ChooseOpens" />
                                @if (_opens == OpensWeb)
                                {
                                    <TextField Label="Web address" Type="url" Value="@(_editing.Link ?? "")" ValueChanged="value => Change(a => a.Link = value)" Placeholder="https://baptist.com.au/…"
                                               Problem="@LinkProblem" />
                                }
                                else if (_opens == OpensPage)
                                {
                                    <TextField Label="Page in the app" Value="@(_editing.Link ?? "")" ValueChanged="value => Change(a => a.Link = value)" Placeholder="/whats-new"
                                               Hint="Ask whoever looks after the app for the page's address" Problem="@LinkProblem" />
                                }
                            </dd>
                        </div>
                        <div class="announcement-check">
                            <dt>Urgent</dt>
                            <dd>
                                <ToggleRow Title="Urgent" Description="Goes straight away, even overnight, and breaks through Focus. For a cancelled service or a change of venue." Checked="_editing.Urgent"
                                           CheckedChanged="value => Change(a => a.Urgent = value)" />
                            </dd>
                        </div>
                    </dl>

                    <div class="announcement-desk__actions">
                        @if (_editing.Id.Length > 0)
                        {
                            <Button Variant="ButtonVariant.Danger" Small="true" Busy="_busy" OnClick="DeleteAsync">Delete</Button>
                        }
                        <span class="announcement-desk__spacer"></span>
                        <Button Variant="ButtonVariant.Quiet" Icon="smartphone" Busy="_busy" Disabled="@(!Ready)" OnClick="SendToMeAsync">Send to my phone</Button>
                        @if (MaySend)
                        {
                            <Button Icon="send" Busy="_busy" Disabled="@(!Ready || (_later && LaterAt is null))" OnClick="() => _confirming = true">@SendLabel</Button>
                        }
                        else
                        {
                            <Button Icon="send" Busy="_busy" Disabled="@(!Ready || _editing.State == WaitingToSend)" OnClick="AskAsync">Ask for it to be sent</Button>
                        }
                    </div>
                }
                else
                {
                    <div class="announcement-desk__sent">
                        <p class="announcement-desk__state">@SentLine(_editing)</p>
                        <p class="announcement-desk__message">@_editing.Body</p>
                        @if (_editing.State == Scheduled && MaySend)
                        {
                            <div class="announcement-desk__actions">
                                <Button Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="CancelAsync">Don't send it: back to writing</Button>
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="announcement-desk__proof" aria-label="How it looks">
                <LockScreenProof Title="@_editing.Title" Body="@_editing.Body" TimeSensitive="_editing.Urgent" Date="@Today.ToString("dddd d MMMM", CultureInfo.InvariantCulture)">
                    Tapping it opens @OpensWords, and it stays in everyone's notifications in the app.
                </LockScreenProof>
            </aside>
        </div>
    }

    @if (context.Value.Where(announcement => announcement.State == Sent && announcement.SentAt < ChurchTime.ToUtc(FirstDay)).ToList() is { Count: > 0 } earlier)
    {
        <Section Title="Sent earlier">
            <DataTable TItem="Announcement" Label="Announcements sent earlier" Items="earlier" Columns="EarlierColumns" Key="announcement => announcement.Id"
                       Selected="earlier.FirstOrDefault(announcement => announcement.Id == _editing.Id)" SelectedChanged="Open" SortColumn="1" SortDescending="true" />
        </Section>
    }
</LiveData>

<Sheet Open="_confirming" OpenChanged="open => _confirming = open" Title="@ConfirmTitle" Lead="@ConfirmLead">
    <ChildContent>
        @if (_reach is { Phones: 0 })
        {
            <Notice Tone="NoticeTone.Warning" Text="No phone with notifications on would get it right now. It still goes into the app's notifications." />
        }
        <LockScreenProof Title="@_editing.Title" Body="@_editing.Body" TimeSensitive="_editing.Urgent" Date="@Today.ToString("dddd d MMMM", CultureInfo.InvariantCulture)" />
        <dl class="announcement-confirm">
            <div><dt>Who it's for</dt><dd>@ReachSummary</dd></div>
            <div><dt>When</dt><dd>@(_later ? LaterLine : "Now")</dd></div>
            @if (_editing.Urgent)
            {
                <div><dt>Urgent</dt><dd>Yes: it breaks through Focus and quiet hours</dd></div>
            }
        </dl>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _confirming = false">Back to writing</Button>
        <Button Icon="send" Busy="_busy" OnClick="SendAsync">@(_later ? "Schedule it" : "Send it now")</Button>
    </Actions>
</Sheet>

@code {
    private const string Everyone = "everyone";
    private const string SignedIn = "signed-in";
    private const string Drafting = "Draft";
    private const string WaitingToSend = "WaitingToSend";
    private const string Scheduled = "Scheduled";
    private const string Sent = "Sent";
    private const string OpensNothing = "inbox";
    private const string OpensWeb = "web";
    private const string OpensPage = "page";
    private const string DayFormat = "yyyy-MM-dd";
    private const string TimeFormat = "HH:mm";
    private const string NewId = "new";
    private const int FortnightDays = 14;
    private static readonly TimeSpan SettleTime = TimeSpan.FromMilliseconds(800);

    private static readonly IReadOnlyList<FieldOption> Audiences = [new(Everyone, "Everyone with the app"), new(SignedIn, "Everyone signed in")];
    private static readonly IReadOnlyList<SegmentOption<bool>> Timings = [new(false, "Now"), new(true, "Later")];
    private static readonly IReadOnlyList<FieldOption> Times = Enumerable.Range(0, 69)
        .Select(step => DateTime.MinValue.AddHours(5).AddMinutes(step * 15))
        .Select(time => new FieldOption(time.ToString(TimeFormat, CultureInfo.InvariantCulture), ChurchDates.Time(time)))
        .ToList();
    private static readonly IReadOnlyList<FieldOption> Opens =
        [new(OpensNothing, "The notifications list"), new(OpensWeb, "A web page"), new(OpensPage, "A page in the app")];
    private static readonly IReadOnlyList<(OfficeSpanKind Kind, string Label)> Legend = [(OfficeSpanKind.Everyone, "Sent"), (OfficeSpanKind.Draft, "Scheduled")];

    [Parameter] public string? Id { get; set; }

    private LiveData<IReadOnlyList<Announcement>>? _live;
    private IReadOnlyList<Announcement> _all = [];
    private Announcement _editing = Fresh();
    private string? _opened;
    private bool _gone;
    private string _opens = OpensNothing;
    private bool _later;
    private string _day = "";
    private string _time = "07:00";
    private Reach? _reach;
    private SaveState _save = SaveState.Saved;
    private CancellationTokenSource? _settling;
    private bool _busy;
    private bool _confirming;
    private string? _told;
    private string? _problem;

    private DateTime Today => ChurchTime.ToChurch(Clock.GetUtcNow().UtcDateTime).Date;

    private DateTime FirstDay => Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7));

    private bool MaySend => Access.Can(NotificationsPermissions.Send);

    private bool Editable => _editing.State is Drafting or WaitingToSend;

    private bool Ready => _editing.Title.Trim().Length > 0 && LinkProblem is null;

    private string? SelectedHref => _editing.Id.Length > 0 ? $"announcements/{_editing.Id}" : null;

    private string DeskTitle => _editing.Id.Length == 0 ? "New announcement" : _all.FirstOrDefault(a => a.Id == _editing.Id)?.Title is { Length: > 0 } saved ? saved : "Untitled announcement";

    private string ReachLine => _reach is null ? "" : $"About {Count(_reach.Phones, "phone")} with notifications on, and {Count(_reach.People, "person", "people")} signed in";

    private string ReachSummary => $"{Audiences.First(option => option.Value == (_editing.Audience?.Kind ?? Everyone)).Label}{(_reach is null ? "" : $", about {Count(_reach.Phones, "phone")}")}";

    private string SendLabel => _later ? "Schedule it" : _reach is { Phones: > 0 } reach ? $"Send to {Count(reach.Phones, "phone")}" : "Send it";

    private string ConfirmTitle => _later ? "Schedule this announcement?" : _reach is { Phones: > 0 } reach ? $"Send to about {Count(reach.Phones, "phone")} now?" : "Send it now?";

    private string ConfirmLead => _later
        ? "You can still cancel it until it goes."
        : "It goes straight to people's phones and into the app's notifications. It can't be taken back.";

    private DateTime? LaterAt =>
        DateTime.TryParseExact($"{_day} {_time}", $"{DayFormat} {TimeFormat}", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime local) && local > ChurchTime.ToChurch(Clock.GetUtcNow().UtcDateTime)
            ? ChurchTime.ToUtc(local)
            : null;

    private string LaterLine => LaterAt is { } at ? $"Goes out {Describe(at)}." : "Choose a day and a time that haven't passed.";

    private string OpensWords => _opens switch
    {
        OpensWeb => "the web page",
        OpensPage => "that page of the app",
        _ => "the app's notifications",
    };

    private string? LinkProblem => (_opens, _editing.Link?.Trim() ?? "") switch
    {
        (OpensNothing, _) => null,
        (_, "") => "Fill this in, or choose the notifications list.",
        (OpensWeb, var link) when LinkTargets.KindOf(link) != LinkKind.Web => "A web address starts with https://",
        (OpensPage, var link) when LinkTargets.KindOf(link) != LinkKind.InApp => "A page in the app starts with /",
        _ => null,
    };

    private IReadOnlyList<TableColumn<Announcement>> EarlierColumns =>
    [
        new("Announcement", announcement => @<span class="cell-strong">@announcement.Title</span>, announcement => announcement.Title),
        new("Sent", announcement => @<DateLine At="announcement.SentAt!.Value" Style="DateLineStyle.Short" WithTime="true" />, announcement => announcement.SentAt, "num"),
        new("Phones", announcement => @<span>@announcement.ReachedPhones</span>, announcement => announcement.ReachedPhones, "num optional"),
        new("Read by", announcement => @<span>@announcement.ReadBy</span>, announcement => announcement.ReadBy, "num"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _opened)
            return;
        _opened = Id;
        _told = _problem = null;
        _gone = false;
        _confirming = false;
        if (Id is null or NewId)
            Show(Fresh());
        else if (_all.FirstOrDefault(announcement => announcement.Id == Id) is { } found)
            Show(found);
        else if (_live is not null)
            await _live.ReloadAsync();
        await ReachAsync();
    }

    private async Task<IReadOnlyList<Announcement>> LoadAsync()
    {
        _all = await Announcements.ListAsync();
        if (Id is not null and not NewId && _save == SaveState.Saved)
        {
            Announcement? found = _all.FirstOrDefault(announcement => announcement.Id == Id);
            _gone = found is null;
            if (found is not null && (found.Id != _editing.Id || !Editable || found.State != _editing.State))
                Show(found);
        }
        return _all;
    }

    private void Show(Announcement announcement)
    {
        _editing = Copy(announcement);
        _opens = announcement.Link is not { Length: > 0 } link ? OpensNothing : LinkTargets.KindOf(link) == LinkKind.Web ? OpensWeb : OpensPage;
        _later = announcement.SendAt is not null;
        DateTime at = announcement.SendAt is { } sendAt ? ChurchTime.ToChurch(sendAt) : Today.AddDays(1).AddHours(7);
        at = at.AddMinutes(-(at.Minute % 15));
        _day = at.ToString(DayFormat, CultureInfo.InvariantCulture);
        _time = at.ToString(TimeFormat, CultureInfo.InvariantCulture);
        _save = SaveState.Saved;
    }

    private static Announcement Fresh() => new() { Audience = new AudienceMessage { Kind = Everyone }, State = Drafting };

    private static Announcement Copy(Announcement announcement) => new()
    {
        Id = announcement.Id, Title = announcement.Title, Body = announcement.Body, Link = announcement.Link, Urgent = announcement.Urgent,
        Audience = new AudienceMessage { Kind = announcement.Audience?.Kind ?? Everyone }, State = announcement.State, SendAt = announcement.SendAt,
        SentAt = announcement.SentAt, UpdatedAt = announcement.UpdatedAt, ReachedPeople = announcement.ReachedPeople, ReachedPhones = announcement.ReachedPhones,
        ReadBy = announcement.ReadBy,
    };

    private void Open(Announcement announcement) => Navigation.NavigateTo($"announcements/{announcement.Id}");

    private void Change(Action<Announcement> change)
    {
        change(_editing);
        _told = null;
        if (_editing.Title.Trim().Length == 0)
            return;
        _save = SaveState.Waiting;
        _settling?.Cancel();
        _settling = new CancellationTokenSource();
        CancellationToken settling = _settling.Token;
        _ = Task.Delay(SettleTime, settling).ContinueWith(_ => InvokeAsync(SaveNowAsync), settling, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
    }

    private void ChooseOpens(string opens)
    {
        _opens = opens;
        Change(a => a.Link = opens == OpensNothing ? null : a.Link);
    }

    private async Task ChooseAudienceAsync(string kind)
    {
        Change(a => a.Audience = new AudienceMessage { Kind = kind });
        await ReachAsync();
    }

    private async Task ReachAsync()
    {
        try
        {
            _reach = await Announcements.ReachAsync(_editing.Audience ?? new AudienceMessage { Kind = Everyone });
        }
        catch (RpcException)
        {
            _reach = null;
        }
    }

    private async Task SaveNowAsync()
    {
        if (!Editable || _editing.Title.Trim().Length == 0 || LinkProblem is not null)
        {
            _save = SaveState.Saved;
            StateHasChanged();
            return;
        }
        _settling?.Cancel();
        _save = SaveState.Saving;
        StateHasChanged();
        try
        {
            await SavedAsync();
            _save = SaveState.Saved;
        }
        catch (RpcException exception)
        {
            _save = SaveState.Failed;
            _problem = Words(exception);
        }
        StateHasChanged();
    }

    private async Task<Announcement> SavedAsync()
    {
        bool isNew = _editing.Id.Length == 0;
        Announcement saved = await Announcements.SaveAsync(_editing);
        _editing.Id = saved.Id;
        _editing.State = saved.State;
        if (isNew)
        {
            _opened = saved.Id;
            Navigation.NavigateTo($"announcements/{saved.Id}", replace: true);
        }
        return saved;
    }

    private Task SendToMeAsync() => RunAsync(async () =>
    {
        await Announcements.SendToMeAsync((await SavedAsync()).Id);
        _told = "Sent to your phone, marked Test. Check your lock screen.";
    });

    private Task AskAsync() => RunAsync(async () =>
    {
        Announcement asked = await Announcements.AskToSendAsync((await SavedAsync()).Id);
        _editing.State = asked.State;
        _told = "Asked. Whoever sends announcements sees it on their Home page and gets a notification.";
    });

    private Task SendAsync() => RunAsync(async () =>
    {
        DateTime? at = _later ? LaterAt : null;
        Announcement sent = await Announcements.SendAsync((await SavedAsync()).Id, at);
        Show(sent);
        _confirming = false;
        _told = sent.State == Scheduled ? $"Scheduled. It goes out {Describe(sent.SendAt!.Value)}." : $"Sent to about {Count(sent.ReachedPhones, "phone")} at {ChurchDates.Time(ChurchTime.ToChurch(sent.SentAt!.Value))}.";
    });

    private Task CancelAsync() => RunAsync(async () =>
    {
        Show(await Announcements.CancelAsync(_editing.Id));
        _told = "It won't be sent. It's back to being written.";
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Announcements.DeleteAsync(_editing.Id);
        Navigation.NavigateTo("announcements/new");
    });

    private async Task RunAsync(Func<Task> action)
    {
        _settling?.Cancel();
        _busy = true;
        _problem = null;
        try
        {
            await action();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = Words(exception);
            _confirming = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private IReadOnlyList<OfficeSpan> Spans(IReadOnlyList<Announcement> announcements)
    {
        DateTime from = ChurchTime.ToUtc(FirstDay);
        DateTime until = from.AddDays(FortnightDays);
        return announcements
            .Select(announcement => (announcement, at: announcement.State == Sent ? announcement.SentAt : announcement.State == Scheduled ? announcement.SendAt : null))
            .Where(entry => entry.at is { } at && at >= from && at < until)
            .Select(entry => new OfficeSpan(entry.announcement.Title, entry.at!.Value, entry.at.Value, $"announcements/{entry.announcement.Id}",
                entry.announcement.State == Sent ? OfficeSpanKind.Everyone : OfficeSpanKind.Draft))
            .ToList();
    }

    private string SentLine(Announcement announcement) => announcement.State switch
    {
        Sent => $"Sent {Describe(announcement.SentAt!.Value)} to about {Count(announcement.ReachedPhones, "phone")}. Read by {Count(announcement.ReadBy, "person", "people")} so far; phones not signed in aren't counted.",
        Scheduled => $"Scheduled: it goes out {Describe(announcement.SendAt!.Value)}.",
        _ => "Cancelled.",
    };

    private static string StateLabel(Announcement announcement) => announcement.State switch
    {
        Sent => "Sent",
        Scheduled => "Scheduled",
        WaitingToSend => "Waiting to send",
        _ => "Being written",
    };

    private string Describe(DateTime utc) => ChurchDates.Describe(utc, DateLineStyle.Relative, withTime: true, Clock.GetUtcNow().UtcDateTime);

    private static string Count(int count, string one, string? many = null) => $"{count} {(count == 1 ? one : many ?? one + "s")}";

    private static string Words(RpcException exception) => exception.StatusCode switch
    {
        StatusCode.Unavailable => "Can't reach the church's server. Check the connection and try again.",
        StatusCode.PermissionDenied => "You can't do that here. Ask whoever looks after the admin panel.",
        _ => exception.Status.Detail,
    };

    public void Dispose() => _settling?.Cancel();
}
