@page "/chats/reports"
@page "/chats/all"
@page "/chats/paused"
@page "/chats/log"
@page "/chats/check/{ChatId}"
@inject NavigationManager Navigation

<AddressWatch Changed="Redirect" />

@code {
    [Parameter] public string? ChatId { get; set; }

    protected override void OnInitialized() => Redirect();

    private void Redirect()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path.StartsWith("chats/", StringComparison.Ordinal))
            Navigation.NavigateTo("chat-safety" + path["chats".Length..], replace: true);
    }
}
