@using GSBC.ChurchApp.Platform.Client.Modules
@inject IAccess Access

<MinistryChatsTab On="On" />
@if (Access.Can(ChatsPermissions.Check, On.Id))
{
    <p class="hint">Chats you're in open in Chats. To read one of @(On.Name)'s other chats, check it under <a href="chat-safety/all">Chat safety</a>; every check is logged.</p>
}

@code {
    [Parameter, EditorRequired] public required MinistryOnPage On { get; set; }
}
