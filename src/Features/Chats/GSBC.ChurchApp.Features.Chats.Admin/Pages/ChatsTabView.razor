@inject ChatChecks Checks
@inject OversightClient Oversight
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => _reason.Trim().Length > 0" What="why you're reading the chat" />

<Workbench Detail="@(Chosen is { } chosen ? Detail(chosen) : null)" DetailLabel="The chat">
    <DataTable TItem="DeskChat" Label="Chats" Items="Desk.Chats" Columns="Columns" Key="chat => chat.Id" Selected="Chosen" SelectedChanged="Choose" RowClass="RowClass">
        <Toolbar>
            @if (Desk.Ministries.Any(ministry => ministry is { MayManage: true, ChatsOn: true }))
            {
                <Button Icon="plus" OnClick="() => _starting = true">New chat</Button>
            }
        </Toolbar>
        <Empty>
            <EmptyState Icon="message-square" Title="No chats yet" Body="Chats that leaders start in the ministries you check show here." />
        </Empty>
    </DataTable>
</Workbench>

<StartChatSheet Desk="Desk" Open="_starting" OpenChanged="open => _starting = open" />

<Sheet Open="_deleting is not null" OpenChanged="open => { if (!open) _deleting = null; }" Title="@($"Delete {_deleting?.Name}?")"
       Lead="Everyone in it loses the chat. The church keeps its messages and the log, so auditors can still check it.">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete the chat</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _deleting = null">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private string _reason = "";
    private string? _problem;
    private bool _busy;
    private bool _starting;
    private DeskChat? _deleting;
    private string? _chosenId;

    [Parameter, EditorRequired] public required Desk Desk { get; set; }

    private DeskChat? Chosen => Desk.Chats.FirstOrDefault(chat => chat.Id == _chosenId);

    private static readonly IReadOnlyList<TableColumn<DeskChat>> Columns =
    [
        new("Chat", chat => @<span><span class="cell-strong">@chat.Name</span><br /><span class="quiet">@chat.MinistryName</span></span>, chat => chat.Name),
        new("For", chat => @<span>@(chat.Kind == ChatKinds.Ask ? "Asking to join" : $"{ChatText.Audience(chat.Audience)}{(chat.Kind == ChatKinds.Channel ? " · leaders post" : "")}")</span>, chat => chat.Audience, "optional"),
        new("People", chat => @<span>@chat.People</span>, chat => chat.People, "num"),
        new("Last message", chat => chat.LastAt is { } at ? @<DateLine At="at" Style="DateLineStyle.Short" WithTime="true" /> : @<span class="quiet">None yet</span>, chat => chat.LastAt, "num optional"),
        new("Needs", chat => @<span class="chat-flag">@(chat.OpenReports > 0 ? ChatLead.Count(chat.OpenReports, "report", "reports") : chat.Flags.FirstOrDefault())</span>, chat => chat.OpenReports),
    ];

    private static string? RowClass(DeskChat chat) => chat.OpenReports > 0 ? "row--urgent" : null;

    private void Choose(DeskChat chat) => (_chosenId, _reason, _problem) = (chat.Id, "", null);

    private IReadOnlyList<MenuItem> Actions(DeskChat chat) => chat.MayManage
        ? [this.Item("Delete the chat…", () => _deleting = chat, "trash-2", "For everyone in it. The church keeps its messages.", danger: true)]
        : [];

    private RenderFragment Detail(DeskChat chat) =>
        @<div class="chat-report">
            <PaneHead Title="@chat.Name" Lead="@ChatLead.Of(chat)" Actions="Actions(chat)" OnClose="() => _chosenId = null" />
            @foreach (string flag in chat.Flags)
            {
                <Notice Tone="NoticeTone.Warning">@flag</Notice>
            }
            @if (Checks.Of(chat.Id) is { } open)
            {
                <p class="hint">You opened it earlier: "@open.Reason".</p>
                <div class="ui-actions">
                    <Button Icon="eye" Href="@ChatChecks.PageOf(chat.Id)">Open the chat again</Button>
                </div>
            }
            else
            {
                <LoggedNotice>Reading a chat is logged with your name, the time and why. The leaders of @chat.MinistryName and the church's chat auditors can see the log.</LoggedNotice>
                <TextField Label="Why are you reading this chat?" Hint="Kept in the log with your name and the time." Value="@_reason" ValueChanged="value => _reason = value" MaxLength="ChatLimits.NoteLength" />
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                <div class="ui-actions">
                    <Button Icon="eye" Busy="_busy" Disabled="@(_reason.Trim().Length == 0)" OnClick="() => OpenAsync(chat)">Open the chat</Button>
                </div>
            }
        </div>;

    private async Task OpenAsync(DeskChat chat)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await Checks.CheckAsync(chat.Id, _reason);
            _reason = "";
            Navigation.NavigateTo(ChatChecks.PageOf(chat.Id));
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleting is not { } chat)
            return;
        (_busy, _problem) = (true, null);
        try
        {
            await Oversight.DeleteAsync(chat.Id);
            (_deleting, _chosenId) = (null, null);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
