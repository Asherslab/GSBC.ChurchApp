@using GSBC.ChurchApp.Platform.Client.Modules

<Section First="true">
    <EmptyState Icon="message-square" Title="Chats are on people's phones" Body="@($"In the admin panel, {On.Name}'s chats are on the Chats page, where you can check them (every check is logged) and handle reports.")">
        <Button Variant="ButtonVariant.Quiet" Href="chats/all">Open Chats</Button>
    </EmptyState>
</Section>

@code {
    [Parameter, EditorRequired] public required MinistryOnPage On { get; set; }
}
