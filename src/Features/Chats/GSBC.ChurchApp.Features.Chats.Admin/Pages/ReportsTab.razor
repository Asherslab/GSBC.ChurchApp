@inject OversightClient Oversight

<UnsavedGuard Changed="() => _pausing is not null && _pauseReason.Trim().Length > 0" What="why you're pausing them" />

<LiveData @ref="_live" TValue="Reports" Load="Oversight.ReportsAsync" Feeds="[ChatsFeeds.Oversight]" FailedTitle="Can't load reports right now">
    <Workbench Detail="@(Chosen(context.Value) is { } chosen ? Detail(chosen) : null)" DetailLabel="The report">
        <DataTable TItem="ReportLine" Label="Reports" Items="Shown(context.Value)" Columns="Columns" Key="line => line.Id"
                   Selected="Chosen(context.Value)" SelectedChanged="line => _chosen = line.Id" RowClass="RowClass" SortColumn="0" SortDescending="true">
            <Toolbar>
                <FilterChips TValue="bool" Label="Show" Options="Filters(context.Value)" Value="_handled" ValueChanged="value => _handled = value" />
            </Toolbar>
            <Empty>
                <EmptyState Icon="flag" Title="@(_handled ? "Nothing handled yet" : "No reports waiting")" Body="When someone reports a message in a chat you check, it shows here." />
            </Empty>
        </DataTable>
    </Workbench>
</LiveData>

<Sheet Open="_pausing is not null" OpenChanged="open => { if (!open) _pausing = null; }" Title="@($"Pause {_pausing?.MessageSender} from chats?")"
       Lead="They lose every chat until someone lets them back in under Paused people. They aren't told who reported them. It's logged.">
    <ChildContent>
        <TextField Label="Why" Hint="Kept in the log." Value="@_pauseReason" ValueChanged="value => _pauseReason = value" MaxLength="ChatLimits.NoteLength" />
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" Disabled="@(_pauseReason.Trim().Length == 0)" OnClick="PauseAsync">Pause @ChatText.First(_pausing?.MessageSender ?? "")</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _pausing = null">Keep them in</Button>
    </Actions>
</Sheet>

@code {
    private LiveData<Reports>? _live;
    private string? _chosen;
    private bool _handled;
    private ReportLine? _pausing;
    private string _pauseReason = "";
    private string? _problem;
    private bool _busy;

    [Parameter, EditorRequired] public required Desk Desk { get; set; }

    private static readonly IReadOnlyList<TableColumn<ReportLine>> Columns =
    [
        new("Reported", report => @<DateLine At="report.At" Style="DateLineStyle.Short" WithTime="true" />, report => report.At, "num"),
        new("Chat", report => @<span><span class="cell-strong">@report.ChatName</span><br /><span class="quiet">@report.MinistryName</span></span>, report => report.ChatName),
        new("Message from", report => @<span>@report.MessageSender</span>, report => report.MessageSender),
        new("Sent to", report => @<Pill Tone="@(report.To == ReportRoutes.Auditors ? PillTone.Danger : PillTone.Quiet)">@(report.To == ReportRoutes.Auditors ? "Safety team" : "Leaders")</Pill>, report => report.To),
        new("By", report => @<span>@report.ReporterName</span>, report => report.ReporterName, "optional"),
    ];

    private IEnumerable<ReportLine> Shown(Reports reports) => _handled ? reports.Handled : reports.Open;

    private ReportLine? Chosen(Reports reports) => reports.Open.Concat(reports.Handled).FirstOrDefault(report => report.Id == _chosen);

    private static string? RowClass(ReportLine report) => report is { To: ReportRoutes.Auditors, HandledAt: null } ? "row--urgent" : null;

    private static IReadOnlyList<FilterOption<bool>> Filters(Reports reports) =>
        [new(false, "Waiting", reports.Open.Count), new(true, "Handled", reports.Handled.Count)];

    private IReadOnlyList<MenuItem> Actions(ReportLine report) =>
        Desk.Auditor && report.MessageSenderId.Length > 0
            ? [this.Item($"Pause {ChatText.First(report.MessageSender)} from chats…", () => (_pausing, _pauseReason, _problem) = (report, "", null), "pause",
                "They lose their chats until you let them back in.", danger: true)]
            : [];

    private RenderFragment Detail(ReportLine report) =>
        @<div class="chat-report">
            <PaneHead Title="@report.ChatName" Lead="@report.MinistryName" Actions="Actions(report)" OnClose="() => _chosen = null" />
            <ReportPanel @key="report.Id" Report="report" ShowHref="@ChatChecks.PageOf(report.ChatId, report.MessageId)" ShowLabel="Read it in the chat" OnHandled="ReloadAsync" />
        </div>;

    private Task ReloadAsync() => _live?.ReloadAsync() ?? Task.CompletedTask;

    private async Task PauseAsync()
    {
        if (_pausing is not { } report)
            return;
        (_busy, _problem) = (true, null);
        try
        {
            await Oversight.PauseAsync(report.MessageSenderId, true, _pauseReason);
            _pausing = null;
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
