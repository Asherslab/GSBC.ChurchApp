@using Grpc.Core
@inject IChats Store

<UnsavedGuard Changed="() => Open" Editing="_draft" State="() => Shape" What="this chat" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@($"New chat in {MinistryName}")">
    <ChildContent>
        <TextField Label="Name of the chat" Hint="Everyone in the chat sees this name." Value="@_draft.Name" ValueChanged="value => _draft.Name = value" MaxLength="ChatLimits.NameLength" Required="true" />
        @if (Leads)
        {
            <Segmented TValue="string" Label="Who can write" ShowLabel="true" Stacked="true" Options="Kinds" Value="_draft.Kind" ValueChanged="value => _draft.Kind = value" />
            <Segmented TValue="string" Label="Who's in the chat" ShowLabel="true" Stacked="true" Options="Audiences" Value="_draft.Audience" ValueChanged="value => _draft.Audience = value" />
        }
        else
        {
            <p class="hint">You can start a group chat for the team. Only leaders can start a leaders-only chat, or a chat with attendees or parents.</p>
        }
        @if (_draft.Audience != ChatAudiences.Team)
        {
            <Notice Tone="NoticeTone.Warning"><strong>Parents say yes first.</strong> Your first message goes to each young person's parents. Their child joins the chat once a parent approves. Until then, only the adults are in the chat.</Notice>
        }
        <TextField Label="First message" Hint="Say why you're starting the chat. Parents of any young people in the chat read this before they approve." Multiline="true" Value="@_draft.FirstMessage" ValueChanged="value => _draft.FirstMessage = value"
                   MaxLength="ChatLimits.TextLength" />
        <p class="hint">@ChatCopy.StaffCanCheck A chat with young people needs two adults in the chat who hold a current blue card. The chat shows a warning until it has them.</p>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Start the chat" Busy="_busy" OnSave="StartAsync" Blocked="@Blocked" />
    </Actions>
</Sheet>

@code {
    private StartChat _draft = Fresh();
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required string MinistryId { get; set; }
    [Parameter, EditorRequired] public required string MinistryName { get; set; }
    [Parameter] public bool HasAttendees { get; set; }
    [Parameter] public bool Leads { get; set; } = true;

    private object Shape => (_draft.Name, _draft.Kind, _draft.Audience, _draft.FirstMessage);

    private static readonly IReadOnlyList<SegmentOption<string>> Kinds =
    [
        new(ChatKinds.Group, "Group chat", Detail: "Everyone in the chat can write."),
        new(ChatKinds.Channel, "Leaders only", Detail: "Only the ministry's leaders can write. Everyone else can react."),
    ];

    private IReadOnlyList<SegmentOption<string>> Audiences => HasAttendees
        ?
        [
            new(ChatAudiences.Team, "The team", Detail: "The ministry's leaders and helpers."),
            new(ChatAudiences.Attendees, "Attendees and their parents", Detail: "Young people who attend the ministry, and their parents."),
            new(ChatAudiences.Parents, "Parents only", Detail: "Parents of the young people who attend the ministry."),
        ]
        : [new(ChatAudiences.Team, "The team", Detail: "The ministry's leaders and helpers.")];

    private string? Blocked => _draft.Name.Trim().Length == 0 ? "Enter a name for the chat."
        : _draft.FirstMessage.Trim().Length == 0 ? "Write the first message."
        : null;

    private static StartChat Fresh() => new() { Kind = ChatKinds.Group, Audience = ChatAudiences.Team };

    private async Task StartAsync()
    {
        (_busy, _problem) = (true, null);
        try
        {
            _draft.ChatId = Guid.NewGuid().ToString();
            _draft.MinistryId = MinistryId;
            await Store.StartAsync(_draft);
            _draft = Fresh();
            await OpenChanged.InvokeAsync(false);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
