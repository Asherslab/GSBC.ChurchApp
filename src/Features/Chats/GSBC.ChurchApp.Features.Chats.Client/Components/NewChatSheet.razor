@inject IChats Store

<UnsavedGuard Changed="() => Open" Editing="_draft" State="() => Shape" What="this chat" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@($"New chat in {MinistryName}")">
    <ChildContent>
        <TextField Label="Name" Value="@_draft.Name" ValueChanged="value => _draft.Name = value" MaxLength="ChatLimits.NameLength" Required="true" />
        @if (Leads)
        {
            <Segmented TValue="string" Label="Kind" ShowLabel="true" Stacked="true" Options="Kinds" Value="_draft.Kind" ValueChanged="value => _draft.Kind = value" />
            <Segmented TValue="string" Label="Who it's for" ShowLabel="true" Stacked="true" Options="Audiences" Value="_draft.Audience" ValueChanged="value => _draft.Audience = value" />
        }
        else
        {
            <p class="hint">A group chat for the team. Leaders start channels and chats with attendees or parents.</p>
        }
        @if (_draft.Audience != ChatAudiences.Team)
        {
            <Notice Tone="NoticeTone.Warning"><strong>Parents say yes first.</strong> Your first message goes to each young person's parents. Their child gets the chat once a parent approves; until then it's just the adults.</Notice>
        }
        <TextField Label="First message: why you're starting this chat" Multiline="true" Value="@_draft.FirstMessage" ValueChanged="value => _draft.FirstMessage = value"
                   MaxLength="ChatLimits.TextLength" Placeholder="Parents of any young people in it read this before they say yes." />
        <p class="hint">@ChatCopy.StaffCanCheck A chat with young people needs two adults in it with a current blue card; the chat flags it if not.</p>
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Start the chat" Busy="_busy" OnSave="StartAsync" Blocked="@Blocked" />
    </Actions>
</Sheet>

@code {
    private StartChat _draft = Fresh();
    private bool _busy;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required string MinistryId { get; set; }
    [Parameter, EditorRequired] public required string MinistryName { get; set; }
    [Parameter] public bool HasAttendees { get; set; }
    [Parameter] public bool Leads { get; set; } = true;

    private object Shape => (_draft.Name, _draft.Kind, _draft.Audience, _draft.FirstMessage);

    private static readonly IReadOnlyList<SegmentOption<string>> Kinds =
    [
        new(ChatKinds.Group, "Group chat", Detail: "Everyone in it can write."),
        new(ChatKinds.Channel, "Leaders post only", Detail: "Only the leaders write. Everyone can react."),
    ];

    private IReadOnlyList<SegmentOption<string>> Audiences => HasAttendees
        ?
        [
            new(ChatAudiences.Team, "The team", Detail: "Leaders and helpers."),
            new(ChatAudiences.Attendees, "Attendees and their parents", Detail: "Young people who come along, and their parents."),
            new(ChatAudiences.Parents, "Parents only", Detail: "The parents of those who come along."),
        ]
        : [new(ChatAudiences.Team, "The team", Detail: "Leaders and helpers.")];

    private string? Blocked => _draft.Name.Trim().Length == 0 ? "Give it a name to start it."
        : _draft.FirstMessage.Trim().Length == 0 ? "Write the first message to start it."
        : null;

    private static StartChat Fresh() => new() { Kind = ChatKinds.Group, Audience = ChatAudiences.Team };

    private async Task StartAsync()
    {
        _busy = true;
        try
        {
            _draft.ChatId = Guid.NewGuid().ToString();
            _draft.MinistryId = MinistryId;
            await Store.StartAsync(_draft);
            _draft = Fresh();
            await OpenChanged.InvokeAsync(false);
        }
        finally
        {
            _busy = false;
        }
    }
}
