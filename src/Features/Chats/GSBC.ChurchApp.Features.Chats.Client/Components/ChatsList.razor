@inject IChats Store
@inject TimeProvider Clock

<LiveData TValue="ChatsHome" Load="Store.HomeAsync" Feeds="ChatsStore.Feeds" Remember="@Remembered" ReloadOn="ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox">
    @{ List<ChatSummary> chats = context.Value.Chats.Where(chat => (MinistryId is null || chat.Card.MinistryId == MinistryId) && ChatSearch.Matches(chat.Card, Search)).ToList(); }
    @if (context.Value.Paused)
    {
        <Notice Tone="NoticeTone.Warning"><strong>Your chats are paused for now.</strong> The church is looking into something. Questions: speak to the church office.</Notice>
    }
    @if (chats.Count == 0 && Search.Trim().Length > 0)
    {
        <EmptyState Icon="search" Title="No chats match" Body="@($"Nothing in your chats' names, ministries or people matches \"{Search.Trim()}\".")" />
    }
    else if (chats.Count == 0)
    {
        <EmptyState Icon="message-square" Title="No chats yet" Body="@EmptyBody">@Empty</EmptyState>
    }
    else
    {
        <ListGroup>
            @foreach (ChatSummary chat in chats)
            {
                ChatCard card = chat.Card;
                if (chat.WaitingForYou)
                {
                    <ListRow Title="@($"{card.Name} wants {Names(card.AwaitingYourConsent)}")" Subtitle="@($"{card.MinistryName} · read why and say yes or not now")"
                             Icon="users" IconTone="RowTone.Warm" Unread="true" Chevron="true" Href="@ChatsDestinations.Chat(card.Id)" Current="@(card.Id == Current)" Class="chat-row--waiting" />
                }
                else
                {
                    <ListRow Title="@ChatText.Title(card)" Subtitle="@Subtitle(card)" Icon="@ChatText.Icon(card)" IconTone="ChatText.Tone(card)"
                             Unread="@(chat.Unread > 0 && !card.Muted)" Href="@ChatsDestinations.Chat(card.Id)" Current="@(card.Id == Current)">
                        <TrailingContent>
                            <span class="chat-row__end">
                                <span class="chat-row__time">@ChatText.When(card.LastAt ?? card.CreatedAt, Clock.GetUtcNow().UtcDateTime)</span>
                                @if (chat.Unread > 0 && !card.Muted)
                                {
                                    <span class="chat-row__count">@(chat.Unread > 99 ? "99+" : chat.Unread)</span>
                                }
                                else if (card.Muted)
                                {
                                    <Icon Name="bell-off" Size="IconSize.Small" />
                                }
                            </span>
                        </TrailingContent>
                    </ListRow>
                }
            }
        </ListGroup>
        @if (ShowHint)
        {
            <p class="hint">@Hint</p>
        }
    }
</LiveData>

@code {
    [Parameter] public string? MinistryId { get; set; }
    [Parameter] public RenderFragment? Empty { get; set; }
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public string? Current { get; set; }
    [Parameter] public bool ShowHint { get; set; } = true;

    private string Remembered => MinistryId is null ? ChatsStore.Remembered : $"{ChatsStore.Remembered}.{MinistryId}";

    private string EmptyBody => MinistryId is null
        ? "When a ministry you're in starts a chat, it shows up here."
        : "When the leaders start a chat for you, it shows up here.";

    private string Hint => MinistryId is null
        ? "Chats from every ministry you're in, newest first. Church staff can check messages in chats."
        : "Church staff can check messages in chats.";

    private string Subtitle(ChatCard card)
    {
        string preview = ChatText.Preview(card);
        if (card.YourRole == ChatRoles.ParentReader && card.ForChildren.Count > 0)
            return $"For {ChatText.First(card.ForChildren[0].Name)} · {preview}";
        if (MinistryId is not null)
            return card.Kind == ChatKinds.Channel ? $"Leaders post · {preview}" : $"{ChatText.Audience(card.Audience)} · {preview}";
        return card.MinistryName.Length > 0 && card.Kind != ChatKinds.Ask ? $"{card.MinistryName} · {preview}" : preview;
    }

    private static string Names(IReadOnlyList<PersonRef> people) =>
        people.Count == 1 ? ChatText.First(people[0].Name) : $"{string.Join(", ", people.SkipLast(1).Select(person => ChatText.First(person.Name)))} and {ChatText.First(people[^1].Name)}";
}
