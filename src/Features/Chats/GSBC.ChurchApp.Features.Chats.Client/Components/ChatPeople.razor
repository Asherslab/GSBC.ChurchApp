@inject IChats Store

@if (OnDelete.HasDelegate)
{
    <PaneHead Title="Chat settings" Actions="@(Card.YouMayManage ? ChatActions : null)" />
}
<Section Title="Notifications" Grouped="true" First="true">
    <ToggleRow Title="Mute" Description="No notifications from this chat, unless someone mentions you. It still shows in your chats." Checked="Card.Muted"
               CheckedChanged="muted => Store.MuteAsync(Card, muted)" />
</Section>
<Section Title="Who's in it" Grouped="true">
    <ListGroup>
        @foreach (ChatPerson person in Card.People.OrderBy(Order).ThenBy(person => person.Name))
        {
            <ListRow Title="@(person.Id == Card.You ? $"{person.Name} (you)" : person.Name)" Subtitle="@About(person)">
                <Leading><Avatar Name="@person.Name" Size="32" /></Leading>
            </ListRow>
        }
    </ListGroup>
</Section>
@if (Card.ParentsCanRead)
{
    <p class="hint">Parents of the young people here can read this chat, and can write for their child.</p>
}
<p class="hint">@ChatCopy.StaffCanCheck</p>

@code {
    [Parameter, EditorRequired] public required ChatCard Card { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private IReadOnlyList<MenuItem> ChatActions =>
    [
        this.Item("Delete the chat…", () => OnDelete.InvokeAsync(), "trash-2", "For everyone in it. The church keeps its messages.", danger: true),
    ];

    private static int Order(ChatPerson person) => person.Role switch
    {
        ChatRoles.Leader => 0,
        ChatRoles.Member => 1,
        _ => 2,
    };

    private string About(ChatPerson person)
    {
        List<string> words = [];
        if (person.Role == ChatRoles.Leader)
            words.Add("Leader");
        if (person.Role == ChatRoles.ParentReader)
            words.Add("Parent, can read");
        if (person.ParentOf.Count > 0)
            words.Add($"Parent of {string.Join(" and ", person.ParentOf.Select(child => ChatText.First(Card.People.FirstOrDefault(other => other.Id == child)?.Name ?? "a young person")))}");
        if (person.State == ChatStates.AwaitingConsent)
            words.Add("Waiting for a parent's yes");
        if (Card.YouMayManage && person.BlueCard)
            words.Add("Current blue card");
        return string.Join(" · ", words);
    }
}
