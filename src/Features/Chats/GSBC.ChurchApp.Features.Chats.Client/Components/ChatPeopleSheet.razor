<Sheet Open="Open" OpenChanged="OpenChanged" Title="@ChatText.Title(Card)" Lead="@ChatText.Who(Card)">
    <ChatPeople Card="Card" />
</Sheet>

@code {
    [Parameter, EditorRequired] public required ChatCard Card { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
}
