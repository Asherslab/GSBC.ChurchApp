@using GSBC.ChurchApp.Platform.Client.Media
@using GSBC.ChurchApp.Platform.Contracts.Media
@inject Shell Shell
@inject IServiceProvider Services

@if (Attachments.Count > 0)
{
    <span class="chat-files">
        @foreach (Attachment attachment in Attachments)
        {
            if (Viewable(attachment) is { } media)
            {
                int at = Pictures.IndexOf(media);
                <PictureOpen Label="@($"Open {Noun(media).ToLowerInvariant()} {at + 1} bigger")" OnOpen="() => View(at)" Class="chat-photo-open">
                    <MediaPreview Media="media" Controls="false" Alt="@(attachment.Name.Length > 0 ? attachment.Name : "Photo")" Class="chat-photo" />
                </PictureOpen>
            }
            else
            {
                <Button Variant="ButtonVariant.Quiet" Class="chat-file" Disabled="@(attachment.MediaId.Length == 0)" OnClick="() => OpenAsync(attachment)">
                    <span class="chat-file__tile"><Icon Name="file" /></span>
                    <span><strong>@attachment.Name</strong><span class="chat-file__about">@About(attachment)</span></span>
                </Button>
            }
        }
        @if (_problem is not null)
        {
            <span class="chat-file__problem">@_problem</span>
        }
    </span>
    @if (Pictures.Count > 0)
    {
        <PictureViewer @bind-Open="_viewing" @bind-Index="_viewingAt" Pictures="Pictures" Noun="@Noun(Pictures[Math.Clamp(_viewingAt, 0, Pictures.Count - 1)])" About="@From" />
    }
}

@code {
    private string? _problem;
    private bool _viewing;
    private int _viewingAt;

    [Parameter, EditorRequired] public required IReadOnlyList<Attachment> Attachments { get; set; }
    [Parameter] public string? From { get; set; }

    private List<MediaRef> Pictures => Attachments.Select(Viewable).OfType<MediaRef>().ToList();

    private IPrivateMediaLinks? Links => Services.GetService(typeof(IPrivateMediaLinks)) as IPrivateMediaLinks;

    private static MediaRef? Viewable(Attachment attachment) =>
        attachment.Media is { } media && (media.IsImage || media.IsVideo) ? media : null;

    private static string Noun(MediaRef media) => media.IsVideo ? "Video" : "Photo";

    private void View(int at) => (_viewingAt, _viewing) = (at, true);

    private static string About(Attachment attachment)
    {
        string kind = attachment.Name.Contains('.') ? attachment.Name[(attachment.Name.LastIndexOf('.') + 1)..].ToUpperInvariant() : "File";
        string size = attachment.Bytes switch
        {
            < 1024 => $"{attachment.Bytes} bytes",
            < 1024 * 1024 => $"{attachment.Bytes / 1024} KB",
            _ => $"{attachment.Bytes / (1024.0 * 1024):0.#} MB",
        };
        return $"{kind} · {size}";
    }

    private async Task OpenAsync(Attachment attachment)
    {
        _problem = null;
        string? link;
        try
        {
            link = Links is null ? null : await Links.LinkAsync(attachment.MediaId, "");
        }
        catch (Grpc.Core.RpcException)
        {
            link = null;
        }
        if (link is null)
            _problem = $"{attachment.Name} can't be opened right now. Opening a file needs a connection.";
        else
            await Shell.OpenExternalAsync(link);
    }
}
