@page "/prayer"
@inject PastoralClient Pastoral
@inject UnsavedChanges Unsaved
@inject TimeProvider Clock

<PageTitle>Prayer · Good Shepherd admin</PageTitle>

<LiveData @ref="_live" TValue="Inbox" Feeds="DeskFeeds" Load="LoadAsync" FailedTitle="Can't load prayer requests right now">
    <Workbench AsideLabel="Prayer requests" Class="prayer-desk" Showing="@(_selectedId is null ? WorkbenchPane.Aside : WorkbenchPane.Main)">
        <Aside>
            <h1 class="prayer-desk__title">Prayer</h1>
            <p class="prayer-desk__lead">Requests from the app. Only the pastoral team reads them, and the prayer wall shows only what you share.</p>
            <FilterChips TValue="Tab" Label="Show" Options="Tabs(context.Value)" Value="TabFor(context.Value)" ValueChanged="ChooseTabAsync" />
            <SearchField Label="Find a request" Placeholder="Words or a name" Value="@_query" ValueChanged="SearchAsync" />
            @if (Shown(context.Value) is { Count: > 0 } shown)
            {
                <div class="prayer-desk__list" role="listbox" aria-label="Prayer requests">
                    @foreach (InboxLine line in shown)
                    {
                        <button type="button" role="option" aria-selected="@(line.Id == _selectedId)" class="prayer-pick @(line.Id == _selectedId ? "is-selected" : "")"
                                @onclick="() => SelectAsync(line.Id)">
                            <strong>@PrayerWords.Excerpt(line.Text, 70)</strong>
                            <span>@line.From · @ChurchDates.Ago(line.SentAt, Now)</span>
                            <span class="prayer-pick__pills">
                                @if (line.Care == CareState.New && context.Value.MayRead)
                                {
                                    <Pill>New</Pill>
                                }
                                @if (line.Wall == WallState.Waiting)
                                {
                                    <Pill Tone="PillTone.Accent">Asks for the wall</Pill>
                                }
                                @if (line.Minor)
                                {
                                    <Pill Tone="PillTone.Marker">Under 18</Pill>
                                }
                                @if (line.WantsContact)
                                {
                                    <Pill Tone="PillTone.Quiet">Get in touch</Pill>
                                }
                            </span>
                        </button>
                    }
                </div>
            }
            else
            {
                <EmptyState Icon="@(_query.Length > 0 ? "search" : "check")" Title="@EmptyTitle(context.Value)" Body="@EmptyBody(context.Value)" />
            }
        </Aside>
        <ChildContent>
            @if (_selectedId is { } id)
            {
                <PastoralRequest @key="id" Id="@id" OnGone="() => _selectedId = null" />
            }
            else
            {
                <EmptyState Icon="prayer" Title="Choose a request" Body="Its words, the notes the pastoral team keeps, and what the prayer wall shows open here." />
            }
        </ChildContent>
    </Workbench>
</LiveData>

@code {
    private enum Tab
    {
        New,
        ForTheWall,
        OnTheWall,
        FollowedUp,
        Answered,
        Everything,
    }

    private static readonly IReadOnlyList<string> DeskFeeds = [PrayerFeeds.Inbox];

    private LiveData<Inbox>? _live;
    private Tab? _tab;
    private string _query = "";
    private string? _selectedId;

    [SupplyParameterFromQuery(Name = "request")] public string? RequestId { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    protected override void OnParametersSet() => _selectedId ??= RequestId;

    private Task<Inbox> LoadAsync() => Pastoral.InboxAsync(_query);

    private Tab TabFor(Inbox inbox) => _tab ?? (inbox.MayRead ? Tab.New : Tab.ForTheWall);

    private static IReadOnlyList<FilterOption<Tab>> Tabs(Inbox inbox)
    {
        List<FilterOption<Tab>> tabs = [];
        if (inbox.MayRead)
            tabs.Add(new(Tab.New, "New", Count(inbox, Tab.New)));
        tabs.Add(new(Tab.ForTheWall, "For the wall", Count(inbox, Tab.ForTheWall)));
        tabs.Add(new(Tab.OnTheWall, "On the wall"));
        if (inbox.MayRead)
        {
            tabs.Add(new(Tab.FollowedUp, "Followed up"));
            tabs.Add(new(Tab.Answered, "Answered"));
        }
        tabs.Add(new(Tab.Everything, "Everything"));
        return tabs;
    }

    private static int? Count(Inbox inbox, Tab tab) => inbox.Requests.Count(line => In(line, tab)) is > 0 and var count ? count : null;

    private static bool In(InboxLine line, Tab tab) => tab switch
    {
        Tab.New => line.Care == CareState.New,
        Tab.ForTheWall => line.Wall == WallState.Waiting,
        Tab.OnTheWall => line.Wall == WallState.Shown,
        Tab.FollowedUp => line.Care == CareState.FollowedUp,
        Tab.Answered => line.Care == CareState.Answered,
        _ => true,
    };

    private List<InboxLine> Shown(Inbox inbox) => inbox.Requests.Where(line => In(line, TabFor(inbox))).ToList();

    private string EmptyTitle(Inbox inbox) => _query.Length > 0 ? "Nothing matches" : TabFor(inbox) switch
    {
        Tab.New => "Nothing new",
        Tab.ForTheWall => "Nothing waiting for the wall",
        Tab.OnTheWall => "Nothing on the wall",
        _ => "No requests here",
    };

    private string EmptyBody(Inbox inbox) => _query.Length > 0
        ? "Try other words, or look under Everything."
        : TabFor(inbox) == Tab.New ? "Every request has been read and followed up. New ones appear here as they arrive." : "Requests appear here as they arrive.";

    private async Task ChooseTabAsync(Tab tab)
    {
        if (!await Unsaved.MayLeaveAsync())
            return;
        _tab = tab;
    }

    private async Task SelectAsync(string id)
    {
        if (id == _selectedId || !await Unsaved.MayLeaveAsync())
            return;
        _selectedId = id;
    }

    private async Task SearchAsync(string query)
    {
        _query = query.Trim();
        if (_live is not null)
            await _live.ReloadAsync();
    }
}
