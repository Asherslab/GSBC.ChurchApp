@inject PastoralClient Pastoral
@inject TimeProvider Clock

<UnsavedGuard Changed="() => _note.Trim().Length > 0" What="your note" />

<LiveData @ref="_live" TValue="RequestDetails" Load="LoadAsync" Feeds="Feeds" FailedTitle="Can't open this request right now">
    @{ RequestDetails request = context.Value; InboxLine line = request.Line; }
    <PaneHead Title="@From(request)" Lead="@($"Sent {ChurchDates.Describe(line.SentAt, DateLineStyle.Short, withTime: true, Now)}")"
              Actions="@(request.MayRead ? Actions : null)" OnClose="OnClose" />
    <div class="prayer-request">
        <div class="prayer-request__main">
            @if (line.Minor)
            {
                <p><Pill Tone="PillTone.Marker">Under 18</Pill></p>
            }
            <p class="prayer-request__text">@line.Text</p>
            @if (line.Minor)
            {
                <Notice Tone="NoticeTone.Warning" Text="They're under 18. Take extra care with what's shared, and follow the church's child safety policy if anything in it worries you." />
            }
            @if (request.MayRead)
            {
                <CareSteps Care="line.Care" AnsweredNote="@request.AnsweredNote" Busy="@(_busy == "care")" Move="CareAsync" />
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        </div>

        @if (line.Wall != WallState.NotAsked)
        {
            <WallChoice Case="WallCaseOf(request)" Show="ShowAsync" OnKeepPrivate="KeepPrivateAsync" Busy="_wallBusy" />
        }

        @if (request.MayRead)
        {
            <Section Grouped="true" Title="Getting in touch" Lead="@(line.WantsContact ? "They'd like someone to get in touch." : null)">
                <ChildContent>
                    @if (request.Contact.Length > 0)
                    {
                        <p class="prayer-request__fact">@request.Contact</p>
                    }
                    @if (request.PersonId.Length > 0)
                    {
                        <p class="prayer-request__fact"><a class="text-link" href="people/@request.PersonId">@line.From in People</a></p>
                    }
                    else if (request.Contact.Length == 0)
                    {
                        <p class="prayer-request__fact">They didn't sign in or leave a way to reach them.</p>
                    }
                </ChildContent>
            </Section>
            <Section Grouped="true" Title="Notes for the pastoral team" Lead="Only people who can read prayer requests see these. The person never does.">
                <ChildContent>
                    @foreach (CareNote note in request.Notes)
                    {
                        <div class="prayer-note" @key="note.Id">
                            <div class="prayer-note__body">
                                <p>@note.Text</p>
                                <span>@note.Author · @ChurchDates.Ago(note.At, Now)</span>
                            </div>
                            <Menu Label="More for this note" Small="true" Items="NoteActions(note.Id)" />
                        </div>
                    }
                    <TextField Label="Add a note" Multiline="true" MaxLength="2000" @bind-Value="_note" />
                </ChildContent>
                <Foot>
                    <SaveBar Label="Add the note" New="true" Busy="@(_busy == "note")" Blocked="@(_note.Trim().Length == 0 ? "Write the note to add it." : null)" OnSave="AddNoteAsync" />
                </Foot>
            </Section>
            <Section Grouped="true" Title="What's happened">
                <ol class="prayer-steps">
                    @foreach (CareStep step in request.History)
                    {
                        <li><strong>@step.What</strong> <span>@step.Who · @ChurchDates.Ago(step.At, Now)</span></li>
                    }
                </ol>
            </Section>
        }
    </div>
</LiveData>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="Delete this prayer request?" Lead="It goes from the pastoral team, the prayer wall and the person's phone, with its notes. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="@(_busy == "delete")" OnClick="DeleteAsync">Delete it</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

<Sheet Open="_deletingNote is not null" OpenChanged="open => _deletingNote = open ? _deletingNote : null" Title="Delete this note?" Lead="Nobody on the pastoral team will see it again. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="@(_busy == "note")" OnClick="DeleteNoteAsync">Delete the note</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deletingNote = null">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private static readonly IReadOnlyList<string> Feeds = [PrayerFeeds.Inbox];

    [Parameter, EditorRequired] public required string Id { get; set; }
    [Parameter] public EventCallback OnGone { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private LiveData<RequestDetails>? _live;
    private string _note = "";
    private bool _deleting;
    private string? _deletingNote;
    private string? _busy;
    private WallAction? _wallBusy;
    private string? _problem;

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private IReadOnlyList<MenuItem> Actions =>
        [this.Item("Delete this request…", () => { _deleting = true; }, "trash-2", "From the pastoral team, the prayer wall and their phone", danger: true)];

    private IReadOnlyList<MenuItem> NoteActions(string noteId) =>
        [this.Item("Delete this note…", () => { _deletingNote = noteId; }, "trash-2", danger: true)];

    private static string From(RequestDetails request) => request.SignedIn
        ? request.Line.From
        : request.Line.From == PrayerWords.NoName ? "Not signed in, no name given" : $"{request.Line.From}, not signed in";

    private static WallCase WallCaseOf(RequestDetails request) => new()
    {
        Id = request.Line.Id,
        Text = request.Line.Text,
        SentAt = request.Line.SentAt,
        Wall = request.Line.Wall,
        Minor = request.Line.Minor,
        ShortName = request.ShowName ? request.ShortName : "",
        WallText = request.WallText,
        WallShowsName = request.WallName.Length > 0,
        WallUntil = request.WallUntil,
        Prayed = request.Prayed,
        ChangedAt = request.Line.ChangedAt,
    };

    private Task<RequestDetails> LoadAsync() => Pastoral.RequestAsync(Id);

    private Task CareAsync(CareState care, string answeredNote) => DoAsync("care", () => Pastoral.CareAsync(Id, care, answeredNote));

    private Task AddNoteAsync() => DoAsync("note", async () =>
    {
        await Pastoral.AddNoteAsync(Id, _note);
        _note = "";
    });

    private Task DeleteNoteAsync() => DoAsync("note", async () =>
    {
        if (_deletingNote is { } noteId)
            await Pastoral.DeleteNoteAsync(Id, noteId);
        _deletingNote = null;
    });

    private async Task<bool> ShowAsync(WallSave save)
    {
        _wallBusy = WallAction.Show;
        try
        {
            return await DoAsync("wall", () => Pastoral.ShowOnWallAsync(Id, save.Text, save.ShowName, save.Until));
        }
        finally
        {
            _wallBusy = null;
        }
    }

    private async Task KeepPrivateAsync()
    {
        _wallBusy = WallAction.KeepPrivate;
        try
        {
            await DoAsync("private", () => Pastoral.KeepPrivateAsync(Id));
        }
        finally
        {
            _wallBusy = null;
        }
    }

    private Task DeleteAsync() => DoAsync("delete", async () =>
    {
        await Pastoral.DeleteAsync(Id);
        (_deleting, _note) = (false, "");
        await OnGone.InvokeAsync();
    });

    private async Task<bool> DoAsync(string what, Func<Task> work)
    {
        (_busy, _problem) = (what, null);
        try
        {
            await work();
            if (_live is not null && what != "delete")
                await _live.ReloadAsync();
            return true;
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
            return false;
        }
        finally
        {
            _busy = null;
        }
    }
}
