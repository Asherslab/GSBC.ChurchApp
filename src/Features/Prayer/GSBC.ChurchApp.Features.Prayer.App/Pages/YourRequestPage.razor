@page "/prayer/yours/{Id}"
@inject PrayerOnPhone Prayer
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => _asking == Ask.Close && _message.Trim().Length > 0" What="your message" />

<Page Title="Your request" BackHref="prayer" BackLabel="Prayer" TopBar="TopBarStyle.Solid">
    <LiveData TValue="PrayerView" Load="Prayer.LoadAsync" Feeds="PrayerOnPhone.Feeds" ReloadOn="Reload" Remember="prayer.view">
        @if (context.Value.Find(Id) is not { } line)
        {
            <Section First="true">
                <EmptyState Icon="prayer" Title="This request isn't here any more" Body="It may have been deleted. Requests are removed a year after they're sent.">
                    <Button Variant="ButtonVariant.Quiet" Href="prayer">Back to Prayer</Button>
                </EmptyState>
            </Section>
        }
        else
        {
            <div class="prayer-band">
                <div class="prayer-band__head">
                    <p class="prayer-band__meta">
                        <span>@(line.Sending == Sending.Sent ? "Sent" : "Written") @PrayerWords.Day(line.SentAt)</span>
                        @if (line.Wall == WallState.Shown)
                        {
                            <span>Shown as @(line.WallName.Length > 0 ? line.WallName : PrayerWords.NoName.ToLowerInvariant())</span>
                        }
                    </p>
                    <Menu Label="More for your request" Small="true" Items="Actions(line)" />
                </div>
                @if (line.Sending == Sending.Sent)
                {
                    <StagePipeline TValue="YourStage" Label="Where your request is" Stages="Stages(line)" Value="Stage(line)" ReadOnly="true" />
                    <p class="prayer-band__state">@PrayerWords.Where(line)</p>
                }
                else
                {
                    <SaveStatus State="@(line.Sending == Sending.CouldNotSend ? SaveState.Failed : SaveState.Waiting)" WaitingText="@PrayerWords.Status(line)"
                                FailedText="Couldn't send" Detail="@line.Problem" Retry="() => Prayer.RetryAsync(line.Id)" />
                }
            </div>
            <Section First="true">
                <p class="prayer-request__text">@line.Text</p>
                @if (line is { Answered: true, AnsweredNote.Length: > 0 })
                {
                    <Card Class="prayer-yours__note" Title="The pastoral team marked it answered"><p>@line.AnsweredNote</p></Card>
                }
                @if (line.Message.Length > 0)
                {
                    <Card Class="prayer-yours__note" Title="Your message"><p>@line.Message</p></Card>
                }
            </Section>
            @if (line.MayClose)
            {
                <Section>
                    @if (line.Wall == WallState.Shown)
                    {
                        <Button Block="true" Icon="eye-off" OnClick="() => Open(Ask.Close, line)">Take down your request</Button>
                        <p class="prayer-request__fact prayer-yours__hint">Answered or not, you can take it down whenever you like, and leave a message for everyone who prayed.</p>
                    }
                    else
                    {
                        <Button Block="true" Icon="check" OnClick="() => Open(Ask.Close, line)">Close your request</Button>
                        <p class="prayer-request__fact prayer-yours__hint">Answered or not, let the pastoral team know you no longer need prayer for it.</p>
                    }
                </Section>
            }
        }
    </LiveData>
</Page>

@if (_closing is { } closing)
{
    <Sheet Open="_asking == Ask.Close" OpenChanged="Closed" Title="@CloseTitle(closing)" Lead="@CloseLead(closing)">
        <ChildContent>
            <TextField Label="@(closing.Wall == WallState.Shown ? "A message for everyone who prayed" : "A message for the pastoral team")"
                       Hint="Optional. A thank you, how it was answered, or how things are now." Multiline="true" MaxLength="500" @bind-Value="_message" />
        </ChildContent>
        <Actions>
            <SaveBar Block="true" Label="@CloseLabel(closing)" Busy="_busy" OnSave="CloseAsync" />
        </Actions>
    </Sheet>
}

<Sheet Open="_asking == Ask.TakeDown" OpenChanged="Closed" Title="Take your request off the prayer wall?" Lead="The pastoral team keeps your request. Once it's off the wall, it can't go back on.">
    <Actions>
        <Button Block="true" Busy="_busy" OnClick="TakeDownAsync">Take the request off the wall</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => Closed(false)">Keep it on the wall</Button>
    </Actions>
</Sheet>

<Sheet Open="_asking == Ask.Delete" OpenChanged="Closed" Title="Delete this request?" Lead="Your request is deleted for the pastoral team and taken off the prayer wall. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete the request</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => Closed(false)">Keep the request</Button>
    </Actions>
</Sheet>

@code {
    private enum Ask
    {
        Nothing,
        Close,
        TakeDown,
        Delete,
    }

    private enum YourStage
    {
        Sent,
        Wall,
        Done,
    }

    private const ChangeKind Reload = ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox;

    [Parameter] public string Id { get; set; } = "";

    private Ask _asking;
    private string _message = "";
    private YourLine? _closing;
    private bool _busy;

    private static IReadOnlyList<SegmentOption<YourStage>> Stages(YourLine line) => line.AskedForWall
        ? [new(YourStage.Sent, "Sent"), new(YourStage.Wall, line.Wall is WallState.Ended or WallState.TakenDown ? "Was on the wall" : "On the wall"), Done(line)]
        : [new(YourStage.Sent, "Sent"), Done(line)];

    private static SegmentOption<YourStage> Done(YourLine line) => new(YourStage.Done, line.Answered ? "Answered" : "Closed");

    private static string CloseTitle(YourLine line) => line.Wall == WallState.Shown ? "Take down your request" : "Close your request";

    private static string CloseLead(YourLine line) => line.Wall switch
    {
        WallState.Shown => "Leave a message and the wall shows it under your request for 3 days, then it comes down. Without one, it comes down now.",
        WallState.Waiting => "It won't go on the prayer wall. The pastoral team sees that you closed it, and any message you leave.",
        _ => "The pastoral team sees that you closed it, and any message you leave.",
    };

    private string CloseLabel(YourLine line) => line.Wall != WallState.Shown ? "Close the request"
        : _message.Trim().Length > 0 ? "Take down in 3 days" : "Take down now";

    private static YourStage Stage(YourLine line) => line.Answered || line.Closed ? YourStage.Done
        : line.Wall is WallState.Shown or WallState.Ended ? YourStage.Wall
        : YourStage.Sent;

    private IReadOnlyList<MenuItem> Actions(YourLine line)
    {
        List<MenuItem> items = [];
        if (line.Wall == WallState.Waiting && line.Sending != Sending.CouldNotSend)
            items.Add(this.Item("Take your request off the prayer wall…", () => Open(Ask.TakeDown), "eye-off", "The pastoral team keeps your request."));
        items.Add(this.Item("Delete the request…", () => Open(Ask.Delete), "trash-2", "Deletes it for the pastoral team and takes it off the prayer wall.", danger: true, startsGroup: items.Count > 0));
        return items;
    }

    private void Open(Ask ask, YourLine? closing = null) => (_asking, _message, _closing) = (ask, "", closing);

    private void Closed(bool open)
    {
        if (!open)
            _asking = Ask.Nothing;
    }

    private Task CloseAsync() => DoAsync(() => Prayer.CloseAsync(Id, _message));

    private Task TakeDownAsync() => DoAsync(() => Prayer.TakeDownAsync(Id));

    private async Task DeleteAsync()
    {
        await DoAsync(() => Prayer.DeleteAsync(Id));
        Navigation.NavigateTo("prayer");
    }

    private async Task DoAsync(Func<Task> work)
    {
        _busy = true;
        try
        {
            await work();
            _asking = Ask.Nothing;
        }
        finally
        {
            _busy = false;
        }
    }
}
