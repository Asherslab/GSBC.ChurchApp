@page "/prayer/yours/{Id}"
@inject PrayerOnPhone Prayer
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => _asking == Ask.Answered && _note.Trim().Length > 0" What="your words of thanks" />

<Page Title="Your request" BackHref="prayer" BackLabel="Prayer" TopBar="TopBarStyle.Solid">
    <LiveData TValue="PrayerView" Load="Prayer.LoadAsync" Feeds="PrayerOnPhone.Feeds" ReloadOn="Reload" Remember="prayer.view">
        @if (context.Value.Find(Id) is not { } line)
        {
            <Section First="true">
                <EmptyState Icon="prayer" Title="This request isn't here any more" Body="It may have been deleted, or kept a year and then removed.">
                    <Button Variant="ButtonVariant.Quiet" Href="prayer">Back to Prayer</Button>
                </EmptyState>
            </Section>
        }
        else
        {
            <div class="prayer-band">
                <div class="prayer-band__head">
                    <p class="prayer-band__meta">
                        <span>@(line.Sending == Sending.Sent ? "Sent" : "Written") @PrayerWords.Day(line.SentAt)</span>
                        @if (line.Wall == WallState.Shown)
                        {
                            <span>Shown as @(line.WallName.Length > 0 ? line.WallName : PrayerWords.NoName.ToLowerInvariant())</span>
                        }
                    </p>
                    <Menu Label="More for your request" Small="true" Items="Actions(line)" />
                </div>
                @if (line.Sending == Sending.Sent)
                {
                    <StagePipeline TValue="YourStage" Label="Where your request is" Stages="Stages(line)" Value="Stage(line)" ReadOnly="true" />
                    <p class="prayer-band__state">@PrayerWords.Where(line)</p>
                }
                else
                {
                    <SaveStatus State="@(line.Sending == Sending.CouldNotSend ? SaveState.Failed : SaveState.Waiting)" WaitingText="@PrayerWords.Status(line)"
                                FailedText="Couldn't send" Detail="@line.Problem" Retry="() => Prayer.RetryAsync(line.Id)" />
                }
            </div>
            <Section First="true">
                <p class="prayer-request__text">@line.Text</p>
                @if (line.Answered && line.AnsweredNote.Length > 0)
                {
                    <Card Class="prayer-yours__answered" Title="Answered"><p>@line.AnsweredNote</p></Card>
                }
            </Section>
            @if (!line.Answered && line.Sending != Sending.CouldNotSend)
            {
                <Section>
                    <Button Block="true" Icon="check" OnClick="() => Open(Ask.Answered)">It was answered</Button>
                    <p class="prayer-request__fact prayer-yours__hint">@(line.Wall == WallState.Shown ? "Add a few words of thanks for the prayer wall." : "Let the pastoral team know.")</p>
                </Section>
            }
        }
    </LiveData>
</Page>

<Sheet Open="_asking == Ask.Answered" OpenChanged="Closed" Title="It was answered" Lead="Praise God. Anything you'd like to say? The prayer wall shows it under your request.">
    <ChildContent>
        <TextField Label="Words of thanks" Hint="Optional" Multiline="true" MaxLength="500" @bind-Value="_note" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Mark it answered" Busy="_busy" OnSave="AnsweredAsync" />
    </Actions>
</Sheet>

<Sheet Open="_asking == Ask.TakeDown" OpenChanged="Closed" Title="Take it off the prayer wall?" Lead="It stays with the pastoral team. It can't go back on the wall.">
    <Actions>
        <Button Block="true" Busy="_busy" OnClick="TakeDownAsync">Take it off the wall</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => Closed(false)">Keep it up</Button>
    </Actions>
</Sheet>

<Sheet Open="_asking == Ask.Delete" OpenChanged="Closed" Title="Delete this request?" Lead="The pastoral team won't have it any more, and it comes off the prayer wall. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete it</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => Closed(false)">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private enum Ask
    {
        Nothing,
        Answered,
        TakeDown,
        Delete,
    }

    private enum YourStage
    {
        Sent,
        Wall,
        Answered,
    }

    private const ChangeKind Reload = ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox;

    [Parameter] public string Id { get; set; } = "";

    private Ask _asking;
    private string _note = "";
    private bool _busy;

    private static IReadOnlyList<SegmentOption<YourStage>> Stages(YourLine line) => line.AskedForWall
        ? [new(YourStage.Sent, "Sent"), new(YourStage.Wall, line.Wall is WallState.Ended or WallState.TakenDown ? "Was on the wall" : "On the wall"), new(YourStage.Answered, "Answered")]
        : [new(YourStage.Sent, "Sent"), new(YourStage.Answered, "Answered")];

    private static YourStage Stage(YourLine line) => line.Answered ? YourStage.Answered
        : line.Wall is WallState.Shown or WallState.Ended ? YourStage.Wall
        : YourStage.Sent;

    private IReadOnlyList<MenuItem> Actions(YourLine line)
    {
        List<MenuItem> items = [];
        if (line.Wall is WallState.Shown or WallState.Waiting && line.Sending != Sending.CouldNotSend)
            items.Add(this.Item("Take it off the prayer wall…", () => Open(Ask.TakeDown), "eye-off", "The pastoral team still has it"));
        items.Add(this.Item("Delete it…", () => Open(Ask.Delete), "trash-2", "From the pastoral team and the prayer wall", danger: true, startsGroup: items.Count > 0));
        return items;
    }

    private void Open(Ask ask) => (_asking, _note) = (ask, "");

    private void Closed(bool open)
    {
        if (!open)
            _asking = Ask.Nothing;
    }

    private Task AnsweredAsync() => DoAsync(() => Prayer.AnsweredAsync(Id, _note));

    private Task TakeDownAsync() => DoAsync(() => Prayer.TakeDownAsync(Id));

    private async Task DeleteAsync()
    {
        await DoAsync(() => Prayer.DeleteAsync(Id));
        Navigation.NavigateTo("prayer");
    }

    private async Task DoAsync(Func<Task> work)
    {
        _busy = true;
        try
        {
            await work();
            _asking = Ask.Nothing;
        }
        finally
        {
            _busy = false;
        }
    }
}
