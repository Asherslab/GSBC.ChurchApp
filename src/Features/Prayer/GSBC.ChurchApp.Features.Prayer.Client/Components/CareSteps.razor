<div class="prayer-care">
    <StagePipeline TValue="CareState" Label="Pastoral care" Stages="Stages" Value="Care" Disabled="Busy" ValueChanged="MoveAsync" />
    @if (Message.Length > 0)
    {
        <p class="prayer-care__message"><strong>Their message:</strong> @Message</p>
    }
    @if (Care == CareState.Answered && AnsweredNote.Length > 0)
    {
        <p class="prayer-care__answered">Answered: @AnsweredNote</p>
    }
</div>

<UnsavedGuard Changed="() => _answering && _note.Trim().Length > 0" What="the words for the wall" />

<Sheet Open="_answering" OpenChanged="open => _answering = open" Title="Mark as answered"
       Lead="Add a few words if you like. If the request is on the prayer wall, they show under it. The person who asked is told it was answered.">
    <ChildContent>
        <TextField Label="Words for the wall" Hint="Optional. Shown under the request on the prayer wall." Multiline="true" MaxLength="500" @bind-Value="_note" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Mark as answered" Busy="Busy" OnSave="AnsweredAsync" OnCancel="() => _answering = false" New="true" />
    </Actions>
</Sheet>

@code {
    private IReadOnlyList<SegmentOption<CareState>> Stages => Care == CareState.Closed
        ? [Stage(CareState.New), Stage(CareState.Closed), Stage(CareState.Answered)]
        : [Stage(CareState.New), Stage(CareState.Answered)];

    [Parameter, EditorRequired] public required CareState Care { get; set; }
    [Parameter, EditorRequired] public required Func<CareState, string, Task> Move { get; set; }
    [Parameter] public string AnsweredNote { get; set; } = "";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public bool Busy { get; set; }

    private bool _answering;
    private string _note = "";

    private static SegmentOption<CareState> Stage(CareState care) => new(care, PrayerWords.Care(care));

    private Task MoveAsync(CareState care)
    {
        if (care == CareState.Closed)
            return Task.CompletedTask;
        if (care != CareState.Answered)
            return Move(care, "");
        (_answering, _note) = (true, "");
        return Task.CompletedTask;
    }

    private async Task AnsweredAsync()
    {
        await Move(CareState.Answered, _note);
        (_answering, _note) = (false, "");
    }
}
