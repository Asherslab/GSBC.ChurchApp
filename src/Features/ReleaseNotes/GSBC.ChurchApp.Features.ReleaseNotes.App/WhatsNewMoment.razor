@using GSBC.ChurchApp.Platform.Client.Native
@implements IDisposable
@inject WhatsNew WhatsNew
@inject NativeBridge Bridge
@inject NavigationManager Navigation

@if (WhatsNew.Showing is { Count: > 0 } highlights)
{
    <PagedSheet Open="true" OpenChanged="Closed" Count="highlights.Count" ItemName="Highlight" Label="What's new">
        <Cover Context="page">
            <SheetHeading Icon="@(highlights[page].Icon ?? "sparkles")" Title="@highlights[page].Title" Note="@ReleaseNoteLabels.NewIn(highlights[page], WhatsNew.ForStaff, Bridge.AppVersion)" />
        </Cover>
        <Page Context="page">
            @if (highlights[page].ImageUrl is { } image)
            {
                <img class="highlight__image" src="@image" alt="" />
            }
            <p class="sheet__summary">@highlights[page].Summary</p>
            @if (highlights[page].Where is not null)
            {
                <FactList>
                    <Fact Label="Where to find it" Text="@highlights[page].Where" Icon="map-pin" />
                </FactList>
            }
        </Page>
        <Action Context="page">
            @if (highlights[page].Link is { } link)
            {
                <Button Block="true" OnClick="() => ShowMe(link)">Show me</Button>
            }
        </Action>
    </PagedSheet>
}

@code {
    protected override void OnInitialized() => WhatsNew.Changed += OnChanged;

    private void Closed(bool open) => WhatsNew.Dismiss();

    private void ShowMe(string link)
    {
        WhatsNew.Dismiss();
        Navigation.NavigateTo(link);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => WhatsNew.Changed -= OnChanged;
}
