<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <GsbcReleaseNotes Condition="'$(GsbcReleaseNotes)' == '' and '$(Configuration)' == 'Release'">everyone</GsbcReleaseNotes>
    <GsbcReleaseNotes Condition="'$(GsbcReleaseNotes)' == ''">staff</GsbcReleaseNotes>
    <GsbcChangelog>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..', 'changelog'))</GsbcChangelog>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GsbcReleaseNotes" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GsbcReleaseNote" />
    <AdditionalFiles Include="$(GsbcChangelog)*/*.md" GsbcReleaseNote="note" />
    <AdditionalFiles Include="$(GsbcChangelog)images/*" GsbcReleaseNote="image" />
    <Content Include="$(GsbcChangelog)images/*" Link="wwwroot/release-notes/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GSBC.ChurchApp.Features.ReleaseNotes.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\GSBC.ChurchApp.Platform.Ui\GSBC.ChurchApp.Platform.Ui.csproj" />
    <ProjectReference Include="..\GSBC.ChurchApp.Features.ReleaseNotes.Generator\GSBC.ChurchApp.Features.ReleaseNotes.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
