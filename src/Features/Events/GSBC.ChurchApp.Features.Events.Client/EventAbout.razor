@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Ui.Content

<div class="field">
    <span class="field__label" aria-hidden="true">@Label</span>
    <RichTextField @ref="_field" Content="@(Text ?? new RichText())" ContentChanged="text => TextChanged.InvokeAsync(text.IsEmpty ? null : text)" Label="@Label"
                   Headings="true" Allowed="Allowed" Placeholder="@Placeholder" />
    @foreach (string problem in Text is null ? [] : RichTextRules.ProblemsWith(Text, allowed: Allowed))
    {
        <small class="message">@problem</small>
    }
</div>

@code {
    public const RichTextMedia Allowed = RichTextMedia.Posts;

    private RichTextField? _field;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public RichText? Text { get; set; }
    [Parameter] public EventCallback<RichText?> TextChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";

    public IReadOnlyList<MediaRef> WaitingFiles() => _field?.WaitingFiles() ?? [];
}
