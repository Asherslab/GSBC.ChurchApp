
<Masthead Title="What's next" Note="@(Digest.Header is null ? null : Digest.Range)">
    @if (Digest.Header is not null && Shown.Count > 0)
    {
        <p class="whats-next__lead">@(AsSent ? Digest.SentLead : Digest.Lead(Today))</p>
    }
</Masthead>

@if (Shown.Count == 0)
{
    <EmptyState Icon="megaphone" Title="Nothing in What's next yet" Body="When the church office sends What's next, it shows here. Everything that's on is in the calendar.">
        <Button Variant="ButtonVariant.Quiet" Href="@(Preview ? null : EventsPlaces.Week)">Open the calendar</Button>
    </EmptyState>
}
else
{
    <Section First="true">
        <div class="whats-next__items">
            @foreach (DigestShownItem item in Shown)
            {
                <WhatsNextCard Item="item" When="@WhenOf(item)" Preview="Preview" HasEvent="HasEvent" OnAdd="OnAdd" OnRegister="OnRegister" OnPick="OnPick" />
            }
        </div>
    </Section>
}

@if (!Preview && Digest.Before.Count > 0)
{
    <Section Title="Earlier editions">
        <ListGroup>
            @foreach (EarlierDigest earlier in Digest.Before)
            {
                <ListRow Title="@earlier.Range" Subtitle="@(earlier.Count == 1 ? "1 thing" : $"{earlier.Count} things")" Href="@EventsPlaces.SentDigest(earlier.Start)" />
            }
        </ListGroup>
    </Section>
}

@code {
    [Parameter, EditorRequired] public required WhatsNextDigest Digest { get; set; }
    [Parameter, EditorRequired] public required DateOnly Today { get; set; }
    [Parameter] public Func<DigestShownItem, bool>? HasEvent { get; set; }
    [Parameter] public EventCallback<DigestShownItem> OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnRegister { get; set; }
    [Parameter] public bool Preview { get; set; }
    [Parameter] public bool AsSent { get; set; }
    [Parameter] public EventCallback<DigestShownItem> OnPick { get; set; }

    private IReadOnlyList<DigestShownItem> Shown => AsSent ? Digest.Items : Digest.Coming(Today);

    private string WhenOf(DigestShownItem item) => AsSent ? WhatsNextDigest.WhenAsSent(item) : WhatsNextDigest.WhenLine(item.Words);
}
