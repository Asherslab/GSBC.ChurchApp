@using GSBC.ChurchApp.Platform.Contracts.Locations
@using GSBC.ChurchApp.Platform.Ui.Locations

<LocationField Label="Place" Value="EventPlaces.LocationOf(Place)" ValueChanged="ChangeAsync" Optional="true" Recent="Recent"
               Description="Where it happens. Tapping it in the app shows the map and directions."
               Problem="@(Missing && Place is null ? "Each date needs a place." : null)" />

@code {
    [Parameter] public EventPlace? Place { get; set; }
    [Parameter] public EventCallback<EventPlace?> PlaceChanged { get; set; }
    [Parameter] public IReadOnlyList<EventPlace> Used { get; set; } = [];
    [Parameter] public bool Missing { get; set; }

    private IReadOnlyList<Location> Recent => [.. Used.Select(EventPlaces.LocationOf).OfType<Location>()];

    private Task ChangeAsync(Location? location) => PlaceChanged.InvokeAsync(EventPlaces.From(location));
}
