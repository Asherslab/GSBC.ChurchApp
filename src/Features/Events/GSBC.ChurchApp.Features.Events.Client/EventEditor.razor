@using GSBC.ChurchApp.Platform.Contracts.Media
@inject IEventEditing Editing
@inject TimeProvider Clock
@inject Shell Shell
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="this event" Save="SaveBeforeLeavingAsync" />
<RefreshOn Feeds="Editing.Feeds" On="ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox" Changed="_ => RefreshAsync()" />

@if (InPanel)
{
    <div class="event-panel"><EditScope Edited="() => { }">@Body</EditScope></div>
}
else
{
    <Page Title="@(Target.IsNew ? "New event" : "Editing")" OnBack="LeaveAsync" BackLabel="Cancel" TopBar="TopBarStyle.Solid">
        <ChildContent><EditScope Edited="() => { }">@Body</EditScope></ChildContent>
    </Page>
}

<TellPeopleSheet Open="_sheet == EditorSheet.Tell" CalendarId="@(_draft?.CalendarId ?? "")" CalendarName="@CalendarName" OccurrenceId="@_savedOccurrenceId"
                 Title="@_tellTitle" Body="@_tellBody" Done="done => FinishAsync(done)" />

<Sheet Open="_sheet == EditorSheet.Delete" OpenChanged="SheetToggled" Title="@DeleteTitle" Lead="It comes off every phone and calendar app. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_saving" OnClick="DeleteAsync">Delete it</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="CloseSheet">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private enum EditorSheet { None, Tell, Delete }

    private EventDraft? _draft;
    private CalendarDesk _desk = new();
    private IReadOnlyList<EventPlace> _placesUsed = [];
    private IReadOnlyList<MediaRef>? _pictures = [];
    private string? _loadProblem;
    private EventSave? _base;
    private string? _problem;
    private bool _saving;
    private EditorSheet _sheet;
    private string _tellTitle = "";
    private string _tellBody = "";
    private string _savedOccurrenceId = "";
    private bool _asked;

    [Parameter, EditorRequired] public required EditTarget Target { get; set; }
    [Parameter] public IReadOnlyList<CalendarInfo> Calendars { get; set; } = [];
    [Parameter] public bool InPanel { get; set; }
    [Parameter] public DateOnly? NewOn { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<string> Saved { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private DateOnly Today => EventWords.Today(Now);

    private EventFields Fields => _draft?.Fields ?? new EventFields();

    private DeskCalendar? DeskCalendar => _desk.Calendars.FirstOrDefault(calendar => calendar.Settings.Calendar.Id == _draft?.CalendarId);

    private string CalendarName => DeskCalendar?.Settings.Calendar.Name ?? Calendars.FirstOrDefault(calendar => calendar.Id == _draft?.CalendarId)?.Name ?? "the calendar";

    private bool MustAsk => DeskCalendar is { Settings.NeedsPublisher: true, CanPublish: false };

    private IReadOnlyList<DeskCalendar> Editable => _desk.Calendars.Where(calendar => calendar.CanEdit && !calendar.Settings.Calendar.ReadOnly).ToList();

    private string DeleteTitle => $"Delete {Fields.Title}?";

    protected override async Task OnParametersSetAsync()
    {
        if (_draft is not null && _loadedFor == Target)
            return;
        _loadedFor = Target;
        _draft = null;
        await LoadAsync();
    }

    private EditTarget? _loadedFor;

    private async Task LoadAsync()
    {
        _loadProblem = null;
        try
        {
            _desk = await Editing.DeskAsync();
            if (Target.EventId is { } eventId)
            {
                if (await Editing.EventAsync(Target.CalendarId, eventId) is not { } detail)
                {
                    _loadProblem = "It isn't on this phone. It may have been deleted, or you may no longer edit its calendar.";
                    return;
                }
                _draft = EventDraft.From(detail, Now);
            }
            else
                _draft = EventDraft.New(StartingCalendar(), NewOn ?? Today);
            if (MustAsk && _draft.IsNew)
                _draft.Showing = Showing.SavedForLater;
            Stored();
            _placesUsed = await Editing.PlacesUsedAsync();
        _pictures = await Editing.PicturesUsedAsync(_draft?.CalendarId ?? Target.CalendarId);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _loadProblem = Editing.Explain(exception);
        }
    }

    private async Task RefreshAsync()
    {
        if (_saving || _sheet != EditorSheet.None || _draft is null)
            return;
        if (!Changed && !_draft.IsNew)
        {
            string? said = _savedWords;
            await LoadAsync();
            _savedWords = said;
            return;
        }
        _desk = await Editing.DeskAsync();
        _placesUsed = await Editing.PlacesUsedAsync();
        _pictures = await Editing.PicturesUsedAsync(_draft?.CalendarId ?? Target.CalendarId);
    }

    private string StartingCalendar() =>
        Editable.Any(calendar => calendar.Settings.Calendar.Id == Target.CalendarId) ? Target.CalendarId : Editable.FirstOrDefault()?.Settings.Calendar.Id ?? Target.CalendarId;

    private RenderFragment Body => @<text>
        @if (_loadProblem is not null)
        {
            <EmptyState Icon="cloud-off" Title="Can't open this for editing" Body="@_loadProblem">
                <Button Variant="ButtonVariant.Quiet" OnClick="Closed">Back</Button>
            </EmptyState>
        }
        else if (_draft is not { } draft)
        {
            <EventHead Title="" Compact="InPanel" />
            <div class="event-body"><Skeleton Shape="SkeletonShape.Lines" Count="5" /></div>
        }
        else
        {
            <EventHead Day="draft.ShownDay" Label="@(Fields.Label.Length > 0 ? Fields.Label : CalendarName)" Title="@(Fields.Title.Length > 0 ? Fields.Title : "New event")" When="@draft.WhenLine"
                       Compact="InPanel" />
            <div class="event-body event-body--editing">
                @if (_asked)
                {
                    <p class="event-saved" role="status"><Icon Name="check" Size="IconSize.Small" />Asked. The calendar's publishers have been told.</p>
                }
                @if (draft.IsNew)
                {
                    <SelectField Label="Calendar" Options="CalendarOptions" Value="@draft.CalendarId" ValueChanged="ChooseCalendar" />
                }
                <TitleFields Fields="Fields" CalendarName="@CalendarName" />
                <div class="ui-pair">
                    <DateField Label="Date" Value="@EventDates.Format(draft.StartDate)" ValueChanged="value => draft.StartDate = EventDates.Parse(value) ?? draft.StartDate" />
                    <DateField Label="Until (for several days)" Value="@(draft.EndDate is { } end ? EventDates.Format(end) : "")" Min="@EventDates.Format(draft.StartDate)"
                               ValueChanged="value => draft.EndDate = EventDates.Parse(value)" />
                </div>
                <TimesEditor Timed="draft.Every" SameDay="@(draft.EndDate is null || draft.EndDate == draft.StartDate)" />
                @if (draft.NotOnThisDate)
                {
                    <p class="event-off"><Icon Name="circle-off" Size="IconSize.Small" />Not on this date</p>
                }
                <EventFieldsEditor Fields="Fields" PlacesUsed="_placesUsed" PicturesUsed="_pictures" />
                <ShownOnEditor Draft="draft" Desk="_desk" />
                <ShowingEditor Draft="draft" MustAsk="MustAsk" CalendarName="@CalendarName" />
            </div>
            <div class="editor-foot @(InPanel ? "editor-foot--panel" : "")">
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                <div class="editor-foot__actions">
                    <SaveBar Block="true" New="draft.IsNew" Label="@SaveLabel(draft)" Busy="_saving" OnSave="SaveAsync" Blocked="@(Fields.Title.Trim().Length == 0 ? $"Give it a title to {(draft.IsNew ? "add" : "save")} it." : null)" State="SaveLine" SavedText="@SavedWords"
                             WaitingText="@EditWaiting.WaitingWords" FailedText="@EditWaiting.FailedWords" Detail="@Waiting?.Problem" Retry="() => Editing.RetryAsync(ItemKey)">
                        @if (!draft.IsNew)
                        {
                            <Button Variant="ButtonVariant.Quiet" Busy="_saving" OnClick="NotOnAsync">@(draft.NotOnThisDate ? "On again" : "Not on this date")</Button>
                        }
                    </SaveBar>
                </div>
                @if (MustAsk && !draft.IsNew && !draft.Asked && !draft.WasShown)
                {
                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="send" OnClick="AskAsync">Ask to publish</Button>
                }
                @if (!draft.IsNew)
                {
                    <button type="button" class="editor-foot__delete" @onclick="() => OpenAsync(EditorSheet.Delete)">Delete this event</button>
                }
            </div>
        }
    </text>;

    private IReadOnlyList<FieldOption> CalendarOptions => Editable.Select(calendar => new FieldOption(calendar.Settings.Calendar.Id, calendar.Settings.Calendar.Name)).ToList();


    private string? _stored;
    private bool _leaving;
    private string? _savedWords;

    private bool Changed => !_leaving && _draft is not null && _stored is not null && Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)) != _stored;

    private string ItemKey => EditKeys.Event(_draft?.ItemId ?? "");

    private EditWaiting? Waiting => _draft is null || Changed ? null : Editing.WaitingFor(ItemKey);

    private SaveState? SaveLine => Waiting?.State ?? SaveBar.For(Changed, _savedWords is not null);

    private string SavedWords => (_savedWords ?? "Saved").TrimEnd('.');

    private void Stored()
    {
        (_stored, _savedWords) = (_draft is null ? null : Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)), null);
        _base = _draft is null || _draft.IsNew ? null : EditSaves.Copy(SaveMessage(_draft));
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync();
        return _problem is null && !Changed;
    }

    private async Task LeaveAsync()
    {
        if (await Unsaved.MayLeaveAsync())
            await Closed.InvokeAsync();
    }

    private static EventSave SaveMessage(EventDraft draft) => draft.ToEventSave();

    private static string SaveLabel(EventDraft draft) => draft.IsNew ? "Add the event" : "Save";

    private void ChooseCalendar(string calendarId)
    {
        if (_draft is null)
            return;
        _draft.CalendarId = calendarId;
        if (MustAsk)
            _draft.Showing = Showing.SavedForLater;
    }

    private async Task OpenAsync(EditorSheet sheet)
    {
        await Shell.HapticAsync();
        _sheet = sheet;
    }

    private void CloseSheet() => _sheet = EditorSheet.None;

    private Task SheetToggled(bool open)
    {
        if (!open)
            _sheet = EditorSheet.None;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_draft is not { } draft || _saving)
            return;
        _saving = true;
        _problem = null;
        bool wasShown = draft.WasShown && !draft.IsNew;
        EventSave? before = _base;
        EventSave save = SaveMessage(draft);
        save.Base = before;
        EditSent sent = await Editing.SaveEventAsync(save);
        _saving = false;
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            _sheet = EditorSheet.None;
            return;
        }
        string note = before is null ? "" : FieldValues.ChangeNote(new Timed(before.Fields, before.Times.StartMinute, before.Times.EndMinute),
            new Timed(save.Fields, save.Times.StartMinute, save.Times.EndMinute), EventDates.Parse(before.Times.StartDate), EventDates.Parse(save.Times.StartDate));
        await SavedAsync(draft.OccurrenceId(), wasShown, note);
    }

    private async Task SavedAsync(string occurrenceId, bool wasShown, string changeNote)
    {
        await Shell.HapticAsync(Haptic.Success);
        Stored();
        _savedOccurrenceId = occurrenceId;
        if (wasShown && occurrenceId.Length > 0)
        {
            _tellTitle = _draft!.NotOnThisDate ? $"{Fields.Title} isn't on" : $"Changed: {Fields.Title}";
            _tellBody = _draft.NotOnThisDate ? $"{EventWords.LongDate(_draft.ShownDay)}." : changeNote;
            _sheet = EditorSheet.Tell;
            return;
        }
        await FinishAsync();
    }

    private async Task NotOnAsync()
    {
        if (_draft is null)
            return;
        _draft.NotOnThisDate = !_draft.NotOnThisDate;
        await SaveAsync();
        if (_problem is not null)
            _draft.NotOnThisDate = !_draft.NotOnThisDate;
    }

    private async Task AskAsync()
    {
        if (_draft is null)
            return;
        EditSent sent = await Editing.AskToPublishAsync(new ItemRef { CalendarId = _draft.CalendarId, EventId = _draft.EventId, RegularEventId = _draft.RegularEventId });
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            return;
        }
        _draft.Asked = true;
        _asked = true;
    }

    private async Task DeleteAsync()
    {
        if (_draft is null)
            return;
        _saving = true;
        EditSent sent = _draft.EventId is { } eventId ? await Editing.DeleteEventAsync(new EventRef { CalendarId = _draft.CalendarId, EventId = eventId }) : EditSent.Done;
        _saving = false;
        _sheet = EditorSheet.None;
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            return;
        }
        _leaving = true;
        _savedOccurrenceId = "";
        await Saved.InvokeAsync("");
        await Closed.InvokeAsync();
    }

    private async Task FinishAsync() => await FinishAsync(TellPeopleSheet.SavedWords);

    private async Task FinishAsync(string done)
    {
        _sheet = EditorSheet.None;
        _savedWords = done;
        await Saved.InvokeAsync(_savedOccurrenceId);
        if (!InPanel)
            await Closed.InvokeAsync();
    }
}
