@inject IEventEditing Editing

<TellSheet Open="Open" Title="Tell people about this change?" Lead="@($"Sends a notification to everyone who has the {CalendarName} calendar. Tapping it opens the event.")"
           NotificationTitle="@Title" NotificationBody="@Body" OnTell="TellAsync" OnNotNow="() => Done.InvokeAsync(SavedWords)" />

@code {
    public const string SavedWords = "Saved.";

    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public required string CalendarId { get; set; }
    [Parameter, EditorRequired] public required string CalendarName { get; set; }
    [Parameter, EditorRequired] public required string OccurrenceId { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> Done { get; set; }

    private async Task<string?> TellAsync(TellWords words)
    {
        EditSent sent = await Editing.TellPeopleAsync(new TellPeople { CalendarId = CalendarId, OccurrenceId = OccurrenceId, Title = words.Title, Body = words.Body });
        if (!sent.Succeeded)
            return sent.Problem;
        await Done.InvokeAsync(sent.Queued ? "Saved. People will be notified once this phone is back online." : "Saved, and people have been told.");
        return null;
    }
}
