@using GSBC.ChurchApp.Platform.Common
@inject IEventEditing Editing
@inject TimeProvider Clock
@inject Shell Shell
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="this regular event" Save="SaveBeforeLeavingAsync" />
<RefreshOn Feeds="Editing.Feeds" On="ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox" Changed="_ => RefreshAsync()" />

@if (InPanel)
{
    <div class="regular-page regular-page--panel"><EditScope Edited="() => { }">@Body</EditScope></div>
}
else
{
    <Page Title="@(RegularEventId is null ? "New regular event" : "Regular event")" OnBack="LeaveAsync" BackLabel="@BackLabel" TopBar="TopBarStyle.Solid">
        <ChildContent><div class="regular-page"><EditScope Edited="() => { }">@Body</EditScope></div></ChildContent>
    </Page>
}

<Sheet Open="_sheet == EditorSheet.Repeats" OpenChanged="SheetToggled" Title="How it repeats">
    <ChildContent>@if (_draft is { } draft) { <RepeatEditor Draft="draft" Breaks="_breaks" Part="RepeatPart.Pattern" /> }</ChildContent>
    <Actions><Button Block="true" OnClick="CloseSheet">Done</Button></Actions>
</Sheet>

<Sheet Open="_sheet == EditorSheet.Breaks" OpenChanged="SheetToggled" Title="Breaks" Lead="Dates it isn't on. People see the first two weeks of a break as not on.">
    <ChildContent>@if (_draft is { } draft) { <RepeatEditor Draft="draft" Breaks="_breaks" Part="RepeatPart.Breaks" /> }</ChildContent>
    <Actions><Button Block="true" OnClick="CloseSheet">Done</Button></Actions>
</Sheet>

<Sheet Open="_sheet == EditorSheet.Needs" OpenChanged="SheetToggled" Title="What each date needs">
    <ChildContent>@if (_draft is { } draft) { <RepeatEditor Draft="draft" Breaks="_breaks" Part="RepeatPart.Needs" /> }</ChildContent>
    <Actions><Button Block="true" OnClick="CloseSheet">Done</Button></Actions>
</Sheet>

<Sheet Open="_sheet == EditorSheet.AlsoOn" OpenChanged="SheetToggled" Title="Also shown on">
    <ChildContent>@if (_draft is { } draft) { <ShownOnEditor Draft="draft" Desk="_desk" /> }</ChildContent>
    <Actions><Button Block="true" OnClick="CloseSheet">Done</Button></Actions>
</Sheet>

<Sheet Open="_sheet == EditorSheet.Showing" OpenChanged="SheetToggled" Title="Shown in the app">
    <ChildContent>@if (_draft is { } draft) { <ShowingEditor Draft="draft" MustAsk="MustAsk" CalendarName="@CalendarName" /> }</ChildContent>
    <Actions><Button Block="true" OnClick="CloseSheet">Done</Button></Actions>
</Sheet>

<Sheet Open="_sheet == EditorSheet.KeepOwn" OpenChanged="SheetToggled" Title="Some dates keep their own" Lead="These dates were changed on their own, so they keep what they have:">
    <ChildContent>
        <ul class="kept-list">
            @foreach (KeptValue kept in _keepOwn)
            {
                <li>@kept.Title on @EventWords.Date(EventDates.Parse(kept.Date) ?? Today) keeps its own @kept.Field, @kept.Value</li>
            }
        </ul>
    </ChildContent>
    <Actions>
        <Button Block="true" Busy="_saving" OnClick="() => SaveAsync(keepOwnConfirmed: true)">Save every date</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="CloseSheet">Go back</Button>
    </Actions>
</Sheet>

<TellPeopleSheet Open="_sheet == EditorSheet.Tell" CalendarId="@(_draft?.CalendarId ?? "")" CalendarName="@CalendarName" OccurrenceId="@_tellOccurrenceId"
                 Title="@($"Changed: {Fields.Title}")" Body="@_tellBody" Done="FinishAsync" />

<Sheet Open="_sheet == EditorSheet.Delete" OpenChanged="SheetToggled" Title="@($"Delete every date of {Fields.Title}?")"
       Lead="The regular event and all its dates come off every phone and calendar app. This can't be undone.">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_saving" OnClick="DeleteAsync">Delete the regular event</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="CloseSheet">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private enum EditorSheet { None, Repeats, Breaks, Needs, AlsoOn, Showing, KeepOwn, Tell, Delete }

    private EventDraft? _draft;
    private IReadOnlyList<RegularDate> _dates = [];
    private CalendarDesk _desk = new();
    private BreakList _breaks = new();
    private IReadOnlyList<EventPlace> _placesUsed = [];
    private string? _loadProblem;
    private RegularEventDetail? _detail;
    private RegularEventSave? _base;
    private string? _problem;
    private bool _saving;
    private EditorSheet _sheet;
    private List<KeptValue> _keepOwn = [];
    private string _tellOccurrenceId = "";
    private string _tellBody = "";
    private bool _asked;
    private (string, string?)? _loadedFor;
    private int _datesVersion;

    [Parameter, EditorRequired] public required string CalendarId { get; set; }
    [Parameter] public string? RegularEventId { get; set; }
    [Parameter] public bool InPanel { get; set; }
    [Parameter] public string? SelectedDate { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Back";
    [Parameter] public int DatesVersion { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<string> Saved { get; set; }
    [Parameter] public EventCallback<RegularDate> DatePicked { get; set; }
    [Parameter] public RenderFragment<string>? Organisers { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private DateOnly Today => EventWords.Today(Now);

    private EventFields Fields => _draft?.Every.Fields ?? new EventFields();

    private DeskCalendar? DeskCalendar => _desk.Calendars.FirstOrDefault(calendar => calendar.Settings.Calendar.Id == _draft?.CalendarId);

    private string CalendarName => DeskCalendar?.Settings.Calendar.Name ?? "the calendar";

    private bool MustAsk => DeskCalendar is { Settings.NeedsPublisher: true, CanPublish: false };

    private IReadOnlyList<DeskCalendar> Editable => _desk.Calendars.Where(calendar => calendar.CanEdit && !calendar.Settings.Calendar.ReadOnly).ToList();

    private IReadOnlyList<FieldOption> CalendarOptions => Editable.Select(calendar => new FieldOption(calendar.Settings.Calendar.Id, calendar.Settings.Calendar.Name)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_draft is not null && _loadedFor == (CalendarId, RegularEventId))
        {
            if (DatesVersion != _datesVersion)
                await RefreshDatesAsync();
            return;
        }
        _datesVersion = DatesVersion;
        _loadedFor = (CalendarId, RegularEventId);
        _draft = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadProblem = null;
        try
        {
            _desk = await Editing.DeskAsync();
            if (RegularEventId is { } regularId)
            {
                if (await Editing.RegularEventAsync(CalendarId, regularId) is not { } detail)
                {
                    _loadProblem = "It isn't on this phone. It may have been deleted, or you may no longer edit its calendar.";
                    return;
                }
                Show(detail);
            }
            else
            {
                _draft = EventDraft.NewRegular(StartingCalendar(), Today);
                _dates = [];
                if (MustAsk)
                    _draft.Showing = Showing.SavedForLater;
                Stored();
            }
            await LoadSideAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _loadProblem = Editing.Explain(exception);
        }
    }

    private async Task RefreshAsync()
    {
        if (_saving || _sheet != EditorSheet.None || _draft is null)
            return;
        if (!Changed && !_draft.IsNew)
        {
            string? said = _savedWords;
            await LoadAsync();
            _savedWords = said;
            return;
        }
        _desk = await Editing.DeskAsync();
        await LoadSideAsync();
    }

    private async Task RefreshDatesAsync()
    {
        _datesVersion = DatesVersion;
        if (_draft?.RegularEventId is not { } regularId)
            return;
        try
        {
            if (await Editing.RegularEventAsync(_draft.CalendarId, regularId) is { } detail)
                (_detail, _dates) = (detail, detail.Dates);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _problem = Editing.Explain(exception);
        }
    }

    private void Show(RegularEventDetail detail)
    {
        _detail = detail;
        _draft = EventDraft.From(detail, null, Now);
        _dates = detail.Dates;
        Stored();
    }

    private string StartingCalendar() =>
        Editable.Any(calendar => calendar.Settings.Calendar.Id == CalendarId) ? CalendarId : Editable.FirstOrDefault()?.Settings.Calendar.Id ?? CalendarId;

    private async Task LoadSideAsync()
    {
        _breaks = await Editing.BreaksAsync();
        _placesUsed = await Editing.PlacesUsedAsync();
    }

    private RenderFragment Body => @<text>
        @if (_loadProblem is not null)
        {
            <EmptyState Icon="cloud-off" Title="Can't open this regular event" Body="@_loadProblem">
                <Button Variant="ButtonVariant.Quiet" OnClick="Closed">Back</Button>
            </EmptyState>
        }
        else if (_draft is not { } draft)
        {
            <EventHead Title="" Compact="InPanel" />
            <div class="event-body"><Skeleton Shape="SkeletonShape.Lines" Count="6" /></div>
        }
        else
        {
            <div class="regular-head">
                @if (InPanel)
                {
                    <div class="regular-head__actions">
                        <span class="regular-head__state">@ShowingWords(draft)</span>
                        @if (MustAsk && !draft.IsNew && !draft.Asked && !draft.WasShown)
                        {
                            <Button Variant="ButtonVariant.GhostOnMasthead" Small="true" Icon="send" OnClick="AskAsync">Ask to publish</Button>
                        }
                        @SaveButton(draft, onMasthead: true)
                    </div>
                }
                <EventHead Label="@(Fields.Label.Length > 0 ? Fields.Label : CalendarName)" Title="@(Fields.Title.Length > 0 ? Fields.Title : "New regular event")" Compact="InPanel">
                    <p class="event-head__when regular-head__pattern"><Icon Name="repeat" Size="IconSize.Small" />@Pattern(draft)</p>
                </EventHead>
                <DateStrip Dates="_dates" Today="Today" Selected="@SelectedDate" Picked="PickAsync"
                           Empty="@(draft.IsNew ? "Its dates show here once it's added." : "It has no more dates. Change how it repeats to carry it on.")" />
            </div>
            <div class="regular-body">
                @if (_asked)
                {
                    <p class="event-saved regular-body__wide" role="status"><Icon Name="check" Size="IconSize.Small" />Asked. The calendar's publishers have been told.</p>
                }
                @if (InPanel && _problem is not null)
                {
                    <div class="regular-body__wide"><Notice Tone="NoticeTone.Warning" Text="@_problem" /></div>
                }
                <section class="regular-col" aria-labelledby="regular-every">
                    <h2 class="regular-col__head" id="regular-every">Every date</h2>
                    <p class="regular-col__lead">What each date has, unless that date is changed on its own.</p>
                    @if (draft.IsNew)
                    {
                        <SelectField Label="Calendar" Options="CalendarOptions" Value="@draft.CalendarId" ValueChanged="ChooseCalendar" />
                    }
                    <TitleFields Fields="Fields" CalendarName="@CalendarName" Placeholder="Morning service" />
                    <TimesEditor Timed="draft.Every" />
                    <EventFieldsEditor Fields="Fields" PlacesUsed="_placesUsed" Needs="draft.Needs" />
                </section>
                <section class="regular-col" aria-labelledby="regular-runs">
                    <h2 class="regular-col__head" id="regular-runs">How it runs</h2>
                    <p class="regular-col__lead">How it repeats, its breaks, and what each date needs before it's on.</p>
                    <div class="list regular-runs">
                        <ListRow Chevron="true" Title="Repeats" Trailing="@RepeatsLine(draft)" OnClick="() => OpenAsync(EditorSheet.Repeats)" />
                        <ListRow Chevron="true" Title="Breaks" Trailing="@BreaksLine(draft)" OnClick="() => OpenAsync(EditorSheet.Breaks)" />
                        <ListRow Chevron="true" Title="Each date needs" Trailing="@NeedsLine(draft)" OnClick="() => OpenAsync(EditorSheet.Needs)" />
                        <ListRow Chevron="true" Title="Also shown on" Trailing="@AlsoOnLine(draft)" OnClick="() => OpenAsync(EditorSheet.AlsoOn)" />
                        <ListRow Chevron="true" Title="Shown in the app" Trailing="@ShowingWords(draft)" OnClick="() => OpenAsync(EditorSheet.Showing)" />
                        <ToggleRow Title="List every date on the website" Description="Off: the website lists it once under Every week, with its changed dates." Checked="draft.ListEveryDate" CheckedChanged="listed => draft.ListEveryDate = listed" />
                    </div>
                    @if (!draft.IsNew && RegularEventId is { } regularEventId && Organisers is not null)
                    {
                        @Organisers(regularEventId)
                    }
                    @if (InPanel && !draft.IsNew)
                    {
                        <button type="button" class="editor-foot__delete" @onclick="() => OpenAsync(EditorSheet.Delete)">Delete the regular event</button>
                    }
                </section>
            </div>
            @if (!InPanel)
            {
                <div class="editor-foot">
                    <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                    <div class="editor-foot__actions">@SaveButton(draft, onMasthead: false)</div>
                    @if (MustAsk && !draft.IsNew && !draft.Asked && !draft.WasShown)
                    {
                        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="send" OnClick="AskAsync">Ask to publish</Button>
                    }
                    @if (!draft.IsNew)
                    {
                        <button type="button" class="editor-foot__delete" @onclick="() => OpenAsync(EditorSheet.Delete)">Delete the regular event</button>
                    }
                </div>
            }
        }
    </text>;

    private RenderFragment SaveButton(EventDraft draft, bool onMasthead) =>
        @<SaveBar Block="@(!onMasthead)" OnMasthead="onMasthead" Label="@(draft.IsNew ? "Add the regular event" : "Save every date")" Busy="_saving"
                  Blocked="@(Fields.Title.Trim().Length == 0 ? $"Give it a title to {(draft.IsNew ? "add" : "save")} it." : null)" State="SaveLine" SavedText="@SavedWords"
                  WaitingText="@EditWaiting.WaitingWords" FailedText="@EditWaiting.FailedWords" Detail="@Waiting?.Problem" Retry="() => Editing.RetryAsync(ItemKey)"
                  OnSave="() => SaveAsync(keepOwnConfirmed: false)" />;

    private string? _stored;
    private bool _leaving;
    private string? _savedWords;

    private bool Changed => !_leaving && _draft is not null && _stored is not null && Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)) != _stored;

    private string ItemKey => EditKeys.Regular(_draft?.ItemId ?? "");

    private EditWaiting? Waiting => _draft is null || Changed ? null : Editing.WaitingFor(ItemKey);

    private SaveState? SaveLine => Waiting?.State ?? SaveBar.For(Changed, _savedWords is not null);

    private string SavedWords => (_savedWords ?? "Saved").TrimEnd('.');

    private void Stored()
    {
        (_stored, _savedWords) = (_draft is null ? null : Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)), null);
        _base = _draft is null || _draft.IsNew ? null : EditSaves.Copy(SaveMessage(_draft));
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync(keepOwnConfirmed: false);
        return _problem is null && !Changed;
    }

    private async Task LeaveAsync()
    {
        if (await Unsaved.MayLeaveAsync())
            await Closed.InvokeAsync();
    }

    private static RegularEventSave SaveMessage(EventDraft draft) => draft.ToRegularSave(false);

    private static string RepeatsLine(EventDraft draft)
    {
        string from = EventDates.Parse(draft.Pattern.StartDate) is { } start && draft.Pattern.Repeats != Repeats.OnDates ? $"from {EventWords.Date(start)} {start.Year}" : "";
        string until = EventDates.Parse(draft.Pattern.EndDate) is { } end ? $"until {EventWords.Date(end)} {end.Year}" : "";
        return EventWords.Join(Capital(draft.RepeatsNow), from, until);
    }

    private string BreaksLine(EventDraft draft)
    {
        List<string> names = _breaks.Breaks.Where(entry => draft.BreakIds.Contains(entry.Id)).Select(entry => entry.Name)
            .Concat(draft.OwnBreaks.Select(entry => entry.Name).Where(name => name.Length > 0)).ToList();
        return names.Count == 0 ? "None" : string.Join(", ", names);
    }

    private static string NeedsLine(EventDraft draft) => draft.Needs.Count == 0
        ? "Nothing"
        : EventWords.Join(Capital(string.Join(", ", draft.Needs.Select(EventWords.Need))),
            draft.RemindDaysBefore.Count == 0 ? "nobody reminded" : $"reminded {string.Join(" and ", draft.RemindDaysBefore.OrderDescending())} days before");

    private string AlsoOnLine(EventDraft draft)
    {
        List<string> names = draft.AlsoOn.Select(showing => _desk.Calendars.FirstOrDefault(calendar => calendar.Settings.Calendar.Id == showing.CalendarId)?.Settings.Calendar.Name)
            .OfType<string>().ToList();
        return names.Count == 0 ? $"Only {CalendarName}" : string.Join(", ", names);
    }

    private static string ShowingWords(EventDraft draft) => draft.Showing switch
    {
        Showing.Shown => "Shown",
        Showing.ShownFrom when draft.ShowFrom is { } from => $"Shown from {EventWords.Date(ChurchTime.DayOf(from))}",
        _ => "Not shown yet",
    };

    private static string Pattern(EventDraft draft) => EventWords.Join(Capital(draft.RepeatsNow), EventDates.Times(draft.Every.StartMinute, draft.Every.EndMinute));

    private static string Capital(string words) => words.Length == 0 ? words : char.ToUpperInvariant(words[0]) + words[1..];

    private void ChooseCalendar(string calendarId)
    {
        if (_draft is null)
            return;
        _draft.CalendarId = calendarId;
        if (MustAsk)
            _draft.Showing = Showing.SavedForLater;
    }

    private async Task PickAsync(RegularDate date)
    {
        await Shell.HapticAsync();
        await DatePicked.InvokeAsync(date);
    }

    private async Task OpenAsync(EditorSheet sheet)
    {
        await Shell.HapticAsync();
        _sheet = sheet;
    }

    private void CloseSheet() => _sheet = EditorSheet.None;

    private Task SheetToggled(bool open)
    {
        if (!open)
            _sheet = EditorSheet.None;
        return Task.CompletedTask;
    }

    private async Task SaveAsync(bool keepOwnConfirmed)
    {
        if (_draft is not { } draft || _saving)
            return;
        _problem = null;
        RegularEventSave? before = _base;
        RegularEventSave save = draft.ToRegularSave(keepOwnConfirmed: true);
        if (!keepOwnConfirmed && !draft.IsNew && _detail is not null && KeptValues.Of(_detail, save, Today) is { Count: > 0 } kept)
        {
            _keepOwn = kept;
            _sheet = EditorSheet.KeepOwn;
            return;
        }
        _saving = true;
        bool wasShown = draft.WasShown && !draft.IsNew;
        save.Base = before;
        EditSent sent = await Editing.SaveRegularEventAsync(save);
        _saving = false;
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            _sheet = EditorSheet.None;
            return;
        }
        await Shell.HapticAsync(Haptic.Success);
        Stored();
        _tellOccurrenceId = draft.OccurrenceId(_detail);
        if (wasShown && before is not null && _tellOccurrenceId.Length > 0)
        {
            _tellBody = FieldValues.ChangeNote(new Timed(before.Fields, before.StartMinute, before.EndMinute), new Timed(save.Fields, save.StartMinute, save.EndMinute));
            _sheet = EditorSheet.Tell;
            return;
        }
        await FinishAsync(TellPeopleSheet.SavedWords);
    }

    private async Task FinishAsync(string done)
    {
        _sheet = EditorSheet.None;
        _savedWords = done;
        await Saved.InvokeAsync(_draft?.ItemId ?? "");
    }

    private async Task AskAsync()
    {
        if (_draft is null)
            return;
        EditSent sent = await Editing.AskToPublishAsync(new ItemRef { CalendarId = _draft.CalendarId, RegularEventId = _draft.RegularEventId });
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            return;
        }
        _draft.Asked = true;
        _asked = true;
    }

    private async Task DeleteAsync()
    {
        if (_draft?.RegularEventId is not { } regularId)
            return;
        _saving = true;
        EditSent sent = await Editing.DeleteRegularEventAsync(new RegularRef { CalendarId = _draft.CalendarId, RegularEventId = regularId });
        _saving = false;
        _sheet = EditorSheet.None;
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            return;
        }
        _leaving = true;
        await Saved.InvokeAsync("");
        await Closed.InvokeAsync();
    }
}
