@using System.Globalization

<div class="date-strip">
    @if (Dates.Count == 0)
    {
        <p class="date-strip__empty">@Empty</p>
    }
    else
    {
        <ul class="date-strip__dates" aria-label="Its dates">
            @foreach (RegularDate date in Dates.Take(_shown))
            {
                DateOnly day = EventDates.Parse(date.Date) ?? Today;
                <li>
                    <button type="button" class="@Classes(date, day)" aria-pressed="@(date.Date == Selected ? "true" : "false")" aria-label="@Spoken(date, day)" @onclick="() => Picked.InvokeAsync(date)">
                        <span class="date-strip__weekday" aria-hidden="true">@day.ToString("ddd", English).ToUpperInvariant()</span>
                        <span class="date-strip__day" aria-hidden="true">@day.Day</span>
                        <span class="date-strip__month" aria-hidden="true">@day.ToString("MMM", English).ToUpperInvariant()</span>
                    </button>
                </li>
            }
            @if (Dates.Count > _shown)
            {
                <li><button type="button" class="date-strip__more" @onclick="() => _shown += PageSize">More dates</button></li>
            }
        </ul>
    }
</div>
@if (Dates.Count > 0)
{
    <p class="date-strip__key">
        @foreach ((string? swatch, string line) in KeyLines)
        {
            <span>
                @if (swatch is not null)
                {
                    <i class="date-strip__swatch date-strip__swatch--@swatch" aria-hidden="true"></i>
                }
                @line
            </span>
        }
    </p>
}

@code {
    private const int PageSize = 13;
    private static readonly CultureInfo English = CultureInfo.InvariantCulture;
    private int _shown = PageSize;

    [Parameter, EditorRequired] public required IReadOnlyList<RegularDate> Dates { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Selected { get; set; }
    [Parameter] public string Empty { get; set; } = "Its dates show here once it's saved.";
    [Parameter] public EventCallback<RegularDate> Picked { get; set; }
    [Parameter] public string Hint { get; set; } = "Choose a date to change only that date";

    private IEnumerable<(string? Swatch, string Line)> KeyLines
    {
        get
        {
            List<RegularDate> shown = Dates.Take(_shown).ToList();
            if (shown.FirstOrDefault(date => date.Changed && !date.NotOn) is { } changed)
                yield return ("changed", $"{Short(changed)} is changed: {EventWords.Join(changed.Title, EventDates.Times(changed.StartMinute, changed.EndMinute))}");
            if (shown.FirstOrDefault(date => date.NotOn) is { } off)
                yield return ("off", off.NotOnReason is { Length: > 0 } reason and not EventDraft.NotOnNote ? $"{Short(off)} isn't on: {reason}" : $"{Short(off)} isn't on");
            yield return (null, Hint);
        }
    }

    private string Classes(RegularDate date, DateOnly day) => string.Join(" ", new[]
    {
        "date-strip__date",
        date.NotOn ? "date-strip__date--off" : date.Changed ? "date-strip__date--changed" : null,
        day == Today ? "date-strip__date--today" : null,
    }.OfType<string>());

    private static string Spoken(RegularDate date, DateOnly day) => EventWords.Join(
        EventWords.LongDate(day),
        date.NotOn ? (date.NotOnReason is { Length: > 0 } reason and not EventDraft.NotOnNote ? $"not on, {reason}" : "not on") : null,
        date.Changed && !date.NotOn ? $"changed: {date.Title}" : null);

    private static string Short(RegularDate date) => EventDates.Parse(date.Date) is { } day ? EventWords.Date(day) : date.Date;
}
