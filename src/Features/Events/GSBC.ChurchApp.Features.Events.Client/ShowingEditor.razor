@using GSBC.ChurchApp.Platform.Common

<div class="field">
    <span class="field__label">Visible in the app</span>
    @if (MustAsk)
    {
        <span class="field__hint">The @CalendarName calendar needs a publisher. Save the event, then choose Ask to publish.</span>
    }
    else
    {
        <Segmented TValue="Showing" Label="Visible in the app" Options="Showings" Rows="Rows" Value="Draft.Showing" ValueChanged="showing => Draft.Showing = showing" />
        @if (Draft.Showing == Showing.ShownFrom)
        {
            <DateField Label="Show from this date" Value="@(Draft.ShowFrom is { } from ? EventDates.Format(ChurchTime.DayOf(from)) : "")" ValueChanged="ShowFromChanged" />
        }
    }
</div>

@code {
    private static readonly IReadOnlyList<SegmentOption<Showing>> Showings =
        [
            new(Showing.Shown, "Show now") { Detail = "Everyone it's for sees it straight away." },
            new(Showing.SavedForLater, "Keep hidden for now") { Detail = "Only the calendar's editors see it until you show it." },
            new(Showing.ShownFrom, "Show from a chosen date") { Detail = "It appears in the app on the date you choose." },
        ];

    [Parameter, EditorRequired] public required EventDraft Draft { get; set; }
    [Parameter] public bool MustAsk { get; set; }
    [Parameter] public string CalendarName { get; set; } = "";
    [Parameter] public bool Rows { get; set; }

    public static string Words(EventDraft draft) => draft.Showing switch
    {
        Showing.Shown => "Shown",
        Showing.ShownFrom when draft.ShowFrom is { } from => $"Shown from {EventWords.Date(ChurchTime.DayOf(from))}",
        _ => "Not shown yet",
    };

    private void ShowFromChanged(string value)
    {
        if (EventDates.Parse(value) is { } day)
            Draft.ShowFrom = ChurchTime.ToUtc(day.ToDateTime(TimeOnly.MinValue));
    }
}
