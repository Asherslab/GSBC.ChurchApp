@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Ui.Content

<PlaceEditor Place="Fields.Place" PlaceChanged="place => Fields.Place = place" Used="PlacesUsed" Missing="@(Needs.Contains(EventFieldKeys.Place))" />
<ContactsEditor Contacts="Fields.Contacts" />
<EventAbout @ref="_about" Label="About" Text="Fields.Description" TextChanged="text => Fields.Description = text"
            Hint="Say what the event is, who it's for and what to bring. Use the bar for formatting, and Insert for pictures, video and files." />
<AddableField Label="Registration link" Adding="Registration link" Shown="Fields.RegisterLink.Length > 0">
    <TextField Label="Registration link" Type="url" Value="@Fields.RegisterLink" ValueChanged="value => Fields.RegisterLink = value.Trim()"
               Hint="A web address where people sign up. It opens in the app's browser; the app doesn't count registrations." />
</AddableField>
<LinksEditor Links="Fields.Links" />
<PictureField Label="Picture" Value="Fields.Picture" ValueChanged="picture => Fields.Picture = picture" AsCover="true" Adding="Add a picture" Offered="PicturesUsed"
              Unavailable="Pictures can only be added in the admin panel." />

@code {
    private EventAbout? _about;

    [Parameter, EditorRequired] public required EventFields Fields { get; set; }
    [Parameter] public IReadOnlyList<EventPlace> PlacesUsed { get; set; } = [];
    [Parameter] public IReadOnlyList<MediaRef>? PicturesUsed { get; set; }
    [Parameter] public IReadOnlyList<string> Needs { get; set; } = [];

    public IReadOnlyList<MediaRef> WaitingFiles() => _about?.WaitingFiles() ?? [];
}
