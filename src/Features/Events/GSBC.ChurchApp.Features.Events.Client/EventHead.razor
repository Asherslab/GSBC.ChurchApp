<header class="event-head @(Compact ? "event-head--compact" : "")">
    <BrandMark Class="event-head__mark" Decorative="true" />
    @if (Day is { } day)
    {
        <DateBlock Day="day" />
    }
    <div class="event-head__words">
        @if (Label is not null)
        {
            <p class="event-head__label">@Label</p>
        }
        <h1 class="event-head__title" tabindex="-1">@Title</h1>
        @if (When is not null)
        {
            <p class="event-head__when">@When</p>
        }
        @ChildContent
    </div>
</header>

@code {
    [Parameter] public DateOnly? Day { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? When { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
