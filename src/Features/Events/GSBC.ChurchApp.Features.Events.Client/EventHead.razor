<header class="event-head @(Compact ? "event-head--compact" : "")">
    <span class="event-head__clip" aria-hidden="true"><BrandMark Class="event-head__mark" Decorative="true" /></span>
    @if (Day is { } day)
    {
        <DateBlock Day="day" />
    }
    <div class="event-head__words">
        @if (Label is not null)
        {
            <p class="event-head__label">@Label</p>
        }
        <h1 class="event-head__title" tabindex="-1">@Title</h1>
        @if (When is not null)
        {
            <p class="event-head__when">@When</p>
        }
        @ChildContent
    </div>
    @if (Actions is { Count: > 0 } actions)
    {
        <Menu Label="@($"More for {(Title.Length > 0 ? Title : "this event")}")" Items="actions" Variant="ButtonVariant.GhostOnMasthead" Class="event-head__menu" />
    }
</header>

@code {
    [Parameter] public DateOnly? Day { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? When { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public IReadOnlyList<MenuItem>? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
