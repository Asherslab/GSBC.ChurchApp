@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Ui.Content
@inject IEventEditing Editing
@inject TimeProvider Clock
@inject Shell Shell
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="this date" Save="SaveBeforeLeavingAsync" />
<RefreshOn Feeds="Editing.Feeds" On="ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox" Changed="_ => RefreshAsync()" />

@if (InPanel)
{
    <div class="event-panel"><EditScope Edited="() => { }">@Body</EditScope></div>
}
else
{
    <Page Title="This date" OnBack="LeaveAsync" BackLabel="Cancel" TopBar="TopBarStyle.Solid">
        <ChildContent><EditScope Edited="() => { }">@Body</EditScope></ChildContent>
    </Page>
}

<TellPeopleSheet Open="_telling" CalendarId="@CalendarId" CalendarName="@CalendarName" OccurrenceId="@_savedOccurrenceId"
                 Title="@_tellTitle" Body="@_tellBody" Done="FinishAsync" />

@code {
    private EventDraft? _draft;
    private CalendarDesk _desk = new();
    private IReadOnlyList<EventPlace> _placesUsed = [];
    private string? _loadProblem;
    private DateSave? _base;
    private string? _problem;
    private bool _saving;
    private bool _telling;
    private string _tellTitle = "";
    private string _tellBody = "";
    private string _savedOccurrenceId = "";
    private int _aboutVersion;
    private string? _inBreak;
    private (string, DateOnly)? _loadedFor;

    [Parameter, EditorRequired] public required string CalendarId { get; set; }
    [Parameter, EditorRequired] public required string RegularEventId { get; set; }
    [Parameter, EditorRequired] public required DateOnly Date { get; set; }
    [Parameter] public bool InPanel { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<string> Saved { get; set; }
    [Parameter] public EventCallback OpenRegular { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private TimedFields OnDate => _draft?.ThisDate ?? new TimedFields();

    private string CalendarName => _desk.Calendars.FirstOrDefault(calendar => calendar.Settings.Calendar.Id == CalendarId)?.Settings.Calendar.Name ?? "the calendar";

    protected override async Task OnParametersSetAsync()
    {
        if (_draft is not null && _loadedFor == (RegularEventId, Date))
            return;
        _loadedFor = (RegularEventId, Date);
        _draft = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadProblem = null;
        try
        {
            _desk = await Editing.DeskAsync();
            if (await Editing.RegularEventAsync(CalendarId, RegularEventId) is not { } detail)
            {
                _loadProblem = "It isn't on this phone. It may have been deleted, or you may no longer edit its calendar.";
                return;
            }
            _draft = EventDraft.From(detail, Date, Now);
            Stored();
            _inBreak = detail.Dates.FirstOrDefault(entry => entry.Date == EventDates.Format(Date) && entry.NotOn && !_draft.NotOnThisDate)?.NotOnReason;
            _placesUsed = await Editing.PlacesUsedAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _loadProblem = Editing.Explain(exception);
        }
    }

    private async Task RefreshAsync()
    {
        if (_saving || _telling || _draft is null)
            return;
        if (!Changed)
        {
            string? said = _savedWords;
            await LoadAsync();
            _savedWords = said;
            return;
        }
        _placesUsed = await Editing.PlacesUsedAsync();
    }

    private RenderFragment Body => @<text>
        @if (_loadProblem is not null)
        {
            <EmptyState Icon="cloud-off" Title="Can't open this date" Body="@_loadProblem">
                <Button Variant="ButtonVariant.Quiet" OnClick="Closed">Back</Button>
            </EmptyState>
        }
        else if (_draft is not { } draft)
        {
            <EventHead Day="Date" Title="" Compact="InPanel" />
            <div class="event-body"><Skeleton Shape="SkeletonShape.Lines" Count="5" /></div>
        }
        else
        {
            <EventHead Day="Date" Label="@(OnDate.Fields.Label.Length > 0 ? OnDate.Fields.Label : CalendarName)" Title="@(OnDate.Fields.Title.Length > 0 ? OnDate.Fields.Title : draft.Every.Fields.Title)"
                       When="@(draft.NotOnThisDate ? "Not on this date" : EventWords.Join(EventDates.Times(OnDate.StartMinute, OnDate.EndMinute), "this date only"))" Compact="InPanel" />
            <div class="date-of">
                <Icon Name="repeat" Size="IconSize.Small" />
                <p>
                    One of the @draft.Every.Fields.Title, @draft.RepeatWords.
                    <button type="button" class="date-of__link" @onclick="OpenRegular">Edit the regular event ›</button>
                </p>
            </div>
            <div class="event-body event-body--editing">
                @if (draft.NotOnThisDate)
                {
                    <p class="event-off"><Icon Name="circle-off" Size="IconSize.Small" />Not on this date. People see it as not on, and calendar apps leave it out.</p>
                }
                else if (_inBreak is not null)
                {
                    <p class="event-off"><Icon Name="circle-off" Size="IconSize.Small" />Not on: it's in @(_inBreak.Length > 0 ? _inBreak : "a break"). Breaks are changed on the regular event.</p>
                }
                <TextField Label="Title on this date" Value="@OnDate.Fields.Title" ValueChanged="value => OnDate.Fields.Title = value" MaxLength="120" Required="true"
                           Placeholder="@draft.Every.Fields.Title" />
                @Usual(draft, EventFieldKeys.Title, $"Usually “{draft.Every.Fields.Title}”.")
                <div class="field">
                    <span class="field__label">Time on this date</span>
                    <TimesEditor Timed="OnDate" />
                </div>
                @Usual(draft, EventFieldKeys.Time, $"Usually {UsualTime(draft)}.")
                <PlaceEditor Place="OnDate.Fields.Place" PlaceChanged="place => OnDate.Fields.Place = place" Used="_placesUsed" Missing="@(draft.Needs.Contains(EventFieldKeys.Place))" />
                @Usual(draft, EventFieldKeys.Place, draft.Every.Fields.Place is { } usual ? $"Usually at {PlaceName(usual)}." : "Usually no place.")
                <div class="field">
                    <span class="field__label" aria-hidden="true">About this date</span>
                    <RichTextEditor @key="_aboutVersion" Label="About this date" Value="@(OnDate.Fields.Description ?? new RichText())" ValueChanged="text => OnDate.Fields.Description = text" Rows="4"
                                    Placeholder="What's different this time" />
                </div>
                @Usual(draft, EventFieldKeys.Description, "This date has its own About.")
            </div>
            <div class="editor-foot @(InPanel ? "editor-foot--panel" : "")">
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                <div class="editor-foot__actions">
                    <SaveBar Block="true" Label="Save this date" Busy="_saving" OnSave="() => SaveAsync(draft.NotOnThisDate)" Blocked="@(OnDate.Fields.Title.Trim().Length == 0 ? "Give it a title to save it." : null)" State="SaveLine" SavedText="@SavedWords"
                             WaitingText="@EditWaiting.WaitingWords" FailedText="@EditWaiting.FailedWords" Detail="@Waiting?.Problem" Retry="() => Editing.RetryAsync(ItemKey)" />
                    <Button Variant="ButtonVariant.Quiet" Busy="_saving" OnClick="() => SaveAsync(!draft.NotOnThisDate)">@(draft.NotOnThisDate ? "On again" : "Not on this date")</Button>
                </div>
            </div>
        }
    </text>;

    private string? _stored;
    private string? _savedWords;

    private bool Changed => _draft is not null && _stored is not null && Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)) != _stored;

    private string ItemKey => EditKeys.Date(RegularEventId, EventDates.Format(Date));

    private EditWaiting? Waiting => _draft is null || Changed ? null : Editing.WaitingFor(ItemKey);

    private SaveState? SaveLine => Waiting?.State ?? SaveBar.For(Changed, _savedWords is not null);

    private string SavedWords => (_savedWords ?? "Saved").TrimEnd('.');

    private void Stored()
    {
        (_stored, _savedWords) = (_draft is null ? null : Fingerprint.Of(EventsContractsModel.Instance, SaveMessage(_draft)), null);
        _base = _draft is null ? null : EditSaves.Copy(SaveMessage(_draft));
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync(_draft!.NotOnThisDate);
        return _problem is null && !Changed;
    }

    private async Task LeaveAsync()
    {
        if (await Unsaved.MayLeaveAsync())
            await Closed.InvokeAsync();
    }

    private static DateSave SaveMessage(EventDraft draft) => draft.ToDateSave(draft.NotOnThisDate);

    private RenderFragment? Usual(EventDraft draft, string key, string words) => !draft.DateDiffers(key) ? null :
        @<p class="usual-line">@words <button type="button" class="usual-line__back" @onclick="() => PutBack(draft, key)">Put it back</button></p>;

    private static string UsualTime(EventDraft draft) => draft.Every.StartMinute is null ? "all day" : EventDates.Times(draft.Every.StartMinute, draft.Every.EndMinute);

    private static string PlaceName(EventPlace place) => place.Name.Length > 0 ? place.Name : place.Address;

    private void PutBack(EventDraft draft, string key)
    {
        draft.PutBack(key);
        if (key == EventFieldKeys.Description)
            _aboutVersion++;
    }

    private async Task SaveAsync(bool notOn)
    {
        if (_draft is not { } draft || _saving)
            return;
        _saving = true;
        _problem = null;
        bool wasShown = draft.WasShown;
        DateSave? before = _base;
        DateSave save = draft.ToDateSave(notOn);
        save.Base = before;
        EditSent sent = await Editing.SaveDateAsync(save);
        _saving = false;
        if (!sent.Succeeded)
        {
            _problem = sent.Problem;
            return;
        }
        draft.NotOnThisDate = notOn;
        Stored();
        await Shell.HapticAsync(Haptic.Success);
        _savedOccurrenceId = draft.OccurrenceId();
        if (wasShown && _savedOccurrenceId.Length > 0)
        {
            _tellTitle = notOn ? $"{OnDate.Fields.Title} isn't on" : $"Changed: {OnDate.Fields.Title}";
            _tellBody = notOn || before is null ? $"{EventWords.LongDate(Date)}."
                : FieldValues.ChangeNote(new Timed(before.Fields, before.StartMinute, before.EndMinute), new Timed(save.Fields, save.StartMinute, save.EndMinute));
            _telling = true;
            return;
        }
        await FinishAsync(TellPeopleSheet.SavedWords);
    }

    private async Task FinishAsync(string done)
    {
        _telling = false;
        _savedWords = done;
        await Saved.InvokeAsync(_savedOccurrenceId);
        if (!InPanel)
            await Closed.InvokeAsync();
    }
}
