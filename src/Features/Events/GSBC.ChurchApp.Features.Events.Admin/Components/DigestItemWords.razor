<section class="digest-words" aria-labelledby="digest-words-title">
    <header class="digest-words__head">
        <div class="digest-words__heading">
            <h2 id="digest-words-title">@(Item.Shown.Title.Length > 0 ? Item.Shown.Title : "New item")</h2>
            <span class="digest-words__note">@(Own ? "In the digest only, not on the calendar" : "Changes here apply to the digest only.")</span>
        </div>
        <button type="button" class="icon-btn" aria-label="Close" @onclick="Closed"><Icon Name="x" Size="IconSize.Small" /></button>
    </header>
    @foreach ((string field, string label, string? hint, bool multiline) in Fields)
    {
        <div class="digest-words__field @(!Own && Item.Changed.Contains(field) ? "digest-words__field--reworded" : "") digest-words__field--@field">
            <TextField Label="@label" Value="@Item.Shown[field]" ValueChanged="value => Set(field, value)" Multiline="multiline" Hint="@hint"
                       MaxLength="@(multiline ? 2000 : 200)" Type="@(field == DigestFields.Register ? "url" : "text")" />
            @if (!Own && Item.Changed.Contains(field))
            {
                <button type="button" class="digest-words__back" @onclick="() => PutBack(field)">@(field == DigestFields.Description ? "Back to the calendar's words" : "Use the calendar's wording")</button>
            }
        </div>
    }
    @if (Own)
    {
        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="x" OnClick="Removed">Remove from the digest</Button>
    }
    else if (Item.Missing.Count > 0)
    {
        <p class="digest-words__missing">The event in the calendar still needs @string.Join(" and ", Item.Missing.Select(EventWords.Need)). The digest says so until the event has it, unless you reword this item.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public required DigestItem Item { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Removed { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private bool Own => Item.Kind == DigestItemKind.Own;

    private IEnumerable<(string, string, string?, bool)> Fields =>
    [
        (DigestFields.Label, "Line above the title", null, false),
        (DigestFields.Title, "Title", null, false),
        (DigestFields.When, "When", Own ? "Write the day in words, such as “This Saturday, 14 November”." : null, false),
        (DigestFields.Time, "Time", null, false),
        (DigestFields.Description, "Description", "Leave a blank line to start a new paragraph.", true),
        (DigestFields.Register, "Registration link", "A web address for signing up. Adds a Register button.", false),
    ];

    private Task Set(string field, string value)
    {
        Item.Words = Item.Words.With(field, value);
        if (Own || value != Item.CalendarWords[field])
        {
            if (!Item.Changed.Contains(field))
                Item.Changed.Add(field);
        }
        else
            Item.Changed.Remove(field);
        return Changed.InvokeAsync();
    }

    private Task PutBack(string field)
    {
        Item.Changed.Remove(field);
        Item.Words = Item.Words.With(field, "");
        return Changed.InvokeAsync();
    }
}
