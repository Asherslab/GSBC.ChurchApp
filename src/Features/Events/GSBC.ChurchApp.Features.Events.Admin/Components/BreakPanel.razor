@inject CalendarEditing Editing

<UnsavedGuard Changed="() => Changed" What="this break" Save="SaveBeforeLeavingAsync" />

<div class="event-panel">
    <EventHead Day="@EventDates.Parse(_start)" Title="@(_name.Length > 0 ? _name : "New break")" When="@When" Compact="true" />
    <div class="event-body event-body--editing">
        <TextField Label="Name" Value="@_name" ValueChanged="value => _name = value" MaxLength="60" Required="true" Placeholder="Christmas break" Hint="Shown on the dates that aren't on." />
        <div class="ui-pair">
            <DateField Label="From" Value="@_start" ValueChanged="value => _start = value" />
            <DateField Label="To" Value="@_end" Min="@_start" ValueChanged="value => _end = value" />
        </div>
        @if (Break is { UsedBy.Count: > 0 } used)
        {
            <div class="field">
                <span class="field__label">Used by</span>
                <ul class="kept-list">
                    @foreach (string id in used.UsedBy)
                    {
                        <li>@(RegularEvents.GetValueOrDefault(id) ?? "A regular event in a calendar that's turned off")</li>
                    }
                </ul>
                <span class="field__hint">Changing the dates changes every one of these.</span>
            </div>
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </div>
    <div class="editor-foot editor-foot--panel">
        <div class="editor-foot__actions">
            <SaveBar Block="true" New="@(Break is null)" Label="@(Break is null ? "Add the break" : "Save")" Busy="_saving" OnSave="SaveAsync" Blocked="@Blocked" State="SaveBar.For(Changed, _saved)" />
            <Button Variant="ButtonVariant.Quiet" OnClick="Closed">Close</Button>
        </div>
        @if (Break is not null)
        {
            <button type="button" class="editor-foot__delete" @onclick="() => _deleting = true">Delete this break</button>
        }
    </div>
</div>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@($"Delete {Break?.Name}?")"
       Lead="@DeleteLead">
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_saving" OnClick="DeleteAsync">Delete the break</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private string _name = "";
    private string _start = "";
    private string _end = "";
    private string? _problem;
    private bool _saving, _deleting, _saved, _loaded;
    private BreakInfo? _loadedFrom;
    private (string Name, string Start, string End) _stored;

    [Parameter] public BreakInfo? Break { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> RegularEvents { get; set; } = new Dictionary<string, string>();
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private string DeleteLead => (Break?.UsedBy.Count ?? 0) switch
    {
        0 => "No regular event uses it. This can't be undone.",
        1 => "The regular event that pauses for it is on again on those dates. This can't be undone.",
        var count => $"The {count} regular events that pause for it are on again on those dates. This can't be undone.",
    };

    private string? Blocked =>
        _name.Trim().Length == 0 ? $"Give it a name to {(Break is null ? "add" : "save")} it."
        : EventDates.Parse(_start) is not { } start || EventDates.Parse(_end) is not { } end ? "Choose the day it starts and the day it ends."
        : end < start ? "It can't end before it starts."
        : null;

    private bool Changed => (_name, _start, _end) != _stored;

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        if (Blocked is not null)
            return false;
        await SaveAsync();
        return _problem is null;
    }

    private string? When => EventDates.Parse(_start) is { } start && EventDates.Parse(_end) is { } end ? $"{EventWords.Date(start)} to {EventWords.Date(end)}" : null;

    protected override void OnParametersSet()
    {
        if (_loaded && ReferenceEquals(_loadedFrom, Break))
            return;
        _saved = _saved && _loadedFrom?.Id == Break?.Id;
        (_loaded, _loadedFrom) = (true, Break);
        _name = Break?.Name ?? "";
        _start = Break?.StartDate ?? "";
        _end = Break?.EndDate ?? "";
        _stored = (_name, _start, _end);
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            await Editing.Setup.SaveBreakAsync(new BreakInfo { Id = Break?.Id ?? "", Name = _name.Trim(), StartDate = _start, EndDate = _end });
            (_stored, _saved) = ((_name, _start, _end), true);
            await Saved.InvokeAsync();
            if (Break is null)
                await Closed.InvokeAsync();
        });
    }

    private async Task DeleteAsync()
    {
        if (Break is null)
            return;
        await RunAsync(async () =>
        {
            await Editing.Setup.DeleteBreakAsync(new BreakRef { Id = Break.Id });
            _stored = (_name, _start, _end);
            _deleting = false;
            await Saved.InvokeAsync();
            await Closed.InvokeAsync();
        });
    }

    private async Task RunAsync(Func<Task> work)
    {
        _saving = true;
        _problem = null;
        try
        {
            await work();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        finally
        {
            _saving = false;
        }
    }
}
