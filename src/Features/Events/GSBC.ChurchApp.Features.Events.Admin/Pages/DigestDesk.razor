@page "/digest"
@using Grpc.Core
@using GSBC.ChurchApp.Platform.Common
@using GSBC.ChurchApp.Platform.Contracts.Destinations
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Ui.Content
@using GSBC.ChurchApp.Platform.Ui.Surfaces
@implements IDisposable
@inject CalendarEditing Editing
@inject IAccess Access
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject Shell Shell

<UnsavedGuard What="the digest" Autosave="() => _save" Save="SaveBeforeLeavingAsync" />
@inject IJSRuntime Js

<LiveData TValue="DigestDraft" Load="LoadAsync" Feeds="DeskFeeds" FailedTitle="The digest can't be opened right now">
    <ChildContent>@Drawn()</ChildContent>
    <Loading>
        <TitleBand Title="Weekly digest" BackHref="@CalendarBack" BackText="Calendar" />
        <Skeleton Shape="SkeletonShape.Lines" Count="8" />
    </Loading>
</LiveData>

@code {
    private static readonly IReadOnlyList<string> DeskFeeds = [EventsFeeds.Public, EventsFeeds.Digest];
    private static readonly IReadOnlyList<SegmentOption<DigestRange>> RangeOptions =
        [new(DigestRange.OneWeek, "1 week"), new(DigestRange.TwoWeeks, "2 weeks"), new(DigestRange.Month, "1 month"), new(DigestRange.Custom, "Other")];
    private static readonly IReadOnlyList<SegmentOption<bool>> PreviewOptions = [new(false, "In the app"), new(true, "Email")];
    private static readonly TimeSpan SettleTime = TimeSpan.FromMilliseconds(700);

    private const int EmailWidth = DigestEmail.Width;

    private DigestDraft? _draft;
    private ElementReference _emailFrame;
    private bool _emailFitted;
    private bool _includePrivate;
    private bool _notifyAgain;
    private DigestItem? _editing;
    private bool _editingNew;
    private Picking _picking;
    private bool _email;
    private SaveState _save = SaveState.Saved;
    private CancellationTokenSource? _settling;
    private string? _problem;
    private string? _told;
    private string? _busy;

    private string? CalendarBack => Access.CanSomewhere(EventsPermissions.Edit) ? CalendarWorkbenchLinks.Page : null;

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private DateOnly Today => EventWords.Today(Now);

    private async Task<DigestDraft> LoadAsync()
    {
        DigestDraft fresh = await Editing.Digest.OpenAsync(new DigestQuery { Id = _draft?.Id ?? "" });
        if (_draft is null || _save == SaveState.Saved)
            _draft = fresh;
        return fresh;
    }

    private RenderFragment Drawn() => _draft is not { } draft ? @<text></text> : @<text>
        <TitleBand Title="Weekly digest" BackHref="@CalendarBack" BackText="Calendar"
                   Lead="What you want people to know about in these weeks: things from the calendar, church news posts and anything else. Add them, put them in order, and reword them for the digest. The calendar and the posts keep their own words." />
        <Workbench DetailLabel="The preview" WideDetail="true" Class="digest-workbench">
        <ChildContent>
            <SaveStatus State="_save" SavedText="@(draft.SavedAt is null ? "Saves automatically" : "Saved")" Detail="@SentLine(draft)" Retry="SaveNowAsync" />

            <div class="digest-desk__choices">
                <DateField Label="From" Value="@draft.Start" ValueChanged="ChooseStartAsync" />
                <div class="field digest-desk__length">
                    <span class="field__label" aria-hidden="true">How long</span>
                    <Segmented TValue="DigestRange" Label="Covers" Options="RangeOptions" Value="draft.Range" ValueChanged="ChooseRangeAsync" />
                </div>
                @if (draft.Range == DigestRange.Custom)
                {
                    <DateField Label="To" Value="@draft.End" Min="@draft.Start" ValueChanged="ChooseEndAsync" />
                }
                <p class="digest-desk__range">@RangeOf(draft)</p>
            </div>

            @if (draft.Items.Count == 0)
            {
                <EmptyState Icon="@AppIcons.WeeklyDigest" Title="Nothing in this digest yet"
                            Body="Add what you want people to know about: something from the calendar, a church news post, or something else you write here." />
            }
            else
            {
                <ReorderList TItem="DigestItem" Items="draft.Items" Key="item => item.Key" Name="TitleOf" Label="What's in the digest" OnReordered="Reordered"
                             More="MoreFor" RowClass="@(item => item.Key == _editing?.Key ? "digest-row digest-row--chosen" : "digest-row")" Class="digest-order">
                    <ItemTemplate>
                        <button type="button" class="digest-row__open" aria-label="@($"Change {TitleOf(context)}")" @onclick="() => Edit(context)">
                            <span class="digest-row__thumb">
                                @if (context.Shown.Picture is { } picture)
                                {
                                    <MediaImage Media="picture" Size="MediaSizeName.Thumbnail" Alt="" />
                                }
                                else
                                {
                                    <span class="digest-row__no-picture @(context.Kind == DigestItemKind.NotOn ? "digest-row__no-picture--off" : "")">@(context.Kind == DigestItemKind.NotOn ? "Not on" : "No picture")</span>
                                }
                            </span>
                            <span class="digest-row__body">
                                <span class="digest-row__source"><Icon Name="@DigestDeskWords.SourceIcon(context)" Size="IconSize.Small" />@DigestDeskWords.Source(context)</span>
                                @if (context.Shown.Label.Length > 0 && context.Shown.Label != DigestDeskWords.Source(context))
                                {
                                    <span class="digest-row__label @(context.Kind == DigestItemKind.NotOn ? "digest-row__label--off" : "")">@context.Shown.Label</span>
                                }
                                <span class="digest-row__title">
                                    @TitleOf(context)
                                    @foreach ((string words, PillTone tone) in PillsOf(context))
                                    {
                                        <Pill Tone="tone">@words</Pill>
                                    }
                                </span>
                                @if (DetailOf(context) is { Length: > 0 } detail)
                                {
                                    <span class="digest-row__detail">@detail</span>
                                }
                                <span class="digest-row__when-below">@EventWords.Join(WhenOf(context), context.Shown.Time)</span>
                            </span>
                        </button>
                    </ItemTemplate>
                    <Trailing>
                        <span class="digest-row__when">@WhenOf(context)<small>@context.Shown.Time</small></span>
                    </Trailing>
                </ReorderList>
            }
            <div class="digest-desk__add">
                <Button Variant="ButtonVariant.Quiet" Small="true" Icon="@AppIcons.Calendar" OnClick="() => _picking = Picking.Calendar">From the calendar</Button>
                <Button Variant="ButtonVariant.Quiet" Small="true" Icon="@AppIcons.News" OnClick="() => _picking = Picking.News">A church news post</Button>
                <Button Variant="ButtonVariant.Quiet" Small="true" Icon="plus" OnClick="AddOwn">Something else</Button>
            </div>
        </ChildContent>
        <Detail>
            <div class="digest-desk__preview-head">
                <Segmented TValue="bool" Label="Preview" Options="PreviewOptions" Value="_email" ValueChanged="value => _email = value" />
                <span class="digest-desk__preview-hint" aria-live="polite">@(_email ? "Copy for email gives this as HTML. In Elvanto, start the email in the drag-and-drop builder, set Body → Content Width to 600px, add an HTML block with no padding and paste it in." : "Click a title in the app to change it.")</span>
            </div>
            @if (_email)
            {
                <div class="digest-desk__top">
                <Section Grouped="true" Title="Top of the email" Lead="An optional photo across the top, and what goes under it.">
                    <PictureField Label="Photo" Value="draft.TopPicture" ValueChanged="SetTopPictureAsync" Adding="Choose a photo" />
                    @if (draft.TopPicture is not null)
                    {
                        <Segmented TValue="DigestHeading" Label="Under the photo" ShowLabel="true" Options="HeadingOptions" Value="draft.Heading" ValueChanged="SetHeadingAsync" />
                    }
                </Section>
                </div>
                <div class="digest-desk__canvas digest-desk__canvas--email">
                    <iframe @ref="_emailFrame" class="digest-email" title="The email, as Copy for email gives it" srcdoc="@EmailPage(draft)" sandbox="allow-same-origin"
                            width="@EmailWidth"></iframe>
                </div>
            }
            else
            {
                <div class="digest-desk__canvas digest-desk__canvas--phone" data-fit-least="0.6">
                    <PhoneFrame Label="What's next in the app, as it looks once sent" Title="What's next" Bell="true" OnRoute="@EventsPlaces.Week">
                        <WhatsNextView Digest="AppDigest(draft)" Today="Today" Preview="true" OnPick="PickFromPreview" />
                    </PhoneFrame>
                </div>
            }
            <div class="digest-desk__foot">
                @if (_problem is not null)
                {
                    <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                }
                @if (draft is { NotifiedAt: { } notified, SentAsItIs: false })
                {
                    <ToggleRow Title="Notify people again" Description="@($"People were told about this digest {Ago(notified)}.")" Checked="_notifyAgain" CheckedChanged="value => _notifyAgain = value" />
                }
                @if (PrivateInEmail(draft) is { } privateNote)
                {
                    <ToggleRow Title="Include what isn't for everyone in the email" Description="@privateNote" Checked="_includePrivate" CheckedChanged="value => _includePrivate = value" />
                }
                <div class="digest-desk__send">
                    <p class="digest-desk__reach" role="status">@(_told ?? ReachLine(draft))</p>
                    <Button Variant="ButtonVariant.Quiet" Icon="copy" Busy="@(_busy == "copy")" Disabled="@(draft.Items.Count == 0)" OnClick="CopyForEmailAsync">Copy for email</Button>
                    <Button Icon="@(draft.SentAsItIs ? "check" : "send")" Busy="@(_busy == "send")" Disabled="@(draft.SentAsItIs || draft.Items.Count == 0)" OnClick="SendToAppAsync">@SendWords(draft)</Button>
                </div>
                @if (draft.SentAsItIs)
                {
                    <div class="digest-desk__test">
                        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="smartphone" Busy="@(_busy == "phone")" OnClick="SendToMyPhoneAsync">Send to my phone</Button>
                        <span>A test notification to you alone that opens What's next. Nobody else is told.</span>
                    </div>
                }
            </div>
        </Detail>
        </Workbench>
        @if (_editing is { } editing)
        {
            <DigestItemEditor @key="editing.Key" Item="editing" IsNew="_editingNew" Shareable="Shareable" OnSave="SaveItem" OnCancel="CloseEditor" OnRemove="() => Remove(editing)" />
        }
        @if (_picking == Picking.Calendar)
        {
            <DigestAddSheet Title="Add from the calendar" Lead="@($"Everything on the calendar {RangeOf(draft)}. Add as many as you like.")"
                            Groups="CalendarGroups(draft)" Added="AddedKeys(draft)" Detail="CalendarDetail" OnAdd="AddFromCalendar" OnClose="() => _picking = Picking.None"
                            EmptyIcon="@AppIcons.Calendar" EmptyTitle="Nothing on these calendars in these dates" EmptyBody="Choose other calendars above, or a longer range.">
                <Filter>
                    <div class="digest-add__calendars">
                        <span class="digest-add__calendars-label" aria-hidden="true">Calendars</span>
                        <ToggleChips TValue="string" Label="Calendars to show" Chips="Chips(draft)" Toggled="ToggleCalendarAsync" Quiet="true" />
                    </div>
                </Filter>
            </DigestAddSheet>
        }
        @if (_picking == Picking.News)
        {
            <DigestAddSheet Title="Add a church news post" Lead="Church news, newest first. In the app a post shows only to people who can see it."
                            Groups="NewsGroups(draft)" Added="AddedKeys(draft)" Detail="NewsDetail" OnAdd="AddPost" OnClose="() => _picking = Picking.None"
                            EmptyIcon="@AppIcons.News" EmptyTitle="No church news published yet" EmptyBody="Posts show here once they're published in Church news." />
        }
    </text>;

    private enum Picking
    {
        None,
        Calendar,
        News,
    }

    private static string TitleOf(DigestItem item) => item.Shown.Title.Trim().Length > 0 ? item.Shown.Title : "Untitled";

    private static string WhenOf(DigestItem item) =>
        item is { Kind: DigestItemKind.News, Shown.When.Length: 0 } ? DigestDeskWords.Posted(item) : item.Shown.When;

    private IReadOnlyList<MenuItem> MoreFor(DigestItem item) =>
    [
        this.Item("Change", () => Edit(item), "pencil", startsGroup: true),
        this.Item("Remove from the digest", () => Remove(item), "trash", danger: true, startsGroup: true),
    ];

    private static IReadOnlySet<string> AddedKeys(DigestDraft draft) => draft.Items.Select(item => item.Key).ToHashSet();

    private static IReadOnlyList<DigestPickGroup> CalendarGroups(DigestDraft draft) =>
        DigestDeskWords.ByDay(draft.Calendar.Where(item => item.CalendarIds.Any(draft.CalendarIds.Contains)));

    private static IReadOnlyList<DigestPickGroup> NewsGroups(DigestDraft draft) =>
        draft.Posts.Count == 0 ? [] : [new DigestPickGroup("Published posts", draft.Posts)];

    private static string CalendarDetail(DigestItem item) =>
        EventWords.Join(item.CalendarName == item.Shown.Title ? null : item.CalendarName, item.OccurrenceIds.Count > 1 ? item.Shown.When : null, item.Shown.Time, item.Place);

    private static string NewsDetail(DigestItem item) => DigestDeskWords.Posted(item);

    private string Shareable(string path) => DestinationPaths.Shareable(new Uri(Navigation.BaseUri), path);

    private static IReadOnlyList<ToggleChip<string>> Chips(DigestDraft draft) =>
        draft.Calendars.Select(calendar => new ToggleChip<string>(calendar.Id, calendar.Name, draft.CalendarIds.Contains(calendar.Id))).ToList();

    private static string RangeOf(DigestDraft draft) =>
        EventDates.Parse(draft.Start) is { } start && EventDates.Parse(draft.End) is { } end ? EventWords.Range(start, end) : "";

    private static IEnumerable<(string, PillTone)> PillsOf(DigestItem item)
    {
        if (item.Reworded)
            yield return ("Reworded", PillTone.Marker);
        if (DigestDeskWords.OnlyFor(item) is { } onlyFor)
            yield return (onlyFor, PillTone.Quiet);
        if (item.Missing.Count > 0)
            yield return ("Needs details", PillTone.Marker);
        if (item.Shown.RegisterLink.Length > 0)
            yield return ("Registration link", PillTone.Accent);
    }

    private static string DetailOf(DigestItem item)
    {
        return EventWords.Join(item.Place, item.Contacts.Length > 0 ? $"contact {item.Contacts}" : null) is { Length: > 0 } detail
            ? detail
            : item.Kind == DigestItemKind.NotOn ? "A date that isn't on" : "";
    }

    private string SentLine(DigestDraft draft)
    {
        if (draft.SentAt is { } sent)
            return draft.SentAsItIs ? $"sent to the app {Ago(sent)}" : $"changed since it went to the app {Ago(sent)}";
        return draft.LastSent is { } last && EventDates.Parse(last.Start) is { } start
            ? $"the one for {EventWords.Date(start)} went to the app {Ago(last.SentAt)}"
            : "not sent to the app yet";
    }

    private string Ago(DateTime utc)
    {
        DateTime at = ChurchTime.ToChurch(utc);
        DateOnly day = DateOnly.FromDateTime(at);
        return (Today.DayNumber - day.DayNumber) switch
        {
            0 => $"today at {ChurchDates.Time(at)}",
            1 => $"yesterday at {ChurchDates.Time(at)}",
            _ => $"on {EventWords.LongDate(day)}",
        };
    }

    private string SendWords(DigestDraft draft) => draft switch
    {
        { SentAsItIs: true } => "Sent to the app",
        { NotifiedAt: null } => "Send to the app and notify people",
        _ when _notifyAgain => "Send again and notify people",
        _ => "Send again without notifying",
    };

    private string? PrivateInEmail(DigestDraft draft)
    {
        List<DigestItem> only = draft.Items.Where(item => DigestDeskWords.OnlyFor(item) is not null).ToList();
        if (only.Count == 0)
            return null;
        List<string> calendars = only.Select(DigestDeskWords.WhoFor).Distinct().ToList();
        string names = calendars.Count == 1 ? calendars[0] : $"{string.Join(", ", calendars.Take(calendars.Count - 1))} and {calendars[^1]}";
        string things = only.Count == 1 ? "1 item" : $"{only.Count} items";
        return _includePrivate
            ? $"The email includes {things} only for {names}. Send it only to people they're for."
            : $"The email leaves out {things} only for {names}.";
    }

    private string ReachLine(DigestDraft draft)
    {
        if (draft.Items.Count == 0)
            return "Add at least one thing to send it to the app or copy it for email.";
        return draft switch
        {
            { SentAsItIs: true, NotifiedAt: { } notified } => $"The app shows this digest as it is now. People were notified {Ago(notified)}.",
            { SentAsItIs: true } => "The app shows this digest as it is now.",
            { NotifiedAt: null } => "Notifies everyone who'll see at least one item. Anyone in quiet hours is notified in the morning.",
            _ when _notifyAgain => "Notifies everyone who'll see it again.",
            _ => "",
        };
    }

    private WhatsNextDigest AppDigest(DigestDraft draft)
    {
        List<DigestShownItem> items = draft.Items.Select((item, order) => new DigestShownItem
        {
            Key = item.Key, Order = order, Kind = item.Kind, Words = item.Shown, Picture = item.Shown.Picture, Place = item.Place, Contacts = item.Contacts,
            Link = item.Link, Posted = item.Posted,
            OccurrenceId = item.OccurrenceIds.FirstOrDefault() ?? "", FirstDate = item.FirstDate, LastDate = item.LastDate,
        }).ToList();
        return new WhatsNextDigest(new DigestShown { Start = draft.Start, End = draft.End }, items);
    }

    private IReadOnlyList<EmailItem> EmailItems(DigestDraft draft) =>
        draft.Items.Where(item => DigestDeskWords.OnlyFor(item) is null || _includePrivate).Select(item => EmailItem.Of(item, Shareable)).ToList();

    private static string? TopPictureUrl(DigestDraft draft) => DigestEmail.PictureUrl(draft.TopPicture);

    private string AllEventsLink => DestinationPaths.Shareable(new Uri(Navigation.BaseUri), EventsPlaces.Week);

    private string EmailPage(DigestDraft draft) =>
        $"<!doctype html><html><head><meta charset=\"utf-8\"><base target=\"_blank\"></head><body style=\"margin:0;background:{DigestEmail.Behind}\">{DigestEmail.Html(RangeOf(draft), EmailItems(draft), AllEventsLink, TopPictureUrl(draft), draft.Heading)}</body></html>";

    private Task ChooseRangeAsync(DigestRange range) => ChooseAsync(draft => draft.Range = range);

    private Task ChooseStartAsync(string start) =>
        EventDates.Parse(start) is null ? Task.CompletedTask : ChooseAsync(draft => draft.Start = start);

    private Task ChooseEndAsync(string end) =>
        EventDates.Parse(end) is null ? Task.CompletedTask : ChooseAsync(draft => draft.End = end);

    private Task ChooseAsync(Action<DigestDraft> choose)
    {
        if (_draft is null)
            return Task.CompletedTask;
        choose(_draft);
        return SaveNowAsync();
    }

    private Task ToggleCalendarAsync(ToggleChip<string> chip)
    {
        if (_draft is null)
            return Task.CompletedTask;
        if (!_draft.CalendarIds.Remove(chip.Value))
            _draft.CalendarIds.Add(chip.Value);
        return SaveNowAsync();
    }

    private void Reordered(IReadOnlyList<DigestItem> order)
    {
        if (_draft is null)
            return;
        _draft.Items = [.. order];
        Change(() => { });
    }

    private void Edit(DigestItem item)
    {
        _editing = item;
        _editingNew = false;
    }

    private Task PickFromPreview(DigestShownItem shown)
    {
        if (_draft?.Items.FirstOrDefault(each => each.Key == shown.Key) is { } item)
            Edit(item);
        return Task.CompletedTask;
    }

    private void AddOwn()
    {
        _editing = new DigestItem
        {
            Key = $"{OwnPrefix}{Guid.NewGuid():N}", Kind = DigestItemKind.Own, Included = true, ForEveryone = true, Changed = [.. DigestFields.All],
        };
        _editingNew = true;
    }

    private void SaveItem(DigestItem saved)
    {
        if (_draft is null)
            return;
        int at = _draft.Items.FindIndex(item => item.Key == saved.Key);
        if (at >= 0)
            _draft.Items[at] = saved;
        else
            _draft.Items.Add(saved);
        CloseEditor();
        Change(() => { });
    }

    private void CloseEditor()
    {
        _editing = null;
        _editingNew = false;
    }

    private void AddFromCalendar(DigestItem picked)
    {
        if (_draft is null || _draft.Items.Any(item => item.Key == picked.Key))
            return;
        int before = _draft.Items.FindLastIndex(item => item.FirstDate.Length > 0 && string.CompareOrdinal(item.FirstDate, picked.FirstDate) <= 0);
        _draft.Items.Insert(before + 1, picked);
        Change(() => { });
    }

    private void AddPost(DigestItem picked)
    {
        if (_draft is null || _draft.Items.Any(item => item.Key == picked.Key))
            return;
        _draft.Items.Add(picked);
        Change(() => { });
    }

    private void Remove(DigestItem item)
    {
        _draft?.Items.RemoveAll(each => each.Key == item.Key);
        CloseEditor();
        Change(() => { });
    }

    private Task SetTopPictureAsync(MediaRef? picture) => ChooseAsync(draft => draft.TopPicture = picture);

    private Task SetHeadingAsync(DigestHeading heading) => ChooseAsync(draft => draft.Heading = heading);

    private static readonly IReadOnlyList<SegmentOption<DigestHeading>> HeadingOptions =
    [
        new(DigestHeading.TitleAndDates, "Title and dates"),
        new(DigestHeading.DatesOnly, "Just the dates"),
        new(DigestHeading.Nothing, "Nothing"),
    ];

    private const string OwnPrefix = "own:";

    private void Change(Action change)
    {
        change();
        _told = null;
        _problem = null;
        _save = SaveState.Waiting;
        _settling?.Cancel();
        _settling = new CancellationTokenSource();
        CancellationToken settling = _settling.Token;
        _ = Task.Delay(SettleTime, settling).ContinueWith(_ => InvokeAsync(SaveNowAsync), settling, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveNowAsync();
        return _save == SaveState.Saved;
    }

    private async Task SaveNowAsync()
    {
        if (_draft is not { } draft)
            return;
        if (_settling is { } settling)
            await settling.CancelAsync();
        _save = SaveState.Saving;
        StateHasChanged();
        try
        {
            DigestDraft saved = await Editing.Digest.SaveAsync(new DigestSave
            {
                Id = draft.Id, Start = draft.Start, End = draft.End, Range = draft.Range, CalendarIds = draft.CalendarIds, TopPicture = draft.TopPicture, Heading = draft.Heading,
                Entries = draft.Items.Select(item => new DigestEntry
                {
                    Key = item.Key, Included = true, Changed = item.Changed, Words = item.Words, Own = item.Kind == DigestItemKind.Own, PictureAt = item.PictureAt,
                }).ToList(),
            });
            if (_save == SaveState.Saving)
            {
                _draft = saved;
                _save = SaveState.Saved;
            }
        }
        catch (RpcException exception)
        {
            _save = SaveState.Failed;
            _problem = CalendarEditing.Problem(exception);
        }
        StateHasChanged();
    }

    private async Task CopyForEmailAsync()
    {
        if (_draft is not { } draft)
            return;
        _busy = "copy";
        string range = RangeOf(draft);
        bool copied;
        try
        {
            string html = DigestEmail.Html(range, EmailItems(draft), AllEventsLink, TopPictureUrl(draft), draft.Heading);
            copied = await Js.InvokeAsync<bool>("gsbcEvents.copyHtml", html, html);
        }
        catch (JSException)
        {
            copied = false;
        }
        _busy = null;
        _told = copied
            ? "Copied as HTML, ready to paste into Elvanto."
            : "Couldn't copy: this browser didn't allow it. Try again, or use Chrome, Edge or Safari.";
    }

    private async Task SendToAppAsync()
    {
        if (_draft is null)
            return;
        if (_save != SaveState.Saved)
            await SaveNowAsync();
        if (_save != SaveState.Saved || _draft is not { } draft)
            return;
        _busy = "send";
        try
        {
            bool notifies = draft.NotifiedAt is null || _notifyAgain;
            _draft = await Editing.Digest.SendToAppAsync(new DigestRef { Id = draft.Id, NotifyAgain = _notifyAgain });
            _notifyAgain = false;
            await Shell.HapticAsync();
            _told = notifies
                ? "Sent. The digest is on What's next, and everyone who will see it is being notified (after quiet hours, if it's late)."
                : "Sent. The digest is on What's next. Nobody was notified again.";
        }
        catch (RpcException exception)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        _busy = null;
    }

    private async Task SendToMyPhoneAsync()
    {
        if (_draft is not { } draft)
            return;
        _busy = "phone";
        try
        {
            await Editing.Digest.SendToMyPhoneAsync(new DigestRef { Id = draft.Id });
            _told = "Sent to your phone, marked Test. Tap the notification to open What's next.";
        }
        catch (RpcException exception)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        _busy = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_email == _emailFitted)
            return;
        _emailFitted = _email;
        if (_email)
            await Js.InvokeVoidAsync("gsbcEvents.fitEmail", _emailFrame, EmailWidth);
    }

    public void Dispose() => _settling?.Cancel();
}
