@page "/calendar"
@using GSBC.ChurchApp.Platform.Contracts.Configuration
@inject CalendarEditing Editing
@inject IPlacePeopleSource People
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject Shell Shell
@inject UnsavedChanges Unsaved
@inject WideningWords Widening

<PageTitle>Calendar · Good Shepherd admin</PageTitle>

<LiveData @ref="_live" TValue="WorkbenchView" Load="LoadAsync" Feeds="WorkbenchFeeds" FailedTitle="Can't load the calendar right now">
    <ChildContent>@Drawn(context.Value)</ChildContent>
    <Loading>
        <Workbench AsideLabel="Calendars" Class="calendar-workbench">
            <Aside><h1 class="calendar-aside__title">Calendar</h1><Skeleton Shape="SkeletonShape.Lines" Count="6" /></Aside>
            <ChildContent><Skeleton Shape="SkeletonShape.Lines" Count="8" /></ChildContent>
        </Workbench>
    </Loading>
</LiveData>

@code {
    private static readonly IReadOnlyList<string> WorkbenchFeeds = [EventsFeeds.Admin];
    private static readonly IReadOnlyList<SegmentOption<View>> AllViews = [new(View.Agenda, "Agenda"), new(View.Month, "Month")];
    private static readonly IReadOnlyList<TabOption<CalendarTab>> CalendarTabs =
        [new(CalendarTab.Events, "Events"), new(CalendarTab.Regular, "Regular events"), new(CalendarTab.People, "People"), new(CalendarTab.Settings, "Settings")];
    private const int FirstWeeks = 6;
    private const int MoreWeeks = 6;

    private enum Middle { All, Calendar, NeedsDetails, Asked, Breaks, NewCalendar }

    private enum View { Agenda, Month, Regular }

    private enum CalendarTab { Events, Regular, People, Settings }

    private abstract record Chosen;
    private sealed record ChosenEvent(EditTarget Target, string OccurrenceId) : Chosen;
    private sealed record NewEvent(string CalendarId, DateOnly? On) : Chosen;
    private sealed record ChosenDate(string CalendarId, string RegularEventId, DateOnly Date, string OccurrenceId) : Chosen;
    private sealed record ChosenRegular(string CalendarId, string? RegularEventId, RegularDate? Date = null) : Chosen;
    private sealed record ChosenBreak(BreakInfo? Break) : Chosen;
    private sealed record ShowingHere(CalendarInfo Calendar) : Chosen;

    private sealed record WorkbenchView(CalendarDesk Desk, IReadOnlyList<EventOccurrence> Agenda, NeedsDetailsList Needs, AskedList Asked, BreakList Breaks, IReadOnlyDictionary<ShowingRequest, string?> Widens);

    private LiveData<WorkbenchView>? _live;
    private Middle _middle = Middle.All;
    private string? _calendarKey;
    private View _view;
    private DateOnly? _monthFirst;
    private DateOnly? _monthDay;
    private int _weeks = FirstWeeks;
    private int _datesVersion;
    private HashSet<string>? _hidden;
    private Chosen? _chosen;
    private string? _problem;
    private string? _busy;
    private bool _readUrl;
    private CalendarTab _tab;
    private CalendarRemoveSheet? _removing;

    [SupplyParameterFromQuery(Name = "show")] public string? Show { get; set; }
    [SupplyParameterFromQuery(Name = "calendar")] public string? CalendarKey { get; set; }
    [SupplyParameterFromQuery(Name = "event")] public string? EventId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabKey { get; set; }
    [SupplyParameterFromQuery(Name = "settings")] public string? SettingsId { get; set; }
    [SupplyParameterFromQuery(Name = "break")] public string? BreakId { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private DateOnly Today => EventWords.Today(Now);

    private bool ShowingMonth => _view == View.Month;

    private DateOnly MonthFirst => _monthFirst ?? new DateOnly(Today.Year, Today.Month, 1);

    protected override async Task OnParametersSetAsync()
    {
        if (SettingsId is { Length: > 0 } settings)
        {
            Navigation.NavigateTo(CalendarWorkbenchLinks.Calendar(settings, CalendarWorkbenchLinks.SettingsTab), new NavigationOptions { ReplaceHistoryEntry = true });
            return;
        }
        string? shownBefore = ShownCalendarKey;
        View viewBefore = _view;
        _middle = Show switch
        {
            CalendarWorkbenchLinks.NeedsDetails => Middle.NeedsDetails,
            CalendarWorkbenchLinks.Asked => Middle.Asked,
            CalendarWorkbenchLinks.Breaks => Middle.Breaks,
            CalendarWorkbenchLinks.NewCalendar => Middle.NewCalendar,
            _ when CalendarKey is not null => Middle.Calendar,
            _ => Middle.All,
        };
        _calendarKey = CalendarKey;
        _tab = _middle != Middle.Calendar ? CalendarTab.Events : TabKey switch
        {
            CalendarWorkbenchLinks.RegularTab => CalendarTab.Regular,
            CalendarWorkbenchLinks.SettingsTab => CalendarTab.Settings,
            CalendarWorkbenchLinks.PeopleTab => CalendarTab.People,
            _ => CalendarTab.Events,
        };
        _view = _tab == CalendarTab.Regular ? View.Regular : _view == View.Regular ? View.Agenda : _view;
        if (_tab != CalendarTab.Events)
            _chosen = _chosen is ChosenRegular ? _chosen : null;
        _readUrl = EventId is null && BreakId is null;
        if (ShownCalendarKey != shownBefore || _view != viewBefore)
            await ReloadAsync();
    }

    private string? ShownCalendarKey => _middle == Middle.Calendar ? _calendarKey : null;

    private static DeskCalendar? Selectable(CalendarDesk desk, string? key) =>
        key is null ? null : desk.Calendars.FirstOrDefault(calendar => calendar.CanEdit && (calendar.Settings.Calendar.Slug == key || calendar.Settings.Calendar.Id == key));

    private DeskCalendar? SelectedCalendar(WorkbenchView view) => Selectable(view.Desk, ShownCalendarKey);

    private async Task<WorkbenchView> LoadAsync()
    {
        Task<CalendarDesk> desk = Editing.DeskAsync().AsTask();
        Task<NeedsDetailsList> needs = Editing.Editing.NeedsDetailsAsync(new Done()).AsTask();
        Task<AskedList> asked = Editing.Editing.AskedToPublishAsync(new Done()).AsTask();
        Task<BreakList> breaks = Editing.BreaksAsync().AsTask();
        await Task.WhenAll(desk, needs, asked, breaks);
        _hidden ??= [];
        List<string> shown = Selectable(desk.Result, ShownCalendarKey) is { } selected
            ? [selected.Settings.Calendar.Id]
            : desk.Result.Calendars.Where(calendar => calendar.CanEdit && !_hidden.Contains(calendar.Settings.Calendar.Id))
                .Select(calendar => calendar.Settings.Calendar.Id).ToList();
        (DateOnly from, DateOnly to) = ShowingMonth
            ? (EventWords.SundayOf(MonthFirst), EventWords.SundayOf(MonthFirst.AddMonths(1)).AddDays(6))
            : (Today, Today.AddDays(7 * _weeks));
        IReadOnlyList<EventOccurrence> agenda = shown.Count == 0 ? [] : (await Editing.AgendaAsync(shown, from, to)).Occurrences;
        Dictionary<ShowingRequest, string?> widens = [];
        foreach (ShowingRequest request in desk.Result.AskedToShow)
        {
            string home = request.HomeCalendarName.Length > 0 ? request.HomeCalendarName : "its own calendar";
            widens[request] = await Widening.SentenceAsync(request.Widens, request.NewlyReaches, request.NewlyReachesRoleIds, home);
        }
        WorkbenchView view = new(desk.Result, agenda, needs.Result, asked.Result, breaks.Result, widens);
        if (!_readUrl)
        {
            _readUrl = true;
            ChooseFromUrl(view);
        }
        return view;
    }

    private void ChooseFromUrl(WorkbenchView view)
    {
        EventOccurrence? found = view.Agenda.FirstOrDefault(occurrence => occurrence.Id == EventId)
            ?? view.Needs.Items.Select(item => item.Occurrence).FirstOrDefault(occurrence => occurrence.Id == EventId);
        if (found is not null)
            _chosen = ChosenFor(found);
        else if (view.Desk.CanManage && view.Breaks.Breaks.FirstOrDefault(entry => entry.Id == BreakId) is { } chosenBreak)
        {
            _middle = Middle.Breaks;
            _chosen = new ChosenBreak(chosenBreak);
        }
    }

    private Task ReloadAsync() => _live?.ReloadAsync() ?? Task.CompletedTask;

    private RenderFragment Drawn(WorkbenchView view) =>
        @<Workbench AsideLabel="Calendars" DetailLabel="@DetailLabel" Class="calendar-workbench" FoldAside="true" Showing="@Pane" Aside="Aside(view)" Detail="@(RegularSpans ? null : Detail(view))">
            @(_chosen is ChosenRegular regular ? Regular(regular) : Main(view))
        </Workbench>;

    private bool RegularSpans => _chosen is ChosenRegular { Date: null } || (_chosen is null && _middle == Middle.Calendar && _tab != CalendarTab.Events) || _middle == Middle.NewCalendar;

    private WorkbenchPane Pane => _chosen is null || RegularSpans ? WorkbenchPane.Main : WorkbenchPane.Detail;

    private string DetailLabel => _chosen switch
    {
        ChosenBreak => "Break",
        ChosenDate or ChosenRegular => "This date",
        ShowingHere => "Show an event from another calendar",
        _ => "Event",
    };

    private static Chosen ChosenFor(EventOccurrence occurrence) => occurrence.Kind == OccurrenceKind.OneOff
        ? new ChosenEvent(EditTarget.Of(occurrence), occurrence.Id)
        : new ChosenDate(occurrence.CalendarId, occurrence.ItemId, EventWords.DayOf(occurrence), occurrence.Id);

    private string? ChosenOccurrence => _chosen switch
    {
        ChosenEvent chosen => chosen.OccurrenceId,
        ChosenDate chosen => chosen.OccurrenceId,
        _ => null,
    };

    private RenderFragment Regular(ChosenRegular chosen) =>
        @<div class="calendar-regular">
            <Button Variant="ButtonVariant.Quiet" Small="true" Icon="chevron-left" Class="calendar-regular__back" OnClick="BackToRegularList">Regular events</Button>
            <RegularEventEditor @key="@(chosen.RegularEventId ?? $"new-{chosen.CalendarId}")" CalendarId="@chosen.CalendarId" RegularEventId="@chosen.RegularEventId" InPanel="true"
                                SelectedDate="@chosen.Date?.Date" DatesVersion="_datesVersion" Saved="id => RegularSavedAsync(chosen, id)" Closed="BackToRegularList"
                                DatePicked="date => Choose(chosen with { Date = date })" Organisers="Organisers" />
        </div>;

    private RenderFragment<string> Organisers => regularEventId =>
        @<PeopleRow @key="regularEventId" Source="People.For(ScopeKind.RegularEvent, regularEventId)" Label="Organisers"
                    SheetTitle="Organisers" SheetLead="Organisers are reminded when a date is missing what it needs." Empty="No one is reminded yet." />;

    private RenderFragment Aside(WorkbenchView view)
    {
        CalendarDesk desk = view.Desk;
        bool publishing = desk.Calendars.Any(calendar => calendar.Settings.NeedsPublisher) || view.Asked.Items.Count > 0 || desk.AskedToShow.Count > 0;
        return @<div class="calendar-aside">
            <h1 class="calendar-aside__title">Calendar</h1>
            <nav class="calendar-aside__group" aria-label="What to show">
                @AsideItem("All your calendars", null, _middle == Middle.All || (_middle == Middle.Calendar && SelectedCalendar(view) is null), () => Go(Middle.All))
                @AsideItem("Needs details", desk.NeedsDetails, _middle == Middle.NeedsDetails, () => Go(Middle.NeedsDetails))
                @if (publishing)
                {
                    @AsideItem("Asked to publish", desk.AskedToPublish + desk.AskedToShow.Count, _middle == Middle.Asked, () => Go(Middle.Asked))
                }
            </nav>
            <ReorderList TItem="DeskCalendar" Label="Your calendars" Class="calendar-aside__calendars" Items="desk.Calendars"
                         KeyOf="calendar => calendar.Settings.Calendar.Id" NameOf="calendar => calendar.Settings.Calendar.Name"
                         ItemClass="@(calendar => SelectedCalendar(view)?.Settings.Calendar.Id == calendar.Settings.Calendar.Id ? "calendar-aside__calendar is-chosen" : "calendar-aside__calendar")"
                         OnReorder="@(desk.CanManage ? EventCallback.Factory.Create<IReadOnlyList<DeskCalendar>>(this, OrderAsync) : default)">
                <Row Context="calendar">
                    @{
                        CalendarInfo info = calendar.Settings.Calendar;
                        bool on = calendar.CanEdit && !_hidden!.Contains(info.Id);
                        bool selected = SelectedCalendar(view)?.Settings.Calendar.Id == info.Id;
                    }
                    @if (calendar.CanEdit)
                    {
                        <button type="button" class="calendar-aside__name calendar-aside__name--pick" aria-current="@(selected ? "true" : null)" @onclick="() => GoToCalendar(calendar)">
                            @CalendarName(calendar)
                        </button>
                    }
                    else
                    {
                        <span class="calendar-aside__name">@CalendarName(calendar)</span>
                    }
                    @if (calendar.CanEdit && _middle == Middle.All)
                    {
                        <label class="switch switch--small">
                            <input type="checkbox" role="switch" checked="@on" aria-label="@($"Show {info.Name}")" @onchange="change => ToggleAsync(info.Id, change.Value is true)" />
                            <span aria-hidden="true"></span>
                        </label>
                    }
                </Row>
            </ReorderList>
            @if (desk.CanManage && desk.Calendars.Count > 1)
            {
                <p class="calendar-aside__tip">Drag a calendar by its handle to change the order everyone sees. With the keyboard: Alt ↑ or Alt ↓ on its handle.</p>
            }
            @if (desk.CanManage)
            {
                <button type="button" class="calendar-aside__add" aria-current="@(_middle == Middle.NewCalendar ? "true" : null)" @onclick="() => Go(Middle.NewCalendar)"><Icon Name="plus" Size="IconSize.Small" />New calendar</button>
            }
            <nav class="calendar-aside__group calendar-aside__group--foot" aria-label="Breaks">
                @AsideItem("Breaks", view.Breaks.Breaks.Count, _middle == Middle.Breaks, () => Go(Middle.Breaks), quietCount: true)
            </nav>
        </div>;
    }

    private static RenderFragment CalendarName(DeskCalendar calendar) =>
        @<span>
            @calendar.Settings.Calendar.Name
            @if (calendar.Settings.Calendar.ReadOnly)
            {
                <small>Copied from iCal</small>
            }
            else if (calendar.Settings.NeedsPublisher)
            {
                <small>Needs a publisher</small>
            }
        </span>;

    private RenderFragment AsideItem(string label, int? count, bool current, Func<Task> go, bool quietCount = false) =>
        @<button type="button" class="calendar-aside__item" aria-current="@(current ? "true" : null)" @onclick="go">
            <span>@label</span>
            @if (count is > 0)
            {
                <span class="@(quietCount ? "calendar-aside__quiet-count" : "count-capsule")">@count</span>
            }
        </button>;

    private RenderFragment Main(WorkbenchView view) => _middle switch
    {
        Middle.NeedsDetails => NeedsList(view),
        Middle.Asked => AskedLists(view),
        Middle.Breaks => BreaksList(view),
        Middle.NewCalendar when view.Desk.CanManage => NewCalendarPage,
        _ => SelectedCalendar(view) is { } selected ? CalendarPage(view, selected) : AgendaOrMonth(view, null),
    };

    private RenderFragment NewCalendarPage =>
        @<div>
            @MainHead("New calendar", "Name it and choose who it's for. Its events, regular events and people come after it's added.")
            <CalendarSettingsForm Saved="AddedAsync" Closed="() => Go(Middle.All)" />
        </div>;

    private RenderFragment CalendarPage(WorkbenchView view, DeskCalendar selected)
    {
        CalendarInfo info = selected.Settings.Calendar;
        IReadOnlyList<MenuItem> actions = view.Desk.CanManage
            ? [this.Item("Remove this calendar", () => _removing?.AskAsync() ?? Task.CompletedTask, "trash-2", "Says first what goes with it", danger: true)]
            : [];
        return @<div>
            <PaneHead Title="@info.Name" Lead="@CalendarLead(selected)" Actions="actions" Class="calendar-page__head" />
            <TabStrip TValue="CalendarTab" Label="@($"{info.Name}'s calendar")" Options="TabsFor(selected)" Value="_tab" Href="tab => CalendarWorkbenchLinks.Calendar(info.Slug, TabKeyOf(tab))" />
            @switch (_tab)
            {
                case CalendarTab.Settings:
                    <CalendarSettingsForm @key="info.Id" Calendar="selected" Saved="_ => ReloadAsync()" />
                    break;
                case CalendarTab.People:
                    <Section Grouped="true" First="true" Title="People on it" Lead="Editors add and change its events; Publishers also publish them. Calendar Managers and Owners can change every calendar without being on it.">
                        <CalendarPeople Calendar="selected" />
                    </Section>
                    break;
                default:
                    @AgendaOrMonth(view, selected)
                    break;
            }
            @if (view.Desk.CanManage)
            {
                <CalendarRemoveSheet @ref="_removing" @key="@($"remove-{info.Id}")" Calendar="selected" Removed="RemovedAsync" Failed="problem => _problem = problem" />
            }
        </div>;
    }

    private static IReadOnlyList<TabOption<CalendarTab>> TabsFor(DeskCalendar calendar) =>
        calendar.Settings.Calendar.ReadOnly ? [.. CalendarTabs.Where(tab => tab.Value != CalendarTab.Regular)] : CalendarTabs;

    private static string? TabKeyOf(CalendarTab tab) => tab switch
    {
        CalendarTab.Regular => CalendarWorkbenchLinks.RegularTab,
        CalendarTab.Settings => CalendarWorkbenchLinks.SettingsTab,
        CalendarTab.People => CalendarWorkbenchLinks.PeopleTab,
        _ => null,
    };

    private static string CalendarLead(DeskCalendar calendar) => EventWords.Join(
        WhoFor(calendar.Settings.Calendar.Audience),
        calendar.Settings.Calendar.ReadOnly ? "Copied from its iCal address" : calendar.Settings.NeedsPublisher ? "Needs a publisher" : null,
        calendar.Settings.Calendar.ShownOnNewPhones ? "Shown on new phones" : "Added from Browse calendars");

    private static string WhoFor(string audience) => audience == Audience.Everyone.Text ? "For everyone"
        : audience == Audience.SignedIn.Text ? "For anyone signed in"
        : "For chosen roles";

    private async Task AddedAsync(CalendarSettings added)
    {
        await ReloadAsync();
        Navigation.NavigateTo(CalendarWorkbenchLinks.Calendar(added.Calendar.Slug), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private RenderFragment MainHead(string title, string? lead, RenderFragment? actions = null) =>
        @<div class="calendar-main__head">
            <div>
                <h2 class="calendar-main__title">@title</h2>
                @if (lead is not null)
                {
                    <p class="calendar-main__lead">@lead</p>
                }
            </div>
            @actions
        </div>;

    private RenderFragment AgendaOrMonth(WorkbenchView view, DeskCalendar? selected)
    {
        DeskCalendar? into = selected switch
        {
            null => view.Desk.Calendars.FirstOrDefault(calendar => calendar is { CanEdit: true, Settings.Calendar.ReadOnly: false }),
            { Settings.Calendar.ReadOnly: true } => null,
            _ => selected,
        };
        string title = selected?.Settings.Calendar.Name ?? "All your calendars";
        string? lead = selected is { Settings.Calendar.ReadOnly: true } ? "Copied from its iCal address, so its events are changed there."
            : _view == View.Regular && selected is not null ? "Things on every week or month, such as services and groups. Choose one to change every date, or a date in it to change only that date."
            : null;
        RenderFragment actions = @<div class="calendar-main__actions">
            @if (selected is null || _tab == CalendarTab.Events)
            {
                <Segmented TValue="View" Label="What to show" Options="AllViews" Value="_view" ValueChanged="ShowViewAsync" />
            }
            @if (into is not null)
            {
                @if (selected is not null)
                {
                    <Button Variant="ButtonVariant.Quiet" Icon="calendar-plus" OnClick="() => Choose(new ShowingHere(into.Settings.Calendar))">From another calendar</Button>
                }
                <Menu Label="New event" Text="New event" Icon="plus" Variant="ButtonVariant.Primary"
                      Items="@([this.Item("Once", () => NewOnce(into), "calendar", "One date, or a few days in a row like a camp"),
                               this.Item("Regularly", () => NewRegular(into), "repeat", "Every week, every second week, monthly, or on dates you choose")])" />
            }
        </div>;
        if (view.Desk.Calendars.Count == 0)
            return @<div>
                @MainHead(title, null, actions)
                <EmptyState Icon="calendar" Title="No calendars you can change" Body="Someone who looks after the calendars can make you a Calendar editor of one." />
            </div>;
        return @<div>
            @if (selected is null)
            {
                @MainHead(title, lead, actions)
            }
            else
            {
                <div class="calendar-main__head calendar-main__head--in-tab">
                    <p class="calendar-main__lead">@lead</p>
                    @actions
                </div>
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            @switch (_view)
            {
                case View.Month:
                    @Month(view, selected)
                    break;
                case View.Regular when selected is not null:
                    <RegularEventsList CalendarId="@selected.Settings.Calendar.Id" OnPick="regular => Choose(new ChosenRegular(regular.CalendarId, regular.Id))" />
                    break;
                default:
                    @Agenda(view, selected)
                    break;
            }
        </div>;
    }

    private RenderFragment Agenda(WorkbenchView view, DeskCalendar? selected)
    {
        List<IGrouping<DateOnly, EventOccurrence>> days = view.Agenda.GroupBy(EventWords.DayOf).OrderBy(day => day.Key).ToList();
        return @<div class="calendar-agenda">
            @if (days.Count == 0)
            {
                <EmptyState Icon="calendar" Title="Nothing in the next few weeks" Body="@(selected is null ? "Turn on more calendars on the left, or add an event." : $"Nothing is on in {selected.Settings.Calendar.Name} in these weeks.")" />
            }
            @foreach (IGrouping<DateOnly, EventOccurrence> day in days)
            {
                <section class="calendar-day">
                    <h3 class="calendar-day__head">@EventWords.DayHeading(day.Key, Today) <span>@(day.Key == Today ? EventWords.LongDate(day.Key) : EventWords.Date(day.Key))</span></h3>
                    <div class="list">
                        @foreach (EventOccurrence occurrence in day)
                        {
                            @Row(view, occurrence)
                        }
                    </div>
                </section>
            }
            @if (Today.AddDays(7 * _weeks) < Today.AddMonths(EventsFeeds.MonthsAhead))
            {
                <Button Variant="ButtonVariant.Quiet" OnClick="MoreAsync">Show the next @MoreWeeks weeks</Button>
            }
        </div>;
    }

    private RenderFragment Row(WorkbenchView view, EventOccurrence occurrence) =>
        @<OccurrenceRow @key="occurrence.Id" Occurrence="occurrence" Calendar="CalendarOf(view, occurrence.CalendarId)" NowUtc="Now" ShowNeeds="true" ShowSaved="true"
                        NewChange="@(occurrence.ChangedAt is not null)" Selected="@(ChosenOccurrence == occurrence.Id)"
                        OnClick="() => Choose(ChosenFor(occurrence))" />;

    private RenderFragment Month(WorkbenchView view, DeskCalendar? calendar)
    {
        DateOnly selected = _monthDay ?? (MonthFirst.Month == Today.Month && MonthFirst.Year == Today.Year ? Today : MonthFirst);
        List<EventOccurrence> onDay = view.Agenda.Where(occurrence => EventWords.DayOf(occurrence) == selected).ToList();
        return @<div class="calendar-month">
            <div class="calendar-month__steps">
                <Button Variant="ButtonVariant.Quiet" Icon="chevron-left" AriaLabel="Previous month" Tooltip="Previous month" OnClick="() => StepMonthAsync(-1)" />
                <h3>@MonthFirst.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</h3>
                <Button Variant="ButtonVariant.Quiet" Icon="chevron-right" AriaLabel="Next month" Tooltip="Next month" OnClick="() => StepMonthAsync(1)" />
            </div>
            <MonthGrid First="MonthFirst" Today="Today" Occurrences="view.Agenda" Selected="selected" Picked="day => _monthDay = day" />
            <MonthKey />
            <section class="calendar-day">
                <h3 class="calendar-day__head">@EventWords.LongDate(selected)</h3>
                @if (onDay.Count == 0)
                {
                    <p class="hint">@(calendar is null ? "Nothing on in the calendars you've turned on." : $"Nothing on in {calendar.Settings.Calendar.Name}.")</p>
                }
                else
                {
                    <div class="list">
                        @foreach (EventOccurrence occurrence in onDay)
                        {
                            @Row(view, occurrence)
                        }
                    </div>
                }
            </section>
        </div>;
    }

    private RenderFragment NeedsList(WorkbenchView view) =>
        @<div>
            @MainHead("Needs details", "Dates of regular events still missing what they need. Their organisers are reminded until it's set.")
            @if (view.Needs.Items.Count == 0)
            {
                <EmptyState Icon="check" Title="Nothing needs details" Body="Every date coming up has what it needs." />
            }
            else
            {
                <div class="list">
                    @foreach (NeedsDetailsItem item in view.Needs.Items)
                    {
                        <OccurrenceRow @key="item.Occurrence.Id" Occurrence="item.Occurrence" Calendar="CalendarOf(view, item.Occurrence.CalendarId)" ShowNeeds="true"
                                       Selected="@(ChosenOccurrence == item.Occurrence.Id)"
                                       OnClick="() => Choose(ChosenFor(item.Occurrence))" />
                    }
                </div>
                <p class="hint">Days are counted to each date: @string.Join(", ", view.Needs.Items.Take(3).Select(item => $"{item.Occurrence.Fields.Title} in {Days(item.DaysToGo)}")).</p>
            }
        </div>;

    private static string Days(int days) => days switch { 0 => "less than a day", 1 => "1 day", _ => $"{days} days" };

    private RenderFragment AskedLists(WorkbenchView view) =>
        @<div>
            @MainHead("Asked to publish", "Events saved by editors who can't show them yet, and other calendars asking to show their events on yours.")
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            @if (view.Asked.Items.Count == 0 && view.Desk.AskedToShow.Count == 0)
            {
                <EmptyState Icon="check" Title="Nothing is waiting" Body="When an editor asks to publish, it shows here and you're told." />
            }
            @if (view.Asked.Items.Count > 0)
            {
                <h3 class="calendar-subhead">Waiting to publish</h3>
                <div class="list">
                    @foreach (AskedItem item in view.Asked.Items)
                    {
                        <ListRow Title="@item.Title" Subtitle="@EventWords.Join(CalendarOf(view, item.CalendarId)?.Name, $"asked {EventWords.Date(EventWords.Today(item.AskedAt))}")">
                            <TrailingContent>
                                <Button Small="true" Busy="@(_busy == (item.EventId ?? item.RegularEventId))" OnClick="() => PublishAsync(item)">Publish</Button>
                            </TrailingContent>
                        </ListRow>
                    }
                </div>
            }
            @AskedToShow(view, view.Desk.AskedToShow.Where(request => !request.AskedByOther).ToList(), "Asked to show on your calendar")
            @AskedToShow(view, view.Desk.AskedToShow.Where(request => request.AskedByOther).ToList(), "Asked to show your events on another calendar")
        </div>;

    private RenderFragment AskedToShow(WorkbenchView view, IReadOnlyList<ShowingRequest> requests, string heading) =>
        @<div>
            @if (requests.Count > 0)
            {
                <h3 class="calendar-subhead">@heading</h3>
                <div class="list">
                    @foreach (ShowingRequest request in requests)
                    {
                        <ListRow Title="@request.Title" Subtitle="@(request.AskedByOther ? $"{request.CalendarName} asks to show it from {request.HomeCalendarName}" : $"From {request.HomeCalendarName}, to show on {request.CalendarName}")">
                            <Below>
                                @if (view.Widens.GetValueOrDefault(request) is { } sentence)
                                {
                                    <span class="widening"><Icon Name="users" Size="IconSize.Small" />@sentence</span>
                                }
                            </Below>
                            <TrailingContent>
                                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="() => AnswerAsync(request, false)">@(request.AskedByOther ? "Not there" : "Not on ours")</Button>
                                <Button Small="true" Busy="@(_busy == request.Title)" OnClick="() => AnswerAsync(request, true)">@(request.AskedByOther ? "Show it there" : "Show it")</Button>
                            </TrailingContent>
                        </ListRow>
                    }
                </div>
            }
        </div>;

    private RenderFragment BreaksList(WorkbenchView view) =>
        @<div>
            @MainHead("Breaks", "Named breaks any regular event can use. Fixing a break's dates fixes every regular event using it.", view.Desk.CanManage ? NewBreak : null)
            @if (view.Breaks.Breaks.Count == 0)
            {
                <EmptyState Icon="calendar" Title="No breaks yet" Body="Add the school holidays or the Christmas break once, then choose them on each regular event." />
            }
            else
            {
                <div class="list">
                    @foreach (BreakInfo entry in view.Breaks.Breaks)
                    {
                        <ListRow Title="@entry.Name" Subtitle="@EventWords.Join(BreakDates(entry), Used(entry))" Class="@(_chosen is ChosenBreak { Break: { } open } && open.Id == entry.Id ? "row--selected" : null)"
                                 OnClick="() => ChooseBreak(view, entry)" />
                    }
                </div>
            }
        </div>;

    private RenderFragment NewBreak => @<Button Icon="plus" OnClick="() => Choose(new ChosenBreak(null))">New break</Button>;

    private static string BreakDates(BreakInfo entry) =>
        EventDates.Parse(entry.StartDate) is { } start && EventDates.Parse(entry.EndDate) is { } end
            ? $"{EventWords.Date(start)} to {EventWords.Date(end)}{(end.Year != start.Year ? $" {end.Year}" : "")}"
            : "";

    private static string Used(BreakInfo entry) => entry.UsedBy.Count switch
    {
        0 => "Not used yet",
        1 => "Used by 1 regular event",
        _ => $"Used by {entry.UsedBy.Count} regular events",
    };

    private RenderFragment Detail(WorkbenchView view) => _chosen switch
    {
        ChosenEvent chosen => @<EventEditor @key="chosen.OccurrenceId" Target="chosen.Target" InPanel="true" Saved="SavedAsync" Closed="CloseDetail" />,
        ChosenDate chosen => @<DateEditor @key="chosen.OccurrenceId" CalendarId="@chosen.CalendarId" RegularEventId="@chosen.RegularEventId" Date="chosen.Date" InPanel="true"
                                          Saved="SavedAsync" Closed="CloseDetail" OpenRegular="() => Choose(new ChosenRegular(chosen.CalendarId, chosen.RegularEventId))" />,
        ChosenRegular { Date: { } date } chosen when EventDates.Parse(date.Date) is { } day =>
            @<DateEditor @key="date.OccurrenceId" CalendarId="@chosen.CalendarId" RegularEventId="@(chosen.RegularEventId ?? string.Empty)" Date="day" InPanel="true"
                         Saved="_ => DateSavedAsync()" Closed="() => Choose(chosen with { Date = null })" OpenRegular="() => Choose(chosen with { Date = null })" />,
        NewEvent fresh => @<EventEditor @key="@($"new-{fresh.CalendarId}")" Target="EditTarget.New(fresh.CalendarId)" NewOn="fresh.On" InPanel="true" Saved="SavedNewAsync" Closed="CloseDetail" />,
        ShowingHere here => @<div class="event-panel" @key="@($"show-{here.Calendar.Id}")">
            <EventHead Title="Show an event from another calendar" Label="@here.Calendar.Name" Compact="true" />
            <div class="event-body">
                <ShowFromElsewhere Calendar="here.Calendar" Changed="ReloadAsync" />
            </div>
            <div class="editor-foot editor-foot--panel">
                <div class="editor-foot__actions"><Button Variant="ButtonVariant.Quiet" OnClick="CloseDetail">Close</Button></div>
            </div>
        </div>,
        ChosenBreak chosen => @<BreakPanel @key="@(chosen.Break?.Id ?? "new")" Break="chosen.Break" RegularEvents="RegularTitles(view)" Saved="ReloadAsync" Closed="CloseDetail" />,
        _ => @<div class="calendar-detail-empty">
            <EmptyState Icon="calendar" Title="Choose an event" Body="It opens here to change, in the same editor as the phone." />
        </div>,
    };

    private static IReadOnlyDictionary<string, string> RegularTitles(WorkbenchView view) =>
        view.Agenda.Where(occurrence => occurrence.Kind != OccurrenceKind.OneOff).GroupBy(occurrence => occurrence.ItemId)
            .ToDictionary(group => group.Key, group => group.First().Fields.Title);

    private static CalendarInfo? CalendarOf(WorkbenchView view, string id) =>
        view.Desk.Calendars.Select(calendar => calendar.Settings.Calendar).FirstOrDefault(calendar => calendar.Id == id);

    private async Task Choose(Chosen? chosen)
    {
        if (await Unsaved.MayLeaveAsync())
            _chosen = chosen;
    }

    private Task NewOnce(DeskCalendar into) => Choose(new NewEvent(into.Settings.Calendar.Id, ShowingMonth ? _monthDay : null));

    private Task NewRegular(DeskCalendar into) => Choose(new ChosenRegular(into.Settings.Calendar.Id, null));

    private async Task BackToRegularList()
    {
        if (!await Unsaved.MayLeaveAsync())
            return;
        _chosen = null;
        if (ShownCalendarKey is { } calendar)
            Navigation.NavigateTo(CalendarWorkbenchLinks.Calendar(calendar, CalendarWorkbenchLinks.RegularTab), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task DateSavedAsync()
    {
        _datesVersion++;
        await ReloadAsync();
    }

    private async Task RegularSavedAsync(ChosenRegular chosen, string regularEventId)
    {
        if (regularEventId.Length == 0)
            _chosen = null;
        else if (chosen.RegularEventId is null)
            _chosen = chosen with { RegularEventId = regularEventId };
        await ReloadAsync();
    }

    private async Task ChooseBreak(WorkbenchView view, BreakInfo entry)
    {
        if (view.Desk.CanManage)
            await Choose(new ChosenBreak(entry));
    }

    private Task CloseDetail() => Choose(null);

    private async Task RemovedAsync()
    {
        _chosen = null;
        _monthDay = null;
        Navigation.NavigateTo(CalendarWorkbenchLinks.Page, new NavigationOptions { ReplaceHistoryEntry = true });
        await ReloadAsync();
    }

    private async Task Go(Middle middle)
    {
        _problem = null;
        Navigation.NavigateTo(CalendarWorkbenchLinks.Showing(middle switch
        {
            Middle.NeedsDetails => CalendarWorkbenchLinks.NeedsDetails,
            Middle.Asked => CalendarWorkbenchLinks.Asked,
            Middle.Breaks => CalendarWorkbenchLinks.Breaks,
            _ => null,
        }), new NavigationOptions { ReplaceHistoryEntry = true });
        await Shell.HapticAsync();
    }

    private async Task GoToCalendar(DeskCalendar calendar)
    {
        _problem = null;
        _monthDay = null;
        Navigation.NavigateTo(CalendarWorkbenchLinks.Calendar(calendar.Settings.Calendar.Slug), new NavigationOptions { ReplaceHistoryEntry = true });
        await Shell.HapticAsync();
    }

    private async Task OrderAsync(IReadOnlyList<DeskCalendar> ordered)
    {
        _problem = null;
        try
        {
            await Editing.Setup.OrderCalendarsAsync(new CalendarOrder { CalendarIds = ordered.Select(calendar => calendar.Settings.Calendar.Id).ToList() });
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        await ReloadAsync();
    }

    private async Task ToggleAsync(string calendarId, bool on)
    {
        if (on)
            _hidden!.Remove(calendarId);
        else
            _hidden!.Add(calendarId);
        await ReloadAsync();
    }

    private async Task ShowViewAsync(View view)
    {
        _view = view;
        await ReloadAsync();
    }

    private async Task StepMonthAsync(int months)
    {
        _monthFirst = MonthFirst.AddMonths(months);
        _monthDay = null;
        await ReloadAsync();
    }

    private async Task MoreAsync()
    {
        _weeks += MoreWeeks;
        await ReloadAsync();
    }

    private async Task SavedAsync(string occurrenceId)
    {
        if (occurrenceId.Length == 0)
            _chosen = null;
        await ReloadAsync();
    }

    private async Task SavedNewAsync(string occurrenceId)
    {
        await ReloadAsync();
        _chosen = null;
    }

    private async Task PublishAsync(AskedItem item)
    {
        _busy = item.EventId ?? item.RegularEventId;
        _problem = null;
        try
        {
            await Editing.Editing.PublishAsync(new ItemRef { CalendarId = item.CalendarId, EventId = item.EventId, RegularEventId = item.RegularEventId });
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task AnswerAsync(ShowingRequest request, bool agree)
    {
        _busy = request.Title;
        _problem = null;
        try
        {
            if (request.AskedByOther)
                await Editing.Editing.AnswerAskToShowAsync(new AskToShowAnswer
                {
                    CalendarId = request.HomeCalendarId, OtherCalendarId = request.CalendarId, EventId = request.EventId, RegularEventId = request.RegularEventId, Agree = agree,
                });
            else
                await Editing.Editing.AnswerShowingAsync(new ShowingAnswer { CalendarId = request.CalendarId, EventId = request.EventId, RegularEventId = request.RegularEventId, Agree = agree });
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _problem = CalendarEditing.Problem(exception);
        }
        finally
        {
            _busy = null;
        }
    }
}
