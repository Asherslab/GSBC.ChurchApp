@if (Lines.Count > 0)
{
    <section class="panel-section" aria-labelledby="@Id">
        <h3 class="panel-subtitle" id="@Id">@Title</h3>
        <ul class="activity">
            @foreach (CountByLabel line in Lines)
            {
                <li><span class="health-where">@line.Label</span><span class="num">@line.Count</span></li>
            }
        </ul>
    </section>
}

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required List<CountByLabel> Lines { get; set; }
    [Parameter, EditorRequired] public required string Id { get; set; }
}
