@inject AccessClient Access
@inject IPeopleDirectory People
@inject IScopeNames ScopeNames

<LiveData @ref="_live" TValue="PersonView" Feeds="[AccessFeeds.Roles, .. ScopeNames.Feeds]" Load="LoadAsync" FailedTitle="Can't load what they can do">
    <header class="person-head">
        <h2 class="person-head__name">@context.Value.Person.Name</h2>
        <p class="person-head__email">@context.Value.Person.Email</p>
    </header>

    <div class="access-columns">
        <section class="editor-section" aria-labelledby="can-do">
            <h3 class="section__title" id="can-do">What can @FirstName(context.Value.Person) do?</h3>
            @if (context.Value.Abilities.Places.Count == 0)
            {
                <p class="panel-hint">@AccessWords.Nothing</p>
            }
            @foreach (PlaceAbilities place in context.Value.Abilities.Places)
            {
                <div class="access-place">
                    <h3 class="panel-subtitle">@(place.ObjectId is null ? "Everywhere" : PlaceLine(context.Value, place.ObjectId, place.IncludesTeams))</h3>
                    <p class="panel-hint">Because they're @string.Join(" and ", place.Because.Select(Reason))@(place.ObjectId is not null && context.Value.Places.Get(place.ObjectId) is { } named ? (context.Value.Places.Kinds[place.ObjectId] == ScopeKind.Draft.Name ? $" for “{named.Name}”" : $" of {named.Name}") : "").</p>
                    <AbilityList Nodes="place.Nodes" Catalog="context.Value.Catalog" EveryMinistry="place.ObjectId is null" />
                </div>
            }
        </section>

        <aside class="split-view__panel access-roles" aria-labelledby="their-roles">
            <h3 class="panel-title" id="their-roles">Their roles</h3>
            @if (context.Value.Assignments.Count == 0)
            {
                <p class="panel-hint">None yet.</p>
            }
            else
            {
                <ul class="holders">
                    @foreach (AssignmentInfo assignment in context.Value.Assignments)
                    {
                        <li>
                            <span>
                                <span class="cell-strong">@assignment.RoleName</span>
                                <span class="quiet">@(assignment.ScopeObjectId is { } place ? PlaceLine(context.Value, place, false) : "") @AccessWords.Until(assignment.ExpiresAt)</span>
                            </span>
                            <Button Small="true" Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="() => TakeAwayAsync(assignment)">Take away</Button>
                        </li>
                    }
                </ul>
            }

            <section class="panel-section" aria-label="Give a role">
                <div class="panel-form">
                    <SelectField Label="Give a role" Options="RoleOptions(context.Value)" @bind-Value="_roleId" />
                    @if (context.Value.Roles.FirstOrDefault(role => role.Id == _roleId) is { } chosen)
                    {
                        @if (chosen.ScopeKind != ScopeKind.Global.Name)
                        {
                            <TextField Label="@($"Which {chosen.ScopeKind}")" Value="@(_scopeObjectId ?? "")" ValueChanged="value => _scopeObjectId = value.Length == 0 ? null : value" />
                        }
                        <TextField Label="Until" Type="date" Value="@(_ends ?? "")" ValueChanged="value => _ends = value.Length == 0 ? null : value" Hint="Leave it empty to keep the role." />
                        <div>
                            <p class="panel-lead">@FirstName(context.Value.Person) will be able to:</p>
                            <AbilityList Nodes="chosen.AbilityNodes" Catalog="context.Value.Catalog" EveryMinistry="chosen.ScopeKind == ScopeKind.Global.Name" />
                        </div>
                        <Button Icon="check" Busy="_busy" OnClick="() => GiveAsync(context.Value.Person, chosen)">Give @FirstName(context.Value.Person) the @chosen.Name role</Button>
                    }
                </div>
            </section>
            <Notice Tone="NoticeTone.Warning" Text="@_message" />
            <Notice Text="@_done" />
        </aside>
    </div>
</LiveData>

@code {
    private LiveData<PersonView>? _live;
    private string _roleId = "";
    private string? _scopeObjectId;
    private string? _ends;
    private bool _busy;
    private string? _message;
    private string? _done;

    [Parameter, EditorRequired] public required string UserId { get; set; }

    private async Task<PersonView> LoadAsync()
    {
        Task<IReadOnlyList<PersonSummary>> person = People.GetAsync([UserId]);
        Task<AssignmentList> assignments = Access.ListAssignmentsAsync(UserId).AsTask();
        Task<PersonAbilities> abilities = Access.ExplainAsync(UserId).AsTask();
        Task<RoleList> roles = Access.ListRolesAsync().AsTask();
        Task<Catalog> catalog = Access.ListCatalogAsync().AsTask();
        List<AssignmentInfo> held = (await assignments).Assignments;
        List<RoleInfo> allRoles = (await roles).Roles;
        Places places = new();
        foreach (IGrouping<string, AssignmentInfo> kind in held.Where(assignment => assignment.ScopeObjectId is not null)
                     .GroupBy(assignment => allRoles.FirstOrDefault(role => role.Id == assignment.RoleId)?.ScopeKind ?? ScopeKind.Ministry.Name))
        {
            IReadOnlyDictionary<string, string> names = await ScopeNames.NamesAsync(kind.Key, kind.Select(assignment => assignment.ScopeObjectId!).Distinct().ToList());
            foreach (string objectId in kind.Select(assignment => assignment.ScopeObjectId!).Distinct())
                places.Add(objectId, kind.Key, names.GetValueOrDefault(objectId));
        }

        PersonSummary found = (await person).FirstOrDefault() ?? new PersonSummary(UserId, "Someone", "", false);
        return new PersonView(found, held, await abilities, places, allRoles, await catalog);
    }

    private static string FirstName(PersonSummary person) => person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? person.Name;

    private static string PlaceLine(PersonView view, string objectId, bool includesTeams) =>
        view.Places.Kinds.TryGetValue(objectId, out string? kind)
            ? AccessWords.PlaceOf(objectId, view.Places.Get(objectId)?.Name, kind, includesTeams)
            : AccessWords.PlaceOf(objectId, null, ScopeKind.Ministry.Name, includesTeams);

    private static IReadOnlyList<FieldOption> RoleOptions(PersonView view) =>
        [new("", "Choose a role…"), .. view.Roles.Select(role => new FieldOption(role.Id, $"{role.Name} · {AccessWords.GivenWhere(role)}"))];

    private static string Reason(PlaceReason reason) =>
        $"{(reason.RoleName.Length > 0 && "AEIOU".Contains(reason.RoleName[0]) ? "an" : "a")} {reason.RoleName}{(reason.ExpiresAt is null ? "" : $" ({AccessWords.Until(reason.ExpiresAt)})")}";

    private Task GiveAsync(PersonSummary person, RoleInfo role) => RunAsync(async () =>
    {
        await Access.AssignAsync(new AssignRequest
        {
            UserId = person.Id,
            RoleId = role.Id,
            ScopeObjectId = _scopeObjectId,
            ExpiresAt = DateTime.TryParse(_ends, out DateTime ends) ? ends.Date.AddDays(1).ToUniversalTime() : null,
        });
        _roleId = "";
        _scopeObjectId = null;
        _ends = null;
        _done = $"{person.Name} now has the {role.Name} role.";
    });

    private Task TakeAwayAsync(AssignmentInfo assignment) => RunAsync(async () =>
    {
        await Access.UnassignAsync(assignment.Id);
        _done = $"{assignment.RoleName} taken away.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        _done = null;
        try
        {
            await action();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _message = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Places
    {
        private readonly Dictionary<string, string> _names = [];

        public Dictionary<string, string> Kinds { get; } = [];

        public void Add(string objectId, string kind, string? name)
        {
            Kinds[objectId] = kind;
            if (name is not null && name != objectId)
                _names[objectId] = name;
        }

        public Place? Get(string objectId) => _names.TryGetValue(objectId, out string? name) ? new Place(name) : null;
    }

    private sealed record Place(string Name);

    private sealed record PersonView(PersonSummary Person, List<AssignmentInfo> Assignments, PersonAbilities Abilities, Places Places, List<RoleInfo> Roles, Catalog Catalog);
}
