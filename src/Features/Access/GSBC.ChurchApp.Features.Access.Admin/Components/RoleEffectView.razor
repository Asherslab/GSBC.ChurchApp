@inject IPeopleDirectory People
@inject IScopeNames ScopeNames

@if (Effect.People.Count == 0)
{
    <Notice>This doesn't change what anyone can do.</Notice>
}
else
{
    <Notice Tone="NoticeTone.Warning">This changes what @AccessWords.Holders(Effect.People.Count) can do.</Notice>
    <LiveData TValue="Names" Load="LoadAsync">
        <ul class="effect-list">
            @foreach (PersonEffect person in Effect.People)
            {
                <li>
                    <strong>@(context.Value.People.GetValueOrDefault(person.UserId) ?? "Someone")</strong>
                    @if (person.Gains.Count > 0)
                    {
                        <span class="effect-list__gains">Gains: @Describe(person.Gains, context.Value.Places)</span>
                    }
                    @if (person.Losses.Count > 0)
                    {
                        <span class="effect-list__losses">Loses: @Describe(person.Losses, context.Value.Places)</span>
                    }
                </li>
            }
        </ul>
    </LiveData>
}

@code {
    [Parameter, EditorRequired] public required RoleEffect Effect { get; set; }
    [Parameter, EditorRequired] public required Catalog Catalog { get; set; }

    private async Task<Names> LoadAsync()
    {
        Dictionary<string, string> people = (await People.GetAsync(Effect.People.Select(person => person.UserId).ToList())).ToDictionary(person => person.Id, person => person.Name);
        List<string> places = Effect.People.SelectMany(person => person.Gains.Concat(person.Losses)).Select(change => change.ObjectId).OfType<string>().Distinct().ToList();
        return new Names(people, await ScopeNames.NamesAsync(ScopeKind.Ministry.Name, places));
    }

    private string Describe(IEnumerable<AbilityChange> changes, IReadOnlyDictionary<string, string> places) =>
        string.Join("; ", changes.Select(change =>
            $"{Catalog.Permissions.FirstOrDefault(permission => permission.Node == change.Node)?.Description ?? change.Node}" +
            (change.ObjectId is { } place ? $" (in {places.GetValueOrDefault(place, place)})" : "")));

    private sealed record Names(Dictionary<string, string> People, IReadOnlyDictionary<string, string> Places);
}
