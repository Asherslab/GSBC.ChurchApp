@page "/access/roles"
@page "/access/roles/{Id}"
@inject AccessClient Access
@inject NavigationManager Navigation

<TitleBand Title="Roles" Lead="A role is a job someone does, such as Leader or Account manager. Choose one to see what it lets people do and who has it. To make a new role, copy the closest one." />

<LiveData @ref="_live" TValue="RolesView" Feeds="[AccessFeeds.Roles]" Load="LoadAsync" FailedTitle="Can't load roles right now">
    <SplitView Detail="@Detail(context.Value)" DetailLabel="@(Chosen(context.Value)?.Name ?? "Role")">
        <DataTable TItem="RoleInfo" Label="Roles" Items="Shown(context.Value.Roles)" Columns="Columns(context.Value.Roles)" Key="role => role.Id"
                   Selected="Chosen(context.Value)" SelectedChanged="Choose" SortColumn="0">
            <Toolbar>
                <SearchField Label="Find a role" Placeholder="Find a role" @bind-Value="_query" />
                <FilterChips TValue="RoleFilter" Label="Show" Options="Filters(context.Value.Roles)" @bind-Value="_filter" />
            </Toolbar>
            <Empty>
                <EmptyState Icon="shield" Title="No roles match" Body="Try another word, or show every role." />
            </Empty>
        </DataTable>
    </SplitView>
</LiveData>

@code {
    private LiveData<RolesView>? _live;
    private string _query = "";
    private RoleFilter _filter = RoleFilter.All;

    [Parameter] public string? Id { get; set; }

    private async Task<RolesView> LoadAsync()
    {
        Task<RoleList> roles = Access.ListRolesAsync().AsTask();
        Task<Catalog> catalog = Access.ListCatalogAsync().AsTask();
        return new RolesView((await roles).Roles, await catalog);
    }

    private RoleInfo? Chosen(RolesView view) => view.Roles.FirstOrDefault(role => role.Id == Id);

    private RenderFragment? Detail(RolesView view) => Chosen(view) is { } role
        ? @<RolePanel @key="role.Id" Role="role" Roles="view.Roles" Catalog="view.Catalog" OnDeleted="Deleted" />
        : null;

    private IEnumerable<RoleInfo> Shown(List<RoleInfo> roles) => roles.Where(role => Matches(role, _filter)
        && (_query.Length == 0 || role.Name.Contains(_query, StringComparison.CurrentCultureIgnoreCase) || role.Description.Contains(_query, StringComparison.CurrentCultureIgnoreCase)));

    private static bool Matches(RoleInfo role, RoleFilter filter) => filter switch
    {
        RoleFilter.BuiltIn => role.IsSystem,
        RoleFilter.MadeHere => !role.IsSystem,
        _ => true,
    };

    private static IReadOnlyList<FilterOption<RoleFilter>> Filters(List<RoleInfo> roles) =>
    [
        new(RoleFilter.All, "All", roles.Count),
        new(RoleFilter.BuiltIn, "Built in", roles.Count(role => role.IsSystem)),
        new(RoleFilter.MadeHere, "Made here", roles.Count(role => !role.IsSystem)),
    ];

    private static IReadOnlyList<TableColumn<RoleInfo>> Columns(List<RoleInfo> roles) =>
    [
        new("Role", role => @<span class="role-name"><span class="cell-strong">@role.Name</span>@if (!role.IsSystem) {<Pill Tone="PillTone.Accent">Made here</Pill>}</span>, role => role.Name),
        new("What it's for", role => @<span class="quiet">@role.Description</span>),
        new("Given", role => @<span class="quiet">@AccessWords.GivenWhere(role)</span>, role => AccessWords.GivenWhere(role), "optional"),
        new("Given by", role => @<span class="quiet">@AccessWords.GivenBy(role, roles)</span>, null, "optional"),
        new("People", role => @<span>@role.HolderCount</span>, role => role.HolderCount, "num"),
    ];

    private void Choose(RoleInfo role) => Navigation.NavigateTo($"access/roles/{role.Id}", new NavigationOptions { ReplaceHistoryEntry = true });

    private async Task Deleted()
    {
        Navigation.NavigateTo("access/roles");
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private sealed record RolesView(List<RoleInfo> Roles, Catalog Catalog);

    public enum RoleFilter
    {
        All,
        BuiltIn,
        MadeHere,
    }
}
