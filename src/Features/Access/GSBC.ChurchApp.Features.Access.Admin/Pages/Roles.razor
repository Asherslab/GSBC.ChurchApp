@page "/access/roles"
@inject AccessClient Access

<h1>Roles</h1>
<p>A role is a job someone does, such as Leader or Account manager. Open one to see what it lets people do.</p>

<Notice Tone="NoticeTone.Warning" Text="@_message" />

@foreach (RoleInfo role in _roles)
{
    <a class="account-panel role-card" href="access/roles/@role.Id">
        <strong>@role.Name</strong> @(role.IsSystem ? "" : "· made here")
        <span>@role.Description</span>
        <small>Given: @AccessWords.GivenWhere(role) · Given by: @AccessWords.GivenBy(role, _roles) · Held by: @AccessWords.Holders(role.HolderCount)</small>
    </a>
}

@code {
    private List<RoleInfo> _roles = [];
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _roles = (await Access.ListRolesAsync()).Roles;
        }
        catch (RpcException exception)
        {
            _message = exception.Status.Detail;
        }
    }
}
