@page "/access/people"
@inject IPeopleDirectory People
@inject NavigationManager Navigation

<Workbench AsideLabel="People" Showing="@(UserId is null ? WorkbenchPane.Aside : WorkbenchPane.Main)">
    <Aside>
        <h2 class="workbench__heading">People</h2>
        <SearchField Label="Find someone" Placeholder="Name or email" Value="@_query" ValueChanged="SearchAsync" />
        <LiveData @ref="_live" TValue="IReadOnlyList<PersonSummary>" Load="LoadAsync" FailedTitle="Can't find people right now">
            <DataTable TItem="PersonSummary" Label="People" Items="context.Value" Columns="Columns" Key="person => person.Id" Selected="Chosen(context.Value)" SelectedChanged="Choose" Class="data-table--list">
                <Empty>
                    <p class="panel-hint">No one matches “@_query”.</p>
                </Empty>
            </DataTable>
        </LiveData>
    </Aside>
    <ChildContent>
        @if (UserId is null)
        {
            <TitleBand Title="Who can do what" Lead="Choose someone to see what they can do and why, take a role away, or give them one." />
            <div class="admin-gate">
                <EmptyState Icon="key" Title="Choose someone on the left" Body="Their roles and everything those roles let them do will show here." />
            </div>
        }
        else
        {
            <PersonAccessPanel @key="UserId" UserId="@UserId" />
        }
    </ChildContent>
</Workbench>

@code {
    private LiveData<IReadOnlyList<PersonSummary>>? _live;
    private string _query = "";

    [SupplyParameterFromQuery(Name = "user")] public string? UserId { get; set; }

    private static readonly IReadOnlyList<TableColumn<PersonSummary>> Columns =
    [
        new("Name", person => @<span class="person-cell"><span class="cell-strong">@person.Name</span><span class="quiet">@person.Email</span></span>, person => person.Name),
    ];

    private Task<IReadOnlyList<PersonSummary>> LoadAsync() => People.SearchAsync(_query);

    private PersonSummary? Chosen(IReadOnlyList<PersonSummary> people) => people.FirstOrDefault(person => person.Id == UserId);

    private async Task SearchAsync(string query)
    {
        _query = query;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private void Choose(PersonSummary person) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("user", person.Id), new NavigationOptions { ReplaceHistoryEntry = true });
}
