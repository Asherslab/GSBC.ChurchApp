@page "/access/roles/new"
@page "/access/roles/{Id}/edit"
@inject AccessClient Access
@inject IAccess MyAccess
@inject NavigationManager Navigation

<Can Permission="AccessPermissions.EditRoles">
    <ChildContent>
        <LiveData TValue="EditorData" Load="LoadAsync" FailedTitle="Can't load this role">
            <TitleBand Title="@Title" BrowserTitle="@(IsNew ? "New role" : "Change a role")" BackHref="@($"access/roles/{Id ?? From}")" BackText="Roles"
                       Lead="Tick what this role lets people do. Nothing changes for anyone until you save." />
            @if (_draft is null)
            {
                <EmptyState Icon="shield" Title="@(IsNew ? "Choose a role to copy first" : "This role can't be changed here")" Body="@_missing">
                    <Button Variant="ButtonVariant.Quiet" Href="access/roles">Go to Roles</Button>
                </EmptyState>
            }
            else
            {
                <SplitView DetailLabel="Before you save">
                    <ChildContent>
                        <section class="editor-section" aria-labelledby="role-about">
                            <h2 class="section__title" id="role-about">About the role</h2>
                            <div class="editor-fields">
                                <TextField Label="Name" Value="@_draft.Name" ValueChanged="name => Change(() => _draft.Name = name)" Required="true" />
                                <TextField Label="What it's for" Value="@_draft.Description" ValueChanged="description => Change(() => _draft.Description = description)" Hint="One line staff will read when giving the role." />
                            </div>
                            <p class="editor-note"><strong>Given:</strong> @AccessWords.GivenWhere(_draft)</p>
                            @if (_draft.ScopeKind != ScopeKind.Global.Name)
                            {
                                <label class="choice">
                                    <input type="checkbox" checked="@_draft.AppliesToChildren" @onchange="() => Change(() => _draft.AppliesToChildren = !_draft.AppliesToChildren)" />
                                    <span>Also applies to the @_draft.ScopeKind's teams <span class="quiet">(a Music role also covers Choir)</span></span>
                                </label>
                            }
                        </section>

                        <section class="editor-section" aria-labelledby="role-abilities">
                            <h2 class="section__title" id="role-abilities">What it lets people do</h2>
                            <GroupedList Items="Offered(context.Value.Catalog)" GroupKey="ability => ability.Area" Context="ability">
                                <ItemTemplate>
                                    <label class="choice">
                                        <input type="checkbox" checked="@_draft.Patterns.Contains(ability.Node)"
                                               disabled="@(!CanGive(ability) && !_draft.Patterns.Contains(ability.Node))"
                                               @onchange="() => Change(() => Toggle(_draft.Patterns, ability.Node))" />
                                        <span>
                                            @ability.Description
                                            @if (!CanGive(ability))
                                            {
                                                <small class="choice__note">You can't do this yourself, so you can't give it.</small>
                                            }
                                            else if (ability.Sensitive)
                                            {
                                                <small class="choice__note">@AccessWords.Sensitive</small>
                                            }
                                        </span>
                                    </label>
                                </ItemTemplate>
                            </GroupedList>
                        </section>

                        <section class="editor-section" aria-labelledby="role-givers">
                            <h2 class="section__title" id="role-givers">Who can give it</h2>
                            <p class="section__lead">People who manage access always can. Also:</p>
                            <ul class="choice-list">
                                @foreach (RoleInfo other in context.Value.Roles.Where(other => other.Id != _draft.Id))
                                {
                                    <li>
                                        <label class="choice">
                                            <input type="checkbox" checked="@_draft.AssignableByRoleIds.Contains(other.Id)" @onchange="() => Change(() => Toggle(_draft.AssignableByRoleIds, other.Id))" />
                                            <span>@other.Name</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </section>
                    </ChildContent>
                    <Detail>
                        <h2 class="panel-title">Before you save</h2>
                        @if (_effect is null)
                        {
                            <p class="panel-lead">See whose abilities change, then save.</p>
                            <Button Icon="eye" Busy="_busy" OnClick="ReviewAsync">Check what changes</Button>
                        }
                        else
                        {
                            <RoleEffectView @key="_effect" Effect="_effect" Catalog="context.Value.Catalog" />
                            <div class="panel-actions">
                                <Button Icon="check" Busy="_busy" OnClick="SaveAsync">Save</Button>
                                <Button Variant="ButtonVariant.Quiet" Href="@($"access/roles/{Id ?? From}")">Cancel</Button>
                            </div>
                        }
                        <Notice Tone="NoticeTone.Warning" Text="@_message" />
                    </Detail>
                </SplitView>
            }
        </LiveData>
    </ChildContent>
    <Otherwise>
        <TitleBand Title="Roles" BackHref="access/roles" BackText="Roles" />
        <div class="admin-gate">
            <EmptyState Icon="lock" Title="Only people who manage roles can make or change them" />
        </div>
    </Otherwise>
</Can>

@code {
    [Parameter] public string? Id { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private RoleInfo? _draft;
    private string? _draftOf;
    private string _templateName = "";
    private string _missing = "";
    private RoleEffect? _effect;
    private bool _busy;
    private string? _message;

    private bool IsNew => Id is null;

    private string Title => _draft is null ? "Roles" : IsNew ? $"A new role, copied from {_templateName}" : $"Change {_draft.Name}";

    private IEnumerable<PermissionInfo> Offered(Catalog catalog) =>
        catalog.Permissions.Where(permission => _draft!.ScopeKind == ScopeKind.Global.Name || permission.ScopeKind == _draft.ScopeKind);

    private async Task<EditorData> LoadAsync()
    {
        Task<RoleList> roles = Access.ListRolesAsync().AsTask();
        Task<Catalog> catalog = Access.ListCatalogAsync().AsTask();
        EditorData data = new((await roles).Roles, await catalog);
        string? templateId = Id ?? From;
        if (_draftOf != templateId)
            _draft = Draft(data.Roles.FirstOrDefault(role => role.Id == templateId));
        _draftOf = templateId;
        return data;
    }

    private RoleInfo? Draft(RoleInfo? template)
    {
        if (template is null)
        {
            _missing = IsNew ? "Open the closest role on the Roles page and press Make a copy." : "That role no longer exists.";
            return null;
        }

        if (!IsNew && template.IsSystem)
        {
            _missing = "Built-in roles come from the app. Make a copy to change it.";
            return null;
        }

        _templateName = template.Name;
        return new RoleInfo
        {
            Id = IsNew ? "" : template.Id,
            Name = IsNew ? $"{template.Name} (copy)" : template.Name,
            Description = template.Description,
            ScopeKind = template.ScopeKind,
            Patterns = [.. template.AbilityNodes],
            AppliesToChildren = template.AppliesToChildren,
            AssignableByRoleIds = [.. template.AssignableByRoleIds],
        };
    }

    private bool CanGive(PermissionInfo ability) =>
        MyAccess.Can(new Permission(ability.Node, ScopeKind.TryParse(ability.ScopeKind, out ScopeKind kind) ? kind : ScopeKind.Global, ability.Description));

    private void Change(Action change)
    {
        change();
        _effect = null;
    }

    private static void Toggle(List<string> values, string value)
    {
        if (!values.Remove(value))
            values.Add(value);
    }

    private Task ReviewAsync() => RunAsync(async () => _effect = await Access.PreviewRoleAsync(_draft!));

    private Task SaveAsync() => RunAsync(async () =>
    {
        RoleInfo saved = await Access.SaveRoleAsync(_draft!);
        Navigation.NavigateTo($"access/roles/{saved.Id}");
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (RpcException exception)
        {
            _message = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record EditorData(List<RoleInfo> Roles, Catalog Catalog);
}
