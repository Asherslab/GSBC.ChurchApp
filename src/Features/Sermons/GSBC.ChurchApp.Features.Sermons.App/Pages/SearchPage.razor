@page "/sermons/search"
@inject SermonLibrary Library

<Page Title="Search sermons" BackHref="sermons" BackLabel="Sermons" TopBar="TopBarStyle.Solid">
    <div class="sermon-search">
        <SearchField Label="Search sermons" Placeholder="Title, series, speaker or day" @bind-Value="_text" SettleMilliseconds="150" AutoFocus="true" />
    </div>
    <LiveData TValue="SermonView" Load="Library.LoadAsync" Feeds="SermonLibrary.Feeds" ReloadOn="ChangeKind.Reconnected | ChangeKind.Session">
        <ChildContent>@Results(context.Value)</ChildContent>
        <Loading><Section First="true"><Skeleton Shape="SkeletonShape.Lines" Count="4" /></Section></Loading>
    </LiveData>
</Page>

@code {
    private const int MostShown = 60;
    private string _text = "";

    private RenderFragment Results(SermonView view)
    {
        string text = _text.Trim();
        if (text.Length == 0)
            return @<p class="hint sermon-search__hint">Search every sermon on this phone, even without a connection: try a series, a speaker, a word from a title, "Wednesday" or a month.</p>;

        List<SeriesInfo> series = view.Shelf.Series.Where(one => Matches(one.Name, text)).Take(6).ToList();
        List<SpeakerInfo> speakers = view.Shelf.Speakers.Where(one => Matches(one.Name, text)).Take(6).ToList();
        IReadOnlyList<Sermon> sermons = view.Shelf.Search(text);
        if (series.Count == 0 && speakers.Count == 0 && sermons.Count == 0)
            return @<EmptyState Icon="search" Title="@($"Nothing for “{text}”")" Body="Check the spelling, or try fewer words." />;

        return @<text>
            @if (series.Count > 0)
            {
                <Section Title="Series" First="true">
                    <ListGroup>
                        @foreach (SeriesInfo one in series)
                        {
                            <ListRow Title="@one.Name" Subtitle="@(one.Count == 1 ? "1 sermon" : $"{one.Count} sermons")" Href="@SermonsDestinations.Series.PathOf(one.Id).TrimStart('/')" Class="sermon-row">
                                <Leading><MediaCover Media="one.Thumbnail ?? one.Artwork" Class="sermon-row__thumb" /></Leading>
                            </ListRow>
                        }
                    </ListGroup>
                </Section>
            }
            @if (speakers.Count > 0)
            {
                <Section Title="Speakers" First="@(series.Count == 0)">
                    <ListGroup>
                        @foreach (SpeakerInfo one in speakers)
                        {
                            <ListRow Title="@one.Name" Subtitle="@(one.Count == 1 ? "1 sermon" : $"{one.Count} sermons")" Href="@SermonsDestinations.Speaker.PathOf(one.Id).TrimStart('/')">
                                <Leading><Avatar Name="@one.Name" Photo="one.Photo" Size="40" /></Leading>
                            </ListRow>
                        }
                    </ListGroup>
                </Section>
            }
            @if (sermons.Count > 0)
            {
                <Section Title="@(sermons.Count == 1 ? "1 sermon" : $"{sermons.Count} sermons")" First="@(series.Count == 0 && speakers.Count == 0)">
                    <ListGroup>
                        @foreach (Sermon sermon in sermons.Take(MostShown))
                        {
                            <SermonRow Sermon="sermon" Progress="view.ProgressOf(sermon)" />
                        }
                    </ListGroup>
                </Section>
            }
        </text>;
    }

    private static bool Matches(string name, string text) =>
        text.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(word => name.Contains(word, StringComparison.OrdinalIgnoreCase));
}
