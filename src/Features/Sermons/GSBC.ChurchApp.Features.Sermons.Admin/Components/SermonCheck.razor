
<UnsavedGuard Changed="() => Dirty" What="this sermon" Save="SaveBeforeLeavingAsync" />

<div class="sermon-check">
    <div class="sermon-check__head">
        <MediaCover Media="Detail.Sermon.Artwork" FallbackTitle="@Detail.Sermon.Title" Class="sermon-check__art" />
        <div class="sermon-check__intro">
            <h2>@Detail.Sermon.Title</h2>
            <p>@SermonText.Join(SermonText.LongDay(Detail.Sermon.PreachedAt), SermonText.Length(Detail.Sermon.DurationSeconds))</p>
            @if (Detail.CheckedAt is null && !Detail.Hidden)
            {
                <p class="sermon-check__reasons">@foreach (string reason in Detail.NeedsALook)
                {
                    <Pill Tone="@(reason == "Just uploaded" ? PillTone.Accent : PillTone.Marker)">@reason</Pill>
                }</p>
            }
            <AudioPreview Item="SermonPlayer.Item(Detail.Sermon)" />
        </div>
    </div>

    <div class="sermon-check__fields">
        <div class="sermon-check__field">
            <TextField Label="Title" @bind-Value="_title" MaxLength="160" />
        </div>
        <div class="sermon-check__field">
            <SearchPicker TItem="SpeakerDetail" Label="Speaker" Items="AllSpeakers" Text="SpeakerName" Detail="SermonCount" Value="SpeakerOf(_speakerId)"
                          ValueChanged="speaker => _speakerId = speaker?.Id ?? _speakerId" Placeholder="Find a speaker"
                          CreateText="@(name => $"Add “{name}” as a new speaker")" OnCreate="AddSpeakerAsync" />
        </div>
        <div class="sermon-check__field">
            <SearchPicker TItem="SeriesDetail" Label="Series" Items="AllSeries" Text="SeriesTitle" Detail="SeriesCount" Value="SeriesOf(_seriesId)"
                          ValueChanged="series => _seriesId = series?.Id ?? string.Empty" NoneText="Not in a series" Placeholder="Find a series"
                          CreateText="@(name => $"Start a new series called “{name}”")" OnCreate="AddSeriesAsync" />
            @if (_seriesId.Length == 0 && Detail.SuggestedSeries is { } suggested)
            {
                <button type="button" class="text-link" @onclick="() => PutInSeriesAsync(suggested)">Put it in “@suggested”</button>
            }
        </div>
        <div class="sermon-check__field">
            <ServicePicker Services="Services" @bind-Value="_service" />
        </div>
        <div class="sermon-check__field">
            <TextField Label="Bible passage" Placeholder="John 3:16-21" @bind-Value="_passage" MaxLength="120" />
        </div>
        <div class="sermon-check__field">
            <TextField Label="Video" Placeholder="A YouTube link" Hint="Paste the video's address; leave empty when there's no video." @bind-Value="_youTube" />
        </div>
        <div class="sermon-check__field sermon-check__field--wide">
            <TextField Label="About this sermon" Multiline="true" Hint="Optional: shown under the sermon in the app and on the website." @bind-Value="_summary" MaxLength="4000" />
        </div>
    </div>

    <Notice Tone="NoticeTone.Warning" Text="@_problem" />

    <div class="panel-actions">
        @if (Detail.CheckedAt is null && !Detail.Hidden)
        {
            <Button Icon="check" Busy="_busy" OnClick="() => SaveAsync(check: true)">@(Dirty ? "Save · looks right · next" : "Looks right · next")</Button>
        }
        else if (Dirty)
        {
            <Button Icon="check" Busy="_busy" OnClick="() => SaveAsync(check: false)">Save</Button>
        }
        @if (Dirty)
        {
            <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="Reset">Undo changes</Button>
        }
        @if (SaveBar.For(Dirty, _saved) is { } state)
        {
            <SaveStatus State="state" />
        }
        <Button Variant="ButtonVariant.Quiet" Icon="@(Detail.Hidden ? "eye" : "eye-off")" Disabled="_busy" OnClick="ToggleHiddenAsync">@(Detail.Hidden ? "Show in the app" : "Hide from the app")</Button>
        @if (Detail.Hidden)
        {
            <Button Variant="ButtonVariant.Danger" Disabled="_busy" OnClick="() => _deleting = true">Delete for good…</Button>
        }
    </div>
</div>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@($"Delete “{Detail.Sermon.Title}” for good?")"
       Lead="Its audio file is deleted, and so is everyone's listening progress on it. It comes off every phone the next time it connects. This can't be undone.">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete it</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private string _title = "", _speakerId = "", _seriesId = "", _service = "", _youTube = "", _passage = "", _summary = "";
    private bool _busy, _deleting, _saved;
    private string? _problem;
    private readonly List<SpeakerDetail> _addedSpeakers = [];
    private readonly List<SeriesDetail> _addedSeries = [];

    [Parameter, EditorRequired] public required SermonsAdminClient Sermons { get; set; }
    [Parameter, EditorRequired] public required SermonDetail Detail { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<SeriesDetail> Series { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<SpeakerDetail> Speakers { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<ServiceChoice> Services { get; set; }
    [Parameter] public EventCallback<SermonSaved> Saved { get; set; }
    [Parameter] public EventCallback Deleted { get; set; }

    protected override void OnInitialized() => Reset();

    private bool Dirty =>
        _title.Trim() != Detail.Sermon.Title || _speakerId != Detail.Sermon.SpeakerId || _seriesId != (Detail.Sermon.SeriesId ?? "")
        || _service.Trim() != Detail.Sermon.Service || YouTubeIds.Find(_youTube) != Detail.Sermon.YouTubeId
        || _passage.Trim() != Detail.Sermon.Passage || _summary.Trim() != Detail.Sermon.Summary;

    private IReadOnlyList<SpeakerDetail> AllSpeakers => [.. Speakers, .. _addedSpeakers.Where(added => Speakers.All(speaker => speaker.Id != added.Id))];

    private IReadOnlyList<SeriesDetail> AllSeries => [.. Series, .. _addedSeries.Where(added => Series.All(series => series.Id != added.Id))];

    private SpeakerDetail? SpeakerOf(string id) => AllSpeakers.FirstOrDefault(speaker => speaker.Id == id);

    private SeriesDetail? SeriesOf(string id) => AllSeries.FirstOrDefault(series => series.Id == id);

    private static string SpeakerName(SpeakerDetail speaker) => speaker.Name;

    private static string SeriesTitle(SeriesDetail series) => series.Name;

    private static string SermonCount(SpeakerDetail speaker) => SermonText.Sermons(speaker.Count);

    private static string SeriesCount(SeriesDetail series) => SermonText.Join(SermonText.Sermons(series.Count), series.LastAt is { } last ? SermonText.Month(last) : null);

    private async Task AddSpeakerAsync(string name)
    {
        if (await RunAsync(() => Sermons.SaveSpeakerAsync(new SpeakerDetail { Name = name }).AsTask()) is { } added)
        {
            _addedSpeakers.Add(added);
            _speakerId = added.Id;
        }
    }

    private async Task AddSeriesAsync(string name)
    {
        if (await RunAsync(() => Sermons.SaveSeriesAsync(new SeriesDetail { Name = name }).AsTask()) is { } added)
        {
            _addedSeries.Add(added);
            _seriesId = added.Id;
        }
    }

    private async Task<T?> RunAsync<T>(Func<Task<T>> work) where T : class
    {
        _problem = null;
        try
        {
            return await work();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
            return null;
        }
    }

    private void Reset()
    {
        _title = Detail.Sermon.Title;
        _speakerId = Detail.Sermon.SpeakerId;
        _seriesId = Detail.Sermon.SeriesId ?? "";
        _service = Detail.Sermon.Service;
        _youTube = Detail.Sermon.YouTubeId is { } video ? YouTubeIds.WatchUrl(video) : "";
        _passage = Detail.Sermon.Passage;
        _summary = Detail.Sermon.Summary;
        _problem = null;
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync(check: false);
        return _problem is null;
    }

    private Task SaveAsync(bool check) => SendAsync(new SermonCorrection
    {
        Id = Detail.Sermon.Id,
        Title = _title.Trim() != Detail.Sermon.Title ? _title : null,
        SpeakerId = _speakerId != Detail.Sermon.SpeakerId ? _speakerId : null,
        SeriesId = _seriesId != (Detail.Sermon.SeriesId ?? "") ? _seriesId : null,
        Service = _service.Trim() != Detail.Sermon.Service ? _service : null,
        YouTube = YouTubeIds.Find(_youTube) != Detail.Sermon.YouTubeId ? _youTube : null,
        Passage = _passage.Trim() != Detail.Sermon.Passage ? _passage : null,
        Summary = _summary.Trim() != Detail.Sermon.Summary ? _summary : null,
        Checked = check ? true : null,
    }, next: check);

    private Task ToggleHiddenAsync() => SendAsync(new SermonCorrection { Id = Detail.Sermon.Id, Hidden = !Detail.Hidden }, next: false);

    private async Task DeleteAsync()
    {
        _busy = true;
        _problem = null;
        try
        {
            await Sermons.DeleteSermonAsync(Detail.Sermon.Id);
            _deleting = false;
            await Deleted.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PutInSeriesAsync(string name)
    {
        SeriesDetail series = Series.FirstOrDefault(existing => string.Equals(existing.Name, name, StringComparison.OrdinalIgnoreCase))
            ?? await Sermons.SaveSeriesAsync(new SeriesDetail { Name = name });
        await SendAsync(new SermonCorrection { Id = Detail.Sermon.Id, SeriesId = series.Id }, next: false);
    }

    private async Task SendAsync(SermonCorrection correction, bool next)
    {
        _busy = true;
        _problem = null;
        try
        {
            SermonDetail saved = await Sermons.CorrectAsync(correction);
            _saved = true;
            await Saved.InvokeAsync(new SermonSaved(saved, next));
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
