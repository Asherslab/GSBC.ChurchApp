@inject SermonsAdminClient Sermons

<LiveData TValue="CopyProgress" Feeds="CopyFeeds" Load="() => Sermons.CopyingAsync().AsTask()" FailedTitle="Can't show the copying right now">
    @if (context.Value is { Total: > 0 } progress)
    {
        <div class="copying">
            <p class="copying__summary" aria-live="polite">
                @(progress.Copied == progress.Total
                    ? $"All {progress.Total} of the website's sermons are in the church's storage."
                    : $"Copying the website's audio into the church's storage: {progress.Copied} of {progress.Total} done.")
            </p>
            @if (progress.Copied < progress.Total)
            {
                <ProgressTrack Fraction="Overall(progress)" Label="Copying progress" />
            }
            @foreach (CopyItem item in progress.Items.Where(item => item.State is CopyStates.Copying or CopyStates.Failed))
            {
                <div class="copying__now @(item.State == CopyStates.Failed ? "is-failed" : "")">
                    <span class="copying__title">@item.Title</span>
                    <span class="copying__state">@StateOf(item)</span>
                    @if (item.State == CopyStates.Copying)
                    {
                        <ProgressTrack Fraction="FractionOf(item)" Label="@($"Copying {item.Title}")" />
                    }
                </div>
            }
            <details class="copying__each">
                <summary>Each sermon</summary>
                <ul>
                    @foreach (CopyItem item in progress.Items)
                    {
                        <li class="copying__row is-@item.State">
                            <span class="copying__title">@item.Title</span>
                            <span class="copying__state">@SermonText.Join(SermonText.Day(item.PreachedAt), StateOf(item))</span>
                        </li>
                    }
                </ul>
            </details>
            @if (progress.Note is { } note)
            {
                <span class="hint">@note</span>
            }
        </div>
    }
</LiveData>

@code {
    private static readonly IReadOnlyList<string> CopyFeeds = [SermonsFeeds.Copying, SermonsFeeds.Admin];

    private static double FractionOf(CopyItem item) => item.Bytes > 0 ? Math.Clamp((double)item.CopiedBytes / item.Bytes, 0, 1) : 0;

    private static double Overall(CopyProgress progress) =>
        (progress.Copied + progress.Items.Where(item => item.State == CopyStates.Copying).Sum(FractionOf)) / Math.Max(1, progress.Total);

    private static string StateOf(CopyItem item) => item.State switch
    {
        CopyStates.Copied => $"Copied · {Megabytes(item.Bytes)}",
        CopyStates.Copying => item.Bytes > 0 ? $"{Megabytes(item.CopiedBytes)} of {Megabytes(item.Bytes)}" : Megabytes(item.CopiedBytes),
        CopyStates.Failed => $"Couldn't copy: {item.Problem} It tries again in a minute.",
        _ => "Waiting",
    };

    private static string Megabytes(long bytes) => $"{bytes / 1024d / 1024d:0.0} MB";
}
