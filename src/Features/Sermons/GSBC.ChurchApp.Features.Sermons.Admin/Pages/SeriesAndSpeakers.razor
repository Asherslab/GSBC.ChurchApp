@page "/sermons/series-and-speakers"
@inject SermonsAdminClient Sermons
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="@(_speaker is null ? "this series" : "this speaker")" Save="SaveBeforeLeavingAsync" />

<TitleBand Title="Series and speakers" BackHref="sermons" BackText="Sermons"
           Lead="Name a series, give it a picture and a line about it; keep the list of speakers, with their names and photos." />

<LiveData @ref="_live" TValue="Lists" Feeds="ListFeeds" Load="LoadAsync" FailedTitle="Can't load series and speakers right now">
    <div class="series-desk">
        <section aria-label="Series">
            <div class="series-desk__head">
                <h2>Series</h2>
                <Can Permission="SermonsPermissions.Edit">
                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="plus" OnClick="() => OpenAsync(NewSeries)">New series</Button>
                </Can>
            </div>
            <SearchField Label="Find a series" Placeholder="Find a series" Value="@_seriesQuery" ValueChanged="query => _seriesQuery = query" />
            <div class="series-desk__list">
                @foreach (SeriesDetail series in Matching(context.Value.Series, _seriesQuery, one => one.Name))
                {
                    <button type="button" class="sermon-pick @(_series?.Id == series.Id && _series.Id.Length > 0 ? "is-selected" : "")" @onclick="() => OpenAsync(() => EditSeries(series))">
                        <MediaCover Media="series.Artwork" Size="MediaSizeName.Thumbnail" FallbackTitle="@series.Name" Class="sermon-pick__thumb" />
                        <span class="sermon-pick__words">
                            <strong>@series.Name</strong>
                            <span>@SermonText.Join(SermonText.Sermons(series.Count), series.LastAt is { } last ? SermonText.Month(last) : null)</span>
                        </span>
                    </button>
                }
                @if (_seriesQuery.Length > 0 && !Matching(context.Value.Series, _seriesQuery, one => one.Name).Any())
                {
                    <p class="series-desk__none">No series called “@_seriesQuery”.</p>
                }
            </div>
        </section>
        <section aria-label="Speakers">
            <div class="series-desk__head">
                <h2>Speakers</h2>
                <Can Permission="SermonsPermissions.Edit">
                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="plus" OnClick="() => OpenAsync(NewSpeaker)">New speaker</Button>
                </Can>
            </div>
            <SearchField Label="Find a speaker" Placeholder="Find a speaker" Value="@_speakerQuery" ValueChanged="query => _speakerQuery = query" />
            <div class="series-desk__list">
                @foreach (SpeakerDetail speaker in Matching(context.Value.Speakers, _speakerQuery, SpeakerName))
                {
                    <button type="button" class="sermon-pick @(_speaker?.Id == speaker.Id && _speaker.Id.Length > 0 ? "is-selected" : "")" @onclick="() => OpenAsync(() => EditSpeaker(speaker))">
                        <Avatar Name="@speaker.Name" Photo="speaker.Photo" Size="40" />
                        <span class="sermon-pick__words">
                            <strong>@speaker.Name</strong>
                            <span>@SermonText.Sermons(speaker.Count)</span>
                        </span>
                    </button>
                }
                @if (_speakerQuery.Length > 0 && !Matching(context.Value.Speakers, _speakerQuery, SpeakerName).Any())
                {
                    <p class="series-desk__none">No speaker called “@_speakerQuery”.</p>
                }
            </div>
        </section>
        <section class="series-desk__edit" aria-label="Edit">
            @if (_series is { } editing)
            {
                <h2>@(editing.Id.Length == 0 ? "A new series" : editing.Name)</h2>
                <TextField Label="Name" @bind-Value="_name" MaxLength="80" />
                <TextField Label="About the series" Multiline="true" Hint="Optional: shown on the series in the app." @bind-Value="_description" MaxLength="600" />
                <span class="field__label">Picture</span>
                <div class="sermon-picture">
                    <div class="sermon-upload__art">
                        <MediaCover Media="ShownArtwork(editing)" Size="MediaSizeName.Thumbnail" FallbackTitle="@_name" />
                        <span class="series-desk__picture-actions">
                            <Button Variant="ButtonVariant.Quiet" Small="true" Icon="image" OnClick="() => _choosing = true">@(ShownArtwork(editing) is null ? "Choose a picture" : "Use another picture")</Button>
                            @if (ShownArtwork(editing) is not null)
                            {
                                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="RemovePicture">Remove the picture</Button>
                            }
                        </span>
                    </div>
                    @if (ShownArtwork(editing) is { } artwork)
                    {
                        <MediaShownAt Media="artwork" Size="SeriesSize" />
                    }
                </div>
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                <div class="panel-actions">
                    <SaveBar Label="@(editing.Id.Length == 0 ? "Add the series" : "Save")" Busy="_busy" OnSave="SaveSeriesAsync" State="SaveBar.For(Changed, _saved)"
                             Blocked="@(_name.Trim().Length == 0 ? $"Give it a name to {(editing.Id.Length == 0 ? "add" : "save")} it." : null)">
                        <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => OpenAsync(Close)">Cancel</Button>
                    </SaveBar>
                </div>
                @if (editing.Id.Length > 0)
                {
                    <div class="series-desk__delete">
                        <Button Variant="ButtonVariant.Danger" Small="true" Disabled="_busy" OnClick="AskToDeleteSeriesAsync">Delete this series…</Button>
                    </div>
                }
            }
            else if (_speaker is { } speaker)
            {
                <h2>@(speaker.Id.Length == 0 ? "A new speaker" : speaker.Name)</h2>
                <TextField Label="Name" @bind-Value="_name" MaxLength="80" Hint="As it shows in the app, for example “Ps Jo Ellery”." />
                <span class="field__label">Photo</span>
                <div class="series-desk__photo">
                    <Avatar Name="@_name" Photo="ShownPhoto(speaker)" Size="72" />
                    <span class="sermon-picture__side">
                        @if (ShownPhoto(speaker) is { } photo)
                        {
                            <MediaShownAt Media="photo" Size="MediaSizeName.Thumbnail" />
                        }
                        <span class="series-desk__picture-actions">
                            <Button Variant="ButtonVariant.Quiet" Small="true" Icon="image" OnClick="() => _choosing = true">@(ShownPhoto(speaker) is null ? "Choose a photo" : "Use another photo")</Button>
                            @if (ShownPhoto(speaker) is not null)
                            {
                                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="RemovePicture">Remove the photo</Button>
                            }
                        </span>
                    </span>
                </div>
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                <div class="panel-actions">
                    <SaveBar Label="@(speaker.Id.Length == 0 ? "Add the speaker" : "Save")" Busy="_busy" OnSave="SaveSpeakerAsync" State="SaveBar.For(Changed, _saved)"
                             Blocked="@(_name.Trim().Length == 0 ? $"Give them a name to {(speaker.Id.Length == 0 ? "add" : "save")} them." : null)">
                        <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => OpenAsync(Close)">Cancel</Button>
                    </SaveBar>
                </div>
                @if (speaker.Id.Length > 0)
                {
                    <div class="series-desk__delete">
                        <Button Variant="ButtonVariant.Danger" Small="true" Disabled="_busy" OnClick="() => _deleting = true">Delete this speaker…</Button>
                    </div>
                }
            }
            else
            {
                <EmptyState Icon="layers" Title="Choose a series or a speaker" Body="Changes show on everyone's phone as soon as they're saved." />
            }
            @if (_choosing)
            {
                <MediaChooser ImagesOnly="true" Size="@(_speaker is null ? SeriesSize : MediaSizeName.Thumbnail)" OnChosen="Chose" OnCancel="() => _choosing = false" />
            }
        </section>
    </div>
    <Sheet Open="_deleting" OpenChanged="open => { if (!open) StopDeleting(); }" Title="@DeleteTitle">
        <ChildContent>
            @if (_speaker is { Id.Length: > 0 } doomedSpeaker)
            {
                @if (doomedSpeaker.Count > 0)
                {
                    <p class="sheet__lead">@SermonText.Sermons(doomedSpeaker.Count) @(doomedSpeaker.Count == 1 ? "is" : "are") credited to them.</p>
                    <SearchPicker TItem="SpeakerDetail" Label="Where their sermons go" Items="OtherSpeakers(context.Value, doomedSpeaker)" Text="SpeakerName" Detail="SpeakerCount"
                                  Value="_moveSpeakerTo" ValueChanged="speaker => _moveSpeakerTo = speaker" NoneText="Leave them without a speaker" Placeholder="Find a speaker" />
                }
                @foreach (string line in DeletionWords.Speaker(doomedSpeaker, _moveSpeakerTo))
                {
                    <p class="sheet__lead">@line</p>
                }
            }
            else if (_series is { Id.Length: > 0 } doomedSeries && _seriesDeletion is { } deletion)
            {
                @if (deletion.Sermons > 0)
                {
                    <p class="sheet__lead">@SermonText.Sermons(deletion.Sermons) @(deletion.Sermons == 1 ? "is" : "are") in it.</p>
                    <SearchPicker TItem="SeriesDetail" Label="Where its sermons go" Items="OtherSeries(context.Value, doomedSeries)" Text="SeriesName" Detail="SeriesCount"
                                  Value="_moveSeriesTo" ValueChanged="series => _moveSeriesTo = series" NoneText="Leave them not in a series" Placeholder="Find a series" />
                }
                @foreach (string line in DeletionWords.Series(deletion, _moveSeriesTo))
                {
                    <p class="sheet__lead">@line</p>
                }
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        </ChildContent>
        <Actions>
            <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" Disabled="@(_speaker is null && _seriesDeletion is null)" OnClick="DeleteAsync">@DeleteButton</Button>
            <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="StopDeleting">Keep it</Button>
        </Actions>
    </Sheet>
</LiveData>

@code {
    private static readonly IReadOnlyList<string> ListFeeds = [SermonsFeeds.Admin, SermonsFeeds.Series, SermonsFeeds.Speakers];
    private const MediaSizeName SeriesSize = MediaSizeName.ForPhones;

    private sealed record Lists(IReadOnlyList<SeriesDetail> Series, IReadOnlyList<SpeakerDetail> Speakers);

    private LiveData<Lists>? _live;
    private SeriesDetail? _series;
    private SpeakerDetail? _speaker;
    private string _name = "", _description = "", _seriesQuery = "", _speakerQuery = "";
    private MediaRef? _picture;
    private bool _busy, _choosing, _removed, _deleting, _saved;
    private SpeakerDetail? _moveSpeakerTo;
    private SeriesDetail? _moveSeriesTo;
    private SeriesDeletion? _seriesDeletion;
    private string? _problem;

    private async Task<Lists> LoadAsync()
    {
        Task<SpeakerList> speakers = Sermons.SpeakersAsync().AsTask();
        Task<SeriesList> series = Sermons.SeriesAsync().AsTask();
        await Task.WhenAll(speakers, series);
        return new Lists((await series).Series, (await speakers).Speakers);
    }

    private static IEnumerable<T> Matching<T>(IEnumerable<T> items, string query, Func<T, string> text) =>
        query.Trim() is { Length: > 0 } wanted ? items.Where(item => text(item).Contains(wanted, StringComparison.CurrentCultureIgnoreCase)) : items;

    private static string SpeakerName(SpeakerDetail speaker) => speaker.Name;

    private static string SpeakerCount(SpeakerDetail speaker) => SermonText.Sermons(speaker.Count);

    private static string SeriesName(SeriesDetail series) => series.Name;

    private static string SeriesCount(SeriesDetail series) => SermonText.Sermons(series.Count);

    private static IReadOnlyList<SpeakerDetail> OtherSpeakers(Lists lists, SpeakerDetail leaving) => lists.Speakers.Where(speaker => speaker.Id != leaving.Id).ToList();

    private static IReadOnlyList<SeriesDetail> OtherSeries(Lists lists, SeriesDetail leaving) => lists.Series.Where(series => series.Id != leaving.Id).ToList();

    private string? DeleteTitle => _speaker is { } speaker ? $"Delete {speaker.Name}?" : _series is { } series ? $"Delete {series.Name}?" : null;

    private string DeleteButton => (_speaker?.Name ?? _series?.Name, _moveSpeakerTo?.Name ?? _moveSeriesTo?.Name) switch
    {
        ({ } name, { } into) => $"Move to {into} and delete {name}",
        ({ } name, null) => $"Delete {name}",
        _ => "Delete",
    };

    private MediaRef? ShownArtwork(SeriesDetail series) => _picture ?? (_removed ? null : series.Artwork);

    private MediaRef? ShownPhoto(SpeakerDetail speaker) => _picture ?? (_removed ? null : speaker.Photo);

    private bool Changed =>
        _series is { } series ? _name != series.Name || _description != series.Description || _picture is not null || _removed
        : _speaker is { } speaker && (_name != speaker.Name || _picture is not null || _removed);

    private async Task OpenAsync(Action open)
    {
        if (await Unsaved.MayLeaveAsync())
            open();
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        if (_name.Trim().Length == 0)
            return false;
        await (_speaker is null ? SaveSeriesAsync() : SaveSpeakerAsync());
        return _problem is null;
    }

    private void NewSeries() => EditSeries(new SeriesDetail());

    private void NewSpeaker() => EditSpeaker(new SpeakerDetail());

    private void EditSeries(SeriesDetail series)
    {
        Close();
        _series = series;
        _name = series.Name;
        _description = series.Description;
    }

    private void EditSpeaker(SpeakerDetail speaker)
    {
        Close();
        _speaker = speaker;
        _name = speaker.Name;
    }

    private void Chose(MediaRef picture)
    {
        _picture = picture;
        _removed = false;
        _choosing = false;
    }

    private void RemovePicture()
    {
        _picture = null;
        _removed = true;
    }

    private Task AskToDeleteSeriesAsync() => RunAsync(async () =>
    {
        _seriesDeletion = await Sermons.SeriesDeletionAsync(_series!.Id);
        _deleting = true;
    }, reload: false);

    private void StopDeleting()
    {
        _deleting = false;
        _moveSpeakerTo = null;
        _moveSeriesTo = null;
        _seriesDeletion = null;
        _problem = null;
    }

    private Task DeleteAsync() => RunAsync(async () =>
    {
        if (_speaker is { } speaker)
            await Sermons.DeleteSpeakerAsync(speaker.Id, _moveSpeakerTo?.Id);
        else if (_series is { } series)
            await Sermons.DeleteSeriesAsync(series.Id, _moveSeriesTo?.Id);
        StopDeleting();
        Close();
    });

    private void Close()
    {
        StopDeleting();
        _series = null;
        _speaker = null;
        _picture = null;
        _removed = false;
        _choosing = false;
        _saved = false;
        _problem = null;
    }

    private Task SaveSeriesAsync() => RunAsync(async () =>
    {
        EditSeries(await Sermons.SaveSeriesAsync(new SeriesDetail { Id = _series!.Id, Name = _name, Description = _description, Artwork = ShownArtwork(_series) }));
        _saved = true;
    });

    private Task SaveSpeakerAsync() => RunAsync(async () =>
    {
        EditSpeaker(await Sermons.SaveSpeakerAsync(new SpeakerDetail { Id = _speaker!.Id, Name = _name, Photo = ShownPhoto(_speaker) }));
        _saved = true;
    });

    private async Task RunAsync(Func<Task> work, bool reload = true)
    {
        _busy = true;
        _problem = null;
        try
        {
            await work();
            if (reload && _live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
