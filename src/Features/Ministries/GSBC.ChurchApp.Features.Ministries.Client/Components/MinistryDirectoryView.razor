@inject IMinistryReads Reads
@inject NavigationManager Navigation

<LiveData TValue="MinistryDirectory" Load="Reads.DirectoryAsync" Feeds="Reads.Feeds" Remember="ministries.directory" FailedTitle="Can't load the ministries right now">
    <ChildContent>
        @{
            MinistryDirectory directory = context.Value;
            List<MinistrySummary> yours = directory.Ministries.Where(ministry => ministry.Yours.Length > 0).ToList();
            List<(MinistrySummary Ministry, int Depth)> tree = MinistryTrees.Walk(directory.Ministries, deepest: Deepest).ToList();
            List<MinistrySummary> groups = directory.Ministries.Where(ministry => ministry.ShowsInLifeGroups).ToList();
            List<MinistrySummary> yourGroups = groups.Where(group => group.Yours.Length > 0).ToList();
        }
        @if (yours.Count > 0)
        {
            <Section First="true" Title="Yours">
                <ListGroup>
                    @foreach (MinistrySummary ministry in yours)
                    {
                        <ListRow @key="ministry.Id" Title="@ministry.Name" Subtitle="@(ministry.Latest.Length > 0 ? $"{ministry.Yours} · {ministry.Latest}" : ministry.Yours)"
                                 Icon="@AboutArea.IconOf(ministry.Icon)" Chevron="true" Href="@MinistriesPlaces.Of(ministry.Id)" />
                    }
                </ListGroup>
            </Section>
        }
        <Section First="@(yours.Count == 0)" Title="All ministries">
            <ListGroup>
                @foreach ((MinistrySummary ministry, int depth) in tree)
                {
                    int hidden = depth == Deepest ? MinistryTrees.Under(directory.Ministries, ministry) : 0;
                    <ListRow @key="ministry.Id" Indent="depth" Title="@ministry.Name" Subtitle="@Line(ministry, hidden)" Icon="@AboutArea.IconOf(ministry.Icon)"
                             Chevron="true" Href="@MinistriesPlaces.Of(ministry.Id)" />
                }
                @if (directory.MayCreate || directory.Ministries.Any(ministry => ministry.MayAddUnder))
                {
                    <ListRow Title="Add a ministry" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _creating = true" />
                }
            </ListGroup>
        </Section>
        @if (groups.Count > 0)
        {
            <Section Title="Life Groups">
                <ListGroup>
                    <ListRow Title="Sunday classes" Subtitle="@(yourGroups.Count > 0 ? $"Yours: {MinistryWords.Names(yourGroups.Select(group => group.Name).ToList())}" : "Choose a class for you or your children")"
                             Icon="book-open" IconTone="RowTone.Accent" Chevron="true" Href="@MinistriesPlaces.LifeGroups" />
                </ListGroup>
            </Section>
        }
        <MinistrySheet Open="_creating" OpenChanged="open => _creating = open" OnCreated="created => Navigation.NavigateTo(MinistriesPlaces.Of(created.Id, MinistriesPlaces.Settings))" />
    </ChildContent>
    <Loading>
        <Section First="true"><Skeleton Shape="SkeletonShape.Lines" Count="6" /></Section>
    </Loading>
</LiveData>

@code {
    private const int Deepest = 2;
    private bool _creating;

    private static string Line(MinistrySummary ministry, int hidden)
    {
        List<string> parts = [];
        if (ministry.Hidden)
            parts.Add("Hidden");
        if (ministry.ShowsInLifeGroups)
            parts.Add("Life Group");
        if (ministry.Summary.Length > 0)
            parts.Add(ministry.Summary);
        parts.Add(hidden > 0 ? $"{MinistryWords.Ministries(hidden)} under it" : ministry.Hidden ? "" : MinistryWords.JoinLine(ministry));
        return string.Join(" · ", parts.Where(part => part.Length > 0));
    }
}
