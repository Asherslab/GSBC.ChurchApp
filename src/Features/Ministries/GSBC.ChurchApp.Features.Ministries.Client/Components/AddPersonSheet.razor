@inject IMinistryWrites Ministries
@inject MinistryLookups Lookups

<Sheet Open="Open" OpenChanged="ClosingAsync" Title="@(Role == Roles.Attendee ? "Add attendees" : $"Add to the {Page.Ministry.Name} team")" Lead="Find them by name. They need to be in the app; a child is added by their parent first.">
    <ChildContent>
        @if (_added.Count > 0)
        {
            <Notice Tone="NoticeTone.Info" Text="@($"Added {MinistryWords.Names(_added)}.")" />
        }
        @if (Role != Roles.Attendee && Givable.Count > 1)
        {
            <div class="field">
                <span class="field__label">Add them as</span>
                <RoleMenu TValue="string" Label="Add them as" Roles="Givable" Value="@Chosen" ValueChanged="value => _role = value" Block="true" />
            </div>
        }
        <PersonFinder Find="FindAsync" ActionText="@($"Add as {MinistryWords.Role(Chosen).ToLowerInvariant()}")" Busy="@_busy" AutoFocus="true" Leave="_addedIds" OnChosen="AddAsync" />
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => ClosingAsync(false)">Done</Button>
    </Actions>
</Sheet>

@code {
    private string? _role;
    private string? _busy;
    private string? _problem;
    private readonly List<string> _added = [];
    private readonly List<string> _addedIds = [];

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter] public IReadOnlyList<string> MayGive { get; set; } = [];
    [Parameter] public string Role { get; set; } = Roles.Team;
    [Parameter] public EventCallback OnAdded { get; set; }

    private IReadOnlyList<RoleChoice<string>> Givable =>
        new[] { Roles.Team, Roles.Admin, Roles.Leader }.Where(MayGive.Contains)
            .Select(role => new RoleChoice<string>(role, MinistryWords.Role(role), MinistryWords.Allows(role))).ToList();

    private string Chosen => _role ?? Role;

    private async Task ClosingAsync(bool open)
    {
        if (!open)
        {
            (_role, _problem) = (null, null);
            _added.Clear();
            _addedIds.Clear();
        }
        await OpenChanged.InvokeAsync(open);
    }

    private async Task<IReadOnlyList<PersonChoice>> FindAsync(string query) =>
        (await Lookups.FindAsync(Page.Ministry.Id, query)).Select(person => new PersonChoice(person.Id, person.Name, person.Detail)).ToList();

    private async Task AddAsync(PersonChoice person)
    {
        (_busy, _problem) = (person.Id, null);
        try
        {
            await Ministries.ChangePersonAsync(Page.Ministry.Id, person.Id, Chosen, add: true);
            _added.Add(Chosen == Role ? person.Name : $"{person.Name} as {MinistryWords.Role(Chosen).ToLowerInvariant()}");
            _addedIds.Add(person.Id);
            await OnAdded.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = null;
        }
    }
}
