@using GSBC.ChurchApp.Platform.Client.Modules
@inject IEnumerable<MinistryPartView> PartViews

@switch (Area)
{
    case MinistriesPlaces.Roster when PartViews.FirstOrDefault(view => view.Part == MinistryParts.Rosters) is { } roster:
        @roster.Content(OnPage)
        break;
    case MinistriesPlaces.Chats when PartViews.FirstOrDefault(view => view.Part == MinistryParts.Chats) is { } chats:
        @chats.Content(OnPage)
        break;
    case MinistriesPlaces.News:
        <NewsArea Page="Page" OnChanged="OnChanged" />
        break;
    case MinistriesPlaces.Calendar:
        <CalendarArea Page="Page" OnChanged="OnChanged" />
        break;
    case MinistriesPlaces.Files:
        <FilesArea Page="Page" OnChanged="OnChanged" />
        break;
    case MinistriesPlaces.Sundays:
        <SundaysArea Page="Page" OnChanged="OnChanged" />
        break;
    case MinistriesPlaces.People:
        <PeopleArea Page="Page" Wide="Wide" OnChanged="OnChanged" />
        break;
    case MinistriesPlaces.Settings:
        <SettingsArea Page="Page" Href="Href" OnChanged="OnChanged" />
        break;
    default:
        <AboutArea Page="Page" Href="Href" OnChanged="OnChanged" />
        break;
}

@code {
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required string Area { get; set; }
    [Parameter, EditorRequired] public required Func<string, string> Href { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool Wide { get; set; }

    private MinistryOnPage OnPage => new(Page.Ministry.Id, Page.Ministry.Name, Wide, Page.You.MayEditSettings, Page.Ministry.AttendJoin != Joining.None);
}
