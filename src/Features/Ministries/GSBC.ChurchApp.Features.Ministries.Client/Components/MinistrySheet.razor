@inject IMinistryReads Reads
@inject IMinistryWrites Ministries

<UnsavedGuard Changed="() => Open && (_name.Length > 0 || _summary.Length > 0 || _meets.Length > 0)" What="@(_shows ? "the new Life Group" : "the new ministry")" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@(_shows ? "A new Life Group" : "A new ministry")" Lead="It's a ministry like any other. Its leaders do the rest: people, posts, files and the ministries under it.">
    <ChildContent>
        <LiveData TValue="MinistryDirectory" Load="Reads.DirectoryAsync" Feeds="Reads.Feeds" Remember="ministries.directory" FailedTitle="Can't load the ministries right now">
            <ChildContent>
                @{
                    _directory = context.Value;
                }
                <SitsUnderPicker Directory="_directory" UnderId="@(Under?.Id ?? "")" UnderIdChanged="id => _underId = id" Hint="Its leaders lead the new ministry too." />
                <TextField Label="Name" @bind-Value="_name" MaxLength="60" Required="true" />
                <TextField Label="In a line" @bind-Value="_summary" MaxLength="140" />
                <TextField Label="When and where it meets" @bind-Value="_meets" MaxLength="140" />
                <LifeGroupsFields Shows="_shows" ShowsChanged="value => _shows = value" RoundId="@_roundId" RoundIdChanged="value => _roundId = value" />
                <JoiningFields TeamJoin="@_teamJoin" TeamJoinChanged="value => _teamJoin = value" AttendJoin="@_attendJoin" AttendJoinChanged="value => _attendJoin = value" />
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            </ChildContent>
        </LiveData>
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="@(_shows ? "Add the Life Group" : "Add the ministry")" Busy="_busy" OnSave="CreateAsync" Blocked="@Blocked" />
    </Actions>
</Sheet>

@code {
    private MinistryDirectory _directory = new();
    private string? _underId;
    private bool _opened;
    private string _name = "";
    private string _summary = "";
    private string _meets = "";
    private string _teamJoin = Joining.Ask;
    private string _attendJoin = Joining.None;
    private bool _shows;
    private string _roundId = "";
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string UnderId { get; set; } = "";
    [Parameter] public bool InLifeGroups { get; set; }
    [Parameter] public string RoundId { get; set; } = "";
    [Parameter] public EventCallback<MinistryDetails> OnCreated { get; set; }

    private MinistrySummary? Under =>
        _directory.Ministries.FirstOrDefault(ministry => ministry.MayAddUnder && ministry.Id == (_underId ?? UnderId));

    private string? Blocked =>
        _name.Trim().Length == 0 ? "Give it a name to add it."
        : Under is null && !_directory.MayCreate ? "Choose the ministry it sits under to add it."
        : null;

    protected override void OnParametersSet()
    {
        if (Open && !_opened)
            (_underId, _problem, _shows, _roundId, _teamJoin, _attendJoin) =
                (null, null, InLifeGroups, RoundId, Joining.Ask, InLifeGroups ? Joining.Open : Joining.None);
        _opened = Open;
    }

    private async Task CreateAsync()
    {
        (_busy, _problem) = (true, null);
        try
        {
            MinistryDetails details = new()
            {
                Name = _name, Summary = _summary, Meets = _meets, TeamJoin = _teamJoin, AttendJoin = _attendJoin,
                ShowsInLifeGroups = _shows, RoundId = _shows ? _roundId : "",
            };
            MinistryDetails created = Under is { } under ? await Ministries.AddSubMinistryAsync(under.Id, details) : await Ministries.CreateAsync(details);
            (_name, _summary, _meets) = ("", "", "");
            await OpenChanged.InvokeAsync(false);
            await OnCreated.InvokeAsync(created);
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
