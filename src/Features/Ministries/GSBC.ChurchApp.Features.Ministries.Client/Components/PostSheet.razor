@using GSBC.ChurchApp.Platform.Client.Uploads
@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Ui.News
@inject IMinistryWrites Ministries
@inject FileUploads Uploads
@inject TimeProvider Clock

<UnsavedGuard Changed="() => Open" Editing="Draft" State="() => Shape" What="this post" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@(Draft.Id.Length > 0 ? "Change the post" : AboutASunday ? "Tell the group about a Sunday" : "New post")" Lead="@($"In {Page.Ministry.Name}.")">
    <Tools>
        @if (Draft.Id.Length > 0)
        {
            <Menu Label="More for this post" Items="More" />
        }
    </Tools>
    <ChildContent>
        @if (AboutASunday)
        {
            <SelectField Label="Which Sunday" Options="SundayChoices" Value="@Draft.Sunday" ValueChanged="value => Draft.Sunday = value" />
            <ToggleRow Title="@SundayPosts.NoClass" Description="Coming up shows the Sunday struck through" Checked="Draft.NoClass" CheckedChanged="NoClassChanged" />
        }
        <PostEditor @ref="_editor" Title="@Draft.Title" TitleChanged="title => Draft.Title = title" Blocks="_blocks" OnChanged="() => _changes++"
                    SettingsInline="true" SettingsTitle="Who it's for and telling them" SettingsSummary="@Summary">
            <Settings>
                <Segmented TValue="string" Label="Who it's for" ShowLabel="true" Stacked="true" Options="Audiences" Value="Draft.Audience" ValueChanged="value => Draft.Audience = value" />
                <p class="ministry-who">@MinistryWords.WhoReads(Draft.Audience, Page.Ministry)</p>
                <ToggleRow Title="Important" Description="Sends a notification to everyone it's for, straight away" @bind-Checked="Draft.Important" />
                @if (Draft.Audience == Contracts.Audiences.Everyone && !MinistryLogic.IsHidden(Page.Ministry))
                {
                    <ToggleRow Title="Ask for church news" Description="Church staff can put it in the News tab for the whole church, saying it's from this ministry" @bind-Checked="Draft.AskWholeChurch" />
                }
            </Settings>
        </PostEditor>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Label="@(Draft.Id.Length == 0 ? MinistryWords.PostFor(Draft.Audience, Page.Ministry) : "Save")" Busy="_busy" OnSave="SaveAsync" OnCancel="() => OpenChanged.InvokeAsync(false)" New="@(Draft.Id.Length == 0)"
                 Blocked="@(Draft.Title.Trim().Length == 0 ? "Give it a title to post it." : null)" />
    </Actions>
</Sheet>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="Delete this post?" Lead="It goes from the news for everyone it was for. This can't be undone.">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Disabled="_busy" OnClick="DeleteAsync">Delete the post</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private bool _busy, _deleting;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required Post Draft { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private PostEditor? _editor;
    private List<PostBlock> _blocks = [];
    private int _changes;
    private Post? _loadedFor;

    private object Shape => (Draft.Title, _changes, Draft.Audience, Draft.Important, Draft.AskWholeChurch, Draft.Sunday, Draft.NoClass);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedFor, Draft))
            return;
        _loadedFor = Draft;
        _blocks = PostBlocks.Of(Draft.Content ?? PlainText.AsRichText(Draft.Body));
        if (_blocks.Count == 0)
            _blocks.Add(new PostBlock { Kind = PostBlockKind.Text });
        _changes = 0;
    }

    private string Summary => string.Join(" · ", new[]
    {
        MinistryWords.Short(Draft.Audience, Page.Ministry),
        Draft.Important ? "Notifies them" : "No notification",
        Draft.AskWholeChurch && Draft.Audience == Contracts.Audiences.Everyone ? "Asks for church news" : "",
    }.Where(part => part.Length > 0));

    private UploadTarget Target => Draft.Audience == Contracts.Audiences.Everyone
        ? new UploadTarget(Area: MinistryFileArea.PostsKey, AreaScopeId: Page.Ministry.Id)
        : new UploadTarget(PrivateTo: MinistriesPermissions.TeamViewNode, PrivateToScope: Page.Ministry.Id, Area: MinistryFileArea.PostsKey, AreaScopeId: Page.Ministry.Id);

    private IReadOnlyList<SegmentOption<string>> Audiences =>
        Page.You.MayPostFor.Select(audience => new SegmentOption<string>(audience, MinistryWords.Short(audience, Page.Ministry))).ToList();

    private bool AboutASunday => Draft.Sunday.Length > 0;

    private IReadOnlyList<FieldOption> SundayChoices =>
        SundayPosts.UpcomingSundays(Page, Clock).Prepend(Draft.Sunday).Distinct().Order(StringComparer.Ordinal)
            .Select(sunday => new FieldOption(sunday, $"Sunday {MinistryWords.Day(sunday)}")).ToList();

    private void NoClassChanged(bool off)
    {
        if (Draft.Title.Trim().Length == 0 || Draft.Title == SundayPosts.NoClass)
            Draft.Title = off ? SundayPosts.NoClass : "";
        Draft.NoClass = off;
    }

    public static Post DraftForSunday(MinistryPage page, string sunday)
    {
        Post draft = DraftOf(null, page, Contracts.Audiences.Everyone);
        draft.Sunday = sunday;
        return draft;
    }

    public static Post DraftOf(Post? post, MinistryPage page, string? audience = null) => new()
    {
        Id = post?.Id ?? "", Title = post?.Title ?? "", Body = post?.Body ?? "", Content = post?.Content, Important = post?.Important ?? false,
        AskWholeChurch = post?.ChurchNews is ChurchNewsStates.Asked or ChurchNewsStates.Shared,
        Sunday = post?.Sunday ?? "", NoClass = post?.NoClass ?? false,
        Audience = post?.Audience ?? (audience is not null && page.You.MayPostFor.Contains(audience) ? audience
            : page.You.MayPostFor.Contains(Contracts.Audiences.Team) ? Contracts.Audiences.Team : page.You.MayPostFor.FirstOrDefault() ?? ""),
    };

    private Task SaveAsync() => RunAsync(async () =>
    {
        if (_editor is not null && await _editor.UploadChosenAsync(Target) is { } problem)
            throw new RpcException(new Status(StatusCode.FailedPrecondition, problem));
        Draft.Content = _editor?.Content ?? PostBlocks.ToRichText(_blocks);
        Draft.Body = PlainText.Of(Draft.Content);
        List<QueuedUpload> uploads = (_editor?.WaitingFiles() ?? [])
            .Select(media => Uploads.For(media, MediaSlot.Id(MinistryFileArea.UploadedInPostSave), Target with { AltText = media.AltText }))
            .OfType<QueuedUpload>().ToList();
        await Ministries.SavePostAsync(Page.Ministry.Id, Draft, uploads);
    });

    private IReadOnlyList<MenuItem> More =>
        [this.Item("Delete the post…", () => _deleting = true, "trash-2", danger: true)];

    private async Task DeleteAsync()
    {
        await RunAsync(() => Ministries.DeletePostAsync(Page.Ministry.Id, Draft.Id));
        _deleting = _problem is not null;
    }

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
