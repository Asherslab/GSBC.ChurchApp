@inject IMinistryWrites Ministries
@inject TimeProvider Clock

<UnsavedGuard Changed="() => Open" Editing="Draft" State="() => Shape" What="this post" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@(Draft.Id.Length > 0 ? "Change the post" : AboutASunday ? "Tell the group about a Sunday" : "New post")" Lead="@($"In {Page.Ministry.Name}.")">
    <ChildContent>
        @if (AboutASunday)
        {
            <SelectField Label="Which Sunday" Options="SundayChoices" Value="@Draft.Sunday" ValueChanged="value => Draft.Sunday = value" />
            <ToggleRow Title="@SundayPosts.NoClass" Description="Coming up shows the Sunday struck through" Checked="Draft.NoClass" CheckedChanged="NoClassChanged" />
        }
        <TextField Label="Title" @bind-Value="Draft.Title" MaxLength="120" Required="true" />
        <TextField Label="What to say" @bind-Value="Draft.Body" Multiline="true" MaxLength="4000" />
        <Segmented TValue="string" Label="Who it's for" ShowLabel="true" Stacked="true" Options="Audiences" Value="Draft.Audience" ValueChanged="value => Draft.Audience = value" />
        <p class="ministry-who">@MinistryWords.WhoReads(Draft.Audience, Page.Ministry.Name)</p>
        <ToggleRow Title="Important" Description="Sends a notification to everyone it's for, straight away" @bind-Checked="Draft.Important" />
        @if (Draft is { Audience: Contracts.Audiences.Everyone, Important: true })
        {
            <ToggleRow Title="Ask to send it to the whole church" Description="Church staff decide, as for any announcement" @bind-Checked="Draft.AskWholeChurch" />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="@(Draft.Id.Length == 0 ? MinistryWords.PostFor(Draft.Audience) : "Save")" Busy="_busy" OnSave="SaveAsync"
                 Blocked="@(Draft.Title.Trim().Length == 0 ? "Give it a title to post it." : null)" />
        @if (Draft.Id.Length > 0)
        {
            <Button Block="true" Variant="ButtonVariant.Danger" Disabled="_busy" OnClick="DeleteAsync">Delete the post</Button>
        }
    </Actions>
</Sheet>

@code {
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required Post Draft { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private object Shape => (Draft.Title, Draft.Body, Draft.Audience, Draft.Important, Draft.AskWholeChurch, Draft.Sunday, Draft.NoClass);

    private IReadOnlyList<SegmentOption<string>> Audiences =>
        Page.You.MayPostFor.Select(audience => new SegmentOption<string>(audience, MinistryWords.Short(audience))).ToList();

    private bool AboutASunday => Draft.Sunday.Length > 0;

    private IReadOnlyList<FieldOption> SundayChoices =>
        SundayPosts.UpcomingSundays(Page, Clock).Prepend(Draft.Sunday).Distinct().Order(StringComparer.Ordinal)
            .Select(sunday => new FieldOption(sunday, $"Sunday {MinistryWords.Day(sunday)}")).ToList();

    private void NoClassChanged(bool off)
    {
        if (Draft.Title.Trim().Length == 0 || Draft.Title == SundayPosts.NoClass)
            Draft.Title = off ? SundayPosts.NoClass : "";
        Draft.NoClass = off;
    }

    public static Post DraftForSunday(MinistryPage page, string sunday)
    {
        Post draft = DraftOf(null, page, Contracts.Audiences.Everyone);
        draft.Sunday = sunday;
        return draft;
    }

    public static Post DraftOf(Post? post, MinistryPage page, string? audience = null) => new()
    {
        Id = post?.Id ?? "", Title = post?.Title ?? "", Body = post?.Body ?? "", Important = post?.Important ?? false,
        Sunday = post?.Sunday ?? "", NoClass = post?.NoClass ?? false,
        Audience = post?.Audience ?? (audience is not null && page.You.MayPostFor.Contains(audience) ? audience
            : page.You.MayPostFor.Contains(Contracts.Audiences.Team) ? Contracts.Audiences.Team : page.You.MayPostFor.FirstOrDefault() ?? ""),
    };

    private Task SaveAsync() => RunAsync(() => Ministries.SavePostAsync(Page.Ministry.Id, Draft));

    private Task DeleteAsync() => RunAsync(() => Ministries.DeletePostAsync(Page.Ministry.Id, Draft.Id));

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
