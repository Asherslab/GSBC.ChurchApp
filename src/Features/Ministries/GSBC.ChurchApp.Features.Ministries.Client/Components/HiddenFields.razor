@if (Ministry.HiddenBy.Length > 0)
{
    <ToggleRow Title="Hide this ministry" Description="@MinistryWords.HiddenBecause(Ministry.HiddenBy)" Checked="true" Disabled="true" />
}
else if (Ministry.ShowsInLifeGroups)
{
    <ToggleRow Title="Hide this ministry" Description="Life Groups are listed for everyone, so a Life Group can't be hidden." Checked="false" Disabled="true" Muted="true" />
}
else
{
    <ToggleRow Title="Hide this ministry" Description="@(Ministry.Hidden ? MinistryWords.WhoSeesHidden : MinistryWords.HidesFromEveryoneElse)" Checked="Ministry.Hidden" CheckedChanged="HiddenChanged" />
}

@code {
    [Parameter, EditorRequired] public required MinistryDetails Ministry { get; set; }
    [Parameter] public EventCallback<bool> HiddenChanged { get; set; }
}
