@if (Ministry.HiddenBy.Length > 0)
{
    <ToggleRow Title="Hidden from everyone else" Description="@MinistryWords.HiddenBecause(Ministry.HiddenBy)" Checked="true" Disabled="true" />
}
else if (Ministry.ShowsInLifeGroups)
{
    <ToggleRow Title="Hidden from everyone else" Description="A Life Group is listed for everyone, so it can't be hidden" Checked="false" Disabled="true" Muted="true" />
}
else
{
    <ToggleRow Title="Hidden from everyone else" Description="@(Ministry.Hidden ? MinistryWords.WhoSeesHidden : MinistryWords.HidesFromEveryoneElse)" Checked="Ministry.Hidden" CheckedChanged="HiddenChanged" />
}

@code {
    [Parameter, EditorRequired] public required MinistryDetails Ministry { get; set; }
    [Parameter] public EventCallback<bool> HiddenChanged { get; set; }
}
