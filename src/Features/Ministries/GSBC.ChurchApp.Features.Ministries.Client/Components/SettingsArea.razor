@inject IMinistryWrites Ministries
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => Changed" What="@($"{MinistryWords.Possessive(Page.Ministry.Name)} settings")" Save="SaveBeforeLeavingAsync" />

<Section First="true" Title="The details" Lead="What people see about it, how they join, and where it shows." Grouped="true">
    <ChildContent>
        <div class="ministry-form">
            <div class="ui-pair ui-pair--wide">
                <TextField Label="Name" @bind-Value="Details.Name" MaxLength="60" Required="true" />
                <TextField Label="In a line" @bind-Value="Details.Summary" MaxLength="140" />
            </div>
            <TextField Label="About" @bind-Value="Details.About" Multiline="true" MaxLength="4000" Hint="What it is and what happens there, for someone who's never been." />
            <div class="ui-pair ui-pair--wide">
                <TextField Label="When and where it meets" @bind-Value="Details.Meets" MaxLength="140" />
                <TextField Label="Who it's for" @bind-Value="Details.WhoFor" MaxLength="140" />
            </div>
            <JoiningFields TeamJoin="@Details.TeamJoin" TeamJoinChanged="value => Details.TeamJoin = value"
                           AttendJoin="@Details.AttendJoin" AttendJoinChanged="value => Details.AttendJoin = value" Hidden="MinistryLogic.IsHidden(Details)" />
            <LifeGroupsFields Shows="Details.ShowsInLifeGroups" ShowsChanged="value => Details.ShowsInLifeGroups = value" RoundId="@Details.RoundId" RoundIdChanged="value => Details.RoundId = value"
                              Blocked="@(MinistryLogic.IsHidden(Details) ? "A hidden ministry isn't listed in Life Groups, which everyone sees" : null)" />
            <HiddenFields Ministry="Details" HiddenChanged="value => Details.Hidden = value" />
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        </div>
    </ChildContent>
    <Foot>
        <SaveBar Label="Save the details" Busy="_busy" OnSave="SaveAsync" OnCancel="Undo" Blocked="@(Details.Name.Trim().Length == 0 ? "Give it a name to save it." : null)" State="SaveBar.For(Changed, _saved)" />
    </Foot>
</Section>

<PartsSection Page="Page" OnChanged="OnChanged" />

<MoveSection Page="Page" OnChanged="OnChanged" />

<Section Title="Ministries under it" Lead="@($"{MinistryWords.Possessive(Page.Ministry.Name)} leaders lead these too.")" Grouped="true">
    <ListGroup>
        @foreach (MinistrySummary under in Page.SubMinistries)
        {
            <ListRow @key="under.Id" Title="@under.Name" Subtitle="@under.Summary" Chevron="true" Href="@Href(under.Id)" />
        }
        <ListRow Title="Add a ministry" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _adding = true" />
    </ListGroup>
</Section>

<MinistrySheet Open="_adding" OpenChanged="open => _adding = open" UnderId="@Page.Ministry.Id" OnCreated="CreatedAsync" />

@code {
    private MinistryDetails _details = new();
    private MinistryDetails _stored = new();
    private MinistryDetails? _seen;
    private bool _adding;
    private bool _busy;
    private bool _saved;
    private string? _problem;

    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required Func<string, string> Href { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private MinistryDetails Details
    {
        get
        {
            FollowPage();
            return _details;
        }
    }

    private bool Changed => !Same(Details, _stored);

    private void FollowPage()
    {
        if (ReferenceEquals(_seen, Page.Ministry))
            return;
        _seen = Page.Ministry;
        bool another = _stored.Id != Page.Ministry.Id;
        if (another)
            (_saved, _problem) = (false, null);
        if (another || !Changed)
            (_stored, _details) = (Page.Ministry, Copy(Page.Ministry));
    }

    private static bool Same(MinistryDetails one, MinistryDetails other) =>
        (one.Name, one.Summary, one.About, one.Meets, one.WhoFor, one.TeamJoin, one.AttendJoin, one.ShowsInLifeGroups, one.RoundId, one.Hidden)
        == (other.Name, other.Summary, other.About, other.Meets, other.WhoFor, other.TeamJoin, other.AttendJoin, other.ShowsInLifeGroups, other.RoundId, other.Hidden);

    private static MinistryDetails Copy(MinistryDetails from) => new()
    {
        Id = from.Id, ParentId = from.ParentId, Name = from.Name, Summary = from.Summary, About = from.About, Meets = from.Meets,
        WhoFor = from.WhoFor, Colour = from.Colour, Icon = from.Icon, TeamJoin = from.TeamJoin, AttendJoin = from.AttendJoin, RoundId = from.RoundId,
        ShowsInLifeGroups = from.ShowsInLifeGroups, Order = from.Order, Hidden = from.Hidden, HiddenBy = from.HiddenBy,
    };

    private Task SaveAsync() =>
        RunAsync(async () =>
        {
            _stored = await Ministries.SaveMinistryAsync(Details);
            _details = Copy(_stored);
            _saved = true;
            await OnChanged.InvokeAsync();
        });

    private void Undo() => (_details, _problem) = (Copy(_stored), null);

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync();
        return _problem is null;
    }

    private async Task CreatedAsync(MinistryDetails created)
    {
        await OnChanged.InvokeAsync();
        Navigation.NavigateTo(Href(created.Id));
    }

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem, _saved) = (true, null, false);
        try
        {
            await work();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
