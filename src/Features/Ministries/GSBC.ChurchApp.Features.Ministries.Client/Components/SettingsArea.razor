@inject MinistriesClient Ministries
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => Changed" What="@($"{MinistryWords.Possessive(Page.Ministry.Name)} settings")" Save="SaveBeforeLeavingAsync" />

<Section First="true" Title="Details">
    <div class="ministry-form">
        <TextField Label="Name" @bind-Value="Details.Name" MaxLength="60" Required="true" />
        <TextField Label="In a line" @bind-Value="Details.Summary" MaxLength="140" />
        <TextField Label="About" @bind-Value="Details.About" Multiline="true" MaxLength="4000" Hint="What it is and what happens there, for someone who's never been." />
        <TextField Label="When and where it meets" @bind-Value="Details.Meets" MaxLength="140" />
        <TextField Label="Who it's for" @bind-Value="Details.WhoFor" MaxLength="140" />
        @if (Details.Kind == MinistryKinds.LifeGroup)
        {
            <TextField Label="Room" @bind-Value="Details.Room" MaxLength="60" />
        }
    </div>
</Section>

<Section Title="Joining" Lead="@(Details.Kind == MinistryKinds.LifeGroup ? "How people get on the team, and how they get into the group." : "How people get on the team, and how they start coming along.")">
    <JoiningFields Kind="@Details.Kind" TeamJoin="@Details.TeamJoin" TeamJoinChanged="value => Details.TeamJoin = value"
                   AttendJoin="@Details.AttendJoin" AttendJoinChanged="value => Details.AttendJoin = value" />
</Section>

<Section>
    <div class="ministry-form">
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        <SaveBar Label="Save the details" Busy="_busy" OnSave="SaveAsync" Blocked="@(Details.Name.Trim().Length == 0 ? "Give it a name to save it." : null)" State="SaveBar.For(Changed, _saved)" />
    </div>
</Section>

<PartsSection Page="Page" OnChanged="OnChanged" />

<MoveSection Page="Page" OnChanged="OnChanged" />

@if (Page.Ministry.Kind != MinistryKinds.LifeGroup)
{
    <Section Title="Ministries under it" Lead="@($"{MinistryWords.Possessive(Page.Ministry.Name)} leaders lead these too.")">
        <ListGroup>
            @foreach (MinistrySummary under in Page.SubMinistries)
            {
                <ListRow @key="under.Id" Title="@under.Name" Subtitle="@under.Summary" Chevron="true" Href="@Href(under.Id)" />
            }
            <ListRow Title="Add a ministry" Icon="plus" IconTone="RowTone.Accent" OnClick="() => _adding = true" />
        </ListGroup>
    </Section>
}

@if (Page.You.MayDelete)
{
    <Section Title="Delete">
        @if (_preview is { } preview)
        {
            <Notice Tone="NoticeTone.Warning" Text="@DeleteWords(preview)" />
            <div class="ui-actions ministry-actions">
                <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete @preview.Name</Button>
                <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => _preview = null">Keep it</Button>
            </div>
        }
        else
        {
            <ListGroup>
                <ListRow Title="@($"Delete {Page.Ministry.Name}")" Subtitle="Shows what goes with it first" Icon="x" IconTone="RowTone.Quiet" OnClick="PreviewAsync" />
            </ListGroup>
        }
    </Section>
}

<MinistrySheet Open="_adding" OpenChanged="open => _adding = open" UnderId="@Page.Ministry.Id" OnCreated="CreatedAsync" />

@code {
    private MinistryDetails _details = new();
    private MinistryDetails _stored = new();
    private MinistryDetails? _seen;
    private DeletionPreview? _preview;
    private bool _adding;
    private bool _busy;
    private bool _saved;
    private bool _leaving;
    private string? _problem;

    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required Func<string, string> Href { get; set; }
    [Parameter] public string AfterDelete { get; set; } = MinistriesPlaces.Directory;
    [Parameter] public EventCallback OnChanged { get; set; }

    private MinistryDetails Details
    {
        get
        {
            FollowPage();
            return _details;
        }
    }

    private bool Changed => !_leaving && !Same(Details, _stored);

    private void FollowPage()
    {
        if (ReferenceEquals(_seen, Page.Ministry))
            return;
        _seen = Page.Ministry;
        bool another = _stored.Id != Page.Ministry.Id;
        if (another)
            (_saved, _problem, _preview) = (false, null, null);
        if (another || !Changed)
            (_stored, _details) = (Page.Ministry, Copy(Page.Ministry));
    }

    private static bool Same(MinistryDetails one, MinistryDetails other) =>
        (one.Name, one.Summary, one.About, one.Meets, one.WhoFor, one.Room, one.TeamJoin, one.AttendJoin)
        == (other.Name, other.Summary, other.About, other.Meets, other.WhoFor, other.Room, other.TeamJoin, other.AttendJoin);

    private static MinistryDetails Copy(MinistryDetails from) => new()
    {
        Id = from.Id, ParentId = from.ParentId, Kind = from.Kind, Name = from.Name, Summary = from.Summary, About = from.About, Meets = from.Meets,
        WhoFor = from.WhoFor, Colour = from.Colour, Icon = from.Icon, TeamJoin = from.TeamJoin, AttendJoin = from.AttendJoin, RoundId = from.RoundId,
        Room = from.Room, JoinAsParent = from.JoinAsParent, Order = from.Order,
    };

    private static string DeleteWords(DeletionPreview preview)
    {
        List<string> goes = [];
        if (preview.Posts > 0) goes.Add($"{preview.Posts} {(preview.Posts == 1 ? "post" : "posts")}");
        if (preview.Files > 0) goes.Add($"{preview.Files} {(preview.Files == 1 ? "file" : "files")}");
        if (preview.Calendars.Count > 0) goes.Add($"the {MinistryWords.Names(preview.Calendars)} {(preview.Calendars.Count == 1 ? "calendar" : "calendars")} and {preview.Events} {(preview.Events == 1 ? "event" : "events")}");
        if (preview.People > 0) goes.Add($"everyone's place in it ({preview.People})");
        string what = goes.Count > 0 ? $"This deletes {MinistryWords.Names(goes)}." : "Nothing else is in it.";
        string under = preview.SubMinistries > 0
            ? $" The {MinistryWords.Ministries(preview.SubMinistries)} under it {(preview.SubMinistries == 1 ? "moves" : "move")} up to {(preview.SubMinistriesGoTo.Length > 0 ? preview.SubMinistriesGoTo : "the top level")}."
            : "";
        return $"{what}{under} This can't be undone.";
    }

    private Task SaveAsync() =>
        RunAsync(async () =>
        {
            _stored = await Ministries.SaveMinistryAsync(Details);
            _details = Copy(_stored);
            _saved = true;
            await OnChanged.InvokeAsync();
        });

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveAsync();
        return _problem is null;
    }

    private Task PreviewAsync() => RunAsync(async () => _preview = await Ministries.DeletionAsync(Page.Ministry.Id));

    private Task DeleteAsync() =>
        RunAsync(async () =>
        {
            await Ministries.DeleteAsync(Page.Ministry.Id);
            _leaving = true;
            Navigation.NavigateTo(Page.Ministry.ParentId.Length > 0 ? Href(Page.Ministry.ParentId) : AfterDelete, replace: true);
        });

    private async Task CreatedAsync(MinistryDetails created)
    {
        await OnChanged.InvokeAsync();
        Navigation.NavigateTo(Href(created.Id));
    }

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem, _saved) = (true, null, false);
        try
        {
            await work();
        }
        catch (RpcException exception)
        {
            _problem = MinistriesClient.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
