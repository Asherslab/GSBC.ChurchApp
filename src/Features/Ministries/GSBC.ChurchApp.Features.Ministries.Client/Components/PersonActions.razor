@inject IMinistryWrites Ministries
@inject MinistryLookups Lookups

@if (Member is { } member)
{
    @if (member.LeadsFrom.Length > 0)
    {
        <p class="hint">@member.Name leads @member.LeadsFrom, so they lead everything under it too. Change that in @member.LeadsFrom.</p>
    }
    else if (_linking)
    {
        <PersonFinder Find="FindAsync" ActionText="Link as their parent" Label="Find their parent or guardian by name" Busy="@_busyId" AutoFocus="true"
                      Leave="[.. member.Parents.Select(parent => parent.Id), member.PersonId]" OnChosen="LinkAsync" />
        <p class="hint">Their parent sees what @Page.Ministry.Name shares with families, and hears about @First(member).</p>
    }
    else
    {
        @if (Choices(member).Count > 1 || MayRemove(member))
        {
            <div class="field">
                <span class="field__label">@($"Role in {Page.Ministry.Name}")</span>
                <RoleMenu TValue="string" Label="@($"{member.Name}'s role in {Page.Ministry.Name}")" Roles="Choices(member)" Value="@Shown(member)" ValueChanged="SetRoleAsync"
                          RemoveLabel="@(MayRemove(member) ? $"Take {First(member)} off {Page.Ministry.Name}" : null)" RemoveDetail="They stay in the church's app."
                          OnRemove="@(MayRemove(member) ? EventCallback.Factory.Create(this, () => SetRoleAsync("")) : default)" Block="true" Disabled="_busy" />
            </div>
        }
        @if (member.Role == Roles.Attendee || member.Age is not null)
        {
            <ListGroup>
                <ListRow Title="@(member.NoParent ? "No parent linked" : $"Parents: {MinistryWords.Names(member.Parents.Select(parent => parent.Name).ToList())}")"
                         Subtitle="@(member.NoParent ? $"Nobody hears about {Page.Ministry.Name} for them yet" : "Link another parent or guardian")"
                         Icon="users" IconTone="@(member.NoParent ? RowTone.Warm : RowTone.Quiet)" OnClick="() => _linking = true" Chevron="true" />
            </ListGroup>
        }
        <p class="hint">Only @MinistryWords.Possessive(Page.Ministry.Name) leaders and the church office see this.</p>
    }
    <Notice Tone="NoticeTone.Warning" Text="@_problem" />
}

@code {
    private bool _linking;
    private bool _busy;
    private string? _busyId;
    private string? _problem;
    private (string Person, string Was, string Now)? _chosen;

    [Parameter] public Member? Member { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter] public IReadOnlyList<string> MayGive { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    public static string? Lead(Member? member) => member is null
        ? null
        : string.Join(" · ", new[] { member.Age is { } age ? $"{age}" : "", MinistryWords.Role(member.Role), member.CanSignIn ? "" : "no sign-in of their own" }.Where(part => part.Length > 0));

    private static string First(Member member) => member.Name.Split(' ')[0];

    private string Shown(Member member) =>
        _chosen is { } chosen && chosen.Person == member.PersonId && chosen.Was == member.Role ? chosen.Now : member.Role;

    private IReadOnlyList<RoleChoice<string>> Choices(Member member) =>
        new[] { Roles.Attendee, Roles.Team, Roles.Admin, Roles.Leader }
            .Where(role => role == Shown(member) || (MayGive.Contains(role) && MayGive.Contains(Shown(member))))
            .Where(role => role != Roles.Attendee || Page.Ministry.AttendJoin != Joining.None || member.Role == Roles.Attendee)
            .Select(role => new RoleChoice<string>(role, MinistryWords.Role(role), MinistryWords.Allows(role)))
            .ToList();

    private bool MayRemove(Member member) => MayGive.Contains(Shown(member));

    private async Task<IReadOnlyList<PersonChoice>> FindAsync(string query) =>
        (await Lookups.FindAsync(Page.Ministry.Id, query)).Select(person => new PersonChoice(person.Id, person.Name, person.Detail)).ToList();

    private Task LinkAsync(PersonChoice parent) =>
        RunAsync(async () =>
        {
            _busyId = parent.Id;
            await Ministries.LinkParentAsync(Page.Ministry.Id, Member!.PersonId, parent.Id);
            _linking = false;
        });

    private Task SetRoleAsync(string role) =>
        RunAsync(async () =>
        {
            Member member = Member!;
            await Ministries.SetRoleAsync(Page.Ministry.Id, member.PersonId, role);
            _chosen = (member.PersonId, member.Role, role);
            if (role.Length == 0)
                await OnClose.InvokeAsync();
        });

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            await OnChanged.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            (_busy, _busyId) = (false, null);
        }
    }
}
