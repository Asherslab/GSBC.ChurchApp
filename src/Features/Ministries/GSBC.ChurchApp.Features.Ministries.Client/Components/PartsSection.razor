@inject IMinistryWrites Ministries

<Section Title="Its tabs" Lead="Turn off what it doesn't use: the tab and everything in it are hidden from everyone, leaders too, until you turn it back on. Nothing is deleted." Grouped="true">
    <ChildContent>
        @foreach (MinistryPart part in MinistryParts.All)
        {
            <ToggleRow @key="part.Key" Title="@part.Name" Description="@part.Does" Checked="@(!Off.Contains(part.Key))" Disabled="_busy" CheckedChanged="on => TurnAsync(part.Key, on)" />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Foot>These change straight away.</Foot>
</Section>

@if (!Off.Contains(MinistryParts.Chats))
{
    <Section Title="Chats" Grouped="true">
        <ChildContent>
            <Segmented TValue="string" Label="Who can start a chat" ShowLabel="true" Value="@StartsChats" ValueChanged="StartersAsync"
                       Options="@([new SegmentOption<string>(ChatStarters.Leaders, "Leaders"), new SegmentOption<string>(ChatStarters.Team, "The team too")])"
                       Hint="The team can start group chats for the team or people they choose. Channels and chats with attendees or parents stay with leaders." />
        </ChildContent>
        <Foot>This changes straight away.</Foot>
    </Section>
}

@if (Gathering.Any())
{
    <Section Title="From the ministries under it" Grouped="true">
        <ChildContent>
            @foreach ((MinistryPart part, PartFromBelow below) in Gathering)
            {
                <ToggleRow @key="@($"{part.Key}-below")" Title="@below.Title" Description="@below.Does"
                           Checked="@FromBelow.Contains(part.Key)" Disabled="_busy" CheckedChanged="on => FromBelowAsync(part.Key, on)" />
            }
        </ChildContent>
        <Foot>These change straight away.</Foot>
    </Section>
}

@code {
    private List<string> _off = [];
    private List<string> _fromBelow = [];
    private string? _starters;
    private MinistryDetails? _seen;
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<string> Off
    {
        get
        {
            FollowPage();
            return _off;
        }
    }

    private List<string> FromBelow
    {
        get
        {
            FollowPage();
            return _fromBelow;
        }
    }

    private void FollowPage()
    {
        if (ReferenceEquals(_seen, Page.Ministry) || _busy)
            return;
        _seen = Page.Ministry;
        (_off, _fromBelow, _starters) = ([.. Page.Ministry.PartsOff], [.. Page.Ministry.PartsFromBelow], null);
    }

    private string StartsChats => _starters ?? (ChatStarters.IsValid(Page.Ministry.ChatStarters) ? Page.Ministry.ChatStarters : ChatStarters.Leaders);

    private async Task StartersAsync(string starters)
    {
        string before = StartsChats;
        (_starters, _busy, _problem) = (starters, true, null);
        try
        {
            await Ministries.SavePartsAsync(Page.Ministry.Id, Off, FromBelow, starters);
            await OnChanged.InvokeAsync();
        }
        catch (RpcException exception)
        {
            (_starters, _problem) = (before, MinistryLookups.Problem(exception));
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<(MinistryPart, PartFromBelow)> Gathering =>
        Page.SubMinistries.Count == 0 ? [] : MinistryParts.All.Where(part => part.FromBelow is not null && !Off.Contains(part.Key)).Select(part => (part, part.FromBelow!));

    private Task TurnAsync(string part, bool on) =>
        SaveAsync(on ? Off.Where(off => off != part).ToList() : [.. Off, part], FromBelow);

    private Task FromBelowAsync(string part, bool on) =>
        SaveAsync(Off, on ? [.. FromBelow, part] : FromBelow.Where(each => each != part).ToList());

    private async Task SaveAsync(List<string> off, List<string> fromBelow)
    {
        (List<string> before, List<string> beforeFromBelow) = (_off, _fromBelow);
        (_off, _fromBelow, _busy, _problem) = (off, fromBelow, true, null);
        try
        {
            await Ministries.SavePartsAsync(Page.Ministry.Id, off, fromBelow);
            await OnChanged.InvokeAsync();
        }
        catch (RpcException exception)
        {
            (_off, _fromBelow, _problem) = (before, beforeFromBelow, MinistryLookups.Problem(exception));
        }
        finally
        {
            _busy = false;
        }
    }
}
