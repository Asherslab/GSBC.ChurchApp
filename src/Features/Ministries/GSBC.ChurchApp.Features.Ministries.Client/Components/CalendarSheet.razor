@inject IMinistryWrites Ministries

<UnsavedGuard Changed="() => Open" Editing="Draft" State="() => Shape" What="this calendar" />

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@(Draft.Id.Length == 0 ? "Add a calendar" : Draft.Name)" Lead="Leaders add events to it in the calendar. Who it's for decides who sees its events.">
    <ChildContent>
        <Segmented TValue="string" Label="Who it's for" ShowLabel="true" Stacked="true" Options="Audiences" Value="Draft.Audience" ValueChanged="value => Draft.Audience = value" />
        <TextField Label="Name" @bind-Value="Draft.Name" MaxLength="60" Placeholder="@DefaultName" Hint="Leave it empty for the usual name." />
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="@(Draft.Id.Length == 0 ? "Add the calendar" : "Save")" Busy="_busy" OnSave="SaveAsync" />
    </Actions>
</Sheet>

@code {
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required CalendarLine Draft { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private object Shape => (Draft.Name, Draft.Audience);

    private IReadOnlyList<SegmentOption<string>> Audiences =>
        (Page.Ministry.AttendJoin == Joining.None ? [Contracts.Audiences.Everyone, Contracts.Audiences.Team] : Contracts.Audiences.All)
        .Select(audience => new SegmentOption<string>(audience, MinistryWords.Short(audience))).ToList();

    private string DefaultName => Draft.Audience switch
    {
        Contracts.Audiences.Team => $"{Page.Ministry.Name} team",
        Contracts.Audiences.Parents => $"{Page.Ministry.Name} parents",
        Contracts.Audiences.Attendees => $"{Page.Ministry.Name} families",
        _ => Page.Ministry.Name,
    };

    public static CalendarLine DraftOf(CalendarLine? calendar, MinistryPage page) => new()
    {
        Id = calendar?.Id ?? "", Name = calendar?.Name ?? "",
        Audience = calendar?.Audience ?? (page.Calendars.Count == 0 ? Contracts.Audiences.Everyone : Contracts.Audiences.Team),
    };

    private Task SaveAsync() =>
        RunAsync(async () =>
        {
            await Ministries.SaveCalendarAsync(Page.Ministry.Id, Draft);
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        });

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
