@inject MinistriesClient Ministries

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@(Draft.Id.Length == 0 ? "Add a calendar" : Draft.Name)" Lead="Leaders add events to it in the calendar. Who it's for decides who sees its events.">
    <ChildContent>
        @if (_removal is { } removal)
        {
            <Notice Tone="NoticeTone.Warning" Text="@($"Removing {removal.Name} also deletes its {(removal.Events == 1 ? "event" : $"{removal.Events} events")}. This can't be undone.")" />
        }
        else
        {
            <Segmented TValue="string" Label="Who it's for" Stacked="true" Options="Audiences" Value="Draft.Audience" ValueChanged="value => Draft.Audience = value" />
            <TextField Label="Name" @bind-Value="Draft.Name" MaxLength="60" Placeholder="@DefaultName" Hint="Leave it empty for the usual name." />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        @if (_removal is not null)
        {
            <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="RemoveAsync">Remove it and its events</Button>
            <Button Block="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => _removal = null">Keep it</Button>
        }
        else
        {
            <Button Block="true" Busy="_busy" OnClick="SaveAsync">@(Draft.Id.Length == 0 ? "Add the calendar" : "Save")</Button>
            @if (Draft.Id.Length > 0)
            {
                <Button Block="true" Variant="ButtonVariant.Danger" Disabled="_busy" OnClick="AskRemoveAsync">Remove the calendar</Button>
            }
        }
    </Actions>
</Sheet>

@code {
    private CalendarRemoval? _removal;
    private bool _busy;
    private string? _problem;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter, EditorRequired] public required CalendarLine Draft { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private IReadOnlyList<SegmentOption<string>> Audiences =>
        (Page.Ministry.AttendJoin == Joining.None ? [Contracts.Audiences.Everyone, Contracts.Audiences.Team] : Contracts.Audiences.All)
        .Select(audience => new SegmentOption<string>(audience, MinistryWords.Short(audience))).ToList();

    private string DefaultName => Draft.Audience switch
    {
        Contracts.Audiences.Team => $"{Page.Ministry.Name} team",
        Contracts.Audiences.Parents => $"{Page.Ministry.Name} parents",
        Contracts.Audiences.Attendees => $"{Page.Ministry.Name} families",
        _ => Page.Ministry.Name,
    };

    public static CalendarLine DraftOf(CalendarLine? calendar, MinistryPage page) => new()
    {
        Id = calendar?.Id ?? "", Name = calendar?.Name ?? "",
        Audience = calendar?.Audience ?? (page.Calendars.Count == 0 ? Contracts.Audiences.Everyone : Contracts.Audiences.Team),
    };

    private Task SaveAsync() =>
        RunAsync(async () =>
        {
            await Ministries.SaveCalendarAsync(Page.Ministry.Id, Draft);
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        });

    private Task AskRemoveAsync() => RunAsync(async () => _removal = await Ministries.CalendarRemovalAsync(Page.Ministry.Id, Draft.Id));

    private Task RemoveAsync() =>
        RunAsync(async () =>
        {
            await Ministries.RemoveCalendarAsync(Page.Ministry.Id, Draft.Id);
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        });

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
        }
        catch (RpcException exception)
        {
            _problem = MinistriesClient.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
