<Section First="true">
    @if (Page.You.MayEditSettings)
    {
        <div class="ministry-tools">
            <Button Icon="calendar-plus" OnClick="() => Open(null)">Add a calendar</Button>
        </div>
    }
    @if (Page.Calendars.Count == 0)
    {
        <EmptyState Icon="calendar" Title="No calendars yet" Body="Add a calendar for everyone, or one only the team sees. Its events show in people's week and their calendar links." />
    }
    @foreach (string audience in MinistryWords.BoxOrder.Where(audience => Page.Calendars.Any(calendar => calendar.Audience == audience)))
    {
        <MinistryBox Audience="@audience">
            <ListGroup>
                @foreach (CalendarLine calendar in Page.Calendars.Where(calendar => calendar.Audience == audience))
                {
                    <ListRow @key="calendar.Id" Title="@calendar.Name" Subtitle="See its events, or add it to your week" Icon="calendar" IconTone="RowTone.Accent" Chevron="true" Href="@MinistriesPlaces.CalendarPage(calendar)">
                        <TrailingContent>
                            @if (Page.You.MayEditSettings)
                            {
                                <Button Small="true" Variant="ButtonVariant.Quiet" Icon="pencil" AriaLabel="@($"Change {calendar.Name}")" OnClick="() => Open(calendar)" />
                            }
                        </TrailingContent>
                    </ListRow>
                }
            </ListGroup>
        </MinistryBox>
    }
</Section>

<CalendarSheet @key="_draft" Open="_open" OpenChanged="open => _open = open" Page="Page" Draft="_draft" OnSaved="OnChanged" />

@code {
    private bool _open;
    private CalendarLine _draft = new();

    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private void Open(CalendarLine? calendar) => (_draft, _open) = (CalendarSheet.DraftOf(calendar, Page), true);
}
