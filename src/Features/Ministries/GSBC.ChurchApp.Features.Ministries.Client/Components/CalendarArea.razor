@using GSBC.ChurchApp.Platform.Client.Modules
@inject MinistryLinks Links
@inject IMinistryWrites Ministries
@inject MinistryLookups Lookups
@inject IServiceProvider Services
@inject TimeProvider Clock
@inject NavigationManager Navigation

@if (Tools)
{
    <Section First="true">
        @if (Page.You.MayEditSettings)
        {
            <div class="ministry-tools">
                <Button Icon="calendar-plus" OnClick="() => Open(null)">Add a calendar</Button>
                @if (Services.GetService(typeof(ILinkableCalendars)) is ILinkableCalendars linkable)
                {
                    <Button Icon="link" Variant="ButtonVariant.Quiet" OnClick="() => OpenLinking(linkable)">Link a calendar</Button>
                }
            </div>
        }
        @if (Page.Calendars.Count == 0)
        {
            <EmptyState Icon="calendar" Title="No calendars yet" Body="@(Page.Ministry.ShowsInLifeGroups ? "Link the calendar its Sundays are in, and its events show here while it runs. Or add a calendar of its own." : "Add a calendar for everyone, or one only the team sees. Its events show in people's week and their calendar links.")" />
        }
    </Section>
}

@if (MayTellAboutASunday)
{
    <Section First="@(!Tools)">
        <ListGroup>
            <ListRow Title="Tell the group about a Sunday" Subtitle="A post in News for one of its Sundays. It shows here under that Sunday too." Icon="megaphone" IconTone="RowTone.Accent" Chevron="true"
                     OnClick="TellAboutASunday" />
        </ListGroup>
    </Section>
}

@if (Page.Calendars.Count > 0 && Services.GetService(typeof(CalendarSetView)) is CalendarSetView view)
{
    <Section First="@(!Tools && !MayTellAboutASunday)" Title="Coming up" Lead="@(FromBelow.Count > 0 ? $"From {Page.Ministry.Name} and the ministries under it." : null)">
        @view.ComingUp(Page.Calendars.Select(calendar => new CalendarInSet(calendar.Id, calendar.From.Length > 0 ? calendar.From : Page.Ministry.Name,
            calendar.OnlyWithin ? MinistryWords.Ranges(calendar.Within) : null, TakesNotes(calendar) ? Notes : null)).ToList())
    </Section>
}

<Section Title="@(FromBelow.Count > 0 && Own.Any() ? "Its calendars" : null)">
    @foreach (string audience in MinistryWords.BoxOrder.Where(audience => Own.Any(calendar => calendar.Audience == audience)))
    {
        <MinistryBox Audience="@audience">
            <ListGroup>
                @foreach (CalendarLine calendar in Own.Where(calendar => calendar.Audience == audience))
                {
                    <ListRow @key="calendar.Id" Title="@calendar.Name" Subtitle="@Links.CalendarNote" Icon="calendar" IconTone="RowTone.Accent" Chevron="true" Href="@Links.Calendar(calendar)"
                             Actions="@(Page.You.MayEditSettings ? OwnActions(calendar) : null)" />
                }
            </ListGroup>
        </MinistryBox>
    }
</Section>

@if (Linked.Count > 0)
{
    <Section Title="Linked calendars" Lead="@LinkedLead">
        <ListGroup>
            @foreach (CalendarLine calendar in Linked)
            {
                <ListRow @key="calendar.Id" Title="@calendar.Name" Subtitle="@Links.CalendarNote" Icon="link" IconTone="RowTone.Quiet" Chevron="true" Href="@Links.Calendar(calendar)"
                         Actions="@(Page.You.MayEditSettings ? LinkedActions(calendar) : null)" />
            }
        </ListGroup>
    </Section>
}

@if (FromBelow.Count > 0)
{
    <Section Title="From the ministries under it">
        <ListGroup>
            @foreach (CalendarLine calendar in FromBelow)
            {
                <ListRow @key="calendar.Id" Title="@calendar.Name" Subtitle="@(calendar.Name == calendar.From ? MinistryWords.Box(calendar.Audience) : $"{calendar.From} · {MinistryWords.Box(calendar.Audience)}")" Icon="calendar" IconTone="RowTone.Quiet" Chevron="true" Href="@Links.Calendar(calendar)" />
            }
        </ListGroup>
    </Section>
}

<Sheet Open="_choices is not null" OpenChanged="open => { if (!open) _choices = null; }" Title="Link a calendar" Lead="@LinkLead">
    <ChildContent>
        <ListGroup>
            @foreach (Contracts.Crumb choice in _choices ?? [])
            {
                <ListRow @key="choice.Id" Title="@choice.Name" Icon="calendar" IconTone="RowTone.Accent" Disabled="_busy" OnClick="() => LinkAsync(choice.Id)" />
            }
        </ListGroup>
        @if (_choices is { Count: 0 })
        {
            <p class="hint">Every calendar for everyone is already linked or is this ministry's own.</p>
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
</Sheet>

<Sheet Open="_unlinking is not null" OpenChanged="open => { if (!open) _unlinking = null; }" Title="@($"Unlink {_unlinking?.Name}?")"
       Lead="@($"Its events stop showing in {Page.Ministry.Name}. The calendar and its events aren't changed, and you can link it again.")">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="UnlinkAsync">Unlink it</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => _unlinking = null">Keep it</Button>
    </Actions>
</Sheet>

<Sheet Open="_removal is not null" OpenChanged="open => { if (!open) _removal = null; }" Title="@($"Remove {_removal?.Name}?")"
       Lead="@(_removal is { } removal ? $"This also deletes its {(removal.Events == 1 ? "event" : $"{removal.Events} events")}. This can't be undone." : null)">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="RemoveAsync">Remove it and its events</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => _removal = null">Keep it</Button>
    </Actions>
</Sheet>

<CalendarSheet @key="_draft" Open="_open" OpenChanged="open => _open = open" Page="Page" Draft="_draft" OnSaved="OnChanged" />
<PostSheet Open="_telling" OpenChanged="open => _telling = open" Page="Page" Draft="_post" OnSaved="OnChanged" />

@code {
    private bool _open;
    private bool _telling;
    private CalendarLine _draft = new();
    private Post _post = new();
    private IReadOnlyList<Contracts.Crumb>? _choices;
    private CalendarLine? _unlinking;
    private CalendarRemoval? _removal;
    private string _removing = "";
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required MinistryPage Page { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool Tools => Page.You.MayEditSettings || Page.Calendars.Count == 0;

    private IEnumerable<CalendarLine> Own => Page.Calendars.Where(calendar => calendar.From.Length == 0 && !calendar.Linked);

    private IReadOnlyList<CalendarLine> Linked => Page.Calendars.Where(calendar => calendar.Linked).ToList();

    private IReadOnlyList<CalendarLine> FromBelow => Page.Calendars.Where(calendar => calendar.From.Length > 0 && !calendar.Linked).ToList();

    private bool MayTellAboutASunday =>
        Page.Ministry.ShowsInLifeGroups && Page.You.MayPostFor.Count > 0 && MinistryParts.IsOn(Page.Ministry.PartsOff, MinistryParts.News)
        && SundayPosts.UpcomingSundays(Page, Clock).Count > 0;

    private bool TakesNotes(CalendarLine calendar) => calendar.Linked || Linked.Count == 0;

    private IReadOnlyList<DayNote> Notes => SundayPosts.Notes(Page);

    private string? LinkedLead => !Page.Ministry.ShowsInLifeGroups
        ? null
        : Linked.FirstOrDefault()?.Within is { Count: > 0 } within
            ? $"Only their events while {Page.Ministry.Name} runs show here: {MinistryWords.Span(within)}."
            : $"Their events show here once {Page.Ministry.Name}'s Sundays are planned.";

    private string LinkLead => Page.Ministry.ShowsInLifeGroups
        ? "Its events show here while the group runs. Only calendars for everyone can be linked."
        : "Its events show here. Only calendars for everyone can be linked.";

    private IReadOnlyList<MenuItem> OwnActions(CalendarLine calendar) =>
    [
        this.Item($"Change {calendar.Name}", () => Open(calendar), "pencil", "Its name and who it's for"),
        this.Item($"Remove {calendar.Name}…", () => AskRemoveAsync(calendar), "trash", "Shows how many events go with it first", danger: true, startsGroup: true),
    ];

    private IReadOnlyList<MenuItem> LinkedActions(CalendarLine calendar) =>
    [
        this.Item($"Unlink {calendar.Name}…", () => { (_unlinking, _problem) = (calendar, null); }, "x", "The calendar itself isn't changed", danger: true),
    ];

    private void TellAboutASunday()
    {
        string sunday = SundayPosts.UpcomingSundays(Page, Clock)[0];
        if (Links.WritesOnAPage)
            Navigation.NavigateTo(MinistryLinks.Writing(Page.Ministry.Id, sunday: sunday));
        else
            (_post, _telling) = (PostSheet.DraftForSunday(Page, sunday), true);
    }

    private async Task OpenLinking(ILinkableCalendars linkable)
    {
        _problem = null;
        _choices = await linkable.ChoicesAsync(Page.Ministry.Id);
    }

    private Task LinkAsync(string calendarId) =>
        RunAsync(async () =>
        {
            await Ministries.LinkCalendarAsync(Page.Ministry.Id, calendarId, true);
            _choices = null;
        });

    private Task UnlinkAsync() =>
        RunAsync(async () =>
        {
            await Ministries.LinkCalendarAsync(Page.Ministry.Id, _unlinking!.Id, false);
            _unlinking = null;
        });

    private Task AskRemoveAsync(CalendarLine calendar) =>
        RunAsync(async () => (_removing, _removal) = (calendar.Id, await Lookups.CalendarRemovalAsync(Page.Ministry.Id, calendar.Id)), reload: false);

    private Task RemoveAsync() =>
        RunAsync(async () =>
        {
            await Ministries.RemoveCalendarAsync(Page.Ministry.Id, _removing);
            _removal = null;
        });

    private async Task RunAsync(Func<Task> work, bool reload = true)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            if (reload)
                await OnChanged.InvokeAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistryLookups.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Open(CalendarLine? calendar) => (_draft, _open) = (CalendarSheet.DraftOf(calendar, Page), true);
}
