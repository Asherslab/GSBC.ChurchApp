<div class="ministry-joining">
    <Segmented TValue="string" Label="Joining the team" ShowLabel="true" Stacked="true"
               Hint="The team runs the ministry: its leaders, helpers and anyone on the roster. Choose how someone joins the team."
               Options="TeamOptions" Value="TeamJoin" ValueChanged="TeamJoinChanged" />
    <Segmented TValue="string" Label="Attending" ShowLabel="true" Stacked="true"
               Hint="Attendees are the people the ministry is for. Choose how someone starts attending. Parents join on behalf of their children."
               Options="AttendOptions" Value="AttendJoin" ValueChanged="AttendJoinChanged" />
</div>

@code {
    private static readonly IReadOnlyList<SegmentOption<string>> TeamOptions =
    [
        new(Joining.Open, "Open") { Detail = "Anyone can join the team in the app, straight away." },
        new(Joining.Ask, "Ask") { Detail = "People ask to join the team, and a leader approves them." },
        new(Joining.Invite, "Invite only") { Detail = "Nobody can ask to join. Leaders add people to the team themselves." },
    ];

    private static readonly IReadOnlyList<SegmentOption<string>> AttendOptions =
    [
        new(Joining.Open, "Open") { Detail = "Anyone can tap Join and start attending straight away." },
        new(Joining.Ask, "Ask") { Detail = "People ask to attend, and a leader approves them." },
        new(Joining.Invite, "Invite only") { Detail = "Nobody can ask to attend. Leaders add attendees themselves." },
        new(Joining.None, "No attendees") { Detail = "This ministry has a team but no attendees. Its posts and files are for everyone or for the team." },
    ];

    [Parameter, EditorRequired] public required string TeamJoin { get; set; }
    [Parameter] public EventCallback<string> TeamJoinChanged { get; set; }
    [Parameter, EditorRequired] public required string AttendJoin { get; set; }
    [Parameter] public EventCallback<string> AttendJoinChanged { get; set; }
}
