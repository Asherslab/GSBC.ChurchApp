<div class="ministry-joining">
    <Segmented TValue="string" Label="Joining the team" ShowLabel="true" Stacked="true"
               Hint="The team runs it: its leaders, helpers and anyone on the roster. How does someone get on it?"
               Options="TeamOptions" Value="TeamJoin" ValueChanged="TeamJoinChanged" />
    <Segmented TValue="string" Label="Coming along" ShowLabel="true" Stacked="true"
               Hint="Attendees are the people it's for. How does someone start coming? Parents join for their children."
               Options="AttendOptions" Value="AttendJoin" ValueChanged="AttendJoinChanged" />
    @if (Hidden)
    {
        <p class="field__hint">While it's hidden, only people who can already see it can join or ask. Everyone else is added by its leaders.</p>
    }
</div>

@code {
    private static readonly IReadOnlyList<SegmentOption<string>> TeamOptions =
    [
        new(Joining.Open, "Open") { Detail = "Anyone can join the team from the app, straight away." },
        new(Joining.Ask, "Ask") { Detail = "People ask to join the team, and a leader says yes." },
        new(Joining.Invite, "Invite only") { Detail = "Nobody can ask. Leaders add people to the team themselves." },
    ];

    private static readonly IReadOnlyList<SegmentOption<string>> AttendOptions =
    [
        new(Joining.Open, "Open") { Detail = "Anyone can tap Join and they're in, straight away." },
        new(Joining.Ask, "Ask") { Detail = "People ask to come along, and a leader says yes." },
        new(Joining.Invite, "Invite only") { Detail = "Nobody can ask. Leaders add the people who come." },
        new(Joining.None, "No attendees") { Detail = "Only the team serves in it. Nobody comes along, so posts are for everyone or the team." },
    ];

    [Parameter, EditorRequired] public required string TeamJoin { get; set; }
    [Parameter] public EventCallback<string> TeamJoinChanged { get; set; }
    [Parameter, EditorRequired] public required string AttendJoin { get; set; }
    [Parameter] public EventCallback<string> AttendJoinChanged { get; set; }
    [Parameter] public bool Hidden { get; set; }
}
