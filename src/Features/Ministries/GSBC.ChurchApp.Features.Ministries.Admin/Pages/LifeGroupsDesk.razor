@page "/life-groups"
@using System.Globalization
@inject MinistriesClient Ministries
@inject TimeProvider Clock

<TitleBand Title="Life Groups" Lead="Every ministry shown in Life Groups, wherever it sits. People see the next groups in the app from the date you choose.">
    <Actions>
        @if (_page is { MayPlan: true })
        {
            <Button Variant="ButtonVariant.Quiet" Icon="calendar" OnClick="() => OpenSet(null)">Plan the next groups</Button>
        }
        @if (_mayAdd)
        {
            <Button Icon="plus" OnClick="() => OpenGroup(null)">Add a Life Group</Button>
        }
    </Actions>
</TitleBand>

<LiveData @ref="_live" TValue="LifeGroupsPage" Load="LoadAsync" Feeds="[MinistriesFeeds.Ministries]" FailedTitle="Can't load Life Groups right now">
    @{
        LifeGroupsPage page = context.Value;
        DateOnly today = ChurchTime.Today(Clock);
    }
    @if (page.Groups.Count == 0 && page.Rounds.Count == 0)
    {
        <EmptyState Icon="book-open" Title="No Life Groups yet" Body="A Life Group is a ministry shown here, under any ministry. Add one, or switch on Show in Life Groups in a ministry's settings.">
            @if (_mayAdd)
            {
                <Button OnClick="() => OpenGroup(null)">Add a Life Group</Button>
            }
        </EmptyState>
    }
    else
    {
        @if (!page.MayPlan)
        {
            <Notice Text="Staff who plan Life Groups set their Sundays. You can see them here." />
        }
        <ListGroup>
            <ListRow Title="@(page.CalendarName.Length > 0 ? $"Shown in {page.CalendarName}" : "Not shown in a calendar")" Icon="calendar" IconTone="RowTone.Quiet"
                     Subtitle="@(page.CalendarName.Length > 0 ? "One Life Groups entry on each Sunday they meet, kept in step with the Sundays here. Sundays between show as not on." : "Show one Life Groups entry in a calendar, such as the one for Sunday services, kept in step with the Sundays here.")"
                     Chevron="page.MayPlan" OnClick="() => page.MayPlan ? OpenCalendarAsync() : Task.CompletedTask" />
        </ListGroup>
        <div class="life-groups-desk">
            @foreach (Round round in page.Rounds.OrderBy(round => round.Sundays.FirstOrDefault()))
            {
                List<MinistrySummary> groups = page.Groups.Where(group => group.RoundId == round.Id).ToList();
                List<MinistrySummary> allYear = AllYear(page);
                <section class="life-groups-desk__set" @key="round.Id">
                    <header class="life-groups-desk__head">
                        <h2>@MinistryWords.Span(round)</h2>
                        <Pill Tone="@Tone(round, today)">@State(round, today)</Pill>
                    </header>
                    <p class="hint">@Count(round.Sundays.Count, "Sunday") · @MinistryWords.Time(round.Starts) to @MinistryWords.Time(round.Ends)@(round.ShowsFrom.Length > 0 ? $" · shows in the app from {MinistryWords.Day(round.ShowsFrom)}" : "")</p>
                    <ListGroup>
                        @foreach (MinistrySummary group in groups)
                        {
                            <ListRow @key="group.Id" Title="@group.Name" Subtitle="@GroupLine(page, group)" Chevron="true" Href="@($"ministries/{group.Id}")" />
                        }
                        @foreach (MinistrySummary group in allYear)
                        {
                            if (LifeGroupRounds.SitsOut(group.Id, round, page.SittingOut) is { } off)
                            {
                                <ListRow @key="@($"off-{group.Id}")" Title="@group.Name" Subtitle="@OffLine(off)" Icon="circle-off" IconTone="RowTone.Quiet"
                                         Chevron="page.MayPlan" OnClick="() => { if (page.MayPlan) OpenSitOut(round, off); }" />
                            }
                        }
                        @if (_mayAdd)
                        {
                            <ListRow Title="Add a group" Icon="plus" IconTone="RowTone.Accent" OnClick="() => OpenGroup(round.Id)" />
                        }
                        @if (page.MayPlan && !Finished(round, today) && allYear.Any(group => LifeGroupRounds.Runs(group.Id, "", round, page.SittingOut)))
                        {
                            <ListRow Title="An all-year group isn't on these Sundays" Icon="circle-off" IconTone="RowTone.Accent" OnClick="() => OpenSitOut(round, null)" />
                        }
                    </ListGroup>
                    @if (page.MayPlan)
                    {
                        <div class="ui-actions ministry-actions">
                            <Button Small="true" Variant="ButtonVariant.Quiet" Icon="pencil" OnClick="() => OpenSet(round)">Sundays and time</Button>
                            @if (groups.Count == 0)
                            {
                                <Button Small="true" Variant="ButtonVariant.Quiet" Icon="x" OnClick="() => DeleteSetAsync(round)">Delete</Button>
                            }
                        </div>
                    }
                </section>
            }
            <section class="life-groups-desk__set">
                <header class="life-groups-desk__head"><h2>All year</h2></header>
                <p class="hint">Groups that meet on every set of Sundays, wherever they sit.</p>
                <ListGroup>
                    @foreach (MinistrySummary group in AllYear(page))
                    {
                        <ListRow @key="group.Id" Title="@group.Name" Subtitle="@GroupLine(page, group)" Chevron="true" Href="@($"ministries/{group.Id}")" />
                    }
                    @if (_mayAdd)
                    {
                        <ListRow Title="Add an all-year group" Icon="plus" IconTone="RowTone.Accent" OnClick="() => OpenGroup(null)" />
                    }
                </ListGroup>
            </section>
        </div>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    }
</LiveData>

<UnsavedGuard Changed="() => _setOpen && SetShape != _setWas" What="these groups' Sundays and time" />

<Sheet Open="_setOpen" OpenChanged="open => _setOpen = open" Title="@(_set is null ? "Plan the next groups" : "Sundays and time")" Lead="People see these groups by their dates. Add the Sundays from a date range, then take off any they don't meet." Wide="true">
    <ChildContent>
        <div class="filter-chips">
            @foreach (string sunday in _sundays.Order())
            {
                <button type="button" class="filter-chip filter-chip--on" @key="sunday" aria-label="@($"Take off {MinistryWords.Day(sunday)}")" @onclick="() => _sundays.Remove(sunday)">
                    @MinistryWords.Day(sunday) <Icon Name="x" Size="IconSize.Small" />
                </button>
            }
        </div>
        <div class="ui-pair">
            <TextField Label="From" Type="date" @bind-Value="_from" />
            <TextField Label="To" Type="date" @bind-Value="_to" />
        </div>
        <div class="ui-actions">
            <Button Small="true" Variant="ButtonVariant.Quiet" Icon="plus" Disabled="@(Day(_from) == DateOnly.MinValue || Day(_to) < Day(_from))" OnClick="AddSundays">Add the Sundays in these dates</Button>
        </div>
        <div class="ui-pair">
            <TextField Label="Starts" Type="time" @bind-Value="_starts" />
            <TextField Label="Ends" Type="time" @bind-Value="_ends" />
        </div>
        <TextField Label="Shows in the app from" Type="date" @bind-Value="_showsFrom" Hint="Usually during the break before they start. Leave empty to show them straight away." />
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="Save" Busy="_busy" OnSave="SaveSetAsync" Blocked="@(_sundays.Count == 0 ? "Add the Sundays they meet to save them." : null)" />
    </Actions>
</Sheet>

<UnsavedGuard Changed="() => _calendarOpen && !_confirmingRemoval && _calendarChoice != _calendarWas" What="where Life Groups show" />

<Sheet Open="_calendarOpen" OpenChanged="open => _calendarOpen = open" Title="@(_confirmingRemoval ? $"Take Life Groups off {_calendar.CalendarName}?" : "Show Life Groups in a calendar")"
       Lead="@(_confirmingRemoval ? "Its entry comes off every phone and calendar app that has it. You can show it in a calendar again at any time." : "One Life Groups entry on each Sunday they meet, at that set's time. Sundays between sets show as not on, and it changes by itself when the Sundays here change. Tapping it in the app opens Life Groups.")">
    <ChildContent>
        @if (!_confirmingRemoval)
        {
            <SelectField Label="Show Life Groups in" Options="CalendarOptions" @bind-Value="_calendarChoice"
                         Hint="@(_calendar.Choices.Count == 0 ? "You can choose a calendar you add events to. Ask whoever looks after the calendar to give you that." : "Calendars you add events to.")" />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        @if (_confirmingRemoval)
        {
            <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="SaveCalendarAsync">Take it off</Button>
            <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _confirmingRemoval = false">Keep it</Button>
        }
        else
        {
            <SaveBar Block="true" Label="Save" Busy="_busy" State="SaveBar.For(_calendarChoice != _calendarWas, false)" OnSave="SaveCalendarAsync" />
        }
    </Actions>
</Sheet>

<UnsavedGuard Changed="() => _sitOutRound is not null && (_sitOutGroup, _sitOutNote, _sitOutInstead) != _sitOutWas" What="this group's Sundays" />

<Sheet Open="_sitOutRound is not null" OpenChanged="open => { if (!open) _sitOutRound = null; }" Title="@(_sitOutRound is { } off ? $"Not on {MinistryWords.Span(off)}" : "")"
       Lead="Its people keep their place in it and are told once, with what you write here. It's back on the next Sundays by itself.">
    <ChildContent>
        @if (_sitOutRound is { } round)
        {
            @if (_sitOutEditing)
            {
                <p class="hint">@NameOf(_sitOutGroup)</p>
            }
            else
            {
                <SelectField Label="Group" Options="SitOutOptions(round)" @bind-Value="_sitOutGroup" />
            }
            <TextField Label="What to tell its people" @bind-Value="_sitOutNote" MaxLength="200" Hint="Where to go instead, or what's happening." />
            <SelectField Label="Point them to" Options="InsteadOptions(round)" @bind-Value="_sitOutInstead" Hint="The group shows a link to it." />
        }
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <SaveBar Block="true" Label="@(_sitOutEditing ? "Save" : "Mark it not on")" Busy="_busy" OnSave="() => SaveSitOutAsync(off: true)"
                 Blocked="@(_sitOutGroup.Length == 0 ? "Choose the group." : null)" />
        @if (_sitOutEditing)
        {
            <Button Block="true" Variant="ButtonVariant.Quiet" Busy="_busy" OnClick="() => SaveSitOutAsync(off: false)">It's on these Sundays after all</Button>
        }
    </Actions>
</Sheet>

<MinistrySheet Open="_groupOpen" OpenChanged="open => _groupOpen = open" InLifeGroups="true" RoundId="@(_groupRound ?? "")" OnCreated="_ => ReloadAsync()" />

@code {
    private LiveData<LifeGroupsPage>? _live;
    private LifeGroupsPage? _page;
    private bool _mayAdd;
    private bool _setOpen;
    private Round? _set;
    private List<string> _sundays = [];
    private string _from = "";
    private string _to = "";
    private string _starts = "09:00";
    private string _ends = "09:45";
    private string _showsFrom = "";
    private string _setWas = "";
    private bool _groupOpen;
    private string? _groupRound;
    private bool _busy;
    private string? _problem;

    private bool _calendarOpen;
    private bool _confirmingRemoval;
    private LifeGroupsCalendar _calendar = new();
    private string _calendarChoice = "";
    private string _calendarWas = "";
    private Round? _sitOutRound;
    private bool _sitOutEditing;
    private string _sitOutGroup = "";
    private string _sitOutNote = "";
    private string _sitOutInstead = "";
    private (string, string, string) _sitOutWas;

    private async Task<LifeGroupsPage> LoadAsync()
    {
        _page = await Ministries.LifeGroupsAsync();
        MinistryDirectory directory = await Ministries.DirectoryAsync();
        _mayAdd = directory.MayCreate || directory.Ministries.Any(ministry => ministry.MayAddUnder);
        StateHasChanged();
        return _page;
    }

    private static List<MinistrySummary> AllYear(LifeGroupsPage page) =>
        page.Groups.Where(group => page.Rounds.All(round => round.Id != group.RoundId)).ToList();

    private static bool Finished(Round round, DateOnly today) => Day(round.Sundays.LastOrDefault()) < today;

    private static string OffLine(SittingOut off) =>
        string.Join(" · ", new[] { "Not on these Sundays", off.Note, off.InsteadName.Length > 0 ? $"pointing to {off.InsteadName}" : "" }.Where(part => part.Length > 0));

    private string NameOf(string groupId) => _page?.Groups.FirstOrDefault(group => group.Id == groupId)?.Name ?? "";

    private IReadOnlyList<FieldOption> CalendarOptions =>
        new[] { new FieldOption("", "No calendar") }
            .Concat(_calendar.CalendarId.Length > 0 && _calendar.Choices.All(choice => choice.Id != _calendar.CalendarId) ? [new FieldOption(_calendar.CalendarId, _calendar.CalendarName)] : [])
            .Concat(_calendar.Choices.Select(choice => new FieldOption(choice.Id, choice.Name)))
            .ToList();

    private IReadOnlyList<FieldOption> SitOutOptions(Round round) =>
        new[] { new FieldOption("", "Choose a group") }
            .Concat(_page is null ? [] : AllYear(_page).Where(group => LifeGroupRounds.Runs(group.Id, "", round, _page.SittingOut)).Select(group => new FieldOption(group.Id, group.Name)))
            .ToList();

    private IReadOnlyList<FieldOption> InsteadOptions(Round round) =>
        new[] { new FieldOption("", "Nowhere") }
            .Concat(_page is null ? [] : _page.Groups.Where(group => group.Id != _sitOutGroup && LifeGroupRounds.Runs(group.Id, group.RoundId, round, _page.SittingOut))
                .Select(group => new FieldOption(group.Id, group.Name)))
            .ToList();

    private async Task OpenCalendarAsync()
    {
        (_problem, _confirmingRemoval) = (null, false);
        try
        {
            _calendar = await Ministries.LifeGroupsCalendarAsync();
            (_calendarChoice, _calendarWas, _calendarOpen) = (_calendar.CalendarId, _calendar.CalendarId, true);
        }
        catch (RpcException exception)
        {
            _problem = MinistriesClient.Problem(exception);
        }
    }

    private async Task SaveCalendarAsync()
    {
        if (_calendarChoice == _calendarWas)
        {
            _calendarOpen = false;
            return;
        }
        if (_calendarChoice.Length == 0 && !_confirmingRemoval)
        {
            _confirmingRemoval = true;
            return;
        }
        await RunAsync(async () =>
        {
            _calendar = await Ministries.ShowLifeGroupsInAsync(_calendarChoice);
            (_calendarOpen, _confirmingRemoval) = (false, false);
        });
    }

    private void OpenSitOut(Round round, SittingOut? off)
    {
        (_sitOutRound, _sitOutEditing, _problem) = (round, off is not null, null);
        (_sitOutGroup, _sitOutNote, _sitOutInstead) = (off?.GroupId ?? "", off?.Note ?? "", off?.InsteadId ?? "");
        _sitOutWas = (_sitOutGroup, _sitOutNote, _sitOutInstead);
    }

    private Task SaveSitOutAsync(bool off) =>
        RunAsync(async () =>
        {
            await Ministries.SitOutAsync(new SittingOut { GroupId = _sitOutGroup, RoundId = _sitOutRound!.Id, Note = _sitOutNote, InsteadId = _sitOutInstead }, off);
            _sitOutRound = null;
        });

    private static string Count(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";

    private static string GroupLine(LifeGroupsPage page, MinistrySummary group) =>
        string.Join(" · ", new[] { Where(page, group), group.Meets, group.Summary }.Where(part => part.Length > 0));

    private static string Where(LifeGroupsPage page, MinistrySummary group) =>
        page.Under.FirstOrDefault(crumb => crumb.Id == group.ParentId) is { } parent ? $"Under {parent.Name}" : "Top-level";

    private static string State(Round round, DateOnly today) =>
        Day(round.Sundays.LastOrDefault()) < today ? "Finished"
        : Day(round.Sundays.FirstOrDefault()) <= today ? "Now on"
        : round.ShowsFrom.Length > 0 && Day(round.ShowsFrom) > today ? $"Shows from {MinistryWords.Day(round.ShowsFrom)}"
        : "Next";

    private static PillTone Tone(Round round, DateOnly today) =>
        State(round, today) switch { "Now on" => PillTone.Accent, "Finished" => PillTone.Quiet, _ => PillTone.Marker };

    private static DateOnly Day(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly day) ? day : DateOnly.MinValue;

    private void OpenSet(Round? round)
    {
        (_set, _problem, _setOpen) = (round, null, true);
        _sundays = round?.Sundays.ToList() ?? [];
        (_starts, _ends, _showsFrom) = (round?.Starts ?? "09:00", round?.Ends ?? "09:45", round?.ShowsFrom ?? "");
        DateOnly today = ChurchTime.Today(Clock);
        _setWas = SetShape;
        SuggestRange(_sundays.Count > 0 ? Day(_sundays.Max()).AddDays(7) : today.AddDays((7 - (int)today.DayOfWeek) % 7));
    }

    private void SuggestRange(DateOnly firstSunday) =>
        (_from, _to) = (firstSunday.ToString("yyyy-MM-dd"), firstSunday.AddDays(7 * (SundaysInASet - 1)).ToString("yyyy-MM-dd"));

    private string SetShape => string.Join(" ", [.. _sundays.Order(), _starts, _ends, _showsFrom]);

    private const int SundaysInASet = 6;

    private void AddSundays()
    {
        (DateOnly from, DateOnly to) = (Day(_from), Day(_to));
        if (from == DateOnly.MinValue || to < from)
            return;
        DateOnly sunday = from.AddDays((7 - (int)from.DayOfWeek) % 7);
        for (; sunday <= to; sunday = sunday.AddDays(7))
            if (sunday.ToString("yyyy-MM-dd") is var day && !_sundays.Contains(day))
                _sundays.Add(day);
        SuggestRange(sunday);
    }

    private Task SaveSetAsync() =>
        RunAsync(async () =>
        {
            Round round = new() { Id = _set?.Id ?? "", Sundays = _sundays.Order().ToList(), Starts = _starts, Ends = _ends, ShowsFrom = _showsFrom };
            round.Name = MinistryWords.Span(round);
            await Ministries.SaveRoundAsync(round);
            _setOpen = false;
        });

    private Task DeleteSetAsync(Round round) => RunAsync(() => Ministries.DeleteRoundAsync(round.Id));

    private void OpenGroup(string? roundId) => (_groupRound, _problem, _groupOpen) = (roundId, null, true);

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            await ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = MinistriesClient.Problem(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }
}
