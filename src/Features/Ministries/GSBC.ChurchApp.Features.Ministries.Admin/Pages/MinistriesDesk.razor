@page "/ministries"
@page "/ministries/{Id}"
@page "/ministries/{Id}/{Area}"
@inject OnlineMinistries Ministries
@inject NavigationManager Navigation

<LiveData TValue="MinistryDirectory" Load="Ministries.DirectoryAsync" Feeds="Ministries.Feeds" FailedTitle="Can't load the ministries right now">
    <TitleBand Title="Ministries" Lead="@Lead(context.Value)">
        <Actions>
            @if (context.Value.MayCreate || context.Value.Ministries.Any(ministry => ministry.MayAddUnder))
            {
                <Button Icon="plus" OnClick="() => _creating = true">New ministry</Button>
            }
        </Actions>
    </TitleBand>

    <div class="ministry-desk">
        <nav class="ministry-tree" aria-label="Ministries">
            <SearchField Label="Find a ministry" Placeholder="Find a ministry" Value="@_query" ValueChanged="value => _query = value" />
            @foreach ((MinistrySummary ministry, int depth) in Tree(context.Value))
            {
                <div class="ministry-tree__row" @key="ministry.Id" style="@($"padding-left: {depth * 20}px")">
                    @if (MinistryTrees.Under(context.Value.Ministries, ministry) > 0 && _query.Trim().Length == 0)
                    {
                        bool open = !_folded.Contains(ministry.Id);
                        <button type="button" class="ministry-tree__fold @(open ? "ministry-tree__fold--open" : "")" aria-expanded="@(open ? "true" : "false")"
                                aria-label="@($"{(open ? "Hide" : "Show")} the ministries under {ministry.Name}")" @onclick="() => Fold(ministry.Id)">
                            <Icon Name="chevron-right" Size="IconSize.Small" />
                        </button>
                    }
                    else
                    {
                        <span class="ministry-tree__fold-space" aria-hidden="true"></span>
                    }
                    <button type="button" class="ministry-tree__item @(ministry.Id == Id ? "ministry-tree__item--on" : "")"
                            aria-current="@(ministry.Id == Id ? "page" : null)" @onclick="() => Navigation.NavigateTo(Href(ministry.Id, Area ?? string.Empty))">
                        <Icon Name="@AboutArea.IconOf(ministry.Icon)" Size="IconSize.Small" />
                        <span class="ministry-tree__name">@ministry.Name</span>
                        @if (ministry.Waiting > 0)
                        {
                            <span class="tab-strip__count" aria-label="@($"{ministry.Waiting} asking to join")">@ministry.Waiting</span>
                        }
                    </button>
                </div>
            }
        </nav>

    <div>
        @if (Id is { Length: > 0 } id)
        {
            <LiveData @key="id" @ref="_live" TValue="MinistryPage" Context="live" Load="() => Ministries.MinistryAsync(id)" Feeds="Ministries.Feeds" FailedTitle="Can't load this ministry right now">
                @{
                    MinistryPage shown = live.Value;
                    string area = MinistryAreas.Known(shown, Area ?? MinistriesPlaces.About);
                }
                <h2 class="title-band__title">@shown.Ministry.Name</h2>
                <p class="title-band__lead">@(string.Join(" · ", new[] { shown.Path.Count > 0 ? $"Under {string.Join(" › ", shown.Path.Select(crumb => crumb.Name))}" : "", MinistryWords.HeroNote(shown.Ministry) }.Where(part => part.Length > 0)))</p>
                <TabStrip TValue="string" Label="@($"{MinistryWords.Possessive(shown.Ministry.Name)} areas")" Options="MinistryAreas.Tabs(shown)" Value="@area" Href="key => Href(shown.Ministry.Id, key)" />
                <MinistryArea Page="shown" Area="@area" Wide="true" Href="ministry => Href(ministry)" OnChanged="ReloadAsync" />
            </LiveData>
        }
        else
        {
            <EmptyState Icon="users" Title="Choose a ministry" Body="Its people, news, calendars, files and settings open here." />
        }
    </div>
</div>
</LiveData>

<MinistrySheet Open="_creating" OpenChanged="open => _creating = open" UnderId="@(Id ?? "")" OnCreated="created => Navigation.NavigateTo(Href(created.Id, MinistriesPlaces.Settings))" />

@code {
    private LiveData<MinistryPage>? _live;
    private string _query = "";
    private readonly HashSet<string> _folded = [];

    private bool _creating;

    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Area { get; set; }

    private static string Href(string id, string area = "") => area.Length == 0 ? $"ministries/{id}" : $"ministries/{id}/{area}";

    private static string Lead(MinistryDirectory directory)
    {
        int waiting = directory.Ministries.Sum(ministry => ministry.Waiting);
        string ministries = $"{directory.Ministries.Count} {(directory.Ministries.Count == 1 ? "ministry" : "ministries")}";
        return waiting > 0 ? $"{ministries} · {waiting} {(waiting == 1 ? "ask" : "asks")} waiting for an answer" : ministries;
    }

    private IEnumerable<(MinistrySummary Ministry, int Depth)> Tree(MinistryDirectory directory)
    {
        string query = _query.Trim();
        if (query.Length > 0)
        {
            foreach (MinistrySummary found in directory.Ministries.Where(ministry => ministry.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase)))
                yield return (found, 0);
            yield break;
        }
        HashSet<string> path = [.. MinistryTrees.Above(directory.Ministries, Id), .. Id is { Length: > 0 } open ? [open] : Array.Empty<string>()];
        foreach ((MinistrySummary, int) next in MinistryTrees.Walk(directory.Ministries, folded: _folded, path: path))
            yield return next;
    }

    private void Fold(string id)
    {
        if (!_folded.Remove(id))
            _folded.Add(id);
    }

    private async Task ReloadAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }
}
