@page "/media"
@using GSBC.ChurchApp.Features.Media.Contracts

<TitleBand Title="Media" Lead="Pictures and PDFs for the app, in folders. Moving a file never changes where it's used.">
    <Actions>
        <Can Permission="MediaPermissions.Organise">
            <Button Variant="ButtonVariant.Quiet" Icon="folder-plus" OnClick="() => _library?.StartNewFolder()">New folder</Button>
        </Can>
        <Can Permission="MediaPermissions.Upload">
            <Button Icon="plus" OnClick="() => _library?.StartUpload()">Upload</Button>
        </Can>
    </Actions>
</TitleBand>

<MediaLibrary @ref="_library" />

@code {
    private MediaLibrary? _library;
}
