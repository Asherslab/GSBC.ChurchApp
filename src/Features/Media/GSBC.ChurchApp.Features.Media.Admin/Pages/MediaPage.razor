@page "/media"
@using GSBC.ChurchApp.Features.Media.Contracts

<TitleBand Title="Media" Lead="Every picture and PDF uploaded for the app. Choose one to see it, open it, or delete it if nothing uses it.">
    <Actions>
        <Can Permission="MediaPermissions.Upload">
            <Button Icon="plus" OnClick="() => _library?.StartUpload()">Upload</Button>
        </Can>
    </Actions>
</TitleBand>

<MediaLibrary @ref="_library" />

@code {
    private MediaLibrary? _library;
}
