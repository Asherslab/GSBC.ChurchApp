@inject MediaClient Media
@inject MediaFolderMemory Memory
@inject ClientSignals Signals

<div class="media-choice">
    <div class="media-choice__tools">
        <SearchField Label="@FindLabel" Placeholder="@FindLabel"
                     Value="@_query" ValueChanged="SearchAsync" SettleMilliseconds="200" />
        <Button Variant="ButtonVariant.Quiet" Icon="@(_uploading ? "x" : "arrow-up")" OnClick="() => _uploading = !_uploading">@(_uploading ? "Close upload" : "Upload")</Button>
    </div>
    @if (_uploading)
    {
        <MediaUpload Label="@(FontsOnly ? "Choose a font file (.woff2, .woff, .ttf or .otf)" : ImagesOnly ? "Choose a picture" : "Choose a picture or PDF")" FontsOnly="FontsOnly" FolderId="@(Searching ? null : _folderId)" OnUploaded="UploadedAsync" />
    }
    @if (OnThisPhone is { Count: > 0 } here)
    {
        <p class="media-choice__where">On this phone</p>
        <div class="media-choice__grid" role="listbox" aria-label="Pictures on this phone">
            @foreach (MediaRef media in here)
            {
                @Choice(media, "Works offline")
            }
        </div>
        <p class="media-choice__where">The whole library</p>
    }
    <RefreshOn On="ChangeKind.Reconnected | ChangeKind.Disconnected" Changed="_ => StateHasChanged()" />
    @if (Offered is not null && !Signals.Online)
    {
        <p class="hint">Browsing the whole library needs a connection.@(OnThisPhone is { Count: > 0 } ? " The pictures above work offline." : "")</p>
    }
    else
    {
        <LiveData @ref="_treeLive" TValue="FolderMap" Feeds="[MediaFeeds.Library]" Load="LoadTreeAsync" FailedTitle="Can't load the library right now" Context="tree">
            @if (Searching)
            {
                <p class="media-choice__where">Results for “@_query” in every folder</p>
            }
            else
            {
                <Breadcrumbs Label="Where you are" Trail="Trail(tree.Value)" OnOpen="crumb => OpenAsync(crumb.Key)" />
                <FolderTiles Compact="true" Folders="tree.Value.ChildrenOf(_folderId, system: false).ToList()" Subfolders="folder => tree.Value.ChildrenOf(folder.Id, system: false).Count()" OnOpen="folder => OpenAsync(folder.Id)" />
            }
            <LiveData @ref="_live" TValue="MediaList" Feeds="[MediaFeeds.Library]" Load="LoadAsync" FailedTitle="Can't load the library right now">
                @if (context.Value.Items is { Count: > 0 } shown)
                {
                    <div class="media-choice__grid" role="listbox" aria-label="@(FontsOnly ? "Font files" : ImagesOnly ? "Pictures" : "Files")">
                        @foreach (MediaItemInfo item in shown)
                        {
                            @Choice(item.Media!, Searching ? $"In {tree.Value.PathName(item.FolderId)}" : MediaWords.UsedIn(item.Uses))
                        }
                    </div>
                    @if (context.Value.HasMore)
                    {
                        <div class="media-more"><Button Variant="ButtonVariant.Quiet" Icon="chevron-down" OnClick="MoreAsync">Show more</Button></div>
                    }
                }
                else
                {
                    <EmptyState Icon="image" Title="@(Searching ? "Nothing matches" : FontsOnly ? (_folderId is null ? "No font files here" : "No font files in this folder") : _folderId is null ? (ImagesOnly ? "No pictures yet" : "No files yet") : (ImagesOnly ? "No pictures in this folder" : "This folder is empty"))"
                                Body="@(Searching ? "Try another word." : FontsOnly ? "Upload the church's font file, or open the folder it's in. Only use a font the church is licensed to use in an app." : _folderId is null ? "Upload one, and it's kept in Media for any tile or page." : "Open another folder, or upload one into this folder.")" />
                }
            </LiveData>
        </LiveData>
    }
    <div class="media-choice__foot">
        <span class="media-choice__chosen">
            <span class="media-choice__chosen-name">@(_selected is null ? "Nothing chosen yet" : NameOf(_selected))</span>
            @if (_selected is { IsImage: true } picture)
            {
                <MediaShownAt Media="picture" Size="Size" />
            }
        </span>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => OnCancel.InvokeAsync()">Cancel</Button>
        <Button Icon="check" Disabled="_selected is null" OnClick="() => OnPick.InvokeAsync(_selected!)">Choose</Button>
    </div>
</div>

@code {
    private const int PageSize = 60;

    private LiveData<FolderMap>? _treeLive;
    private LiveData<MediaList>? _live;
    private FolderMap _map = FolderMap.Empty;
    private string? _folderId;
    private int _wanted = PageSize;
    private string _query = "";
    private MediaRef? _selected;
    private bool _uploading;

    [Parameter] public EventCallback<MediaRef> OnPick { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool ImagesOnly { get; set; }
    [Parameter] public bool FontsOnly { get; set; }
    [Parameter] public MediaSizeName Size { get; set; } = MediaSizeName.ForPhones;
    [Parameter] public IReadOnlyList<MediaRef>? Offered { get; set; }

    private IReadOnlyList<MediaRef>? OnThisPhone => Offered?.Where(media => !FontsOnly && (!ImagesOnly || media.IsImage) && (_query.Length == 0 || NameOf(media).Contains(_query, StringComparison.CurrentCultureIgnoreCase))).ToList();

    private RenderFragment Choice(MediaRef media, string line)
    {
        bool on = media.Id == _selected?.Id;
        return @<button type="button" role="option" aria-selected="@(on ? "true" : "false")" class="media-choice__item @(on ? "media-choice__item--on" : "")"
                        @onclick="() => _selected = media" @ondblclick="() => OnPick.InvokeAsync(media)">
            <span class="media-choice__thumb">
                @if (media.IsImage)
                {
                    <MediaImage Media="media" Size="MediaSizeName.Thumbnail" Class="media-choice__image" />
                }
                else
                {
                    <Icon Name="file" />
                }
                @if (on)
                {
                    <span class="media-choice__tick" aria-hidden="true"><Icon Name="check" Size="IconSize.Small" /></span>
                }
            </span>
            <span class="media-choice__name">@NameOf(media)</span>
            <span class="media-choice__used">@line</span>
        </button>;
    }

    private bool Searching => _query.Length > 0;

    private string FindLabel => FontsOnly ? "Find a font file in every folder" : ImagesOnly ? "Find a picture in every folder" : "Find a file in every folder";

    protected override async Task OnInitializedAsync() => _folderId = await Memory.LastFolderAsync();

    private IReadOnlyList<Crumb> Trail(FolderMap map) =>
        [new("Library", null, "image"), .. map.PathTo(_folderId).Select(folder => new Crumb(folder.Name, folder.Id, "folder"))];

    private async Task<FolderMap> LoadTreeAsync()
    {
        _map = await Media.FoldersAsync();
        if (_folderId is not null && _map.Find(_folderId) is not { IsSystem: false })
            await OpenAsync(null);
        return _map;
    }

    private async Task<MediaList> LoadAsync()
    {
        MediaList page = await Media.ListAsync(new MediaQuery
        {
            FolderId = Searching ? null : _folderId,
            Search = _query,
            Filter = FontsOnly ? MediaFilter.Fonts : ImagesOnly ? MediaFilter.Pictures : MediaFilter.All,
            Take = _wanted,
        });
        page.Items.RemoveAll(item => item.Media is null);
        return page;
    }

    private async Task OpenAsync(string? folderId)
    {
        _folderId = folderId;
        _wanted = PageSize;
        await Memory.RememberAsync(folderId);
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task SearchAsync(string query)
    {
        _query = query.Trim();
        _wanted = PageSize;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task MoreAsync()
    {
        _wanted += PageSize;
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private async Task UploadedAsync(UploadedMedia uploaded)
    {
        _uploading = false;
        _selected = uploaded.Item!.Media;
        if (_treeLive is not null)
            await _treeLive.ReloadAsync();
        if (_live is not null)
            await _live.ReloadAsync();
    }

    private static string NameOf(MediaRef media) => media.AltText.Length > 0 ? media.AltText : string.IsNullOrEmpty(media.FileName) ? media.Key : media.FileName;
}
