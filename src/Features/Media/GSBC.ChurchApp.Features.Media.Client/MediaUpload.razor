@inject MediaClient Media
@inject IJSRuntime JS

<div class="media-upload">
    <label class="media-upload__drop @(_busy ? "media-upload__drop--busy" : "")">
        <Icon Name="image" />
        <span class="media-upload__label">@Label</span>
        <span class="media-upload__hint">@(_file is null ? "Click to choose a file from this computer" : _checking ? $"{_file.Name}: checking the library…" : _file.Name)</span>
        <InputFile @ref="_picker" OnChange="ChooseAsync" accept="@string.Join(",", MediaTypes.Accepted)" disabled="@_busy" class="visually-hidden" />
    </label>
    @if (_file is not null && _match is { Media: { } existing } match)
    {
        <section @ref="_prompt" class="media-upload__match" tabindex="-1" aria-labelledby="media-upload-match-title" aria-describedby="media-upload-match-lead">
            @if (_putBack)
            {
                <h3 id="media-upload-match-title" class="media-upload__match-title">This is the original of a picture in the library</h3>
                <p id="media-upload-match-lead" class="media-upload__match-lead">“@MediaWords.NameOf(existing)” had its original removed to save space, and @_file.Name is that original. Put it back, and the picture is whole again with nothing new to look after.</p>
            }
            else
            {
                <h3 id="media-upload-match-title" class="media-upload__match-title">Already in the library</h3>
                <p id="media-upload-match-lead" class="media-upload__match-lead">@_file.Name is exactly the same file as this one. Use it, and there's one copy to look after instead of two.</p>
            }
            <div class="media-upload__existing">
                <span class="media-thumb">
                    @if (existing.IsImage)
                    {
                        <MediaImage Media="existing" Class="media-thumb__image" />
                    }
                    else
                    {
                        <Icon Name="file" />
                    }
                </span>
                <span class="media-name">
                    <strong>@MediaWords.NameOf(existing)</strong>
                    <span class="quiet">In @_folders.PathName(match.FolderId) · @MediaWords.UsedIn(match.Uses)</span>
                </span>
            </div>
            <div class="panel-actions">
                @if (_putBack)
                {
                    <Button Icon="check" Busy="_busy" OnClick="PutBackAsync">Put it back as the original of “@MediaWords.NameOf(existing)”</Button>
                    <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="AddAgain">Add it as a new picture</Button>
                }
                else
                {
                    <Button Icon="check" OnClick="UseExistingAsync">Use the existing one</Button>
                    <Button Variant="ButtonVariant.Quiet" OnClick="AddAgain">Add it again anyway</Button>
                }
            </div>
        </section>
    }
    else if (_file is not null)
    {
        <TextField Label="Description" Hint="For people using screen readers: what the picture shows." @bind-Value="_altText" />
        @if (MediaTypes.WarnsWhenLarge(_file.ContentType, _file.Size))
        {
            <Notice Tone="NoticeTone.Warning">@_file.Name is @Megabytes(_file.Size). Everyone who sees it downloads all of that, often on mobile data. Shrink it first if you can.</Notice>
        }
        <div class="panel-actions">
            <Button Icon="arrow-up" Busy="_busy" Disabled="_checking" OnClick="UploadAsync">@(_addAgain ? (_asNewPicture ? "Add as a new picture" : "Add a second copy") : MediaTypes.WarnsWhenLarge(_file.ContentType, _file.Size) ? "Upload anyway" : "Upload")</Button>
            <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="Reset">Choose another</Button>
        </div>
    }
    <Notice Tone="NoticeTone.Warning" Text="@_error" />
</div>

@code {
    private InputFile? _picker;
    private ElementReference _prompt;
    private bool _showPrompt;
    private IBrowserFile? _file;
    private MediaItemInfo? _match;
    private bool _putBack;
    private bool _asNewPicture;
    private FolderMap _folders = FolderMap.Empty;
    private string _altText = "";
    private bool _checking;
    private bool _addAgain;
    private bool _busy;
    private string? _error;

    [Parameter] public string Label { get; set; } = "Choose an image or PDF";
    [Parameter] public MediaAudience? PrivateTo { get; set; }
    [Parameter] public string? FolderId { get; set; }
    [Parameter] public EventCallback<UploadedMedia> OnUploaded { get; set; }

    private async Task ChooseAsync(InputFileChangeEventArgs args)
    {
        Reset();
        if (!MediaTypes.TryGetExtension(args.File.ContentType, out _))
        {
            _error = $"{args.File.Name} isn't an image or PDF this app can show.";
            return;
        }

        _file = args.File;
        _checking = true;
        try
        {
            MediaMatches? found = await FindExistingAsync(_file);
            _match = found?.Items.FirstOrDefault() ?? found?.RemovedOriginals.FirstOrDefault();
            _putBack = _match is not null && found!.Items.Count == 0;
            if (_match is not null)
            {
                _folders = await Media.FoldersAsync();
                _showPrompt = true;
            }
        }
        catch (Exception exception) when (exception is RpcException or JSException)
        {
            _match = null;
        }
        finally
        {
            _checking = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showPrompt || _match is null)
            return;
        _showPrompt = false;
        try
        {
            await using IJSObjectReference module = await ImportAsync();
            await module.InvokeVoidAsync("reveal", _prompt);
        }
        catch (JSException)
        {
            await _prompt.FocusAsync();
        }
    }

    private ValueTask<IJSObjectReference> ImportAsync() =>
        JS.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Features.Media.Client/media-upload.js");

    private async Task<MediaMatches?> FindExistingAsync(IBrowserFile file)
    {
        if (_picker?.Element is not { } input)
            return null;
        await using IJSObjectReference module = await ImportAsync();
        return await module.InvokeAsync<string?>("sha256", input) is { } sha256 ? await Media.FindAsync(sha256, file.ContentType, PrivateTo) : null;
    }

    private async Task UseExistingAsync()
    {
        if (_match is not { } match)
            return;
        Reset();
        await OnUploaded.InvokeAsync(new UploadedMedia { Item = match, AlreadyInLibrary = true });
    }

    private void AddAgain()
    {
        _asNewPicture = _putBack;
        _match = null;
        _putBack = false;
        _addAgain = true;
    }

    private Task PutBackAsync() => _match?.Media is { } existing ? SendAsync(existing.Id) : Task.CompletedTask;

    private Task UploadAsync() => SendAsync(null);

    private async Task SendAsync(string? putBackInto)
    {
        if (_file is null)
            return;

        _busy = true;
        _error = null;
        try
        {
            await using Stream content = _file.OpenReadStream(maxAllowedSize: long.MaxValue);
            UploadedMedia uploaded = await Media.UploadAsync(new BeginUploadRequest
            {
                FileName = _file.Name,
                ContentType = _file.ContentType,
                Bytes = _file.Size,
                AltText = _altText,
                PrivateTo = PrivateTo,
                FolderId = FolderId,
            }, content, _addAgain, putBackInto);
            Reset();
            await OnUploaded.InvokeAsync(uploaded);
        }
        catch (RpcException exception)
        {
            _error = exception.Status.Detail;
        }
        catch (HttpRequestException exception)
        {
            _error = $"The file couldn't be sent: {exception.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reset()
    {
        _file = null;
        _match = null;
        _putBack = false;
        _asNewPicture = false;
        _addAgain = false;
        _altText = "";
        _error = null;
    }

    private static string Megabytes(long bytes) => $"{bytes / 1024d / 1024d:0.#} MB";
}
