@page "/news"
@page "/news/{Id}"
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Permissions
@using GSBC.ChurchApp.Platform.Ui.News
@inject OnlineNews News
@inject NewsWrites Writes
@inject IAccess Access
@inject TimeProvider Clock
@inject NavigationManager Navigation

<TitleBand Title="Church news" Lead="News for the whole church, in the app's News tab. A post can send a notification that opens it, and a ministry's post can be put in here too.">
    <Actions>
        @if (Access.Can(EarlierAnnouncements))
        {
            <Button Variant="ButtonVariant.Quiet" Icon="clock" Href="announcements">Earlier announcements</Button>
        }
        <Button Icon="plus" Href="news/write">New post</Button>
    </Actions>
</TitleBand>

<LiveData @ref="_live" TValue="IReadOnlyList<NewsPost>" Load="News.DeskAsync" Feeds="DeskFeeds" FailedTitle="Can't load church news right now">
    <Workbench FoldAside="true" AsideLabel="Show" DetailLabel="The post" Detail="@(Chosen(context.Value) is not null ? DetailOf(context.Value) : null)"
               Showing="@(Chosen(context.Value) is not null ? WorkbenchPane.Detail : WorkbenchPane.Main)">
        <Aside>
            <FilterChips TValue="string" Label="Show" Rail="true" Options="Filters(context.Value)" Value="@Filter(context.Value)" ValueChanged="filter => _filter = filter" />
        </Aside>
        <ChildContent>
            @if (Shown(context.Value) is { Count: > 0 } shown)
            {
                <ListGroup>
                    @foreach (NewsPost post in shown)
                    {
                        <ListRow @key="post.Id" Title="@post.Title" Subtitle="@Line(post)" Current="@(post.Id == _chosen)" OnClick="() => Open(post)">
                            <TrailingContent>
                                @if (Pill(post) is { } pill)
                                {
                                    <Pill Tone="@pill.Tone">@pill.Words</Pill>
                                }
                                @if (post.Picture is { } picture)
                                {
                                    <MediaImage Media="picture" Size="MediaSizeName.Thumbnail" Alt="" Class="news-pick__thumb" />
                                }
                            </TrailingContent>
                        </ListRow>
                    }
                </ListGroup>
            }
            else
            {
                <EmptyState Icon="@AppIcons.News" Title="@EmptyTitle(context.Value)" Body="Posts show here as they're written, asked for, scheduled and published." />
            }
        </ChildContent>
    </Workbench>
</LiveData>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@(_deletingShared ? "Take it off church news?" : "Delete this post?")"
       Lead="@(_deletingShared ? "It stays in the ministry's news. Its notification is taken back from phones that haven't opened it." : "It goes from everyone's phone and its notification is taken back. This can't be undone.")">
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">@(_deletingShared ? "Take it off" : "Delete the post")</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private RenderFragment DetailOf(IReadOnlyList<NewsPost> posts) => @<text>
            @if (Chosen(posts) is { } post)
            {
                <PaneHead Title="@post.Title" Lead="@NewsWords.StateLine(post, Clock)" Actions="Actions(post)" OnClose="() => _chosen = null" />
                @if (post.State is NewsState.Asked or NewsState.Declined && Access.Can(NewsPermissions.Publish))
                {
                    <Section Grouped="true" Title="@($"{post.From} asks for this to go in church news")"
                             Lead="It shows in church news as it is in the ministry, and follows the ministry's changes.">
                        <ChildContent>
                            <ToggleRow Title="Send a notification" Description="Tells everyone with the app, opening the post" @bind-Checked="_tell" />
                        </ChildContent>
                        <Foot>
                            <div class="news-desk__answer">
                                <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => AnswerAsync(post, yes: false)">Keep it in @post.From</Button>
                                <Button Busy="_busy" OnClick="() => AnswerAsync(post, yes: true)">Put it in church news</Button>
                            </div>
                        </Foot>
                    </Section>
                }
                <div class="news-desk__preview">
                    <PostView Title="@post.Title" Content="post.Body" From="@post.From" FromHref="@post.FromLink.TrimStart('/')" Author="@post.Author"
                              When="@When(post)" LinkPath="@post.LinkPath" LinkLabel="@post.LinkLabel" />
                </div>
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            }
    </text>;

    private const string Asked = "asked", Writing = "writing", Scheduled = "scheduled", Published = "published", Kept = "kept";

    private static readonly IReadOnlyList<string> DeskFeeds = [NewsFeeds.Desk];

    private static readonly Permission EarlierAnnouncements = new(NewsPermissions.AnnouncementsWriteNode, ScopeKind.Global, "See earlier announcements");

    private LiveData<IReadOnlyList<NewsPost>>? _live;
    private string? _filter;
    private string? _chosen;
    private bool _deleting, _deletingShared, _busy, _tell = true;
    private string? _problem;

    [Parameter] public string? Id { get; set; }

    [SupplyParameterFromQuery] public string? Opens { get; set; }

    protected override void OnParametersSet()
    {
        if (Opens is { Length: > 0 } opens)
            Navigation.NavigateTo($"news/write?opens={Uri.EscapeDataString(opens)}", replace: true);
        _chosen ??= Id;
    }

    private void Open(NewsPost post)
    {
        if (IsEditable(post))
            Navigation.NavigateTo($"news/{post.Id}/change");
        else
            (_chosen, _problem, _tell) = (post.Id, null, true);
    }

    private NewsPost? Chosen(IReadOnlyList<NewsPost> posts) => posts.FirstOrDefault(post => post.Id == _chosen);

    private static string Group(NewsPost post) => post.State switch
    {
        NewsState.Asked => Asked,
        NewsState.Draft or NewsState.WaitingToPublish => Writing,
        NewsState.Scheduled => Scheduled,
        NewsState.Declined => Kept,
        _ => Published,
    };

    private string Filter(IReadOnlyList<NewsPost> posts) =>
        _filter ?? (posts.Any(post => Group(post) == Asked) ? Asked : posts.Any(post => Group(post) == Writing) ? Writing : Published);

    private IReadOnlyList<FilterOption<string>> Filters(IReadOnlyList<NewsPost> posts) =>
    [
        new(Asked, "Ministries asking", posts.Count(post => Group(post) == Asked)),
        new(Writing, "Being written", posts.Count(post => Group(post) == Writing)),
        new(Scheduled, "Scheduled", posts.Count(post => Group(post) == Scheduled)),
        new(Published, "Published", posts.Count(post => Group(post) == Published)),
        new(Kept, "Kept in ministries", posts.Count(post => Group(post) == Kept)),
    ];

    private List<NewsPost> Shown(IReadOnlyList<NewsPost> posts)
    {
        string filter = Filter(posts);
        return posts.Where(post => Group(post) == filter).OrderByDescending(post => post.PublishAt ?? post.PublishedAt ?? post.CreatedAt).ToList();
    }

    private string EmptyTitle(IReadOnlyList<NewsPost> posts) => Filter(posts) switch
    {
        Asked => "No ministry is asking",
        Writing => "Nothing being written",
        Scheduled => "Nothing scheduled",
        Kept => "No posts kept in ministries",
        _ => "Nothing published yet",
    };

    private bool IsEditable(NewsPost post) =>
        !post.Shared && (Access.Can(NewsPermissions.Publish) || post.State is NewsState.Draft or NewsState.WaitingToPublish);

    private string When(NewsPost post) => NewsWords.When(post, Clock);

    private string Line(NewsPost post) => post.State switch
    {
        NewsState.Asked or NewsState.Declined => $"{post.From} · asked by {(post.AskedBy.Length > 0 ? post.AskedBy : "a leader")}",
        NewsState.Scheduled when post.PublishAt is { } at => $"Publishes {ChurchDates.Describe(at, DateLineStyle.Relative, withTime: true, Clock.GetUtcNow().UtcDateTime)}",
        NewsState.Published => string.Join(" · ", new[] { post.From.Length > 0 ? $"From {post.From}" : post.Author, When(post) }.Where(part => part.Length > 0)),
        _ => post.Author.Length > 0 ? $"By {post.Author}" : "Being written",
    };

    private static (string Words, PillTone Tone)? Pill(NewsPost post) => post.State switch
    {
        NewsState.WaitingToPublish => ("Waiting to be published", PillTone.Marker),
        NewsState.Asked => ("Asking", PillTone.Marker),
        NewsState.Published when post.Urgent => ("Urgent", PillTone.Marker),
        NewsState.Published when post.Shared => ("From a ministry", PillTone.Accent),
        _ => null,
    };

    private IReadOnlyList<MenuItem> Actions(NewsPost post)
    {
        bool publishes = Access.Can(NewsPermissions.Publish);
        List<MenuItem> items = [];
        if (IsEditable(post))
            items.Add(this.Item("Change the post", () => Navigation.NavigateTo($"news/{post.Id}/change"), "pencil"));
        if (post.State is NewsState.Scheduled && publishes || post.State == NewsState.WaitingToPublish)
            items.Add(this.Item("Back to writing", () => RunAsync(() => Writes.BackToWritingAsync(post.Id)), "pencil",
                post.State == NewsState.Scheduled ? "It won't publish until it's posted again" : "Nobody is asked to publish it any more"));
        if (post is { Shared: true, State: NewsState.Published } && publishes)
            items.Add(this.Item("Take it off church news…", () => (_deleting, _deletingShared) = (true, true), "trash-2", danger: true, startsGroup: true));
        else if (!post.Shared && (publishes || post.State is NewsState.Draft or NewsState.WaitingToPublish))
            items.Add(this.Item("Delete the post…", () => (_deleting, _deletingShared) = (true, false), "trash-2", danger: true, startsGroup: true));
        return items;
    }

    private Task AnswerAsync(NewsPost post, bool yes) => RunAsync(() => Writes.AnswerAskAsync(post.Id, yes, yes && _tell));

    private async Task DeleteAsync()
    {
        if (_chosen is not { } id)
            return;
        await RunAsync(() => Writes.DeleteAsync(id));
        if (_problem is null)
            (_deleting, _chosen) = (false, null);
    }

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
