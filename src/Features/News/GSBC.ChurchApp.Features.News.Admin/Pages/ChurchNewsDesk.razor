@page "/news"
@page "/news/{Id}"
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Permissions
@using GSBC.ChurchApp.Platform.Client.News
@using GSBC.ChurchApp.Platform.Ui.News
@inject OnlineNews News
@inject IEnumerable<IEveryMinistrysNews> EveryMinistry
@inject NewsWrites Writes
@inject IAccess Access
@inject TimeProvider Clock
@inject NavigationManager Navigation

<TitleBand Title="Church news" Lead="News for the whole church, shown in the app's News tab. A post can send a notification, and a ministry's post can be put in church news too.">
    <Actions>
        @if (Access.Can(EarlierAnnouncements))
        {
            <Button Variant="ButtonVariant.Quiet" Icon="clock" Href="announcements">Earlier announcements</Button>
        }
        <Button Icon="plus" Href="news/write">New post</Button>
    </Actions>
</TitleBand>

<LiveData @ref="_live" TValue="DeskView" Load="LoadAsync" Feeds="Feeds" FailedTitle="Can't load church news right now">
    <Workbench FoldAside="true" AsideLabel="Show" DetailLabel="The post" Detail="@DetailOf(context.Value)"
               Showing="@(IsOpen(context.Value) ? WorkbenchPane.Detail : WorkbenchPane.Main)">
        <Aside>
            <FilterChips TValue="string" Label="Show" Rail="true" Options="Filters(context.Value.Posts)" Value="@Filter(context.Value.Posts)" ValueChanged="filter => _filter = filter" />
            @if (SeesMinistries)
            {
                <FilterChips TValue="string" Label="Every ministry" Rail="true" Options="EveryFilter(context.Value)" Value="@Filter(context.Value.Posts)" ValueChanged="filter => _filter = filter" />
            }
        </Aside>
        <ChildContent>
            @if (Filter(context.Value.Posts) == Every)
            {
                @MinistriesList(context.Value.Every)
            }
            else if (Shown(context.Value.Posts) is { Count: > 0 } shown)
            {
                <ListGroup>
                    @foreach (NewsPost post in shown)
                    {
                        <ListRow @key="post.Id" Title="@post.Title" Subtitle="@Line(post)" Current="@(post.Id == _chosen)" OnClick="() => Open(post)">
                            <TrailingContent>
                                @if (Pill(post) is { } pill)
                                {
                                    <Pill Tone="@pill.Tone">@pill.Words</Pill>
                                }
                                @if (post.Picture is { } picture)
                                {
                                    <MediaImage Media="picture" Size="MediaSizeName.Thumbnail" Alt="" Class="news-pick__thumb" />
                                }
                            </TrailingContent>
                        </ListRow>
                    }
                </ListGroup>
            }
            else
            {
                <EmptyState Icon="@AppIcons.News" Title="@EmptyTitle(context.Value.Posts)" Body="@EmptyBody(context.Value.Posts)" />
            }
        </ChildContent>
    </Workbench>
</LiveData>

<Sheet Open="_deleting" OpenChanged="open => _deleting = open" Title="@(_deletingShared ? "Take the post off church news?" : "Delete this post for good?")"
       Lead="@(_deletingShared ? $"The post stays in {_deletingFrom}'s news. Its notification is taken back from phones that haven't opened it." : "The post is deleted from Archived, and nobody can put it back. This can't be undone.")">
    <Actions>
        <Button Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">@(_deletingShared ? "Take the post off church news" : "Delete the post for good")</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _deleting = false">Keep the post</Button>
    </Actions>
</Sheet>

<Sheet Open="_sharing" OpenChanged="open => _sharing = open" Title="Put the post in church news?"
       Lead="Everyone sees the post in the app's News, as it is in the ministry, and changes made in the ministry show there too.">
    <ChildContent>
        <ToggleRow Title="Send a notification" Description="Sends everyone with the app a notification that opens the post." @bind-Checked="_tell" />
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        <Button Icon="@AppIcons.News" Busy="_busy" OnClick="ShareChosenAsync">Put the post in church news</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _sharing = false">Cancel</Button>
    </Actions>
</Sheet>

<Sheet Open="_archiving" OpenChanged="open => _archiving = open" Title="Archive this post?"
       Lead="The post comes out of everyone's News, and its notification is taken back from phones that haven't opened it. You can put the post back from Archived.">
    <Actions>
        <Button Busy="_busy" OnClick="ArchiveChosenAsync">Archive the post</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _archiving = false">Keep the post</Button>
    </Actions>
</Sheet>

@code {
    private sealed record DeskView(IReadOnlyList<NewsPost> Posts, IReadOnlyList<MinistryNewsItem> Every);

    private RenderFragment MinistriesList(IReadOnlyList<MinistryNewsItem> every) => @<text>
        @if (every.Count > 0)
        {
            <p class="news-desk__scope">Every ministry's posts for everyone, newest first. Posts for a team, leaders or parents, and hidden ministries' posts, stay in their ministry.</p>
            <ListGroup>
                @foreach (MinistryNewsItem post in every)
                {
                    <ListRow @key="post.Item.Id" Title="@post.Item.Title" Current="@(post.Item.Id == _chosenMinistryPost)" OnClick="() => OpenMinistryPost(post)">
                        <Below>
                            <span class="news-desk__from">@post.Item.From</span>
                            <span class="row__subtitle">@MinistryLine(post)</span>
                        </Below>
                        <TrailingContent>
                            @if (MinistryPill(post) is { } pill)
                            {
                                <Pill Tone="@pill.Tone">@pill.Words</Pill>
                            }
                            @if (post.Item.Picture is { } picture)
                            {
                                <MediaImage Media="picture" Size="MediaSizeName.Thumbnail" Alt="" Class="news-pick__thumb" />
                            }
                        </TrailingContent>
                    </ListRow>
                }
            </ListGroup>
        }
        else
        {
            <EmptyState Icon="@AppIcons.News" Title="No ministry news yet" Body="Ministries' posts for everyone show here as they're posted." />
        }
    </text>;

    private RenderFragment? DetailOf(DeskView view) =>
        Filter(view.Posts) == Every ? MinistryDetailOf(view.Every) : Chosen(view.Posts) is not null ? DetailOf(view.Posts) : null;

    private RenderFragment? MinistryDetailOf(IReadOnlyList<MinistryNewsItem> every) => ChosenMinistryPost(every) is { } post ? @<text>
        <PaneHead Title="@post.Item.Title" Lead="@($"{post.Item.From} · for everyone · posted {NewsWords.InASentence(NewsWords.Posted(post.Item, Clock))}")" Actions="MinistryActions(post)"
                  OnClose="() => _chosenMinistryPost = null" />
        <div class="news-desk__preview">
            <PostView Title="@post.Item.Title" Content="post.Item.Body" From="@post.Item.From" FromHref="@post.Item.Href" Author="@post.Item.Author"
                      Posted="post.Item.PostedAt" Edited="post.Item.EditedAt is not null" For="Everyone" />
        </div>
        <Notice Tone="NoticeTone.Warning" Text="@(_sharing ? null : _problem)" />
    </text> : null;

    private RenderFragment DetailOf(IReadOnlyList<NewsPost> posts) => @<text>
            @if (Chosen(posts) is { } post)
            {
                <PaneHead Title="@post.Title" Lead="@NewsWords.StateLine(post, Clock)" Actions="Actions(post)" OnClose="() => _chosen = null" />
                @if (post.State is NewsState.Asked or NewsState.Declined && Access.Can(NewsPermissions.Publish))
                {
                    <Section Grouped="true" Title="@($"{post.From} asks for this to go in church news")"
                             Lead="The post shows in church news as it is in the ministry, and changes made in the ministry show there too.">
                        <ChildContent>
                            <ToggleRow Title="Send a notification" Description="Sends everyone with the app a notification that opens the post." @bind-Checked="_tell" />
                        </ChildContent>
                        <Foot>
                            <div class="news-desk__answer">
                                <Button Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => AnswerAsync(post, yes: false)">Keep the post in @post.From</Button>
                                <Button Busy="_busy" OnClick="() => AnswerAsync(post, yes: true)">Put the post in church news</Button>
                            </div>
                        </Foot>
                    </Section>
                }
                <div class="news-desk__preview">
                    <PostView Title="@post.Title" Content="post.Body" From="@post.From" FromHref="@post.FromLink.TrimStart('/')" Author="@post.Author"
                              Posted="NewsWords.PostedAt(post)" Edited="post.EditedAt is not null" For="@NewsWords.AudienceWords(post.Audience)" LinkPath="@post.LinkPath" LinkLabel="@post.LinkLabel" NotPosted="@NewsWords.NotPosted(post, Clock)" />
                </div>
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            }
    </text>;

    private const string Asked = "asked", Writing = "writing", Scheduled = "scheduled", Published = "published", Kept = "kept", Archived = "archived", Every = NewsWords.EveryTab;

    private IEveryMinistrysNews? Ministries => EveryMinistry.FirstOrDefault();

    private bool SeesMinistries => Ministries is not null && Access.Can(NewsPermissions.SeeMinistries);

    private IReadOnlyList<string> Feeds => [NewsFeeds.Desk, .. SeesMinistries ? Ministries!.Feeds : []];

    private static readonly Permission EarlierAnnouncements = new(NewsPermissions.AnnouncementsWriteNode, ScopeKind.Global, "See earlier announcements");

    private LiveData<DeskView>? _live;
    private DeskView? _view;
    private string? _filter;
    private string? _chosen, _chosenMinistryPost;
    private string _deletingFrom = "";
    private bool _deleting, _deletingShared, _archiving, _sharing, _busy, _tell = true;
    private string? _problem;

    [Parameter] public string? Id { get; set; }

    [SupplyParameterFromQuery] public string? Opens { get; set; }

    protected override void OnParametersSet()
    {
        if (Opens is { Length: > 0 } opens)
            Navigation.NavigateTo($"news/write?opens={Uri.EscapeDataString(opens)}", replace: true);
        _chosen ??= Id;
    }

    private void Open(NewsPost post)
    {
        if (IsEditable(post))
            Navigation.NavigateTo($"news/{post.Id}/change");
        else
            (_chosen, _problem, _tell) = (post.Id, null, true);
    }

    private NewsPost? Chosen(IReadOnlyList<NewsPost> posts) => posts.FirstOrDefault(post => post.Id == _chosen);

    private async Task<DeskView> LoadAsync() =>
        _view = new DeskView(await News.DeskAsync(), SeesMinistries ? await Ministries!.LoadAsync() : []);

    private bool IsOpen(DeskView view) => Filter(view.Posts) == Every ? ChosenMinistryPost(view.Every) is not null : Chosen(view.Posts) is not null;

    private MinistryNewsItem? ChosenMinistryPost(IReadOnlyList<MinistryNewsItem> every) => every.FirstOrDefault(post => post.Item.Id == _chosenMinistryPost);

    private void OpenMinistryPost(MinistryNewsItem post) => (_chosenMinistryPost, _problem, _tell) = (post.Item.Id, null, true);

    private IReadOnlyList<FilterOption<string>> EveryFilter(DeskView view) => [new(Every, "All ministries", view.Every.Count)];

    private string MinistryLine(MinistryNewsItem post) =>
        string.Join(" · ", new[] { post.Item.Author.Length > 0 ? $"By {post.Item.Author}" : "", NewsWords.Posted(post.Item, Clock) }.Where(part => part.Length > 0));

    private static (string Words, PillTone Tone)? MinistryPill(MinistryNewsItem post) => post.Standing switch
    {
        ChurchNewsStanding.InChurchNews => ("In church news", PillTone.Accent),
        ChurchNewsStanding.Asked => ("Asking", PillTone.Marker),
        _ => null,
    };

    private IReadOnlyList<MenuItem> MinistryActions(MinistryNewsItem post)
    {
        List<MenuItem> items = [];
        if (Access.Can(NewsPermissions.Publish) && post.Standing != ChurchNewsStanding.InChurchNews)
            items.Add(this.Item("Put the post in church news…", () => (_sharing, _problem, _tell) = (true, null, true), AppIcons.News,
                "Everyone sees the post in News. You choose whether to send a notification."));
        items.Add(this.Item($"Open the post in {post.Item.From}", () => Navigation.NavigateTo(post.Item.Href), AppIcons.Ministries));
        return items;
    }

    private async Task ShareChosenAsync()
    {
        if (Ministries is null || _view is null || ChosenMinistryPost(_view.Every) is not { } post)
            return;
        await RunAsync(() => Ministries.PutInChurchNewsAsync(post, _tell));
        if (_problem is null)
            _sharing = false;
    }

    private static string Group(NewsPost post) => post.State switch
    {
        NewsState.Asked => Asked,
        NewsState.Draft or NewsState.WaitingToPublish => Writing,
        NewsState.Scheduled => Scheduled,
        NewsState.Declined => Kept,
        NewsState.Archived => Archived,
        _ => Published,
    };

    private string Filter(IReadOnlyList<NewsPost> posts) =>
        _filter ?? (posts.Any(post => Group(post) == Asked) ? Asked : posts.Any(post => Group(post) == Writing) ? Writing : Published);

    private IReadOnlyList<FilterOption<string>> Filters(IReadOnlyList<NewsPost> posts) =>
    [
        new(Asked, "Ministries asking", posts.Count(post => Group(post) == Asked)),
        new(Writing, "Being written", posts.Count(post => Group(post) == Writing)),
        new(Scheduled, "Scheduled", posts.Count(post => Group(post) == Scheduled)),
        new(Published, "Published", posts.Count(post => Group(post) == Published)),
        new(Kept, "Kept in ministries", posts.Count(post => Group(post) == Kept)),
        new(Archived, "Archived", posts.Count(post => Group(post) == Archived)),
    ];

    private List<NewsPost> Shown(IReadOnlyList<NewsPost> posts)
    {
        string filter = Filter(posts);
        return posts.Where(post => Group(post) == filter).OrderByDescending(post => post.PublishAt ?? post.PublishedAt ?? post.CreatedAt).ToList();
    }

    private string EmptyTitle(IReadOnlyList<NewsPost> posts) => Filter(posts) switch
    {
        Asked => "No ministry is asking",
        Writing => "Nothing being written",
        Scheduled => "Nothing scheduled",
        Kept => "No posts kept in ministries",
        Archived => "Nothing archived",
        _ => "Nothing published yet",
    };

    private string EmptyBody(IReadOnlyList<NewsPost> posts) => Filter(posts) == Archived
        ? "Posts you archive show here, out of everyone's News. Put one back to use it again, or delete it for good."
        : "Posts show here as they're written, asked for, scheduled and published.";

    private bool IsEditable(NewsPost post) =>
        !post.Shared && post.State != NewsState.Archived && (Access.Can(NewsPermissions.Publish) || post.State is NewsState.Draft or NewsState.WaitingToPublish);

    private string When(NewsPost post) => NewsWords.When(post, Clock);

    private string Line(NewsPost post) => post.State switch
    {
        NewsState.Asked or NewsState.Declined => $"{post.From} · asked by {(post.AskedBy.Length > 0 ? post.AskedBy : "a leader")}",
        NewsState.Scheduled when post.PublishAt is { } at => $"Publishes {ChurchDates.Describe(at, DateLineStyle.Relative, withTime: true, Clock.GetUtcNow().UtcDateTime)}",
        NewsState.Published => string.Join(" · ", new[] { post.From.Length > 0 ? $"From {post.From}" : post.Author, When(post) }.Where(part => part.Length > 0)),
        NewsState.Archived => NewsWords.ArchivedLine(post, Clock),
        _ => post.Author.Length > 0 ? $"By {post.Author}" : "Being written",
    };

    private static (string Words, PillTone Tone)? Pill(NewsPost post) => post.State switch
    {
        NewsState.WaitingToPublish => ("Waiting to be published", PillTone.Marker),
        NewsState.Asked => ("Asking", PillTone.Marker),
        NewsState.Published when post.Urgent => ("Urgent", PillTone.Marker),
        NewsState.Published when post.Shared => ("From a ministry", PillTone.Accent),
        _ => null,
    };

    private IReadOnlyList<MenuItem> Actions(NewsPost post)
    {
        bool publishes = Access.Can(NewsPermissions.Publish);
        List<MenuItem> items = [];
        if (IsEditable(post))
            items.Add(this.Item("Change the post", () => Navigation.NavigateTo($"news/{post.Id}/change"), "pencil"));
        if (post.State is NewsState.Scheduled && publishes || post.State == NewsState.WaitingToPublish)
            items.Add(this.Item("Back to writing", () => RunAsync(() => Writes.BackToWritingAsync(post.Id)), "pencil",
                post.State == NewsState.Scheduled ? "The post won't publish until it's posted again." : "Nobody is asked to publish the post any more."));
        bool mayPutAway = !post.Shared && (publishes || post.State is NewsState.Draft or NewsState.WaitingToPublish || post is { State: NewsState.Archived, PublishedAt: null });
        if (post is { Shared: true, State: NewsState.Published } && publishes)
            items.Add(this.Item("Take the post off church news…", () => (_deleting, _deletingShared, _deletingFrom) = (true, true, post.From), "trash-2", danger: true, startsGroup: true));
        else if (mayPutAway && post.State == NewsState.Archived)
        {
            items.Add(this.Item("Put the post back", () => RunAsync(() => Writes.PutBackAsync(post.Id)), "rotate-ccw", "The post comes back as a draft, to change or publish again."));
            items.Add(this.Item("Delete the post for good…", () => (_deleting, _deletingShared) = (true, false), "trash-2", danger: true, startsGroup: true));
        }
        else if (mayPutAway)
            items.Add(post.State == NewsState.Published
                ? this.Item("Archive…", () => (_archiving, _problem) = (true, null), "archive", "Takes the post out of everyone's News. You can put it back.", startsGroup: true)
                : this.Item("Archive", () => RunAsync(() => Writes.ArchiveAsync(post.Id)), "archive", "Keeps the post under Archived. You can put it back.", startsGroup: true));
        return items;
    }

    private Task AnswerAsync(NewsPost post, bool yes) => RunAsync(() => Writes.AnswerAskAsync(post.Id, yes, yes && _tell));

    private async Task ArchiveChosenAsync()
    {
        if (_chosen is not { } id)
            return;
        await RunAsync(() => Writes.ArchiveAsync(id));
        if (_problem is null)
            _archiving = false;
    }

    private async Task DeleteAsync()
    {
        if (_chosen is not { } id)
            return;
        await RunAsync(() => Writes.DeleteAsync(id));
        if (_problem is null)
            (_deleting, _chosen) = (false, null);
    }

    private async Task RunAsync(Func<Task> work)
    {
        (_busy, _problem) = (true, null);
        try
        {
            await work();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
