@using GSBC.ChurchApp.Platform.Contracts.Configuration
@using GSBC.ChurchApp.Platform.Ui.Surfaces
@inject IServiceProvider Services
@inject TimeProvider Clock

@if (Services.GetService(typeof(OutreachStore)) is OutreachStore store)
{
    <LiveData TValue="OutreachNow" Load="store.LoadAsync" Feeds="OutreachStore.Feeds" Remember="outreach.tile">
        <ChildContent>@Drawn(context.Value)</ChildContent>
        <Loading>@Drawn(null)</Loading>
        <Failed>@Drawn(null)</Failed>
    </LiveData>
}
else
{
    @Drawn(null)
}

@code {
    [CascadingParameter] public HubContext Hub { get; set; } = HubContext.Still;
    [Parameter, EditorRequired] public required ArrangedSurface Entry { get; set; }

    private TileLook Look => TileLook.Of(OutreachTiles.Outreach, Entry.Values);

    private TileVariant Variant => OutreachTiles.Outreach.VariantFor(Look, Hub.Columns);

    private TileSpan Span => new(Math.Min(Look.Columns, Hub.Columns), Look.Rows);

    private RenderFragment Drawn(OutreachNow? now)
    {
        OutreachDay? day = now is null ? null : OutreachDays.On(now, Clock.GetUtcNow().UtcDateTime);
        if (Variant.Key == OutreachTiles.JustALink)
            return @<HubTile Look="@(Look with { Image = null })" Layout="@(Span.Columns > 1 && Span.Rows == 1 ? TileShape.Row : TileShape.Square)" Title="@Look.Title" PlacementId="@Entry.Placement?.Id" />;
        string title = day is null ? Look.Title : OutreachPhoneWords.DayOn(day);
        IReadOnlyList<string> lines = Span is { Columns: 1, Rows: 1 } ? []
            : day is not null && now is not null ? [OutreachPhoneWords.RoutesClaimed(OutreachDays.Claimed(now, day), now.RoutesOf(day.Id).Count())]
            : [Look.Text];
        string? go = Span.Rows > 1 ? day is null ? "Plan a walk" : "Pick a route" : null;
        return @<HubTile Look="@(WordsTileView.ShapeOf(Variant) is null ? Look with { Image = null } : Look)" Layout="@WordsTileView.ShapeOf(Variant)" Title="@title" Lines="lines" Go="@go" PlacementId="@Entry.Placement?.Id" />;
    }
}
