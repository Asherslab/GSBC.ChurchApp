@page "/outreach/days/{DayId}"
@inject OutreachDayRoutes Days
@inject IAccess Access

<Page Title="Outreach day" BackHref="@OutreachLinks.Home" BackLabel="Outreach">
    <LiveData @key="DayId" TValue="DayView" Load="() => Days.DayAsync(DayId)" Feeds="OutreachDayRoutes.Feeds" ReloadOn="Reload">
        @{
            DayView view = context.Value;
        }
        @if (view.Day is not { } day)
        {
            <Masthead Title="Outreach day" />
            <Section First="true">
                <EmptyState Icon="calendar" Title="This outreach day isn't on this phone" Body="It may have finished, or it's more than four weeks away." />
            </Section>
        }
        else
        {
            <Masthead Title="@(view.Campaign?.Name ?? "Outreach day")" Note="@OutreachPhoneWords.DayWhen(day)" />
            <Section First="true">
                <FactList>
                    @if (day.MeetingPlace.Length > 0)
                    {
                        <Fact Label="Meet at" Text="@day.MeetingPlace" Icon="map-pin" />
                    }
                    <Fact Label="What it is" Text="@(day.Mode == WalkMode.Doorknock ? "Doorknocking, in pairs" : "Letterboxing, alone or together")" Icon="@(day.Mode == WalkMode.Doorknock ? "door-open" : "mail")" />
                    @if (view.Campaign?.HandedOut is { Length: > 0 } handedOut)
                    {
                        <Fact Label="Handing out" Text="@handedOut" Icon="mail" />
                    }
                </FactList>
                @if (day.Note.Length > 0)
                {
                    <p class="outreach-note">@day.Note</p>
                }
                @if (Access.CanSomewhere(OutreachPermissions.Reports))
                {
                    <Button Block="true" Variant="ButtonVariant.Quiet" Icon="chart-line" Href="@OutreachLinks.DayBoard(day.Id)">How the day is going</Button>
                }
            </Section>
            <Section Title="Routes" Lead="@(view.Over ? "This day has finished." : "Pick one. Several people can take the same route, together or apart.")">
                @if (view.Routes.Count == 0)
                {
                    <EmptyState Icon="map" Title="The routes aren't out yet" Body="They show here once the outreach team publishes them." />
                }
                else
                {
                    <ListGroup>
                        @foreach (RouteLine line in view.Routes)
                        {
                            <ListRow @key="line.Route.Id" Title="@RouteTitle(line.Route)" Subtitle="@RouteLine(day, line)" Chevron="true"
                                     Href="@OutreachLinks.Route(line.Route.Code)">
                                <TrailingContent>
                                    @if (line.Mine)
                                    {
                                        <Pill Tone="PillTone.Accent">Yours</Pill>
                                    }
                                    else if (line.Claims.Count == 0)
                                    {
                                        <Pill Tone="PillTone.Accent">Open</Pill>
                                    }
                                    else
                                    {
                                        <Pill Tone="PillTone.Quiet">Taken</Pill>
                                    }
                                </TrailingContent>
                            </ListRow>
                        }
                    </ListGroup>
                }
            </Section>
        }
    </LiveData>
</Page>

@code {
    private const ChangeKind Reload = ChangeKind.Reconnected | ChangeKind.Session | ChangeKind.Access | ChangeKind.Outbox;

    [Parameter] public string DayId { get; set; } = "";

    public static string RouteTitle(DayRoute route) => route.Name.Length > 0 ? $"Route {route.Number} · {route.Name}" : $"Route {route.Number}";

    private static string RouteLine(OutreachDay day, RouteLine line)
    {
        List<string> parts =
        [
            day.Mode == WalkMode.Doorknock ? OutreachPhoneWords.Doors(line.Route.Letterboxes) : OutreachPhoneWords.Letterboxes(line.Route.Letterboxes),
            OutreachPhoneWords.Duration(TimeSpan.FromMinutes(line.Route.Minutes)),
        ];
        if (line.Claims.Count > 0)
            parts.Add(Names(line.Claims));
        return string.Join(" · ", parts);
    }

    private static string Names(IReadOnlyList<Claim> claims) => claims.Count switch
    {
        1 or 2 => string.Join(", ", claims.Select(claim => claim.FirstName)),
        _ => $"{claims[0].FirstName}, {claims[1].FirstName} + {claims.Count - 2}",
    };
}
