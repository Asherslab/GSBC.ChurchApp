@inject OutreachDeskClient Outreach

<TitleBand Title="Outreach" Lead="@(Tab == OutreachTab.Map ? null : Lead)">
    <Actions><SectionOutlet SectionName="@ActionsSection" /></Actions>
</TitleBand>
<LiveData TValue="OutreachDesk" Feeds="Feeds" Load="() => Outreach.DeskAsync(Scope)" Remember="@($"outreach.head.{Scope}")">
    <ChildContent>@Tabs(context.Value)</ChildContent>
    <Loading>@Tabs(null)</Loading>
    <Failed>@Tabs(null)</Failed>
</LiveData>

@code {
    public const string ActionsSection = "outreach-actions";

    private const string Lead = "Campaigns, outreach days and their routes, the map of where outreach has been, what it adds up to, and what walkers send in.";

    private static readonly IReadOnlyList<string> Feeds = [OutreachFeeds.Desk];

    [Parameter, EditorRequired] public required string Scope { get; set; }
    [Parameter, EditorRequired] public required OutreachTab Tab { get; set; }

    private RenderFragment Tabs(OutreachDesk? desk) =>
        @<TabStrip TValue="OutreachTab" Label="Outreach" Options="Options(desk)" Value="Tab" Href="OutreachTabs.Href" />;

    private static IReadOnlyList<TabOption<OutreachTab>> Options(OutreachDesk? desk) =>
    [
        new(OutreachTab.Campaigns, "Campaigns"), new(OutreachTab.Map, "Map", desk?.NewReports ?? 0), new(OutreachTab.Days, "Days"), new(OutreachTab.Numbers, "Numbers"),
        new(OutreachTab.FollowUps, "Follow-ups", desk?.OpenFollowUps ?? 0), new(OutreachTab.Settings, "Settings"),
    ];
}
