@using GSBC.ChurchApp.Features.Outreach.Maps.Contracts
@using Area = GSBC.ChurchApp.Features.Outreach.Maps.Contracts.MapArea
@inject OutreachMapsClient Maps

<LiveData @ref="_live" TValue="MapAreaList" Feeds="Feeds" Load="Maps.AreasAsync" FailedTitle="Can't load the map areas right now">
    <Section Grouped="true" Title="Map areas" Lead="Where the app has maps and streets. Each area is cut into regions of about 10 km; phones download the region they walk in.">
        <ChildContent>
            @if (context.Value.Areas.Count == 0)
            {
                <p class="field__hint">No map areas yet. Add the area around church first; a campaign far away gets its own.</p>
            }
            else
            {
                <ListGroup>
                    @foreach (Area area in context.Value.Areas)
                    {
                        <ListRow Title="@area.Name" Subtitle="@MapAreaWords.State(area)" Icon="map" Href="@OutreachLinks.MapArea(area.Id)" Actions="@ActionsFor(area)">
                            <Below>
                                @if (area.State == MapAreaStates.Building && area.Steps > 0)
                                {
                                    <ProgressTrack Fraction="MapAreaWords.Progress(area)" Label="How far the build has got" Class="outreach-areas__progress" />
                                }
                                @if (area.Regions.Count > 0)
                                {
                                    <p class="outreach-areas__regions">@MapAreaWords.Regions(area)</p>
                                }
                            </Below>
                        </ListRow>
                    }
                </ListGroup>
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            <div>
                <Button Variant="ButtonVariant.Quiet" Icon="plus" Href="@OutreachLinks.NewMapArea">Add a map area</Button>
            </div>
        </ChildContent>
        <Foot><p class="field__hint">Open an area to switch its regions off or on, or to add regions on its edge. Building takes a few minutes; phones get the new maps by themselves.</p></Foot>
    </Section>
    <MapAreaSheets @ref="_sheets" OnChanged="ReloadAsync" OnDeleted="ReloadAsync" />
</LiveData>

@code {
    private static readonly IReadOnlyList<string> Feeds = [OutreachMapsFeeds.Builds, OutreachMapsFeeds.Regions];

    private LiveData<MapAreaList>? _live;
    private MapAreaSheets? _sheets;
    private bool _busy;
    private string? _problem;

    private IReadOnlyList<MenuItem> ActionsFor(Area area) => MapAreaSheets.Actions(this, area, _sheets, _busy, () => RebuildAsync(area));

    private async Task RebuildAsync(Area area)
    {
        _busy = true;
        _problem = null;
        try
        {
            await Maps.RebuildAsync(area.Id);
            await ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        if (_live is not null)
            await _live.ReloadAsync();
    }
}
