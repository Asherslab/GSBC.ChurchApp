@inject OutreachDeskClient Outreach
@inject UnsavedChanges Unsaved

<UnsavedGuard Changed="() => Changed" What="this campaign" Save="SaveBeforeLeavingAsync" />

<LiveData @ref="_live" TValue="OutreachDesk" Feeds="Feeds" Load="() => Outreach.DeskAsync(Scope)" FailedTitle="Can't load the campaigns right now">
    <OutreachHead Tab="OutreachTab.Campaigns" FollowUps="context.Value.OpenFollowUps" Reports="context.Value.NewReports">
        <Actions>
            <Can Permission="OutreachPermissions.Plan" ObjectId="@Scope">
                <Button Icon="plus" OnClick="() => OpenAsync(() => Edit(new Campaign()))">New campaign</Button>
            </Can>
        </Actions>
    </OutreachHead>
    <Workbench DetailLabel="The campaign" Showing="@(_editing is null ? WorkbenchPane.Main : WorkbenchPane.Detail)">
        <ChildContent>
            <DataTable TItem="Campaign" Label="Campaigns" Items="context.Value.Campaigns" Columns="Columns(context.Value)" Key="campaign => campaign.Id"
                       Selected="Chosen(context.Value)" SelectedChanged="campaign => OpenAsync(() => Edit(campaign))" />
        </ChildContent>
        <Detail>
            <div class="outreach-desk__edit">
                @if (_editing is { } editing)
                {
                    <PaneHead Title="@(IsNew ? "A new campaign" : editing.Name)" Lead="@Lead(editing)"
                              Actions="@(IsNew || editing.General ? null : [this.Item("Delete this campaign…", AskToDeleteAsync, "trash-2", "Says first what goes with it", danger: true, disabled: _busy)])"
                              OnClose="() => OpenAsync(Close)" />
                    @if (!IsNew)
                    {
                        <div class="outreach-desk__totals">
                            <StatTile Value="@OutreachWords.Count(TotalsOf(context.Value, editing).Letterboxes)" Label="letterboxes" Quiet="true" />
                            <StatTile Value="@OutreachWords.Kilometres(TotalsOf(context.Value, editing).Metres)" Label="walked" Quiet="true" />
                            <StatTile Value="@OutreachWords.Count(TotalsOf(context.Value, editing).Days)" Label="outreach days" Quiet="true" />
                        </div>
                    }
                    <TextField Label="Name" @bind-Value="_name" MaxLength="80" Hint="@(editing.General ? "General outreach is always there; its name can change." : null)" />
                    <TextField Label="What's handed out" @bind-Value="_handedOut" MaxLength="80" Hint="For example tracts, or invitations to carols." />
                    @if (!editing.General)
                    {
                        <div class="ui-pair ui-pair--wide">
                            <DateField Label="Starts" @bind-Value="_starts" Shortcuts="false" />
                            <DateField Label="Ends" @bind-Value="_ends" Shortcuts="false" Min="@_starts" />
                        </div>
                        <p class="field__hint">With no dates it runs until you delete it. Walkers carry it only between its dates.</p>
                    }
                    <ToggleRow Title="Show a leaderboard" @bind-Checked="_leaderboard"
                               Description="Walkers counted by name see who's done the most. Anyone who has turned that off is counted without a name." />
                    <div class="editor-foot">
                        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                        <SaveBar New="IsNew" Label="@(IsNew ? "Add the campaign" : "Save")" Busy="_busy" OnSave="SaveAsync" OnCancel="() => OpenAsync(Close)"
                                 State="SaveBar.For(Changed, _saved)" Blocked="@(_name.Trim().Length == 0 ? "Give it a name to save it." : DatesProblem)" />
                    </div>
                }
                else
                {
                    <EmptyState Icon="footprints" Title="Choose a campaign"
                                Body="Each campaign keeps its own record of streets done, so a carols drop isn't held back by general outreach." />
                }
            </div>
        </Detail>
    </Workbench>
    <Sheet Open="_deletion is not null" OpenChanged="open => { if (!open) StopDeleting(); }" Title="@($"Delete {_editing?.Name}?")">
        <ChildContent>
            @if (_deletion is { } deletion)
            {
                @if (deletion.WhyNot.Length > 0)
                {
                    <p class="sheet__lead">@deletion.WhyNot</p>
                }
                else
                {
                    <p class="sheet__lead">@DeletionWords(deletion)</p>
                }
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        </ChildContent>
        <Actions>
            @if (_deletion is { WhyNot.Length: 0 })
            {
                <Button Block="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete the campaign</Button>
            }
            <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="StopDeleting">Keep it</Button>
        </Actions>
    </Sheet>
</LiveData>

@code {
    private static readonly IReadOnlyList<string> Feeds = [OutreachFeeds.Desk, OutreachFeeds.Campaigns];

    [Parameter, EditorRequired] public required string Scope { get; set; }

    private LiveData<OutreachDesk>? _live;
    private Campaign? _editing;
    private string _name = "", _handedOut = "", _starts = "", _ends = "";
    private bool _leaderboard, _busy, _saved;
    private CampaignDeletion? _deletion;
    private string? _problem;

    private bool IsNew => _editing is { Id.Length: 0 };

    private bool Changed =>
        _editing is { } editing && (_name != editing.Name || _handedOut != editing.HandedOut || _starts != editing.StartsOn || _ends != editing.EndsOn
                                    || _leaderboard != editing.Leaderboard);

    private string? DatesProblem =>
        OutreachRules.DateOf(_starts) is { } starts && OutreachRules.DateOf(_ends) is { } ends && ends < starts ? "It ends on or after the day it starts." : null;

    private Campaign? Chosen(OutreachDesk desk) => _editing is { Id.Length: > 0 } editing ? desk.Campaigns.FirstOrDefault(campaign => campaign.Id == editing.Id) : null;

    private static CampaignTotals TotalsOf(OutreachDesk desk, Campaign campaign) =>
        desk.Totals.FirstOrDefault(totals => totals.Campaign == campaign.Id) ?? new CampaignTotals();

    private static string Lead(Campaign campaign) =>
        campaign.Id.Length == 0 ? "What's handed out and when. It keeps its own record of streets done."
        : campaign.General ? "Always there. Walks carry it unless the walker chooses another campaign."
        : "Its own record of streets done: general outreach's streets don't count here, and the other way round.";

    private IReadOnlyList<TableColumn<Campaign>> Columns(OutreachDesk desk) =>
    [
        new("Campaign", campaign => @<span class="outreach-desk__cell"><span class="outreach-desk__name">@campaign.Name</span>@if (Handed(campaign) is { Length: > 0 } handed) { <span class="outreach-desk__sub">@handed</span> }</span>, campaign => campaign.Name),
        new("Letterboxes this month", campaign => @<span>@OutreachWords.Count(TotalsOf(desk, campaign).LetterboxesThisMonth)</span>,
            campaign => TotalsOf(desk, campaign).LetterboxesThisMonth, "num"),
    ];

    private static string Handed(Campaign campaign) =>
        string.Join(" · ", new[] { campaign.HandedOut, campaign.General ? "Always there" : OutreachWords.When(campaign) }.Where(part => part.Length > 0));

    private static string DeletionWords(CampaignDeletion deletion)
    {
        List<string> goes = [];
        if (deletion.CoveredStretches > 0)
            goes.Add("its record of streets done");
        if (deletion.PastDays > 0)
            goes.Add(OutreachWords.Plural(deletion.PastDays, "past outreach day", "past outreach days"));
        string taken = goes.Count == 0 ? "Nothing else goes with it." : $"It takes {string.Join(" and ", goes)} with it.";
        string walks = deletion.Walks > 0 ? $" {OutreachWords.Plural(deletion.Walks, "walk stays", "walks stay")} in the totals." : "";
        return $"{taken}{walks} This can't be undone.";
    }

    private async Task OpenAsync(Action open)
    {
        if (await Unsaved.MayLeaveAsync())
            open();
    }

    private void Edit(Campaign campaign)
    {
        Close();
        _editing = campaign;
        (_name, _handedOut, _starts, _ends, _leaderboard) = (campaign.Name, campaign.HandedOut, campaign.StartsOn, campaign.EndsOn, campaign.Leaderboard);
    }

    private void Close()
    {
        StopDeleting();
        _editing = null;
        _saved = false;
        _problem = null;
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        if (_name.Trim().Length == 0 || DatesProblem is not null)
            return false;
        await SaveAsync();
        return _problem is null;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        Campaign saved = new()
        {
            Id = IsNew ? Guid.CreateVersion7().ToString() : _editing!.Id, Name = _name.Trim(), HandedOut = _handedOut.Trim(), StartsOn = _starts, EndsOn = _ends,
            Leaderboard = _leaderboard, General = _editing!.General, Area = _editing.Area, Regions = _editing.Regions,
        };
        await Outreach.SaveCampaignAsync(Scope, saved);
        Edit(saved);
        _saved = true;
    });

    private Task AskToDeleteAsync() => RunAsync(async () => _deletion = await Outreach.CampaignDeletionAsync(Scope, _editing!.Id), reload: false);

    private void StopDeleting()
    {
        _deletion = null;
        _problem = null;
    }

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Outreach.DeleteCampaignAsync(Scope, _editing!.Id);
        Close();
    });

    private async Task RunAsync(Func<Task> work, bool reload = true)
    {
        _busy = true;
        _problem = null;
        try
        {
            await work();
            if (reload && _live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
