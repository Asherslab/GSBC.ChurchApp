@using GSBC.ChurchApp.Features.Outreach.Maps.Contracts
@using GSBC.ChurchApp.Features.Outreach.Routing
@using GSBC.ChurchApp.Platform.Ui.Maps
@using MapAreaShape = GSBC.ChurchApp.Platform.Ui.Maps.MapArea
@using RoutingPoint = GSBC.ChurchApp.Features.Outreach.Routing.GeoPoint
@inject OutreachMapsClient Maps
@inject StreetGraphLoader Graphs
@inject IAccess Access

<LiveData TValue="OutreachAtlas" Feeds="Feeds" Load="() => OutreachAtlas.LoadAsync(Maps, Access)" FailedTitle="Can't load the map right now">
<div class="place-map">
    @if (context.Value.Source is { } source)
    {
        <MapView @ref="_map" Class="place-map__map" Source="@source" Reach="@context.Value.Limits" Label="@Label"
                 Areas="@Shapes" Markers="@Pins" Frame="@(Framed ?? (Middle is null ? context.Value.Opening : null))" Centre="@Middle" Zoom="15" OnTap="point => TapAsync(context.Value, point)">
            <Outside><OutreachMapOutside /></Outside>
        </MapView>
        <MapSketch Map="_map" Tool="@(Mode == PlaceMapMode.DrawArea ? MapSketchTool.Polygon : MapSketchTool.None)" OnDrawn="DrawnAsync" />
        @if (Mode != PlaceMapMode.Show)
        {
            <p class="place-map__how">@(Mode == PlaceMapMode.DrawArea
                ? "Click round the area, then click the first point to close it. Escape starts again."
                : "Click the letterbox. The nearest one on that side of the street is chosen.")</p>
        }
    }
    else
    {
        <p class="field__hint">There's no map here yet. Add a map area under Settings to see places on the map.</p>
    }
</div>
</LiveData>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public MapPoint? Point { get; set; }
    [Parameter] public IReadOnlyList<MapPoint>? Area { get; set; }
    [Parameter] public PlaceMapMode Mode { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<MapPoint>> OnArea { get; set; }
    [Parameter] public EventCallback<AddressPoint> OnAddress { get; set; }

    private MapView? _map;
    private MapPoint? _placed;

    private MapPoint? Middle => Point ?? (Area is { Count: > 0 } area ? new MapPoint(area.Average(point => point.Lat), area.Average(point => point.Lon)) : null);

    private MapFrame? Framed => Area is { Count: >= 3 } area ? MapFrame.Around(area, padding: 40, maxZoom: 17) : null;

    private IReadOnlyList<MapAreaShape> Shapes => Area is { Count: >= 3 } area ? [new MapAreaShape(area, "--danger", Dashed: true)] : [];

    private IReadOnlyList<MapMarker> Pins => (_placed ?? Point) is { } point ? [new MapMarker(point, MapMarkerKind.Pin)] : [];

    private static readonly IReadOnlyList<string> Feeds = [OutreachMapsFeeds.Regions];

    private async Task TapAsync(OutreachAtlas atlas, MapPoint point)
    {
        if (Mode != PlaceMapMode.PickAddress || atlas.RegionAt(point) is not { } region)
            return;
        StreetGraph graph = await Graphs.LoadAsync(region);
        Flat flat = graph.Projection.ToFlat(new RoutingPoint(point.Lat, point.Lon));
        if (graph.Index.Nearest(flat, 60, street => graph.Street(street).CanDeliver) is not { } near)
            return;
        LetterboxRange boxes = graph.Letterboxes(near.Street, near.Side);
        int? nearest = null;
        double best = double.MaxValue;
        for (int box = boxes.Start; box < boxes.End; box++)
        {
            double distance = Math.Abs(graph.LetterboxAlong(box) - near.Along);
            if (distance < best)
                (best, nearest) = (distance, box);
        }
        if (nearest is not { } letterbox)
            return;
        AddressPoint address = EngineInputs.Address(graph, region.Id, letterbox);
        if (address.Label.Length == 0)
            address.Label = $"{graph.Street(near.Street).Name}, {(near.Side == Side.Left ? "left" : "right")} side";
        _placed = new MapPoint(address.Point.Lat, address.Point.Lng);
        await OnAddress.InvokeAsync(address);
    }

    private Task DrawnAsync(MapSketchStroke stroke) => stroke.Points.Count >= 3 ? OnArea.InvokeAsync(stroke.Points) : Task.CompletedTask;
}
