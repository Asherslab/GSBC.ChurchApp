@using GSBC.ChurchApp.Features.Outreach.Admin.Map
@using GSBC.ChurchApp.Features.Outreach.Maps.Contracts
@using GSBC.ChurchApp.Features.Outreach.Routing
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Ui.Maps
@using MapArea = GSBC.ChurchApp.Platform.Ui.Maps.MapArea
@using GeoPoint = GSBC.ChurchApp.Features.Outreach.Contracts.GeoPoint
@inherits OutreachMapLayer
@inject OutreachDeskClient Outreach
@inject StreetGraphLoader Graphs
@inject TimeProvider Time
@inject IAccess Access
@inject UnsavedChanges Unsaved

<LiveData @ref="_live" TValue="Shown" Feeds="Feeds" Load="LoadAsync" Remember="@($"outreach.map.coverage.{Map.Scope}.{Campaign}")" FailedTitle="Can't load the coverage right now">
    <ChildContent>
        @{ Shown shown = context.Value; }
        @if (IsOpen)
        {
            <SectionContent SectionName="@OutreachMap.DrawerSection">
                <PaneHead Title="Coverage" Lead="Where a campaign has been lately. Streets open up again as its rest period ends." />
                <div class="outreach-map__stack">
                    <SelectField Label="Campaign" Options="CampaignOptions(shown.Desk)" Value="@shown.Campaign" ValueChanged="ChooseCampaignAsync" />
                    @Legend(shown)
                    @Figures()
                    @if (!Map.Shows(OutreachLayer.Coverage))
                    {
                        <Notice Tone="NoticeTone.Info" Text="Coverage is switched off under Layers on the map." />
                    }
                </div>
            </SectionContent>
            <SectionContent SectionName="@OutreachMap.FootSection">
                <p class="field__hint">Click a street on the map, or draw round several, to mark them not done.</p>
                <Button Variant="ButtonVariant.Quiet" Icon="@AppIcons.LassoStreets" Block="true" Disabled="@(!Map.Shows(OutreachLayer.Coverage))" OnClick="DrawRound">Draw round streets</Button>
            </SectionContent>
        }
        else if (Map.Shows(OutreachLayer.Coverage))
        {
            <SectionContent SectionName="@OutreachMap.LegendSection">
                <div class="outreach-map__legend">
                    <p class="outreach-map__legend-title"><span>@CampaignName(shown)</span><span>@FiguresLine()</span></p>
                    <div class="outreach-coverage__ramp" aria-hidden="true"></div>
                    <p class="outreach-coverage__ramp-key"><span>This week</span><span>@Weeks(RestDays(shown)): open again</span></p>
                </div>
            </SectionContent>
        }
        @if (HasCard && (_choice is not null || _undo is not null))
        {
            <SectionContent SectionName="@OutreachMap.CardSection">
                <MapCard Label="The chosen streets">
                    <ChildContent>
                        @if (_choice is { } chosen)
                        {
                            <PaneHead Title="@chosen.Title" Lead="@ChoiceLine(chosen)" OnClose="Clear" />
                            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
                            @if (CanExpire && chosen.Pieces.Count > 0)
                            {
                                <p class="field__hint">Marking them not done opens them to walks in @CampaignName(shown) straight away. Other campaigns keep theirs.</p>
                            }
                        }
                        else
                        {
                            <p class="outreach-coverage__done" role="status">
                                Those streets are open again for @CampaignName(shown).
                                <Button Variant="ButtonVariant.Link" Busy="_busy" OnClick="UndoAsync">Undo</Button>
                            </p>
                        }
                    </ChildContent>
                    <Foot>
                        @if (_choice is { } chosen && CanExpire)
                        {
                            <div class="outreach-map__card-actions">
                                <Button Variant="ButtonVariant.Quiet" OnClick="Clear">Clear</Button>
                                <Button Busy="_busy" Disabled="@(chosen.Pieces.Count == 0)" OnClick="() => ExpireAsync(shown, chosen)">Mark as not done</Button>
                            </div>
                        }
                    </Foot>
                </MapCard>
            </SectionContent>
        }
    </ChildContent>
    <Loading>
        @if (IsOpen)
        {
            <SectionContent SectionName="@OutreachMap.DrawerSection">
                <PaneHead Title="Coverage" Lead="Where a campaign has been lately." />
                <Skeleton />
            </SectionContent>
        }
    </Loading>
</LiveData>

@code {
    private static readonly IReadOnlyList<string> Feeds = [OutreachFeeds.Desk, OutreachFeeds.Coverage, OutreachFeeds.Settings];
    private static readonly TimeSpan DrawingsClosingClick = TimeSpan.FromMilliseconds(600);

    private sealed record Shown(OutreachDesk Desk, string Campaign, CoverageMap Coverage);

    private sealed record Undo(string Campaign, DateTime At);

    private LiveData<Shown>? _live;
    private CoverageChoice? _choice;
    private CoverageView? _choiceView;
    private Undo? _undo;
    private bool _busy;
    private string? _problem;
    private Shown? _shown;
    private Dictionary<string, CoverageView> _views = [];
    private HashSet<string> _building = [];
    private Task<IReadOnlyList<CoverageRecord>>? _records;
    private readonly Dictionary<string, MapLineSet> _lineSets = [];
    private IReadOnlyList<MapLineSet> _shownSets = [];
    private IReadOnlyList<MapLine> _drawn = [];
    private CoverageTally? _tally;
    private DateTimeOffset _drewAt;

    public override OutreachMapJob Job => OutreachMapJob.Coverage;

    public override IReadOnlyList<LayerCount> Shows => [new(OutreachLayer.Coverage, 0)];

    public override IReadOnlyList<MapLine> Lines => Map.Shows(OutreachLayer.Coverage) ? _drawn : [];

    public override IReadOnlyList<MapLineSet> LineSets => Map.Shows(OutreachLayer.Coverage) ? _shownSets : [];

    public override IReadOnlyList<MapArea> Areas => _choice is { Area: { } drawn } ? [new MapArea(drawn, "--ink", Dashed: true)] : [];

    private string Campaign => Map.Campaign ?? OutreachCampaigns.GeneralId.ToString();

    private bool CanExpire => Access.Can(OutreachPermissions.Expire, MinistryScope);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Map.Moved += Moved;
    }

    public override void Dispose()
    {
        Map.Moved -= Moved;
        base.Dispose();
    }

    private async Task<Shown> LoadAsync()
    {
        string campaign = Campaign;
        Task<OutreachDesk> desk = Outreach.DeskAsync(Map.Scope);
        Task<CoverageMap> coverage = Outreach.CoverageAsync(Map.Scope, campaign);
        await Task.WhenAll(desk, coverage);
        Shown shown = new(await desk, campaign, await coverage);
        HashSet<string> shownBefore = [.. _views.Keys];
        (_shown, _views, _building, _tally) = (shown, [], [], null);
        _records = CoverageRecord.ReadAsync(shown.Coverage.Streets, new FrameBudget(Time));
        foreach (string gone in _lineSets.Keys.Where(region => Map.Atlas.Regions.All(each => each.Id != region)).ToList())
            _lineSets.Remove(gone);
        _ = ShowViewsAsync(Map.Atlas.Regions.Where(region => shownBefore.Contains(region.Id)));
        return shown;
    }

    private void Moved() => _ = ShowViewsAsync([]);

    private async Task ShowViewsAsync(IEnumerable<OutreachRegion> rebuilding)
    {
        if (_shown is not { } shown || _records is not { } reading || (Map.View ?? Map.Frame) is not { } view)
            return;
        HashSet<string> building = _building;
        List<OutreachRegion> missing = [.. Map.Atlas.In(view).Concat(rebuilding).Where(region => !_views.ContainsKey(region.Id) && building.Add(region.Id))];
        _tally = Tally(view);
        await InvokeAsync(StateHasChanged);
        if (missing.Count == 0)
            return;
        FrameBudget budget = new(Time);
        IReadOnlyList<CoverageRecord> records = await reading;
        Task<StreetGraph>[] graphs = [.. missing.Select(Graphs.LoadAsync)];
        for (int index = 0; index < missing.Count; index++)
        {
            OutreachRegion region = missing[index];
            if (await Loaded(graphs[index]) is not { } graph)
            {
                building.Remove(region.Id);
                continue;
            }
            CoverageView built = await CoverageView.BuildAsync(graph, records, RestDays(shown), ChurchTime.Today(Time), Map.Atlas.Owns(region), budget);
            if (!ReferenceEquals(shown, _shown))
                return;
            _views[region.Id] = built;
            _lineSets[region.Id] = new MapLineSet(region.Id, built.Lines);
            _shownSets = [.. _lineSets.Values];
            RefreshChoice();
            Redraw();
            _tally = (Map.View ?? Map.Frame) is { } now ? Tally(now) : null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task<StreetGraph?> Loaded(Task<StreetGraph> graph)
    {
        try
        {
            return await graph;
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private CoverageTally? Tally(MapFrame view)
    {
        List<CoverageView?> inView = [.. Map.Atlas.In(view).Select(region => _views.GetValueOrDefault(region.Id))];
        return inView.Any(each => each is null)
            ? null
            : inView.OfType<CoverageView>().Aggregate(new CoverageTally(), (sum, each) => sum + each.TallyIn(view));
    }

    private void RefreshChoice()
    {
        if (_choice is not { } choice)
            return;
        if (choice.Street is { } street && _choiceView is not null && _views.GetValueOrDefault(_choiceView.Graph.Region.Id) is { } fresh)
            (_choice, _choiceView) = (fresh.ForStreet(street), fresh);
        else if (choice.Area is { } area)
            _choice = InArea(area);
    }

    private void Redraw()
    {
        _drawn = _choice is { Street: { } street } && _choiceView is { } view ? [new MapLine(view.StreetShape(street), MapLineStyle.Chosen)] : [];
        Map.Redraw();
    }

    private CoverageChoice InArea(IReadOnlyList<MapPoint> area) =>
        new("The streets you drew round", [.. _views.Values.SelectMany(view => view.InArea(area).Pieces)], area, null);

    private RenderFragment Legend(Shown shown) =>
        @<div>
            <p class="outreach-coverage__label">When it was last done</p>
            <div class="outreach-coverage__ramp" aria-hidden="true"></div>
            <p class="outreach-coverage__ramp-key"><span>This week</span><span>@Weeks(RestDays(shown) / 2)</span><span>@Weeks(RestDays(shown))</span></p>
            <p class="field__hint">Streets fade to the map as they open again, @Weeks(RestDays(shown)) after they were done.</p>
        </div>;

    private RenderFragment Figures() =>
        @<div class="outreach-coverage__figures">
            @if (_tally is { } tally)
            {
                <StatTile Value="@OutreachWords.Count(tally.StreetsDone)" Label="@($"streets done, of {OutreachWords.Count(tally.Streets)} on the map in view")" Quiet="true" />
                <StatTile Value="@Percent(tally.HomesDone, tally.Homes)" Label="of the letterboxes in view done" Quiet="true" />
            }
            else
            {
                <StatTile Value="Counting…" Label="streets done on the map in view" Quiet="true" />
                <StatTile Value="Counting…" Label="of the letterboxes in view done" Quiet="true" />
            }
        </div>;

    private string FiguresLine() => _tally is { } tally
        ? $"{OutreachWords.Count(tally.StreetsDone)} of {OutreachWords.Count(tally.Streets)} streets in view"
        : "Counting…";

    private static int RestDays(Shown shown) => Math.Max(1, shown.Desk.Settings.RestDays);

    private static IReadOnlyList<FieldOption> CampaignOptions(OutreachDesk desk) => [.. desk.Campaigns.Select(campaign => new FieldOption(campaign.Id, campaign.Name))];

    private static string CampaignName(Shown shown) => shown.Desk.Campaigns.FirstOrDefault(campaign => campaign.Id == shown.Campaign)?.Name ?? "this campaign";

    private static string Weeks(int days) => days >= 56 ? $"{(int)Math.Round(days / 30.4)} months" : $"{(int)Math.Round(days / 7.0)} weeks";

    private static string Percent(int part, int whole) => whole == 0 ? "0%" : $"{Math.Round(part * 100.0 / whole):0}%";

    private string ChoiceLine(CoverageChoice choice) =>
        choice.Pieces.Count == 0 || _views.Values.FirstOrDefault() is not { } view
            ? "Nothing done here in this campaign's rest period."
            : $"{OutreachWords.Plural(choice.Sides, "street side", "street sides")} · {OutreachWords.Plural(choice.Homes, "letterbox", "letterboxes")} · {view.DoneBetween(choice)}";

    private Task ChooseCampaignAsync(string campaign)
    {
        _undo = null;
        Map.Use(campaign);
        return _live?.ReloadAsync() ?? Task.CompletedTask;
    }

    public override async Task<bool> TapAsync(MapPoint point, double reachMetres)
    {
        if (!Map.Shows(OutreachLayer.Coverage) || Time.GetUtcNow() - _drewAt < DrawingsClosingClick)
            return false;
        CoverageView? view = Map.Atlas.RegionAt(point) is { } region ? _views.GetValueOrDefault(region.Id) : null;
        if (view?.StreetAt(point) is not { } choice)
            return false;
        if (await Unsaved.MayLeaveAsync())
        {
            (_choice, _choiceView, _problem, _undo) = (choice, view, null, null);
            Map.Choose(this);
            Redraw();
        }
        return true;
    }

    public override void LetGo()
    {
        (_choice, _choiceView, _problem, _undo) = (null, null, null, null);
        Redraw();
    }

    private void DrawRound() =>
        Map.Draw(new OutreachMapDrawing(MapSketchTool.Lasso, "Drag a loop round the streets", DrawnAsync));

    private Task DrawnAsync(IReadOnlyList<MapPoint> points)
    {
        _drewAt = Time.GetUtcNow();
        if (points.Count < 3)
            return Task.CompletedTask;
        (_choice, _choiceView, _problem, _undo) = (InArea(points), null, null, null);
        Map.Choose(this);
        Redraw();
        return Task.CompletedTask;
    }

    private void Clear()
    {
        (_choice, _choiceView, _problem, _undo) = (null, null, null, null);
        Map.LetGo(this);
        Redraw();
    }

    private Task ExpireAsync(Shown shown, CoverageChoice choice) => RunAsync(async () =>
    {
        Expired expired = choice.Street is { } street && _choiceView is not null
            ? await Outreach.ExpireAsync(Map.Scope, shown.Campaign, [], CoverageView.WholeStreet(_choiceView.Graph, street))
            : await Outreach.ExpireAsync(Map.Scope, shown.Campaign, [.. choice.Area!.Select(point => new GeoPoint { Lat = point.Lat, Lng = point.Lon })], []);
        (_undo, _choice, _choiceView) = (new Undo(shown.Campaign, expired.At), null, null);
    });

    private Task UndoAsync() => _undo is not { } undo ? Task.CompletedTask : RunAsync(async () =>
    {
        await Outreach.UndoExpiryAsync(Map.Scope, undo.Campaign, undo.At);
        _undo = null;
        Map.LetGo(this);
    });

    private async Task RunAsync(Func<Task> work)
    {
        _busy = true;
        _problem = null;
        try
        {
            await work();
            if (_live is not null)
                await _live.ReloadAsync();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
