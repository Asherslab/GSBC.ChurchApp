@using GSBC.ChurchApp.Platform.Contracts.Locations
@using GSBC.ChurchApp.Features.Outreach.Admin.Planning
@using GSBC.ChurchApp.Features.Outreach.Client.Planning
@using GSBC.ChurchApp.Features.Outreach.Routing
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Ui.Maps
@using GeoPoint = GSBC.ChurchApp.Features.Outreach.Routing.GeoPoint
@implements IDisposable
@inject OutreachDeskClient Outreach
@inject TimeProvider Time
@inject IAccess Access
@using Microsoft.JSInterop
@using GSBC.ChurchApp.Features.Outreach.Admin.Map

<UnsavedGuard What="the routes" Autosave="() => _save" Save="SaveBeforeLeavingAsync" />

<SectionContent SectionName="@OutreachHead.ActionsSection">
    @if (CanPlan && _view == PlanView.Plan)
    {
        <SaveStatus State="_save" SavedText="@(_draftChangedAt is null ? "Saves as you go" : "Draft saved")" Retry="SaveNowAsync" Detail="@_saveProblem" />
    }
    <RouteMapsButton Setup="Setup" Planner="_planner" Routes="_published" Changed="_changedSincePublished" />
</SectionContent>

@if (Setup.Region is null || Setup.Graph is null || _planner is null)
{
    <EmptyState Icon="map" Title="There's no map of the church's area yet"
                Body="Someone who looks after maps builds it once, under Map areas on the Map tab. Routes are planned on it." />
}
else
{
    <MapWorkspace Label="Outreach map" Jobs="Dock.Jobs" Current="@OutreachMapJobs.Slug(OutreachMapJob.Plan)" OnChoose="Dock.Choose" Open="_open" OpenChanged="open => _open = open"
                  Wide="true" DrawerLabel="The routes" Class="outreach-map">
        <Map>
            <MapView @ref="_map" Source="@(Setup.Atlas.Source ?? MapSource.Url(Setup.Region.Map.Url, Setup.Region.Attribution))" Reach="@Setup.Atlas.Limits" Label="@($"Map of the routes for {OutreachWords.DayTitle(Setup.Day)}")"
                     Lines="_lines" Areas="_areas" Markers="_markers" Frame="_frame" OnTap="TappedAsync" Class="plan-desk__map">
                <Overlay>
                    @if (_view == PlanView.Plan && CanPlan)
                    {
                        <div class="plan-rail" role="toolbar" aria-label="Map tools" data-map-cover>
                            @foreach (ToolChoice choice in Tools)
                            {
                                <Button Variant="ButtonVariant.Quiet" Icon="@choice.Icon" AriaLabel="@choice.Name" Tooltip="@choice.Tip" Pressed="@(_tool == choice.Tool)"
                                        Disabled="@(choice.NeedsRoute && _selected is null || choice.NeedsRoutes && _planner.Sections.Count == 0)"
                                        Class="plan-rail__tool" OnClick="() => ChooseTool(choice.Tool)" />
                            }
                            <span class="plan-rail__rule" role="separator"></span>
                            <Button Variant="ButtonVariant.Quiet" Icon="@AppIcons.Undo" AriaLabel="Undo" Tooltip="Undo" Disabled="!_planner.Draft.CanUndo" Class="plan-rail__tool" OnClick="UndoAsync" />
                            <Button Variant="ButtonVariant.Quiet" Icon="@AppIcons.Redo" AriaLabel="Redo" Tooltip="Redo" Disabled="!_planner.Draft.CanRedo" Class="plan-rail__tool" OnClick="RedoAsync" />
                        </div>
                        @if (_tool == PlanTool.Area)
                        {
                            <MapDrawBar Class="plan-draw-bar" Text="Area: click each corner" OnUndo="() => _sketch?.UndoPointAsync() ?? Task.CompletedTask" CanUndo="@(_placed > 0)"
                                        OnCancel="Cancelled" OnFinish="() => _sketch?.FinishAsync() ?? Task.CompletedTask" CanFinish="@(_placed >= 3)" />
                        }
                        else if (ToolHint is { } hint)
                        {
                            <p class="plan-hint" role="status">@hint</p>
                        }
                    }
                    @if (_hovered is { } hovered && Board(hovered) is var progress)
                    {
                        <div class="plan-card" aria-hidden="true">
                            <p class="plan-card__title"><span class="plan-dot" style="--route: @RouteColours.Of(hovered.Colour)"></span>Route @hovered.Number · @hovered.Name</p>
                            <p class="plan-card__facts">@OutreachWords.Plural(hovered.Letterboxes, "letterbox", "letterboxes") · @hovered.Kilometres.ToString("0.0") km · @OutreachWords.Minutes(hovered.Minutes) · @Bundles(hovered)</p>
                            @if (progress is not null)
                            {
                                <p class="plan-card__facts">@Claimed(progress) · @Percent(progress)% walked</p>
                            }
                            @if (hovered.Review is { } review)
                            {
                                <p class="plan-card__review">Needs review: @review</p>
                            }
                        </div>
                    }
                    @if (_view == PlanView.Plan && CanPlan && Selected is { } chosen)
                    {
                        <div class="plan-chosen" role="group" aria-label="@($"Route {chosen.Number}")" data-map-cover>
                            @if (_renaming)
                            {
                                <TextField Label="Route name" @bind-Value="_name" MaxLength="80" Class="plan-chosen__name" />
                                <Button Small="true" OnClick="RenameAsync">Rename</Button>
                                <Button Small="true" Variant="ButtonVariant.Quiet" OnClick="() => _renaming = false">Cancel</Button>
                            }
                            else
                            {
                                <span class="plan-chosen__what"><span class="plan-dot" style="--route: @RouteColours.Of(chosen.Colour)"></span><strong>Route @chosen.Number</strong> · @chosen.Letterboxes · @OutreachWords.Minutes(chosen.Minutes)</span>
                                <span class="plan-chosen__actions">
                                    <Button Small="true" Variant="ButtonVariant.Quiet" Icon="@(chosen.Locked ? AppIcons.Unlock : AppIcons.Lock)" OnClick="LockAsync">@(chosen.Locked ? "Unlock" : "Lock")</Button>
                                    <Button Small="true" Variant="ButtonVariant.Quiet" Icon="@AppIcons.SplitInTwo" Disabled="chosen.Locked" OnClick="SplitAsync">Split in two</Button>
                                    <Menu Label="@($"More for route {chosen.Number}")" Small="true" Items="ChosenItems(chosen)" />
                                </span>
                            }
                        </div>
                    }
                </Overlay>
                <Outside><OutreachMapOutside /></Outside>
            </MapView>
            <MapSketch @ref="_sketch" Map="_map" Tool="SketchTool" Labels="_labels" Preview="_preview" BrushColour="@BrushColour"
                       OnDrawn="DrawnAsync" OnDrawing="Drawing" OnHover="Hover" OnHoverEnded="() => _hovered = null" OnCancelled="Cancelled" />
        </Map>
        <Drawer>
            <PaneHead Title="@($"Outreach {OutreachWords.DayTitle(Setup.Day)}")" Lead="@Lead" />
            <Button Variant="ButtonVariant.Link" Href="@OutreachMapJobs.Href(OutreachMapJob.Plan)" Class="plan-desk__leave">Leave this day's routes</Button>
            <Segmented TValue="PlanView" Label="Show" Options="Views" Value="_view" ValueChanged="ShowAsync" Class="plan-desk__views" />
            @if (_view == PlanView.Plan)
            {
                <PlanPane Planner="_planner" Areas="Setup.Areas" AreaName="@AreaName" CanPlan="CanPlan" Selected="_selected" Busy="_busy"
                          OnSelect="SelectAsync" OnDraw="() => ChooseTool(PlanTool.Area)" OnUseArea="UseAreaAsync" OnSize="SizeAsync"
                          OnIncludeRested="IncludeRestedAsync" OnSaveArea="SaveAreaAsync" OnNextReview="NextReviewAsync" />
            }
            else
            {
                <LiveData TValue="DayBoard" Feeds="BoardFeeds" Load="LoadBoardAsync" FailedTitle="Can't load how the day is going">
                    <DayBoardPane Board="context.Value" Planner="_planner" Day="Setup.Day" Selected="_selected" OnSelect="SelectAsync" />
                </LiveData>
            }
            <Notice Tone="NoticeTone.Warning" Text="@_problem" />
        </Drawer>
        <DrawerFoot>
            @if (_view == PlanView.Plan && CanPlan && _planner.Sections.Count > 0)
            {
                <p class="plan-desk__published">@PublishedLine</p>
                <div class="plan-desk__actions">
                    <Button Small="true" Variant="ButtonVariant.Quiet" Icon="@AppIcons.Rebalance" Tooltip="Even out the routes that aren't locked" Disabled="_busy" OnClick="RebalanceAsync">Rebalance</Button>
                    <Button Small="true" Variant="ButtonVariant.Quiet" Icon="@AppIcons.Regenerate" Tooltip="Split the area again, keeping locked routes" Disabled="@(_busy || !_planner.HasArea)" OnClick="RegenerateAsync">Regenerate</Button>
                    <span class="plan-desk__gap"></span>
                    <Button Busy="_busy" Disabled="!Unpublished" OnClick="AskToPublish">@PublishLabel</Button>
                </div>
            }
            else if (_view == PlanView.OnTheDay)
            {
                <p class="plan-desk__published">@DayLine</p>
            }
        </DrawerFoot>
    </MapWorkspace>
}

<Sheet Open="_publishing" OpenChanged="open => _publishing = open" Title="@PublishLabel">
    <ChildContent>
        <p class="sheet__lead">@PublishWords</p>
        @if (_planner?.NeedingReview > 0)
        {
            <ul class="plan-review">
                @foreach (PlannedSection section in _planner.Sections.Where(section => section.Review is not null))
                {
                    <li><strong>Route @section.Number</strong>: @section.Review</li>
                }
            </ul>
        }
    </ChildContent>
    <Actions>
        <Button Block="true" Busy="_busy" OnClick="PublishAsync">@(_planner?.NeedingReview > 0 ? "Publish anyway" : "Publish")</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" OnClick="() => _publishing = false">Not yet</Button>
    </Actions>
</Sheet>

@code {
    private static readonly IReadOnlyList<string> BoardFeeds = [OutreachFeeds.Claims, OutreachFeeds.Coverage, OutreachFeeds.Desk];
    private static readonly TimeSpan SettleTime = TimeSpan.FromSeconds(1.2);
    private static readonly TimeSpan ClickAfterDrawing = TimeSpan.FromMilliseconds(600);

    private static readonly IReadOnlyList<ToolChoice> Tools =
    [
        new(PlanTool.Select, AppIcons.SelectOnMap, "Select", "Select a route (click it on the map)"),
        new(PlanTool.Area, AppIcons.DrawArea, "Draw the area", "Draw the area to cover; it's split into routes"),
        new(PlanTool.Cut, AppIcons.CutRoutes, "Scissors", "Draw across a route's streets where it should split", NeedsRoutes: true),
        new(PlanTool.Brush, AppIcons.PaintStreets, "Brush", "Drag along streets to paint them into the selected route; click takes a whole street", NeedsRoute: true),
        new(PlanTool.Lasso, AppIcons.LassoStreets, "Lasso", "Loop streets into the selected route, or into a new one", NeedsRoutes: true),
        new(PlanTool.Erase, AppIcons.LeaveOut, "Eraser", "Drag along streets to leave them out of the day", NeedsRoutes: true),
        new(PlanTool.Start, AppIcons.RouteStart, "Start pin", "Click where the selected route starts", NeedsRoute: true),
    ];

    private static readonly IReadOnlyList<SegmentOption<PlanView>> Views = [new(PlanView.Plan, "Plan"), new(PlanView.OnTheDay, "On the day")];

    [Parameter, EditorRequired] public required PlanSetup Setup { get; set; }
    [Parameter, EditorRequired] public required OutreachDock Dock { get; set; }

    private MapSketch? _sketch;
    private int _placed;
    private bool _open = true;

    private PlanSetup? _shown;
    private DayPlanner? _planner;
    private MapView? _map;
    private PlanTool _tool;
    private PlanView _view;
    private int? _selected;
    private PlannedSection? _hovered;
    private DateTime _drawnAt;
    private DayBoard? _board;
    private IReadOnlyList<MapLine> _lines = [];
    private IReadOnlyList<MapArea> _areas = [];
    private IReadOnlyList<MapMarker> _markers = [];
    private IReadOnlyList<MapLabel> _labels = [];
    private IReadOnlyList<MapLine> _preview = [];
    private MapFrame? _frame;
    private IReadOnlyList<DayRoute> _published = [];
    private DateTime? _publishedAt;
    private DateTime? _draftChangedAt;
    private bool _changedSincePublished;
    private SaveState _save = SaveState.Saved;
    private CancellationTokenSource? _settling;
    private bool _busy, _publishing, _renaming;
    private string _name = "";
    private string? _problem, _saveProblem;

    private enum PlanView
    {
        Plan,
        OnTheDay,
    }

    private sealed record ToolChoice(PlanTool Tool, string Icon, string Name, string Tip, bool NeedsRoute = false, bool NeedsRoutes = false);

    private bool CanPlan => Access.Can(OutreachPermissions.Plan, Setup.Scope);

    private PlannedSection? Selected => _selected is { } id ? _planner?.Section(id) : null;

    private bool Unpublished => _changedSincePublished || _published.Count == 0;

    private string Lead =>
        $"{OutreachWords.Window(Setup.Day)}{(Setup.Day.MeetingPlace.Length > 0 ? $", meeting at {Setup.Day.MeetingPlace}" : "")} · {Setup.Campaign}"
        + (_planner is { Sections.Count: > 0 } planner ? $" · {OutreachWords.Plural(planner.Sections.Count, "route", "routes")}, {OutreachWords.Plural(planner.Letterboxes, "letterbox", "letterboxes")}" : "");

    private string AreaName => Setup.Areas.FirstOrDefault(area => area.Id == _planner?.AreaId)?.Name ?? "";

    private MapSketchTool SketchTool => _tool switch
    {
        PlanTool.Area => MapSketchTool.Polygon,
        PlanTool.Cut => MapSketchTool.Line,
        PlanTool.Brush or PlanTool.Erase => MapSketchTool.Brush,
        PlanTool.Lasso => MapSketchTool.Lasso,
        PlanTool.Start => MapSketchTool.Pin,
        _ => MapSketchTool.None,
    };

    private string? BrushColour => _tool == PlanTool.Erase ? "#626a79" : Selected is { } chosen ? RouteColours.Of(chosen.Colour) : null;

    private string? ToolHint => _tool switch
    {
        PlanTool.Area => "Click the corners of the area. Click the first corner, or press Enter, to finish. Escape starts again.",
        PlanTool.Cut => "Draw a line across the streets where the route should split.",
        PlanTool.Brush => Selected is { } chosen ? $"Drag along streets to paint them into route {chosen.Number}. Click a street to take all of it." : null,
        PlanTool.Lasso => Selected is { } chosen ? $"Draw a loop around streets to give them to route {chosen.Number}." : "Draw a loop around streets to make them a new route.",
        PlanTool.Erase => "Drag along streets to leave them out of the day. Click a street to leave all of it out.",
        PlanTool.Start => Selected is { } chosen ? $"Click the corner where route {chosen.Number} should start." : null,
        _ => _planner?.Note,
    };

    private string PublishLabel => _published.Count == 0 ? $"Publish {OutreachWords.Plural(_planner?.Sections.Count ?? 0, "route", "routes")}" : "Publish the changes";

    private string PublishWords =>
        _published.Count == 0
            ? "Walkers see the day's routes in the app and can claim one. Each route gets the code its printed QR opens."
            : "Walkers see the new routes straight away. Routes you kept keep their printed QR codes; claims on routes that are gone are taken off.";

    private string PublishedLine =>
        _publishedAt is not { } at ? "Not published yet: walkers can't see these routes."
        : _changedSincePublished ? $"Changed since it was published {OutreachWords.At(at)}. Walkers still see the old routes."
        : $"Published {OutreachWords.At(at)}. Walkers see these routes.";

    private string DayLine
    {
        get
        {
            DateTime now = Time.GetUtcNow().UtcDateTime;
            return now < Setup.Day.StartsAt ? $"It starts {OutreachWords.At(Setup.Day.StartsAt)}. Claims show here as people take routes."
                : now < Setup.Day.EndsAt ? $"On now, until {OutreachWords.Window(Setup.Day).Split(" to ")[^1]}. This updates by itself."
                : "It's over. This is what got done.";
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_shown, Setup))
            return;
        _shown = Setup;
        _published = Setup.Plan.Routes;
        _publishedAt = Setup.Plan.PublishedAt;
        _draftChangedAt = Setup.Plan.Draft?.ChangedAt;
        _changedSincePublished = _draftChangedAt is { } changed && (_publishedAt is not { } published || changed > published);
        DateTime now = Time.GetUtcNow().UtcDateTime;
        _view = now >= Setup.Day.StartsAt.AddHours(-1) && _published.Count > 0 ? PlanView.OnTheDay : PlanView.Plan;
        _planner = Build(Setup);
        Redraw(fit: true);
    }

    public void Dispose() => _settling?.Cancel();

    private static DayPlanner? Build(PlanSetup setup)
    {
        if (setup.Graph is not { } graph || setup.Region is not { } region)
            return null;
        StreetGraph streets = graph;
        DayPlanner planner = new(streets, region.Id, region.Version, EngineInputs.Settings(setup.Settings) with { BundleSize = setup.BundleSize },
            [EngineInputs.Coverage(streets, setup.Day.Campaign, setup.Coverage.Streets)], EngineInputs.Marks(setup.Marks.Skips, setup.Marks.Exclusions),
            ChurchTime.DayOf(setup.Day.StartsAt), setup.Day.Mode == WalkMode.Doorknock ? WalkKind.Doorknock : WalkKind.Letterbox, Meeting(setup, region));
        DayDraft? draft = setup.Plan.Draft ?? (setup.Plan.Routes.Count > 0 ? DayPlanner.DraftOf(setup.Plan.Routes) : null);
        if (draft is not null)
            planner.Restore(draft);
        return planner;
    }

    private static GeoPoint Meeting(PlanSetup setup, Maps.Contracts.OutreachRegion region)
    {
        if (setup.Day.Meeting is { Kind: LocationKind.AtChurch } && setup.Atlas.Church is { } church)
            return new GeoPoint(church.Lat, church.Lon);
        if (setup.Day.MeetingPoint is { Lat: not 0 } meeting)
            return EngineInputs.Point(meeting);
        (double lat, double lon) = OutreachRegions.Centre(region);
        return new GeoPoint(lat, lon);
    }

    private void Redraw(bool fit = false)
    {
        if (_planner is not { } planner)
            return;
        _lines = PlanDrawing.Lines(planner, _selected, _view == PlanView.OnTheDay ? _board?.Progress.SelectMany(progress => progress.Done).ToList() : null);
        _labels = PlanDrawing.Labels(planner, _selected);
        _areas = planner.HasArea ? [new MapArea(PlanDrawing.Points(planner.Area))] : [];
        List<MapMarker> markers = [new(PlanDrawing.Point(planner.Meeting), MapMarkerKind.Meeting, "Meet here")];
        if (Selected is { } chosen)
            markers.Add(new MapMarker(PlanDrawing.Point(planner.Network.Graph.Projection.ToGeo(planner.Network.Node(chosen.Summary.Plan.Start))), MapMarkerKind.Start, $"Route {chosen.Number} starts"));
        _markers = markers;
        _preview = [];
        if (fit)
            _frame = PlanDrawing.Frame(planner, planner.Meeting);
    }

    private DayBoard? BoardOrNull => _view == PlanView.OnTheDay ? _board : null;

    private RouteProgress? Board(PlannedSection section) =>
        BoardOrNull is { } board && _published.FirstOrDefault(published => published.Number == section.Number) is { } route
            ? board.Progress.FirstOrDefault(progress => progress.RouteId == route.Id)
            : null;

    private static string Claimed(RouteProgress progress) =>
        progress.ClaimedBy.Count == 0 ? "No one yet" : progress.ClaimedBy.Count <= 2 ? string.Join(", ", progress.ClaimedBy) : $"{progress.ClaimedBy[0]}, {progress.ClaimedBy[1]} + {progress.ClaimedBy.Count - 2}";

    private static int Percent(RouteProgress progress) => progress.Letterboxes == 0 ? 0 : (int)Math.Round(100.0 * progress.LetterboxesDone / progress.Letterboxes);

    private string Bundles(PlannedSection section) => OutreachWords.Plural(section.Summary.Plan.BundlesToTake, "bundle", "bundles");

    private IReadOnlyList<MenuItem> ChosenItems(PlannedSection chosen) =>
    [
        this.Item("Rename…", () => { _name = chosen.Name; _renaming = true; }, AppIcons.Heading),
        .. _planner!.Sections.Where(other => other.Id != chosen.Id).Select(other => this.Item($"Merge with route {other.Number}", () => EditAsync(planner => planner.Apply(planner.Draft.Merge([chosen.Id, other.Id]))), AppIcons.Merge, other.Name, startsGroup: other == _planner.Sections.First(s => s.Id != chosen.Id))),
        this.Item("Leave its streets out", () => EditAsync(planner => planner.Apply(planner.Draft.Unassign([chosen.Id]))), AppIcons.LeaveOut, "They stay on the map, in no route", danger: true, startsGroup: true),
    ];

    private async Task<DayBoard> LoadBoardAsync()
    {
        _board = await Outreach.BoardAsync(Setup.Scope, Setup.Day.Id);
        Redraw();
        return _board;
    }

    private async Task ShowAsync(PlanView view)
    {
        _view = view;
        _tool = PlanTool.Select;
        Redraw();
        StateHasChanged();
        await Task.Yield();
        if (_map?.Handle is { } handle)
            await handle.InvokeVoidAsync("resize");
    }

    private Task NextReviewAsync()
    {
        List<PlannedSection> flagged = _planner?.Sections.Where(section => section.Review is not null).ToList() ?? [];
        if (flagged.Count == 0)
            return Task.CompletedTask;
        PlannedSection next = flagged.FirstOrDefault(section => section.Number > (Selected?.Number ?? 0)) ?? flagged[0];
        _selected = next.Id;
        _renaming = false;
        Redraw();
        return Task.CompletedTask;
    }

    private void ChooseTool(PlanTool tool)
    {
        _tool = _tool == tool ? PlanTool.Select : tool;
        _placed = 0;
        _preview = [];
        _renaming = false;
    }

    private void Hover(MapPoint point)
    {
        PlannedSection? found = _planner is { } planner ? PlanDrawing.SectionAt(planner, point) : null;
        if (found?.Id != _hovered?.Id)
            _hovered = found;
    }

    private void Cancelled()
    {
        _placed = 0;
        _preview = [];
        _tool = PlanTool.Select;
    }

    private Task SelectAsync(int? section)
    {
        _selected = section == _selected ? null : section;
        _renaming = false;
        Redraw();
        return Task.CompletedTask;
    }

    private Task TappedAsync(MapPoint point)
    {
        if (_planner is not { } planner || Time.GetUtcNow().UtcDateTime - _drawnAt < ClickAfterDrawing)
            return Task.CompletedTask;
        switch (_tool)
        {
            case PlanTool.Select:
                return SelectAsync(PlanDrawing.SectionAt(planner, point)?.Id);
            case PlanTool.Brush when _selected is { } into && PlanDrawing.StreetAt(planner, point) is { } brushed:
                return EditAsync(p => p.Apply(p.Draft.Paint(into, [Routing.Stretch.Whole(brushed.Street)])));
            case PlanTool.Erase when PlanDrawing.StreetAt(planner, point) is { } erased:
                return EditAsync(p => p.Apply(p.Draft.Erase([Routing.Stretch.Whole(erased.Street)])));
            default:
                return Task.CompletedTask;
        }
    }

    private void Drawing(MapSketchStroke stroke)
    {
        if (stroke.Tool == MapSketchTool.Polygon)
        {
            _placed = stroke.Points.Count;
            return;
        }
        if (_planner is not { } planner)
            return;
        IReadOnlyList<GeoPoint> points = PlanDrawing.Points(stroke.Points);
        _preview = _tool switch
        {
            PlanTool.Cut => PlanDrawing.CutPreview(planner, planner.Draft.PreviewCut(points)),
            PlanTool.Brush when Selected is { } chosen => PlanDrawing.StretchPreview(planner, planner.Brush(points), RouteColours.Of(chosen.Colour)),
            PlanTool.Erase => PlanDrawing.StretchPreview(planner, planner.Brush(points), "#626a79"),
            _ => [],
        };
    }

    private Task DrawnAsync(MapSketchStroke stroke)
    {
        if (_planner is null)
            return Task.CompletedTask;
        IReadOnlyList<GeoPoint> points = PlanDrawing.Points(stroke.Points);
        _preview = [];
        _drawnAt = Time.GetUtcNow().UtcDateTime;
        return _tool switch
        {
            PlanTool.Area => EditAsync(planner =>
            {
                bool drawn = planner.Draw(points);
                _tool = PlanTool.Select;
                _selected = null;
                return drawn;
            }, fit: true),
            PlanTool.Cut => EditAsync(planner => planner.Apply(planner.Draft.Cut(points))),
            PlanTool.Brush when _selected is { } into => EditAsync(planner => planner.Apply(planner.Draft.Paint(into, planner.Brush(points)))),
            PlanTool.Erase => EditAsync(planner => planner.Apply(planner.Draft.Erase(planner.Brush(points)))),
            PlanTool.Lasso => EditAsync(planner => planner.Apply(planner.Draft.Lasso(_selected, points))),
            PlanTool.Start when _selected is { } route && points.Count > 0 => EditAsync(planner => planner.Apply(planner.Draft.MoveStart(route, points[0]))),
            _ => Task.CompletedTask,
        };
    }

    private Task UndoAsync() => EditAsync(planner => planner.Undo());

    private Task RedoAsync() => EditAsync(planner => planner.Redo());

    private Task RebalanceAsync() => EditAsync(planner => planner.Rebalance());

    private Task RegenerateAsync() => EditAsync(planner => planner.Regenerate());

    private Task LockAsync() => Selected is { } chosen ? EditAsync(planner => planner.Apply(planner.Draft.SetLocked([chosen.Id], !chosen.Locked))) : Task.CompletedTask;

    private Task SplitAsync() => Selected is { } chosen ? EditAsync(planner => planner.SplitInTwo(chosen.Id)) : Task.CompletedTask;

    private Task RenameAsync()
    {
        _renaming = false;
        return Selected is { } chosen ? EditAsync(planner => planner.Apply(planner.Draft.Rename(chosen.Id, _name.Trim()))) : Task.CompletedTask;
    }

    private Task SizeAsync((PlanTarget Target, double PerRoute) size) => EditAsync(planner => planner.SizeRoutes(size.Target, size.PerRoute));

    private Task IncludeRestedAsync(bool restedToo) => EditAsync(planner => planner.IncludeRested(restedToo));

    private Task UseAreaAsync(SavedArea area) =>
        EditAsync(planner =>
        {
            _selected = null;
            return planner.Draw(area.Area.Select(EngineInputs.Point).ToList(), area.Id);
        }, fit: true);

    private async Task SaveAreaAsync(string name)
    {
        if (_planner is not { HasArea: true } planner)
            return;
        await RunAsync(() => Outreach.SaveAreaAsync(Setup.Scope, new SavedArea
        {
            Id = Guid.CreateVersion7().ToString(), Name = name, Area = planner.Area.Select(EngineInputs.Point).ToList(),
        }));
    }

    private Task EditAsync(Func<DayPlanner, bool> edit, bool fit = false)
    {
        if (_planner is not { } planner || !CanPlan)
            return Task.CompletedTask;
        _problem = null;
        if (!edit(planner))
        {
            Redraw();
            return Task.CompletedTask;
        }
        if (_selected is { } selected && planner.Section(selected) is null)
            _selected = null;
        Redraw(fit);
        _changedSincePublished = true;
        _save = SaveState.Waiting;
        _settling?.Cancel();
        _settling = new CancellationTokenSource();
        CancellationToken settling = _settling.Token;
        _ = Task.Delay(SettleTime, settling).ContinueWith(_ => InvokeAsync(SaveNowAsync), settling, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
        return Task.CompletedTask;
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        await SaveNowAsync();
        return _save == SaveState.Saved;
    }

    private async Task SaveNowAsync()
    {
        if (_planner is not { } planner || _save == SaveState.Saved)
            return;
        if (_settling is { } settling)
            await settling.CancelAsync();
        _save = SaveState.Saving;
        StateHasChanged();
        try
        {
            await Outreach.SaveDraftAsync(Setup.Scope, Setup.Day.Id, planner.Save());
            if (_save == SaveState.Saving)
                _save = SaveState.Saved;
            _draftChangedAt = Time.GetUtcNow().UtcDateTime;
            _saveProblem = null;
        }
        catch (RpcException exception)
        {
            _save = SaveState.Failed;
            _saveProblem = exception.Status.Detail;
        }
        StateHasChanged();
    }

    private void AskToPublish() => _publishing = true;

    private async Task PublishAsync()
    {
        if (_planner is not { } planner)
            return;
        await RunAsync(async () =>
        {
            IReadOnlyList<DayRoute> published = await Outreach.PublishAsync(Setup.Scope, Setup.Day.Id, planner.ToRoutes());
            planner.Published(published);
            _published = published;
            _publishedAt = Time.GetUtcNow().UtcDateTime;
            _changedSincePublished = false;
            _save = SaveState.Waiting;
            await SaveNowAsync();
            _publishing = false;
        });
    }

    private async Task RunAsync(Func<Task> work)
    {
        _busy = true;
        _problem = null;
        try
        {
            await work();
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }
}
