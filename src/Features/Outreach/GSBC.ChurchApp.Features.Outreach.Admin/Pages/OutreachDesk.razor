@page "/outreach"
@page "/outreach/{Slug}"
@inject OutreachDeskClient Outreach
@using GSBC.ChurchApp.Features.Outreach.Admin.Map
@inject IAccess Access

<LiveData TValue="Place" Feeds="Feeds" Load="ScopeAsync" Remember="outreach.scope" FailedTitle="Can't load Outreach right now">
    @if (context.Value.Scope is not { } scope)
    {
        <TitleBand Title="Outreach" Lead="Campaigns, the settings walks run on, and what walkers send in." />
        <EmptyState Icon="footprints" Title="No ministry runs outreach yet"
                    Body="Turn on Outreach in a ministry's Settings, under What it uses. Its leaders then plan outreach here." />
    }
    else
    {
        <OutreachHead Scope="@scope" Tab="Tab" />
        @switch (Tab)
        {
            case OutreachTab.Days:
                <DaysDesk Scope="@scope" Open="@Day" />
                break;
            case OutreachTab.Map:
                <OutreachMap Scope="@scope" Job="@(OutreachMapJobs.Of(Job) ?? OutreachMapJobs.Of(Slug))" Day="@Day" Report="@Report" Area="@Area" />
                break;
            case OutreachTab.Numbers:
                <NumbersDesk Scope="@scope" />
                break;
            case OutreachTab.FollowUps:
                <FollowUpsDesk Scope="@scope" />
                break;
            case OutreachTab.Settings:
                <SettingsDesk Scope="@scope" />
                break;
            default:
                <CampaignsDesk Scope="@scope" />
                break;
        }
    }
</LiveData>

@code {
    private static readonly IReadOnlyList<string> Feeds = [OutreachFeeds.Settings];

    [Parameter] public string? Slug { get; set; }

    [SupplyParameterFromQuery(Name = "day")] public string? Day { get; set; }

    [SupplyParameterFromQuery(Name = "job")] public string? Job { get; set; }

    [SupplyParameterFromQuery(Name = "report")] public string? Report { get; set; }

    [SupplyParameterFromQuery(Name = "area")] public string? Area { get; set; }

    private OutreachTab Tab => OutreachTabs.Of(Slug);

    private sealed record Place(string? Scope);

    private async Task<Place> ScopeAsync() => new(await OutreachScopes.FindAsync(Outreach, Access));
}
