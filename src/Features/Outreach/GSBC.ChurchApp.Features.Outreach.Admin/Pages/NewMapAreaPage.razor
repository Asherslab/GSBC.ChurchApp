@page "/outreach/map-areas/new"
@using GSBC.ChurchApp.Features.Outreach.Maps.Contracts
@using GSBC.ChurchApp.Platform.Ui.Maps
@using Area = GSBC.ChurchApp.Features.Outreach.Maps.Contracts.MapArea
@using MapShape = GSBC.ChurchApp.Platform.Ui.Maps.MapArea
@implements IDisposable
@inject OutreachMapsClient Maps
@inject NavigationManager Navigation

<UnsavedGuard Changed="() => _centre is not null" What="the new map area" Save="SaveBeforeLeavingAsync" />

<TitleBand Title="Add a map area" BackHref="@OutreachLinks.Settings" BackText="Outreach settings"
           Lead="Find the town or suburb, or click the map. The area is cut into regions of about 10 km; once it's built you can switch regions off or add more on its edge." />

<LiveData TValue="RegionList" Feeds="Feeds" Load="Maps.RegionsAsync" FailedTitle="Can't load the maps right now">
    @if (Source(context.Value) is not { } source)
    {
        <EmptyState Icon="map" Title="The first map is still being built" Body="Once the area around the church is built, other areas can be added here." />
    }
    else
    {
        <MapDesk PaneLabel="The new map area">
            <Map>
                <MapView @ref="_map" Source="MapSource.Url(source.Map.Url, source.Attribution)" Label="Map of the new area's regions"
                         Areas="_shapes" Markers="_markers" Frame="_frame" Centre="@Start(context.Value)" Zoom="9" OnTap="TapAsync" Class="area-desk__map">
                    <Overlay>
                        <p class="plan-hint" role="status">@(_centre is null ? "Find a place, or click the map where the area's middle should be" : "Click the map to move the middle")</p>
                    </Overlay>
                </MapView>
                <MapSketch Map="_map" Labels="_labels" />
            </Map>
            <Pane>
                <SearchField Label="Find a town or suburb" Placeholder="A town or suburb in Queensland" Value="@_search" ValueChanged="SearchAsync" AutoFocus="true" />
                @if (_places is null && _centre is null)
                {
                    <p class="field__hint area-desk__hint">Type at least two letters of a town or suburb anywhere in Queensland, or click the map where the area's middle should be. You'll see its squares and how big they are before anything is built.</p>
                }
                @if (_places is { } found)
                {
                    @if (!found.Indexed)
                    {
                        <p class="field__hint area-desk__hint">The list of places is still being made from OpenStreetMap. Click the map where the area should be.</p>
                    }
                    else if (found.Places.Count == 0 && _search.Trim().Length >= 2)
                    {
                        <p class="field__hint area-desk__hint">No town or suburb called that. Try another spelling, or click the map.</p>
                    }
                    else
                    {
                        <div class="area-desk__places" role="list">
                            @foreach (MapPlace place in found.Places)
                            {
                                <ListRow Title="@place.Name" Subtitle="@MapAreaWords.Place(place)" Current="@(Same(place, _place))" OnClick="() => ChooseAsync(place)" />
                            }
                        </div>
                    }
                }
                @if (_centre is not null)
                {
                    <div class="area-desk__fields">
                        <TextField Label="How far around it" Type="number" Min="1" Max="30" Value="@_radius" ValueChanged="RadiusAsync"
                                   Hint="Kilometres each way, 1 to 30. Around the church is 20." Problem="@RadiusProblem" />
                        <TextField Label="Name" @bind-Value="_name" MaxLength="80" Hint="What staff call the place." />
                    </div>
                    <p class="area-desk__estimate" role="status">@EstimateLine</p>
                    @if (_preview is { } shown && !Mapped(shown))
                    {
                        <p class="field__hint area-desk__hint">There's no street map here yet, so the map shows only the places' names. Its own maps come with the build.</p>
                    }
                }
                <Notice Tone="NoticeTone.Warning" Text="@_problem" />
            </Pane>
            <Foot>
                <SaveBar Label="Add and build it" New="true" Busy="_busy" Blocked="@Blocked" OnSave="AddAsync" OnCancel="() => Navigation.NavigateTo(OutreachLinks.Settings)" />
            </Foot>
        </MapDesk>
    }
</LiveData>

@code {
    private static readonly IReadOnlyList<string> Feeds = [OutreachMapsFeeds.Regions];

    private MapView? _map;
    private IReadOnlyList<OutreachRegion> _regions = [];
    private string _search = "", _radius = "10", _name = "";
    private PlaceList? _places;
    private MapPlace? _place;
    private MapPoint? _centre;
    private MapAreaPreview? _preview;
    private IReadOnlyList<MapShape> _shapes = [];
    private IReadOnlyList<MapLabel> _labels = [];
    private IReadOnlyList<MapMarker> _markers = [];
    private MapFrame? _frame;
    private CancellationTokenSource? _previewing;
    private bool _busy, _estimating;
    private string? _problem;

    private string? RadiusProblem => _radius.Trim().Length > 0 && MapAreaWords.Radius(_radius) is null ? "Between 1 and 30 kilometres." : null;

    private string? Blocked => _centre is null ? "Find a place or click the map first."
        : MapAreaWords.Radius(_radius) is null ? "Say how far around it, 1 to 30 km."
        : _name.Trim().Length == 0 ? "Give the area a name."
        : _preview is { } preview && preview.Cells.All(cell => !cell.HasHomes) ? "There are no homes here, so there's nothing to build."
        : null;

    private string EstimateLine
    {
        get
        {
            if (_estimating || _preview is null)
                return "Counting the letterboxes in each square…";
            List<CellEstimate> homes = _preview.Cells.Where(cell => cell.HasHomes).ToList();
            int empty = _preview.Cells.Count - homes.Count;
            string none = empty == 0 ? "" : $" {OutreachWords.Plural(empty, "square has", "squares have")} no homes and isn't made.";
            return $"{OutreachWords.Plural(homes.Count, "region", "regions")} with homes, about {OutreachWords.Plural(homes.Sum(cell => cell.Addresses), "letterbox", "letterboxes")}, "
                   + $"about {MapAreaWords.Megabytes(homes.Sum(cell => cell.Bytes))} for phones in all.{none}";
        }
    }

    private OutreachRegion? Source(RegionList list)
    {
        _regions = list.Regions;
        return MapAreaDrawing.Nearest(list.Regions, _centre ?? Middle(list));
    }

    private static MapPoint Middle(RegionList list) => list.Regions.Count == 0
        ? default
        : new MapPoint(list.Regions.Average(region => (region.Core.South + region.Core.North) / 2), list.Regions.Average(region => (region.Core.West + region.Core.East) / 2));

    private MapPoint? Start(RegionList list) => _centre is null && Source(list) is { } region
        ? new MapPoint((region.Core.South + region.Core.North) / 2, (region.Core.West + region.Core.East) / 2)
        : null;

    private async Task SearchAsync(string text)
    {
        _search = text;
        try
        {
            _places = text.Trim().Length < 2 ? null : await Maps.FindPlacesAsync(text);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
    }

    private Task ChooseAsync(MapPlace place)
    {
        _place = place;
        if (_name.Trim().Length == 0 || _places?.Places.Any(found => found.Name == _name) == true)
            _name = place.Name;
        return CentreAsync(new MapPoint(place.Latitude, place.Longitude), frame: true);
    }

    private Task TapAsync(MapPoint point)
    {
        _place = null;
        return CentreAsync(point, frame: _centre is null);
    }

    private Task RadiusAsync(string radius)
    {
        _radius = radius;
        return _centre is { } centre ? CentreAsync(centre, frame: true) : Task.CompletedTask;
    }

    private async Task CentreAsync(MapPoint centre, bool frame)
    {
        _centre = centre;
        _markers = [new MapMarker(centre, MapMarkerKind.Pin, _place?.Name)];
        if (MapAreaWords.Radius(_radius) is not { } radius)
            return;
        _previewing?.Cancel();
        CancellationTokenSource previewing = _previewing = new CancellationTokenSource();
        _estimating = true;
        _problem = null;
        try
        {
            MapAreaPreview preview = await Maps.PreviewAsync(centre.Lat, centre.Lon, radius);
            if (previewing.IsCancellationRequested)
                return;
            _preview = preview;
            Draw(preview);
            if (frame)
                _frame = MapFrame.Around(_shapes.SelectMany(shape => shape.Points), padding: 48, maxZoom: 13);
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            if (!previewing.IsCancellationRequested)
                _estimating = false;
        }
    }

    private void Draw(MapAreaPreview preview)
    {
        _shapes = preview.Cells.Select(cell => new MapShape(MapAreaDrawing.Ring(preview.Grid.Core(cell.Row, cell.Column)),
            cell.HasHomes ? "--live" : "--ink-3", $"{cell.Row}:{cell.Column}", Dashed: !cell.HasHomes)).ToList();
        List<MapLabel> labels = preview.Cells.Select((cell, index) =>
        {
            MapBounds core = preview.Grid.Core(cell.Row, cell.Column);
            MapPoint corner = new(core.North - (core.North - core.South) * 0.12, core.West + (core.East - core.West) * 0.22);
            string text = cell.HasHomes ? MapAreaWords.Estimate(cell) : "No homes";
            return new MapLabel(corner, text, cell.HasHomes ? "--live" : "--ink-3", index, Short: cell.HasHomes ? MapAreaWords.Megabytes(cell.Bytes) : "No homes");
        }).ToList();
        if (!Mapped(preview))
        {
            double apart = Math.Min(preview.Grid.CellLatitude, preview.Grid.CellLongitude) * 0.22;
            foreach (MapPlace place in preview.Places)
            {
                MapPoint at = new(place.Latitude, place.Longitude);
                if (labels.All(label => Math.Abs(label.Point.Lat - at.Lat) > apart / 2 || Math.Abs(label.Point.Lon - at.Lon) > apart * 1.6))
                    labels.Add(new MapLabel(at, place.Name, "--ink-2", labels.Count, Quiet: true));
            }
        }
        _labels = labels;
    }

    private static bool Same(MapPlace place, MapPlace? other) =>
        other is not null && place.Name == other.Name && place.Latitude.Equals(other.Latitude) && place.Longitude.Equals(other.Longitude);

    private bool Mapped(MapAreaPreview preview) =>
        preview.Cells.Select(cell => preview.Grid.Core(cell.Row, cell.Column))
            .Any(core => _regions.Any(region => region.Bounds.South < core.North && region.Bounds.North > core.South && region.Bounds.West < core.East && region.Bounds.East > core.West));

    private async Task AddAsync()
    {
        if (Blocked is not null || _centre is not { } centre || MapAreaWords.Radius(_radius) is not { } radius)
            return;
        _busy = true;
        _problem = null;
        try
        {
            Area added = await Maps.AddAsync(_name.Trim(), centre.Lat, centre.Lon, radius);
            _centre = null;
            Navigation.NavigateTo(OutreachLinks.MapArea(added.Id));
        }
        catch (RpcException exception)
        {
            _problem = exception.Status.Detail;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> SaveBeforeLeavingAsync()
    {
        if (Blocked is not null)
            return false;
        await AddAsync();
        return _problem is null;
    }

    public void Dispose() => _previewing?.Cancel();
}
