<div class="field @(Problem is null ? "" : "field--problem")">
    <label class="field__label" for="@_id">@Label</label>
    <span class="field__select">
        <select id="@_id" class="field__input" value="@Value" disabled="@Disabled" aria-describedby="@(Hint is null ? null : $"{_id}-hint")" @onchange="ChangeAsync">
            @foreach (FieldOption option in Options)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        <Icon Name="chevron-right" Size="IconSize.Small" Class="field__chevron" />
    </span>
    @if (Hint is not null)
    {
        <span class="field__hint" id="@(_id)-hint">@Hint</span>
    }
    @if (Problem is not null)
    {
        <span class="field__problem">@Problem</span>
    }
</div>

@code {
    private static int _fields;
    private readonly string _id = $"select-field-{Interlocked.Increment(ref _fields)}";

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<FieldOption> Options { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Problem { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task ChangeAsync(ChangeEventArgs change) => ValueChanged.InvokeAsync(change.Value?.ToString() ?? "");
}
