@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

<div class="rich-text-editor">
    <div class="rich-text-toolbar" role="toolbar" aria-label="Formatting">
        <button type="button" data-action="bold" title="Bold (⌘B)" aria-label="Bold" @onclick='() => WrapAsync("**", "bold text")'><strong>B</strong></button>
        <button type="button" data-action="italic" title="Italic (⌘I)" aria-label="Italic" @onclick='() => WrapAsync("*", "italic text")'><em>I</em></button>
        <button type="button" title="Heading" @onclick="() => LinesAsync(LineStyle.Heading)">Heading</button>
        <button type="button" title="Subheading" @onclick="() => LinesAsync(LineStyle.Subheading)">Subheading</button>
        <button type="button" title="Bulleted list" aria-label="Bulleted list" @onclick="() => LinesAsync(LineStyle.Bullets)">• List</button>
        <button type="button" title="Numbered list" aria-label="Numbered list" @onclick="() => LinesAsync(LineStyle.Numbers)">1. List</button>
        <button type="button" title="Quote" @onclick="() => LinesAsync(LineStyle.Quote)">Quote</button>
        <button type="button" data-action="link" title="Link (⌘K)" aria-pressed="@_linking" @onclick="StartLinkAsync">Link</button>
        @if (_canChooseImages)
        {
            <button type="button" title="Picture from the media library" aria-pressed="@_choosingImage" @onclick="StartImageAsync">Picture</button>
        }
    </div>

    @if (_linking)
    {
        <div class="rich-text-panel">
            <label>
                Link to
                <input type="text" inputmode="url" @bind="_href" @bind:event="oninput" placeholder="https://…, /events, mailto:… or tel:…" />
            </label>
            <button type="button" data-action="add-link" @onclick="AddLinkAsync" disabled="@(!LinkTargets.IsSafe(_href.Trim()))">Add link</button>
            <button type="button" class="link" @onclick="() => _linking = false">Cancel</button>
            @if (_href.Trim().Length > 0 && !LinkTargets.IsSafe(_href.Trim()))
            {
                <small class="message">Use a link starting with https://, mailto: or tel:, or a page in the app such as /events.</small>
            }
        </div>
    }

    @if (_choosingImage)
    {
        <div class="rich-text-panel">
            <MediaChooser ImagesOnly="true" OnChosen="InsertImageAsync" OnCancel="() => _choosingImage = false" />
        </div>
    }

    <textarea @ref="_textarea" value="@_markdown" @oninput="TypedAsync" rows="@Rows" aria-label="@Label" placeholder="@Placeholder"></textarea>

    @foreach (string problem in _problems)
    {
        <small class="message">@problem</small>
    }

    <section class="rich-text-preview" aria-label="Preview">
        <span class="rich-text-preview-label">Preview</span>
        @if (_draft.IsEmpty)
        {
            <p class="rich-text-preview-empty">Nothing yet.</p>
        }
        else
        {
            <RichTextView Content="_draft" />
        }
    </section>
</div>

@code {
    private ElementReference _textarea;
    private IJSObjectReference? _module;
    private string _markdown = "";
    private List<MediaRef> _media = [];
    private RichText _draft = new();
    private IReadOnlyList<string> _problems = [];
    private (int Start, int End)? _pendingSelection;
    private bool _linking;
    private bool _choosingImage;
    private bool _canChooseImages;
    private string _href = "";
    private EditorText _beforePanel;

    [Parameter, EditorRequired] public required RichText Value { get; set; }
    [Parameter] public EventCallback<RichText> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 10;
    [Parameter] public int MaximumLength { get; set; } = RichText.MaximumLength;

    protected override void OnInitialized() => _canChooseImages = MediaChooser.IsAvailable(Services);

    protected override void OnParametersSet()
    {
        if (Value.Markdown == _markdown && Value.Media.Select(media => media.Id).SequenceEqual(_media.Select(media => media.Id)))
            return;
        _markdown = Value.Markdown;
        _media = [.. Value.Media];
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/rich-text-editor.js");
            await _module.InvokeVoidAsync("attach", _textarea);
        }

        if (_pendingSelection is { } selection && _module is not null)
        {
            _pendingSelection = null;
            await _module.InvokeVoidAsync("select", _textarea, selection.Start, selection.End);
        }
    }

    private Task TypedAsync(ChangeEventArgs change)
    {
        _markdown = change.Value?.ToString() ?? "";
        return PublishAsync();
    }

    private async Task WrapAsync(string marker, string placeholder) =>
        await ApplyAsync(RichTextEdits.Wrap(await CurrentAsync(), marker, placeholder));

    private async Task LinesAsync(LineStyle style) =>
        await ApplyAsync(RichTextEdits.Lines(await CurrentAsync(), style));

    private async Task StartLinkAsync()
    {
        _beforePanel = await CurrentAsync();
        _choosingImage = false;
        _linking = !_linking;
        string selected = _beforePanel.Selected.Trim();
        _href = LinkTargets.IsSafe(selected) ? selected : "";
    }

    private async Task AddLinkAsync()
    {
        _linking = false;
        await ApplyAsync(RichTextEdits.Link(_beforePanel, _href.Trim(), "link text"));
    }

    private async Task StartImageAsync()
    {
        _beforePanel = await CurrentAsync();
        _linking = false;
        _choosingImage = !_choosingImage;
    }

    private async Task InsertImageAsync(MediaRef media)
    {
        _choosingImage = false;
        if (_media.All(known => known.Id != media.Id))
            _media.Add(media);
        await ApplyAsync(RichTextEdits.Image(_beforePanel, media.Id, media.AltText));
    }

    private async Task<EditorText> CurrentAsync()
    {
        if (_module is null)
            return new EditorText(_markdown, _markdown.Length, _markdown.Length);

        string[] parts = (await _module.InvokeAsync<string>("selection", _textarea)).Split(',', 3);
        string text = parts[2];
        int start = Math.Clamp(int.Parse(parts[0], System.Globalization.CultureInfo.InvariantCulture), 0, text.Length);
        int end = Math.Clamp(int.Parse(parts[1], System.Globalization.CultureInfo.InvariantCulture), start, text.Length);
        return new EditorText(text, start, end);
    }

    private Task ApplyAsync(EditorText edited)
    {
        _markdown = edited.Text;
        _pendingSelection = (edited.Start, edited.End);
        return PublishAsync();
    }

    private async Task PublishAsync()
    {
        Refresh();
        await ValueChanged.InvokeAsync(_draft);
    }

    private void Refresh()
    {
        _draft = new RichText { Markdown = _markdown, Media = [.. _media] };
        _problems = RichTextRules.ProblemsWith(_draft, MaximumLength);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
