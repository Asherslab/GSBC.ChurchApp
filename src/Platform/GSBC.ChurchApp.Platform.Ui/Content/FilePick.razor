@using GSBC.ChurchApp.Platform.Client.Uploads
@using GSBC.ChurchApp.Platform.Contracts.Media
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject FileUploads Uploads
@inject IJSRuntime JS
@inject UiHost Host

@if (Box)
{
    <DropBox Prompt="@Label" Hint="@(_busy ? Keeping : Hint)" Icon="@(ChildContent is null ? ShownIcon : null)" Words="@ChildContent?.Invoke(_busy)" Busy="_busy"
             TakesPaste="TakesPaste" DropOn="@DropOn" Class="@Class">
        <InputFile @ref="_input" OnChange="PickAsync" accept="@Uploads.Accepted(Chosen)" multiple="@Multiple" disabled="@_busy" class="visually-hidden" aria-label="@Label" />
    </DropBox>
}
else
{
    <label class="add-row file-pick @(_busy ? "file-pick--busy" : "") @Class">
        @if (ChildContent is null)
        {
            <Icon Name="@ShownIcon" Size="IconSize.Small" />
            <span>@(_busy ? Keeping : Label)</span>
        }
        else
        {
            @ChildContent(_busy)
        }
        <InputFile @ref="_input" OnChange="PickAsync" accept="@Uploads.Accepted(Chosen)" multiple="@Multiple" disabled="@_busy" class="visually-hidden" aria-label="@Label" />
    </label>
}
<Notice Tone="NoticeTone.Warning" Text="@_problem" />

@code {
    private InputFile? _input;
    private IJSObjectReference? _listening;
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public bool ImagesOnly { get; set; } = true;
    [Parameter] public PickableFiles? Kinds { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public int Limit { get; set; } = 1;
    [Parameter] public Func<string, long, string?>? TooLarge { get; set; }
    [Parameter] public string AltText { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Box { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment<bool>? ChildContent { get; set; }
    [Parameter] public EventCallback<MediaRef> OnPicked { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<ChosenFile>> OnChosen { get; set; }
    [Parameter] public bool TakesPaste { get; set; }
    [Parameter] public string? DropOn { get; set; }

    public ElementReference? Input => _input?.Element;

    private string Keeping => Host.Desktop ? "Adding it…" : "Keeping it on this phone…";

    private string ShownIcon => Icon ?? (Chosen == PickableFiles.Pictures ? "image" : "file");

    private PickableFiles Chosen => Kinds ?? (ImagesOnly ? PickableFiles.Pictures : PickableFiles.PicturesAndDocuments);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Box || (!TakesPaste && DropOn is null) || _input?.Element is not { } input)
            return;
        await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/file-pick.js");
        _listening = await module.InvokeAsync<IJSObjectReference>("listen", input, DropOn, TakesPaste);
    }

    private async Task PickAsync(InputFileChangeEventArgs args)
    {
        if (_input?.Element is not { } input)
            return;
        (_busy, _problem) = (true, null);
        List<string> problems = [];
        List<MediaRef> kept = [];
        try
        {
            IReadOnlyList<IBrowserFile> files = Multiple ? args.GetMultipleFiles(int.MaxValue) : [args.File];
            if (files.Count > Limit)
                problems.Add(Limit == 1 ? "Choose one at a time." : $"Only the first {Limit} were kept; that's the most at once.");
            List<ChosenFile> chosen = [];
            for (int index = 0; index < Math.Min(files.Count, Limit); index++)
            {
                IBrowserFile file = files[index];
                string? contentType = Uploads.ContentTypeOf(file.Name, file.ContentType, Chosen);
                if (contentType is not null && TooLarge?.Invoke(contentType, file.Size) is { } tooLarge)
                {
                    problems.Add(tooLarge);
                    continue;
                }
                if (OnChosen.HasDelegate)
                {
                    if (contentType is null)
                        problems.Add(Uploads.Unusable(file.Name, Chosen));
                    else
                        chosen.Add(new ChosenFile(file, contentType));
                    continue;
                }
                PickedFile picked = await Uploads.KeepAsync(input, file.Name, file.ContentType, Chosen, AltText, index);
                if (picked.Problem is { } problem)
                    problems.Add(problem);
                if (picked.Media is { } media)
                    kept.Add(media);
            }
            if (chosen.Count > 0)
                await OnChosen.InvokeAsync(chosen);
        }
        finally
        {
            _busy = false;
            _problem = problems.Count == 0 ? null : string.Join(" ", problems);
        }
        foreach (MediaRef media in kept)
            await OnPicked.InvokeAsync(media);
    }

    public async ValueTask DisposeAsync()
    {
        if (_listening is null)
            return;
        try
        {
            await _listening.InvokeVoidAsync("dispose");
            await _listening.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
