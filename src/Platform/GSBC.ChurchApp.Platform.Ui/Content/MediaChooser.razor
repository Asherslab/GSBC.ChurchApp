@using GSBC.ChurchApp.Platform.Client.Media
@using GSBC.ChurchApp.Platform.Contracts.Media
@inject IServiceProvider Services

@if (Picker is { } picker)
{
    <Sheet Open="true" OpenChanged="_ => OnCancel.InvokeAsync()" Wide="true" Title="@(FontsOnly ? "Choose a font file" : ImagesOnly ? "Choose a picture" : "Choose a file")">
        @Render(picker)
    </Sheet>
}

@code {
    [Parameter] public bool ImagesOnly { get; set; } = true;
    [Parameter] public bool FontsOnly { get; set; }
    [Parameter] public MediaSizeName Size { get; set; } = MediaSizeName.ForPhones;
    [Parameter] public EventCallback<MediaRef> OnChosen { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public IReadOnlyList<MediaRef>? Offered { get; set; }

    private MediaPicker? Picker => Services.GetService(typeof(MediaPicker)) as MediaPicker;

    private RenderFragment Render(MediaPicker picker) => builder =>
    {
        builder.OpenComponent(0, picker.Component);
        builder.AddComponentParameter(1, MediaPicker.ImagesOnlyParameter, ImagesOnly && !FontsOnly);
        builder.AddComponentParameter(2, MediaPicker.OnPickParameter, EventCallback.Factory.Create<MediaRef>(this, media => OnChosen.InvokeAsync(media)));
        builder.AddComponentParameter(3, MediaPicker.OnCancelParameter, EventCallback.Factory.Create(this, () => OnCancel.InvokeAsync()));
        builder.AddComponentParameter(4, MediaPicker.SizeParameter, Size);
        builder.AddComponentParameter(5, MediaPicker.FontsOnlyParameter, FontsOnly);
        if (Offered is not null)
            builder.AddComponentParameter(6, MediaPicker.OfferedParameter, Offered);
        builder.CloseComponent();
    };

    public static bool IsAvailable(IServiceProvider services) => services.GetService(typeof(MediaPicker)) is MediaPicker;
}
