@using System.Globalization
@using System.Text.Json
@using GSBC.ChurchApp.Platform.Client.Content
@using GSBC.ChurchApp.Platform.Client.Media
@using GSBC.ChurchApp.Platform.Client.Uploads
@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Contracts.Media
@using GSBC.ChurchApp.Platform.Icons
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMediaFiles Files
@inject FileUploads Uploads
@inject UiHost Host
@inject IEnumerable<IAppCardSource> CardSources

<div class="rich-text-field @(Host.Desktop ? "" : "rich-text-field--phone") @Class" data-headings="@(Headings ? "true" : "false")">
    <div class="rich-text-field__bar" role="toolbar" aria-label="Formatting" data-look-scroll data-look-bleed data-folded="@_folded" @ref="_bar">
        @if (Inserts.Count > 0)
        {
            @if (Host.Desktop)
            {
                <Menu Label="Insert" Text="@(InsertIconOnly ? null : "Insert")" Icon="@AppIcons.Insert" Variant="ButtonVariant.Primary" Small="true" Items="InsertItems()" Class="rich-text-field__insert" />
            }
            else
            {
                <Button Small="true" Icon="@AppIcons.Insert" Class="rich-text-field__insert" AriaLabel="Insert" OnClick="() => _sheet = Sheet.Insert">Insert</Button>
            }
        }
        @if (Headings)
        {
            @if (Host.Desktop)
            {
                <Menu Label="Text style" Text="@StyleName(_style)" Icon="@null" Chevron="true" Small="true" AlignStart="true" Items="StyleItems()" Class="rich-text-field__style" />
            }
            else
            {
                @Tool(Format.Style, AppIcons.Heading, "Text style", null, pressed: _style != LineStyle.Text, open: true)
            }
            <span class="rich-text-field__divider" aria-hidden="true"></span>
        }
        @foreach (BarTool tool in BarTools.Where(tool => !Folded(tool)))
        {
            @if (tool.Group > 0 && BarTools.First(other => other.Group == tool.Group && !Folded(other)) == tool)
            {
                <span class="rich-text-field__divider" aria-hidden="true"></span>
            }
            @Tool(tool.Mark, tool.Icon, tool.Name, tool.Shortcut)
        }
        @if (Host.Desktop)
        {
            <Menu Label="More formatting" Small="true" Items="MoreItems()" />
        }
        else
        {
            @Tool(Format.More, AppIcons.More, "More formatting", null, pressed: false, open: true)
        }
    </div>
    @if (_panel == Panel.Link)
    {
        <div class="rich-text-panel">
            <TextField Label="Link to" Value="@_href" ValueChanged="href => _href = href" Type="url" Placeholder="https://…, /events, mailto:… or tel:…"
                       Problem="@(_href.Trim().Length > 0 && !LinkTargets.IsSafe(_href.Trim()) ? "Use a link starting with https://, mailto: or tel:, or a page in the app such as /events." : null)" />
            <div class="rich-text-panel__actions">
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="ClosePanel">Cancel</Button>
                <Button Small="true" Disabled="@(!LinkTargets.IsSafe(_href.Trim()))" OnClick="AddLinkAsync">Add the link</Button>
            </div>
        </div>
    }
    else if (_panel == Panel.VideoLink)
    {
        <div class="rich-text-panel">
            <TextField Label="YouTube or Vimeo link" Value="@_href" ValueChanged="href => _href = href" Type="url" Placeholder="https://www.youtube.com/watch?v=…"
                       Problem="@(_href.Trim().Length > 0 && VideoLink.Of(_href) is null ? "That isn't a YouTube or Vimeo video's address." : null)"
                       Hint="It plays in the post when the phone is online." />
            <div class="rich-text-panel__actions">
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="ClosePanel">Cancel</Button>
                <Button Small="true" Disabled="@(VideoLink.Of(_href) is null)" OnClick="AddVideoLinkAsync">Add the video</Button>
            </div>
        </div>
    }
    else if (_panel == Panel.Look && _cardAt is { } looking)
    {
        <div class="rich-text-panel" role="group" aria-label="How the card looks">
            <Segmented TValue="AppCardLook" Label="How the card looks" Rows="true" Options="Looks" Value="looking.Card.Look" ValueChanged="LookChosenAsync" />
            <div class="rich-text-panel__actions">
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="ClosePanel">Done</Button>
            </div>
        </div>
    }
    else if (_panel == Panel.Table && _table is { } table)
    {
        <div class="rich-text-panel" role="group" aria-label="The table">
            <div class="rich-text-table-editor">
                <table>
                    @for (int row = 0; row < table.Rows.Count; row++)
                    {
                        int r = row;
                        <tr>
                            @for (int column = 0; column < table.Columns; column++)
                            {
                                int c = column;
                                <td>
                                    <input class="rich-text-table-editor__cell @(r == 0 ? "rich-text-table-editor__cell--head" : "")" value="@table.Rows[r][c]"
                                           aria-label="@(r == 0 ? $"Heading {c + 1}" : $"Row {r}, column {c + 1}")" @oninput="change => SetCell(table, r, c, change)" />
                                </td>
                            }
                            <td class="rich-text-table-editor__tool">
                                @if (r > 0 && table.Rows.Count > 2)
                                {
                                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="x" AriaLabel="@($"Take out row {r}")" Tooltip="Take out this row" OnClick="() => table.RemoveRow(r)" />
                                }
                            </td>
                        </tr>
                    }
                    @if (table.Columns > 1)
                    {
                        <tr>
                            @for (int column = 0; column < table.Columns; column++)
                            {
                                int c = column;
                                <td class="rich-text-table-editor__tool">
                                    <Button Variant="ButtonVariant.Quiet" Small="true" Icon="x" AriaLabel="@($"Take out column {c + 1}")" Tooltip="Take out this column" OnClick="() => table.RemoveColumn(c)" />
                                </td>
                            }
                        </tr>
                    }
                </table>
            </div>
            <div class="rich-text-panel__actions">
                <Button Variant="ButtonVariant.Tinted" Small="true" Icon="plus" OnClick="table.AddRow">Add a row</Button>
                <Button Variant="ButtonVariant.Tinted" Small="true" Icon="plus" OnClick="table.AddColumn">Add a column</Button>
                <span class="rich-text-panel__gap"></span>
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="ClosePanel">Cancel</Button>
                <Button Small="true" OnClick="TableDoneAsync">@(_tableAt is null ? "Put it in" : "Done")</Button>
            </div>
        </div>
    }
    else if (_panel == Panel.Emoji)
    {
        <div class="rich-text-panel rich-text-panel--emoji" role="group" aria-label="Emoji">
            <div class="rich-text-emoji">
                @foreach ((string shortcode, string character) in Emoji.Common)
                {
                    <button type="button" class="rich-text-emoji__item" aria-label="@shortcode.Replace('_', ' ')" title="@(":" + shortcode + ":")" @onclick="() => InsertTextAsync(character)">@character</button>
                }
            </div>
            <div class="rich-text-panel__actions">
                <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="ClosePanel">Done</Button>
            </div>
        </div>
    }
    <div class="rich-text-field__editor" @ref="_host"></div>
    @if (Allowed.HasFlag(RichTextMedia.AppCards))
    {
        <div class="rich-text-field__cards" @ref="_shelf" aria-hidden="true">
            @foreach (AppCard card in CardsInText())
            {
                <div @key="card.Directive" data-card="@card.Directive" data-label="@($"A card for {AppCards.WithArticle(card.Kind)}")">
                    <AppCardBlock Card="card" Editing="true" />
                </div>
            }
        </div>
    }
</div>

@if (Host.Desktop && _picture is { } picture)
{
    <Menu Label="@picture.Name" Items="PictureItems(picture)" Anchor="picture.Box" OnClose="PictureClosedAsync" />
}

@if (_picking is { } picking)
{
    <AppCardPicker Kind="picking.Kind" Look="picking.Look" OnChosen="CardChosenAsync" OnCancel="() => _picking = null" />
}

@if (_choosing is { } choosing)
{
    <MediaChooser ImagesOnly="@(choosing.Kinds == PickableFiles.Pictures)" Kinds="choosing.Kinds" UploadTo="UploadTo" OnChosen="ChosenAsync" OnCancel="() => _choosing = null" />
}

@if (!Host.Desktop)
{
    <Sheet Open="_sheet != Sheet.None" OpenChanged="open => _sheet = open ? _sheet : Sheet.None" Title="@SheetTitle">
        @if (_sheet == Sheet.Picture && _picture is { } chosen)
        {
            <div class="rich-text-sheet__rows">
                @foreach (MenuItem item in PictureItems(chosen))
                {
                    <button type="button" class="rich-text-sheet__row @(item.Danger ? "rich-text-sheet__row--danger" : "")" disabled="@item.Disabled" @onclick="() => FromSheetAsync(() => item.OnChoose.InvokeAsync())">
                        <Icon Name="@(item.Icon ?? AppIcons.PlainText)" />
                        <span>@item.Label</span>
                    </button>
                }
            </div>
        }
        else if (_sheet == Sheet.Insert)
        {
            @foreach (IGrouping<string, InsertChoice> group in Inserts.GroupBy(choice => choice.Group))
            {
                <p class="rich-text-sheet__group">@group.Key</p>
                <div class="rich-text-sheet__tiles">
                    @foreach (InsertChoice choice in group)
                    {
                        <button type="button" class="rich-text-sheet__tile" @onclick="() => FromSheetAsync(choice.Action)">
                            <Icon Name="@choice.Icon" />
                            <span>@choice.Label</span>
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div class="rich-text-sheet__rows">
                @foreach (MenuItem item in _sheet == Sheet.Style ? StyleItems() : MoreItems())
                {
                    <button type="button" class="rich-text-sheet__row @(item.Checked ? "is-on" : "")" aria-pressed="@(item.Checked ? "true" : "false")" @onclick="() => FromSheetAsync(() => item.OnChoose.InvokeAsync())">
                        <Icon Name="@(item.Icon ?? AppIcons.PlainText)" />
                        <span>@item.Label</span>
                        @if (item.Detail is not null)
                        {
                            <small>@item.Detail</small>
                        }
                    </button>
                }
            </div>
        }
    </Sheet>
}

@code {
    private readonly Dictionary<string, MediaRef> _waiting = [];
    private readonly List<MediaRef> _media = [];
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<RichTextField>? _self;
    private string _markdown = "";
    private HashSet<string> _active = [];
    private LineStyle _style = LineStyle.Text;
    private Panel _panel;
    private Sheet _sheet;
    private string _href = "";
    private EditorText _before;
    private Choosing? _choosing;
    private string _sentMedia = "";
    private ElementReference _shelf;
    private bool _watchingCards;
    private Picking? _picking;
    private CardAt? _cardAt;
    private string _cardLines = "";
    private MarkdownTable? _table;
    private int? _tableAt;
    private PictureAt? _picture;
    private ElementReference _bar;
    private int _folded;

    [Parameter, EditorRequired] public required RichText Content { get; set; }
    [Parameter] public EventCallback<RichText> ContentChanged { get; set; }
    [Parameter] public RichTextMedia Allowed { get; set; }
    [Parameter] public string Label { get; set; } = "Text";
    [Parameter] public string Placeholder { get; set; } = "Write here. Formatting is in the bar, and pictures, video and files are under Insert.";
    [Parameter] public bool Headings { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public UploadTarget? UploadTo { get; set; }

    private enum Panel
    {
        None,
        Link,
        VideoLink,
        Emoji,
        Look,
        Table,
    }

    private enum Sheet
    {
        None,
        Insert,
        Style,
        More,
        Picture,
    }

    private sealed record Choosing(PickableFiles Kinds, string Mode, int At, int Index = 0);

    private sealed record PictureAt(int At, int Index, int Count, MenuAnchor Box)
    {
        public string Name => $"Picture {Index + 1} of {Count}";
    }

    private sealed record Picking(AppCardKind Kind, AppCardLook Look, int? At);

    private sealed record CardAt(AppCard Card, int At);

    private static readonly IReadOnlyList<SegmentOption<AppCardLook>> Looks =
    [
        new(AppCardLook.Rule, "Side rule", Detail: "Quiet, part of the text, its actions as words"),
        new(AppCardLook.Line, "Timetable line", Detail: "The date or picture at the left, with buttons"),
        new(AppCardLook.Box, "Box", Detail: "Its picture across the top and a wide main button"),
    ];

    private sealed record InsertChoice(string Group, string Label, string Icon, string? Detail, Func<Task> Action);

    private static class Format
    {
        public const string Bold = "bold", Italic = "italic", Strike = "strike", Highlight = "highlight", Code = "code", Sub = "sub", Sup = "sup",
            Bullets = "bullets", Numbers = "numbers", Quote = "quote", Link = "link", Text = "text", H1 = "h1", H2 = "h2", H3 = "h3",
            Style = "style", More = "more";
    }

    private const int NeverFolds = int.MaxValue;

    private sealed record BarTool(string Mark, string Icon, string Name, string Shortcut, int Group, int FoldOrder);

    private static readonly IReadOnlyList<BarTool> BarTools =
    [
        new(Format.Bold, AppIcons.Bold, "Bold", "⌘B", 0, NeverFolds),
        new(Format.Italic, AppIcons.Italic, "Italic", "⌘I", 0, NeverFolds),
        new(Format.Strike, AppIcons.Strikethrough, "Strikethrough", "⌘⇧X", 0, 2),
        new(Format.Highlight, AppIcons.Highlight, "Highlight", "⌘⇧H", 0, 1),
        new(Format.Bullets, AppIcons.BulletedList, "Bulleted list", "⌘⇧8", 1, 5),
        new(Format.Numbers, AppIcons.NumberedList, "Numbered list", "⌘⇧7", 1, 4),
        new(Format.Quote, AppIcons.Quote, "Quote", "⌘⇧9", 1, 3),
        new(Format.Link, AppIcons.Link, "Link", "⌘K", 1, 6),
        new(Format.Code, AppIcons.Code, "Code", "⌘E", 1, 0),
    ];

    private static readonly int Foldable = BarTools.Count(tool => tool.FoldOrder != NeverFolds);

    private bool Folded(BarTool tool) => tool.FoldOrder < _folded;

    private bool InsertIconOnly => _folded > Foldable;

    [JSInvokable]
    public Task FoldAsync(int count)
    {
        int folded = Math.Clamp(count, 0, Foldable + 1);
        if (folded == _folded)
            return Task.CompletedTask;
        _folded = folded;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static readonly IReadOnlyDictionary<string, (string Marker, string Placeholder)> Wraps = new Dictionary<string, (string, string)>
    {
        [Format.Bold] = ("**", "bold text"),
        [Format.Italic] = ("*", "italic text"),
        [Format.Strike] = ("~~", "struck out"),
        [Format.Highlight] = ("==", "highlighted"),
        [Format.Code] = ("`", "code"),
        [Format.Sub] = ("~", "2"),
        [Format.Sup] = ("^", "2"),
    };

    public IReadOnlyList<MediaRef> WaitingFiles()
    {
        HashSet<string> used = [.. RichTextParser.Parse(_markdown).MediaIds];
        return _waiting.Where(entry => used.Contains(entry.Key)).Select(entry => entry.Value).ToList();
    }

    private string SheetTitle => _sheet switch
    {
        Sheet.Insert => "Insert",
        Sheet.Picture => _picture?.Name ?? "",
        Sheet.Style => "Text style",
        _ => "More formatting",
    };

    private IReadOnlyList<InsertChoice> Inserts =>
    [
        .. Allowed.HasFlag(RichTextMedia.Pictures) ? [new InsertChoice("Pictures and media", "Picture", AppIcons.Picture, "From the library or upload", () => Choose(PickableFiles.Pictures))] : Array.Empty<InsertChoice>(),
        .. Allowed.HasFlag(RichTextMedia.Video) ? [new InsertChoice("Pictures and media", "Video", AppIcons.Video, "Uploaded", () => Choose(PickableFiles.Videos))] : Array.Empty<InsertChoice>(),
        .. Allowed.HasFlag(RichTextMedia.VideoLinks) ? [new InsertChoice("Pictures and media", "Video link", AppIcons.VideoLink, "YouTube, Vimeo", () => OpenPanel(Panel.VideoLink))] : Array.Empty<InsertChoice>(),
        .. Allowed.HasFlag(RichTextMedia.Files) ? [new InsertChoice("Pictures and media", "File", AppIcons.File, null, () => Choose(PickableFiles.Documents))] : Array.Empty<InsertChoice>(),
        .. Allowed.HasFlag(RichTextMedia.Layout)
            ? [
                new InsertChoice("Layout", "Split into cards", AppIcons.CardSplit, null, () => BlockAsync(RichTextParser.CardSplit)),
                new InsertChoice("Layout", "Line across", AppIcons.LineAcross, null, () => BlockAsync("---")),
                new InsertChoice("Layout", "Table", AppIcons.Table, null, NewTableAsync),
                new InsertChoice("Layout", "Code block", AppIcons.CodeBlock, null, () => BlockAsync("```\n\n```", 4)),
                new InsertChoice("In the text", "Footnote", AppIcons.Footnote, null, FootnoteAsync),
                new InsertChoice("In the text", "Emoji", AppIcons.Emoji, null, () => OpenPanel(Panel.Emoji)),
            ]
            : Array.Empty<InsertChoice>(),
        .. Allowed.HasFlag(RichTextMedia.AppCards)
            ? AppCards.All.Where(kind => CardSources.Any(source => source.Kinds.Contains(kind)))
                .Select(kind => new InsertChoice("From the app", AppCards.Title(kind), CardIcon(kind), null, () => PickCardAsync(kind)))
            : [],
    ];

    private static string CardIcon(AppCardKind kind) => kind switch
    {
        AppCardKind.Event => AppIcons.Calendar,
        AppCardKind.Sermon => AppIcons.Sermons,
        AppCardKind.Ministry => AppIcons.Ministries,
        _ => AppIcons.LifeGroups,
    };

    private IReadOnlyList<AppCard> CardsInText() =>
        RichTextParser.Parse(_markdown).AppCards.DistinctBy(card => card.Directive).ToList();

    private IReadOnlyList<MenuItem> InsertItems()
    {
        List<MenuItem> items = [];
        string? group = null;
        foreach (InsertChoice choice in Inserts)
        {
            items.Add(new MenuItem(choice.Label, EventCallback.Factory.Create(this, choice.Action), choice.Icon, choice.Detail, StartsGroup: choice.Group != group, GroupTitle: choice.Group != group ? choice.Group : null));
            group = choice.Group;
        }
        return items;
    }

    private IReadOnlyList<MenuItem> StyleItems() =>
    [
        this.Item("Text", () => FormatAsync(Format.Text), AppIcons.PlainText, @checked: _style == LineStyle.Text),
        this.Item("Heading 1", () => FormatAsync(Format.H1), AppIcons.Heading, @checked: _style == LineStyle.Heading1),
        this.Item("Heading 2", () => FormatAsync(Format.H2), AppIcons.Heading, @checked: _style == LineStyle.Heading2),
        this.Item("Heading 3", () => FormatAsync(Format.H3), AppIcons.Heading, @checked: _style == LineStyle.Heading3),
    ];

    private IReadOnlyList<MenuItem> PictureItems(PictureAt picture) =>
    [
        this.Item("Move earlier", () => PictureAsync("earlier", picture), AppIcons.MoveEarlier, disabled: picture.Index == 0),
        this.Item("Move later", () => PictureAsync("later", picture), AppIcons.MoveLater, disabled: picture.Index == picture.Count - 1),
        this.Item("Replace", () => _choosing = new Choosing(PickableFiles.Pictures, "replace", picture.At, picture.Index), AppIcons.ReplaceIt),
        this.Item("Take this picture out", () => PictureAsync("remove", picture), AppIcons.TakeOut, danger: true, startsGroup: true),
    ];

    private async Task PictureAsync(string action, PictureAt picture)
    {
        _picture = null;
        if (_editor is not null)
            await _editor.InvokeVoidAsync("picture", action, picture.At, picture.Index);
    }

    private async Task PictureClosedAsync()
    {
        _picture = null;
        if (_editor is not null)
            await _editor.InvokeVoidAsync("pictureClosed");
    }

    [JSInvokable]
    public Task PictureMenuAsync(int at, int index, int count, double left, double top, double width, double height)
    {
        _picture = new PictureAt(at, index, count, new MenuAnchor(left, top, width, height));
        if (!Host.Desktop)
            _sheet = Sheet.Picture;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private IReadOnlyList<MenuItem> MoreItems() =>
    [
        .. BarTools.Where(Folded).Select(tool => this.Item(tool.Name, () => FormatAsync(tool.Mark), tool.Icon, tool.Shortcut, @checked: IsOn(tool.Mark))),
        this.Item("Superscript", () => FormatAsync(Format.Sup), AppIcons.Superscript, "x²", @checked: _active.Contains(Format.Sup), startsGroup: _folded > 0),
        this.Item("Subscript", () => FormatAsync(Format.Sub), AppIcons.Subscript, "H₂O", @checked: _active.Contains(Format.Sub)),
    ];

    private bool IsOn(string format) => format == Format.Link ? _panel == Panel.Link : _active.Contains(format);

    private static string StyleName(LineStyle style) => style switch
    {
        LineStyle.Heading1 => "Heading 1",
        LineStyle.Heading2 => "Heading 2",
        LineStyle.Heading3 => "Heading 3",
        _ => "Text",
    };

    private RenderFragment Tool(string format, string icon, string name, string? shortcut, bool? pressed = null, bool open = false) =>
        @<Button Variant="ButtonVariant.Quiet" Small="true" Icon="@icon" Class="rich-text-field__tool" AriaLabel="@name" Tooltip="@(shortcut is null ? name : $"{name} ({shortcut})")"
                 Pressed="@(open ? null : pressed ?? IsOn(format))" Expanded="@(open ? false : null)" OnClick="() => FormatAsync(format)" />;

    protected override async Task OnParametersSetAsync()
    {
        foreach (MediaRef media in Content.Media.Where(media => _media.All(known => known.Id != media.Id)))
            _media.Add(media);
        if (Content.Markdown != _markdown)
        {
            _markdown = Content.Markdown;
            if (_editor is not null)
                await _editor.InvokeVoidAsync("setValue", _markdown);
        }
        await SendMediaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/rich-text-field.js");
        string emoji = Json(writer =>
        {
            foreach ((string code, string character) in Emoji.Common)
                writer.WriteString(code, character);
        });
        _editor = await _module.InvokeAsync<IJSObjectReference>("attach", _host, _self, _markdown, Label, Placeholder, emoji);
        if (Host.Desktop)
            await _editor.InvokeVoidAsync("foldBar", _bar);
        _sentMedia = "";
        await SendMediaAsync();
        if (Allowed.HasFlag(RichTextMedia.AppCards))
        {
            await _editor.InvokeVoidAsync("watchCards", _shelf);
            _watchingCards = true;
        }
    }

    private async Task SendMediaAsync()
    {
        if (_editor is null)
            return;
        List<(MediaRef Media, string? Url)> shown = [];
        foreach (MediaRef media in _media)
            shown.Add((media, media.IsImage || media.IsVideo ? await SourceOfAsync(media) : null));
        string json = Json(writer =>
        {
            foreach ((MediaRef media, string? url) in shown)
            {
                writer.WriteStartObject(media.Id);
                writer.WriteString("kind", RichTextRules.KindOf(media) switch
                {
                    RichTextMedia.Pictures => "picture",
                    RichTextMedia.Video => "video",
                    RichTextMedia.Audio => "audio",
                    _ => "file",
                });
                writer.WriteString("url", url);
                writer.WriteString("name", media.AltText.Length > 0 ? media.AltText : media.FileName);
                writer.WriteString("path", PathOf(media));
                writer.WriteString("size", FileLine(media));
                writer.WriteEndObject();
            }
        });
        if (json == _sentMedia)
            return;
        _sentMedia = json;
        await _editor.InvokeVoidAsync("setMedia", json);
    }

    private static string Json(Action<Utf8JsonWriter> write)
    {
        using MemoryStream buffer = new();
        using (Utf8JsonWriter writer = new(buffer))
        {
            writer.WriteStartObject();
            write(writer);
            writer.WriteEndObject();
        }
        return System.Text.Encoding.UTF8.GetString(buffer.ToArray());
    }

    private async Task<string?> SourceOfAsync(MediaRef media)
    {
        if (media.Url is { } url && url.StartsWith("data:", StringComparison.Ordinal))
            return url;
        try
        {
            return await Files.SourceOfAsync(media.At(MediaSizeName.ForPhones)) ?? media.Url;
        }
        catch (Exception exception) when (exception is Grpc.Core.RpcException or HttpRequestException or JSException)
        {
            return media.Url;
        }
    }

    private string PathOf(MediaRef media)
    {
        if (_waiting.ContainsKey(media.Id))
            return $"On this phone: {media.FileName}. It's sent with your save.";
        string name = media.FileName.Length > 0 ? media.FileName : media.AltText;
        return media.Folder.Length > 0 ? $"~/{media.Folder}/{name}" : $"~/{name}";
    }

    private static string FileLine(MediaRef media)
    {
        string extension = Path.GetExtension(media.FileName).TrimStart('.').ToUpperInvariant();
        string weight = media.Bytes > 0 ? MediaSizes.Weight(media.Bytes) : "";
        return string.Join(" · ", new[] { extension, weight }.Where(part => part.Length > 0));
    }

    [JSInvokable]
    public async Task ChangedAsync(string markdown)
    {
        if (markdown == _markdown)
            return;
        _markdown = markdown;
        await ContentChanged.InvokeAsync(Current());
        string lines = string.Join('\n', CardsInText().Select(card => card.Directive));
        if (_watchingCards && lines != _cardLines)
        {
            _cardLines = lines;
            StateHasChanged();
        }
    }

