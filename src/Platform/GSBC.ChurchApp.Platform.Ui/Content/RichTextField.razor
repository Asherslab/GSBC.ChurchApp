        await ApplyAsync(RichTextEdits.Link(_before, _href.Trim(), "link text"));
    }

    private async Task AddVideoLinkAsync()
    {
        ClosePanel();
        if (VideoLink.Of(_href) is { } video)
            await ApplyAsync(RichTextEdits.Block(_before, RichTextEdits.VideoLinkLine(video, "")));
    }

    private async Task InsertTextAsync(string text) => await ApplyAsync(RichTextEdits.Insert(await CurrentAsync(), text));

    private async Task BlockAsync(string block, int? caret = null) => await ApplyAsync(RichTextEdits.Block(await CurrentAsync(), block, caret));

    private async Task FootnoteAsync() => await ApplyAsync(RichTextEdits.Footnote(await CurrentAsync()));

    private async Task<EditorText> CurrentAsync()
    {
        if (_editor is null)
            return new EditorText(_markdown, _markdown.Length, _markdown.Length);
        string text = await _editor.InvokeAsync<string>("text");
        string[] range = (await _editor.InvokeAsync<string>("selection")).Split(',');
        int start = Math.Clamp(int.Parse(range[0], CultureInfo.InvariantCulture), 0, text.Length);
        int end = Math.Clamp(int.Parse(range[1], CultureInfo.InvariantCulture), start, text.Length);
        return new EditorText(text, start, end);
    }

    private async Task ApplyAsync(EditorText edited)
    {
        if (_editor is not null)
            await _editor.InvokeVoidAsync("apply", edited.Text, edited.Start, edited.End);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("dispose");
                await _editor.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
