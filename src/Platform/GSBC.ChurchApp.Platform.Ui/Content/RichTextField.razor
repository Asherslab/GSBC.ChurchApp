    [JSInvokable]
    public Task MediaWantedAsync(string mode, int at, int index)
    {
        _choosing = new Choosing(mode == "add" ? PickableFiles.Pictures : KindAt(at), mode, at, index);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private PickableFiles KindAt(int at)
    {
        return RichTextParser.Parse(LineAt(at)).MediaIds.FirstOrDefault() is { } id && _media.FirstOrDefault(known => known.Id == id) is { } media
            ? media.IsVideo ? PickableFiles.Videos : media.IsImage ? PickableFiles.Pictures : PickableFiles.Documents
            : PickableFiles.Pictures;
    }

    [JSInvokable]
    public async Task FormatAsync(string format)
    {
        if (_editor is null)
            return;
        switch (format)
        {
            case Format.Style:
                _sheet = Sheet.Style;
                StateHasChanged();
                break;
            case Format.More:
                _sheet = Sheet.More;
                StateHasChanged();
                break;
            case Format.Link:
                if (_panel == Panel.Link)
                {
                    ClosePanel();
                    break;
                }
                await OpenPanel(Panel.Link);
                string selected = _before.Selected.Trim();
                _href = LinkTargets.IsSafe(selected) ? selected : "";
                break;
            case var wrap when Wraps.TryGetValue(wrap, out (string Marker, string Placeholder) marks):
                if (!await _editor.InvokeAsync<bool>("toggleOff", format))
                    await ApplyAsync(RichTextEdits.Wrap(await CurrentAsync(), marks.Marker, marks.Placeholder));
                break;
            default:
                await ApplyAsync(RichTextEdits.Lines(await CurrentAsync(), format switch
                {
                    Format.Text => LineStyle.Text,
                    Format.H1 => LineStyle.Heading1,
                    Format.H2 => LineStyle.Heading2,
                    Format.H3 => LineStyle.Heading3,
                    Format.Numbers => LineStyle.Numbers,
                    Format.Quote => LineStyle.Quote,
                    _ => LineStyle.Bullets,
                }));
                break;
        }
    }

    private async Task FromSheetAsync(Func<Task> action)
    {
        _sheet = Sheet.None;
        await action();
    }

    private async Task OpenPanel(Panel panel)
    {
        _before = await CurrentAsync();
        _href = "";
        _panel = panel;
        StateHasChanged();
    }

    private void ClosePanel() => _panel = Panel.None;

    private async Task Choose(PickableFiles kinds)
    {
        _before = await CurrentAsync();
        _choosing = new Choosing(kinds, "insert", 0);
    }

    private async Task ChosenAsync(MediaRef chosen)
    {
        Choosing? choosing = _choosing;
        _choosing = null;
        if (choosing is null || _editor is null)
            return;
        MediaRef media = chosen;
        if (Uploads.HashOf(chosen) is { } hash)
        {
            string id = UploadedMedia.PlaceholderId(hash);
            _waiting[id] = chosen;
            media = new MediaRef { Id = id, ContentType = chosen.ContentType, Bytes = chosen.Bytes, Url = chosen.Url, FileName = chosen.FileName, AltText = chosen.AltText };
        }
        _media.RemoveAll(known => known.Id == media.Id);
        _media.Add(media);
        await SendMediaAsync();
        string line = RichTextEdits.MediaLine(media.Id, media.AltText.Length > 0 ? media.AltText : media.FileName);
        if (choosing.Mode == "insert")
            await ApplyAsync(RichTextEdits.MediaLines(_before, [line]));
        else
            await _editor.InvokeVoidAsync("placeMedia", choosing.Mode, choosing.At, line, choosing.Index);
    }

    private async Task AddLinkAsync()
