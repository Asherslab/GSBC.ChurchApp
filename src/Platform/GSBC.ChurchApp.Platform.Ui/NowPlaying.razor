@using GSBC.ChurchApp.Platform.Client.Audio
@implements IAsyncDisposable
@inject IAudioPlayer Player
@inject Shell Shell
@inject NowPlayingBar Bar
@inject NavigationManager Navigation

@if (Player.State.Item is { } item)
{
    if (!Bar.Hidden)
    {
        <div class="now-playing @(State.Playing ? "is-playing" : "")" @ref="_bar">
            <button type="button" class="now-playing__open" @onclick="OpenSheet" aria-label="@($"Now playing: {item.Title}. Open the player")">
                <AudioArt Item="item" Class="now-playing__art" />
                <span class="now-playing__words">
                    <span class="now-playing__title">@item.Title</span>
                    <span class="now-playing__line">@Line(item)</span>
                </span>
            </button>
            <button type="button" class="now-playing__toggle" aria-label="@(State.Playing ? "Pause" : "Play")" @onclick="ToggleAsync">
                <Icon Name="@(State.Playing ? "pause" : "play")" />
            </button>
            <i class="now-playing__progress" style="width: @Percent(State)%" aria-hidden="true"></i>
        </div>
    }

    <Sheet Open="_sheet" OpenChanged="open => _sheet = open" Label="Now playing">
        <div class="player-sheet">
            <AudioArt Item="item" Class="player-sheet__art" />
            <h2 class="player-sheet__title">@item.Title</h2>
            <p class="player-sheet__by">@string.Join(" · ", new[] { item.Artist, item.Album }.Where(part => part.Length > 0))</p>
            @if (item.Link is { Length: > 0 } link)
            {
                <button type="button" class="text-link" @onclick="() => GoTo(link)">About this sermon<Icon Name="chevron-right" Size="IconSize.Small" /></button>
            }

            <div class="player-sheet__scrub">
                <input type="range" min="0" max="@Math.Max(1, State.Duration).ToString("0")" step="1" value="@ShownPosition.ToString("0")"
                       aria-label="Position" aria-valuetext="@($"{Clock(ShownPosition)} of {Clock(State.Duration)}")"
                       style="--filled: @Percent(State with { Position = ShownPosition })%"
                       @oninput="Scrubbing" @onchange="ScrubbedAsync" />
                <span class="player-sheet__times"><span>@Clock(ShownPosition)</span><span>-@Clock(Math.Max(0, State.Duration - ShownPosition))</span></span>
            </div>

            <div class="player-sheet__transport">
                <button type="button" class="player-sheet__skip" aria-label="Back 15 seconds" @onclick="() => Player.SkipAsync(-15)"><Icon Name="rotate-ccw" /><span>15</span></button>
                <button type="button" class="player-sheet__play" aria-label="@(State.Playing ? "Pause" : "Play")" @onclick="ToggleAsync">
                    <Icon Name="@(State.Playing ? "pause" : "play")" />
                </button>
                <button type="button" class="player-sheet__skip" aria-label="Forward 30 seconds" @onclick="() => Player.SkipAsync(30)"><Icon Name="rotate-cw" /><span>30</span></button>
            </div>

            @if (State.Problem is { } problem)
            {
                <p class="player-sheet__problem" role="status">@problem</p>
            }

            <div class="player-sheet__options">
                <div class="player-sheet__option">
                    <span class="player-sheet__label">Speed</span>
                    <div class="chips" role="group" aria-label="Speed">
                        @foreach (double speed in Speeds)
                        {
                            <button type="button" class="chip @(Math.Abs(State.Rate - speed) < 0.01 ? "is-on" : "")" aria-pressed="@(Math.Abs(State.Rate - speed) < 0.01)"
                                    @onclick="() => Player.SetRateAsync(speed)">@($"{speed:0.##}×")</button>
                        }
                    </div>
                </div>
                <div class="player-sheet__option">
                    <span class="player-sheet__label">Sleep timer@(SleepNote is { } note ? $" · {note}" : "")</span>
                    <div class="chips" role="group" aria-label="Sleep timer">
                        <button type="button" class="chip @(NoSleep ? "is-on" : "")" aria-pressed="@NoSleep" @onclick="() => Player.SleepAsync(SleepTimer.Off)">Off</button>
                        @foreach (int minutes in SleepMinutes)
                        {
                            <button type="button" class="chip" @onclick="() => Player.SleepAsync(SleepTimer.After(minutes))">@($"{minutes} min")</button>
                        }
                        <button type="button" class="chip @(State.SleepAtEnd ? "is-on" : "")" aria-pressed="@State.SleepAtEnd" @onclick="() => Player.SleepAsync(SleepTimer.AtTheEnd)">At the end</button>
                    </div>
                </div>
            </div>

            @if (Player.UpNext.FirstOrDefault() is { } next)
            {
                <p class="player-sheet__next"><span>Up next</span> @next.Title</p>
            }

            <button type="button" class="text-link player-sheet__hide" @onclick="() => HidePlayer(item)">Hide the player<Icon Name="chevron-down" Size="IconSize.Small" /></button>
        </div>
    </Sheet>
}

@code {
    private static readonly IReadOnlyList<double> Speeds = [0.8, 1, 1.2, 1.5, 1.75, 2];
    private static readonly IReadOnlyList<int> SleepMinutes = [15, 30, 45];
    private bool _sheet;
    private double? _scrubbing;
    private bool _wasPlaying;
    private ElementReference _bar;
    private IJSObjectReference? _swipe;
    private DotNetObjectReference<NowPlaying>? _receiver;

    private AudioState State => Player.State;

    private double ShownPosition => _scrubbing ?? State.Position;

    private bool NoSleep => State.SleepAt is null && !State.SleepAtEnd;

    private string? SleepNote => State.SleepAt is { } at ? $"stops at {at.ToLocalTime():h:mm tt}".ToLowerInvariant() : State.SleepAtEnd ? "stops at the end" : null;

    protected override void OnInitialized()
    {
        Player.Changed += OnChanged;
        Bar.Changed += OnBarChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool shown = Player.State.Item is not null && !Bar.Hidden;
        if (shown && _swipe is null)
        {
            _receiver ??= DotNetObjectReference.Create(this);
            _swipe = await Shell.SwipeAwayAsync(_bar, _receiver);
        }
        else if (!shown && _swipe is not null)
        {
            await StopSwipeAsync();
        }
    }

    private void OnChanged()
    {
        if (Bar.HiddenFor is { } hidden && (State.Item?.Id != hidden || State.Playing && !_wasPlaying))
            Bar.Show();
        _wasPlaying = State.Playing;
        InvokeAsync(StateHasChanged);
    }

    private void OnBarChanged() => InvokeAsync(StateHasChanged);

    private void HidePlayer(AudioItem item)
    {
        _sheet = false;
        Bar.Hide(item.Id);
    }

    [JSInvokable]
    public void OnSwipedAway()
    {
        if (State.Item is { } item)
            Bar.Hide(item.Id);
    }

    private async Task StopSwipeAsync()
    {
        if (_swipe is null)
            return;
        try
        {
            await _swipe.InvokeVoidAsync("dispose");
            await _swipe.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _swipe = null;
    }

    private async Task ToggleAsync()
    {
        await Shell.HapticAsync();
        await (State.Playing ? Player.PauseAsync() : Player.PlayAsync());
    }

    private void OpenSheet() => _sheet = true;

    private void GoTo(string link)
    {
        _sheet = false;
        Navigation.NavigateTo(link.TrimStart('/'));
    }

    private void Scrubbing(ChangeEventArgs change) =>
        _scrubbing = double.TryParse(change.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out double position) ? position : null;

    private async Task ScrubbedAsync(ChangeEventArgs change)
    {
        if (double.TryParse(change.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out double position))
            await Player.SeekAsync(position);
        _scrubbing = null;
    }

    private static string Line(AudioItem item) => item.Artist;

    private static double Percent(AudioState state) => state.Duration > 0 ? Math.Clamp(state.Position / state.Duration * 100, 0, 100) : 0;

    public static string Clock(double seconds)
    {
        TimeSpan time = TimeSpan.FromSeconds(Math.Max(0, Math.Floor(seconds)));
        return time.TotalHours >= 1 ? time.ToString(@"h\:mm\:ss") : time.ToString(@"m\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        Player.Changed -= OnChanged;
        Bar.Changed -= OnBarChanged;
        await StopSwipeAsync();
        _receiver?.Dispose();
    }
}
