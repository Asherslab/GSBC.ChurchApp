@using System.Globalization
@using GSBC.ChurchApp.Platform.Client.Audio
@implements IDisposable
@inject IAudioPlayer Player
@inject Shell Shell

@if (Player.State.Item is not null)
{
    <div class="audio-controls @Class">
        <input type="range" class="audio-controls__scrub" min="0" max="@Math.Max(1, State.Duration).ToString("0", CultureInfo.InvariantCulture)" step="1"
               value="@ShownPosition.ToString("0", CultureInfo.InvariantCulture)"
               aria-label="Position" aria-valuetext="@($"{Clock(ShownPosition)} of {Clock(State.Duration)}")"
               style="--filled: @Percent(ShownPosition)%"
               @oninput="Scrubbing" @onchange="ScrubbedAsync" />
        <div class="audio-controls__times">
            <span>@Clock(ShownPosition)</span>
            <button type="button" class="audio-controls__speed" aria-label="@($"Speed {Speed(State.Rate)}. Change the speed")" @onclick="NextSpeedAsync">@Speed(State.Rate)</button>
            <span>-@Clock(Math.Max(0, State.Duration - ShownPosition))</span>
        </div>
        <div class="audio-controls__transport">
            <button type="button" class="audio-controls__skip" aria-label="Back 15 seconds" @onclick="() => Player.SkipAsync(-15)"><Icon Name="rotate-ccw" /><span>15</span></button>
            <button type="button" class="audio-controls__play" aria-label="@(State.Playing ? "Pause" : "Play")" @onclick="ToggleAsync">
                <Icon Name="@(State.Playing ? "pause" : "play")" />
            </button>
            <button type="button" class="audio-controls__skip" aria-label="Forward 30 seconds" @onclick="() => Player.SkipAsync(30)"><Icon Name="rotate-cw" /><span>30</span></button>
        </div>
        @if (State.Problem is { } problem)
        {
            <p class="audio-controls__problem" role="status">@problem</p>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<double> Speeds = [0.8, 1, 1.2, 1.5, 1.75, 2];

    private double? _scrubbing;

    [Parameter] public string? Class { get; set; }

    private AudioState State => Player.State;

    private double ShownPosition => _scrubbing ?? State.Position;

    protected override void OnInitialized() => Player.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleAsync()
    {
        await Shell.HapticAsync();
        await (State.Playing ? Player.PauseAsync() : Player.PlayAsync());
    }

    private Task NextSpeedAsync() => Player.SetRateAsync(NextSpeed(State.Rate));

    private void Scrubbing(ChangeEventArgs change) =>
        _scrubbing = double.TryParse(change.Value?.ToString(), CultureInfo.InvariantCulture, out double position) ? position : null;

    private async Task ScrubbedAsync(ChangeEventArgs change)
    {
        if (double.TryParse(change.Value?.ToString(), CultureInfo.InvariantCulture, out double position))
            await Player.SeekAsync(position);
        _scrubbing = null;
    }

    private double Percent(double position) => State.Duration > 0 ? Math.Clamp(position / State.Duration * 100, 0, 100) : 0;

    private static double NextSpeed(double rate) => Speeds.FirstOrDefault(speed => speed > rate + 0.01, Speeds[0]);

    private static string Speed(double rate) => $"{rate.ToString("0.##", CultureInfo.InvariantCulture)}×";

    public static string Clock(double seconds)
    {
        TimeSpan time = TimeSpan.FromSeconds(Math.Max(0, Math.Floor(seconds)));
        return time.TotalHours >= 1 ? time.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture) : time.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    public void Dispose() => Player.Changed -= OnChanged;
}
