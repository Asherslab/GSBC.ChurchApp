@implements IDisposable
@inject UnsavedChanges Unsaved

<NavigationLock OnBeforeInternalNavigation="CheckAsync" ConfirmExternalNavigation="HasChanges" />

<Sheet Open="_answer is not null" OpenChanged="open => { if (!open) Answer(false); }" Title="@(Save is null ? "Leave without saving?" : "Save your changes?")"
       Lead="@(Failed ? $"{Capital(What)} couldn't be saved. If you leave now, the changes are lost." : $"You've changed {What} and haven't saved yet. If you leave now, the changes are lost.")">
    <ChildContent>
        <Notice Tone="NoticeTone.Warning" Text="@_problem" />
    </ChildContent>
    <Actions>
        @if (Save is not null)
        {
            <Button Block="true" Busy="_busy" OnClick="SaveAndGoAsync">@(Failed ? "Try saving again" : "Save and go on")</Button>
        }
        <Button Block="true" Variant="@(Save is null ? ButtonVariant.Danger : ButtonVariant.Quiet)" Disabled="_busy" OnClick="() => Answer(true)">Discard the changes</Button>
        <Button Block="true" Variant="ButtonVariant.Quiet" Disabled="_busy" OnClick="() => Answer(false)">Stay here</Button>
    </Actions>
</Sheet>

@code {
    private TaskCompletionSource<bool>? _answer;
    private bool _busy;
    private string? _problem;

    [Parameter, EditorRequired] public required Func<bool> Changed { get; set; }
    [Parameter, EditorRequired] public required string What { get; set; }
    [Parameter] public Func<Task<bool>>? Save { get; set; }
    [Parameter] public bool Failed { get; set; }

    internal bool HasChanges => Changed();

    protected override void OnInitialized() => Unsaved.Add(this);

    internal async Task<bool> AskAsync()
    {
        if (_answer is { } asking)
            return await asking.Task;
        _answer = new TaskCompletionSource<bool>();
        _problem = null;
        await InvokeAsync(StateHasChanged);
        return await _answer.Task;
    }

    private async Task CheckAsync(LocationChangingContext context)
    {
        if (HasChanges && !await AskAsync())
            context.PreventNavigation();
    }

    private async Task SaveAndGoAsync()
    {
        _busy = true;
        try
        {
            if (await Save!())
                Answer(true);
            else
                _problem = "It couldn't be saved. Try again, or discard the changes.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void Answer(bool leave)
    {
        TaskCompletionSource<bool>? answer = _answer;
        _answer = null;
        answer?.TrySetResult(leave);
    }

    private static string Capital(string words) => words.Length == 0 ? words : char.ToUpperInvariant(words[0]) + words[1..];

    public void Dispose()
    {
        Unsaved.Remove(this);
        Answer(true);
    }
}
