@implements IAsyncDisposable
@inject IJSRuntime Js

<figure class="map-view @Class">
    <div class="map-view__map" @ref="_element" role="img" aria-label="@Label"></div>
    @if (Overlay is not null)
    {
        <div class="map-view__overlay">@Overlay</div>
    }
    @if (!string.IsNullOrEmpty(Source.Attribution))
    {
        <figcaption class="map-view__attribution">@Source.Attribution</figcaption>
    }
</figure>

@code {
    private const string Module = "./_content/GSBC.ChurchApp.Platform.Ui/map/map-view.js";
    private static readonly IReadOnlyList<MapLine> NoLines = [];
    private static readonly IReadOnlyList<MapArea> NoAreas = [];
    private static readonly IReadOnlyList<MapMarker> NoMarkers = [];

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<MapView>? _receiver;
    private MapSource? _shownSource;
    private object? _shownLines;
    private object? _shownAreas;
    private object? _shownMarkers;
    private MapYou? _shownYou;
    private bool _shownFollow;
    private MapFrame? _shownFrame;
    private bool _disposed;
    private Task? _creating;

    [Parameter, EditorRequired] public required MapSource Source { get; set; }
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public IReadOnlyList<MapLine> Lines { get; set; } = NoLines;
    [Parameter] public IReadOnlyList<MapArea> Areas { get; set; } = NoAreas;
    [Parameter] public IReadOnlyList<MapMarker> Markers { get; set; } = NoMarkers;
    [Parameter] public MapYou? You { get; set; }
    [Parameter] public bool Follow { get; set; }
    [Parameter] public MapFrame? Frame { get; set; }
    [Parameter] public MapPoint? Centre { get; set; }
    [Parameter] public double Zoom { get; set; } = 15;
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public EventCallback<MapPoint> OnTap { get; set; }
    [Parameter] public EventCallback OnStoppedFollowing { get; set; }
    [Parameter] public RenderFragment? Overlay { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;
        if (_creating is not null)
            await _creating;
        if (_map is null || !Equals(_shownSource, Source))
        {
            _creating = CreateAsync();
            try
            {
                await _creating;
            }
            finally
            {
                _creating = null;
            }
        }
        if (_map is null)
            return;
        await PushAsync();
    }

    [JSInvokable("OnTap")]
    public Task TappedAsync(double lat, double lon) => OnTap.InvokeAsync(new MapPoint(lat, lon));

    [JSInvokable("OnStoppedFollowing")]
    public Task StoppedFollowingAsync() => OnStoppedFollowing.InvokeAsync();

    public IJSObjectReference? Handle => _map;

    public event Func<Task>? Created;

    public async Task FitAsync(MapFrame frame)
    {
        if (_map is not null && !frame.IsEmpty)
            await _map.InvokeVoidAsync("fit", MapJson.Frame(frame));
    }

    public async Task CentreAsync(MapPoint point, double? zoom = null)
    {
        if (_map is not null)
            await _map.InvokeVoidAsync("centre", point.Lat, point.Lon, zoom);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DropMapAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _receiver?.Dispose();
    }

    private async Task CreateAsync()
    {
        await DropMapAsync();
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", Module);
        _receiver ??= DotNetObjectReference.Create(this);
        _map = await _module.InvokeAsync<IJSObjectReference>("create", _element, MapJson.Options(Source, Centre, Zoom, Interactive, Follow), _receiver);
        _shownSource = Source;
        _shownLines = _shownAreas = _shownMarkers = null;
        _shownYou = null;
        _shownFrame = null;
        _shownFollow = Follow;
        if (Created is { } created)
            await created();
    }

    private async Task PushAsync()
    {
        if (_map is null)
            return;
        if (!ReferenceEquals(_shownLines, Lines))
        {
            _shownLines = Lines;
            await _map.InvokeVoidAsync("setLines", MapJson.Lines(Lines));
        }
        if (!ReferenceEquals(_shownAreas, Areas))
        {
            _shownAreas = Areas;
            await _map.InvokeVoidAsync("setAreas", MapJson.Areas(Areas));
        }
        if (!ReferenceEquals(_shownMarkers, Markers))
        {
            _shownMarkers = Markers;
            await _map.InvokeVoidAsync("setMarkers", MapJson.Markers(Markers));
        }
        if (!Equals(_shownYou, You))
        {
            _shownYou = You;
            await _map.InvokeVoidAsync("setYou", MapJson.You(You));
        }
        if (_shownFollow != Follow)
        {
            _shownFollow = Follow;
            await _map.InvokeVoidAsync("follow", Follow);
        }
        if (Frame is { IsEmpty: false } frame && !Equals(_shownFrame, frame))
        {
            _shownFrame = frame;
            await _map.InvokeVoidAsync("fit", MapJson.Frame(frame));
        }
    }

    private async Task DropMapAsync()
    {
        if (_map is null)
            return;
        try
        {
            await _map.InvokeVoidAsync("dispose");
            await _map.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _map = null;
    }
}
