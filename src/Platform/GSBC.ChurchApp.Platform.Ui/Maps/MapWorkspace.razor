@using GSBC.ChurchApp.Platform.Icons
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@Classes" @ref="_root">
    @if (!_full)
    {
        <nav class="map-workspace__dock" aria-label="@Label">
            @foreach (MapWorkspaceJob job in Jobs)
            {
                @if (job.StartsGroup)
                {
                    <span class="map-workspace__rule" aria-hidden="true"></span>
                }
                <Button Variant="ButtonVariant.Quiet" Icon="@job.Icon" Pressed="@(job.Id == Current && Open)" Class="@JobClass(job)"
                        AriaLabel="@(job.Count > 0 ? $"{job.Label}, {job.Count}" : job.Label)" OnClick="() => ChooseAsync(job)">
                    <span class="map-workspace__job-name">@job.Label</span>
                    @if (job.Count > 0)
                    {
                        <span class="map-workspace__count" aria-hidden="true">@job.Count</span>
                    }
                </Button>
            }
        </nav>
    }
    @if (Drawer is not null && (Open || _full))
    {
        <section class="map-workspace__drawer" aria-label="@DrawerLabel">
            @if (_full)
            {
                <div class="map-workspace__head" data-panel-grip title="Drag to move the panel to the other side">
                    <Menu Label="Jobs on the map" Text="@CurrentJob?.Label" Icon="@(CurrentJob?.Icon ?? AppIcons.Coverage)" Chevron="true" Small="true" AlignStart="true" Items="JobItems" />
                    <span class="map-workspace__grip" aria-hidden="true"><Icon Name="@AppIcons.DragPanel" Size="IconSize.Small" /></span>
                    <Button Variant="ButtonVariant.Quiet" Icon="@(Open ? AppIcons.FoldPanel : AppIcons.UnfoldPanel)" Small="true" Tooltip="@(Open ? "Fold this away" : "Show the panel")"
                            AriaLabel="@(Open ? "Fold this away" : "Show the panel")" Expanded="Open" OnClick="() => OpenChanged.InvokeAsync(!Open)" />
                </div>
            }
            else
            {
                <Button Variant="ButtonVariant.Quiet" Icon="@AppIcons.HideDrawer" Small="true" Class="map-workspace__fold" Tooltip="Fold this away" AriaLabel="Fold this away"
                        OnClick="() => OpenChanged.InvokeAsync(false)" />
            }
            @if (Open)
            {
                <div class="map-workspace__body">@Drawer</div>
                @if (DrawerFoot is not null)
                {
                    <div class="map-workspace__foot">@DrawerFoot</div>
                }
            }
        </section>
    }
    <div class="map-workspace__map" data-look-bleed>
        @Map
        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="@(_full ? AppIcons.LeaveFullMap : AppIcons.FullMap)" Class="map-workspace__full"
                Tooltip="@(_full ? null : "Full map: just the map and this panel")" AriaLabel="@(_full ? "Leave the full map" : "Full map")" OnClick="() => FullAsync(!_full)">
            @if (_full)
            {
                <span>Leave full map</span>
                <kbd class="map-workspace__key">Esc</kbd>
            }
        </Button>
        @if (_full)
        {
            <div class="map-workspace__drop" aria-hidden="true"><span>Let go to keep it on the @(_right ? "left" : "right")</span></div>
        }
    </div>
</div>

@code {
    private const string Module = "./_content/GSBC.ChurchApp.Platform.Ui/map/map-workspace.js";
    private static bool? _fullThisSession;
    private static bool _rightHere;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<MapWorkspace>? _self;
    private bool _full = _fullThisSession ?? false;
    private bool _right = _rightHere;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<MapWorkspaceJob> Jobs { get; set; }
    [Parameter] public string? Current { get; set; }
    [Parameter] public EventCallback<string> OnChoose { get; set; }
    [Parameter] public bool Open { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? Drawer { get; set; }
    [Parameter] public RenderFragment? DrawerFoot { get; set; }
    [Parameter] public string? DrawerLabel { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter, EditorRequired] public required RenderFragment Map { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Classes =>
        $"map-workspace{(Wide ? " map-workspace--wide" : "")}{(_full ? " map-workspace--full" : "")}{(_full && _right ? " map-workspace--panel-right" : "")}{(_full && !Open ? " map-workspace--folded" : "")}{(Class is null ? "" : $" {Class}")}";

    private MapWorkspaceJob? CurrentJob => Jobs.FirstOrDefault(job => job.Id == Current);

    private IReadOnlyList<MenuItem> JobItems =>
    [
        .. Jobs.Select(job => new MenuItem(job.Label, EventCallback.Factory.Create(this, () => ChooseAsync(job)), job.Icon,
            job.Count > 0 ? $"{job.Count} new" : null, Checked: job.Id == Current, StartsGroup: job.StartsGroup)),
        this.Item(_right ? "Move the panel left" : "Move the panel right", () => PanelSideAsync(!_right), AppIcons.MovePanel, startsGroup: true),
    ];

    private string JobClass(MapWorkspaceJob job) => job.Id == Current ? "map-workspace__job map-workspace__job--current" : "map-workspace__job";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", Module);
            _self = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _root, _self);
            string[] remembered = (await _handle.InvokeAsync<string>("remembered")).Split(' ');
            (_fullThisSession, _rightHere) = (_fullThisSession ?? remembered[0] == "full", remembered[1] == "right");
            if ((_full, _right) != (_fullThisSession.Value, _rightHere))
            {
                (_full, _right) = (_fullThisSession.Value, _rightHere);
                StateHasChanged();
            }
            await _handle.InvokeVoidAsync("full", _full);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task LeaveFullAsync() => FullAsync(false);

    [JSInvokable]
    public async Task PanelSideAsync(bool right)
    {
        (_right, _rightHere) = (right, right);
        StateHasChanged();
        if (_handle is not null)
            await _handle.InvokeVoidAsync("side", right);
    }

    private async Task FullAsync(bool full)
    {
        (_full, _fullThisSession) = (full, full);
        StateHasChanged();
        if (_handle is not null)
            await _handle.InvokeVoidAsync("full", full);
    }

    private async Task ChooseAsync(MapWorkspaceJob job)
    {
        if (job.Id == Current)
        {
            await OpenChanged.InvokeAsync(!Open);
            return;
        }
        await OnChoose.InvokeAsync(job.Id);
        if (!Open)
            await OpenChanged.InvokeAsync(true);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
