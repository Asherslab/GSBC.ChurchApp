@implements IAsyncDisposable
@inject IJSRuntime Js

@code {
    private const string Module = "./_content/GSBC.ChurchApp.Platform.Ui/map/map-tools.js";
    private static readonly IReadOnlyList<MapLabel> NoLabels = [];
    private static readonly IReadOnlyList<MapLine> NoPreview = [];

    private MapView? _attachedTo;
    private IJSObjectReference? _module;
    private IJSObjectReference? _tools;
    private DotNetObjectReference<MapSketch>? _receiver;
    private MapSketchTool? _shownTool;
    private object? _shownLabels;
    private object? _shownPreview;
    private string? _shownBrush;

    [Parameter, EditorRequired] public required MapView? Map { get; set; }
    [Parameter] public MapSketchTool Tool { get; set; }
    [Parameter] public IReadOnlyList<MapLabel> Labels { get; set; } = NoLabels;
    [Parameter] public IReadOnlyList<MapLine> Preview { get; set; } = NoPreview;
    [Parameter] public string? BrushColour { get; set; }
    [Parameter] public EventCallback<MapSketchStroke> OnDrawn { get; set; }
    [Parameter] public EventCallback<MapSketchStroke> OnDrawing { get; set; }
    [Parameter] public EventCallback<MapPoint> OnHover { get; set; }
    [Parameter] public EventCallback OnHoverEnded { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ReferenceEquals(_attachedTo, Map))
        {
            if (_attachedTo is not null)
                _attachedTo.Created -= AttachAsync;
            _attachedTo = Map;
            if (Map is not null)
                Map.Created += AttachAsync;
            await AttachAsync();
        }
        await PushAsync();
    }

    [JSInvokable("OnDrawn")]
    public Task DrawnAsync(string kind, string points) => OnDrawn.InvokeAsync(new MapSketchStroke(MapSketchTools.Of(kind), MapSketchJson.Points(points)));

    [JSInvokable("OnDrawing")]
    public Task DrawingAsync(string kind, string points) => OnDrawing.InvokeAsync(new MapSketchStroke(MapSketchTools.Of(kind), MapSketchJson.Points(points)));

    [JSInvokable("OnHover")]
    public Task HoverAsync(double lat, double lon) => OnHover.InvokeAsync(new MapPoint(lat, lon));

    [JSInvokable("OnHoverEnded")]
    public Task HoverEndedAsync() => OnHoverEnded.InvokeAsync();

    [JSInvokable("OnCancelled")]
    public Task CancelledAsync() => OnCancelled.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_attachedTo is not null)
            _attachedTo.Created -= AttachAsync;
        await DetachAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _receiver?.Dispose();
    }

    private async Task AttachAsync()
    {
        await DetachAsync();
        if (Map?.Handle is not { } handle)
            return;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", Module);
        _receiver ??= DotNetObjectReference.Create(this);
        _tools = await _module.InvokeAsync<IJSObjectReference>("attach", handle, _receiver);
        _shownTool = null;
        _shownLabels = _shownPreview = null;
        _shownBrush = null;
        await PushAsync();
    }

    private async Task PushAsync()
    {
        if (_tools is null)
            return;
        if (_shownTool != Tool)
        {
            _shownTool = Tool;
            await _tools.InvokeVoidAsync("setTool", MapSketchTools.Name(Tool));
        }
        if (_shownBrush != BrushColour)
        {
            _shownBrush = BrushColour;
            await _tools.InvokeVoidAsync("setBrushColour", BrushColour);
        }
        if (!ReferenceEquals(_shownLabels, Labels))
        {
            _shownLabels = Labels;
            await _tools.InvokeVoidAsync("setLabels", MapSketchJson.Labels(Labels));
        }
        if (!ReferenceEquals(_shownPreview, Preview))
        {
            _shownPreview = Preview;
            await _tools.InvokeVoidAsync("preview", MapSketchJson.Preview(Preview));
        }
    }

    private async Task DetachAsync()
    {
        if (_tools is null)
            return;
        try
        {
            await _tools.InvokeVoidAsync("dispose");
            await _tools.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _tools = null;
    }
}
