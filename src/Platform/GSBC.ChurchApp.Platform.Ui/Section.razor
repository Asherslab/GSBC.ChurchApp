<section class="section @(First ? "section--first" : "") @(Grouped ? "section--grouped" : "")" id="@Id" aria-labelledby="@(Title is null ? null : HeadingId)">
    @if (Title is not null)
    {
        <div class="section__head">
            <h2 class="section__title" id="@HeadingId">@Title</h2>
            @if (LinkHref is not null)
            {
                <a class="section__link" href="@LinkHref">@LinkText<Icon Name="chevron-right" Size="IconSize.Small" /></a>
            }
            @Trailing
        </div>
    }
    @if (Lead is not null)
    {
        <p class="section__lead">@Lead</p>
    }
    @if (Grouped)
    {
        <div class="section__group">@ChildContent</div>
        @if (Foot is not null)
        {
            <div class="section__foot">@Foot</div>
        }
    }
    else
    {
        @ChildContent
    }
</section>

@code {
    private static int _sections;
    private readonly string _headingId = $"section-{Interlocked.Increment(ref _sections)}";

    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string LinkText { get; set; } = "See all";
    [Parameter] public string? LinkHref { get; set; }
    [Parameter] public bool First { get; set; }
    [Parameter] public bool Grouped { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public RenderFragment? Foot { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string HeadingId => Id is null ? _headingId : $"{Id}-title";
}
