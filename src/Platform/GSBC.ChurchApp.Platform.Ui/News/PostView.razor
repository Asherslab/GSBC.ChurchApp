@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Icons
@using GSBC.ChurchApp.Platform.Ui.Content
@inject Shell Shell
@inject TimeProvider Clock

<article class="@(FillsPage ? "post-view post-view--fills" : "post-view")">
    <header class="post-view__head">
        <p class="post-view__day"><span class="visually-hidden">@LongDate</span><small aria-hidden="true">@Day.Word</small><b aria-hidden="true">@Day.Number</b><span aria-hidden="true">@Day.Month</span></p>
        <div class="post-view__heading">
            <h1 class="post-view__title" data-page-title>@Title</h1>
            <p class="post-view__meta">
                @if (From.Length > 0)
                {
                    @if (FromHref.Length > 0)
                    {
                        <a class="post-view__from" href="@FromHref"><Icon Name="@AppIcons.Ministries" Size="IconSize.Small" />@From</a>
                    }
                    else
                    {
                        <span class="post-view__from"><Icon Name="@AppIcons.Ministries" Size="IconSize.Small" />@From</span>
                    }
                }
                @if (Author.Length > 0)
                {
                    <span class="post-view__author">@Author</span>
                }
                @if (Edited)
                {
                    <span>Edited</span>
                }
            </p>
            @Status
        </div>
    </header>
    <MediaStrip Content="Content" About="@Title" />
    @if (!Content.IsEmpty)
    {
        <RichTextView Content="Content" Class="post-view__body" About="@Title" SkipBlocks="Leading" />
    }
    @if (LinkPath.Length > 0)
    {
        <div class="post-view__link">
            @if (LinkTargets.KindOf(LinkPath) == LinkKind.InApp)
            {
                <Button Block="true" Icon="@AppIcons.PlacesInTheApp" Href="@LinkTargets.InAppRoute(LinkPath)">@LinkLabel</Button>
            }
            else
            {
                <Button Block="true" Icon="external-link" OnClick="() => Shell.OpenExternalAsync(LinkPath)">@LinkLabel</Button>
            }
        </div>
    }
    @ChildContent
    <footer class="post-view__end">
        @if (NotPosted is { Length: > 0 } notPosted)
        {
            <p>@notPosted</p>
        }
        else
        {
            <p>Posted <b>@Day.Phrase</b>@if (By.Length > 0) { <text> by <b>@By</b></text> }@if (For.Length > 0) { <text> for @ForWords</text> }.</p>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required RichText Content { get; set; }
    [Parameter, EditorRequired] public required DateTime Posted { get; set; }
    [Parameter] public bool Edited { get; set; }
    [Parameter] public string Author { get; set; } = "";
    [Parameter] public string From { get; set; } = "";
    [Parameter] public string FromHref { get; set; } = "";
    [Parameter] public string For { get; set; } = "";
    [Parameter] public string LinkPath { get; set; } = "";
    [Parameter] public string LinkLabel { get; set; } = "";
    [Parameter] public bool FillsPage { get; set; }
    [Parameter] public string? NotPosted { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private DateTime Now => Clock.GetUtcNow().UtcDateTime;

    private PostDay Day => PostDay.Of(Posted, Now);

    private string LongDate => ChurchDates.Describe(Posted, DateLineStyle.Long, withTime: false, Now);

    private string ForWords => For.Length == 0 ? "" : char.ToLowerInvariant(For[0]) + For[1..];

    private string By => Author.Length > 0 ? Author : From;

    private int Leading => MediaStrip.Leads(Content) ? PostOpening.Of(Content).Blocks : 0;
}
