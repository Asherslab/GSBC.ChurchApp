@using GSBC.ChurchApp.Platform.Contracts.Content
@using GSBC.ChurchApp.Platform.Ui.Content

<RichTextField Value="@Block.Text" ValueChanged="TypedAsync" Label="@Label" Class="post-text" />

@code {
    [Parameter, EditorRequired] public required PostBlock Block { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Text";

    private Task TypedAsync(string text)
    {
        Block.Text = text;
        return OnChanged.InvokeAsync();
    }
}
