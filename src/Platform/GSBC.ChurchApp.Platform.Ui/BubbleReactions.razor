@inject Shell Shell

@if (Reactions.Count > 0)
{
    <span class="bubble-reactions @(Picker ? "bubble-reactions--picker" : "") @Class" role="group" aria-label="@Label">
        @foreach (BubbleReaction reaction in Reactions)
        {
            <button type="button" class="bubble-reaction @(reaction.Yours ? "bubble-reaction--yours" : "")" disabled="@Disabled" aria-pressed="@(reaction.Yours ? "true" : "false")"
                    aria-label="@(Picker ? reaction.Emoji : $"{reaction.Emoji} {reaction.Count}")" @onclick="() => ToggleAsync(reaction)">
                @reaction.Emoji
                @if (!Picker)
                {
                    <span class="bubble-reaction__count">@reaction.Count</span>
                }
            </button>
        }
    </span>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<BubbleReaction> Reactions { get; set; }
    [Parameter] public EventCallback<BubbleReaction> OnToggle { get; set; }
    [Parameter] public bool Picker { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Reactions";
    [Parameter] public string? Class { get; set; }

    private async Task ToggleAsync(BubbleReaction reaction)
    {
        await Shell.HapticAsync();
        await OnToggle.InvokeAsync(reaction);
    }
}
