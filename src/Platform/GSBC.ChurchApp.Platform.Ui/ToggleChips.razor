@typeparam TValue
@inject Shell Shell

<div class="toggle-chips @(Quiet ? "toggle-chips--wrap toggle-chips--quiet" : "") @Class" role="group" aria-label="@Label">
    @foreach (ToggleChip<TValue> chip in Chips)
    {
        <button type="button" class="filter-chip @(chip.On ? "filter-chip--on" : "")" aria-pressed="@(chip.On ? "true" : "false")" @onclick="() => ToggleAsync(chip)">
            @if (Quiet && chip.On)
            {
                <Icon Name="check" Size="IconSize.Small" />
            }
            @chip.Label
        </button>
    }
    @Trailing
</div>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<ToggleChip<TValue>> Chips { get; set; }
    [Parameter] public EventCallback<ToggleChip<TValue>> Toggled { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Quiet { get; set; }

    private async Task ToggleAsync(ToggleChip<TValue> chip)
    {
        await Shell.HapticAsync();
        await Toggled.InvokeAsync(chip);
    }
}
