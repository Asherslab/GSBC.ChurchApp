@if (ChildContent is not null || !string.IsNullOrWhiteSpace(Text))
{
    <div class="fact @(Icon is null ? "fact--plain" : "")">
        @if (Icon is not null)
        {
            <span class="fact__icon"><Icon Name="@Icon" Size="IconSize.Small" /></span>
        }
        <dt class="fact__label">@Label</dt>
        <dd class="fact__text">@(ChildContent ?? (RenderFragment)(builder => builder.AddContent(0, Text)))</dd>
    </div>
}

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
