@if (!string.IsNullOrWhiteSpace(Text))
{
    <div class="fact">
        <span class="fact__icon"><Icon Name="@Icon" Size="IconSize.Small" /></span>
        <dt class="fact__label">@Label</dt>
        <dd class="fact__text">@Text</dd>
    </div>
}

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Icon { get; set; } = "check";
}
