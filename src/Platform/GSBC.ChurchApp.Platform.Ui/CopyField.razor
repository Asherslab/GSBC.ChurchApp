@inject Shell Shell

<div class="copy-field">
    <label class="copy-field__label" for="@_id">@Label</label>
    <div class="copy-field__row">
        <input id="@_id" class="copy-field__input" readonly value="@Value" onfocus="this.select()" />
        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="@(_copied ? "check" : "copy")" OnClick="CopyAsync">@(_copied ? "Copied" : "Copy")</Button>
    </div>
    <p class="copy-field__hint" role="status" aria-live="polite">@(_failed ? "Couldn't copy here. Select it and press ⌘C or Ctrl+C." : Hint)</p>
</div>

@code {
    private static int _fields;
    private readonly string _id = $"copy-field-{Interlocked.Increment(ref _fields)}";
    private bool _copied;
    private bool _failed;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public string? Hint { get; set; }

    private async Task CopyAsync()
    {
        _copied = await Shell.CopyAsync(Value);
        _failed = !_copied;
    }
}
