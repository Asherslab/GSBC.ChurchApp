@using System.Diagnostics.CodeAnalysis
@using System.Reflection
@attribute [UnconditionalSuppressMessage("Trimming", "IL2110", Justification = "The Razor compiler references Router.NotFoundPage's annotated setter; no page type flows through it, and page and layout assemblies are rooted (SPEC §9).")]
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "As above.")]
@inject ClientModules Modules

<Router AppAssembly="AppAssembly" AdditionalAssemblies="Modules.AdditionalAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="Layout" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [Parameter, EditorRequired] public required Assembly AppAssembly { get; set; }

    [Parameter, EditorRequired] public required Type Layout { get; set; }
}
