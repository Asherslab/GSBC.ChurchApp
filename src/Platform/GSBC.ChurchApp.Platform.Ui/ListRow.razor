@inject Shell Shell

@if (Href is not null && !External && !Disabled)
{
    <a class="row @ReadingClass @Class" href="@Href" @onclick="TapAsync">@Body</a>
}
else if (Disabled || (Href is null && !OnClick.HasDelegate))
{
    <div class="row @(Disabled ? "row--disabled" : "") @ReadingClass @Class" aria-disabled="@(Disabled ? "true" : null)">@Body</div>
}
else
{
    <button type="button" class="row @ReadingClass @Class" @onclick="ActivateAsync">@Body</button>
}

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RowTone IconTone { get; set; } = RowTone.Primary;
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public string? Trailing { get; set; }
    [Parameter] public RenderFragment? TrailingContent { get; set; }
    [Parameter] public RenderFragment? Below { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool External { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? TitleExtra { get; set; }
    [Parameter] public bool Reading { get; set; }
    [Parameter] public bool? Unread { get; set; }
    [Parameter] public bool Chevron { get; set; }

    private string ReadingClass => string.Join(" ", new[] { Reading ? "row--reading" : null, Unread switch { true => "row--unread", false => "row--read", _ => null } }.OfType<string>());

    private bool Navigates => !Disabled && (Href is not null || Chevron);

    private string ToneClass => IconTone switch
    {
        RowTone.Accent => "row__icon--accent",
        RowTone.Warm => "row__icon--warm",
        RowTone.Quiet => "row__icon--quiet",
        _ => "",
    };

    private RenderFragment Body => @<text>
        @if (Leading is not null)
        {
            @Leading
        }
        else if (Icon is not null)
        {
            <span class="row__icon @ToneClass"><GSBC.ChurchApp.Platform.Ui.Icon Name="@Icon" Size="IconSize.Small" /></span>
        }
        <span class="row__body">
            <span class="row__title">
                @if (Unread is true)
                {
                    <span class="row__unread" role="img" aria-label="Unread"></span>
                }
                @Title
                @if (TitleExtra is not null)
                {
                    <span class="row__title-extra">@TitleExtra</span>
                }
            </span>
            @if (Subtitle is not null)
            {
                <span class="row__subtitle">@Subtitle</span>
            }
            @Below
        </span>
        @if (Trailing is not null || TrailingContent is not null || Navigates)
        {
            <span class="row__trail">
                @Trailing
                @TrailingContent
                @if (Navigates)
                {
                    <GSBC.ChurchApp.Platform.Ui.Icon Name="@(External ? "external-link" : "chevron-right")" Size="IconSize.Small" />
                }
            </span>
        }
    </text>;

    private Task TapAsync() => Shell.HapticAsync().AsTask();

    private async Task ActivateAsync()
    {
        await TapAsync();
        if (Href is not null)
            await Shell.OpenExternalAsync(Href);
        await OnClick.InvokeAsync();
    }
}
