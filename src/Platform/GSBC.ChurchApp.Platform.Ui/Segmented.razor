@typeparam TValue
@inject Shell Shell

@if (ShowLabel)
{
    <div class="field">
        <span class="field__label" id="@_id">@Label</span>
        @if (Hint is not null)
        {
            <span class="field__hint" id="@HintId">@Hint</span>
        }
        @Track
    </div>
}
else
{
    @Track
}

@code {
    private static int _groups;
    private readonly string _id = $"segmented-{Interlocked.Increment(ref _groups)}";

    private string HintId => $"{_id}-hint";

    private RenderFragment Track => @<div class="segmented @(Rows ? "segmented--rows" : Stacked ? "segmented--stacked" : "") @Class" role="radiogroup" aria-label="@(ShowLabel ? null : Label)"
     aria-labelledby="@(ShowLabel ? _id : null)" aria-describedby="@(ShowLabel && Hint is not null ? HintId : null)">
    @for (int index = 0; index < Options.Count; index++)
    {
        SegmentOption<TValue> option = Options[index];
        int at = index;
        bool selected = IsSelected(option);
        <button type="button" class="segmented__option" role="radio" aria-checked="@(selected ? "true" : "false")" tabindex="@(at == TabStop ? 0 : -1)"
                @ref="_buttons[at]" @onclick="() => SelectAsync(option.Value)" @onkeydown="key => StepAsync(key, at)">
            @if (Rows)
            {
                <span class="segmented__radio" aria-hidden="true"></span>
            }
            else if (option.Icon is not null)
            {
                <Icon Name="@option.Icon" Size="IconSize.Small" />
            }
            @if (Stacked || Rows)
            {
                <span class="segmented__text">
                    <span class="segmented__label">@option.Label</span>
                    @if (option.Detail is not null)
                    {
                        <span class="segmented__detail">@option.Detail</span>
                    }
                </span>
            }
            else
            {
                @option.Label
            }
            @if (option.Count is > 0)
            {
                <span class="segmented__count">@option.Count</span>
            }
        </button>
    }
</div>;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<SegmentOption<TValue>> Options { get; set; }
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Stacked { get; set; }
    [Parameter] public bool Rows { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public string? Hint { get; set; }

    private ElementReference[] _buttons = [];

    private bool IsSelected(SegmentOption<TValue> option) => EqualityComparer<TValue>.Default.Equals(option.Value, Value);

    private int TabStop => Math.Max(0, Options.ToList().FindIndex(IsSelected));

    protected override void OnParametersSet()
    {
        if (_buttons.Length != Options.Count)
            _buttons = new ElementReference[Options.Count];
    }

    private async Task StepAsync(KeyboardEventArgs key, int at)
    {
        int? next = key.Key switch
        {
            "ArrowRight" or "ArrowDown" => (at + 1) % Options.Count,
            "ArrowLeft" or "ArrowUp" => (at - 1 + Options.Count) % Options.Count,
            "Home" => 0,
            "End" => Options.Count - 1,
            _ => null,
        };
        if (next is not { } chosen)
            return;
        await SelectAsync(Options[chosen].Value);
        await _buttons[chosen].FocusAsync();
    }

    private async Task SelectAsync(TValue value)
    {
        await Shell.HapticAsync();
        await ValueChanged.InvokeAsync(value);
    }
}
