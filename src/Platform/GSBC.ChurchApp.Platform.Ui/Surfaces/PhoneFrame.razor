<div @ref="_frame" class="phone-frame phone-frame--@Device.Cutout.ToString().ToLowerInvariant()" data-palette="@(Theme is null ? Palette : PreviewPalette)" data-preview-scheme="@Scheme?.ToString().ToLowerInvariant()" role="@(Interactive ? "group" : "img")" aria-label="@Label"
     style="@($"width: {Device.Width}px; height: {Device.Height}px; --sat: {Device.TopInset}px; --sab: {Device.BottomInset}px")">
    @if (Theme is not null)
    {
        <style>@ThemeDerivation.Css(Theme, $"[data-palette=\"{PreviewPalette}\"]",
            $":root[data-scheme=\"dark\"] [data-palette=\"{PreviewPalette}\"]:not([data-preview-scheme=\"light\"]), [data-palette=\"{PreviewPalette}\"][data-preview-scheme=\"dark\"]", _fontSources)</style>
    }
    <div class="phone-frame__screen" data-stuck-at="@StuckAt">
        <div class="topbar" aria-hidden="true"><span></span><span class="topbar__title">@Title</span><span class="topbar__end">@if (Bell)
            {
                <span class="icon-btn"><Icon Name="bell" /></span>
            }</span></div>
        @ChildContent
    </div>
    <div class="phone-frame__status" aria-hidden="true">
        <span class="phone-frame__time">9:41</span>
        @if (Device.Cutout != PhoneCutout.None)
        {
            <span class="phone-frame__cutout"></span>
        }
        <span class="phone-frame__levels">
            <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 27 13"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="20" height="9" rx="2" /><rect x="25" y="4.5" width="1.5" height="4" rx="0.75" opacity="0.4" /></svg>
        </span>
    </div>
    @if (TabBarContent is not null)
    {
        @TabBarContent
    }
    else
    {
        <nav class="tabbar" aria-hidden="true">
            @foreach (AppTab tab in Tabs)
            {
                <span class="tabbar__item @(tab.Route == OnRoute ? "active" : "")"><Icon Name="@tab.Icon" /><span>@tab.Word</span></span>
            }
            <span class="tabbar__item @(OnRoute == "more" ? "active" : "")"><Icon Name="more" /><span>More</span></span>
        </nav>
    }
</div>

@inject Shell Shell
@inject Client.Media.IMediaFiles Files

@code {
    private ElementReference _frame;
    private PhoneDevice? _fitted;
    private IReadOnlyDictionary<string, string> _fontSources = new Dictionary<string, string>();
    private string _fontsFor = "";

    protected override async Task OnParametersSetAsync()
    {
        string fonts = Theme is null ? "" : string.Join(',', ThemeDerivation.FontFiles(Theme).Select(file => file.Key));
        if (fonts == _fontsFor)
            return;
        _fontsFor = fonts;
        _fontSources = Theme is null ? new Dictionary<string, string>() : await Appearance.FontSourcesAsync(Files, Theme);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_fitted == Device)
            return;
        _fitted = Device;
        await Shell.FitToSpaceAsync(_frame, Device.Width, Device.Height);
    }

    private const string PreviewPalette = "preview";

    [Parameter] public string? Palette { get; set; }
    [Parameter] public ThemeSpec? Theme { get; set; }
    [Parameter] public ThemeScheme? Scheme { get; set; }
    [Parameter] public PhoneDevice Device { get; set; } = PhoneDevice.IPhone15Pro;
    [Parameter] public IReadOnlyList<AppTab> Tabs { get; set; } = TabBar.Starting;
    [Parameter] public string? OnRoute { get; set; } = "";
    [Parameter] public RenderFragment? TabBarContent { get; set; }
    [Parameter] public bool Interactive { get; set; }
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Bell { get; set; }
    [Parameter] public int StuckAt { get; set; } = 44;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
