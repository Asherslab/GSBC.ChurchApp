<Masthead Title="@Top.Title" Class="@($"masthead--home {(Top.Title.Length > ShortTitle ? "masthead--home-long" : "")}")">
    <div class="home-line">
        @switch (Top.Line)
        {
            case HomeTopLine.Today:
                <p class="masthead__note"><DateLine At="At" /></p>
                break;
            case HomeTopLine.Own own:
                <p class="masthead__note">@own.Words</p>
                break;
        }
        @if (Live)
        {
            <SyncIndicator OnMasthead="true" />
        }
    </div>
    @TopOverlay
</Masthead>

<Section First="true">
    @if (!HasTiles)
    {
        <EmptyState Icon="home" Title="Home is on its way" Body="This Sunday, sermons and the week will show here as each part of the app is built." />
    }
    else
    {
        <HubTiles Shown="Shown" Live="Live" Overlay="Overlay" />
    }
</Section>

@inject SurfaceViews Views

@code {
    private const int ShortTitle = 16;

    [Parameter, EditorRequired] public required IReadOnlyList<ArrangedSurface> Shown { get; set; }
    [Parameter, EditorRequired] public required DateTime At { get; set; }
    [Parameter] public bool Live { get; set; }
    [Parameter] public RenderFragment<HubCell>? Overlay { get; set; }
    [Parameter] public RenderFragment? TopOverlay { get; set; }

    private HomeTop Top => HubSurfaces.Top.In(Shown);

    private bool HasTiles => HubTiles.TilesIn(Shown, Views).Count > 0;
}
