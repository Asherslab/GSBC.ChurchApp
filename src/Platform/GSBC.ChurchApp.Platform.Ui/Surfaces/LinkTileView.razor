<HubTile Look="Look" Title="@Entry.Values.Get(HubSurfaces.LinkTile.Title)" Lines="[Entry.Values.Get(HubSurfaces.LinkTile.Subtitle)]" PlacementId="@Entry.Placement?.Id" />

@code {
    [Parameter, EditorRequired] public required ArrangedSurface Entry { get; set; }

    private TileLook Look => new(
        Entry.Values.Get(HubSurfaces.LinkTile.Wide) ? HubGrid.MostColumns : 1, 1,
        Entry.Values.Get(HubSurfaces.LinkTile.Colour) switch { "navy" => TileTones.Masthead, "aqua" => TileTones.LiveSoft, "plain" => TileTones.Raised, _ => TileTones.Sand },
        "link", IconTones.Auto, "", "", Entry.Values.Get(HubSurfaces.LinkTile.Image), FocalPoint.Centre, Entry.Values.Get(HubSurfaces.LinkTile.Link));
}
