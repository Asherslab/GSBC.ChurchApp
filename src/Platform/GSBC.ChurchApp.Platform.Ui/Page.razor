@using Microsoft.Extensions.DependencyInjection
@inject Shell Shell
@inject IServiceProvider Services

<PageTitle>@Title · Good Shepherd</PageTitle>

<div class="page-scroll" data-stuck-at="@StuckAt" data-back-href="@Back">
    <header class="topbar @(TopBar switch { TopBarStyle.Solid => "topbar--solid", TopBarStyle.SolidTitleOnScroll => "topbar--solid topbar--late-title", _ => "" })">
        <div class="topbar__start">
            @if (Back is not null || OnBack.HasDelegate)
            {
                <button type="button" class="icon-btn icon-btn--back" @onclick="BackAsync" aria-label="@(Label == DefaultBack ? Label : $"Back to {Label}")">
                    <Icon Name="chevron-left" />@Label
                </button>
            }
        </div>
        <div class="topbar__title" aria-hidden="true">@Title</div>
        <div class="topbar__end">
            @Actions
            @if (Back is null && !OnBack.HasDelegate)
            {
                <InboxBell />
            }
        </div>
    </header>
    <div class="page">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? BackHref { get; set; }
    private const string DefaultBack = "Back";

    [Parameter] public string BackLabel { get; set; } = DefaultBack;
    [Parameter] public TopBarStyle TopBar { get; set; } = TopBarStyle.OverMasthead;
    [Parameter] public int StuckAt { get; set; } = 120;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public string? Place { get; set; }

    private PlaceBack? _placeBack;

    private string? Back => Place is null ? BackHref : _placeBack?.Href;

    private string Label => Place is null ? BackLabel : _placeBack?.Label ?? DefaultBack;

    private PhoneTabs? Tabs => Services.GetService<PhoneTabs>();

    protected override void OnParametersSet()
    {
        if (Place is not null && Tabs is { } tabs)
            _placeBack = tabs.BackFor(Place);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Place is not null && Tabs is { } tabs)
            _placeBack = await tabs.BackForAsync(Place);
    }

    private async Task BackAsync()
    {
        await Shell.HapticAsync();
        if (OnBack.HasDelegate)
            await OnBack.InvokeAsync();
        else
            await Shell.BackAsync(Back!);
    }
}
