@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (Preview is not null)
{
    <div class="reorder__preview" aria-hidden="true">@Preview(Shown)</div>
}
<div class="reorder @(Quiet ? "reorder--quiet" : "") @Class" role="list" aria-label="@Label" @ref="_list">
    @for (int index = 0; index < Items.Count; index++)
    {
        TItem item = Items[index];
        int at = index;
        <div class="reorder__row @RowClass?.Invoke(item)" role="listitem" data-reorder-row @key="Key(item)">
            @if (!Quiet)
            {
                <span class="reorder__grip" data-reorder-grip aria-hidden="true"><Icon Name="grip" Size="IconSize.Small" /></span>
            }
            else if (!Disabled)
            {
                <button type="button" class="reorder__grip" data-reorder-grip aria-label="@($"Move {Name(item)}")" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown"
                        title="Drag to move, or press Alt and an arrow key" @onkeydown="key => KeyAsync(key, at)">
                    <Icon Name="grip" Size="IconSize.Small" />
                </button>
            }
            <div class="reorder__body">@ItemTemplate(item)</div>
            @if (Trailing is not null)
            {
                <div class="reorder__trail">@Trailing(item)</div>
            }
            @if (!Quiet)
            {
                <Menu Label="@($"Move {Name(item)}")" Items="Moves(at)" Small="true" Disabled="Disabled" />
            }
        </div>
    }
</div>
<p class="visually-hidden" aria-live="polite">@_announced</p>

@code {
    private ElementReference _list;
    private IJSObjectReference? _module;
    private IJSObjectReference? _subscription;
    private DotNetObjectReference<ReorderReceiver>? _receiver;
    private (int From, int To)? _previewing;
    private string? _announced;

    [Parameter, EditorRequired] public required IReadOnlyList<TItem> Items { get; set; }
    [Parameter, EditorRequired] public required Func<TItem, string> Key { get; set; }
    [Parameter, EditorRequired] public required Func<TItem, string> Name { get; set; }
    [Parameter, EditorRequired] public required RenderFragment<TItem> ItemTemplate { get; set; }
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public RenderFragment<TItem>? Trailing { get; set; }
    [Parameter] public RenderFragment<IReadOnlyList<TItem>>? Preview { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnReordered { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Quiet { get; set; }
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }
    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<TItem> Shown => _previewing is { } moving ? Moved(moving.From, moving.To) : Items;

    private IReadOnlyList<MenuItem> Moves(int at) =>
    [
        this.Item("Move up", () => MoveAsync(at, at - 1), "chevron-up", disabled: at == 0),
        this.Item("Move down", () => MoveAsync(at, at + 1), "chevron-down", disabled: at == Items.Count - 1),
    ];

    private IReadOnlyList<TItem> Moved(int from, int to)
    {
        List<TItem> order = [.. Items];
        TItem moving = order[from];
        order.RemoveAt(from);
        order.Insert(Math.Clamp(to, 0, order.Count), moving);
        return order;
    }

    private async Task MoveAsync(int from, int to)
    {
        _previewing = null;
        if (from == to || to < 0 || to >= Items.Count)
            return;
        IReadOnlyList<TItem> order = Moved(from, to);
        _announced = $"Moved {Name(Items[from])} to {to + 1} of {Items.Count}.";
        await OnReordered.InvokeAsync(order);
    }

    private Task KeyAsync(KeyboardEventArgs key, int at) =>
        key is { AltKey: true, Key: "ArrowUp" or "ArrowDown" } ? MoveAsync(at, at + (key.Key == "ArrowDown" ? 1 : -1)) : Task.CompletedTask;

    private Task PreviewAsync(int from, int to) => InvokeAsync(() =>
    {
        _previewing = (from, to);
        StateHasChanged();
    });

    private Task DroppedAsync(int from, int to) => InvokeAsync(() => MoveAsync(from, to));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/reorder.js");
        _receiver = DotNetObjectReference.Create(new ReorderReceiver(PreviewAsync, DroppedAsync));
        _subscription = await _module.InvokeAsync<IJSObjectReference>("attach", _list, _receiver);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_subscription is not null)
                await _subscription.InvokeVoidAsync("dispose");
            if (_subscription is not null)
                await _subscription.DisposeAsync();
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _receiver?.Dispose();
    }
}
