@using GSBC.ChurchApp.Platform.Contracts.Media

<span class="media-cover @(Whole ? "media-cover--whole" : "") @Class">
    @if (Media is { } media)
    {
        <MediaImage Media="media" Alt="@Alt" />
    }
    else
    {
        <BrandMark Decorative="true" />
        @if (FallbackTitle is { Length: > 0 } title)
        {
            <span class="media-cover__title">@title</span>
        }
    }
    @ChildContent
</span>

@code {
    [Parameter] public MediaRef? Media { get; set; }
    [Parameter] public string? Alt { get; set; } = "";
    [Parameter] public string? FallbackTitle { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool Whole => Media is { Width: > 0, Height: > 0 } media && (double)media.Width / media.Height < 1.6;
}
