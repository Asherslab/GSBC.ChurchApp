@using GSBC.ChurchApp.Platform.Contracts.Media

<span class="media-cover @(Whole ? "media-cover--whole" : "") @Class">
    @if (Media is { } media)
    {
        <MediaImage Media="media" Size="Size" Alt="@Alt" />
    }
    else
    {
        <BrandMark Decorative="true" />
        @if (FallbackTitle is { Length: > 0 } title)
        {
            <span class="media-cover__title">@title</span>
        }
    }
    @ChildContent
</span>

@code {
    [Parameter] public MediaRef? Media { get; set; }
    [Parameter] public MediaSizeName Size { get; set; } = MediaSizeName.ForPhones;
    [Parameter] public string? Alt { get; set; } = "";
    [Parameter] public string? FallbackTitle { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const double Frame = 16d / 9;
    private const double CloseEnough = 0.08;

    private bool Whole => Media is { Width: > 0, Height: > 0 } media && Math.Abs((double)media.Width / media.Height - Frame) > CloseEnough;
}
