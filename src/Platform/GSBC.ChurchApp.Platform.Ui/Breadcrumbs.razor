<nav class="breadcrumbs" aria-label="@Label">
    <ol class="breadcrumbs__list">
        @for (int index = 0; index < Trail.Count; index++)
        {
            int position = index;
            Crumb crumb = Trail[position];
            bool current = position == Trail.Count - 1;
            bool droppable = !current && CanDrop?.Invoke(crumb) == true;
            <li class="breadcrumbs__item">
                @if (position > 0)
                {
                    <Icon Name="chevron-right" Size="IconSize.Small" Class="breadcrumbs__sep" />
                }
                @if (current)
                {
                    <span class="breadcrumbs__current" aria-current="page">
                        @if (crumb.Icon is not null)
                        {
                            <Icon Name="@crumb.Icon" Size="IconSize.Small" />
                        }
                        @crumb.Label
                    </span>
                }
                else
                {
                    <button type="button" class="breadcrumbs__link @(droppable && _over == position ? "breadcrumbs__link--drop" : "")"
                            @onclick="() => OnOpen.InvokeAsync(crumb)"
                            @ondragenter="() => _over = droppable ? position : NotOver" @ondragleave="() => _over = NotOver"
                            @ondragover:preventDefault="droppable" @ondrop="() => DropAsync(crumb)">
                        @if (crumb.Icon is not null)
                        {
                            <Icon Name="@crumb.Icon" Size="IconSize.Small" />
                        }
                        @crumb.Label
                    </button>
                }
            </li>
        }
    </ol>
</nav>

@code {
    private const int NotOver = -1;
    private int _over = NotOver;

    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<Crumb> Trail { get; set; }
    [Parameter] public EventCallback<Crumb> OnOpen { get; set; }
    [Parameter] public Func<Crumb, bool>? CanDrop { get; set; }
    [Parameter] public EventCallback<Crumb> OnDrop { get; set; }

    private async Task DropAsync(Crumb crumb)
    {
        _over = NotOver;
        if (CanDrop?.Invoke(crumb) == true)
            await OnDrop.InvokeAsync(crumb);
    }
}
