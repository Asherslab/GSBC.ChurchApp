@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="workbench @(Narrow ? "workbench--narrow" : "") @(Aside is null ? "workbench--no-aside" : "") @(Detail is null ? "workbench--no-detail" : "") @(FoldAside ? "workbench--fold-aside" : "") @Class" data-showing="@Shown.ToString().ToLowerInvariant()">
    @if (Aside is not null)
    {
        <aside class="workbench__aside" aria-label="@AsideLabel">@Aside</aside>
    }
    <section class="workbench__main">@ChildContent</section>
    @if (Detail is not null)
    {
        <aside class="workbench__detail" aria-label="@DetailLabel">@Detail</aside>
    }
</div>

@code {
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Detail { get; set; }
    [Parameter] public string AsideLabel { get; set; } = "Filters";
    [Parameter] public string DetailLabel { get; set; } = "Details";
    [Parameter] public bool Narrow { get; set; }
    [Parameter] public bool FoldAside { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public WorkbenchPane? Showing { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _fit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Narrow)
            return;
        await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/workbench.js");
        _fit = await module.InvokeAsync<IJSObjectReference>("fitRecord", _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_fit is null)
            return;
        try
        {
            await _fit.InvokeVoidAsync("dispose");
            await _fit.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private WorkbenchPane Shown => Showing ?? (Detail is null ? WorkbenchPane.Main : WorkbenchPane.Detail);
}
