<p class="save-status @(State switch { SaveState.Failed => "save-status--failed", SaveState.Unsaved => "save-status--unsaved", _ => "" })" role="status" aria-live="polite">
    @switch (State)
    {
        case SaveState.Saving or SaveState.Waiting:
            <span class="spinner" aria-hidden="true"></span>
            <span>@(State == SaveState.Waiting ? WaitingText : "Saving…")</span>
            break;
        case SaveState.Failed:
            <Icon Name="cloud-off" Size="IconSize.Small" />
            <span>@FailedText</span>
            <button type="button" class="save-status__retry" @onclick="Retry">Try now</button>
            break;
        case SaveState.Unsaved:
            <Icon Name="pencil" Size="IconSize.Small" />
            <span>@UnsavedText</span>
            break;
        default:
            <Icon Name="check" Size="IconSize.Small" />
            <span>@SavedText</span>
            break;
    }
    @if (Detail is not null)
    {
        <span class="save-status__detail">· @Detail</span>
    }
</p>

@code {
    [Parameter] public SaveState State { get; set; }
    [Parameter] public string SavedText { get; set; } = "Saved";
    [Parameter] public string UnsavedText { get; set; } = "You have changes that aren't saved";
    [Parameter] public string WaitingText { get; set; } = "Saving…";
    [Parameter] public string FailedText { get; set; } = "Couldn't save. Trying again by itself.";
    [Parameter] public string? Detail { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
}
