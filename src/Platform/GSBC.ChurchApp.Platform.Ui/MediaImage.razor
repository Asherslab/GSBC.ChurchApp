@using GSBC.ChurchApp.Platform.Client.Media
@using GSBC.ChurchApp.Platform.Contracts.Media
@inject IMediaFiles Files

@if (_source is not null && !_failed)
{
    <img src="@_source" alt="@(Alt ?? Media.AltText)" class="@Class" style="@Style" width="@NullIfZero(_shown.Width)" height="@NullIfZero(_shown.Height)" loading="lazy" @onerror="() => _failed = true" />
}
else
{
    <span class="media-placeholder @Class" role="img" aria-label="@(Alt ?? Media.AltText)" style="@AspectRatio"></span>
}

@code {
    private string? _source;
    private bool _failed;
    private string? _resolvedKey;
    private MediaRef _shown = new();

    [Parameter, EditorRequired] public required MediaRef Media { get; set; }
    [Parameter] public MediaSizeName Size { get; set; } = MediaSizeName.ForPhones;
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        MediaRef shown = Media.At(Size);
        if (shown.Key == _resolvedKey)
            return;

        _shown = shown;
        _resolvedKey = shown.Key;
        _source = null;
        _failed = false;
        _source = await Files.SourceOfAsync(shown);
    }

    private string? AspectRatio => Media.Width > 0 && Media.Height > 0 ? $"aspect-ratio: {Media.Width} / {Media.Height}" : null;

    private static int? NullIfZero(int value) => value > 0 ? value : null;
}
