@using GSBC.ChurchApp.Platform.Client.Native
@using GSBC.ChurchApp.Platform.Contracts.Media
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject Shell Shell
@inject NavigationManager Navigation
@inject IServiceProvider Services

<div class="video-embed @(_open ? "is-open" : "")">
    @if (_open && EmbedUrl is { } url && !_failed)
    {
        <iframe @ref="_frame" class="video-embed__frame" src="@url" title="@Title" referrerpolicy="strict-origin-when-cross-origin"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
    }
    else
    {
        <button type="button" class="video-embed__poster" aria-label="@($"Watch {Title}")" @onclick="OpenAsync">
            @if (Poster is { } poster)
            {
                <MediaImage Media="poster" Alt="" Class="video-embed__image" />
            }
            <span class="video-embed__play" aria-hidden="true"><Icon Name="play" /></span>
        </button>
        @if (_failed)
        {
            <p class="video-embed__problem" role="status">This video won't play here. <button type="button" class="text-link" @onclick="WatchOnYouTubeAsync">Watch on YouTube</button></p>
        }
    }
</div>

@code {
    private ElementReference _frame;
    private bool _open;
    private bool _failed;
    private bool _listening;
    private IJSObjectReference? _module;
    private IJSObjectReference? _subscription;
    private DotNetObjectReference<VideoEmbed>? _receiver;

    [Parameter, EditorRequired] public required string YouTubeId { get; set; }
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public MediaRef? Poster { get; set; }
    [Parameter] public int StartAt { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback Watched { get; set; }

    public static string WatchUrl(string id) => $"https://www.youtube.com/watch?v={Uri.EscapeDataString(id)}";

    private string? EmbedUrl => EmbedHost is { } host
        ? $"{host.GetLeftPart(UriPartial.Authority)}/embed/youtube.html#v={Uri.EscapeDataString(YouTubeId)}&t={Math.Max(0, StartAt)}"
        : null;

    private Uri? EmbedHost =>
        (Services.GetService(typeof(NativeBridge)) as NativeBridge) is { IsNative: true } bridge
            ? bridge.Gateway
            : Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? baseUri) && baseUri.Scheme == Uri.UriSchemeHttps ? baseUri : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_open)
            await OpenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open || _failed || _listening || EmbedUrl is null)
            return;
        _listening = true;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/GSBC.ChurchApp.Platform.Ui/js/video.js");
        _receiver ??= DotNetObjectReference.Create(this);
        _subscription = await _module.InvokeAsync<IJSObjectReference>("listen", _frame, _receiver);
    }

    private async Task OpenAsync()
    {
        await Shell.HapticAsync();
        if (EmbedUrl is null)
        {
            await WatchOnYouTubeAsync();
            return;
        }
        _open = true;
        _failed = false;
        await Watched.InvokeAsync();
    }

    private async Task WatchOnYouTubeAsync()
    {
        await Watched.InvokeAsync();
        await Shell.OpenExternalAsync(WatchUrl(YouTubeId));
    }

    [JSInvokable]
    public async Task OnVideoState(string state, string? code)
    {
        if (state != "error")
            return;
        _failed = true;
        _listening = false;
        await DisposeSubscriptionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DisposeSubscriptionAsync()
    {
        if (_subscription is null)
            return;
        try
        {
            await _subscription.InvokeVoidAsync("dispose");
            await _subscription.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _subscription = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeSubscriptionAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _receiver?.Dispose();
    }
}
