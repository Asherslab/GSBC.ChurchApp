@implements IDisposable
@inject IAccess Access

@if (Access.Can(Permission, ObjectId))
{
    @ChildContent
}
else
{
    @Otherwise
}

@code {
    [Parameter, EditorRequired] public required Permission Permission { get; set; }
    [Parameter] public string? ObjectId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Otherwise { get; set; }

    protected override void OnInitialized() => Access.Changed += OnAccessChanged;

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Access.Changed -= OnAccessChanged;
}
