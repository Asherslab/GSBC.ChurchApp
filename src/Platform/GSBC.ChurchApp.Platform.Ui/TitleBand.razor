@implements IDisposable
@inject ClientModules Modules
@inject NavigationManager Navigation
@inject SidebarPins Pins
@inject IAccess Access

<PageTitle>@(BrowserTitle ?? Title) · Good Shepherd admin</PageTitle>
<header class="title-band">
    <div class="title-band__text">
        @if (BackHref is not null)
        {
            <a class="title-band__back" href="@BackHref"><Icon Name="chevron-left" Size="IconSize.Small" />@BackText</a>
        }
        <h1 class="title-band__title" tabindex="-1">@Title</h1>
        @if (Lead is not null)
        {
            <p class="title-band__lead">@Lead</p>
        }
        @LeadContent
    </div>
    @if (Actions is not null || Pinnable is not null)
    {
        <div class="title-band__actions">
            @Actions
            @if (Pinnable is { } page)
            {
                <Button Variant="ButtonVariant.Quiet" Small="true" Icon="pin" OnClick="() => Pins.SetAsync(page.Href, !Pins.IsPinned(page.Href))">
                    @(Pins.IsPinned(page.Href) ? "Unpin from the sidebar" : "Pin to the sidebar")
                </Button>
            }
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public RenderFragment? LeadContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackText { get; set; } = "Back";
    [Parameter] public string? BrowserTitle { get; set; }

    private NavEntry? Pinnable => Pins.Available
        ? Modules.Navigation.FirstOrDefault(entry => SidebarPlan.Pinnable(entry) && (entry.Requires is null || Access.CanSomewhere(entry.Requires)) && entry.Href == Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0])
        : null;

    protected override void OnInitialized() => Pins.Changed += OnPinsChanged;

    private void OnPinsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Pins.Changed -= OnPinsChanged;
}
