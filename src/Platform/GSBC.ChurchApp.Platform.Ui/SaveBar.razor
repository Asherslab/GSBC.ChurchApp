<div class="save-bar @(OnMasthead ? "save-bar--on-masthead" : "") @(Block ? "save-bar--block" : "")">
    <Button Block="Block" Variant="@(OnMasthead ? ButtonVariant.OnMasthead : ButtonVariant.Primary)" Busy="Busy" Disabled="@(Blocked is not null)" OnClick="OnSave">@Label</Button>
    @if (Blocked is not null)
    {
        <p class="save-bar__why">@Blocked</p>
    }
    else if (State is { } state)
    {
        <SaveStatus State="state" SavedText="@SavedText" />
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Blocked { get; set; }
    [Parameter] public SaveState? State { get; set; }
    [Parameter] public string SavedText { get; set; } = "Saved";
    [Parameter] public bool OnMasthead { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public static SaveState? For(bool changed, bool saved) => changed ? SaveState.Unsaved : saved ? SaveState.Saved : null;
}
