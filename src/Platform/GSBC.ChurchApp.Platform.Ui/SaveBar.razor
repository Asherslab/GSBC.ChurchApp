<div class="save-bar @(OnMasthead ? "save-bar--on-masthead" : "") @(Block ? "save-bar--block" : "") @Class">
    <Button Type="@(Submit ? "submit" : "button")" Block="Block" Variant="@(OnMasthead ? ButtonVariant.OnMasthead : ButtonVariant.Primary)" Busy="Busy" Disabled="@(Blocked is not null)" OnClick="@(Submit ? default : OnSave)">@Label</Button>
    @if (Blocked is not null)
    {
        <p class="save-bar__why">@Blocked</p>
    }
    else if (State is { } state)
    {
        <SaveStatus State="state" SavedText="@SavedText" WaitingText="@WaitingText" FailedText="@FailedText" Detail="@Detail" Retry="Retry" />
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Blocked { get; set; }
    [Parameter] public SaveState? State { get; set; }
    [Parameter] public string SavedText { get; set; } = "Saved";
    [Parameter] public string WaitingText { get; set; } = "Saving…";
    [Parameter] public string FailedText { get; set; } = "Couldn't save. Trying again by itself.";
    [Parameter] public string? Detail { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public bool OnMasthead { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool Submit { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public static SaveState? For(bool changed, bool saved) => changed ? SaveState.Unsaved : saved ? SaveState.Saved : null;
}
