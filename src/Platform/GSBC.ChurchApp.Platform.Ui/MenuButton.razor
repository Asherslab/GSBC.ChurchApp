@inject Shell Shell

<button type="button" class="menu__item @(Danger ? "menu__item--danger" : "")" disabled="@Disabled" @onclick="ChooseAsync">
    @if (Icon is not null)
    {
        <span class="menu__lead"><GSBC.ChurchApp.Platform.Ui.Icon Name="@Icon" Size="IconSize.Small" /></span>
    }
    <span class="menu__text">@ChildContent</span>
</button>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task ChooseAsync()
    {
        await Shell.HapticAsync();
        await OnClick.InvokeAsync();
    }
}
