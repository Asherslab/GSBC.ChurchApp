@using GSBC.ChurchApp.Platform.Client.Destinations
@using GSBC.ChurchApp.Platform.Contracts.Destinations
@inject DestinationsClient Destinations
@inject IEnumerable<PlaceAction> Actions
@inject IAccess Access
@inject NavigationManager Navigation

<div class="place-explorer">
    <PlaceDirectory Chosen="@At" OnChoose="place => AtChanged.InvokeAsync(place.Path)" />
    <aside class="place-explorer__aside" aria-label="The chosen place">
        <LiveData @key="At" TValue="Destination" Load="() => Destinations.DescribeAsync(At).AsTask()" Feeds="Destinations.Feeds">
            @if (context.Value is { State: DestinationState.Available } place)
            {
                <div class="place-explorer__phone" data-fit-height>
                    <PlacePhone Destination="place" />
                </div>
                <h2 class="place-explorer__title">@place.Title</h2>
                <p class="place-explorer__where">@place.Where</p>
                <p class="place-explorer__who"><Icon Name="users" Size="IconSize.Small" />@WhoLine(place)</p>
                <div class="place-explorer__actions">
                    @foreach ((PlaceAction action, string href) in ActionsFor(place).Where(pair => pair.Action.Leads))
                    {
                        <Button Small="true" Icon="@action.Icon" Href="@href">@action.Label</Button>
                    }
                    <CopyField ButtonOnly="true" Label="Copy link" Value="@Link(place)" />
                    @foreach ((PlaceAction action, string href) in ActionsFor(place).Where(pair => !pair.Action.Leads))
                    {
                        <Button Variant="ButtonVariant.Quiet" Small="true" Icon="@action.Icon" Href="@href">@action.Label</Button>
                    }
                </div>
                <p class="place-explorer__link">@ShortLink(place)</p>
                <p class="place-explorer__note">@Note(place)</p>
            }
            else
            {
                <EmptyState Icon="link" Title="Can't show this place" Body="@PlaceWords.Unavailable(context.Value.State)" />
            }
        </LiveData>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public required string At { get; set; }
    [Parameter] public EventCallback<string> AtChanged { get; set; }

    private string Link(Destination place) => DestinationPaths.Shareable(new Uri(Navigation.BaseUri), place.Path);

    private string ShortLink(Destination place) => Link(place) is var link && new Uri(link) is var uri ? $"{uri.Host}{uri.AbsolutePath}" : link;

    private string Note(Destination place) => Destinations.Catalog.KindByKey(place.Kind)?.OpensOutside == true
        ? "On a phone with the app, the link opens this in the phone's browser. Anyone else is shown how to get the app."
        : "On a phone with the app, the link opens it there. Anyone else is shown how to get the app.";

    private static string WhoLine(Destination place) => place.WhoCanOpen == "Everyone" ? "Everyone can open it" : $"{place.WhoCanOpen} can open it";

    private IEnumerable<(PlaceAction Action, string Href)> ActionsFor(Destination place) => Actions
        .Where(action => action.Requires is null || Access.Can(action.Requires))
        .Select(action => (action, action.HrefFor(place)))
        .Where(pair => pair.Item2 is not null)
        .OrderByDescending(pair => pair.action.Leads)
        .Select(pair => (pair.action, pair.Item2!));
}
