@implements IAsyncDisposable
@inject Shell Shell

@if (Open)
{
    <dialog class="sheet-layer @LayerClass" @ref="_layer" aria-labelledby="@(Title is null ? null : _titleId)" aria-label="@(Title is null ? Label : null)">
    <div class="sheet-backdrop" @onclick="CloseAsync"></div>
    <div class="sheet @(Cover is null ? "" : "sheet--cover") @(Wide ? "sheet--wide" : "")" tabindex="-1" @ref="_sheet" @onkeydown="KeyAsync">
        @if (Cover is not null)
        {
            <div class="sheet__cover">
                <div class="sheet__grabber" aria-hidden="true"></div>
                <BrandMark Class="sheet__mark" Decorative="true" />
                @Cover
            </div>
        }
        else
        {
            <div class="sheet__grabber" aria-hidden="true"></div>
        }
        @if (Title is not null)
        {
            <h2 class="sheet__title" id="@_titleId">@Title</h2>
        }
        @if (Lead is not null)
        {
            <p class="sheet__lead">@Lead</p>
        }
        <div class="sheet__body">@ChildContent</div>
        @if (Actions is not null)
        {
            <div class="sheet__actions">@Actions</div>
        }
    </div>
    </dialog>
}

@code {
    private static int _sheets;
    private readonly string _titleId = $"sheet-{Interlocked.Increment(ref _sheets)}";
    private ElementReference _sheet;
    private ElementReference _layer;
    private bool _focused;
    private IJSObjectReference? _drag;
    private DotNetObjectReference<Sheet>? _receiver;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? Cover { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public string? LayerClass { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_focused)
        {
            _focused = true;
            await Shell.ShowModalAsync(_layer);
            await Shell.FocusFirstAsync(_sheet);
            _receiver ??= DotNetObjectReference.Create(this);
            _drag = await Shell.SheetDragAsync(_sheet, _receiver);
        }
        else if (!Open && _focused)
        {
            _focused = false;
            await StopDragAsync();
            await Shell.RestoreFocusAsync();
        }
    }

    [JSInvokable]
    public Task OnDragDismissed() => CloseAsync();

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private async Task StopDragAsync()
    {
        if (_drag is null)
            return;
        try
        {
            await _drag.InvokeVoidAsync("dispose");
            await _drag.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _drag = null;
    }

    public async ValueTask DisposeAsync()
    {
        await StopDragAsync();
        _receiver?.Dispose();
    }

    private Task KeyAsync(KeyboardEventArgs key) => key.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
