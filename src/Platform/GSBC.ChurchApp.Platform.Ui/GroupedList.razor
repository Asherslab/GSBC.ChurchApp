@typeparam TItem

@if (Items.Any())
{
    <div class="grouped-list">
        @foreach (IGrouping<string, TItem> group in Items.GroupBy(GroupKey))
        {
            <section>
                <h4>@group.Key</h4>
                <ul>
                    @foreach (TItem item in group)
                    {
                        <li>@ItemTemplate(item)</li>
                    }
                </ul>
            </section>
        }
    </div>
}
else
{
    @Empty
}

@code {
    [Parameter, EditorRequired] public required IEnumerable<TItem> Items { get; set; }
    [Parameter, EditorRequired] public required Func<TItem, string> GroupKey { get; set; }
    [Parameter, EditorRequired] public required RenderFragment<TItem> ItemTemplate { get; set; }
    [Parameter] public RenderFragment? Empty { get; set; }
}
