@page "/"
@using System.Globalization
@using GSBC.ChurchApp.Platform.Client.Access
@using GSBC.ChurchApp.Platform.Client.Modules
@using GSBC.ChurchApp.Platform.Common
@implements IDisposable
@inject IEnumerable<IOfficeWeekSource> Sources
@inject ClientModules Modules
@inject IAccess Access
@inject TimeProvider Clock

@if (!Access.SignedIn)
{
    <TitleBand Title="Good Shepherd admin" BrowserTitle="Welcome" Lead="Where staff change what the church app shows: its home screen, colours, pictures, and who can do what." />
    <div class="admin-gate">
        <EmptyState Icon="key" Title="Sign in to start" Body="Use the passkey on this computer or your phone. If you haven't got an account yet, ask the office for an invitation.">
            <Button Href="account" Icon="user">Sign in</Button>
        </EmptyState>
    </div>
}
else
{
    <TitleBand Title="This week" Lead="@($"{Today.ToString("dddd d MMMM", CultureInfo.InvariantCulture)} · dates are church time")" />

    <LiveData TValue="OfficeWeek" Load="LoadAsync" Feeds="Feeds" FailedTitle="Can't load this week right now">
        <DayRail First="Today" Today="Today" Days="Days" Spans="context.Value.Spans" Heading="The next seven days"
                 Quiet="Nothing dated this week. Event layers and tiles with dates appear here." Legend="Legend" />

        <div class="office-columns">
            <Section Title="Needs you">
                @if (context.Value.Tasks.Count == 0)
                {
                    <p class="office-done"><Icon Name="check" Size="IconSize.Small" /> Nothing is waiting on you.</p>
                }
                else
                {
                    <ul class="office-tasks">
                        @foreach (OfficeTask task in context.Value.Tasks.OrderBy(task => task.Since))
                        {
                            <li class="office-task">
                                <span class="office-task__tile" aria-hidden="true"><Icon Name="pencil" Size="IconSize.Small" /></span>
                                <span class="office-task__text">
                                    <a class="office-task__title" href="@task.Href">@task.Title</a>
                                    <span class="office-task__detail">@task.Detail · <DateLine At="task.Since" Style="DateLineStyle.Relative" /></span>
                                </span>
                                <Button Small="true" Variant="ButtonVariant.Quiet" Href="@task.Href">@task.Action</Button>
                            </li>
                        }
                    </ul>
                }
            </Section>

            <Section Title="Your areas">
                <ul class="office-areas">
                    @foreach (NavEntry entry in Areas)
                    {
                        <li>
                            <a class="office-area" href="@entry.Href">
                                <span class="office-area__tile" aria-hidden="true"><Icon Name="@entry.Icon" Size="IconSize.Small" /></span>
                                <span class="office-area__text">
                                    <span class="office-area__title">@entry.Title</span>
                                    <span class="office-area__summary">@entry.Summary</span>
                                </span>
                                <Icon Name="chevron-right" Size="IconSize.Small" Class="office-area__chevron" />
                            </a>
                        </li>
                    }
                </ul>
            </Section>
        </div>
    </LiveData>
}

@code {
    private const int Days = 7;

    private static readonly IReadOnlyList<(OfficeSpanKind Kind, string Label)> Legend =
        [(OfficeSpanKind.Everyone, "What everyone sees"), (OfficeSpanKind.Layer, "Event layer"), (OfficeSpanKind.Draft, "Not out yet: a draft or a scheduled announcement")];

    private DateTime Today => ChurchTime.ToChurch(Clock.GetUtcNow().UtcDateTime).Date;

    private DateTime From => ChurchTime.ToUtc(Today);

    private IReadOnlyCollection<string> Feeds => Sources.SelectMany(source => source.Feeds).ToHashSet();

    private IEnumerable<NavEntry> Areas =>
        Modules.Navigation.Where(entry => entry.Summary is not null && (entry.Requires is null || Access.CanSomewhere(entry.Requires)));

    private async Task<OfficeWeek> LoadAsync()
    {
        OfficeWeek[] weeks = await Task.WhenAll(Sources.Select(source => source.LoadAsync(From, From.AddDays(Days))));
        return new OfficeWeek(weeks.SelectMany(week => week.Tasks).ToList(), weeks.SelectMany(week => week.Spans).ToList());
    }

    protected override void OnInitialized() => Access.Changed += OnAccessChanged;

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Access.Changed -= OnAccessChanged;
}
