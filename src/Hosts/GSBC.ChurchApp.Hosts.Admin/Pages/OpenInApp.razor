@page "/open/{*Path}"
@layout StageLayout
@using GSBC.ChurchApp.Platform.Client.Access
@using GSBC.ChurchApp.Platform.Client.Destinations
@using GSBC.ChurchApp.Platform.Contracts.Destinations
@using GSBC.ChurchApp.Platform.Ui.Destinations
@inject DestinationsClient Destinations
@inject IEnumerable<OpenedPlaceView> Views
@inject ChurchWebsite Website
@inject NavigationManager Navigation
@inject IAccess Access

<LiveData @key="PlacePath" TValue="Destination" Load="() => Destinations.DescribeAsync(PlacePath).AsTask()" Feeds="Destinations.Feeds">
    @if (context.Value is { State: DestinationState.Available } shown && ViewOf(shown) is { } view)
    {
        <OpenedPage Note="@shown.Where">
            <DynamicComponent Type="view.Component" Parameters="@(new Dictionary<string, object> { [OpenedPlaceView.PlaceParameter] = shown })" />
        </OpenedPage>
    }
    else
    {
        <PageTitle>Open in the app · Good Shepherd</PageTitle>
        <div class="sign-in-stage open-stage">
            <div class="sign-in-card open-card">
                <div class="sign-in-card__brand">
                    <BrandMark Decorative="true" />
                    <span>Good Shepherd</span>
                </div>
                @if (context.Value is { State: DestinationState.Available } place)
                {
                    <div class="open-card__place">
                        <span class="row__icon @(place.Area == DestinationAreas.Pages.Key ? "" : "row__icon--accent")"><Icon Name="@place.Icon" Size="IconSize.Small" /></span>
                        <span>
                            <h1 class="open-card__title" tabindex="-1">@place.Title</h1>
                            <span class="open-card__where">@place.Where</span>
                        </span>
                    </div>
                    <p class="open-card__body">This link opens in the Good Shepherd app. On a phone with the app, tapping the link opens it there straight away.</p>
                    <p class="open-card__body">Don't have the app yet? Ask the church office how to get it, then tap the link again.</p>
                }
                else if (context.Value.State == DestinationState.NotForYou)
                {
                    <h1 class="open-card__title" tabindex="-1">A place in the church app</h1>
                    <p class="open-card__body">This link opens in the Good Shepherd app, for people the church has given access. Open it on a phone that has the app and is signed in.</p>
                }
                else
                {
                    <h1 class="open-card__title" tabindex="-1">This isn't in the app any more</h1>
                    <p class="open-card__body">@PlaceWords.Unavailable(context.Value.State) If someone sent you this link, ask them for a new one.</p>
                }
                @if (Access.SignedIn)
                {
                    <Button Variant="ButtonVariant.Quiet" Icon="link" Href="@($"places?at={Uri.EscapeDataString(PlacePath)}")">See it in Places in the app</Button>
                }
            </div>
        </div>
    }
</LiveData>

@code {
    [Parameter] public string? Path { get; set; }

    private string PlacePath => "/" + (Path ?? "");

    protected override void OnParametersSet()
    {
        if (Website.LinkGoesTo(PlacePath) is { } address)
            Navigation.NavigateTo(address, forceLoad: true, replace: true);
    }

    private OpenedPlaceView? ViewOf(Destination place) => Views.FirstOrDefault(view => view.Kind.Key == place.Kind);
}
