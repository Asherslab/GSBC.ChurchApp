{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "grpc-web": {
        "ClusterId": "api-web",
        "Order": 0,
        "Match": {
          "Path": "/gsbc.{service}/{method}",
          "Headers": [ { "Name": "Content-Type", "Values": [ "application/grpc-web" ], "Mode": "HeaderPrefix" } ]
        }
      },
      "grpc": {
        "ClusterId": "api-grpc",
        "Order": 1,
        "Match": {
          "Path": "/gsbc.{service}/{method}",
          "Headers": [ { "Name": "Content-Type", "Values": [ "application/grpc" ], "Mode": "HeaderPrefix" } ]
        }
      }
    },
    "Clusters": {
      "api-web": {
        "Destinations": { "api": { "Address": "http://api:8080" } }
      },
      "api-grpc": {
        "HttpRequest": { "Version": "2", "VersionPolicy": "RequestVersionExact" },
        "Destinations": { "api": { "Address": "http://api:8081" } }
      }
    }
  }
}
