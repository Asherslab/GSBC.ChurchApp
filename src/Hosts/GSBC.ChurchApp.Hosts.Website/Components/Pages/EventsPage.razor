@inject PublicFeeds Feeds
@inject TimeProvider Time
@inject WebsiteLinks Links

<PageMeta Title="Events" Description="What's on at Good Shepherd Baptist Church: services, groups and special events, week by week." />

<div class="bar">
    @if (Offered.Count > 1)
    {
        <ul class="chips" aria-label="Calendars">
            <li><a class="chip" href="@ListHref(null, Weeks)" aria-current="@(Showing is null ? "true" : null)">@(Limit is null ? "All calendars" : "All of these")</a></li>
            @foreach (CalendarInfo calendar in Offered)
            {
                <li><a class="chip" href="@ListHref(calendar.Slug, Weeks)" aria-current="@(Showing?.Id == calendar.Id ? "true" : null)">@calendar.Name</a></li>
            }
        </ul>
    }
    <div class="bar-end">
        <a class="text-link" href="@Links.Subscribe(Showing?.Slug ?? (Offered.Count == 1 ? Offered[0].Slug : null))"><SiteIcon Name="calendar" /> Subscribe in your calendar app</a>
    </div>
</div>

@if (!Feeds.HasRead)
{
    <section class="empty"><h2>The calendar is on its way</h2><p>It's being read from the app. Try again in a minute.</p></section>
}
else if (WeekList.Count == 0 && Gatherings.Count == 0)
{
    <section class="empty"><h2>Nothing on the calendar yet</h2><p>There's nothing coming up@(Showing is null ? "" : $" in {Showing.Name}"). New events appear here as soon as they're added in the app.</p></section>
}
else
{
    <div class="with-side">
    <div class="with-side-main">
    @if (WeekList.Count == 0)
    {
        <section class="empty"><h2>No special events coming up</h2><p>Anything special@(Showing is null ? "" : $" in {Showing.Name}") appears here as soon as it's added in the app.</p></section>
    }
    @foreach (EventWeek week in WeekList)
    {
        <section class="week" aria-labelledby="week-@week.Start.DayNumber">
            <div class="week-head"><h2 id="week-@week.Start.DayNumber">@week.Heading</h2><span class="week-range">@week.Range</span></div>
            @foreach (EventDay day in week.Days)
            {
                <div class="day">
                    <DateTile Date="day.Date" Today="day.Date == Today" />
                    <h3 class="visually-hidden">@EventWords.LongDate(day.Date)</h3>
                    <ul class="day-events">
                        @foreach (EventOccurrence occurrence in day.Events)
                        {
                            <EventItem Occurrence="occurrence" Calendar="Data.Calendar(occurrence.CalendarId)" Href="@EventHref(occurrence)" />
                        }
                    </ul>
                </div>
            }
        </section>
    }
    @if (EventListing.HasLater(Ahead, Today, Weeks))
    {
        <div class="more"><a class="button button-quiet" href="@ListHref(Showing?.Slug, Weeks + EventListing.FirstWeeks)">Show the next @EventListing.FirstWeeks weeks</a></div>
    }
    </div>
    @if (Gatherings.Count > 0)
    {
        <section class="regulars side" aria-labelledby="regulars">
            <h2 class="regulars-head" id="regulars">Regular gatherings</h2>
            <ul class="regular-list">
                @foreach (RegularGathering gathering in Gatherings)
                {
                    <li>
                        <a href="@EventHref(gathering.Next)">@gathering.Next.Fields.Title</a>
                        <span class="regular-when"><SiteIcon Name="repeat" /> @gathering.When</span>
                        @if (gathering.Place is { } place)
                        {
                            <span class="regular-where"><SiteIcon Name="pin" /> @place</span>
                        }
                        @if (gathering.NotOn is { } off)
                        {
                            <span class="not-on-line"><SiteIcon Name="paused" /> @off</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "calendar")] public string? Limit { get; set; }
    [SupplyParameterFromQuery(Name = "show")] public string? Show { get; set; }
    [SupplyParameterFromQuery(Name = "weeks")] public int? WeeksAsked { get; set; }

    private WebsiteData Data = WebsiteData.Empty;
    private IReadOnlyList<CalendarInfo> Offered = [];
    private CalendarInfo? Showing;
    private IReadOnlyList<EventOccurrence> Ahead = [];
    private IReadOnlyList<EventWeek> WeekList = [];
    private IReadOnlyList<RegularGathering> Gatherings = [];
    private DateOnly Today;

    private int Weeks => Math.Clamp(WeeksAsked ?? EventListing.FirstWeeks, 1, EventListing.MostWeeks);

    protected override void OnParametersSet()
    {
        Data = Feeds.Current;
        DateTime now = Time.GetUtcNow().UtcDateTime;
        Today = ChurchTime.DayOf(now);
        Offered = EventListing.Limited(Data.Calendars, Limit);
        Showing = Offered.FirstOrDefault(calendar => string.Equals(calendar.Slug, Show, StringComparison.OrdinalIgnoreCase));
        List<EventOccurrence> ahead = EventListing.Ahead(EventListing.On(Data.Events, Showing is null ? Offered : [Showing]), now).ToList();
        Ahead = EventListing.Listed(ahead).ToList();
        Gatherings = EventListing.Gatherings(ahead);
        WeekList = EventListing.Weeks(Ahead, Today, Weeks);
    }

    private string ListHref(string? show, int weeks) => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/events", Query(show, weeks));

    private Dictionary<string, string?> Query(string? show, int weeks)
    {
        Dictionary<string, string?> query = [];
        if (Limit is { Length: > 0 })
            query["calendar"] = Limit;
        if (show is { Length: > 0 })
            query["show"] = show;
        if (weeks != EventListing.FirstWeeks)
            query["weeks"] = weeks.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return query;
    }

    private string EventHref(EventOccurrence occurrence) =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString($"/events/{Uri.EscapeDataString(occurrence.Id)}", Limit is { Length: > 0 } ? new Dictionary<string, string?> { ["calendar"] = Limit } : []);
}
