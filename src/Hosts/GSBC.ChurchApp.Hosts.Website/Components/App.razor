<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <script>if (window.parent !== window) document.documentElement.classList.add("in-frame");</script>
    <link rel="preload" href="fonts/dm-serif-text-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <link rel="stylesheet" href="@Assets["website.css"]" />
    <HeadOutlet />
</head>
<body>
    <LayoutView Layout="typeof(EmbedLayout)">
        <DynamicComponent Type="Page" Parameters="Parameters" />
    </LayoutView>
    <script src="@Assets["frame.js"]"></script>
</body>
</html>

@code {
    [Parameter, EditorRequired] public required Type Page { get; set; }
    [Parameter] public IDictionary<string, object> Parameters { get; set; } = new Dictionary<string, object>();
}
