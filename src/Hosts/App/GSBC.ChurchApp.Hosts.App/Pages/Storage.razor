@page "/storage"
@using System.Text
@using GSBC.ChurchApp.Platform.Client.Feeds
@using GSBC.ChurchApp.Platform.Client.Outbox
@using GSBC.ChurchApp.Platform.Contracts.Sync
@inject ILocalFeeds Feeds
@inject IOutbox Outbox
@inject Platform.Client.Native.NativeBridge Bridge

<RefreshOn On="ChangeKind.Feeds | ChangeKind.Outbox | ChangeKind.Reconnected" Changed="LoadAsync" />

<Page Title="Storage" BackHref="more" BackLabel="More">
    <PullToRefresh OnRefresh="RefreshAsync">
        <Masthead Title="Storage" Note="@(Feeds.IsAvailable ? $"{Size(_info.FileBytes)} on this phone" : null)">
            <SyncIndicator OnMasthead="true" />
        </Masthead>

        @if (!Feeds.IsAvailable)
        {
            <Section First="true">
                <EmptyState Icon="database" Title="Kept on the phone" Body="The app stores what it syncs on the phone. In a browser, nothing is kept here." />
            </Section>
        }
        else
        {
            <StorageSections />

            <Section Title="Synced to this phone">
                <Trailing><Button Variant="ButtonVariant.Quiet" Small="true" Icon="refresh" Busy="_refreshing" OnClick="RefreshAsync">Sync now</Button></Trailing>
                <ChildContent>
                    <ListGroup>
                        @foreach (StoredFeed feed in _info.Feeds)
                        {
                            <ListRow Title="@feed.Feed" Subtitle="@($"{feed.Rows} {(feed.Rows == 1 ? "record" : "records")} · cursor {feed.Cursor}")" Trailing="@Size(feed.Bytes)" Icon="database" IconTone="RowTone.Quiet" />
                        }
                    </ListGroup>
                </ChildContent>
            </Section>

            <Section Title="Waiting to send" Lead="Changes made offline wait here and go as soon as there's a signal.">
                @if (_outbox.Count == 0)
                {
                    <ListGroup><ListRow Title="Nothing waiting" Icon="check" IconTone="RowTone.Accent" /></ListGroup>
                }
                else
                {
                    <ListGroup>
                        @foreach (OutboxEntry entry in _outbox)
                        {
                            <ListRow Title="@(entry.FileName is { } file ? $"The file {file}" : entry.Method)" Subtitle="@Describe(entry)" Icon="@(entry.FileName is null ? "send" : "file")" IconTone="@(entry.Failed ? RowTone.Warm : RowTone.Quiet)">
                                <TrailingContent>
                                    @if (entry.Failed)
                                    {
                                        <Menu Label="@($"More for {(entry.FileName ?? entry.Method)}")" Items="EntryActions(entry)" Small="true" />
                                    }
                                </TrailingContent>
                            </ListRow>
                        }
                    </ListGroup>
                }
                @if (Bridge.IsDevelopmentBuild)
                {
                    <div class="ui-actions ui-after">
                        <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="QueueTestSendAsync">Queue a test send</Button>
                        <Button Variant="ButtonVariant.Quiet" Small="true" OnClick="QueueFailingSendAsync">Queue a failing send</Button>
                    </div>
                }
            </Section>

            @if (_echo.Count > 0)
            {
                <Section Title="@DevelopmentFeeds.Echo">
                    <ListGroup>
                        @foreach (StoredRecord record in _echo)
                        {
                            <ListRow Title="@record.Id" Subtitle="@Encoding.UTF8.GetString(record.Payload)" Trailing="@($"v{record.Version}")" />
                        }
                    </ListGroup>
                </Section>
            }
        }
    </PullToRefresh>
</Page>

<Sheet Open="_discarding is not null" OpenChanged="open => { if (!open) _discarding = null; }" Title="Discard this change?"
       Lead="It hasn't reached the church's server, so it's lost from this phone. This can't be undone.">
    <Actions>
        <Button Variant="ButtonVariant.Danger" OnClick="DiscardAsync">Discard it</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="() => _discarding = null">Keep it</Button>
    </Actions>
</Sheet>

@code {
    private OutboxEntry? _discarding;

    private IReadOnlyList<MenuItem> EntryActions(OutboxEntry entry) =>
    [
        this.Item("Retry", () => Outbox.RetryAsync(entry.Id).AsTask(), "refresh"),
        this.Item("Discard…", () => { _discarding = entry; return Task.CompletedTask; }, "trash-2", danger: true, startsGroup: true),
    ];

    private async Task DiscardAsync()
    {
        if (_discarding is { } entry)
            await Outbox.DiscardAsync(entry.Id);
        _discarding = null;
    }

    private StoreInfo _info = new(0, []);
    private IReadOnlyList<StoredRecord> _echo = [];
    private IReadOnlyList<OutboxEntry> _outbox = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _info = await Feeds.InfoAsync();
        _echo = await Feeds.ReadPageAsync(new FeedPageQuery(DevelopmentFeeds.Echo));
        _outbox = await Outbox.ListAsync();
    }

    private bool _refreshing;

    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            await Feeds.RefreshAsync();
            await LoadAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static string Describe(OutboxEntry entry) =>
        entry.Failed ? $"Couldn't send: {entry.LastError}"
        : entry.WaitsForUpload ? "Waiting for its file to be sent"
        : entry.Attempts == 0 ? "Sending" : $"Retrying ({entry.Attempts} tries; {entry.LastError})";

    private async Task QueueTestSendAsync() => await Outbox.EnqueueAsync("/gsbc.accounts.Session/GetCurrent", []);

    private async Task QueueFailingSendAsync() => await Outbox.EnqueueAsync("/gsbc.development.Missing/Call", []);

    private static string Size(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:0.#} KB";
}
