@page "/"
@using GSBC.ChurchApp.Features.Accounts.Client
@using GSBC.ChurchApp.Features.Accounts.Contracts
@inject AccountsClient Accounts
@using GSBC.ChurchApp.Platform.Client.Configuration
@using GSBC.ChurchApp.Platform.Contracts.Configuration
@implements IDisposable
@inject TimeProvider Clock
@inject ISurfaceLayout Layout

<Page Title="Good Shepherd">
    <Masthead Title="Good Shepherd">
        <p class="masthead__note"><DateLine At="Clock.GetUtcNow().UtcDateTime" /></p>
        <div class="home-status"><SyncIndicator OnMasthead="true" /></div>
    </Masthead>

    <Section First="true">
        @if (_tiles.Count == 0)
        {
            <EmptyState Icon="home" Title="Home is on its way" Body="This Sunday, sermons and the week will show here as each part of the app is built." />
        }
        else
        {
            <ListGroup>
                @foreach (ArrangedSurface tile in _tiles)
                {
                    <ListRow Title="@tile.Values.Get(HubSurfaces.LinkTile.Title)" Subtitle="@NullIfEmpty(tile.Values.Get(HubSurfaces.LinkTile.Subtitle))"
                             Icon="link" IconTone="RowTone.Accent" Href="@tile.Values.Get(HubSurfaces.LinkTile.Link)" External="true" />
                }
            </ListGroup>
        }
    </Section>

    <Section Title="Connection">
        <ListGroup>
            <LiveData TValue="CurrentSession" Load="() => Accounts.GetCurrentSessionAsync().AsTask()">
                <ChildContent>
                    @if (context.Stale)
                    {
                        @Unreachable
                    }
                    else
                    {
                        <ListRow Title="Connected to the church's server" Subtitle="@(context.Value.SignedIn ? $"Signed in as {context.Value.DisplayName}" : "Not signed in")" Icon="check" IconTone="RowTone.Accent" />
                    }
                </ChildContent>
                <Failed>@Unreachable</Failed>
            </LiveData>
        </ListGroup>
    </Section>
</Page>

@code {
    private IReadOnlyList<ArrangedSurface> _tiles = [];

    protected override async Task OnInitializedAsync()
    {
        Layout.Changed += OnLayoutChanged;
        await LoadTilesAsync();
    }

    private async Task LoadTilesAsync() =>
        _tiles = (await Layout.ShownAsync(HubSurfaces.Area)).Where(entry => entry.Surface.Key == HubSurfaces.LinkTile.Surface.Key).ToList();

    private void OnLayoutChanged() => InvokeAsync(async () =>
    {
        await LoadTilesAsync();
        StateHasChanged();
    });

    private static string? NullIfEmpty(string text) => text.Length == 0 ? null : text;

    public void Dispose() => Layout.Changed -= OnLayoutChanged;

    private static readonly RenderFragment Unreachable =
        @<ListRow Title="Can't reach the church's server" Subtitle="The app keeps showing what's on this phone and reconnects by itself." Icon="alert" IconTone="RowTone.Warm" />;
}
