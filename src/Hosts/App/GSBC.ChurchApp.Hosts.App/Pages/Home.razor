@page "/"
@using GSBC.ChurchApp.Features.Accounts.Client
@using GSBC.ChurchApp.Features.Accounts.Contracts
@inject AccountsClient Accounts
@inject TimeProvider Clock

<Page Title="Good Shepherd">
    <Masthead Title="Good Shepherd">
        <p class="masthead__note"><DateLine At="Clock.GetUtcNow().UtcDateTime" /></p>
        <div class="home-status"><SyncIndicator OnMasthead="true" /></div>
    </Masthead>

    <Section First="true">
        <EmptyState Icon="home" Title="Home is on its way" Body="This Sunday, sermons and the week will show here as each part of the app is built." />
    </Section>

    <Section Title="Connection">
        <ListGroup>
            <LiveData TValue="CurrentSession" Load="() => Accounts.GetCurrentSessionAsync().AsTask()">
                <ChildContent>
                    @if (context.Stale)
                    {
                        @Unreachable
                    }
                    else
                    {
                        <ListRow Title="Connected to the church's server" Subtitle="@(context.Value.SignedIn ? $"Signed in as {context.Value.DisplayName}" : "Not signed in")" Icon="check" IconTone="RowTone.Accent" />
                    }
                </ChildContent>
                <Failed>@Unreachable</Failed>
            </LiveData>
        </ListGroup>
    </Section>
</Page>

@code {
    private static readonly RenderFragment Unreachable =
        @<ListRow Title="Can't reach the church's server" Subtitle="The app keeps showing what's on this phone and reconnects by itself." Icon="alert" IconTone="RowTone.Warm" />;
}
