@inherits LayoutComponentBase
@using System.Globalization
@using GSBC.ChurchApp.Platform.Client.Configuration
@using GSBC.ChurchApp.Platform.Common
@implements IDisposable
@inject Shell Shell
@inject IPreviewMode Preview
@inject Platform.Client.Native.NativeBridge Bridge
@inject OpeningSheets OpeningSheets
@inject Platform.Ui.Destinations.LinkOpener Links

<div class="shell">
    @Body
    @if (Preview.Current is { } preview && !_bannerHidden)
    {
        <PreviewBanner Title="@BannerTitle(preview)" Detail="@BannerDetail(preview)" OnExit="() => Preview.ChooseAsync(null)" OnHide="() => _bannerHidden = true" />
    }
    <NowPlaying />
    <AppTabBar />
</div>
<GSBC.ChurchApp.Features.Notifications.App.NotificationsWelcomeMoment />
<GSBC.ChurchApp.Features.ReleaseNotes.App.WhatsNewMoment />
<AppTheme />

@code {
    private static readonly TimeSpan SettleFirst = TimeSpan.FromMilliseconds(600);
    private bool _bannerHidden;

    protected override async Task OnInitializedAsync()
    {
        Preview.Changed += OnPreviewChanged;
        await Preview.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Shell.Returned += OnReturned;
            await Shell.WatchReturnsAsync();
            await Shell.StartedAsync();
            await Bridge.OpenLinksWithAsync(path => InvokeAsync(() => Links.OpenAsync(path)));
            await Task.Delay(SettleFirst);
            await OpeningSheets.PresentFirstAsync();
        }
    }

    private static string BannerTitle(PreviewChoice preview) =>
        preview.DraftId is null ? "Previewing what everyone sees" : $"Previewing \"{preview.Name}\"";

    private static string? BannerDetail(PreviewChoice preview)
    {
        List<string> parts = [];
        if (preview.As == PreviewViewer.Visitor)
            parts.Add("as a visitor");
        if (preview.As == PreviewViewer.Member)
            parts.Add("as a member");
        if (preview.At is { } at)
            parts.Add(ChurchTime.ToChurch(at).ToString("ddd d MMM, h:mmtt", CultureInfo.InvariantCulture).Replace(":00", "").ToLowerInvariant());
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private void OnPreviewChanged()
    {
        _bannerHidden = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnReturned()
    {
        _bannerHidden = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Preview.Changed -= OnPreviewChanged;
        Shell.Returned -= OnReturned;
    }
}
