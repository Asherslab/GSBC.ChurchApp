<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <GsbcIsAppHost>true</GsbcIsAppHost>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Blazor hides trim warnings by default (SPEC §9 rule 1). -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\GSBC.ChurchApp.Platform.Ui\GSBC.ChurchApp.Platform.Ui.csproj" />
    <ProjectReference Include="..\..\..\Features\Access\GSBC.ChurchApp.Features.Access.Client\GSBC.ChurchApp.Features.Access.Client.csproj" />
    <ProjectReference Include="..\..\..\Features\Accounts\GSBC.ChurchApp.Features.Accounts.App\GSBC.ChurchApp.Features.Accounts.App.csproj" />
    <ProjectReference Include="..\..\..\Features\Configuration\GSBC.ChurchApp.Features.Configuration.App\GSBC.ChurchApp.Features.Configuration.App.csproj" />
    <ProjectReference Include="..\..\..\Features\Media\GSBC.ChurchApp.Features.Media.Client\GSBC.ChurchApp.Features.Media.Client.csproj" />
  </ItemGroup>
</Project>
