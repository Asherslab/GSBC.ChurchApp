<Project>
  <ItemGroup Condition="'$(GsbcIsContracts)' == 'true'">
    <AssemblyAttribute Include="ProtoBuf.CompatibilityLevelAttribute">
      <_Parameter1>ProtoBuf.CompatibilityLevel.Level300</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The router finds pages by reflection, so the trimmer must keep each host (the app, the admin panel) and its page modules whole (SPEC §9 rule 1). -->
  <Target Name="GsbcRootPageModules" BeforeTargets="PrepareForILLink" Condition="'$(GsbcIsAppHost)' == 'true' or '$(GsbcIsAdminHost)' == 'true'">
    <ItemGroup>
      <TrimmerRootAssembly Include="$(AssemblyName)" />
      <TrimmerRootAssembly Include="%(ProjectReference.Filename)" Condition="'$(GsbcIsAppHost)' == 'true' and $([System.String]::Copy('%(ProjectReference.Filename)').EndsWith('.App'))" />
      <TrimmerRootAssembly Include="%(ProjectReference.Filename)" Condition="'$(GsbcIsAdminHost)' == 'true' and $([System.String]::Copy('%(ProjectReference.Filename)').EndsWith('.Admin'))" />
    </ItemGroup>
  </Target>
</Project>
